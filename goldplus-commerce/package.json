{
  "name": "goldplus-commerce",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:web": "pnpm -F @goldplus/web dev",
    "dev:api": "pnpm -F @goldplus/api dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:architecture": "vitest run tests/architecture",
    "db:generate": "pnpm -F @goldplus/api db:generate",
    "db:migrate": "pnpm -F @goldplus/api db:migrate",
    "db:studio": "pnpm -F @goldplus/api db:studio",
    "seed": "tsx scripts/seed.ts",
    "verify": "tsx scripts/verify-build.ts"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "bun-types": "^1.3.13",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3",
    "vitest": "^1.3.1",
    "xlsx": "^0.18.5"
  }
}
