{
  "name": "goldplus-commerce",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:web": "pnpm -F @goldplus/web dev",
    "dev:api": "pnpm -F @goldplus/api dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration --no-file-parallelism",
    "test:e2e": "playwright test",
    "test:architecture": "vitest run tests/architecture",
    "db:generate": "pnpm -F @goldplus/api db:generate",
    "db:migrate": "pnpm -F @goldplus/api db:migrate",
    "db:studio": "pnpm -F @goldplus/api db:studio",
    "seed": "tsx scripts/seed.ts",
    "verify": "tsx scripts/verify-build.ts",
    "measurement:gtm:plan": "pnpm -F @goldplus/api exec tsx src/scripts/measurement-gtm-plan.ts",
    "measurement:gtm:validate": "pnpm -F @goldplus/api exec tsx src/scripts/measurement-gtm-validate.ts",
    "measurement:gtm:diff": "pnpm -F @goldplus/api exec tsx src/scripts/measurement-gtm-diff.ts",
    "measurement:gtm:create-workspace": "pnpm -F @goldplus/api exec tsx src/scripts/measurement-gtm-create-workspace.ts",
    "measurement:gtm:create-version-draft": "pnpm -F @goldplus/api exec tsx src/scripts/measurement-gtm-create-version-draft.ts",
    "security:scan-secrets": "node scripts/security/scan-secrets.mjs",
    "images:optimise": "node scripts/images/optimise-static-images.mjs",
    "images:check": "node scripts/images/optimise-static-images.mjs --check",
    "e2e:checkout": "scripts/qa/checkout-e2e-harness.sh",
    "proof:checkout-durability": "tsx scripts/qa/checkout-side-effect-durability.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^25.6.2",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "axe-core": "^4.12.1",
    "bun-types": "^1.3.13",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3",
    "vitest": "^4.1.11",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz"
  },
  "pnpm": {
    "overrides": {
      "devalue": ">=5.9.3",
      "@grpc/grpc-js": ">=1.14.5",
      "@opentelemetry/propagator-jaeger": ">=2.9.0",
      "sharp": ">=0.35.5",
      "brace-expansion@<1.1.20": "^1.1.20",
      "brace-expansion@>=2.0.0 <2.1.6": "^2.1.6",
      "brace-expansion@>=5.0.0 <5.0.11": "^5.0.11",
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
      "js-yaml@<3.15.2": "^3.15.2",
      "nanoid@<3.3.18": "^3.3.18",
      "postcss@<8.5.18": "^8.5.18",
      "source-map-js@<1.2.2": "^1.2.2",
      "browserslist@<4.28.7": "^4.28.7"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-26w7-cxv4-gfx2",
        "GHSA-qh8j-hqjv-7m4x",
        "GHSA-gpj5-g38j-94v9",
        "GHSA-ch52-4w7c-c8xp",
        "GHSA-vfj7-8cjw-p6xm"
      ]
    }
  }
}
