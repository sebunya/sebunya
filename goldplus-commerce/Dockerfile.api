# Pin Node.js LTS version (node:20-alpine)
FROM node:20-alpine@sha256:c13b26e6de602defad90aa7afaf3905581177651a2d59ad0cb233ec7c813350b AS base

# Install pnpm
RUN npm install -g pnpm@9.1.4

WORKDIR /app

FROM base AS builder
# Copy configuration files
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/api/package.json ./apps/api/
COPY packages/shared/package.json ./packages/shared/

# Install all dependencies (including devDependencies for build)
RUN pnpm install --frozen-lockfile

# Copy source code
COPY packages/shared ./packages/shared
COPY apps/api ./apps/api

# Build the packages
RUN pnpm -F @goldplus/shared typecheck
RUN pnpm -F @goldplus/api build

# Prune dev dependencies for production runtime
RUN pnpm install --prod --frozen-lockfile

FROM base AS runner
# Set production environment
ENV NODE_ENV=production
ENV PORT=3000

WORKDIR /app

# Copy built code and node_modules
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages/shared ./packages/shared
COPY --from=builder /app/apps/api/dist ./apps/api/dist
COPY --from=builder /app/apps/api/node_modules ./apps/api/node_modules
COPY --from=builder /app/apps/api/package.json ./apps/api/package.json

# Use non-root node user
USER node

EXPOSE 3000

# Run API server
CMD ["node", "apps/api/dist/interfaces/http/server.js"]
