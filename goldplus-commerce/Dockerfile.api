# Pin Node.js LTS version (node:20-alpine)
FROM node:20-alpine@sha256:fb4cd12c85ee03686f6af5362a0b0d56d50c58a04632e6c0fb8363f609372293 AS base

# Install pnpm
RUN npm install -g pnpm@9.1.4

WORKDIR /app

FROM base AS builder
# Copy configuration files
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/api/package.json ./apps/api/
COPY packages/shared/package.json ./packages/shared/

# Install all dependencies (including devDependencies for build)
RUN pnpm install --frozen-lockfile

# Copy source code
COPY packages/shared ./packages/shared
COPY apps/api ./apps/api

# Build the packages
RUN pnpm exec tsc -p packages/shared/tsconfig.json
RUN pnpm -F @goldplus/api build

# Prune dev dependencies for production runtime. NOTE: this rewrites the reachable
# graph but pnpm's virtual store (node_modules/.pnpm) physically retains every
# package it ever linked — which is how the whole web/build toolchain (esbuild's
# Go binaries, vite, rollup) was still shipping inside the API runtime image and
# dominating its vulnerability scan. `pnpm deploy` below produces a self-contained
# production-only tree instead.
RUN pnpm install --prod --frozen-lockfile

# The workspace package points at TypeScript for local tooling. Runtime Node must
# load the compiled CommonJS entrypoint copied into the final image.
RUN node -e "const fs=require('fs');const p='packages/shared/package.json';const pkg=JSON.parse(fs.readFileSync(p,'utf8'));pkg.main='dist/index.js';fs.writeFileSync(p,JSON.stringify(pkg,null,2)+'\\n')"

# Self-contained production dependency tree (no dev toolchain, no virtual store).
RUN pnpm deploy --filter=@goldplus/api --prod /app/deploy

# COPY preserves host file modes; a root-only (600) file in the deploy checkout
# is unreadable by the non-root runtime user and turns into MODULE_NOT_FOUND.
RUN chmod -R a+rX /app/deploy /app/packages/shared /app/apps/api/dist /app/apps/api/package.json

FROM base AS runner
# Set production environment
ENV NODE_ENV=production
ENV PORT=3000

WORKDIR /app

# Copy built code and node_modules
COPY --from=builder /app/deploy/node_modules ./node_modules
COPY --from=builder /app/packages/shared ./packages/shared
COPY --from=builder /app/apps/api/dist ./apps/api/dist
COPY --from=builder /app/apps/api/package.json ./apps/api/package.json

# Use non-root node user
USER node

EXPOSE 3000

# Run API server
CMD ["node", "apps/api/dist/interfaces/http/server.js"]
