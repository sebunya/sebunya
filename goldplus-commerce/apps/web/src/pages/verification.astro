---
import BaseLayout from "../layouts/BaseLayout.astro";

// Mock verification results for demonstration
const verificationResult = null; // 'success' | 'failure' | 'missing_info' | null
---

<BaseLayout title="Product Verification - GoldPlus">
  <div class="bg-brand-dark text-white py-16 border-b border-gray-800">
    <div class="container mx-auto px-4 lg:px-8 text-center">
      <span class="inline-block py-1 px-3 rounded-full bg-brand-gold/10 text-brand-gold text-xs font-bold tracking-widest uppercase mb-4">
        GoldPlus Shield
      </span>
      <h1 class="text-3xl md:text-5xl font-black tracking-tight mb-4">Verify Your Product</h1>
      <p class="text-gray-400 max-w-2xl mx-auto text-lg">Every authentic GoldPlus product comes with a unique verification code. Enter it below to confirm your purchase is genuine.</p>
    </div>
  </div>

  <div class="container mx-auto px-4 lg:px-8 py-12">
    <div class="max-w-2xl mx-auto">
      
      {/* Verification Input Area */}
      <div class="bg-white p-8 rounded-2xl border border-gray-200 shadow-xl mb-12 relative overflow-hidden">
        <div class="absolute top-0 right-0 w-32 h-32 bg-gray-50 -mr-16 -mt-16 rounded-full opacity-50"></div>
        
        <form class="relative z-10">
          <label for="code" class="block text-sm font-bold text-brand-dark mb-4 uppercase tracking-widest text-center">Enter 12-Digit Code</label>
          <div class="flex flex-col sm:flex-row gap-4 mb-6">
            <input 
              type="text" 
              id="code" 
              name="code" 
              placeholder="e.g. GP-XXXX-XXXX-XXXX" 
              class="flex-grow px-6 py-4 bg-gray-50 border border-gray-200 rounded-xl font-mono text-xl text-center focus:ring-4 focus:ring-brand-gold/20 focus:border-brand-gold outline-none transition-all uppercase"
            >
            <button type="submit" class="bg-brand-dark text-white px-8 py-4 rounded-xl font-bold text-lg hover:bg-black transition-all transform hover:-translate-y-1">
              Verify Now
            </button>
          </div>
          <p class="text-center text-xs text-gray-500">You can find the code on the security hologram on your product packaging.</p>
        </form>
      </div>

      {/* Trust Messaging */}
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
        <div class="flex gap-4">
          <div class="w-12 h-12 rounded-xl bg-brand-green/10 text-brand-green flex items-center justify-center flex-shrink-0">
             <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
          </div>
          <div>
            <h3 class="font-bold text-brand-dark mb-1">Secure Hologram</h3>
            <p class="text-sm text-gray-500">Our codes are tamper-proof and generated using secure cryptographic standards.</p>
          </div>
        </div>
        <div class="flex gap-4">
          <div class="w-12 h-12 rounded-xl bg-brand-gold/10 text-brand-gold flex items-center justify-center flex-shrink-0">
             <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          </div>
          <div>
            <h3 class="font-bold text-brand-dark mb-1">Instant Results</h3>
            <p class="text-sm text-gray-500">Get immediate feedback on product model, warranty status, and original manufacture date.</p>
          </div>
        </div>
      </div>

      {/* Report Fake CTA */}
      <div class="bg-red-50 border border-red-100 rounded-2xl p-8 text-center">
        <h3 class="text-xl font-bold text-red-800 mb-2">Code not working?</h3>
        <p class="text-red-700 mb-6 text-sm">If your code is rejected or the package was tampered with, please report it immediately. We take counterfeit products seriously.</p>
        <a href="/support/fake" class="inline-block px-6 py-2 bg-red-600 text-white rounded-lg font-bold hover:bg-red-700 transition-colors">Report Fake Product</a>
      </div>

    </div>
  </div>
</BaseLayout>
