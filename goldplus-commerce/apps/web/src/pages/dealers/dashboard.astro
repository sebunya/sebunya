---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { whatsappSupportNumber } from "../../lib/api";

/**
 * Dealer portal placeholder.
 *
 * This route previously rendered a hard-coded "Sample Dealer Store" with
 * invented figures (UGX 4,200,000 in sales, 42 stock items, account DLR-123)
 * and was publicly reachable and indexable. There is no dealer backend — no
 * dealer tables, no dealer API — so every number on it was fiction presented
 * as a real account.
 *
 * Until a real dealer portal exists this page states the truth and routes the
 * visitor to the channels that do work. It is noindex because it is an
 * account-adjacent utility page with nothing to rank for.
 */
// WhatsApp, not mailto: it is the channel a reply actually comes back on.
const supportWhatsapp = `https://wa.me/${whatsappSupportNumber}?text=${encodeURIComponent("Hello GoldPlus, I have a question about becoming a dealer.")}`;
---

<BaseLayout
  title="Dealer account | GoldPlus"
  description="How GoldPlus dealer accounts are managed."
  robotsMeta="noindex,follow"
>
  <main id="main-content" class="container mx-auto max-w-3xl px-4 py-16 lg:px-8">
    <p class="text-xs font-black uppercase tracking-[0.18em] text-brand-primary">Dealers</p>
    <h1 class="mt-3 text-3xl font-black tracking-tight text-gray-900 sm:text-4xl">Dealer account</h1>

    <p class="mt-6 text-base leading-relaxed text-slate-700">
      GoldPlus does not yet offer a self-service dealer portal. Dealer accounts, pricing and orders are handled
      directly by our team, so there is no dashboard to sign in to at this address.
    </p>

    <div class="mt-10 rounded-2xl border border-slate-200 bg-slate-50 p-6">
      <h2 class="font-black text-gray-900">If you are already a GoldPlus dealer</h2>
      <p class="mt-2 text-sm leading-relaxed text-slate-700">
        Contact your usual GoldPlus representative, or reach us through support, for pricing, stock availability and
        order status. Please have your business details ready so we can verify the account before discussing terms.
      </p>
      <div class="mt-5 flex flex-col gap-3 sm:flex-row">
        <a
          href="/support"
          class="inline-flex min-h-11 items-center justify-center rounded-full bg-slate-900 px-6 py-3 text-center text-sm font-bold text-white outline-none hover:bg-black focus-visible:ring-2 focus-visible:ring-slate-900 focus-visible:ring-offset-2"
        >Contact support</a>
        <a
          href={supportWhatsapp}
          class="inline-flex min-h-11 items-center justify-center rounded-full border border-slate-300 bg-white px-6 py-3 text-center text-sm font-bold text-slate-900 outline-none hover:border-slate-500 focus-visible:ring-2 focus-visible:ring-brand-primary"
        >Ask on WhatsApp</a>
      </div>
    </div>

    <div class="mt-6 rounded-2xl border border-slate-200 bg-white p-6">
      <h2 class="font-black text-gray-900">If you would like to become a dealer</h2>
      <p class="mt-2 text-sm leading-relaxed text-slate-700">
        Apply through the dealer application form. We review each application and respond with the next steps.
      </p>
      <a
        href="/dealers/apply"
        class="mt-5 inline-flex min-h-11 items-center justify-center rounded-full bg-brand-primary px-6 py-3 text-center text-sm font-bold text-white outline-none hover:opacity-90 focus-visible:ring-2 focus-visible:ring-brand-primary focus-visible:ring-offset-2"
      >Apply to become a dealer</a>
    </div>

    <p class="mt-10 text-sm text-slate-500">
      Looking for your own orders? <a class="underline decoration-slate-300 underline-offset-4 hover:text-gray-950" href="/account/orders">Your account</a>
      holds your order history and delivery details.
    </p>
  </main>
</BaseLayout>
