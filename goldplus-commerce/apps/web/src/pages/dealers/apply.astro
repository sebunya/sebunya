---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormField from '../../components/FormField.astro';
import FormFeedback from '../../components/FormFeedback.astro';
import { postJson } from '../../lib/api';

let status: 'success' | 'error' | 'received' | null = null;
let message: string | undefined;
let reference: string | undefined;
let values: Record<string, string> = {};

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const dto = {
    businessName: String(form.get('businessName') ?? '').trim(),
    contactName: String(form.get('contactName') ?? '').trim(),
    email: String(form.get('email') ?? '').trim(),
    phone: String(form.get('phone') ?? '').trim(),
    tinNumber: String(form.get('tinNumber') ?? '').trim(),
    location: String(form.get('location') ?? '').trim(),
  };
  values = dto;
  const missing = (['businessName', 'contactName', 'email', 'phone', 'tinNumber', 'location'] as const)
    .filter((k) => !dto[k]);
  if (missing.length > 0) {
    status = 'error';
    message = `Please fill in all required fields: ${missing.join(', ')}.`;
  } else {
    const result = await postJson('/governance/dealers/apply', dto);
    reference = result.ok ? result.reference : undefined;
    if (result.ok) {
      status = 'success';
      message = 'Application received. A GoldPlus partnerships officer will review your details and contact you on the email and phone provided.';
      values = {};
    } else {
      status = 'error';
      message = result.code === 'NETWORK'
        ? 'Cannot reach the application service right now. Please try again shortly.'
        : result.message;
    }
  }
}
---

<BaseLayout title="Apply to be a GoldPlus Dealer">
  <div class="bg-brand-dark text-white py-16 border-b border-gray-800">
    <div class="container mx-auto px-4 lg:px-8 text-center">
      <span class="inline-block py-1 px-3 rounded-full bg-brand-green/15 text-brand-green text-xs font-bold tracking-widest uppercase mb-4">
        Authorised dealership
      </span>
      <h1 class="text-3xl md:text-5xl font-black tracking-tight mb-4">Become a GoldPlus dealer</h1>
      <p class="text-gray-300 max-w-2xl mx-auto text-lg leading-relaxed">
        Partner with a trusted electronics brand. Verified stock, marketing support and protected pricing.
      </p>
    </div>
  </div>

  <div class="container mx-auto px-4 lg:px-8 py-16">
    <div class="max-w-3xl mx-auto">
      <FormFeedback status={status} message={message} reference={reference} />

      <div class="bg-white p-8 md:p-10 rounded-2xl border border-gray-200 shadow-xl">
        <h2 class="text-xl md:text-2xl font-bold text-brand-dark mb-6 pb-4 border-b border-gray-100">Application form</h2>

        <form method="POST" action="/dealers/apply" novalidate class="space-y-6">
          <FormField id="businessName" name="businessName" label="Business legal name" required defaultValue={values.businessName} autocomplete="organization" />
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <FormField id="contactName" name="contactName" label="Contact person" required defaultValue={values.contactName} autocomplete="name" />
            <FormField id="tinNumber" name="tinNumber" label="TIN number (URA)" required defaultValue={values.tinNumber} placeholder="100XXXXXXXX" />
            <FormField id="email" name="email" label="Business email" type="email" required defaultValue={values.email} autocomplete="email" />
            <FormField id="phone" name="phone" label="Business phone" type="tel" required defaultValue={values.phone} autocomplete="tel" inputmode="tel" />
          </div>
          <FormField id="location" name="location" label="Store location (street, town, district)" required defaultValue={values.location} />

          <div class="bg-gray-50 p-5 rounded-xl border border-gray-200">
            <h3 class="font-bold text-brand-dark mb-2 text-sm">Dealer commitment</h3>
            <p class="text-xs text-gray-600 leading-relaxed mb-3">
              By applying, you commit to selling only original GoldPlus products and observing recommended pricing and service standards.
            </p>
            <label class="flex items-center gap-3 cursor-pointer">
              <input type="checkbox" name="agree" required class="w-5 h-5 rounded border-gray-300 text-brand-green focus:ring-brand-green" />
              <span class="text-sm font-bold text-gray-700">I agree to the GoldPlus dealer terms</span>
            </label>
          </div>

          <button type="submit" class="w-full bg-brand-green text-white py-4 rounded-xl font-bold text-lg hover:opacity-90 focus-visible:ring-4 focus-visible:ring-brand-green/30 outline-none transition-all">
            Submit application
          </button>
        </form>
      </div>

      <p class="text-xs text-gray-500 text-center mt-6 leading-relaxed max-w-md mx-auto">
        We review applications in the order they arrive. Owner review required before a dealership is activated.
      </p>
    </div>
  </div>
</BaseLayout>
