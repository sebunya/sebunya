---
import BaseLayout from '../layouts/BaseLayout.astro';
import { policyBySlug, POLICY_STATUS_LABEL } from '../lib/legal-policies';
const policy = policyBySlug('returns')!;
import CmsPolicyDocument from '../components/CmsPolicyDocument.astro';
import { fetchPublishedPolicy } from '../lib/legalCms';
// Wave 2C: a PUBLISHED CMS version replaces the interim static wording below;
// until one exists this page keeps its truthful interim content unchanged.
const cms = await fetchPublishedPolicy('returns');
---

<BaseLayout title="Returns policy | GoldPlus">
  <main id="main-content">
    {cms ? <CmsPolicyDocument policy={cms} /> : <>
    <header class="border-b border-slate-200 bg-gradient-to-b from-slate-50 to-white py-12 sm:py-16">
      <div class="container mx-auto max-w-4xl px-4 lg:px-8">
        <p class="text-xs font-black uppercase tracking-[0.18em] text-brand-primary">Customer policy</p>
        <h1 class="mt-3 text-3xl font-black tracking-tight text-gray-900 sm:text-4xl">Returns policy</h1>
        <p class="mt-4 max-w-3xl text-sm leading-relaxed text-slate-600 sm:text-base">This draft explains how to start a return today. The formal returns policy, with exact windows and refund rules, is being prepared and reviewed.</p>
        <p class="mt-4 inline-flex flex-wrap items-center gap-2 text-xs font-bold text-slate-600">
          <span class="rounded-full border border-amber-300 bg-amber-50 px-3 py-1 text-amber-800">{POLICY_STATUS_LABEL[policy.status]}</span>
          <span class="rounded-full border border-slate-200 bg-slate-50 px-3 py-1">Version {policy.version}</span>
          <span class="rounded-full border border-slate-200 bg-slate-50 px-3 py-1">Effective date: {policy.effectiveDate ?? 'to be confirmed after legal review'}</span>
        </p>
      </div>
    </header>

    <div class="container mx-auto max-w-4xl px-4 py-10 sm:py-14 lg:px-8">
      <div class="space-y-10 text-sm leading-relaxed text-slate-700 sm:text-base">
        <section aria-labelledby="returns-how" class="scroll-mt-24">
          <h2 id="returns-how" class="text-xl font-black text-gray-900">How to start a return</h2>
          <p class="mt-3">Contact GoldPlus support with your order number, the product involved, and the reason for the return. The support team confirms the next steps, including whether the item should be brought to a GoldPlus location or collected.</p>
          <p class="mt-3">Keep the product, its packaging and your receipt or order confirmation until the return is resolved.</p>
        </section>
        <section aria-labelledby="returns-scope" class="scroll-mt-24">
          <h2 id="returns-scope" class="text-xl font-black text-gray-900">What this draft covers</h2>
          <p class="mt-3">Specific return windows, refund methods and condition requirements are being finalised in the formal policy. Until it takes effect, each return is assessed individually by the support team, and you will be told the outcome and reasons directly.</p>
          <p class="mt-3">Nothing on this page removes protections you have under applicable Ugandan consumer law.</p>
        </section>
        <section aria-labelledby="returns-contact" class="scroll-mt-24 rounded-2xl border border-slate-200 bg-slate-50 p-6">
          <h2 id="returns-contact" class="text-xl font-black text-gray-900">Start a return</h2>
          <p class="mt-3">The fastest way to start a return is through support — have your order number ready.</p>
          <div class="mt-5 flex flex-col gap-3 sm:flex-row">
            <a href="/support" class="rounded-full bg-slate-950 px-6 py-3 text-center text-sm font-bold text-white hover:bg-brand-primary hover:text-slate-950">Contact support</a>
            <a href="/track-order" class="rounded-full border border-slate-300 px-6 py-3 text-center text-sm font-bold text-slate-800">Find my order</a>
          </div>
        </section>
      </div>
    </div>
  </>}
  </main>
</BaseLayout>
