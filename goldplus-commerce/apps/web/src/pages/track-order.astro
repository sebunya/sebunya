---
import BaseLayout from '../layouts/BaseLayout.astro';
import FormField from '../components/FormField.astro';
import FormFeedback from '../components/FormFeedback.astro';
import Notice from '../components/Notice.astro';
import { apiBase, type ApiEnvelope } from '../lib/api';

interface OrderItem {
  productId: string;
  sku: string;
  name: string;
  price: number;
  quantity: number;
}

interface Order {
  id: string;
  orderNumber: string;
  customerName: string;
  customerPhone: string;
  customerEmail?: string;
  deliveryArea: string;
  deliveryAddress: string;
  buyerType: string;
  items: OrderItem[];
  subtotalUgx: number;
  deliveryFeeUgx: number;
  totalUgx: number;
  paymentStatus: string;
  orderStatus: string;
  createdAt: string;
}

let status: 'success' | 'error' | null = null;
let message: string | undefined;
let order: Order | null = null;
let isOfflineDraft = false;
let draftReference: string | undefined;
let values: { orderReference?: string; customerContact?: string } = {};

const formatUgx = (n: number) =>
  new Intl.NumberFormat('en-UG', { style: 'currency', currency: 'UGX', maximumFractionDigits: 0 }).format(n);

const maskPhone = (phone: string) => {
  if (phone.length <= 5) return '*****';
  return phone.slice(0, 3) + '****' + phone.slice(-3);
};

const maskEmail = (email: string) => {
  const parts = email.split('@');
  if (parts.length !== 2) return '*****';
  const name = parts[0];
  const domain = parts[1];
  if (name.length <= 2) return '*@' + domain;
  return name.slice(0, 1) + '***' + name.slice(-1) + '@' + domain;
};

// Handle Form POST Submission
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const orderReference = String(form.get('orderReference') ?? '').trim();
  const customerContact = String(form.get('customerContact') ?? '').trim().toLowerCase();
  
  values = { orderReference, customerContact };

  if (!orderReference || !customerContact) {
    status = 'error';
    message = 'Please provide both the order reference number and your contact details (phone or email).';
  } else if (orderReference.toUpperCase().startsWith('GP-DRAFT-')) {
    isOfflineDraft = true;
    draftReference = orderReference.toUpperCase();
    status = 'success';
  } else {
    try {
      const res = await fetch(`${apiBase}/commerce/orders/${encodeURIComponent(orderReference)}`);
      
      if (res.status === 404) {
        status = 'error';
        message = 'We could not find any order with that reference. Please check and try again.';
      } else if (!res.ok) {
        status = 'error';
        message = `Unable to connect to order services (HTTP ${res.status}).`;
      } else {
        const json = (await res.json()) as ApiEnvelope<Order>;
        
        if (json.success && json.data) {
          const matchedOrder = json.data;
          const storedEmail = (matchedOrder.customerEmail ?? '').trim().toLowerCase();
          const storedPhone = (matchedOrder.customerPhone ?? '').trim();

          const contactMatch =
            (storedEmail && customerContact === storedEmail) ||
            (storedPhone && customerContact.replace(/\s+/g, '') === storedPhone.replace(/\s+/g, ''));

          if (contactMatch) {
            order = matchedOrder;
            status = 'success';
          } else {
            status = 'error';
            message = 'The contact details provided do not match our records for this order reference. For security reasons, please verify and try again.';
          }
        } else {
          status = 'error';
          message = json.error?.message ?? 'Could not parse order details.';
        }
      }
    } catch (err) {
      status = 'error';
      message = 'The order tracking service is currently unreachable. Please try again shortly.';
    }
  }
}

// Status translation display names and badges
const statusBadge: Record<string, { label: string; class: string }> = {
  received: { label: 'Received', class: 'bg-indigo-50 text-indigo-700 border-indigo-200' },
  pending_payment: { label: 'Pending Payment', class: 'bg-orange-50 text-orange-700 border-orange-200' },
  pending_owner_review: { label: 'Review Required', class: 'bg-amber-50 text-amber-700 border-amber-200' },
  processing: { label: 'Processing', class: 'bg-blue-50 text-blue-700 border-blue-200' },
  completed: { label: 'Completed', class: 'bg-green-50 text-green-700 border-green-200' },
  cancelled: { label: 'Cancelled', class: 'bg-gray-100 text-gray-700 border-gray-200' },
  failed: { label: 'Failed', class: 'bg-red-50 text-red-700 border-red-200' },
};
---

<BaseLayout title="Track Your Order - GoldPlus">
  <div class="bg-brand-softGrey py-10 border-b border-brand-borderGrey">
    <div class="container mx-auto px-4 lg:px-8">
      <h1 class="text-2xl md:text-3xl font-black tracking-tight text-brand-charcoal mb-2">Track your order</h1>
      <p class="text-brand-mutedGrey max-w-xl">Enter your order reference and contact details below to check delivery status and checkout details.</p>
    </div>
  </div>

  <div class="container mx-auto px-4 lg:px-8 py-12">
    <div class="max-w-4xl mx-auto">
      
      {/* Form State */}
      {(!order && !isOfflineDraft) && (
        <div class="max-w-md mx-auto">
          <FormFeedback status={status} message={message} />
          
          <form method="POST" action="/track-order" novalidate class="bg-white p-6 md:p-8 rounded-2xl border border-brand-borderGrey shadow-sm space-y-5 mt-4">
            <FormField 
              id="orderReference" 
              name="orderReference" 
              label="Order reference or number" 
              placeholder="e.g. GP-202605-A1B2 or UUID" 
              required 
              defaultValue={values.orderReference} 
            />
            
            <FormField 
              id="customerContact" 
              name="customerContact" 
              label="Email or phone used at checkout" 
              placeholder="e.g. 0770000000 or customer@mail.com" 
              required 
              defaultValue={values.customerContact} 
            />
            
            <button
              type="submit"
              class="w-full bg-brand-primary text-brand-charcoal py-3 rounded-lg font-bold hover:opacity-90 focus-visible:ring-4 focus-visible:ring-brand-primary/30 outline-none"
            >
              Verify & Find Order
            </button>
            
            <p class="text-xs text-brand-mutedGrey text-center leading-relaxed">
              We value your privacy. Real-time verification protects order details and delivery coordinates.
            </p>
          </form>
        </div>
      )}

      {/* RENDER SUCCESS STATE: Real Order Detail */}
      {order && (
        <div class="space-y-6">
          <div class="flex items-center justify-between pb-6 border-b border-brand-borderGrey">
            <div>
              <a href="/track-order" class="text-sm font-bold text-brand-mutedGrey hover:text-brand-charcoal mb-3 inline-block">&larr; Look up another order</a>
              <h2 class="text-3xl font-black text-brand-charcoal tracking-tight">{order.orderNumber}</h2>
              <p class="text-xs text-brand-mutedGrey mt-1">Placed {new Date(order.createdAt).toLocaleDateString('en-GB')} at {new Date(order.createdAt).toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' })}</p>
            </div>
            
            <div class="text-right">
              <span class={`inline-flex items-center px-3 py-1 rounded border text-xs font-bold uppercase tracking-wider ${statusBadge[order.orderStatus]?.class ?? 'bg-gray-50 text-gray-700 border-gray-200'}`}>
                {statusBadge[order.orderStatus]?.label ?? 'Received'}
              </span>
            </div>
          </div>

          {/* Visual Order Progress Timeline */}
          <div class="bg-white border border-brand-borderGrey rounded-2xl p-6 md:p-8">
            <h3 class="text-xs font-bold uppercase tracking-widest text-brand-mutedGrey mb-6">Delivery status progress</h3>
            
            <div class="relative flex flex-col md:flex-row justify-between gap-6 md:gap-0">
              <div class="absolute top-1/2 left-0 w-full h-0.5 bg-gray-100 -translate-y-1/2 hidden md:block" aria-hidden="true"></div>
              
              {/* Timeline Steps */}
              {['received', 'processing', 'completed'].map((step, idx) => {
                const isCurrent = order.orderStatus === step;
                const isPast = 
                  (step === 'received' && (order.orderStatus === 'processing' || order.orderStatus === 'completed')) ||
                  (step === 'processing' && order.orderStatus === 'completed');
                
                const labels = {
                  received: 'Order Received',
                  processing: 'In Processing',
                  completed: 'Completed / Delivered'
                };
                
                return (
                  <div class="relative flex items-center md:flex-col gap-4 md:gap-2 z-10 md:w-1/3 text-left md:text-center">
                    <div class={`w-10 h-10 rounded-full flex items-center justify-center border font-bold text-sm transition-all duration-300 ${
                      isCurrent ? 'bg-brand-primary border-brand-primary text-brand-charcoal scale-110 shadow-sm' :
                      isPast ? 'bg-green-50 border-green-300 text-green-700' :
                      'bg-white border-gray-200 text-gray-400'
                    }`}>
                      {isPast ? '✓' : idx + 1}
                    </div>
                    <div>
                      <p class={`font-bold text-sm ${isCurrent ? 'text-brand-charcoal' : 'text-brand-mutedGrey'}`}>{labels[step]}</p>
                      <p class="text-xs text-brand-mutedGrey mt-0.5">
                        {step === 'received' && 'Awaiting zone logistics'}
                        {step === 'processing' && 'Fulfilling hardware'}
                        {step === 'completed' && 'Settled successfully'}
                      </p>
                    </div>
                  </div>
                );
              })}
            </div>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            
            {/* Items Summary list */}
            <div class="bg-white border border-brand-borderGrey rounded-2xl overflow-hidden lg:col-span-2 shadow-sm">
              <h3 class="text-xs font-bold uppercase tracking-widest text-brand-mutedGrey px-6 pt-6 mb-3">Order items</h3>
              <ul class="divide-y divide-brand-borderGrey" aria-label="Items ordered">
                {order.items.map((item) => (
                  <li class="p-6 flex items-start gap-4">
                    <div class="flex-grow min-w-0">
                      <p class="font-bold text-brand-charcoal">{item.name}</p>
                      <p class="text-xs text-brand-mutedGrey mt-1">SKU: {item.sku}</p>
                      <p class="text-sm text-brand-mutedGrey mt-1">Qty {item.quantity} × {formatUgx(item.price)}</p>
                    </div>
                    <p class="font-bold text-brand-charcoal whitespace-nowrap">{formatUgx(item.price * item.quantity)}</p>
                  </li>
                ))}
              </ul>
              <div class="bg-brand-softGrey border-t border-brand-borderGrey p-6 space-y-2 text-sm">
                <div class="flex justify-between text-brand-mutedGrey">
                  <span>Subtotal</span>
                  <span class="font-bold text-brand-charcoal">{formatUgx(order.subtotalUgx)}</span>
                </div>
                <div class="flex justify-between text-brand-mutedGrey">
                  <span>Delivery fee</span>
                  <span class="font-bold text-brand-charcoal">{order.deliveryFeeUgx === 0 ? 'Calculated post-zone' : formatUgx(order.deliveryFeeUgx)}</span>
                </div>
                <div class="flex justify-between text-brand-charcoal text-base font-bold pt-3 border-t border-brand-borderGrey">
                  <span>Grand total</span>
                  <span class="text-lg font-black">{formatUgx(order.totalUgx)}</span>
                </div>
              </div>
            </div>

            {/* Delivery & Customer Info */}
            <div class="space-y-6 lg:col-span-1">
              <section class="bg-white border border-brand-borderGrey rounded-2xl p-6 shadow-sm">
                <h3 class="text-xs font-bold uppercase tracking-widest text-brand-mutedGrey mb-3">Customer contact</h3>
                <p class="font-bold text-brand-charcoal break-all">{order.customerName}</p>
                <p class="text-sm text-brand-mutedGrey mt-1 break-all">{maskPhone(order.customerPhone)}</p>
                {order.customerEmail && <p class="text-sm text-brand-mutedGrey mt-0.5 break-all">{maskEmail(order.customerEmail)}</p>}
              </section>

              <section class="bg-white border border-brand-borderGrey rounded-2xl p-6 shadow-sm">
                <h3 class="text-xs font-bold uppercase tracking-widest text-brand-mutedGrey mb-3">Delivery coordinates</h3>
                <p class="font-bold text-brand-charcoal">{order.deliveryArea}</p>
                <p class="text-sm text-brand-mutedGrey mt-1 leading-relaxed">{order.deliveryAddress || 'No additional landmark provided.'}</p>
              </section>

              {/* WhatsApp Handoff Action */}
              <a
                href={`https://wa.me/256000000000?text=Hello%20GoldPlus%20team,%20I'm%20inquiring%20about%20order%20${encodeURIComponent(order.orderNumber)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full bg-brand-charcoal hover:bg-black text-white py-4 px-6 rounded-xl font-bold flex items-center justify-center gap-2 shadow-sm text-center"
              >
                <svg class="w-5 h-5 text-green-400" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946C.06 5.348 5.397.01 12.008.01c3.202.001 6.212 1.246 8.477 3.513 2.262 2.268 3.507 5.28 3.505 8.484-.004 6.657-5.34 11.997-11.953 11.997-2.005-.001-3.973-.502-5.754-1.458L0 24zM6.59 5.86c-.22-.492-.452-.503-.66-.512-.17-.008-.364-.007-.56-.007-.195 0-.514.073-.783.366-.268.293-1.026 1.002-1.026 2.441 0 1.439 1.047 2.829 1.193 3.023.147.195 2.059 3.145 4.988 4.41.698.302 1.242.482 1.668.618.7.223 1.34.191 1.844.116.563-.083 1.732-.708 1.977-1.393.243-.684.243-1.27.17-1.393-.073-.122-.268-.195-.561-.341-.293-.146-1.732-.853-2.001-.951-.269-.098-.464-.147-.66.146-.195.293-.757.951-.928 1.147-.171.195-.342.22-.635.073-.293-.146-1.238-.457-2.36-1.457-.872-.777-1.46-1.738-1.631-2.03-.171-.293-.018-.452.129-.597.132-.131.293-.342.44-.512.146-.17.195-.293.293-.488.097-.195.048-.366-.024-.512-.072-.147-.66-1.59-.904-2.18z"></path></svg>
                Chat with Agent on WhatsApp
              </a>
            </div>
          </div>

          {/* Customer Trust Copy */}
          <div class="bg-amber-50 border border-amber-100 rounded-2xl p-6 text-sm text-amber-900 leading-relaxed shadow-sm">
            <h4 class="font-bold text-base text-amber-950 mb-2">What happens next?</h4>
            <p class="mb-3">
              1. **Order Audit**: Our logistics coordinators in Kampala review this submission to confirm product availability and calculate the optimized route delivery fee.
            </p>
            <p class="mb-3">
              2. **Agent Direct Contact**: An authorized GoldPlus customer trust representative will contact you via WhatsApp or telephone to confirm delivery timing and initiate the secure Mobile Money checkout.
            </p>
            <p>
              3. **No Automatic Payment**: GoldPlus will **never** charge your mobile money wallet automatically. Payment will only be executed directly to our verified merchant Till or upon physical zone delivery confirmation.
            </p>
          </div>
        </div>
      )}

      {/* RENDER SUCCESS STATE: Local Demo Draft */}
      {isOfflineDraft && (
        <div class="max-w-2xl mx-auto text-center py-12 bg-white border border-brand-borderGrey rounded-3xl shadow-sm px-6">
          <div class="w-20 h-20 bg-amber-100 text-amber-600 rounded-full flex items-center justify-center mx-auto mb-6">
            <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
          </div>
          <h2 class="text-3xl font-black text-brand-charcoal mb-2">Offline Draft Saved</h2>
          <p class="text-xs font-bold text-amber-800 bg-amber-50 border border-amber-200 px-3 py-1 rounded-full inline-block mb-6 uppercase tracking-wider">Local Demo Mode Only</p>
          <p class="text-gray-600 text-lg mb-6">Local Draft Reference: <strong class="font-mono bg-gray-100 px-2 py-0.5 rounded text-brand-charcoal">{draftReference}</strong></p>
          
          <div class="text-left bg-amber-50 border border-amber-200 p-6 rounded-2xl mb-8 space-y-4">
            <p class="text-amber-900 text-sm font-semibold leading-relaxed">
              Notice: The server was offline when this draft was recorded. This draft has <strong>not</strong> been submitted to the GoldPlus distribution team.
            </p>
            <p class="text-amber-800 text-xs leading-relaxed">
              If this was done during a local demonstration, you can continue exploring the catalog or choose to retry checkout once the local Hono API server has been fully configured and turned online.
            </p>
          </div>

          <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            <a href="/track-order" class="w-full sm:w-auto inline-block border border-brand-borderGrey hover:bg-gray-50 text-brand-charcoal px-8 py-3 rounded-xl font-bold transition-all">Look up another reference</a>
            <a
              href={`https://wa.me/256000000000?text=Hello%20GoldPlus,%20I'm%20submitting%20an%20offline%20draft%20reference%20${encodeURIComponent(draftReference ?? '')}`}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full sm:w-auto inline-block bg-brand-charcoal text-white px-8 py-3 rounded-xl font-bold hover:bg-black transition-all"
            >
              Contact Agent via WhatsApp
            </a>
          </div>
        </div>
      )}

    </div>
  </div>
</BaseLayout>
