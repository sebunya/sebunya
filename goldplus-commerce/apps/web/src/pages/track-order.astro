---
import BaseLayout from '../layouts/BaseLayout.astro';
import { whatsappSupportNumber } from '../lib/api';

const orderHelpWhatsappUrl = `https://wa.me/${whatsappSupportNumber}?text=${encodeURIComponent(
  'Hello GoldPlus, I need help with an order. I have my order reference ready.'
)}`;
---

<BaseLayout title="Order help | GoldPlus">
  <main>
    <section class="border-b border-slate-100 bg-gradient-to-b from-slate-50 to-white py-12 sm:py-16">
      <div class="container mx-auto px-4 lg:px-8">
        <a href="/support" class="text-xs font-bold text-slate-600 underline decoration-slate-300 underline-offset-4 hover:text-gray-900 focus-visible:ring-2 focus-visible:ring-brand-primary">&larr; Customer support</a>
        <p class="mt-8 text-xs font-black uppercase tracking-[0.18em] text-brand-primary">Order support</p>
        <h1 class="mt-3 text-3xl font-black tracking-tight text-gray-900 sm:text-4xl">Need help with an order?</h1>
        <p class="mt-4 max-w-2xl text-sm leading-relaxed text-slate-600 sm:text-base">
          Have your order reference ready. GoldPlus support will help verify the order information available to us.
        </p>
      </div>
    </section>

    <section class="container mx-auto px-4 py-10 sm:py-14 lg:px-8">
      <div class="mx-auto grid max-w-5xl grid-cols-1 gap-6 lg:grid-cols-[1.2fr_0.8fr]">
        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-xs sm:p-8">
          <h2 class="text-2xl font-black text-gray-900">Before you contact support</h2>
          <ol class="mt-6 space-y-5" aria-label="Information to prepare for order support">
            <li class="flex gap-4">
              <span aria-hidden="true" class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-brand-primary text-sm font-black text-gray-950">1</span>
              <div>
                <h3 class="font-black text-gray-900">Find your order reference</h3>
                <p class="mt-1 text-sm leading-relaxed text-slate-600">Use the reference shown after checkout or on any genuine order record you received.</p>
              </div>
            </li>
            <li class="flex gap-4">
              <span aria-hidden="true" class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-brand-primary text-sm font-black text-gray-950">2</span>
              <div>
                <h3 class="font-black text-gray-900">Keep your checkout contact ready</h3>
                <p class="mt-1 text-sm leading-relaxed text-slate-600">Support may ask for the phone number or email used at checkout to protect order details.</p>
              </div>
            </li>
            <li class="flex gap-4">
              <span aria-hidden="true" class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-brand-primary text-sm font-black text-gray-950">3</span>
              <div>
                <h3 class="font-black text-gray-900">Ask us to verify</h3>
                <p class="mt-1 text-sm leading-relaxed text-slate-600">Tell support what you need checked. Do not post payment credentials, passwords or one-time codes.</p>
              </div>
            </li>
          </ol>

          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a
              href={orderHelpWhatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Open GoldPlus order support on WhatsApp in a new tab"
              class="inline-flex min-h-12 flex-1 items-center justify-center rounded-full bg-slate-900 px-6 py-3 text-center text-xs font-black uppercase tracking-wider text-white outline-none transition hover:bg-black focus-visible:ring-2 focus-visible:ring-slate-900 focus-visible:ring-offset-2"
            >
              Ask on WhatsApp
            </a>
            <a href="/support" class="inline-flex min-h-12 flex-1 items-center justify-center rounded-full border border-slate-300 px-6 py-3 text-center text-xs font-black uppercase tracking-wider text-slate-800 outline-none transition hover:border-slate-900 focus-visible:ring-2 focus-visible:ring-brand-primary">See all support options</a>
          </div>
          <p class="mt-4 text-center text-xs leading-relaxed text-slate-500">WhatsApp opens as a link. No message is sent automatically.</p>
        </div>

        <aside aria-labelledby="order-status-truth" class="rounded-2xl border border-amber-200 bg-amber-50/60 p-6 sm:p-8">
          <h2 id="order-status-truth" class="text-xl font-black text-amber-950">What this page does—and does not—show</h2>
          <p class="mt-4 text-sm leading-relaxed text-amber-900">
            This is an order-help page, not live courier tracking. It does not confirm payment, product availability, dispatch, delivery status or an arrival time.
          </p>
          <p class="mt-4 text-sm leading-relaxed text-amber-900">
            Support will verify the details available for your order. Delivery timing depends on the order, product availability and location.
          </p>
          <p class="mt-4 text-sm font-bold leading-relaxed text-amber-950">
            An order reference alone is not proof that an order is paid, confirmed or dispatched.
          </p>
        </aside>
      </div>
    </section>

    <section aria-labelledby="order-policy-help" class="border-y border-slate-200 bg-slate-50/70">
      <div class="container mx-auto px-4 py-10 lg:px-8">
        <div class="mx-auto max-w-5xl">
          <h2 id="order-policy-help" class="text-2xl font-black text-gray-900">Returns, warranty and terms</h2>
          <p class="mt-3 max-w-3xl text-sm leading-relaxed text-slate-600">
            Warranty and returns are subject to the applicable GoldPlus policy and your order details. Contact support before returning an item so the relevant policy can be confirmed.
          </p>
          <nav aria-label="Order policy help" class="mt-6 flex flex-wrap gap-3">
            <a href="/support#returns-warranty" class="inline-flex min-h-11 items-center rounded-full border border-slate-300 bg-white px-5 py-3 text-xs font-bold text-slate-800 outline-none hover:border-slate-900 focus-visible:ring-2 focus-visible:ring-brand-primary">Returns help</a>
            <a href="/support#returns-warranty" class="inline-flex min-h-11 items-center rounded-full border border-slate-300 bg-white px-5 py-3 text-xs font-bold text-slate-800 outline-none hover:border-slate-900 focus-visible:ring-2 focus-visible:ring-brand-primary">Warranty help</a>
            <a href="/support#terms-guidance" class="inline-flex min-h-11 items-center rounded-full border border-slate-300 bg-white px-5 py-3 text-xs font-bold text-slate-800 outline-none hover:border-slate-900 focus-visible:ring-2 focus-visible:ring-brand-primary">Terms guidance</a>
            <a href="/support#privacy-guidance" class="inline-flex min-h-11 items-center rounded-full border border-slate-300 bg-white px-5 py-3 text-xs font-bold text-slate-800 outline-none hover:border-slate-900 focus-visible:ring-2 focus-visible:ring-brand-primary">Privacy guidance</a>
          </nav>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
