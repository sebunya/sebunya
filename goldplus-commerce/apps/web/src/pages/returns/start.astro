---
/**
 * Start a return (gap analysis #8). The shopper proves the order the same way order tracking and reviews do
 * (reference + the phone or email used at checkout; the API applies the shared lockout), then picks the item, the
 * reason and how it comes back. The request becomes a Care Desk task; the customer gets the usual "we have your
 * request" text, and a person calls. Nothing is refunded or approved by this page: the published policy is applied
 * by staff, except the 14-day change-of-mind window, which is checked here so nobody is promised what the policy
 * does not give.
 */
import { readClientAddress } from '../../lib/forwardClient';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { postJson, whatsappSupportNumber } from '../../lib/api';
import { readGuestMemory, rememberedContact } from '../../lib/guestMemory';
import RememberedDetails from '../../components/RememberedDetails.astro';

type Item = { productId: string; name: string };
const REASONS: Array<[string, string]> = [
  ['faulty', 'It does not work properly'],
  ['damaged', 'It arrived damaged'],
  ['wrong_item', 'It is not what I ordered'],
  ['changed_mind', 'I changed my mind (within 14 days)'],
  ['other', 'Something else'],
];
let reference = (Astro.url.searchParams.get('reference') ?? '').trim().slice(0, 80);
let contact = '';
let items: Item[] | null = null;
let delivered = false;
let orderNumber = '';
let errorMsg = '';
let doneFor = '';
let alreadyOpen = false;
let itemError: { productId: string; message: string } | null = null;
let contactRemembered = false;

const eligibility = () => postJson('/commerce/reviews/eligibility', { reference, contact }, null, readClientAddress(Astro));
const load = (data: unknown) => {
  const d = data as { orderNumber?: string; delivered?: boolean; items?: Item[] };
  orderNumber = String(d.orderNumber ?? reference);
  delivered = Boolean(d.delivered);
  items = Array.isArray(d.items) ? d.items.map((i) => ({ productId: i.productId, name: i.name })) : [];
};

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = String(form.get('intent') ?? 'lookup');
  reference = String(form.get('reference') ?? '').trim().slice(0, 80);
  contact = String(form.get('contact') ?? '').trim().slice(0, 120);
  if (!reference || !contact) {
    errorMsg = 'Enter both your order reference and the phone number or email used at checkout.';
  } else {
    if (intent === 'submit') {
      const productId = String(form.get('productId') ?? '');
      const res = await postJson('/commerce/orders/return-request', {
        reference, contact, productId,
        reason: String(form.get('reason') ?? ''),
        preference: String(form.get('preference') ?? ''),
        detail: String(form.get('detail') ?? '').slice(0, 1000),
      }, null, readClientAddress(Astro));
      if (res.ok) {
        doneFor = String(form.get('productName') ?? 'that item');
        alreadyOpen = Boolean((res.data as { alreadyOpen?: boolean } | undefined)?.alreadyOpen);
      } else itemError = { productId, message: res.message ?? 'We could not take that request. Please try again.' };
    }
    const result = await eligibility();
    if (!result.ok) {
      errorMsg = result.code === 'NETWORK'
        ? 'We cannot reach the order service right now. Please try again shortly.'
        : (result.message ?? 'We could not verify that order. Please check your reference and contact details.');
    } else load(result.data);
  }
}
if (Astro.request.method === 'GET') {
  contact = rememberedContact(readGuestMemory(Astro.cookies, Astro.request));
  contactRemembered = Boolean(contact);
  if (reference && contact) {
    const auto = await eligibility();
    if (auto.ok) load(auto.data);
  }
}
const helpUrl = `https://wa.me/${whatsappSupportNumber}?text=${encodeURIComponent(`Hello GoldPlus, I need help with a return${orderNumber ? ` for order ${orderNumber}` : ''}.`)}`;
---
<BaseLayout robotsMeta="noindex,follow" title="Start a return | GoldPlus" description="Return or report a problem with an item from your GoldPlus order.">
  <div class="mx-auto max-w-xl px-4 py-10 sm:py-14">
    <p class="text-xs font-black uppercase tracking-[0.18em] text-brand-primaryInk">Your order</p>
    <h1 class="mt-3 text-3xl font-black tracking-tight text-gray-900 sm:text-4xl" style="text-wrap:balance">Return or report a problem</h1>
    <p class="mt-3 text-base text-slate-600">Tell us which item and what happened. Our team calls you on your order's phone number to arrange the next step. <a class="font-bold underline" href="/returns">Read the returns policy</a>.</p>

    <RememberedDetails show={contactRemembered} back="/returns/start" class="mt-4" />
    {errorMsg && <p role="alert" class="mt-6 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-semibold text-red-800">{errorMsg}</p>}
    {doneFor && (
      <p role="status" class="mt-6 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-semibold text-emerald-800" data-return-received>
        {alreadyOpen
          ? <>We already have a request for {doneFor} on order {orderNumber}. Our team will call you; there is no need to send it again.</>
          : <>We have your request for {doneFor}. Our team will call you on your order's phone number. Keep the item, its box and everything that came with it until then.</>}
      </p>
    )}

    {!items && (
      <form method="POST" action="/returns/start" class="mt-6 space-y-4">
        <input type="hidden" name="intent" value="lookup" />
        <label class="block">
          <span class="text-sm font-bold text-gray-900">Order reference</span>
          <input name="reference" required value={reference} autocomplete="off" placeholder="GP-…" class="mt-1 w-full min-h-11 rounded-lg border border-slate-300 px-3 py-2.5 text-base outline-none focus:ring-2 focus:ring-brand-primaryInk" />
        </label>
        <label class="block">
          <span class="text-sm font-bold text-gray-900">Phone number or email used at checkout</span>
          <input name="contact" required value={contact} autocomplete="tel" class="mt-1 w-full min-h-11 rounded-lg border border-slate-300 px-3 py-2.5 text-base outline-none focus:ring-2 focus:ring-brand-primaryInk" />
        </label>
        <button type="submit" class="inline-flex min-h-12 items-center justify-center rounded-full bg-brand-primary px-6 text-xs font-black uppercase tracking-widest text-brand-black">Find my order</button>
      </form>
    )}

    {items && !delivered && (
      <div class="mt-6 rounded-xl border border-slate-200 bg-white px-4 py-4 text-sm text-slate-700">
        <p class="font-bold text-gray-900">Order {orderNumber} has not reached you yet.</p>
        <p class="mt-1">A return starts once it is delivered or collected. Something wrong with the order before then? <a class="font-bold underline" href={helpUrl} target="_blank" rel="noopener noreferrer">Message us on WhatsApp</a> or <a class="font-bold underline" href={`/track-order?reference=${encodeURIComponent(reference)}`}>track it</a>.</p>
      </div>
    )}

    {items && delivered && (
      <div class="mt-6 space-y-5">
        {items.map((it) => (
          <details class="rounded-2xl border border-slate-200 bg-white" open={items!.length === 1 || itemError?.productId === it.productId}>
            <summary class="flex min-h-12 cursor-pointer items-center justify-between gap-3 px-4 font-bold text-gray-900 sm:px-5">{it.name}<span class="text-xs font-semibold text-slate-500">Return or report</span></summary>
            <form method="POST" action="/returns/start" class="border-t border-slate-100 p-4 sm:p-5" data-return-form>
              <input type="hidden" name="intent" value="submit" />
              <input type="hidden" name="reference" value={reference} />
              <input type="hidden" name="contact" value={contact} />
              <input type="hidden" name="productId" value={it.productId} />
              <input type="hidden" name="productName" value={it.name} />
              <fieldset>
                <legend class="text-sm font-semibold text-slate-700">What happened?</legend>
                <div class="mt-2 space-y-2">
                  {REASONS.map(([value, label]) => (
                    <label class="flex min-h-11 items-center gap-3 rounded-lg border border-slate-200 px-3 text-sm text-slate-800">
                      <input type="radio" name="reason" value={value} required class="h-4 w-4" />{label}
                    </label>
                  ))}
                </div>
              </fieldset>
              <fieldset class="mt-4">
                <legend class="text-sm font-semibold text-slate-700">How should it come back to us?</legend>
                <div class="mt-2 space-y-2">
                  <label class="flex min-h-11 items-center gap-3 rounded-lg border border-slate-200 px-3 text-sm text-slate-800"><input type="radio" name="preference" value="bring_to_shop" required class="h-4 w-4" />I will bring it to the shop</label>
                  <label class="flex min-h-11 items-center gap-3 rounded-lg border border-slate-200 px-3 text-sm text-slate-800"><input type="radio" name="preference" value="collect" class="h-4 w-4" />Please collect it</label>
                </div>
              </fieldset>
              <label class="mt-4 block">
                <span class="text-sm font-semibold text-slate-700">Tell us more <span class="font-normal text-slate-500">(needed for a fault or "something else")</span></span>
                <textarea name="detail" maxlength="1000" rows="3" placeholder="For example: it stopped charging after two days" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2.5 text-base outline-none focus:ring-2 focus:ring-brand-primaryInk"></textarea>
              </label>
              {itemError && itemError.productId === it.productId && <p role="alert" class="mt-3 text-sm font-semibold text-red-700">{itemError.message}</p>}
              <p class="mt-3 text-xs text-slate-500">For a change of mind, the item comes back unused and complete, and getting it to us is at your cost. A faulty item is replaced or refunded at our cost.</p>
              <button type="submit" class="mt-4 inline-flex min-h-12 items-center justify-center rounded-full bg-brand-primary px-6 text-xs font-black uppercase tracking-widest text-brand-black">Send my request</button>
            </form>
          </details>
        ))}
      </div>
    )}
  </div>
</BaseLayout>
