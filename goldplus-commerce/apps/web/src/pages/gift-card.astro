---
import BaseLayout from '../layouts/BaseLayout.astro';
import { postJson } from '../lib/api';
import { readClientAddress } from '../lib/forwardClient';
import { formatUgx } from '../lib/money';

/** Check a gift card or store credit balance (gap analysis #17). The code holder sees the balance, nothing else. */
let code = '';
let result: { kind: string; masked: string; balanceUgx: number; usable: boolean; reason: string | null } | null = null;
let error = '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  code = String(form.get('code') ?? '').trim().slice(0, 40);
  const res = await postJson('/commerce/credit/check', { code }, null, readClientAddress(Astro));
  if (res.ok) result = res.data as typeof result;
  else error = 'That code is not right. Check each character (it starts with GPGC or GPSC), or call us.';
}
Astro.response.headers.set('Cache-Control', 'private, no-store');
---
<BaseLayout title="Gift card balance | GoldPlus" description="Check the balance of a GoldPlus gift card or store credit." robotsMeta="noindex,follow">
  <div class="mx-auto max-w-xl px-4 py-10 sm:py-14" data-gift-card-check>
    <h1 class="text-3xl font-black tracking-tight text-gray-900">Gift card and store credit</h1>
    <p class="mt-3 text-base text-slate-600">Type the code to see what it is worth. Use it at checkout, in the "Gift card or store credit" box, or in the shop.</p>
    <p class="mt-3 text-base text-slate-600">Want to give one? <a href="/gift-card/buy" class="font-bold underline">Send a gift card</a>: pay with Mobile Money or card and we text them the code.</p>
    <form method="POST" action="/gift-card" class="mt-6 space-y-4">
      <label class="block"><span class="text-sm font-bold text-gray-900">Code</span>
        <input name="code" required value={code} autocomplete="off" autocapitalize="characters" spellcheck="false" placeholder="GPGC-XXXX-XXXX-XXXX" class="mt-1 w-full min-h-11 rounded-lg border border-slate-300 px-3 py-2.5 text-base font-bold uppercase tracking-wider outline-none focus:ring-2 focus:ring-brand-primaryInk" />
      </label>
      <button type="submit" class="inline-flex min-h-12 items-center rounded-full bg-brand-primary px-6 text-xs font-black uppercase tracking-widest text-brand-black">Check balance</button>
    </form>
    {error && <p role="alert" class="mt-6 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-semibold text-red-800">{error}</p>}
    {result && (
      <div class={`mt-6 rounded-2xl border p-5 ${result.usable ? 'border-emerald-200 bg-emerald-50' : 'border-amber-200 bg-amber-50'}`} role="status">
        <p class="text-sm font-bold text-gray-900">{result.kind === 'gift_card' ? 'Gift card' : 'Store credit'} {result.masked}</p>
        <p class="mt-1 text-2xl font-black tabular-nums text-gray-900">{formatUgx(result.balanceUgx)}</p>
        <p class="mt-1 text-sm text-slate-700">{result.reason ?? 'Ready to spend. Anyone with the code can spend it, so keep it safe.'}</p>
        {result.usable && <a href="/shop" class="mt-3 inline-block text-sm font-bold underline">Start shopping</a>}
      </div>
    )}
  </div>
</BaseLayout>
