---
import { jsonApiHeaders } from '../lib/forwardClient';
import { safeReturnTo } from '../lib/safeReturnTo';
import BaseLayout from '../layouts/BaseLayout.astro';
import FormField from '../components/FormField.astro';
import FormFeedback from '../components/FormFeedback.astro';
import Notice from '../components/Notice.astro';
import { apiBase } from '../lib/api';
import SocialSignIn from '../components/auth/SocialSignIn.astro';
import { SESSION_COOKIE_NAME } from '../lib/session';
import { checkRequestOrigin, CROSS_SITE_MESSAGE } from '../lib/requestOrigin';
import {
  validateRegistration,
  fieldErrorsFromBadInput,
  firstErrorField,
  registerBannerMessage,
  sanitiseJoinPhone,
  registerUrlWithoutPhone,
  JOIN_PHONE_COOKIE,
  type RegisterFieldErrors,
} from '../lib/registerForm';

/**
 * The visitor's address, forwarded so abuse control counts THEM and not this
 * container. Reading it can throw in a prerendered context, so it degrades to
 * the shared bucket rather than breaking the page.
 */
let clientAddress: string | null = null;
try {
  clientAddress = Astro.clientAddress ?? null;
} catch {
  clientAddress = null;
}


// Already signed in? Registration has nothing to offer — go to the account.
if (Astro.cookies.get('goldplus_session')?.value && Astro.request.method !== 'POST') {
  return Astro.redirect('/account', 303);
}

// The header's "Join free" form is a GET with the number in ?phone=. Carry the
// number into the phone field, but never leave it in the address bar: the page
// URL is recorded by analytics, and a phone number is personal data. The
// redirect happens here, server-side, before any tag on the page can run.
if (Astro.request.method === 'GET' && Astro.url.searchParams.has('phone')) {
  const joinPhone = sanitiseJoinPhone(Astro.url.searchParams.get('phone'));
  if (joinPhone) {
    Astro.cookies.set(JOIN_PHONE_COOKIE, joinPhone, {
      path: '/register',
      httpOnly: true,
      sameSite: 'lax',
      maxAge: 600,
      secure: import.meta.env.PROD,
    });
  }
  return Astro.redirect(registerUrlWithoutPhone(Astro.url), 303);
}

let status: 'success' | 'error' | null = null;
let message: string | undefined;
let values: { email?: string; phone?: string } = {};
let fieldErrors: RegisterFieldErrors = {};
let notConfigured = false;

if (Astro.request.method === 'GET') {
  const carried = sanitiseJoinPhone(Astro.cookies.get(JOIN_PHONE_COOKIE)?.value);
  if (carried) values.phone = carried;
  if (Astro.cookies.has(JOIN_PHONE_COOKIE)) Astro.cookies.delete(JOIN_PHONE_COOKIE, { path: '/register' });
}

const returnToParam = Astro.url.searchParams.get('returnTo');
const returnTo =
  safeReturnTo(returnToParam);

// 0087 referrals: ?ref=CODE arrives from a shared invite link and rides the
// form through registration. An invalid code never blocks the signup — the API
// records the link as a pending fact and pays nothing until first delivery.
const refParam = Astro.url.searchParams.get('ref');
const referralCodeFromUrl = refParam && /^[A-Za-z0-9]{4,12}$/.test(refParam) ? refParam.toUpperCase() : '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const email = String(form.get('email') ?? '').trim();
  const phone = String(form.get('phone') ?? '').trim();
  const password = String(form.get('password') ?? '');
  const confirm = String(form.get('confirmPassword') ?? '');
  const referralCodeRaw = String(form.get('referralCode') ?? '').trim().toUpperCase();
  const referralCode = /^[A-Z0-9]{4,12}$/.test(referralCodeRaw) ? referralCodeRaw : '';
  values = { email, phone };

  // The same checks the API makes, before the round trip, so each problem is
  // marked on its own field. Only the passwords are cleared on a retry.
  fieldErrors = validateRegistration({ email, phone, password, confirmPassword: confirm });
  // Login CSRF (registration IS a sign-in): a cross-site auto-submitted form
  // must never create an account and sign this browser into it.
  const origin = checkRequestOrigin(Astro.request, import.meta.env as unknown as Record<string, string | undefined>);
  if (!origin.allowed) {
    status = 'error';
    message = CROSS_SITE_MESSAGE;
  } else if (firstErrorField(fieldErrors)) {
    status = 'error';
    message = registerBannerMessage(fieldErrors);
  } else {
    try {
      const res = await fetch(`${apiBase}/auth/register`, {
        method: 'POST',
        headers: jsonApiHeaders(clientAddress),
        body: JSON.stringify({ email, phone, password, ...(referralCode ? { referralCode } : {}) }),
      });
      const json: any = await res.json().catch(() => null);

      if (res.ok && json?.success && json.data?.token) {
        // Registration IS a login: the session cookie is set immediately, so the
        // very next page is their signed-in account (or the checkout they came from).
        // Via Astro.cookies — a raw Set-Cookie header on Astro.response is DROPPED
        // when the return value is Astro.redirect(), which is exactly this path.
        Astro.cookies.set(SESSION_COOKIE_NAME, json.data.token, {
          path: '/',
          httpOnly: true,
          sameSite: 'lax',
          maxAge: 604800,
          secure: import.meta.env.PROD,
        });


        // R9 (M8, fixation): the visit token is ROTATED at the authentication
        // boundary — a pre-planted cookie must never become the token that
        // gets linked to the freshly signed-in customer. The NEW token is
        // linked; the old one keeps only its anonymous history.
        const { mintSignedVisitToken } = await import('../lib/visitToken');
        const { VISIT_COOKIE_NAME, visitCookieOptions } = await import('../middleware');
        const rotatedToken = mintSignedVisitToken();
        if (rotatedToken) {
          Astro.cookies.set(VISIT_COOKIE_NAME, rotatedToken, visitCookieOptions());
          try {
            await fetch(`${apiBase}/recommendations/profile/link`, {
              method: 'POST',
              headers: { Authorization: `Bearer ${json.data.token}`, 'x-gp-visit': rotatedToken },
              signal: AbortSignal.timeout(3000),
            });
          } catch {
            // Continuity, not correctness.
          }
        }
        return Astro.redirect(returnTo, 303);
      }

      if (json?.error?.code === 'AUTH_NOT_CONFIGURED') {
        notConfigured = true;
        message = json.error.message;
      } else {
        status = 'error';
        // Never the API's own text, and never an HTTP number. A 400's message is
        // read only to decide which field to mark; the words are the page's own.
        if (res.status === 400) {
          fieldErrors = fieldErrorsFromBadInput(json?.error?.message);
          message = registerBannerMessage(fieldErrors);
        } else {
          message = res.status === 409
            ? 'There is already an account with that email. Try signing in, or reset your password.'
            : 'We could not create your account right now. Please try again in a moment.';
        }
      }
    } catch {
      status = 'error';
      message = 'Cannot reach the registration service right now. Please try again shortly.';
    }
  }
}

const focusField = firstErrorField(fieldErrors);
---

<BaseLayout robotsMeta="noindex,follow" title="Create your account" description="Create a free GoldPlus account to track orders, save addresses and earn loyalty points.">
  <div class="container mx-auto px-4 lg:px-8 py-12 md:py-20">
    <div class="max-w-md mx-auto">
      <h1 class="text-2xl md:text-3xl font-black text-gray-900 mb-2 tracking-tight">Create your account</h1>
      <p class="text-slate-600 mb-6 text-sm leading-relaxed">Track orders in one place, check out faster with saved addresses, and earn GoldPlus points on every delivered order.</p>

      {notConfigured && (
        <div class="mb-6">
          <Notice kind="warning" title="Sign-up is temporarily unavailable" message="Please try again shortly. You can still shop and check out as a guest." />
        </div>
      )}
      {!notConfigured && <FormFeedback status={status} message={message} actionHref={status === 'error' && message?.startsWith('There is already an account') ? '/login' : undefined} actionLabel="Sign in instead" />}

      <SocialSignIn returnTo={Astro.url.searchParams.get('returnTo') ?? '/account'} intent="signup" />

      <form method="POST" novalidate class="bg-white p-8 rounded-2xl border border-slate-200/80 space-y-5">
        <FormField id="email" name="email" label="Email" type="email" required autocomplete="email" helperText="You sign in with this email address and your password." defaultValue={values.email} errorMessage={fieldErrors.email} autofocus={focusField === 'email'} />
        <FormField id="phone" name="phone" label="Phone (MTN / Airtel)" type="tel" required inputmode="tel" placeholder="07XX XXX XXX" autocomplete="tel" helperText="For delivery calls, and an SMS code if you ever forget your password. It is not used to sign in." defaultValue={values.phone} errorMessage={fieldErrors.phone} autofocus={focusField === 'phone'} />
        <FormField id="password" name="password" label="Password (at least 8 characters)" type="password" required autocomplete="new-password" errorMessage={fieldErrors.password} autofocus={focusField === 'password'} />
        <FormField id="confirmPassword" name="confirmPassword" label="Confirm password" type="password" required autocomplete="new-password" errorMessage={fieldErrors.confirmPassword} autofocus={focusField === 'confirmPassword'} />
        <FormField
          id="referralCode"
          name="referralCode"
          label="Referral code (optional)"
          type="text"
          autocomplete="off"
          placeholder="GPXXXXXX"
          defaultValue={referralCodeFromUrl}
        />
        <button
          type="submit"
          class="w-full min-h-12 bg-brand-primary text-gray-950 py-3 rounded-full font-bold text-sm hover:shadow-lg hover:shadow-brand-primary/20 transition-all outline-none cursor-pointer hover:scale-[1.005] active:scale-[0.985]"
        >
          Create account
        </button>
        <p class="text-xs text-slate-500 text-center leading-relaxed">
          Already have an account?
          <a href={`/login${returnToParam ? `?returnTo=${encodeURIComponent(returnTo)}` : ''}`} class="font-bold text-slate-600 underline hover:text-gray-900">Sign in</a>
        </p>
      </form>
    </div>
  </div>
</BaseLayout>
