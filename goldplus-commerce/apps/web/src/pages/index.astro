---
import BaseLayout from '../layouts/BaseLayout.astro';
import { apiBase } from '../lib/api';
import ProductCard from '../components/ProductCard.astro';
import type { ApiResponse, ProductPublicDto } from '@goldplus/shared';
import PopularNowRail from '../components/recommendations/PopularNowRail.astro';

let featuredProducts: ProductPublicDto[] = [];
let hasApiError = false;

try {
  const res = await fetch(`${apiBase}/products?limit=4`, { signal: AbortSignal.timeout(3000) });
  if (res.ok) {
    const json = await res.json() as ApiResponse<ProductPublicDto[]>;
    if (json.success) {
      featuredProducts = json.data;
    }
  } else {
    hasApiError = true;
  }
} catch {
  hasApiError = true;
}
---

<BaseLayout title="Premium electronics — Uganda">

  {/* Hero */}
  <section class="bg-brand-softGrey flex-grow flex flex-col justify-center items-center text-center px-4 py-20 lg:py-32 border-b border-brand-borderGrey">
    <div class="max-w-3xl mx-auto">
      <span class="inline-block py-1 px-3 rounded-full bg-brand-primary/15 text-brand-charcoal text-sm font-bold tracking-wide uppercase mb-6">
        Guaranteed authenticity
      </span>
      <h1 class="text-5xl md:text-6xl lg:text-7xl font-black tracking-tight text-brand-charcoal mb-6 leading-tight">
        Power your lifestyle with <span class="text-brand-primary">GoldPlus</span>
      </h1>
      <p class="text-lg md:text-xl text-brand-mutedGrey mb-10 max-w-2xl mx-auto leading-relaxed">
        Engineered for the Ugandan market. Durable, reliable, verified original electronics. Power, sound, storage and car accessories.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/shop" class="w-full sm:w-auto bg-brand-primary text-brand-charcoal px-8 py-4 rounded-lg font-bold hover:opacity-90 transition-opacity focus-visible:ring-4 focus-visible:ring-brand-primary/30 outline-none text-lg">
          Shop all products
        </a>
        <a href="/verification" class="w-full sm:w-auto bg-white text-brand-charcoal border-2 border-brand-borderGrey px-8 py-4 rounded-lg font-bold hover:border-brand-charcoal transition-colors focus-visible:ring-4 focus-visible:ring-brand-charcoal/10 outline-none text-lg">
          Verify product
        </a>
      </div>
    </div>
  </section>

  {/* Trust */}
  <section class="bg-white py-12 border-b border-brand-borderGrey">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center">
        <div>
          <h3 class="font-bold text-lg text-brand-charcoal mb-2">Originality verified</h3>
          <p class="text-brand-mutedGrey text-sm">Every product includes a verification code. Check it online instantly.</p>
        </div>
        <div>
          <h3 class="font-bold text-lg text-brand-charcoal mb-2">No fake claims</h3>
          <p class="text-brand-mutedGrey text-sm">If a spec isn't verified, we tell you it's missing. Honest specifications.</p>
        </div>
        <div>
          <h3 class="font-bold text-lg text-brand-charcoal mb-2">Direct support</h3>
          <p class="text-brand-mutedGrey text-sm">Report issues or fake products directly to our Ugandan team.</p>
        </div>
      </div>
    </div>
  </section>

  {/* Categories */}
  <section class="bg-brand-softGrey py-16">
    <div class="container mx-auto px-4 lg:px-8">
      <h2 class="text-3xl font-black tracking-tight text-brand-charcoal mb-8 text-center">Shop by category</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {[
          { name: 'Power devices', desc: 'Chargers, banks', slug: 'power' },
          { name: 'Sound devices', desc: 'Earbuds, speakers', slug: 'sound' },
          { name: 'Storage devices', desc: 'Flash drives, SDs', slug: 'storage' },
          { name: 'Car accessories', desc: 'Mounts, chargers', slug: 'car' },
        ].map((cat) => (
          <a href={`/shop?category=${cat.slug}`} class="block group focus-visible:ring-4 focus-visible:ring-brand-primary/30 outline-none rounded-2xl">
            <div class="bg-white border border-brand-borderGrey aspect-[4/3] rounded-2xl p-6 flex flex-col justify-end relative overflow-hidden transition-all hover:border-brand-primary hover:shadow-lg">
              <div class="absolute inset-0 flex items-center justify-center text-gray-300 font-medium" aria-hidden="true">
                <svg class="w-10 h-10 opacity-20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
              </div>
              <div class="relative z-10 bg-white/90 p-3 rounded-lg backdrop-blur-sm">
                <h3 class="text-xl font-bold text-brand-charcoal mb-1">{cat.name}</h3>
                <p class="text-sm text-brand-mutedGrey font-medium group-hover:text-brand-primary transition-colors">{cat.desc}</p>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* Featured products */}
  <section class="bg-white py-16 border-t border-brand-borderGrey">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="flex items-center justify-between mb-8">
        <h2 class="text-3xl font-black tracking-tight text-brand-charcoal">Featured products</h2>
        <a href="/shop" class="text-brand-primary font-bold hover:opacity-80">View all &rarr;</a>
      </div>

      {hasApiError ? (
        <div class="p-8 text-center bg-brand-softGrey border border-brand-borderGrey rounded-2xl">
           <p class="text-brand-mutedGrey">Featured items are currently loading slowly. Explore the full collection below.</p>
           <a href="/shop" class="inline-block mt-4 text-brand-charcoal font-bold underline">Browse Catalog</a>
        </div>
      ) : featuredProducts.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {featuredProducts.map((p) => (
            <ProductCard product={p} />
          ))}
        </div>
      ) : (
        <div class="p-8 text-center bg-brand-softGrey border border-brand-borderGrey rounded-2xl">
          <p class="text-brand-mutedGrey">No featured items highlighted right now.</p>
        </div>
      )}
    </div>
  </section>

  {/* Trending Recommendations */}
  <section class="bg-brand-softGrey py-16 border-t border-brand-borderGrey">
    <div class="container mx-auto px-4 lg:px-8">
      <PopularNowRail />
    </div>
  </section>

  {/* Business pathways */}
  <section class="bg-brand-charcoal text-white py-16">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="border border-gray-700 p-8 rounded-2xl">
          <h3 class="text-2xl font-bold text-brand-primary mb-4">Retail customers</h3>
          <p class="text-gray-300 mb-6 leading-relaxed">Shop our verified products directly, and verify authenticity instantly.</p>
          <a href="/shop" class="inline-block px-6 py-2 bg-brand-primary text-brand-charcoal font-bold rounded-lg hover:opacity-90">Start shopping</a>
        </div>
        <div class="border border-gray-700 p-8 rounded-2xl">
          <h3 class="text-2xl font-bold text-brand-primary mb-4">Dealers</h3>
          <p class="text-gray-300 mb-6 leading-relaxed">Apply to become an authorised GoldPlus dealer in Uganda.</p>
          <a href="/dealers/apply" class="inline-block px-6 py-2 bg-transparent border border-white font-bold rounded-lg hover:bg-gray-800">Apply now</a>
        </div>
        <div class="border border-gray-700 p-8 rounded-2xl">
          <h3 class="text-2xl font-bold text-brand-primary mb-4">Corporate buyers</h3>
          <p class="text-gray-300 mb-6 leading-relaxed">Request wholesale quotes for corporate electronics deployment.</p>
          <a href="/quote-request?kind=corporate" class="inline-block px-6 py-2 bg-transparent border border-white font-bold rounded-lg hover:bg-gray-800">Request quote</a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
