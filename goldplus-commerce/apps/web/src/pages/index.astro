---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Premium Electronics">
  
  {/* Hero Section - High Contrast, Clean */}
  <section class="bg-gray-50 flex-grow flex flex-col justify-center items-center text-center px-4 py-20 lg:py-32">
    <div class="max-w-3xl mx-auto">
      <span class="inline-block py-1 px-3 rounded-full bg-brand-green/10 text-brand-green text-sm font-bold tracking-wide uppercase mb-6">
        Guaranteed Authenticity
      </span>
      <h1 class="text-5xl md:text-6xl lg:text-7xl font-black tracking-tight text-brand-dark mb-6 leading-tight">
        Power your lifestyle with <span class="text-brand-gold relative inline-block">GoldPlus</span>
      </h1>
      <p class="text-lg md:text-xl text-gray-600 mb-10 max-w-2xl mx-auto leading-relaxed">
        Engineered for the Ugandan market. Durable, reliable, and verified original electronics.
      </p>
      
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/shop" class="w-full sm:w-auto bg-brand-dark text-white px-8 py-4 rounded-lg font-bold hover:bg-black transition-colors focus:ring-4 focus:ring-gray-300 outline-none text-lg">
          Explore Products
        </a>
        <a href="/verification" class="w-full sm:w-auto bg-white text-brand-dark border-2 border-gray-200 px-8 py-4 rounded-lg font-bold hover:border-brand-dark transition-colors focus:ring-4 focus:ring-gray-100 outline-none text-lg">
          Verify Purchase
        </a>
      </div>
    </div>
  </section>

  {/* Category Teaser - Mobile Horizontal Scroll */}
  <section class="border-t border-gray-200 bg-white py-16">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="flex items-center justify-between mb-8">
        <h2 class="text-2xl font-bold tracking-tight">Our Categories</h2>
        <a href="/shop" class="text-sm font-semibold text-brand-green hover:text-green-800 flex items-center gap-1">
          View All <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
      
      <div class="flex overflow-x-auto pb-8 gap-6 no-scrollbar snap-x snap-mandatory">
        
        {/* Card 1 */}
        <a href="/categories/power" class="snap-start shrink-0 w-72 md:w-1/3 group block">
          <div class="bg-gray-100 aspect-[4/3] rounded-2xl mb-4 p-6 flex flex-col justify-end relative overflow-hidden transition-colors group-hover:bg-gray-200">
             <div class="absolute inset-0 flex items-center justify-center text-gray-400 font-medium">
               No Image Available
             </div>
             <div class="relative z-10">
               <h3 class="text-xl font-bold text-brand-dark mb-1">Power Devices</h3>
               <p class="text-sm text-gray-600 font-medium group-hover:text-brand-dark transition-colors">Fast chargers & Power banks</p>
             </div>
          </div>
        </a>

        {/* Card 2 */}
        <a href="/categories/sound" class="snap-start shrink-0 w-72 md:w-1/3 group block">
          <div class="bg-gray-100 aspect-[4/3] rounded-2xl mb-4 p-6 flex flex-col justify-end relative overflow-hidden transition-colors group-hover:bg-gray-200">
             <div class="absolute inset-0 flex items-center justify-center text-gray-400 font-medium">
               No Image Available
             </div>
             <div class="relative z-10">
               <h3 class="text-xl font-bold text-brand-dark mb-1">Sound Devices</h3>
               <p class="text-sm text-gray-600 font-medium group-hover:text-brand-dark transition-colors">Earbuds & Speakers</p>
             </div>
          </div>
        </a>

      </div>
    </div>
  </section>

</BaseLayout>

