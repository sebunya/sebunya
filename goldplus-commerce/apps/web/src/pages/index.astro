---
import BaseLayout from '../layouts/BaseLayout.astro';
import { apiBase } from '../lib/api';
import ProductCard from '../components/ProductCard.astro';
import type { ApiResponse, ProductPublicDto } from '@goldplus/shared';
import PopularNowRail from '../components/recommendations/PopularNowRail.astro';
import RecentlyViewedRail from '../components/recommendations/RecentlyViewedRail.astro';
import CartAwareRail from '../components/home/CartAwareRail.astro';
import HeroSlider from '../components/hero/HeroSlider.astro';
import HomeCommerceHighlights from '../components/HomeCommerceHighlights.astro';
import { buildHomepageProductAllocation } from '../lib/homepage-merchandising';
import { getCleanCatalog } from '../lib/catalog/catalog';
import { getTaxonomy } from '../lib/taxonomy';

let rawProducts: ProductPublicDto[] = [];
let hasApiError = false;

try {
  // Fetch higher depth limit to satisfy full homepage allocation without duplicates
  const res = await fetch(`${apiBase}/products?limit=50`, { signal: AbortSignal.timeout(3000) });
  if (res.ok) {
    const json = await res.json() as ApiResponse<ProductPublicDto[]>;
    if (json.success && json.data && json.data.length > 0) {
      rawProducts = json.data;
    }
  }
} catch {
  // Graceful fallback
}

const allProducts = getCleanCatalog(rawProducts);
// Homepage "Shop by category" tiles — operator-editable taxonomy (admin/categories).
const homepageCategories = (await getTaxonomy()).filter((c) => c.showOnHomepage);

// Execute cross-section deduplication and building of allocations
const allocation = buildHomepageProductAllocation(allProducts);

const featuredProducts = allocation.featuredProducts;
const promoProduct = allocation.promoProduct;
const todaysPickProduct = allocation.todaysPickProduct;

// Collect all IDs consumed so far to strictly isolate Trending Now
const usedProductIds = [
  ...featuredProducts.map(p => p.id),
  promoProduct?.id,
  todaysPickProduct?.id,
].filter((id): id is string => typeof id === 'string');
---

<BaseLayout title="Premium electronics — Uganda">

  {/* 1. Hero — CMS-driven 12-slide personalised slider (ported 2026-08-07).
      Wrapped in the SAME content container as every rail/section below, so the
      hero card aligns to the site's grid instead of juting out full-bleed. */}
  <div class="container mx-auto px-4 lg:px-8">
    <HeroSlider />
  </div>

  {/* Cart-Aware Continue Journey Banner (Only when active cart items exist) */}
  <div class="container mx-auto px-4 lg:px-8">
    <CartAwareRail />
  </div>

  {/* 2. Pick Up Where You Left Off (Returning Visitors Only) */}
  <div id="homepage-recovery-strip" class="container mx-auto px-4 lg:px-8">
    <RecentlyViewedRail />
  </div>

  {/* 3. Trust strip (New Visitors Only, hidden client-side if returning) */}
  <section id="homepage-trust-strip" class="bg-white py-10 border-b border-slate-100">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center md:text-left">
        <div class="flex flex-col md:flex-row items-center md:items-start gap-4 p-2">
          <div class="p-3 rounded-full bg-slate-50 border border-slate-100 text-brand-charcoal shrink-0">
            <svg class="w-5 h-5 text-gray-800" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
          </div>
          <div>
            <h3 class="font-bold text-sm text-gray-900 mb-1">Check it's real in seconds</h3>
            <p class="text-slate-500 text-[13px] leading-relaxed">Every product carries a code you can verify online. If it doesn't check out, it isn't from us.</p>
          </div>
        </div>
        <div class="flex flex-col md:flex-row items-center md:items-start gap-4 p-2">
          <div class="p-3 rounded-full bg-slate-50 border border-slate-100 text-brand-charcoal shrink-0">
            <svg class="w-5 h-5 text-gray-800" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path></svg>
          </div>
          <div>
            <h3 class="font-bold text-sm text-gray-900 mb-1">The spec you read is the spec you get</h3>
            <p class="text-slate-500 text-[13px] leading-relaxed">If a detail isn't verified, we mark it missing. We would rather leave a gap than fill it to close a sale.</p>
          </div>
        </div>
        <div class="flex flex-col md:flex-row items-center md:items-start gap-4 p-2">
          <div class="p-3 rounded-full bg-slate-50 border border-slate-100 text-brand-charcoal shrink-0">
            <svg class="w-5 h-5 text-gray-800" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
          </div>
          <div>
            <h3 class="font-bold text-sm text-gray-900 mb-1">A real person in Kampala</h3>
            <p class="text-slate-500 text-[13px] leading-relaxed">Message our team on WhatsApp and reach a person, not a queue. Report a fake and we act on it.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* 4. HomeCommerceHighlights */}
  <HomeCommerceHighlights promoProduct={promoProduct} todaysPickProduct={todaysPickProduct} />

  {/* 5. Shop by Category */}
  <section class="bg-slate-50 py-14 border-b border-slate-100/65">
    <div class="container mx-auto px-4 lg:px-8">
      <h2 class="text-2xl font-black tracking-tight text-gray-900 mb-8 text-center">Shop by category</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {homepageCategories.map((cat) => (
          <a href={`/shop?category=${cat.slug}`} class="block group focus-visible:ring-4 focus-visible:ring-brand-primary/30 outline-none rounded-2xl">
            <div class="bg-white border border-slate-200/85 aspect-[4/3] rounded-2xl p-6 flex flex-col justify-end relative overflow-hidden transition-all hover:border-brand-primary hover:shadow-lg hover:shadow-slate-100/60">
              <div class="absolute inset-0 flex items-center justify-center text-slate-200 font-medium" aria-hidden="true">
                <svg class="w-10 h-10 opacity-20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
              </div>
              <div class="relative z-10 bg-white/95 p-3.5 rounded-xl border border-slate-100/80 shadow-xs">
                <h3 class="text-base font-bold text-gray-950 mb-0.5">{cat.name}</h3>
                {cat.homepageBlurb && <p class="text-xs text-slate-500 font-medium group-hover:text-brand-primary transition-colors">{cat.homepageBlurb}</p>}
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* 6. Featured products */}
  <section class="bg-white py-14 border-b border-slate-100">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="flex items-center justify-between mb-8">
        <h2 class="text-2xl font-black tracking-tight text-gray-900">Featured products</h2>
        <a href="/shop" class="text-sm font-bold text-gray-800 hover:text-brand-primary transition-colors flex items-center gap-1">View all &rarr;</a>
      </div>

      {hasApiError ? (
        <div class="p-8 text-center bg-slate-50 border border-slate-200/80 rounded-2xl">
           <p class="text-slate-500 text-sm">Featured items are currently loading slowly. Explore the full collection below.</p>
           <a href="/shop" class="inline-block mt-4 text-gray-900 font-bold underline">Browse Catalog</a>
        </div>
      ) : featuredProducts.length > 0 ? (
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6">
          {featuredProducts.map((p) => (
            <ProductCard product={p} />
          ))}
        </div>
      ) : (
        <div class="p-8 text-center bg-slate-50 border border-slate-200/80 rounded-2xl">
          <p class="text-slate-500 text-sm">No featured items highlighted right now.</p>
        </div>
      )}
    </div>
  </section>

  {/* Category/Search Aware Continuation Rail (Only when user history exists) */}
  <div class="container mx-auto px-4 lg:px-8">
    {/* R7 (2026-08-06): CategoryAwareRail retired — it read two localStorage
        keys (goldplus_last_category / goldplus_last_search) that NOTHING ever
        wrote, so it could never render, while serializing the entire catalogue
        into the homepage HTML on every request. Category affinity is served
        server-side by the engine's search-affinity source instead. */}
  </div>

  {/* 7. Trending Now (with Cross-Section Deduplication) */}
  <PopularNowRail excludeProductIds={usedProductIds} useContainerWrapper={true} />

  {/* 8. Business pathways */}
  <section class="bg-zinc-50 border-t border-zinc-200/85 py-16">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="border border-zinc-200/90 bg-white p-8 rounded-2xl hover:border-zinc-300 hover:shadow-md transition-all duration-300 flex flex-col justify-between h-full">
          <div>
            <h3 class="text-xl font-bold text-gray-900 mb-3">Shopping for yourself</h3>
            <p class="text-zinc-500 text-sm mb-6 leading-relaxed">Genuine electronics you can verify. Before you pay, and again the day they arrive.</p>
          </div>
          <div>
            <a href="/shop" class="inline-block px-6 py-2.5 bg-brand-primary text-gray-950 font-bold rounded-full hover:shadow-lg hover:shadow-brand-primary/20 hover:scale-[1.015] active:scale-95 transition-all text-sm">Start shopping</a>
          </div>
        </div>
        <div class="border border-zinc-200/90 bg-white p-8 rounded-2xl hover:border-zinc-300 hover:shadow-md transition-all duration-300 flex flex-col justify-between h-full">
          <div>
            <h3 class="text-xl font-bold text-gray-900 mb-3">Selling to your customers</h3>
            <p class="text-zinc-500 text-sm mb-6 leading-relaxed">Stock originals your buyers can trust, with the codes to prove it. Apply to become an authorised GoldPlus dealer.</p>
          </div>
          <div>
            <a href="/dealers/apply" class="inline-block px-6 py-2.5 bg-zinc-900 text-white font-bold rounded-full hover:bg-zinc-800 hover:shadow-md active:scale-95 transition-all text-sm">Become a dealer</a>
          </div>
        </div>
        <div class="border border-zinc-200/90 bg-white p-8 rounded-2xl hover:border-zinc-300 hover:shadow-md transition-all duration-300 flex flex-col justify-between h-full">
          <div>
            <h3 class="text-xl font-bold text-gray-900 mb-3">Buying for a team</h3>
            <p class="text-zinc-500 text-sm mb-6 leading-relaxed">Fitting out an office or a fleet? Get a wholesale quote built around your exact spec.</p>
          </div>
          <div>
            <a href="/quote-request?kind=corporate" class="inline-block px-6 py-2.5 bg-zinc-900 text-white font-bold rounded-full hover:bg-zinc-800 hover:shadow-md active:scale-95 transition-all text-sm">Get a quote</a>
          </div>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<script>
  import { hasSeenBefore, handleUserVisitState } from "../lib/returning-user";

  document.addEventListener("DOMContentLoaded", () => {
    const trustStrip = document.getElementById("homepage-trust-strip");
    
    // First-party lock check: If they are a confirmed returning visitor, hide the Trust Strip
    if (trustStrip && hasSeenBefore()) {
      trustStrip.style.display = "none";
    }

    // Run user state persistence so this visit transitions them to "returning" for subsequent navigations
    handleUserVisitState();
  });
</script>

