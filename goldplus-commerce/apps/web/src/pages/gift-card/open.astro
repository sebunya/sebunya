---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GiftCardFace from '../../components/GiftCardFace.astro';
import { giftCardPhotoUrl } from '../../lib/giftCardPhoto';
import GiftCardPhotoRemove from '../../components/GiftCardPhotoRemove.astro';
import { apiBase } from '../../lib/api';
import { apiHeaders, readClientAddress } from '../../lib/forwardClient';
import { formatUgx } from '../../lib/money';

/**
 * Open a gift card (0199): the page the recipient's text links to, shopgoldplus.com/gift-card/open#GPGC-…
 *
 * The code travels in the #fragment, which a browser never sends anywhere. A small script posts it here (in the
 * body, never the address: no server or proxy log holds it), and the page answers with the card the buyer designed
 * and a scratch panel over the code. Without JavaScript, or from a code read off a phone, the same form is typed in.
 */
type Opened = {
  kind: 'gift_card' | 'store_credit'; masked: string; balanceUgx: number; usable: boolean; reason: string | null; code: string | null;
  face: { theme: string; fromName: string; toName: string; message: string | null; originalUgx?: number; photoId?: string | null } | null;
  originalUgx?: number | null;
};
let opened: Opened | null = null;
let problem = '';
let typed = '';
let photoNotice: string | null = null;
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  typed = String(form.get('code') ?? '').trim().slice(0, 40);
  // 0201: the person the card is for takes the photo off it, then sees their card again. The code is the proof.
  if (form.get('intent') === 'remove-photo') {
    try {
      const res = await fetch(`${apiBase}/commerce/gift-cards/photo/remove-by-code`, {
        method: 'POST',
        headers: apiHeaders({ 'Content-Type': 'application/json', Accept: 'application/json' }, readClientAddress(Astro)),
        body: JSON.stringify({ code: typed }),
        signal: AbortSignal.timeout(10_000),
      });
      photoNotice = res.ok ? 'The photo is removed. Your card shows its occasion picture instead.'
        : res.status === 409 ? 'This card has no photo.' : 'We could not remove the photo just now. Please try again, or call us.';
    } catch {
      photoNotice = 'We could not remove the photo just now. Please try again, or call us.';
    }
  }
  try {
    const res = await fetch(`${apiBase}/commerce/gift-cards/open`, {
      method: 'POST',
      headers: apiHeaders({ 'Content-Type': 'application/json', Accept: 'application/json' }, readClientAddress(Astro)),
      body: JSON.stringify({ code: typed }),
      signal: AbortSignal.timeout(10_000),
    });
    const json: any = await res.json().catch(() => null);
    if (res.ok && json?.success) opened = json.data as Opened;
    else if (res.status === 429) problem = 'Too many tries in a short time. Wait a minute and try again.';
    else problem = 'That code is not right. Check each character (it starts with GPGC or GPSC), or call us.';
  } catch {
    problem = 'We could not open the card just now. Please try again in a minute.';
  }
}
Astro.response.headers.set('Cache-Control', 'private, no-store');
// No address of this page ever goes to another site. NOT 'no-referrer': with it the browser sends `Origin: null` on
// this page's own form, and the storefront's cross-site guard refuses it (seen in a real browser, 2026-10-21).
Astro.response.headers.set('Referrer-Policy', 'same-origin');
const photoUrl = giftCardPhotoUrl(opened?.face?.photoId);
const kindWord = opened?.kind === 'store_credit' ? 'store credit' : 'gift card';
// What "Share your gift" may use: an explicit list of permitted fields, built here and nothing more. The code, the
// balance, the private link and anything about payment never enter it (the share script reads only this).
const shareSource = opened ? {
  occasion: opened.face?.theme ?? 'gold',
  recipientName: opened.face?.toName ?? null,
  senderName: opened.face?.fromName ?? null,
  message: opened.face?.message ?? null,
  originalUgx: opened.originalUgx ?? opened.face?.originalUgx ?? null,
  photoUrl,
} : null;
---
<BaseLayout title="A GoldPlus gift card for you" description="Someone sent you a GoldPlus gift card. Open it, scratch to reveal your code, and spend it on shopgoldplus.com or in our shop in Kampala." robotsMeta="noindex,nofollow">
  <div class="mx-auto max-w-xl px-4 py-10 sm:py-14" data-gift-card-open data-state={opened ? (opened.usable ? 'ready' : 'unusable') : problem ? 'problem' : 'form'}>
    {!opened && (
      <>
        <h1 class="text-3xl font-black tracking-tight text-gray-900" data-open-heading>Open your gift card</h1>
        <p class="mt-3 text-base text-slate-600" data-opening hidden>Opening your gift card…</p>
        {problem && <p role="alert" class="mt-6 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-semibold text-red-800">{problem}</p>}
        <form method="POST" action="/gift-card/open" class="mt-6 space-y-4" data-open-form>
          <label class="block"><span class="text-sm font-bold text-gray-900">Your code (from the text we sent)</span>
            <input name="code" required value={typed} autocomplete="off" autocapitalize="characters" spellcheck="false" placeholder="GPGC-XXXX-XXXX-XXXX" class="mt-1 w-full min-h-11 rounded-lg border border-slate-300 px-3 py-2.5 text-base font-bold uppercase tracking-wider outline-none focus:ring-2 focus:ring-brand-primaryInk" />
          </label>
          <button type="submit" class="inline-flex min-h-12 items-center rounded-full bg-brand-primary px-6 text-xs font-black uppercase tracking-widest text-brand-black">Open my card</button>
        </form>
      </>
    )}

    {opened && (
      <>
        <h1 class="text-2xl font-black tracking-tight text-gray-900 sm:text-3xl">
          {opened.face ? `${opened.face.fromName} sent you a gift` : `Your GoldPlus ${kindWord}`}
        </h1>
        <div class="mt-6">
          <GiftCardFace theme={opened.face?.theme} amountUgx={opened.balanceUgx} toName={opened.face?.toName} fromName={opened.face?.fromName ?? 'GoldPlus'} message={opened.face?.message} photoUrl={photoUrl} masked={opened.usable ? null : opened.masked} />
          {photoNotice && <p class="mt-3 rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm font-semibold text-gray-900" role="status">{photoNotice}</p>}
          {photoUrl && opened.code && <GiftCardPhotoRemove whose="your" fields={{ code: opened.code }} />}
        </div>

        {/* Share your gift: optional, secondary, and available after the card is spent too. */}
        <script type="application/json" id="gc-share-source" nonce={Astro.locals.cspNonce} set:html={JSON.stringify(shareSource).replace(/</g, '\\u003c')}></script>
        <div class="mt-3 flex justify-end">
          <button type="button" class="inline-flex min-h-11 items-center gap-2 rounded-full border border-slate-300 bg-white px-4 text-xs font-black uppercase tracking-wider text-gray-900" data-share-open aria-expanded="false" aria-controls="share-panel" hidden>Share your gift</button>
        </div>
        <section id="share-panel" class="mt-3 hidden rounded-2xl border border-slate-200 bg-white p-4 sm:p-5" aria-labelledby="share-title" data-share-panel>
          <div class="flex items-start justify-between gap-3">
            <div>
              <h2 id="share-title" class="text-lg font-black text-gray-900">Share your gift</h2>
              <p class="mt-0.5 text-sm text-slate-600">Choose what you’d like others to see.</p>
            </div>
            <button type="button" class="min-h-10 rounded-full px-3 text-sm font-bold text-slate-600 underline" data-share-close>Close</button>
          </div>
          <div class="mt-4 grid gap-5 md:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
            <div class="flex items-start justify-center rounded-xl bg-slate-100 p-3">
              <canvas class="h-auto max-h-[420px] w-auto max-w-full rounded-lg shadow" data-share-canvas aria-label="Preview of the picture you will share" role="img"></canvas>
            </div>
            <div class="space-y-4">
              <fieldset class="space-y-2" data-share-options>
                <legend class="text-sm font-bold text-gray-900">Show on the picture</legend>
                {shareSource?.photoUrl && <label class="flex items-center gap-3 text-sm"><input type="checkbox" class="h-5 w-5 accent-[#456B00]" data-share-opt="photo" />The photo</label>}
                {shareSource?.message && <label class="flex items-center gap-3 text-sm"><input type="checkbox" class="h-5 w-5 accent-[#456B00]" data-share-opt="message" />The personal message</label>}
                {shareSource?.recipientName && <label class="flex items-center gap-3 text-sm"><input type="checkbox" class="h-5 w-5 accent-[#456B00]" data-share-opt="recipientName" />My name ({shareSource.recipientName})</label>}
                {shareSource?.senderName && <label class="flex items-center gap-3 text-sm"><input type="checkbox" class="h-5 w-5 accent-[#456B00]" data-share-opt="senderName" />Who it is from ({shareSource.senderName})</label>}
                {shareSource?.originalUgx && <label class="flex items-center gap-3 text-sm"><input type="checkbox" class="h-5 w-5 accent-[#456B00]" data-share-opt="amount" />The gift amount ({formatUgx(shareSource.originalUgx)})</label>}
              </fieldset>
              <div class="hidden space-y-1" data-share-excerpt-box>
                <label class="block text-sm font-bold text-gray-900" for="share-excerpt">A shorter message for the picture</label>
                <p class="text-xs text-slate-600">The message is long for this size. Your card keeps the full message; this is only for the picture.</p>
                <textarea id="share-excerpt" rows="3" maxlength="200" class="w-full rounded-xl border border-slate-300 px-3 py-2 text-base" data-share-excerpt></textarea>
                <p class="hidden text-xs font-semibold text-amber-800" data-share-excerpt-warn>Still too long for this size: shorten it a little more.</p>
              </div>
              <fieldset>
                <legend class="text-sm font-bold text-gray-900">Size</legend>
                <div class="mt-2 grid grid-cols-2 gap-2">
                  <label class="flex min-h-11 cursor-pointer items-center justify-center rounded-xl border border-slate-300 text-sm font-black has-[:checked]:border-brand-primaryInk has-[:checked]:bg-brand-primary/20"><input type="radio" name="share-size" value="square" checked class="sr-only" />Square</label>
                  <label class="flex min-h-11 cursor-pointer items-center justify-center rounded-xl border border-slate-300 text-sm font-black has-[:checked]:border-brand-primaryInk has-[:checked]:bg-brand-primary/20"><input type="radio" name="share-size" value="story" class="sr-only" />Story / Status</label>
                </div>
              </fieldset>
              <div class="space-y-2">
                <label class="block text-sm font-bold text-gray-900" for="share-caption">Caption <span class="font-normal text-slate-500">(yours to write; ideas below)</span></label>
                <div class="flex flex-wrap gap-2" data-share-captions></div>
                <textarea id="share-caption" rows="2" maxlength="300" class="w-full rounded-xl border border-slate-300 px-3 py-2 text-base" data-share-caption></textarea>
                <label class="flex items-center gap-3 text-sm"><input type="checkbox" class="h-5 w-5 accent-[#456B00]" data-share-link />Add a link to buy GoldPlus gift cards</label>
              </div>
              {/* Thumb-sized on a phone: the share menu first and full width, save and copy side by side. */}
              <div class="space-y-2">
                <button type="button" class="hidden min-h-14 w-full items-center justify-center rounded-full bg-brand-primary px-5 text-base font-black text-brand-black disabled:opacity-50" data-share-native disabled>Share image</button>
                <div class="grid grid-cols-2 gap-2">
                  <button type="button" class="inline-flex min-h-12 items-center justify-center rounded-full border-2 border-brand-primary px-3 text-sm font-black text-gray-900 disabled:opacity-50" data-share-save disabled>Save image</button>
                  <button type="button" class="inline-flex min-h-12 items-center justify-center rounded-full border-2 border-slate-300 px-3 text-sm font-black text-gray-900" data-share-copy>Copy caption</button>
                </div>
              </div>
              <p class="hidden text-sm text-slate-600" data-share-hint>Save the image, then upload it in your favourite app.</p>
              <p class="text-sm font-semibold text-slate-700" aria-live="polite" data-share-status></p>
              <button type="button" class="hidden min-h-11 rounded-full border border-slate-300 px-4 text-xs font-black uppercase" data-share-retry>Try again</button>
            </div>
          </div>
        </section>

        {opened.usable && opened.code && (
          <section class="mt-6" aria-labelledby="scratch-title" data-scratch>
            <h2 id="scratch-title" class="text-sm font-black uppercase tracking-widest text-slate-600">Your code</h2>
            <div class="relative mt-2 h-24 overflow-hidden rounded-2xl border-2 border-dashed border-slate-300 bg-white sm:h-28">
              <p class="absolute inset-0 flex items-center justify-center font-mono text-xl font-black tracking-[0.12em] text-gray-900 sm:text-2xl" data-scratch-code aria-hidden="true">{opened.code}</p>
              <canvas class="absolute inset-0 h-full w-full cursor-grab touch-none rounded-2xl" data-scratch-canvas aria-hidden="true"></canvas>
            </div>
            <p class="mt-2 text-sm text-slate-600" data-scratch-hint>Scratch the silver panel with your finger or mouse to reveal your code.</p>
            <p class="sr-only" aria-live="polite" data-scratch-live></p>
            <div class="mt-4 flex flex-wrap gap-3">
              <button type="button" class="inline-flex min-h-11 items-center rounded-full border-2 border-slate-300 px-4 text-xs font-black uppercase tracking-wider text-gray-900" data-scratch-reveal>Reveal without scratching</button>
              <button type="button" class="hidden min-h-11 items-center rounded-full border-2 border-brand-primary px-4 text-xs font-black uppercase tracking-wider text-gray-900" data-copy-code>Copy code</button>
              <a href="/shop" class="hidden min-h-11 items-center rounded-full bg-brand-primary px-5 text-xs font-black uppercase tracking-widest text-brand-black" data-shop-with>Shop with it</a>
            </div>
            <noscript><p class="mt-3 font-mono text-lg font-black tracking-wider">{opened.code}</p></noscript>
          </section>
        )}

        <div class={`mt-6 rounded-2xl border p-4 text-sm ${opened.usable ? 'border-emerald-200 bg-emerald-50 text-emerald-900' : 'border-amber-200 bg-amber-50 text-amber-900'}`} role="status">
          {opened.usable
            ? <p><strong>{formatUgx(opened.balanceUgx)}</strong> ready to spend. Type the code in the "Gift card or store credit" box at checkout, or show it in our shop on Burton Street, Kampala. Anyone with the code can spend it, so keep it to yourself.</p>
            : <p>{opened.reason ?? 'This card cannot be used.'} Balance: <strong>{formatUgx(opened.balanceUgx)}</strong>.</p>}
        </div>
        <p class="mt-6 text-sm text-slate-600">Want to send one too? <a class="font-bold underline" href="/gift-card/buy">Send a gift card</a>.</p>
        <form method="POST" action="/gift-card/open" hidden data-open-again><input type="hidden" name="code" /></form>
        <p class="sr-only" data-opening hidden>Opening the other gift card…</p>
      </>
    )}
  </div>
</BaseLayout>

<script>
  // 1. Arrived from the text: the code is in the #fragment. Take it out of the address bar, then post it.
  //    Also on a hash change: a second card link tapped while this page is open changes only the #fragment, and a
  //    browser does not reload for that.
  const openFromLink = () => {
    const form = document.querySelector<HTMLFormElement>('[data-open-form]') ?? document.querySelector<HTMLFormElement>('[data-open-again]');
    let fromLink = '';
    try { fromLink = decodeURIComponent(location.hash.slice(1)).trim(); } catch { return; }
    if (!form || !/^GP[GS]C[-\s]?[0-9A-Z]{4}[-\s]?[0-9A-Z]{4}[-\s]?[0-9A-Z]{4}$/i.test(fromLink)) return;
    history.replaceState(null, '', location.pathname);
    const input = form.querySelector<HTMLInputElement>('input[name="code"]');
    if (input) input.value = fromLink;
    document.querySelector<HTMLElement>('[data-opening]')?.removeAttribute('hidden');
    form.hidden = true;
    form.submit();
  };
  openFromLink();
  window.addEventListener('hashchange', openFromLink);

  // 2. The scratch panel.
  const panel = document.querySelector<HTMLElement>('[data-scratch]');
  const canvas = panel?.querySelector<HTMLCanvasElement>('[data-scratch-canvas]');
  const code = panel?.querySelector<HTMLElement>('[data-scratch-code]')?.textContent?.trim() ?? '';
  if (panel && canvas && code) {
    const ctx = canvas.getContext('2d', { willReadFrequently: true });
    let revealed = false;
    let drawing = false;
    let moves = 0;
    let last: { x: number; y: number } | null = null;
    const paint = () => {
      const r = canvas.getBoundingClientRect();
      const dpr = Math.min(2, window.devicePixelRatio || 1);
      canvas.width = Math.round(r.width * dpr);
      canvas.height = Math.round(r.height * dpr);
      if (!ctx) return;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const g = ctx.createLinearGradient(0, 0, r.width, r.height);
      g.addColorStop(0, '#9ca3af'); g.addColorStop(0.35, '#e5e7eb'); g.addColorStop(0.55, '#c0c4ca'); g.addColorStop(1, '#8b9099');
      ctx.globalCompositeOperation = 'source-over';
      ctx.fillStyle = g;
      ctx.fillRect(0, 0, r.width, r.height);
      // a fine sparkle so it reads as foil
      ctx.fillStyle = 'rgba(255,255,255,.35)';
      for (let i = 0; i < 140; i++) ctx.fillRect(Math.random() * r.width, Math.random() * r.height, 1.2, 1.2);
      ctx.fillStyle = '#374151';
      ctx.font = '800 15px "Plus Jakarta Sans", sans-serif';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText('SCRATCH HERE', r.width / 2, r.height / 2 - 9);
      ctx.font = '600 12px "Plus Jakarta Sans", sans-serif';
      ctx.fillText('to reveal your code', r.width / 2, r.height / 2 + 11);
    };
    const reveal = () => {
      if (revealed) return;
      revealed = true;
      canvas.style.transition = 'opacity .45s ease';
      canvas.style.opacity = '0';
      setTimeout(() => canvas.remove(), 500);
      panel.querySelector('[data-scratch-code]')?.removeAttribute('aria-hidden');
      panel.querySelector('[data-scratch-reveal]')?.classList.add('hidden');
      panel.querySelector('[data-scratch-hint]')?.classList.add('hidden');
      for (const sel of ['[data-copy-code]', '[data-shop-with]']) { const el = panel.querySelector(sel); el?.classList.remove('hidden'); el?.classList.add('inline-flex'); }
      const live = panel.querySelector('[data-scratch-live]');
      if (live) live.textContent = `Your code is ${code.split('').join(' ')}`;
    };
    const cleared = () => {
      if (!ctx) return 0;
      const { data } = ctx.getImageData(0, 0, canvas.width, canvas.height);
      let clear = 0;
      let seen = 0;
      for (let i = 3; i < data.length; i += 4 * 16) { seen++; if (data[i] < 40) clear++; }
      return seen ? clear / seen : 0;
    };
    const scratchAt = (e: PointerEvent) => {
      if (!ctx || revealed) return;
      const r = canvas.getBoundingClientRect();
      const p = { x: e.clientX - r.left, y: e.clientY - r.top };
      // A stroke from the last point, not a dot: a quick finger on a slow phone sends few move events.
      ctx.globalCompositeOperation = 'destination-out';
      ctx.lineCap = 'round';
      ctx.lineJoin = 'round';
      ctx.lineWidth = 44;
      ctx.beginPath();
      ctx.moveTo((last ?? p).x, (last ?? p).y);
      ctx.lineTo(p.x + 0.01, p.y);
      ctx.stroke();
      last = p;
      if (++moves % 8 === 0 && cleared() > 0.45) reveal();
    };
    paint();
    window.addEventListener('resize', () => { if (!revealed) paint(); });
    canvas.addEventListener('pointerdown', (e) => { drawing = true; last = null; canvas.setPointerCapture(e.pointerId); scratchAt(e); });
    canvas.addEventListener('pointermove', (e) => { if (drawing) scratchAt(e); });
    const stop = () => { drawing = false; last = null; if (!revealed && cleared() > 0.45) reveal(); };
    canvas.addEventListener('pointerup', stop);
    canvas.addEventListener('pointercancel', stop);
    panel.querySelector('[data-scratch-reveal]')?.addEventListener('click', reveal);
    panel.querySelector('[data-copy-code]')?.addEventListener('click', async (e) => {
      const btn = e.currentTarget as HTMLButtonElement;
      try { await navigator.clipboard.writeText(code); btn.textContent = 'Copied'; } catch { btn.textContent = code; }
    });
    // "Shop with it": checkout fills the gift card box from this tab (sessionStorage dies with the tab).
    panel.querySelector('[data-shop-with]')?.addEventListener('click', () => {
      try { sessionStorage.setItem('gp_gift_code', code); } catch { /* the code is on screen to type */ }
    });
  }
</script>

<script>
  import { PUBLIC_BUY_URL, canvasToBlob, captionSuggestions, drawShareImage, loadShareFonts, messageFits, shareContent, shareFileName, type ShareSize } from '../../lib/giftCardShare';

  // "Share your gift". Reads ONLY #gc-share-source (the permitted fields the page wrote), never the card's code,
  // balance or link. Nothing is posted anywhere: the picture is made here and handed to the phone's own share menu.
  const sourceEl = document.getElementById('gc-share-source');
  const panel = document.querySelector<HTMLElement>('[data-share-panel]');
  const openBtn = document.querySelector<HTMLButtonElement>('[data-share-open]');
  let raw: Record<string, unknown> | null = null;
  try { raw = JSON.parse(sourceEl?.textContent || 'null'); } catch { raw = null; }
  if (raw && panel && openBtn) {
    // Re-picked by name: even the page's own object cannot add a field the renderer would use.
    const source = {
      occasion: String(raw.occasion ?? 'gold'),
      recipientName: typeof raw.recipientName === 'string' ? raw.recipientName : null,
      senderName: typeof raw.senderName === 'string' ? raw.senderName : null,
      message: typeof raw.message === 'string' ? raw.message : null,
      originalUgx: typeof raw.originalUgx === 'number' ? raw.originalUgx : null,
      photoUrl: typeof raw.photoUrl === 'string' ? raw.photoUrl : null,
    };
    const canvas = panel.querySelector<HTMLCanvasElement>('[data-share-canvas]')!;
    const status = panel.querySelector<HTMLElement>('[data-share-status]')!;
    const retry = panel.querySelector<HTMLButtonElement>('[data-share-retry]')!;
    const nativeBtn = panel.querySelector<HTMLButtonElement>('[data-share-native]')!;
    const saveBtn = panel.querySelector<HTMLButtonElement>('[data-share-save]')!;
    const hint = panel.querySelector<HTMLElement>('[data-share-hint]')!;
    const captionBox = panel.querySelector<HTMLTextAreaElement>('[data-share-caption]')!;
    const linkBox = panel.querySelector<HTMLInputElement>('[data-share-link]')!;
    const excerptBox = panel.querySelector<HTMLElement>('[data-share-excerpt-box]')!;
    const excerpt = panel.querySelector<HTMLTextAreaElement>('[data-share-excerpt]')!;
    const excerptWarn = panel.querySelector<HTMLElement>('[data-share-excerpt-warn]')!;
    const choice = (k: string) => Boolean(panel.querySelector<HTMLInputElement>(`[data-share-opt="${k}"]`)?.checked);
    const size = () => (panel.querySelector<HTMLInputElement>('input[name="share-size"]:checked')?.value === 'story' ? 'story' : 'square') as ShareSize;
    let file: File | null = null;
    let blob: Blob | null = null;
    let timer = 0;
    let run = 0;

    // Captions: the occasion's own, then the general thank-yous. Never the private message, no tags, no hashtags.
    const chips = panel.querySelector<HTMLElement>('[data-share-captions]')!;
    for (const c of captionSuggestions(source.occasion)) {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'min-h-10 rounded-full border border-slate-300 bg-white px-3 text-xs font-bold text-gray-900';
      b.textContent = c;
      b.addEventListener('click', () => { captionBox.value = c; captionBox.focus(); });
      chips.append(b);
    }
    const caption = () => [captionBox.value.trim(), linkBox.checked ? PUBLIC_BUY_URL : ''].filter(Boolean).join('\n');

    async function render() {
      const mine = ++run;
      status.textContent = '';
      retry.classList.add('hidden');
      nativeBtn.disabled = true; saveBtn.disabled = true; file = null; blob = null;
      // Measured in the face it is drawn in (Montserrat), so "fits" means fits.
      await loadShareFonts();
      if (mine !== run) return;
      // A message too long for this size (beside the other chosen details) is never cut or shrunk: the recipient
      // writes a shorter one for the picture.
      const picked = { recipientName: choice('recipientName'), senderName: choice('senderName'), amount: choice('amount'), photo: choice('photo') };
      const rest = shareContent(source, { ...picked, message: false });
      let messageForPicture: string | null = null;
      if (choice('message') && source.message) {
        const ctx = canvas.getContext('2d')!;
        const fits = messageFits(ctx, source.message, size(), rest);
        excerptBox.classList.toggle('hidden', fits);
        if (!fits) {
          if (!excerpt.value) excerpt.value = source.message;
          const ok = messageFits(ctx, excerpt.value.trim(), size(), rest) && excerpt.value.trim().length > 0;
          excerptWarn.classList.toggle('hidden', ok);
          messageForPicture = ok ? excerpt.value.trim() : null;
        }
      } else excerptBox.classList.add('hidden');
      const content = shareContent(source, {
        ...picked,
        // In whole, when it fits; otherwise only the recipient's own shorter version (never a silent cut).
        message: choice('message') && (excerptBox.classList.contains('hidden') || messageForPicture !== null),
      }, messageForPicture);
      try {
        await drawShareImage(canvas, content, size());
        const b = await canvasToBlob(canvas);
        if (mine !== run) return; // a newer choice is being drawn
        blob = b;
        file = new File([b], shareFileName(source.occasion, size()), { type: 'image/png' });
        saveBtn.disabled = false;
        const canFiles = typeof navigator.canShare === 'function' && navigator.canShare({ files: [file] });
        nativeBtn.classList.toggle('hidden', !canFiles); nativeBtn.classList.toggle('inline-flex', canFiles);
        nativeBtn.disabled = !canFiles;
        hint.classList.toggle('hidden', canFiles);
      } catch {
        if (mine !== run) return;
        // Choices are kept; a retry draws again. Never a fallback to sharing a link.
        status.textContent = 'We could not make the picture just now. Your choices are kept.';
        retry.classList.remove('hidden');
      }
    }
    const soon = () => { clearTimeout(timer); timer = window.setTimeout(render, 120); };
    panel.addEventListener('change', (e) => { if ((e.target as HTMLElement).matches('[data-share-opt], input[name="share-size"]')) soon(); });
    excerpt.addEventListener('input', soon);
    retry.addEventListener('click', render);

    openBtn.hidden = false;
    openBtn.addEventListener('click', () => {
      const open = panel.classList.toggle('hidden') === false;
      openBtn.setAttribute('aria-expanded', String(open));
      if (open) { render(); panel.scrollIntoView({ block: 'nearest', behavior: 'smooth' }); }
    });
    panel.querySelector('[data-share-close]')?.addEventListener('click', () => { panel.classList.add('hidden'); openBtn.setAttribute('aria-expanded', 'false'); openBtn.focus(); });

    nativeBtn.addEventListener('click', async () => {
      if (!file) return;
      try {
        await navigator.share({ files: [file], text: caption() || undefined });
        status.textContent = ''; // the menu closed; whether it was posted is the app's to know, not ours to claim
      } catch (err) {
        // Closing the share menu is not an error.
        status.textContent = (err as DOMException)?.name === 'AbortError' ? '' : 'The share menu did not open. Save the image, then upload it in your favourite app.';
      }
    });
    saveBtn.addEventListener('click', () => {
      if (!blob || !file) return;
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url; a.download = file.name;
      document.body.append(a); a.click(); a.remove();
      setTimeout(() => URL.revokeObjectURL(url), 10_000);
      status.textContent = 'Your image is downloading.';
    });
    panel.querySelector('[data-share-copy]')?.addEventListener('click', async () => {
      const text = caption();
      if (!text) { status.textContent = 'Write or pick a caption first.'; captionBox.focus(); return; }
      try { await navigator.clipboard.writeText(text); status.textContent = 'Caption copied.'; }
      catch { captionBox.select(); status.textContent = 'Select the caption and copy it.'; }
    });
  }
</script>
