          )}
          <details class="mt-4 rounded-2xl border border-slate-200 bg-slate-50 p-4" open={askedFlag === '0'}>
            <summary class="cursor-pointer text-sm font-bold text-gray-900">Ask a question about this product</summary>
            <form method="POST" action="/api/questions/ask" class="mt-3 grid gap-3" data-ask-question>
              <input type="hidden" name="productId" value={product.id} />
              <input type="hidden" name="back" value={`/products/${product.slug}`} />
              <label class="block text-sm"><span class="font-semibold text-slate-700">Your question</span>
                <textarea name="question" required minlength="8" maxlength="500" rows="3" class="mt-1 w-full rounded-xl border border-slate-300 px-3 py-2 text-sm" placeholder="Does it fit the Tecno Spark 10? How long does the battery last?"></textarea></label>
              <div class="grid gap-3 sm:grid-cols-2">
                <label class="block text-sm"><span class="font-semibold text-slate-700">Your name</span>
                  <input name="name" required minlength="2" maxlength="80" autocomplete="name" class="mt-1 w-full rounded-xl border border-slate-300 px-3 py-2 text-sm" /></label>
                <label class="block text-sm"><span class="font-semibold text-slate-700">Phone or email <span class="font-normal text-slate-500">(optional: we send you the answer)</span></span>
                  <input name="phone" maxlength="254" autocomplete="tel" placeholder="07xx xxx xxx or you@example.com" class="mt-1 w-full rounded-xl border border-slate-300 px-3 py-2 text-sm" /></label>
              </div>
              <input type="hidden" name="email" value="" />
              <p class="text-xs text-slate-500">Your name and the question are shown with the answer; your number is not.</p>
              <button type="submit" class="inline-flex min-h-11 items-center justify-center rounded-full bg-brand-primary px-5 text-xs font-bold uppercase tracking-wider text-brand-black">Send the question</button>
              <p class="hidden text-sm font-semibold" data-ask-result role="status"></p>
            </form>
          </details>
          <script>
            // Ask without leaving the page; the form still works without JavaScript.
            document.querySelectorAll<HTMLFormElement>('form[data-ask-question]').forEach((form) => {
              form.addEventListener('submit', async (event) => {
                event.preventDefault();
                const button = form.querySelector('button');
                const out = form.querySelector<HTMLElement>('[data-ask-result]');
                if (!button || button.disabled || !out) return;
                button.disabled = true;
                const data = new FormData(form);
                const phoneOrEmail = String(data.get('phone') ?? '').trim();
                const body = { productId: data.get('productId'), name: data.get('name'), question: data.get('question'), phone: phoneOrEmail.includes('@') ? '' : phoneOrEmail, email: phoneOrEmail.includes('@') ? phoneOrEmail : '' };
                const res = await fetch('/api/questions/ask', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) }).catch(() => null);
                const json = res ? await res.json().catch(() => null) : null;
                out.classList.remove('hidden');
                if (json?.success) {
                  out.className = 'text-sm font-semibold text-emerald-800';
                  out.textContent = phoneOrEmail ? 'We have your question. A person at the shop will answer it and send you the answer.' : 'We have your question. A person at the shop will answer it, and the answer appears here.';
                  form.reset();
                } else {
                  out.className = 'text-sm font-semibold text-rose-800';
                  out.textContent = json?.error?.message || 'We could not take that question. Please try again.';
                  button.disabled = false;
                }
              });
            });
          </script>
        </section>
        <CompleteSetupRail
          productId={product.id}
          productSlug={product.slug}
          categoryName={product.categoryName}
          subcategoryName={productSubcategory}
        />
        {/* The rails carry their own vertical margin (my-12); the divider wrappers
            add no padding of their own, or the two stack into a void. */}
        <div class="border-t border-slate-100">
          <RelatedProductsRail
            productId={product.id}
            productSlug={product.slug}
            categoryName={product.categoryName}
            subcategoryName={productSubcategory}
          />
        </div>
        <div class="border-t border-slate-100">
          <RecentlyViewedRail 
            title="Browse available products"
            subtitle="A few more from the GoldPlus shelf."
            alwaysRender={true}
            excludeProductId={product.id}
            fallbackProducts={pdpFallbackProducts}
          />
        </div>
      </div>
    )}
  </div>
</BaseLayout>

{/* Sale countdown. SCOPED to the PDP's own element: the header carries
    data-sale-ends for the flash-sale strip, and a bare [data-sale-ends] query
    matched it FIRST — textContent then wiped the whole navigation. (Notes live
    out here: an is:inline script ships to the browser exactly as written.) */}
<script nonce={Astro.locals.cspNonce} is:inline>
  (function () {
    var el = document.querySelector('[data-pdp-sale-ends]');
    if (!el) return;
    var end = new Date(el.getAttribute('data-pdp-sale-ends')).getTime();
    if (!isFinite(end)) return;
    function tick() {
      var ms = end - Date.now();
      if (ms <= 0) { el.textContent = 'This offer has ended'; return; }
      var d = Math.floor(ms / 86400000), h = Math.floor((ms % 86400000) / 3600000), m = Math.floor((ms % 3600000) / 60000);
      el.textContent = d > 0 ? ('Offer ends in ' + d + 'd ' + h + 'h') : (h > 0 ? ('Offer ends in ' + h + 'h ' + m + 'm') : ('Offer ends in ' + m + 'm'));
    }
    tick();
    setInterval(tick, 60000);
  })();
</script>

<script>
  // WhatsApp chat taps on this page: reference code + lead (lib/whatsappClicks).
  import { installWhatsAppClicks } from '../../lib/whatsappClicks';
  installWhatsAppClicks();
  // Share this product: the phone's own share sheet where there is one, else copy the (tagged) link.
  (() => {
    const box = document.querySelector<HTMLElement>('[data-product-share]');
    if (!box) return;
    const status = box.querySelector<HTMLElement>('[data-share-status]');
    const native = box.querySelector<HTMLButtonElement>('[data-share-native]');
    if (native && typeof navigator.share === 'function') {
      native.hidden = false;
      native.addEventListener('click', () => {
        navigator.share({ title: box.dataset.shareTitle || '', text: box.dataset.shareText || '', url: box.dataset.shareUrl || '' }).catch(() => undefined);
      });
    }
    box.querySelector<HTMLButtonElement>('[data-share-copy]')?.addEventListener('click', async () => {
      const url = box.dataset.copyUrl || '';
      try { await navigator.clipboard.writeText(url); if (status) status.textContent = 'Link copied'; }
      catch { if (status) status.textContent = url; }
    });
  })();
  import {
    trackProductView,
    saveRecentlyViewedLocal,
    getAndClearClickAttribution,
    trackRecommendationEvent,
  } from '../../lib/recommendations';
  import { markSeenBefore } from '../../lib/returning-user';

  import {
    track,
    captureClickIdsServerSide,
    getFpClientId,
  } from '../../lib/telemetry';
  import { sendFinderEvent } from '../../lib/finderEvents';

  document.addEventListener('DOMContentLoaded', () => {
    const root = document.querySelector('[data-product-tracking]');
    if (!root) return;

    const id       = root.getAttribute('data-product-id') ?? '';
    const slug     = root.getAttribute('data-product-slug') ?? '';
    const name     = root.getAttribute('data-product-name') ?? '';
    const image    = root.getAttribute('data-product-image') ?? '';
    const priceRaw = root.getAttribute('data-product-price') ?? '';
    const categoryName = root.getAttribute('data-product-category') ?? '';
    const sku      = root.getAttribute('data-product-sku') || undefined;
    const price    = priceRaw ? Number(priceRaw) : undefined;

    // ── 1. Capture any click IDs from URL and persist them server-side ────────
    // This is the critical attribution step — if a user arrives via a Google/
    // Meta/TikTok ad and converts 3 days later, this persists the gclid/ttclid
    // so the purchase event can be enriched with it.
    captureClickIdsServerSide();

    if (id && name) {
      // ── 2. GA4-compatible view_item event ──────────────────────────────────
      track('view_item', {
        ecommerce: {
          value:    price,
          currency: 'UGX',
          items: [{
            item_id:       id,
            item_sku:      sku,
            item_name:     name,
            price:         price,
            quantity:      1,
            item_category: categoryName || undefined,
            item_brand:    'GoldPlus',
          }],
        },
      });

      // ── 3. Existing recommendation tracking ───────────────────────────────
      trackProductView(id).catch(() => {});
      // R7: the returning-visitor marker finally gets its writer — without it,
      // the homepage recently-viewed rail could never render for anyone.
      markSeenBefore();

      saveRecentlyViewedLocal({
        productId: id,
        slug,
        name,
        imageUrl:  image || undefined,
        price,
        currency:  'UGX',
      });
    }

    // ── 4. Sticky buy bar (phones/tablets) ───────────────────────────────────
    // Shown only while BOTH the buy form and the footer are out of view; it is
    // `hidden` in the markup, so without this observer nothing ever shows.
    const buyBar = document.querySelector<HTMLElement>('[data-pdp-buybar]');
    const buyForm = document.getElementById('pdp-buy');
    if (buyBar && buyForm && 'IntersectionObserver' in window) {
      const footer = document.querySelector('footer');
      let formInView = true;
      let footerInView = false;
      const observer = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (entry.target === buyForm) formInView = entry.isIntersecting;
          else footerInView = entry.isIntersecting;
        }
        buyBar.hidden = formInView || footerInView;
      });
      observer.observe(buyForm);
      if (footer) observer.observe(footer);
    }

    // ── 5. Add-to-Cart telemetry + recommendation attribution ────────────────
    // By id: "the first /cart form on the page" was an accident of DOM order.
    // The sticky bar's button submits this same form (form="pdp-buy").
    const form = document.getElementById('pdp-buy') as HTMLFormElement | null;
    if (form && id) {
      form.addEventListener('submit', () => {
        // A battery added to the basket, for the phone the customer chose (finder funnel; demand report).
        if (root.getAttribute('data-battery')) {
          sendFinderEvent({ eventType: 'ADDED_TO_CART', mode: 'PRODUCT_PAGE', productId: id, deviceSlug: root.getAttribute('data-battery-device') || null });
        }
        // GA4-compatible add_to_cart event (fires before page navigation)
        track('add_to_cart', {
          ecommerce: {
            value:    price,
            currency: 'UGX',
            items: [{
              item_id:       id,
              item_sku:      sku,
              item_name:     name,
              price:         price,
              quantity:      1,
              item_category: categoryName || undefined,
              item_brand:    'GoldPlus',
            }],
          },
        });

        // Existing recommendation attribution
        const attribution = getAndClearClickAttribution(id);
        if (attribution) {
          trackRecommendationEvent({
            eventType:               'RECOMMENDATION_ADD_TO_CART',
            recommendationProductId: id,
            placement:               attribution.placement,
            attributionId:           attribution.attributionId,
            railRenderId:            attribution.railRenderId,
            ruleId:                  attribution.ruleId,
            reasonCode:              attribution.reasonCode,
            source:                  'product_page',
          }).catch(() => {});
        } else {
          trackRecommendationEvent({
            eventType: 'PRODUCT_ADDED_TO_CART',
            productId: id,
            source:    'product_page',
          }).catch(() => {});
        }
      });
    }
  });
</script>
