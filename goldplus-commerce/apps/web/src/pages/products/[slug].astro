// No selling price = nothing to buy: checkout refuses a priceless line (PRICE_UNAVAILABLE).
const canBuy = product?.availability.kind === 'in_stock' && pdpHasPrice;
// "Deliver to": the area this customer told us (chosen, or their last checkout on this device), so the quote below
// is THEIR fee, not "from …". Never inferred from the IP address.
// 0193: else the area they set on another device when signed in (kept on their profile), never a guess.
const deliverTo = canBuy
  ? (Astro.locals.gpDeliverTo !== undefined
      ? Astro.locals.gpDeliverTo
      : await resolveDeliveryPlace({ cookies: Astro.cookies, request: Astro.request, visit: Astro.locals.gpVisit, secure: import.meta.env.PROD }))
  : null;
const humanVisitor = isLikelyHuman(Astro.request.headers.get('user-agent'));
// Search snippet (2026-10-08 SEO audit: all 183 titles were the bare name and
// every description the same template; none said Kampala, Uganda or the price,
// which is how shoppers here search — "… price in Uganda"). Built only from
// facts on this page: the price charged today (campaign included), the stock
// state, the product's own summary and the admin-editable delivery note.
const metaPriceUgx = product && pdpHasPrice ? (pdpOnSale && pdpSaleUgx !== null ? pdpSaleUgx : product.retailPriceUgx) : null;
const metaPrice = typeof metaPriceUgx === 'number' ? `UGX ${metaPriceUgx.toLocaleString('en-UG')}` : null;
const pageTitle = product
  ? `${product.name} | ${metaPrice ? `${metaPrice} in ` : ''}Kampala, Uganda`
  : 'Product unavailable';
const metaStock: Record<ProductPublicDto['availability']['kind'], string> = {
  in_stock: 'in stock',
  out_of_stock: 'currently out of stock',
  pre_order: 'available to pre-order',
  unknown: 'ask us about stock',
};
const firstSentence = (s: string | null | undefined) => (s ?? '').trim().split(/(?<=\.)\s/)[0] ?? '';
const clip = (s: string, max: number) => (s.length <= max ? s : `${s.slice(0, s.lastIndexOf(' ', max - 1)).replace(/[,;:.\s]+$/, '')}…`);
const description = product
  ? clip(
      [
        `${product.name}${metaPrice ? ` for ${metaPrice}` : ''}, ${metaStock[product.availability.kind]}.`,
        (product.shortDescription ?? '').trim(),
        firstSentence(bizForPdp.deliveryNote),
      ].filter(Boolean).join(' '),
      160,
    )
  : 'This product is temporarily unavailable.';
// Path only: ?searchQuery=…&searchRank=… must never become the canonical.
// SITE_ORIGIN, not the request's origin: the product pages are the ones that
// have to rank, and a canonical that agrees with whichever host the crawler
// used left each of them competing against its own www twin.
const canonical = `${SITE_ORIGIN}${Astro.url.pathname}`;
// Share this product (2026-10-23): a customer passing a product on in WhatsApp or anywhere else is the commonest way
// it travels, and an untagged link counted as Direct. The links carry the rulebook's PRODUCT_SHARE_TAGS (a friend
// referral in GA4, our reports and the order's source) and how it went (utm_content). wa.me/?text= has no number: it
// is a share, never a chat with us (lib/whatsappClicks leaves it alone: no reference code, no lead).
const sharePrice = product && pdpHasPrice ? (pdpOnSale ? pdpSaleUgx : product.retailPriceUgx) : null;
const shareLine = product ? `${product.name}${sharePrice ? `, ${formatUgx(sharePrice)}` : ''} at GoldPlus` : '';
const shareWhatsAppHref = product ? `https://wa.me/?text=${encodeURIComponent(`${shareLine}\n${productShareUrl(canonical, 'whatsapp')}`)}` : null;
const shareNativeUrl = product ? productShareUrl(canonical, 'share') : null;
const shareCopyUrl = product ? productShareUrl(canonical, 'copy') : null;

// U6 AC4 — BreadcrumbList JSON-LD (Home → category → product) from the real
// category already rendered on the page. The category URL is the shop filtered
// to that category (there are no dedicated category pages); it is only included
// when the category maps back to a taxonomy slug.
let breadcrumbJson: string | null = null;
// Hoisted: the visible breadcrumb renders the same category the JSON-LD names.
let crumbCategory: { name: string; slug: string } | undefined;
if (product) {
  crumbCategory = await crumbCategoryP;
  // The breadcrumb JSON-LD names the same one host as the canonical above.
  const origin = SITE_ORIGIN;
  const crumbs = [{ name: 'Home', url: `${origin}/` }];
  if (crumbCategory) crumbs.push({ name: crumbCategory.name, url: `${origin}${indexableCategoryHref(`/shop?category=${encodeURIComponent(crumbCategory.slug)}`)}` });
  crumbs.push({ name: product.name, url: canonical });
  breadcrumbJson = serializeJsonLd(breadcrumbJsonLd(crumbs));
}
