---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { apiBase } from "../../lib/api";

const { slug } = Astro.params;

// Default fallback
let product = {
  id: slug || 'unknown',
  name: slug === 'generic-fast-charger' ? 'Generic Fast Charger' : 'Wireless Earbuds',
  category: slug === 'generic-fast-charger' ? 'Power Devices' : 'Sound Devices',
  priceUgx: slug === 'generic-fast-charger' ? 50000 : 80000,
  stockStatus: 'in_stock',
  modelNumber: 'Missing. Requires admin review.',
  sku: 'Missing. Requires admin review.',
  shortDescription: 'Missing. Requires admin review. Authentic product verified by GoldPlus.',
  hasImage: false,
  warrantyPeriod: 'Unspecified in source.',
  compatibility: 'Unspecified in source.',
  imageUrl: undefined as string | undefined
};

let isRealData = false;

try {
  const res = await fetch(`${apiBase}/products/${slug}`, { signal: AbortSignal.timeout(2000) });
  if (res.ok) {
    const json = await res.json();
    if (json.success && json.data) {
      product = { ...product, ...json.data };
      isRealData = true;
    }
  }
} catch (err) {
  // Silent fallback to mock
}

const formatter = new Intl.NumberFormat('en-UG', { style: 'currency', currency: 'UGX', maximumFractionDigits: 0 });
const formattedPrice = formatter.format(product.priceUgx);
const inStock = product.stockStatus !== 'out_of_stock';
---

<BaseLayout title={`${product.name} | GoldPlus`}>
  <div class="bg-gray-50 py-4 border-b border-gray-200">
    <div class="container mx-auto px-4 lg:px-8">
      <nav class="flex text-sm text-gray-500 font-medium" aria-label="Breadcrumb">
        <a href="/" class="hover:text-brand-dark transition-colors">Home</a>
        <span class="mx-2">/</span>
        <a href="/shop" class="hover:text-brand-dark transition-colors">Shop</a>
        <span class="mx-2">/</span>
        <a href={`/shop?category=${product.category.toLowerCase().split(' ')[0]}`} class="hover:text-brand-dark transition-colors">{product.category}</a>
        <span class="mx-2">/</span>
        <span class="text-brand-dark" aria-current="page">{product.name}</span>
      </nav>
    </div>
  </div>

  <div class="container mx-auto px-4 lg:px-8 py-12 lg:py-16">
    <div class="flex flex-col lg:flex-row gap-12">
      
      {/* Product Image Area */}
      <div class="w-full lg:w-1/2">
        <div class="bg-gray-100 aspect-square rounded-2xl flex items-center justify-center relative overflow-hidden border border-gray-200">
          {product.imageUrl ? (
            <img src={product.imageUrl} alt={product.name} class="w-full h-full object-cover" />
          ) : (
            <div class="text-gray-400 font-medium flex flex-col items-center">
              <svg class="w-16 h-16 mb-4 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
              <p>Image Missing. Requires admin review.</p>
            </div>
          )}
        </div>
      </div>

      {/* Product Info Area */}
      <div class="w-full lg:w-1/2 flex flex-col">
        <div class="mb-6">
          <p class="text-sm font-bold text-brand-green uppercase tracking-widest mb-2">{product.category}</p>
          <h1 class="text-3xl md:text-5xl font-black tracking-tight text-brand-dark mb-4">{product.name}</h1>
          
          <div class="flex items-baseline gap-4 mb-4">
            <p class="text-3xl font-black text-brand-dark">{formattedPrice}</p>
            <span class={`text-xs font-bold px-3 py-1.5 rounded-full uppercase tracking-wider ${inStock ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800'}`}>
              {inStock ? 'In Stock' : 'Out of Stock'}
            </span>
          </div>
          
          <p class="text-gray-600 text-lg leading-relaxed">{product.shortDescription}</p>
        </div>

        {/* Missing Data Warning Panel */}
        {!isRealData && (
          <div class="bg-orange-50 border border-orange-200 rounded-xl p-4 mb-8">
            <h3 class="font-bold text-orange-800 flex items-center gap-2 mb-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
              Data Missing
            </h3>
            <p class="text-sm text-orange-700">Some specifications for this product have not been verified by an admin yet. We do not invent claims.</p>
          </div>
        )}

        {/* Specs Table */}
        <div class="border border-gray-200 rounded-xl overflow-hidden mb-8">
          <table class="w-full text-sm text-left">
            <tbody>
              <tr class="border-b border-gray-200">
                <th class="px-4 py-3 bg-gray-50 font-bold text-brand-dark w-1/3">Model</th>
                <td class={`px-4 py-3 font-medium ${product.modelNumber.includes('Missing') ? 'text-red-600' : 'text-gray-800'}`}>{product.modelNumber}</td>
              </tr>
              <tr class="border-b border-gray-200">
                <th class="px-4 py-3 bg-gray-50 font-bold text-brand-dark w-1/3">SKU</th>
                <td class={`px-4 py-3 font-medium ${product.sku.includes('Missing') ? 'text-red-600' : 'text-gray-800'}`}>{product.sku}</td>
              </tr>
              <tr class="border-b border-gray-200">
                <th class="px-4 py-3 bg-gray-50 font-bold text-brand-dark w-1/3">Warranty</th>
                <td class="px-4 py-3 text-gray-500 italic">{product.warrantyPeriod}</td>
              </tr>
              <tr>
                <th class="px-4 py-3 bg-gray-50 font-bold text-brand-dark w-1/3">Compatibility</th>
                <td class="px-4 py-3 text-gray-500 italic">{product.compatibility}</td>
              </tr>
            </tbody>
          </table>
        </div>

        {/* Action Buttons */}
        <div class="flex flex-col sm:flex-row gap-4 mb-8">
          <button 
            id="add-to-cart-btn"
            disabled={!inStock} 
            data-product={JSON.stringify({
              productId: product.id,
              sku: product.sku,
              name: product.name,
              priceUgx: product.priceUgx,
              category: product.category
            })}
            class={`flex-1 py-4 px-6 rounded-lg font-bold text-lg transition-colors outline-none focus:ring-4 focus:ring-brand-gold ${inStock ? 'bg-brand-dark text-white hover:bg-black' : 'bg-gray-100 text-gray-400 cursor-not-allowed'}`}>
            {inStock ? 'Add to Cart' : 'Currently Unavailable'}
          </button>
          <a href="/quotes" class="flex-1 py-4 px-6 rounded-lg font-bold text-lg text-center transition-colors outline-none border-2 border-gray-200 text-brand-dark hover:border-brand-dark focus:ring-4 focus:ring-gray-100">
            Request Quote
          </a>
        </div>

        {/* Trust Links */}
        <div class="border-t border-gray-200 pt-6 mt-auto">
          <h4 class="font-bold text-brand-dark mb-4 text-sm uppercase tracking-widest">Support & Trust</h4>
          <div class="flex flex-wrap gap-3">
            <a href="/verification" class="text-sm font-semibold text-gray-600 bg-gray-100 px-4 py-2 rounded hover:bg-gray-200 hover:text-brand-dark transition-colors flex items-center gap-2">
              <svg class="w-4 h-4 text-brand-green" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
              Verify Product
            </a>
            <a href="/support/issue" class="text-sm font-semibold text-gray-600 bg-gray-100 px-4 py-2 rounded hover:bg-gray-200 hover:text-brand-dark transition-colors">
              Report Issue
            </a>
            <a href="/support/fake" class="text-sm font-semibold text-red-600 bg-red-50 px-4 py-2 rounded hover:bg-red-100 transition-colors">
              Report Fake
            </a>
          </div>
        </div>

      </div>
    </div>
  </div>

  <script>
    import { addOrUpdateCartItem, type CartItem } from '../../lib/cart';

    const btn = document.getElementById('add-to-cart-btn');
    if (btn) {
      btn.addEventListener('click', () => {
        const productData = JSON.parse(btn.getAttribute('data-product') || '{}');
        const currentCart: CartItem[] = JSON.parse(localStorage.getItem('gp_cart') || '[]');
        
        const newItem: CartItem = {
          productId: productData.productId,
          sku: productData.sku || 'GEN-SKU',
          name: productData.name,
          priceUgx: productData.priceUgx,
          category: productData.category,
          quantity: 1
        };

        const updatedCart = addOrUpdateCartItem(currentCart, newItem);
        
        localStorage.setItem('gp_cart', JSON.stringify(updatedCart));
        
        const oldText = btn.innerText;
        btn.innerText = 'Added to Cart!';
        btn.classList.add('bg-green-700');
        setTimeout(() => {
          btn.innerText = oldText;
          btn.classList.remove('bg-green-700');
        }, 1500);
      });
    }
  </script>
</BaseLayout>
