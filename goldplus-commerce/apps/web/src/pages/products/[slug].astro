              ))}
            </ul>
            <p class="mt-3 text-xs text-slate-500">Bought this? <a class="font-bold underline" href="/review">Rate it</a> once it has reached you.</p>
          </section>
          <script>
            // "Helpful" without leaving the page; the form still works without JavaScript.
            document.querySelectorAll<HTMLFormElement>('form[data-review-vote]').forEach((form) => {
              form.addEventListener('submit', async (event) => {
                event.preventDefault();
                const button = form.querySelector('button');
                if (!button || button.disabled) return;
                button.disabled = true;
                const data = new FormData(form);
                const res = await fetch('/api/reviews/vote', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ reviewId: data.get('reviewId'), vote: 'helpful' }),
                }).catch(() => null);
                const count = form.querySelector('[data-count]');
                if (res?.ok && count) {
                  const n = Number((count.textContent ?? '').replace(/\D/g, '')) || 0;
                  count.textContent = `(${n + 1})`;
                  button.setAttribute('aria-pressed', 'true');
                  button.title = 'Thanks for saying so';
                } else {
                  button.disabled = false;
                }
              });
            });
