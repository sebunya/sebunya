---
import DeliveryQuote from "../../components/DeliveryQuote.astro";
import DeliverTo from "../../components/DeliverTo.astro";
import { resolveDeliveryPlace } from "../../lib/locationSignals";
import { indexableCategoryHref } from '../../lib/indexableLinks';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductJsonLd from '../../components/ProductJsonLd.astro';
import Notice from '../../components/Notice.astro';
import { apiBase } from '../../lib/api';
import { formatUgx } from '../../lib/money';
import { getStorefrontDiscount, salePriceUgx, effectiveFloorUgx } from '../../lib/storefrontDiscount';
import type { ProductPublicDto, ApiEnvelope, ApiResponse } from '@goldplus/shared';
import CompleteSetupRail from '../../components/recommendations/CompleteSetupRail.astro';
import RelatedProductsRail from '../../components/recommendations/RelatedProductsRail.astro';
import RecentlyViewedRail from '../../components/recommendations/RecentlyViewedRail.astro';
import { normalizeProductCategory, getCleanCatalog } from '../../lib/catalog/catalog';
import { readSessionToken } from '../../lib/session';
import { getProductSubcategory, pickComparisonPeers, subcategoryNameForSlug } from '../../lib/product-discovery';
import { getTaxonomy } from '../../lib/taxonomy';
import { previewRecommendationRules, productToRecommendationItem } from '../../lib/recommendation-display';
import { breadcrumbJsonLd, serializeJsonLd } from '../../lib/jsonld';
import { getBusinessInfo } from '../../lib/businessInfo';
import ThisPhoneSuggestion from '../../components/ThisPhoneSuggestion.astro';
import CheckYourPhoneNote from '../../components/CheckYourPhoneNote.astro';
import AskGoldie from '../../components/AskGoldie.astro';
import { productQuestions, todayStillOpen } from '../../lib/goldieQuestions';
import ProductGallery from '../../components/product/ProductGallery.astro';
// Focus 4 rollback switch: PRODUCT_GALLERY_ENRICHMENT=false shows slot 1 only (still the correct cover).
const galleryEnrichment = process.env.PRODUCT_GALLERY_ENRICHMENT !== 'false';
import { publicBattery, parseDeviceCookie, serialiseDeviceCookie, DEVICE_COOKIE, FIT_BADGE } from '../../lib/batteries';
import { phoneBatteryPath, phoneGuides } from '../../lib/phoneBatteryPage';
import { SITE_ORIGIN } from '../../lib/sitemap';
import { RETURNS_POLICY } from '../../lib/returnsPolicy';
import { getStorefrontCopy } from '../../lib/storefrontCopy';
import { findRecordedRedirect } from '../../lib/recordedRedirect';
import { carryQuery } from '../../lib/carryQuery';
import { productShareUrl } from '@goldplus/shared/src/attribution/arrival';
import { isLikelyHuman } from '../../lib/humanTraffic';
import { getProductReviews, aggregateRatingNode, starsText } from '../../lib/reviews';
import { getProductQuestions } from '../../lib/questions';

/**
 * A product that was on sale and is off sale now (drafted until photographed,
 * or discontinued): still a 404 for search engines, but a person on an old
 * link, a WhatsApp share or a Goldie card gets the name and the way to the
 * range. The API says PRODUCT_NOT_LISTED only for a once-published product.
 */
async function notListedResponse(res: Response): Promise<Response | null> {
  const body = (await res.json().catch(() => null)) as { error?: { code?: string; details?: { name?: string; categorySlug?: string | null; categoryName?: string | null } } } | null;
  const notice = body?.error?.code === 'PRODUCT_NOT_LISTED' ? body.error.details : null;
  if (!notice?.name) return null;
  const esc = (t: string) => t.replace(/[&<>"]/g, (ch) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[ch] as string));
  const hubHref = notice.categorySlug ? indexableCategoryHref(`/shop?category=${encodeURIComponent(notice.categorySlug)}`) : '/shop';
  const biz = await getBusinessInfo().catch(() => null);
  return new Response(
    `<!doctype html><html lang="en"><head><meta charset="utf-8">` +
      `<meta name="viewport" content="width=device-width,initial-scale=1">` +
      `<meta name="robots" content="noindex,follow">` +
      `<title>${esc(notice.name)} is not listed right now | GoldPlus</title></head>` +
      `<body style="font-family:system-ui,sans-serif;margin:0;padding:3rem 1.5rem;color:#0A0A0A;background:#fbfbf7">` +
      `<main style="max-width:34rem;margin:0 auto">` +
      `<p style="font-size:.75rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:#456b00">GoldPlus</p>` +
      `<h1 style="font-size:1.5rem;font-weight:800;line-height:1.25">${esc(notice.name)} is not listed right now</h1>` +
      `<p style="line-height:1.6">This product is off the shop for the moment, so there is no price or stock to show. ` +
      `If you need it, ask us and we will tell you whether it is back soon${notice.categoryName ? `, or browse the current ${esc(notice.categoryName.toLowerCase())} range` : ''}.</p>` +
      `<p style="display:flex;flex-wrap:wrap;gap:.6rem;margin-top:1.5rem">` +
      `<a href="${esc(hubHref)}" style="font-weight:800;color:#fff;background:#0A0A0A;padding:.7rem 1.1rem;border-radius:9999px;text-decoration:none">Browse the range</a>` +
      (biz?.whatsappUrl ? `<a href="${esc(biz.whatsappUrl)}" style="font-weight:800;color:#456b00;border:1.5px solid #456b00;padding:.7rem 1.1rem;border-radius:9999px;text-decoration:none">Ask us on WhatsApp</a>` : '') +
      `<a href="/shop" style="font-weight:700;color:#456b00;padding:.7rem .4rem;text-decoration:underline">All products</a>` +
      `</p></main></body></html>`,
    { status: 404, headers: { 'Content-Type': 'text/html; charset=utf-8', 'Cache-Control': 'no-store' } },
  );
}

const { slug } = Astro.params;
const searchQuery = Astro.url.searchParams.get('searchQuery') ?? '';
const searchRank = Number(Astro.url.searchParams.get('searchRank') ?? 0);

let product: ProductPublicDto | null = null;
let fetchError: string | null = null;
let isOfflineFallback = false;

try {
  const res = await fetch(`${apiBase}/products/${encodeURIComponent(slug ?? '')}`, {
    headers: { Accept: 'application/json' },
    signal: AbortSignal.timeout(3000)
  });
  if (res.ok) {
    const json = (await res.json()) as ApiEnvelope<ProductPublicDto>;
    if (json.success && json.data) {
      product = normalizeProductCategory(json.data);
    } else {
      fetchError = json.error?.message ?? 'Unexpected API response.';
    }
  } else if (res.status === 404) {
    // R1: the seed-catalogue rescue is retired. It rendered a fully
    // fabricated PDP — invented price, working Add-to-cart — for products the
    // database has never contained. A product the API does not know is a 404,
    // unless the path has a recorded redirect (a changed slug): handing over
    // to 404.astro cannot redirect, because Astro keeps this 404 status.
    {
      const recorded = await findRecordedRedirect(Astro.url.pathname);
      if (recorded) return Astro.redirect(carryQuery(recorded.target, Astro.url.search), recorded.status);
      const unlisted = await notListedResponse(res);
      if (unlisted) return unlisted;
      return Astro.redirect('/404', 404);
    }
  } else {
    fetchError = 'We could not load this product right now.';
  }
} catch {
  fetchError = 'Cannot reach the product service right now.';
}

if (!product) {
  // R1: no seed rescue here either — a product page is never fabricated.
  // But "we cannot reach the catalogue" is not "this product does not exist".
  // Answering 404 to a blip told the customer the item was gone and invited
  // search engines to drop a live product URL. A reachability failure is a 503
  // with Retry-After; only a real 404 from the API is a 404.
  if (fetchError) {
    return new Response(
      `<!doctype html><html lang="en"><head><meta charset="utf-8">` +
        `<meta name="viewport" content="width=device-width,initial-scale=1">` +
        `<meta name="robots" content="noindex,follow">` +
        `<title>This page is not loading right now | GoldPlus</title></head>` +
        `<body style="font-family:system-ui,sans-serif;margin:0;padding:3rem 1.5rem;color:#0A0A0A">` +
        `<main style="max-width:32rem;margin:0 auto">` +
        `<h1 style="font-size:1.5rem;font-weight:800">This page is not loading right now</h1>` +
        `<p style="line-height:1.6">The product is still in our shop. We just could not load its details this moment. ` +
        `Please try again shortly.</p>` +
        `<p><a href="/shop" style="font-weight:700">Back to the shop</a></p>` +
        `</main></body></html>`,
      {
        status: 503,
        headers: { 'Content-Type': 'text/html; charset=utf-8', 'Retry-After': '30', 'Cache-Control': 'no-store' },
      },
    );
  }
  // Not the 503 above: an unreachable API is not a missing product.
  {
    const recorded = await findRecordedRedirect(Astro.url.pathname);
    if (recorded) return Astro.redirect(carryQuery(recorded.target, Astro.url.search), recorded.status);
    return Astro.redirect('/404', 404);
  }
}

// A search click is a PERSON choosing a result: a crawler following every
// result link counted a click for each, so the ranking report showed near-100%
// CTR whatever people chose. Fire-and-forget, as shop.astro does: awaiting it
// held every search click-through up to half a second before rendering.
if (searchQuery && Number.isInteger(searchRank) && searchRank >= 1 && searchRank <= 50 && isLikelyHuman(Astro.request.headers.get('user-agent'))) {
  fetch(`${apiBase}/products/search-interactions`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ query: searchQuery, productId: product.id, rank: searchRank, type: 'click' }),
    signal: AbortSignal.timeout(500),
  }).catch(() => {});
}

/**
 * Honour any recorded lifecycle SEO decision for this product. A decision is
 * a deliberate human act, so the page obeys it: a 301 only ever goes to a
 * genuine successor product, and a discontinued-but-honest page keeps its 200
 * and its indexability because it still answers the customer's question.
 * No decision recorded = nothing changes.
 */
let lifecycleNotice: string | null = null;
let lifecycleNoindex = false;
let lifecycleAlternatives = false;
try {
  const lcRes = await fetch(`${apiBase}/seo/product-lifecycle?productId=${encodeURIComponent(product.id)}`, {
    headers: { Accept: 'application/json' },
    signal: AbortSignal.timeout(700),
  });
  const lcJson = (await lcRes.json()) as ApiResponse<{
    decided?: boolean;
    successorSlug?: string | null;
    outcome?: { httpStatus?: number; indexable?: boolean; showAlternatives?: boolean; notice?: string | null } | null;
  }>;
  if (lcJson.success && lcJson.data?.decided && lcJson.data.outcome) {
    const o = lcJson.data.outcome;
    if (o.httpStatus === 301 && lcJson.data.successorSlug) {
      return Astro.redirect(carryQuery(`/products/${lcJson.data.successorSlug}`, Astro.url.search), 301);
    }
    // A real 410 page. Astro.redirect('/404', 410) is not a redirect Astro can
    // reroute (only 404/500 are), so it answered 410 with `location: /404` and
    // an EMPTY body: a blank screen for a person, and for an ad click a
    // "landing page not working". Gone is said in words, with a way on.
    if (o.httpStatus === 410) {
      const esc = (v: string) => v.replace(/[&<>"']/g, (ch) => `&#${ch.charCodeAt(0)};`);
      return new Response(
        `<!doctype html><html lang="en"><head><meta charset="utf-8">` +
          `<meta name="viewport" content="width=device-width,initial-scale=1">` +
          `<meta name="robots" content="noindex,follow">` +
          `<title>No longer available | GoldPlus</title></head>` +
          `<body style="font-family:system-ui,sans-serif;margin:0;padding:3rem 1.5rem;color:#0A0A0A">` +
          `<main style="max-width:32rem;margin:0 auto">` +
          `<h1 style="font-size:1.5rem;font-weight:800">${esc(product.name)} is no longer available</h1>` +
          `<p style="line-height:1.6">${esc(o.notice ?? 'This page is no longer available.')} GoldPlus no longer sells this item.</p>` +
          `<p><a href="/shop" style="font-weight:700">See what GoldPlus sells now</a></p>` +
          `</main></body></html>`,
        { status: 410, headers: { 'Content-Type': 'text/html; charset=utf-8', 'Cache-Control': 'public, max-age=300' } },
      );
    }
    lifecycleNotice = o.notice ?? null;
    lifecycleNoindex = o.indexable === false;
    lifecycleAlternatives = o.showAlternatives === true;
  }
} catch {
  // The decision service is advisory: if it is unreachable the product page
  // behaves exactly as it always did rather than failing or redirecting.
}

/**
 * Every read below depends only on the product, so they all start NOW and each
 * is awaited where it is used. They ran one after another: with the API slow
 * but up, each waited close to its own timeout and the page's first byte took
 * the sum (about 30 s), not the slowest one. Each keeps its own timeout and its
 * own fallback. The lifecycle decision above stays first: it can answer 301/410.
 * `settle` only stops an early rejection from being reported as unhandled while
 * the page is still awaiting something else; the later await still sees it.
 */
const settle = <T,>(p: Promise<T>): Promise<T> => { p.catch(() => undefined); return p; };
const taxonomyP = settle(getTaxonomy());
const bizP = settle(getBusinessInfo());
// Started with the page's other parallel reads, so reviews never add a round trip.
const productReviewsP = settle(getProductReviews(product!.id));
const answeredQuestionsP = settle(getProductQuestions(product!.id));
// Bundles (gap analysis #9): approved promotions that need this product and others together, priced by the
// evaluator (what is shown is what checkout charges). Started with the other reads.
type PdpBundle = { promotionId: string; name: string; productIds: string[]; togetherUgx: number; separatelyUgx: number; savingUgx: number; endsAt: string; products: ProductPublicDto[] };
const bundlesP: Promise<PdpBundle[]> = (async () => {
  const res = await fetch(`${apiBase}/commerce/bundles?productId=${encodeURIComponent(product!.id)}`, { signal: AbortSignal.timeout(2500) });
  const list = res.ok ? (((await res.json()) as ApiResponse<Omit<PdpBundle, 'products'>[]>).data ?? []) : [];
  if (!Array.isArray(list) || list.length === 0) return [];
  const ids = [...new Set(list.flatMap((b) => b.productIds))];
  // The public list answers at most three ids per call: asked for all at once, a 4-product bundle (or two bundles
  // with more than three partners between them) came back short and was dropped, so it never showed (2026-10-22).
  const batches: string[][] = [];
  for (let i = 0; i < ids.length; i += 3) batches.push(ids.slice(i, i + 3));
  const products = (await Promise.all(batches.map(async (batch) => {
    const pr = await fetch(`${apiBase}/products?ids=${batch.join(',')}&limit=${batch.length}`, { signal: AbortSignal.timeout(2500) });
    return pr.ok ? (((await pr.json()) as ApiResponse<ProductPublicDto[]>).data ?? []) : [];
  }))).flat();
  const byId = new Map(products.map((x) => [x.id, x]));
  // Only a bundle whose every product is listed right now.
  return list
    .map((b) => ({ ...b, products: b.productIds.map((id) => byId.get(id)).filter((x): x is ProductPublicDto => Boolean(x)) }))
    .filter((b) => b.products.length === b.productIds.length);
})().catch(() => []);
// "Save for later" (gap analysis #6): whether this signed-in shopper already saved it. Signed-in only, started
// with the other reads so it adds no round trip.
const pdpSessionToken = readSessionToken(Astro.request);
const pdpSavedP: Promise<boolean> = pdpSessionToken
  ? fetch(`${apiBase}/account/saved/${product!.id}`, { headers: { Authorization: `Bearer ${pdpSessionToken}` }, signal: AbortSignal.timeout(1500) })
      .then(async (r) => (r.ok ? Boolean(((await r.json()) as { data?: { saved?: boolean } })?.data?.saved) : false))
      .catch(() => false)
  : Promise.resolve(false);
const storefrontCopyP = settle(getStorefrontCopy());
const discountP = settle(getStorefrontDiscount());
// The browse-rail fallback needs a handful of candidates, not the whole
// catalogue: the product's own category plus one general page (the rail caps
// any one category at two), never every page of every product.
const crumbCategoryP = taxonomyP.then((tax) => tax.find((cat) => cat.name === product!.categoryName)).catch(() => undefined);
const fetchProductList = async (query: string): Promise<ProductPublicDto[]> => {
  const res = await fetch(`${apiBase}/products?${query}`, { headers: { Accept: 'application/json' }, signal: AbortSignal.timeout(3000) });
  if (!res.ok) return [];
  const body = (await res.json()) as ApiResponse<ProductPublicDto[]>;
  return body.success && Array.isArray(body.data) ? body.data : [];
};
const fallbackCandidatesP: Promise<ProductPublicDto[]> = (async () => {
  const cat = await crumbCategoryP;
  const [sameCategory, general] = await Promise.all([
    cat ? fetchProductList(`category=${encodeURIComponent(cat.slug)}&limit=12`).catch(() => []) : Promise.resolve([] as ProductPublicDto[]),
    fetchProductList('limit=24').catch(() => []),
  ]);
  const seen = new Set<string>();
  return [...sameCategory, ...general].filter((p) => (seen.has(p.id) ? false : (seen.add(p.id), true)));
})().catch(() => []);
// Earn rate and the redemption value of a point, both from the live programme
// (the /loyalty worked example reads the same config, so the two cannot drift).
const loyaltyP: Promise<{ rate: number; pointValueUgx: number }> = (async () => {
  const lpRes = await fetch(`${apiBase}/commerce/loyalty-programme`, { signal: AbortSignal.timeout(2000) });
  const lpJson: any = lpRes.ok ? await lpRes.json().catch(() => null) : null;
  if (!(lpJson?.success && lpJson.data?.active)) return { rate: 0, pointValueUgx: 0 };
  const redemption = lpJson.data.redemption;
  return {
    rate: Number(lpJson.data.earnRatePer1000Ugx) || 0,
    pointValueUgx: redemption?.configured ? Number(redemption.pointValueUgx) || 0 : 0,
  };
})().catch(() => ({ rate: 0, pointValueUgx: 0 }));
const loyaltyRateP: Promise<number> = loyaltyP.then((l) => l.rate);
const compatibilityP: Promise<unknown> = (async () => {
  const compatRes = await fetch(`${apiBase}/products/${encodeURIComponent(product!.slug)}/compatibility`, { signal: AbortSignal.timeout(2000) });
  return compatRes.json().catch(() => null);
})().catch(() => null);
const batteryP = publicBattery<BatteryPublic>(`/products/${encodeURIComponent(product.slug)}`);
const selectedDeviceParam = (Astro.url.searchParams.get('device') ?? '').trim().slice(0, 160);
// record=0: the finder already counted this phone when the customer chose it;
// resolving the link here is not a second choice (nor is a reload or a crawl).
const chosenDeviceP = selectedDeviceParam && /^[a-z0-9-]{1,160}$/.test(selectedDeviceParam)
  ? publicBattery<{ device: { slug: string; label: string } }>(`/finder/devices/${encodeURIComponent(selectedDeviceParam)}?record=0`)
  : null;

const hasValidSku = product.sku && product.sku !== 'Needs Business Confirmation' && !product.sku.toLowerCase().includes('pending');
const verifiedAttributes = product.attributeValues.filter((v) => v.isVerified && v.name !== 'Badge' && v.name !== 'CardShortDescription');

const pdpSaved: boolean = await pdpSavedP;
const pdpBundles: PdpBundle[] = await bundlesP;
const productSubcategory = getProductSubcategory(product, await taxonomyP);
// "Compare with similar" (gap #11): same subcategory, nearest price, from the candidates already fetched for the rail.
const comparePeers: ProductPublicDto[] = await fallbackCandidatesP
  .then(async (list) => pickComparisonPeers(product!, list, await taxonomyP))
  .catch(() => []);
const compareSubName = subcategoryNameForSlug(productSubcategory, await taxonomyP).toLowerCase();
const compareLabel = comparePeers.length === 1
  ? `Compare with the ${comparePeers[0].name.replace(/^GoldPlus\s+/i, '')}`
  : `Compare with ${comparePeers.length} similar ${compareSubName || 'products'}`;

// Honest catalogue fallback for the non-personalised PDP browse rail.
let pdpFallbackProducts: Array<{
  productId: string;
  slug: string;
  name: string;
  imageUrl?: string;
  price?: number;
  availability?: ProductPublicDto['availability'];
}> = [];

const selectPdpFallbackProducts = (products: ProductPublicDto[]) => previewRecommendationRules(
  getCleanCatalog(products).map((candidate) => productToRecommendationItem(candidate, 'CATALOGUE_FALLBACK')),
  {
    currentProductId: product.id,
    currentProductSlug: product.slug,
    currentCategory: product.categoryName,
    currentSubcategory: productSubcategory,
    maxCount: 4,
    categoryDominanceCap: 2,
  },
).selected.map((candidate) => ({
  productId: candidate.productId,
  slug: candidate.slug,
  name: candidate.name,
  imageUrl: candidate.imageUrl,
  price: candidate.price,
  availability: candidate.availability,
}));

try {
  // R1: fabricated seed products no longer pad the fallback rail — an
  // unreachable catalogue yields an empty rail, which renders its honest
  // empty state.
  pdpFallbackProducts = selectPdpFallbackProducts(await fallbackCandidatesP);
} catch {
  pdpFallbackProducts = [];
}


// Loyalty earn preview (loyalty brief PART G: visibility at the point of
// decision). Lower bound, vests on delivery — absent when the programme is off.
const loyaltyRate = await loyaltyRateP; // preview only: 0 when unavailable
const loyaltyPointValueUgx = (await loyaltyP).pointValueUgx; // 0 = redemption not configured: points only

const bizForPdp = await bizP;
// Published, verified-purchase reviews (none until a real buyer's review passes moderation).
const productReviews = await productReviewsP;
// Answered questions (0208): what other shoppers asked and what the shop said.
const answeredQuestions = await answeredQuestionsP;
const askedFlag = Astro.url.searchParams.get('asked');
// Why a question posted without JavaScript was refused (the relay passes the API's code; the words are the API's own).
const ASKED_WHY: Record<string, string> = {
  NO_NAME: 'Tell us your name, so we know who we are answering.',
  TOO_SHORT: 'Ask the question in a few more words.',
  TOO_LONG: 'Keep the question under 500 characters.',
  BAD_CONTACT: 'Check the phone number or email: we could not read it.',
  CONTACT_IN_TEXT: 'Put your number or email in the box for it, not in your name or the question: those are shown on the page once we answer.',
  TOO_MANY: 'You have asked a few questions today. Ask us the rest on WhatsApp.',
  SHOP_BUSY: 'We have had a lot of questions today. Ask us on WhatsApp and we answer there.',
  NO_VISITOR: 'Refresh the page and try again.',
  UNAVAILABLE: 'We could not take your question just now. Try again in a minute, or ask us on WhatsApp.',
};
const askedWhy = ASKED_WHY[Astro.url.searchParams.get('why') ?? ''] ?? 'We could not take that question. Check the name and the question, or ask us on WhatsApp.';
const ratingNode = aggregateRatingNode(productReviews, product.availability.kind === 'in_stock');
const askAboutHref = `${bizForPdp.whatsappUrl}?text=${encodeURIComponent(`Hello GoldPlus, is the ${product.name} available?`)}`;

const availabilityLabel: Record<ProductPublicDto['availability']['kind'], string> = {
  in_stock: 'In stock',
  out_of_stock: 'Out of stock',
  pre_order: 'Pre-order',
  unknown: 'Stock not confirmed',
};

const availabilityClass: Record<ProductPublicDto['availability']['kind'], string> = {
  in_stock: 'bg-green-50/70 text-green-700 border-green-200/70',
  out_of_stock: 'bg-red-50/70 text-red-700 border-red-200/70',
  pre_order: 'bg-blue-50/70 text-blue-700 border-blue-200/70',
  unknown: 'bg-slate-50 text-slate-600 border-slate-200',
};

const whyYoullLikeIt = (() => {
  if (product?.categoryName === 'Storage Devices') {
    return [
      "Easy everyday storage",
      "Compact and portable",
      "Useful for files, photos and music",
      "Simple GoldPlus design"
    ];
  }
  if (product?.categoryName === 'PC Accessories') {
    return [
      "Useful for daily computer setups",
      "Easy plug-in support",
      "Practical for work and study",
      "Built for simple everyday use"
    ];
  }
  // These bullets are per CATEGORY, so nothing here may be a specification —
  // "Two USB ports" and "Compact charging case" were being asserted for every
  // product in the category, wired earphones and single-port chargers
  // included. Specs come from the verified attributes table below, or not at all.
  if (product?.categoryName === 'Sound Devices') {
    return [
      "For music, calls and videos",
      "Easy to carry through the day",
      "Simple GoldPlus design"
    ];
  }
  if (product?.categoryName === 'Car Accessories') {
    return [
      "For everyday use in the car",
      "Compact for travel",
      "Clean GoldPlus design"
    ];
  }
  return [];
})();

/**
 * What sits above the buying actions: up to three VERIFIED specifications (the
 * same rows as the table below), so the facts a shopper compares are next to
 * the button. Only when a product has none do the per-category lines above
 * show, and they are labelled as highlights, not facts.
 */
const keySpecs = verifiedAttributes.slice(0, 3).map((v) => ({ name: v.name, value: `${v.value}${v.unit ? ` ${v.unit}` : ''}` }));

// Returns and payment, beside the buy button, from their single sources: the
// returns window the JSON-LD already publishes, and the checkout's own
// admin-editable payment labels (both methods are offered at checkout).
const storefrontCopy = await storefrontCopyP;
const lowerFirst = (value: string) => value.charAt(0).toLowerCase() + value.slice(1);

