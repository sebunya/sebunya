---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductJsonLd from '../../components/ProductJsonLd.astro';
import Notice from '../../components/Notice.astro';
import { apiBase } from '../../lib/api';
import type { ProductPublicDto, ApiEnvelope } from '@goldplus/shared';
import CompleteSetupRail from '../../components/recommendations/CompleteSetupRail.astro';
import RelatedProductsRail from '../../components/recommendations/RelatedProductsRail.astro';
import { LOCAL_SEED_PRODUCTS, normalizeProductCategory } from '../../lib/catalog/catalog';

const { slug } = Astro.params;

let product: ProductPublicDto | null = null;
let fetchError: string | null = null;
let isOfflineFallback = false;

try {
  const res = await fetch(`${apiBase}/products/${encodeURIComponent(slug ?? '')}`, {
    headers: { Accept: 'application/json' },
    signal: AbortSignal.timeout(3000)
  });
  if (res.ok) {
    const json = (await res.json()) as ApiEnvelope<ProductPublicDto>;
    if (json.success && json.data) {
      product = normalizeProductCategory(json.data);
    } else {
      fetchError = json.error?.message ?? 'Unexpected API response.';
    }
  } else if (res.status === 404) {
    // Try to find it in the local seed list
    const found = LOCAL_SEED_PRODUCTS.find(p => p.slug === slug);
    if (found) {
      product = normalizeProductCategory(found);
      isOfflineFallback = true;
    } else {
      return Astro.redirect('/404', 404);
    }
  } else {
    fetchError = `API responded with HTTP ${res.status}.`;
  }
} catch {
  fetchError = 'Cannot reach the product service right now.';
}

if (!product) {
  // If we couldn't fetch from API, try finding in local fallback
  const found = LOCAL_SEED_PRODUCTS.find(p => p.slug === slug);
  if (found) {
    product = normalizeProductCategory(found);
    isOfflineFallback = true;
    fetchError = null; // Clear fetchError to display the fallback product details
  } else {
    return Astro.redirect('/404', 404);
  }
}

const formatUgx = (amount: number): string =>
  new Intl.NumberFormat('en-UG', { style: 'currency', currency: 'UGX', maximumFractionDigits: 0 }).format(amount);

const availabilityLabel: Record<ProductPublicDto['availability']['kind'], string> = {
  in_stock: 'In stock',
  out_of_stock: 'Out of stock',
  pre_order: 'Pre-order',
  unknown: 'Stock not confirmed',
};

const availabilityClass: Record<ProductPublicDto['availability']['kind'], string> = {
  in_stock: 'bg-green-50 text-green-700 border-green-200',
  out_of_stock: 'bg-red-50 text-red-700 border-red-200',
  pre_order: 'bg-blue-50 text-blue-700 border-blue-200',
  unknown: 'bg-gray-100 text-gray-700 border-gray-200',
};

const canBuy = product?.availability.kind === 'in_stock';
const pageTitle = product ? product.name : 'Product unavailable';
const description = product
  ? `${product.name} — ${product.categoryName} from GoldPlus Uganda.`
  : 'This product is temporarily unavailable.';
const canonical = Astro.url.toString();
---

<BaseLayout title={pageTitle} description={description} canonicalUrl={canonical}>
  {product && (
    <Fragment slot="head">
      <ProductJsonLd product={product} url={canonical} />
    </Fragment>
  )}

  <div class="bg-brand-softGrey py-4 border-b border-brand-borderGrey">
    <div class="container mx-auto px-4 lg:px-8">
      <nav class="flex text-sm text-brand-mutedGrey font-medium" aria-label="Breadcrumb">
        <a href="/" class="hover:text-brand-charcoal transition-colors">Home</a>
        <span class="mx-2" aria-hidden="true">/</span>
        <a href="/shop" class="hover:text-brand-charcoal transition-colors">Shop</a>
        <span class="mx-2" aria-hidden="true">/</span>
        <span class="text-brand-charcoal truncate" aria-current="page">{product?.name ?? slug}</span>
      </nav>
    </div>
  </div>

  <div class="container mx-auto px-4 lg:px-8 py-10 lg:py-14">
    {fetchError && (
      <div class="mb-8">
        <Notice kind="not-configured" title="Product service unavailable" message={fetchError} />
      </div>
    )}

    {product && (
      <div class="flex flex-col lg:flex-row gap-10 lg:gap-14">

        <div class="w-full lg:w-1/2">
          <div class="bg-white aspect-square rounded-3xl flex items-center justify-center relative overflow-hidden border border-brand-borderGrey shadow-sm">
            {product.primaryImageUrl ? (
              <img
                src={product.primaryImageUrl}
                alt={product.images[0]?.alt ?? product.name}
                width="800"
                height="800"
                class="w-full h-full object-contain p-6 hover:scale-102 transition-transform duration-500"
                loading="eager"
                decoding="async"
              />
            ) : (
              <div class="absolute inset-0 flex items-center justify-center text-brand-mutedGrey p-6 text-center">
                <span>Image. Missing. Requires admin review.</span>
              </div>
            )}
          </div>
        </div>

        <div class="w-full lg:w-1/2 flex flex-col">
          <div class="mb-6">
            <p class="text-xs font-bold text-brand-mutedGrey uppercase tracking-widest mb-2">{product.categoryName}</p>
            <h1 class="text-3xl md:text-5xl font-black tracking-tight text-brand-charcoal mb-4">{product.name}</h1>

            <div class="flex items-baseline gap-4 mb-4 flex-wrap">
              {product.retailPriceUgx !== null ? (
                <p class="text-3xl font-black text-brand-charcoal">{formatUgx(product.retailPriceUgx)}</p>
              ) : (
                <p class="text-base text-brand-mutedGrey italic">Price on request.</p>
              )}
              <span class={`inline-flex items-center px-3 py-1 rounded-full border text-[10px] font-bold uppercase tracking-widest ${availabilityClass[product.availability.kind]}`}>
                {availabilityLabel[product.availability.kind]}
              </span>
            </div>

            {product.modelNumber && (
              <p class="text-xs text-brand-mutedGrey font-mono bg-brand-softGrey px-3 py-1.5 rounded-lg border border-brand-borderGrey inline-block">Model: {product.modelNumber}</p>
            )}
          </div>

          {product.hasMissingSpecs && (
            <div class="mb-6">
              <Notice kind="owner-review" title="Some details are pending review" message="Some specifications for this product have not yet been verified by an admin. We do not invent claims." />
            </div>
          )}

          <div class="border border-brand-borderGrey rounded-2xl overflow-hidden mb-8 bg-white shadow-sm">
            <table class="w-full text-sm text-left">
              <caption class="sr-only">Specifications for {product.name}</caption>
              <tbody>
                {product.sku && (
                  <tr class="border-b border-brand-borderGrey">
                    <th scope="row" class="px-5 py-4 bg-brand-softGrey/50 font-bold text-brand-charcoal w-1/3 text-xs uppercase tracking-wider">SKU</th>
                    <td class="px-5 py-4 text-brand-charcoal font-mono text-sm">{product.sku}</td>
                  </tr>
                )}
                {product.attributeValues.map((v) => (
                  <tr class="border-b border-brand-borderGrey last:border-b-0">
                    <th scope="row" class="px-5 py-4 bg-brand-softGrey/50 font-bold text-brand-charcoal w-1/3 text-xs uppercase tracking-wider">{v.name}</th>
                    <td class="px-5 py-4 text-brand-charcoal text-sm flex items-center gap-2">
                      <span>{v.value}{v.unit ? ` ${v.unit}` : ''}</span>
                      {!v.isVerified && (
                        <span class="inline-flex items-center px-2 py-0.5 rounded bg-amber-50 text-amber-800 border border-amber-200 text-[10px] font-bold uppercase tracking-widest">Pending review</span>
                      )}
                    </td>
                  </tr>
                ))}
                {product.attributeValues.length === 0 && !product.sku && (
                  <tr>
                    <td class="px-5 py-6 text-brand-mutedGrey italic text-center text-sm" colspan="2">No specifications published yet. Owner review required.</td>
                  </tr>
                )}
              </tbody>
            </table>
          </div>

          <form method="POST" action="/cart" class="flex flex-col sm:flex-row gap-4 mb-8">
            <input type="hidden" name="action" value="add" />
            <input type="hidden" name="productId" value={product.id} />
            <input type="hidden" name="slug" value={product.slug} />
            <input type="hidden" name="name" value={product.name} />
            <input type="hidden" name="categoryName" value={product.categoryName} />
            <input type="hidden" name="priceUgx" value={product.retailPriceUgx ?? 0} />
            <button
              type="submit"
              disabled={!canBuy}
              class={`flex-1 py-4 px-6 rounded-xl font-bold text-base transition-all duration-300 outline-none focus-visible:ring-4 focus-visible:ring-brand-primary/30 ${canBuy ? 'bg-brand-primary text-brand-charcoal hover:opacity-90 shadow-md shadow-brand-primary/10' : 'bg-brand-softGrey text-brand-mutedGrey cursor-not-allowed'}`}
            >
              {canBuy ? 'Add to cart' : availabilityLabel[product.availability.kind]}
            </button>
            <a href={`/quote-request?productName=${encodeURIComponent(product.name)}`} class="flex-1 py-4 px-6 rounded-xl font-bold text-base text-center transition-all duration-300 outline-none border-2 border-brand-borderGrey text-brand-charcoal hover:border-brand-charcoal hover:bg-brand-softGrey focus-visible:ring-4 focus-visible:ring-brand-charcoal/10">
              Request quote
            </a>
          </form>

          <div class="border-t border-brand-borderGrey pt-6 mt-auto">
            <h4 class="font-bold text-brand-charcoal mb-4 text-xs uppercase tracking-widest">Support &amp; trust</h4>
            <div class="flex flex-wrap gap-3">
              <a href="/verification" class="text-xs font-bold text-brand-charcoal bg-brand-softGrey border border-brand-borderGrey px-4 py-2.5 rounded-xl hover:bg-brand-charcoal hover:text-white transition-all">Verify product</a>
              <a href="/support/issue" class="text-xs font-bold text-brand-charcoal bg-brand-softGrey border border-brand-borderGrey px-4 py-2.5 rounded-xl hover:bg-brand-charcoal hover:text-white transition-all">Report issue</a>
              <a href="/support/fake" class="text-xs font-bold text-brand-error bg-red-50 border border-red-100 px-4 py-2.5 rounded-xl hover:bg-red-600 hover:text-white transition-all">Report fake</a>
            </div>
          </div>
        </div>
      </div>
    )}

    {/* Product-Specific Discovery Tracks */}
    {product && (
      <div 
        class="mt-24 space-y-16"
        data-product-tracking
        data-product-id={product.id}
        data-product-slug={product.slug}
        data-product-name={product.name}
        data-product-image={product.primaryImageUrl ?? ''}
        data-product-price={product.retailPriceUgx ?? ''}
      >
        <div class="border-t border-brand-borderGrey pt-12">
          <CompleteSetupRail productId={product.id} />
        </div>
        <div class="border-t border-brand-borderGrey pt-12">
          <RelatedProductsRail productId={product.id} />
        </div>
      </div>
    )}
  </div>
</BaseLayout>

<script>
  import { trackProductView, saveRecentlyViewedLocal, getAndClearClickAttribution, trackRecommendationEvent } from '../../lib/recommendations';

  document.addEventListener('DOMContentLoaded', () => {
    const root = document.querySelector('[data-product-tracking]');
    if (!root) return;

    const id = root.getAttribute('data-product-id');
    const slug = root.getAttribute('data-product-slug');
    const name = root.getAttribute('data-product-name');
    const image = root.getAttribute('data-product-image');
    const priceRaw = root.getAttribute('data-product-price');

    if (id && slug && name) {
      // Fire back analytics
      trackProductView(id).catch(() => {});

      // Update local history cache
      saveRecentlyViewedLocal({
        productId: id,
        slug,
        name,
        imageUrl: image || undefined,
        price: priceRaw ? Number(priceRaw) : undefined,
        currency: 'UGX'
      });
    }

    const form = document.querySelector('form[action="/cart"]');
    if (form && id) {
      form.addEventListener('submit', () => {
        const attribution = getAndClearClickAttribution(id);
        if (attribution) {
          trackRecommendationEvent({
            eventType: "RECOMMENDATION_ADD_TO_CART",
            recommendationProductId: id,
            placement: attribution.placement,
            attributionId: attribution.attributionId,
            railRenderId: attribution.railRenderId,
            ruleId: attribution.ruleId,
            reasonCode: attribution.reasonCode,
            source: "product_page",
          }).catch(() => {});
        } else {
          trackRecommendationEvent({
            eventType: "PRODUCT_ADDED_TO_CART",
            productId: id,
            source: "product_page",
          }).catch(() => {});
        }
      });
    }
  });
</script>
