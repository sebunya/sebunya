const battery = batteryRes && batteryRes.ok && (batteryRes.data.isPublished || batteryRes.data.devices.length > 0) ? batteryRes.data : null;
const hasAwaitingFit = !!battery && battery.devices.some((dv) => dv.fitState === 'AWAITING_VERIFICATION');
const fitForSelected = battery && selectedDevice ? battery.devices.find((dv) => dv.slug === selectedDevice.slug) ?? null : null;
const CHEMISTRY_LABEL: Record<string, string> = { LI_ION: 'Li-ion', LI_POLYMER: 'Li-polymer', NIMH: 'NiMH', OTHER: 'Other' };

const pdpCopy = product ? pdpDescriptions[product.slug] : null;
// DB copy (admin-editable) is the source of truth; the hardcoded map is only a
