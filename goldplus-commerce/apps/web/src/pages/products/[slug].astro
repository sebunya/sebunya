---
import DeliveryQuote from "../../components/DeliveryQuote.astro";
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductJsonLd from '../../components/ProductJsonLd.astro';
import Notice from '../../components/Notice.astro';
import { apiBase } from '../../lib/api';
import { formatUgx } from '../../lib/money';
import { getStorefrontDiscount, salePriceUgx } from '../../lib/storefrontDiscount';
import type { ProductPublicDto, ApiEnvelope, ApiResponse } from '@goldplus/shared';
import CompleteSetupRail from '../../components/recommendations/CompleteSetupRail.astro';
import RelatedProductsRail from '../../components/recommendations/RelatedProductsRail.astro';
import RecentlyViewedRail from '../../components/recommendations/RecentlyViewedRail.astro';
import { normalizeProductCategory, getCleanCatalog } from '../../lib/catalog/catalog';
import { getProductSubcategory } from '../../lib/product-discovery';
import { getTaxonomy } from '../../lib/taxonomy';
import { previewRecommendationRules, productToRecommendationItem } from '../../lib/recommendation-display';
import { breadcrumbJsonLd, serializeJsonLd } from '../../lib/jsonld';
import { getBusinessInfo } from '../../lib/businessInfo';
import { publicBattery, parseDeviceCookie, serialiseDeviceCookie, DEVICE_COOKIE, FIT_BADGE } from '../../lib/batteries';

const { slug } = Astro.params;
const searchQuery = Astro.url.searchParams.get('searchQuery') ?? '';
const searchRank = Number(Astro.url.searchParams.get('searchRank') ?? 0);

let product: ProductPublicDto | null = null;
let fetchError: string | null = null;
let isOfflineFallback = false;

try {
  const res = await fetch(`${apiBase}/products/${encodeURIComponent(slug ?? '')}`, {
    headers: { Accept: 'application/json' },
    signal: AbortSignal.timeout(3000)
  });
  if (res.ok) {
    const json = (await res.json()) as ApiEnvelope<ProductPublicDto>;
    if (json.success && json.data) {
      product = normalizeProductCategory(json.data);
    } else {
      fetchError = json.error?.message ?? 'Unexpected API response.';
    }
  } else if (res.status === 404) {
    // R1: the seed-catalogue rescue is retired. It rendered a fully
    // fabricated PDP — invented price, working Add-to-cart — for products the
    // database has never contained. A product the API does not know is a 404.
    return Astro.redirect('/404', 404);
  } else {
    fetchError = 'We could not load this product right now.';
  }
} catch {
  fetchError = 'Cannot reach the product service right now.';
}

if (!product) {
  // R1: no seed rescue here either — an unreachable product service is a 404,
  // never a fabricated product page.
  {
    return Astro.redirect('/404', 404);
  }
}

if (searchQuery && Number.isInteger(searchRank) && searchRank >= 1 && searchRank <= 50) {
  await fetch(`${apiBase}/products/search-interactions`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ query: searchQuery, productId: product.id, rank: searchRank, type: 'click' }),
    signal: AbortSignal.timeout(500),
  }).catch(() => {});
}

/**
 * Honour any recorded lifecycle SEO decision for this product. A decision is
 * a deliberate human act, so the page obeys it: a 301 only ever goes to a
 * genuine successor product, and a discontinued-but-honest page keeps its 200
 * and its indexability because it still answers the customer's question.
 * No decision recorded = nothing changes.
 */
let lifecycleNotice: string | null = null;
let lifecycleNoindex = false;
let lifecycleAlternatives = false;
try {
  const lcRes = await fetch(`${apiBase}/seo/product-lifecycle?productId=${encodeURIComponent(product.id)}`, {
    headers: { Accept: 'application/json' },
    signal: AbortSignal.timeout(700),
  });
  const lcJson = (await lcRes.json()) as ApiResponse<{
    decided?: boolean;
    successorSlug?: string | null;
    outcome?: { httpStatus?: number; indexable?: boolean; showAlternatives?: boolean; notice?: string | null } | null;
  }>;
  if (lcJson.success && lcJson.data?.decided && lcJson.data.outcome) {
    const o = lcJson.data.outcome;
    if (o.httpStatus === 301 && lcJson.data.successorSlug) {
      return Astro.redirect(`/products/${lcJson.data.successorSlug}`, 301);
    }
    if (o.httpStatus === 410) return Astro.redirect('/404', 410);
    lifecycleNotice = o.notice ?? null;
    lifecycleNoindex = o.indexable === false;
    lifecycleAlternatives = o.showAlternatives === true;
  }
} catch {
  // The decision service is advisory: if it is unreachable the product page
  // behaves exactly as it always did rather than failing or redirecting.
}

const hasValidSku = product.sku && product.sku !== 'Needs Business Confirmation' && !product.sku.toLowerCase().includes('pending');
const verifiedAttributes = product.attributeValues.filter((v) => v.isVerified && v.name !== 'Badge' && v.name !== 'CardShortDescription');

const productSubcategory = getProductSubcategory(product, await getTaxonomy());

// Honest catalogue fallback for the non-personalised PDP browse rail.
let pdpFallbackProducts: Array<{
  productId: string;
  slug: string;
  name: string;
  imageUrl?: string;
  price?: number;
  availability?: ProductPublicDto['availability'];
}> = [];

const selectPdpFallbackProducts = (products: ProductPublicDto[]) => previewRecommendationRules(
  getCleanCatalog(products).map((candidate) => productToRecommendationItem(candidate, 'CATALOGUE_FALLBACK')),
  {
    currentProductId: product.id,
    currentProductSlug: product.slug,
    currentCategory: product.categoryName,
    currentSubcategory: productSubcategory,
    maxCount: 4,
    categoryDominanceCap: 2,
  },
).selected.map((candidate) => ({
  productId: candidate.productId,
  slug: candidate.slug,
  name: candidate.name,
  imageUrl: candidate.imageUrl,
  price: candidate.price,
  availability: candidate.availability,
}));

try {
  let allProducts: ProductPublicDto[] = [];
  const res = await fetch(`${apiBase}/products?limit=50`, { signal: AbortSignal.timeout(3000) });
  if (res.ok) {
    const json = await res.json() as ApiResponse<ProductPublicDto[]>;
    if (json.success && json.data) {
      allProducts = json.data;
    }
  }
  // R1: fabricated seed products no longer pad the fallback rail — an
  // unreachable catalogue yields an empty rail, which renders its honest
  // empty state.
  pdpFallbackProducts = selectPdpFallbackProducts(allProducts);
} catch {
  pdpFallbackProducts = [];
}


// Loyalty earn preview (loyalty brief PART G: visibility at the point of
// decision). Lower bound, vests on delivery — absent when the programme is off.
let loyaltyRate = 0;
try {
  const lpRes = await fetch(`${apiBase}/commerce/loyalty-programme`, { signal: AbortSignal.timeout(2000) });
  const lpJson: any = lpRes.ok ? await lpRes.json().catch(() => null) : null;
  if (lpJson?.success && lpJson.data?.active) loyaltyRate = Number(lpJson.data.earnRatePer1000Ugx) || 0;
} catch { /* preview only */ }

const bizForPdp = await getBusinessInfo();
const askAboutHref = `${bizForPdp.whatsappUrl}?text=${encodeURIComponent(`Hello GoldPlus, is the ${product.name} available?`)}`;

const availabilityLabel: Record<ProductPublicDto['availability']['kind'], string> = {
  in_stock: 'In stock',
  out_of_stock: 'Out of stock',
  pre_order: 'Pre-order',
  unknown: 'Stock not confirmed',
};

const availabilityClass: Record<ProductPublicDto['availability']['kind'], string> = {
  in_stock: 'bg-green-50/70 text-green-700 border-green-200/70 shadow-xs',
  out_of_stock: 'bg-red-50/70 text-red-600 border-red-200/70 shadow-xs',
  pre_order: 'bg-blue-50/70 text-blue-700 border-blue-200/70 shadow-xs',
  unknown: 'bg-slate-50 text-slate-500 border-slate-200 shadow-xs',
};

const whyYoullLikeIt = (() => {
  if (product?.categoryName === 'Storage Devices') {
    return [
      "Easy everyday storage",
      "Compact and portable",
      "Useful for files, photos and music",
      "Simple GoldPlus design"
    ];
  }
  if (product?.categoryName === 'PC Accessories') {
    return [
      "Useful for daily computer setups",
      "Easy plug-in support",
      "Practical for work and study",
      "Built for simple everyday use"
    ];
  }
  // These bullets are per CATEGORY, so nothing here may be a specification —
  // "Two USB ports" and "Compact charging case" were being asserted for every
  // product in the category, wired earphones and single-port chargers
  // included. Specs come from the verified attributes table below, or not at all.
  if (product?.categoryName === 'Sound Devices') {
    return [
      "For music, calls and videos",
      "Easy to carry through the day",
      "Simple GoldPlus design"
    ];
  }
  if (product?.categoryName === 'Car Accessories') {
    return [
      "For everyday use in the car",
      "Compact for travel",
      "Clean GoldPlus design"
    ];
  }
  return [];
})();

const pdpDescriptions: Record<string, { intro: string; description: string }> = {
  'goldplus-16gb-usb-flash-drive': {
    intro: '16GB of storage small enough to live on your keyring.',
    description: 'A metal-bodied 16GB drive that clips to your keys, so the documents, photos and music you need are always on you. Plug it into any compatible USB port and it is ready. Nothing to install, nothing to charge.'
  },
  'goldplus-32gb-memory-card': {
    intro: '32GB more room on the devices you already own.',
    description: 'Slot it into a phone, camera, tablet or speaker that takes microSD and you have space for thousands more photos, songs and files. If the device supports microSD, this works in it.'
  },
  'goldplus-usb-mouse': {
    intro: 'A wired USB mouse that just works.',
    description: 'Plug it in and start clicking. No batteries to replace, no pairing, no drivers to hunt down. It sits comfortably under your hand through a long day at the laptop or desk, whether you are working, studying or catching up online.'
  },
  'goldplus-usb-sound-card': {
    intro: 'External USB audio for laptops and desktops.',
    description: 'When your computer’s built-in audio is not enough, or has stopped behaving, this plugs in over USB and gives you a clean headphone and microphone connection. Producers, editors and anyone stuck with a dead audio jack will get the most out of it.'
  },
  'goldplus-dual-usb-car-charger-gp-ca03': {
    intro: 'Two USB ports, so nobody fights over the charger.',
    description: 'Charge two phones at once on the school run, the daily commute or a long drive upcountry. It sits flush in the socket in the black-and-white GoldPlus finish and stays out of the way until you need it.'
  }
};

if (product?.categoryName === 'Sound Devices') {
  if (product && !pdpDescriptions[product.slug] && product.slug.includes('earbuds')) {
    pdpDescriptions[product.slug] = {
      intro: 'Wireless earbuds for music, calls and the daily commute.',
      description: 'Take them out of the case, put them in, and you are connected. Good for music on the boda, calls on the move, and videos once you finally sit down. The case tops them up between uses, so they are ready when you are.'
    };
  }
}

// Active campaign discount (display only; mirrors the checkout charge).
const pdpHasPrice = product && typeof product.retailPriceUgx === 'number' && product.retailPriceUgx > 0;
const pdpDiscount = await getStorefrontDiscount();
const pdpCampaignRunning = pdpHasPrice && pdpDiscount.active && pdpDiscount.percentBps > 0;
// The floor is a required argument: without it the page would advertise a price
// the checkout refuses to honour.
const pdpSaleUgx = pdpCampaignRunning ? salePriceUgx(product!.retailPriceUgx!, pdpDiscount.percentBps, pdpDiscount.priceFloorUgx) : null;
/**
 * Only call it a sale when the price actually drops. At the per-unit price
 * floor the evaluator discounts nothing, and the page was showing a struck
 * through price identical to the one beside it with a "10% discount" badge.
 */
const pdpOnSale = pdpCampaignRunning && pdpSaleUgx !== null && pdpSaleUgx < product!.retailPriceUgx!;

/**
 * Battery block. A battery product carries its verified device list, its specs
 * and, when the customer came from the finder, whether it fits the phone they
 * picked. A mismatch is stated; it is never silently dropped.
 */
const selectedDeviceParam = (Astro.url.searchParams.get('device') ?? '').trim().slice(0, 160);
if (selectedDeviceParam && /^[a-z0-9-]{1,160}$/.test(selectedDeviceParam)) {
  const chosen = await publicBattery<{ device: { slug: string; label: string } }>(`/finder/devices/${encodeURIComponent(selectedDeviceParam)}`);
  if (chosen.ok) {
    Astro.cookies.set(DEVICE_COOKIE, serialiseDeviceCookie(chosen.data.device), {
      path: '/', httpOnly: false, sameSite: 'lax', secure: Astro.url.protocol === 'https:', maxAge: 60 * 60 * 24 * 30,
    });
  }
}
const selectedDevice = parseDeviceCookie(Astro.cookies.get(DEVICE_COOKIE)?.value);

interface BatteryPublic {
  battery: { productId: string; canonicalCode: string; capacityMah: number | null; nominalVoltageMv: number | null; warrantyMonths: number | null; chemistry: string | null; publicNotes: string | null; lifecycleStatus: string };
  devices: Array<{ slug: string; label: string; modelNumber: string | null; fitState: string; fitLabel: string; condition: string | null }>;
  config: { modelNumberHelp: string; requestCta: string; awaitingVerificationNote: string; conditionalNote: string; whatsappPrefill: string };
  isPublished: boolean;
}
const batteryRes = product ? await publicBattery<BatteryPublic>(`/products/${encodeURIComponent(product.slug)}`) : null;
const battery = batteryRes && batteryRes.ok && batteryRes.data.isPublished ? batteryRes.data : null;
const fitForSelected = battery && selectedDevice ? battery.devices.find((dv) => dv.slug === selectedDevice.slug) ?? null : null;
const CHEMISTRY_LABEL: Record<string, string> = { LI_ION: 'Li-ion', LI_POLYMER: 'Li-polymer', NIMH: 'NiMH', OTHER: 'Other' };

const pdpCopy = product ? pdpDescriptions[product.slug] : null;
// DB copy (admin-editable) is the source of truth; the hardcoded map is only a
// fallback for any product whose description hasn't been written yet.
const descIntro = product?.shortDescription?.trim() || pdpCopy?.intro || null;
const descBody = product?.longDescription?.trim() || pdpCopy?.description || null;

// Slice 5: admin-verified compatibility guidance (declared mappings only —
// unverified pairs are simply absent; unknown is never shown as compatible).
interface CompatEntry { productId: string; name: string; slug: string; verdict: string; label: string; note: string | null }
let compatibilityEntries: CompatEntry[] = [];
if (product) {
  try {
    const compatRes = await fetch(`${apiBase}/products/${encodeURIComponent(product.slug)}/compatibility`, { signal: AbortSignal.timeout(2000) });
    const compatJson = await compatRes.json().catch(() => null);
    if (compatJson?.success && Array.isArray(compatJson.data)) compatibilityEntries = compatJson.data;
  } catch { /* section is hidden when unavailable */ }
}
const verdictBadge: Record<string, string> = {
  exact: 'border-green-300 bg-green-50 text-green-800',
  compatible: 'border-green-200 bg-green-50 text-green-700',
  conditional: 'border-amber-300 bg-amber-50 text-amber-800',
  incompatible: 'border-red-300 bg-red-50 text-red-700',
};

const canBuy = product?.availability.kind === 'in_stock';
const pageTitle = product ? product.name : 'Product unavailable';
const description = product
  ? `${product.name}, ${product.categoryName} from GoldPlus Uganda.`
  : 'This product is temporarily unavailable.';
// Path only: ?searchQuery=…&searchRank=… must never become the canonical.
const canonical = `${Astro.url.origin}${Astro.url.pathname}`;

// U6 AC4 — BreadcrumbList JSON-LD (Home → category → product) from the real
// category already rendered on the page. The category URL is the shop filtered
// to that category (there are no dedicated category pages); it is only included
// when the category maps back to a taxonomy slug.
let breadcrumbJson: string | null = null;
// Hoisted: the visible breadcrumb renders the same category the JSON-LD names.
let crumbCategory: { name: string; slug: string } | undefined;
if (product) {
  const taxonomyForCrumbs = await getTaxonomy();
  crumbCategory = taxonomyForCrumbs.find((cat) => cat.name === product!.categoryName);
  const origin = Astro.url.origin;
  const crumbs = [{ name: 'Home', url: `${origin}/` }];
  if (crumbCategory) crumbs.push({ name: crumbCategory.name, url: `${origin}/shop?category=${encodeURIComponent(crumbCategory.slug)}` });
  crumbs.push({ name: product.name, url: canonical });
  breadcrumbJson = serializeJsonLd(breadcrumbJsonLd(crumbs));
}
---

<BaseLayout title={pageTitle} description={description} canonicalUrl={canonical} robotsMeta={lifecycleNoindex ? 'noindex,follow' : undefined}>
  {product && (
    <Fragment slot="head">
      <ProductJsonLd product={product} url={canonical} />
      {breadcrumbJson && <script type="application/ld+json" is:inline set:html={breadcrumbJson} />}
    </Fragment>
  )}

  {lifecycleNotice && (
    <div role="status" class="bg-amber-50 border-b border-amber-200">
      <div class="container mx-auto px-4 lg:px-8 py-3 text-sm text-amber-900">
        <strong>{lifecycleNotice}</strong>
        {lifecycleAlternatives && <span class="ml-1">Browse the alternatives below.</span>}
      </div>
    </div>
  )}

  <div class="bg-slate-50 py-3.5 border-b border-slate-100">
    <div class="container mx-auto px-4 lg:px-8">
      <nav class="flex text-sm text-slate-500 font-medium" aria-label="Breadcrumb">
        <a href="/" class="hover:text-brand-primary transition-colors">Home</a>
        <span class="mx-2 text-slate-350" aria-hidden="true">/</span>
        <a href="/shop" class="hover:text-brand-primary transition-colors">Shop</a>
        {crumbCategory && (
          <>
            <span class="mx-2 text-slate-350" aria-hidden="true">/</span>
            <a href={`/shop?category=${encodeURIComponent(crumbCategory.slug)}`} class="hover:text-brand-primary transition-colors">{crumbCategory.name}</a>
          </>
        )}
        <span class="mx-2 text-slate-350" aria-hidden="true">/</span>
        <span class="text-gray-900 truncate" aria-current="page">{product?.name ?? slug}</span>
      </nav>
    </div>
  </div>

  <div class="container mx-auto px-4 lg:px-8 py-10 lg:py-14">
    {fetchError && (
      <div class="mb-8">
        <Notice kind="not-configured" title="Product service unavailable" message={fetchError} />
      </div>
    )}

    {product && (
      <div class="flex flex-col lg:flex-row gap-10 lg:gap-14">

        <div class="w-full lg:w-1/2">
          <div class="bg-white aspect-square rounded-2xl flex items-center justify-center relative overflow-hidden border border-slate-200/80 shadow-xs">
            {product.primaryImageUrl ? (
              <img
                src={product.primaryImageUrl}
                alt={product.images[0]?.alt ?? product.name}
                width="800"
                height="800"
                class="w-full h-full object-contain p-6 hover:scale-[1.01] transition-transform duration-500"
                loading="eager"
                decoding="async"
              />
            ) : (
              <div class="absolute inset-0 flex items-center justify-center text-slate-400 p-6 text-center">
                <span>No photo of this one yet.</span>
              </div>
            )}
          </div>
        </div>

        <div class="w-full lg:w-1/2 flex flex-col">
          <div class="mb-6">
            <p class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-1.5">{product.categoryName}</p>
            <h1 class="text-2xl sm:text-3xl md:text-4xl font-black tracking-tight text-gray-900 mb-4">{product.name}</h1>

            <div class="flex items-baseline gap-3 mb-4 flex-wrap">
              {product.retailPriceUgx !== null ? (
                <>
                {pdpOnSale ? (
                  <div class="flex flex-wrap items-baseline gap-3">
                    <p class="text-3xl font-black text-gray-900 tabular-nums">{formatUgx(pdpSaleUgx)}</p>
                    <p class="text-lg font-semibold text-slate-400 line-through tabular-nums">{formatUgx(product.retailPriceUgx)}</p>
                    <span class="text-xs font-black uppercase tracking-wider rounded-full px-2.5 py-1" style="background:#93D500;color:#0A0A0A">{pdpDiscount.percent}% discount</span>
                  </div>
                ) : (
                  <p class="text-3xl font-black text-gray-900 tabular-nums">{formatUgx(product.retailPriceUgx)}</p>
                )}
                {pdpOnSale && pdpDiscount.endsIso && (
                  <p class="mt-1.5 text-xs font-bold text-amber-700" data-pdp-sale-ends={pdpDiscount.endsIso}>Offer ends soon</p>
                )}
                {loyaltyRate > 0 && Math.floor(product.retailPriceUgx / 1000) * loyaltyRate > 0 && (
                  <p class="text-xs font-bold text-brand-primaryInk mt-1">Earn {(Math.floor(product.retailPriceUgx / 1000) * loyaltyRate).toLocaleString('en-UG')} GoldPlus points on this order</p>
                )}
                </>
              ) : (
                <p class="text-base text-slate-400 italic">Price on request.</p>
              )}
              <span class={`inline-flex items-center px-2.5 py-1 rounded-full border text-[9px] font-black uppercase tracking-wider ${availabilityClass[product.availability.kind]}`}>
                {availabilityLabel[product.availability.kind]}
                {product.availability.kind === 'in_stock' && product.availability.quantity > 0 && ` · ${product.availability.quantity} available`}
              </span>
            </div>

            {product.modelNumber && product.modelNumber !== 'Needs Business Confirmation' && !product.modelNumber.toLowerCase().includes('pending') && (
              <p class="text-[10px] text-slate-500 font-mono bg-slate-50 px-2.5 py-1 rounded-md border border-slate-200/70 inline-block">Model: {product.modelNumber}</p>
            )}
          </div>

          {battery && selectedDevice && (
            <div role="status" class={`mb-6 rounded-xl border px-4 py-3 text-sm ${fitForSelected ? FIT_BADGE[fitForSelected.fitState] ?? 'border-gray-200 bg-gray-50' : 'border-amber-300 bg-amber-50 text-amber-900'}`}>
              <p class="font-bold">Buying for your {selectedDevice.label}</p>
              {fitForSelected ? (
                <p class="mt-1">{fitForSelected.fitLabel}.{fitForSelected.condition ? ` ${fitForSelected.condition}` : ''}</p>
              ) : (
                <p class="mt-1">
                  We have not checked this battery against the {selectedDevice.label}. That does not mean it will not fit,
                  it means we have not confirmed it. <a href={`/battery-finder?device=${encodeURIComponent(selectedDevice.slug)}`} class="font-bold underline">See what we have checked for it</a>.
                </p>
              )}
            </div>
          )}

          {(descIntro || descBody) && (
            <div class="mb-6 prose prose-sm max-w-none text-slate-600 leading-relaxed">
              {descIntro && <p class="font-bold text-gray-900 text-base mb-2">{descIntro}</p>}
              {descBody && descBody.split('\n\n').map(p => <p class="mb-3">{p}</p>)}
            </div>
          )}

          {whyYoullLikeIt.length > 0 && (
            <div class="mb-8">
              <h3 class="text-sm font-bold text-gray-900 mb-3">Why You'll Like It</h3>
              <ul class="space-y-2">
                {whyYoullLikeIt.map(item => (
                  <li class="flex items-start gap-2 text-sm text-slate-600">
                    <svg class="w-5 h-5 text-brand-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}



          <div class="border border-slate-200/80 rounded-xl overflow-hidden mb-6 bg-white shadow-xs">
            <table class="w-full text-sm text-left">
              <caption class="sr-only">Specifications for {product.name}</caption>
              <tbody>
                {hasValidSku && (
                  <tr class="border-b border-slate-100">
                    <th scope="row" class="px-5 py-3.5 bg-slate-50/60 font-bold text-gray-800 w-1/3 text-[10px] uppercase tracking-wider">SKU</th>
                    <td class="px-5 py-3.5 text-slate-700 font-mono text-sm">{product.sku}</td>
                  </tr>
                )}
                {verifiedAttributes.map((v) => (
                  <tr class="border-b border-slate-100 last:border-b-0">
                    <th scope="row" class="px-5 py-3.5 bg-slate-50/60 font-bold text-gray-800 w-1/3 text-[10px] uppercase tracking-wider">{v.name}</th>
                    <td class="px-5 py-3.5 text-slate-700 text-sm flex items-center gap-2">
                      <span>{v.value}{v.unit ? ` ${v.unit}` : ''}</span>
                    </td>
                  </tr>
                ))}
                {!hasValidSku && verifiedAttributes.length === 0 && (
                  <tr>
                    <td class="px-5 py-6 text-slate-450 italic text-center text-sm" colspan="2">No specifications published yet.</td>
                  </tr>
                )}
              </tbody>
            </table>
          </div>

          {/* Delivery, stage 1: an estimate labelled as one, before an area
              is known. Same endpoint and same copy as the cart and checkout. */}
          <div class="mb-6">
            <DeliveryQuote
              stage={1}
              compact={true}
              items={[{ productId: product.id, quantity: 1 }]}
              subtotalUgx={product.retailPriceUgx ?? 0}
            />
          </div>

          <form method="POST" action="/cart" class="flex flex-col sm:flex-row gap-3 mb-8">
            <input type="hidden" name="action" value="add" />
            <input type="hidden" name="productId" value={product.id} />
            <input type="hidden" name="slug" value={product.slug} />
            <input type="hidden" name="name" value={product.name} />
            <input type="hidden" name="categoryName" value={product.categoryName} />
            <input type="hidden" name="priceUgx" value={product.retailPriceUgx ?? 0} />
            {searchQuery && Number.isInteger(searchRank) && searchRank >= 1 && searchRank <= 50 && (
              <>
                <input type="hidden" name="searchQuery" value={searchQuery} />
                <input type="hidden" name="searchRank" value={searchRank} />
              </>
            )}
            <button
              type="submit"
              disabled={!canBuy}
              class={`flex-1 py-3 px-6 rounded-full font-bold text-xs tracking-wider uppercase transition-all duration-300 outline-none focus-visible:ring-4 focus-visible:ring-brand-primary/30 active:scale-[0.98] cursor-pointer shadow-xs ${canBuy ? 'bg-brand-primary text-gray-950 hover:shadow-md hover:shadow-brand-primary/25' : 'bg-slate-100 text-slate-400 cursor-not-allowed'}`}
            >
              {canBuy ? 'Add to cart' : availabilityLabel[product.availability.kind]}
            </button>
            {canBuy && (
              <button
                type="submit"
                name="buyNow"
                value="1"
                class="flex-1 py-3 px-6 rounded-full font-bold text-xs tracking-wider uppercase transition-all duration-300 outline-none focus-visible:ring-4 focus-visible:ring-gray-900/20 active:scale-[0.98] cursor-pointer shadow-xs bg-gray-900 text-white hover:bg-black"
              >
                Buy now
              </button>
            )}
          </form>

          {!canBuy && (
            <p class="mt-3 text-sm text-slate-600">
              {/* An out-of-stock product used to end at a greyed button and nothing else — the strongest-intent visitor on the site, with nowhere to go. */}
              Want this one? <a href={askAboutHref} class="font-bold text-gray-900 underline">Ask us on WhatsApp</a> and we will tell you what we have.
            </p>
          )}

          {battery ? (
            <a href="/battery-finder" class="block mb-8 rounded-xl border border-brand-primary/40 bg-brand-primary/5 px-5 py-4 text-sm font-semibold text-gray-900 hover:border-brand-primary">
              Not sure this is your battery? Find it by your phone
            </a>
          ) : (
            <a href={`/product-finder?compatibleWith=${encodeURIComponent(product.id)}`} class="block mb-8 rounded-xl border border-brand-primary/40 bg-brand-primary/5 px-5 py-4 text-sm font-semibold text-gray-900 hover:border-brand-primary">
              See what works with this
            </a>
          )}

          </div>

        </div>
      </div>
    )}

    {/* Product-Specific Discovery Tracks */}
    {product && (
      <div 
        class="mt-24 space-y-16"
        data-product-tracking
        data-product-id={product.id}
        data-product-slug={product.slug}
        data-product-name={product.name}
        data-product-image={product.primaryImageUrl ?? ''}
        data-product-price={product.retailPriceUgx ?? ''}
        data-product-category={product.categoryName ?? ''}
      >
        {battery && (
          <div class="border-t border-slate-100 pt-10" aria-labelledby="battery-fits-heading">
            <h2 id="battery-fits-heading" class="text-xl font-black text-slate-900">Phones this battery fits</h2>
            <p class="mt-1 text-sm text-slate-600">
              Every phone below has been checked and published by GoldPlus staff. A phone that is not listed has not been
              checked; we will confirm it for you rather than guess.
            </p>
            {battery.devices.length > 0 ? (
              <ul class="mt-5 grid grid-cols-1 gap-3 sm:grid-cols-2">
                {battery.devices.map((dv) => (
                  <li class="rounded-2xl border border-slate-200 bg-white p-4">
                    <div class="flex items-start justify-between gap-3">
                      <a href={`/battery-finder?device=${encodeURIComponent(dv.slug)}`} class="text-sm font-bold text-slate-900 hover:text-brand-primary">{dv.label}</a>
                      <span class={`shrink-0 rounded-full border px-2.5 py-1 text-[10px] font-black uppercase tracking-widest ${FIT_BADGE[dv.fitState] ?? 'border-slate-200 bg-slate-50 text-slate-600'}`}>{dv.fitLabel}</span>
                    </div>
                    {dv.modelNumber && <p class="mt-1 text-xs font-mono text-slate-500">{dv.modelNumber}</p>}
                    {dv.fitState === 'CONDITIONAL' && dv.condition && <p class="mt-2 text-xs leading-relaxed text-amber-900">{dv.condition}</p>}
                    {dv.fitState === 'AWAITING_VERIFICATION' && <p class="mt-2 text-xs leading-relaxed text-blue-900">{battery.config.awaitingVerificationNote}</p>}
                  </li>
                ))}
              </ul>
            ) : (
              <p class="mt-4 rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900">
                We have not published a checked phone for this battery yet. Ask us before you buy.
              </p>
            )}
            <div class="mt-5 rounded-2xl border border-slate-200 bg-slate-50 p-4">
              <h3 class="text-sm font-bold text-slate-900">Check your exact model number first</h3>
              <p class="mt-1 text-xs leading-relaxed text-slate-600">{battery.config.modelNumberHelp}</p>
              <a href="/battery-finder" class="mt-3 inline-block rounded-xl border border-slate-300 bg-white px-4 py-2 text-xs font-bold text-slate-900 hover:border-brand-primary">Find a battery by phone</a>
            </div>
            {(battery.battery.capacityMah || battery.battery.nominalVoltageMv || battery.battery.warrantyMonths || battery.battery.chemistry) && (
              <dl class="mt-5 grid grid-cols-2 sm:grid-cols-4 gap-3 text-sm">
                {battery.battery.capacityMah && <div class="rounded-xl border border-slate-200 bg-white p-3"><dt class="text-[10px] uppercase font-black tracking-widest text-slate-400">Capacity</dt><dd class="font-bold text-slate-900 mt-1">{battery.battery.capacityMah} mAh</dd></div>}
                {battery.battery.nominalVoltageMv && <div class="rounded-xl border border-slate-200 bg-white p-3"><dt class="text-[10px] uppercase font-black tracking-widest text-slate-400">Voltage</dt><dd class="font-bold text-slate-900 mt-1">{(battery.battery.nominalVoltageMv / 1000).toFixed(2)} V</dd></div>}
                {battery.battery.chemistry && <div class="rounded-xl border border-slate-200 bg-white p-3"><dt class="text-[10px] uppercase font-black tracking-widest text-slate-400">Chemistry</dt><dd class="font-bold text-slate-900 mt-1">{CHEMISTRY_LABEL[battery.battery.chemistry] ?? battery.battery.chemistry}</dd></div>}
                {battery.battery.warrantyMonths != null && <div class="rounded-xl border border-slate-200 bg-white p-3"><dt class="text-[10px] uppercase font-black tracking-widest text-slate-400">Warranty</dt><dd class="font-bold text-slate-900 mt-1">{battery.battery.warrantyMonths} months</dd></div>}
              </dl>
            )}
            {battery.battery.publicNotes && <p class="mt-4 text-sm text-slate-600">{battery.battery.publicNotes}</p>}
          </div>
        )}

        {compatibilityEntries.length > 0 && (
          <div class="border-t border-slate-100 pt-10" aria-labelledby="compat-heading">
            <h2 id="compat-heading" class="text-xl font-black text-slate-900">Verified compatibility</h2>
            <p class="mt-1 text-sm text-slate-600">Checked and declared by GoldPlus staff, not guesses.</p>
            <ul class="mt-5 grid grid-cols-1 gap-3 sm:grid-cols-2">
              {compatibilityEntries.map((entry) => (
                <li class="rounded-2xl border border-slate-200 bg-white p-4">
                  <div class="flex items-start justify-between gap-3">
                    <a href={`/products/${entry.slug}`} class="text-sm font-bold text-slate-900 hover:text-brand-primary">{entry.name}</a>
                    <span class={`shrink-0 rounded-full border px-2.5 py-1 text-[10px] font-black uppercase tracking-widest ${verdictBadge[entry.verdict] ?? 'border-slate-200 bg-slate-50 text-slate-600'}`}>{entry.label}</span>
                  </div>
                  {entry.note && <p class="mt-2 text-xs leading-relaxed text-slate-600">{entry.note}</p>}
                </li>
              ))}
            </ul>
          </div>
        )}
        <div class="border-t border-slate-100 pt-10">
          <CompleteSetupRail
            productId={product.id}
            productSlug={product.slug}
            categoryName={product.categoryName}
            subcategoryName={productSubcategory}
          />
        </div>
        <div class="border-t border-slate-100 pt-10">
          <RelatedProductsRail
            productId={product.id}
            productSlug={product.slug}
            categoryName={product.categoryName}
            subcategoryName={productSubcategory}
          />
        </div>
        <div class="border-t border-slate-100 pt-10">
          <RecentlyViewedRail 
            title="Browse available products"
            subtitle="A few more from the GoldPlus shelf."
            alwaysRender={true} 
            fallbackProducts={pdpFallbackProducts} 
          />
        </div>
      </div>
    )}
  </div>
</BaseLayout>

<script is:inline>
  (function () {
    // SCOPED to the PDP's own element: the header carries data-sale-ends for the
    // flash-sale strip, and a bare [data-sale-ends] query matched it FIRST —
    // textContent then wiped the ENTIRE navigation on every product page.
    var el = document.querySelector('[data-pdp-sale-ends]');
    if (!el) return;
    var end = new Date(el.getAttribute('data-pdp-sale-ends')).getTime();
    if (!isFinite(end)) return;
    function tick() {
      var ms = end - Date.now();
      if (ms <= 0) { el.textContent = 'This offer has ended'; return; }
      var d = Math.floor(ms / 86400000), h = Math.floor((ms % 86400000) / 3600000), m = Math.floor((ms % 3600000) / 60000);
      el.textContent = d > 0 ? ('Offer ends in ' + d + 'd ' + h + 'h') : (h > 0 ? ('Offer ends in ' + h + 'h ' + m + 'm') : ('Offer ends in ' + m + 'm'));
    }
    tick();
    setInterval(tick, 60000);
  })();
</script>

<script>
  import {
    trackProductView,
    saveRecentlyViewedLocal,
    getAndClearClickAttribution,
    trackRecommendationEvent,
  } from '../../lib/recommendations';
  import { markSeenBefore } from '../../lib/returning-user';

  import {
    track,
    captureClickIdsServerSide,
    getFpClientId,
  } from '../../lib/telemetry';

  document.addEventListener('DOMContentLoaded', () => {
    const root = document.querySelector('[data-product-tracking]');
    if (!root) return;

    const id       = root.getAttribute('data-product-id') ?? '';
    const slug     = root.getAttribute('data-product-slug') ?? '';
    const name     = root.getAttribute('data-product-name') ?? '';
    const image    = root.getAttribute('data-product-image') ?? '';
    const priceRaw = root.getAttribute('data-product-price') ?? '';
    const categoryName = root.getAttribute('data-product-category') ?? '';
    const price    = priceRaw ? Number(priceRaw) : undefined;

    // ── 1. Capture any click IDs from URL and persist them server-side ────────
    // This is the critical attribution step — if a user arrives via a Google/
    // Meta/TikTok ad and converts 3 days later, this persists the gclid/ttclid
    // so the purchase event can be enriched with it.
    captureClickIdsServerSide();

    if (id && name) {
      // ── 2. GA4-compatible view_item event ──────────────────────────────────
      track('view_item', {
        ecommerce: {
          value:    price,
          currency: 'UGX',
          items: [{
            item_id:       id,
            item_name:     name,
            price:         price,
            quantity:      1,
            item_category: categoryName || undefined,
            item_brand:    'GoldPlus',
          }],
        },
      });

      // ── 3. Existing recommendation tracking ───────────────────────────────
      trackProductView(id).catch(() => {});
      // R7: the returning-visitor marker finally gets its writer — without it,
      // the homepage recently-viewed rail could never render for anyone.
      markSeenBefore();

      saveRecentlyViewedLocal({
        productId: id,
        slug,
        name,
        imageUrl:  image || undefined,
        price,
        currency:  'UGX',
      });
    }

    // ── 4. Add-to-Cart telemetry + recommendation attribution ────────────────
    const form = document.querySelector<HTMLFormElement>('form[action="/cart"]');
    if (form && id) {
      form.addEventListener('submit', () => {
        // GA4-compatible add_to_cart event (fires before page navigation)
        track('add_to_cart', {
          ecommerce: {
            value:    price,
            currency: 'UGX',
            items: [{
              item_id:       id,
              item_name:     name,
              price:         price,
              quantity:      1,
              item_category: categoryName || undefined,
              item_brand:    'GoldPlus',
            }],
          },
        });

        // Existing recommendation attribution
        const attribution = getAndClearClickAttribution(id);
        if (attribution) {
          trackRecommendationEvent({
            eventType:               'RECOMMENDATION_ADD_TO_CART',
            recommendationProductId: id,
            placement:               attribution.placement,
            attributionId:           attribution.attributionId,
            railRenderId:            attribution.railRenderId,
            ruleId:                  attribution.ruleId,
            reasonCode:              attribution.reasonCode,
            source:                  'product_page',
          }).catch(() => {});
        } else {
          trackRecommendationEvent({
            eventType: 'PRODUCT_ADDED_TO_CART',
            productId: id,
            source:    'product_page',
          }).catch(() => {});
        }
      });
    }
  });
</script>
