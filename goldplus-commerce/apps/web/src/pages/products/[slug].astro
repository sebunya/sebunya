              document.querySelectorAll<HTMLButtonElement>('[data-bundle-add]').forEach((btn) => {
                btn.hidden = false;
                btn.closest('[data-bundle]')?.querySelectorAll<HTMLElement>('[data-bundle-fallback]').forEach((f) => { f.hidden = true; });
