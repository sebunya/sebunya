                {battery.battery.nominalVoltageMv && <div class="rounded-xl border border-slate-200 bg-white p-3"><dt class="text-[10px] uppercase font-black tracking-widest text-slate-500">Voltage</dt><dd class="font-bold text-slate-900 mt-1">{(battery.battery.nominalVoltageMv / 1000).toFixed(2)} V</dd></div>}
                {battery.battery.chemistry && <div class="rounded-xl border border-slate-200 bg-white p-3"><dt class="text-[10px] uppercase font-black tracking-widest text-slate-500">Chemistry</dt><dd class="font-bold text-slate-900 mt-1">{CHEMISTRY_LABEL[battery.battery.chemistry] ?? battery.battery.chemistry}</dd></div>}
