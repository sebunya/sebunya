---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormField from '../../components/FormField.astro';
import FormFeedback from '../../components/FormFeedback.astro';
import { postJson } from '../../lib/api';

let status: 'success' | 'error' | 'received' | null = null;
let message: string | undefined;
let reference: string | undefined;
let values: Record<string, string> = {};

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const dto = {
    locationFound: String(form.get('locationFound') ?? '').trim(),
    productDescription: String(form.get('productDescription') ?? '').trim(),
    hologramCode: String(form.get('hologramCode') ?? '').trim(),
    reporterContact: String(form.get('reporterContact') ?? '').trim(),
  };
  values = dto;
  const missing = (['locationFound', 'productDescription'] as const)
    .filter((k) => !dto[k as keyof typeof dto]);
  if (missing.length > 0) {
    status = 'error';
    message = `Please fill in all required fields: ${missing.join(', ')}.`;
  } else {
    const result = await postJson('/governance/support/report-fake', dto);
    reference = result.ok ? result.reference : undefined;
    if (result.ok) {
      status = 'received';
      message = 'Report received. The brand protection team investigates every counterfeit report.';
      values = {};
    } else {
      status = 'error';
      message = result.code === 'NETWORK'
        ? 'Cannot reach the report service right now. Please try again shortly.'
        : result.message;
    }
  }
}
---

<BaseLayout title="Report counterfeit product">
  <div class="container mx-auto px-4 lg:px-8 py-12">
    <div class="max-w-2xl mx-auto">
      <div class="bg-red-50 border border-red-100 rounded-2xl p-6 mb-6 flex gap-4 items-start">
        <div aria-hidden="true" class="w-10 h-10 bg-red-100 text-red-600 rounded-full flex items-center justify-center flex-shrink-0 font-black">!</div>
        <div>
          <h1 class="text-xl md:text-2xl font-black text-red-800 mb-1">Report a counterfeit product</h1>
          <p class="text-red-700 text-sm leading-relaxed">
            Your report helps us eliminate fake electronics in Uganda. We investigate every submission and refer serious cases to the relevant authorities.
          </p>
        </div>
      </div>

      <FormFeedback status={status} message={message} reference={reference} />

      <form method="POST" action="/support/fake" novalidate class="space-y-6">
        <div class="bg-white p-6 md:p-8 rounded-2xl border border-gray-200 shadow-sm space-y-5">
          <FormField id="locationFound" name="locationFound" label="Where did you find this product?" required defaultValue={values.locationFound} placeholder="Shop name, market stall, online store" />
          <FormField id="productDescription" name="productDescription" label="What did the product look like?" type="textarea" rows={4} required defaultValue={values.productDescription} placeholder="e.g. Code rejected, poor build quality, strange packaging…" />
          <FormField id="hologramCode" name="hologramCode" label="Hologram code (if any)" defaultValue={values.hologramCode} placeholder="GP-XXXX-XXXX-XXXX" helperText="Optional. Tells us which batch the counterfeit is targeting." />
          <FormField id="reporterContact" name="reporterContact" label="Your contact (optional)" defaultValue={values.reporterContact} helperText="Optional. We can update you if we make progress on your report." />
          <p class="text-xs text-gray-500 italic">Image upload is not active in this phase. Future module. Not active in Phase 1.</p>
        </div>

        <div class="flex items-center gap-4">
          <button type="submit" class="bg-red-600 text-white px-8 py-3 rounded-xl font-bold hover:bg-red-700 focus-visible:ring-4 focus-visible:ring-red-300 outline-none transition-all">
            Submit report
          </button>
          <a href="/support" class="text-sm font-bold text-gray-500 hover:text-brand-dark transition-colors">Cancel</a>
        </div>
      </form>
    </div>
  </div>
</BaseLayout>
