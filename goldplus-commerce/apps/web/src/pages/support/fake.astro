---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Report Counterfeit - GoldPlus">
  <div class="container mx-auto px-4 lg:px-8 py-12">
    <div class="max-w-2xl mx-auto">
      <div class="bg-red-50 border border-red-100 rounded-2xl p-6 mb-8 flex gap-4 items-start">
        <div class="w-10 h-10 bg-red-100 text-red-600 rounded-full flex items-center justify-center flex-shrink-0">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
        </div>
        <div>
          <h1 class="text-2xl font-black text-red-800 mb-1">Report a Counterfeit Product</h1>
          <p class="text-red-700 text-sm">Your report helps us eliminate fake electronics in Uganda. We investigate every submission and take legal action where necessary.</p>
        </div>
      </div>

      <form class="space-y-6">
        <div class="bg-white p-8 rounded-2xl border border-gray-200 shadow-sm">
          <div class="space-y-4">
            <div>
              <label for="location" class="block text-sm font-bold text-brand-dark mb-2">Where did you find this product?</label>
              <input type="text" id="location" name="location" required placeholder="Shop name, market, or online link" class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-red-500 outline-none transition-all">
            </div>
            <div>
              <label for="details" class="block text-sm font-bold text-brand-dark mb-2">Details / Why do you suspect it's fake?</label>
              <textarea id="details" name="details" rows="4" required placeholder="e.g. Code rejected, poor build quality, strange packaging..." class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-red-500 outline-none transition-all"></textarea>
            </div>
            <div class="p-4 bg-gray-50 border border-dashed border-gray-300 rounded-xl text-center">
               <p class="text-xs text-gray-400 font-medium">Image upload (Coming Soon in Phase 2)</p>
            </div>
            <div>
              <label for="contact" class="block text-sm font-bold text-brand-dark mb-2">Your Contact (Optional but helpful)</label>
              <input type="text" id="contact" name="contact" class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-red-500 outline-none transition-all">
            </div>
          </div>
        </div>

        <div class="flex items-center gap-4">
          <button type="submit" class="bg-red-600 text-white px-8 py-3 rounded-xl font-bold hover:bg-red-700 transition-all transform hover:-translate-y-1 shadow-lg shadow-red-100">
            Submit Report
          </button>
          <a href="/support" class="text-sm font-bold text-gray-500 hover:text-brand-dark transition-colors">Cancel</a>
        </div>
      </form>
    </div>
  </div>
</BaseLayout>
