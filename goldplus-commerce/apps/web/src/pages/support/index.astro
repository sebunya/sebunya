---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { whatsappSupportNumber } from '../../lib/api';
import { getStorefrontCopy } from '../../lib/storefrontCopy';

const whatsappSupportUrl = `https://wa.me/${whatsappSupportNumber}?text=${encodeURIComponent(
  'Hello GoldPlus, I need customer support.'
)}`;
// Support landing heading + intro — operator-editable (admin/storefront-copy).
const copy = await getStorefrontCopy();
---

<BaseLayout title="Customer support and order help | GoldPlus">
  <main>
    <section class="border-b border-slate-100 bg-gradient-to-b from-slate-50 to-white py-12 sm:py-16">
      <div class="container mx-auto px-4 text-center lg:px-8">
        <p class="mb-3 text-xs font-black uppercase tracking-[0.18em] text-brand-primary">GoldPlus support</p>
        <h1 class="text-3xl font-black tracking-tight text-gray-900 sm:text-4xl">{copy.supportHeading}</h1>
        <p class="mx-auto mt-4 max-w-2xl text-sm leading-relaxed text-slate-600 sm:text-base">
          {copy.supportIntro}
        </p>
      </div>
    </section>

    <section aria-labelledby="support-options" class="container mx-auto px-4 py-10 sm:py-14 lg:px-8">
      <h2 id="support-options" class="sr-only">Support options</h2>
      <div class="grid grid-cols-1 gap-5 md:grid-cols-3">
        <article class="flex flex-col rounded-2xl border border-slate-200 bg-white p-6 shadow-xs sm:p-8">
          <p class="text-xs font-black uppercase tracking-wider text-brand-primary">Existing orders</p>
          <h3 class="mt-3 text-xl font-black text-gray-900">Need help with an order?</h3>
          <p class="mt-3 flex-1 text-sm leading-relaxed text-slate-600">
            Have your order reference and the contact detail used at checkout ready. We will help verify your order details.
          </p>
          <a
            href="/track-order"
            aria-label="Open order help guidance"
            class="mt-6 inline-flex min-h-11 items-center justify-center rounded-full bg-brand-primary px-5 py-3 text-center text-xs font-black uppercase tracking-wider text-gray-950 outline-none transition hover:shadow-md focus-visible:ring-2 focus-visible:ring-brand-primary focus-visible:ring-offset-2"
          >
            Open order help
          </a>
        </article>

        <article class="flex flex-col rounded-2xl border border-slate-200 bg-white p-6 shadow-xs sm:p-8">
          <p class="text-xs font-black uppercase tracking-wider text-emerald-700">Direct support</p>
          <h3 class="mt-3 text-xl font-black text-gray-900">Ask on WhatsApp</h3>
          <p class="mt-3 flex-1 text-sm leading-relaxed text-slate-600">
            Open a conversation with GoldPlus support. This link does not send a message automatically.
          </p>
          <a
            href={whatsappSupportUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Open GoldPlus support on WhatsApp in a new tab"
            class="mt-6 inline-flex min-h-11 items-center justify-center rounded-full bg-slate-900 px-5 py-3 text-center text-xs font-black uppercase tracking-wider text-white outline-none transition hover:bg-black focus-visible:ring-2 focus-visible:ring-slate-900 focus-visible:ring-offset-2"
          >
            Open WhatsApp support
          </a>
        </article>

        <article class="flex flex-col rounded-2xl border border-slate-200 bg-white p-6 shadow-xs sm:p-8">
          <p class="text-xs font-black uppercase tracking-wider text-slate-500">Product concerns</p>
          <h3 class="mt-3 text-xl font-black text-gray-900">Report a product issue</h3>
          <p class="mt-3 flex-1 text-sm leading-relaxed text-slate-600">
            Share a technical concern or report a suspected counterfeit product using the existing support routes.
          </p>
          <div class="mt-6 flex flex-col gap-3 sm:flex-row md:flex-col">
            <a href="/support/issue" class="inline-flex min-h-11 flex-1 items-center justify-center rounded-full border border-slate-300 px-5 py-3 text-center text-xs font-black uppercase tracking-wider text-slate-800 outline-none transition hover:border-slate-900 focus-visible:ring-2 focus-visible:ring-brand-primary">Report an issue</a>
            <a href="/support/fake" class="inline-flex min-h-11 flex-1 items-center justify-center rounded-full border border-slate-300 px-5 py-3 text-center text-xs font-black uppercase tracking-wider text-slate-800 outline-none transition hover:border-slate-900 focus-visible:ring-2 focus-visible:ring-brand-primary">Report counterfeit</a>
          </div>
        </article>
      </div>
    </section>

    <section id="returns-warranty" aria-labelledby="policy-help" class="scroll-mt-24 border-y border-slate-200 bg-slate-50/70">
      <div class="container mx-auto px-4 py-10 lg:px-8">
        <div class="mx-auto max-w-4xl">
          <h2 id="policy-help" class="text-2xl font-black text-gray-900">Returns, warranty and terms</h2>
          <p class="mt-3 max-w-3xl text-sm leading-relaxed text-slate-600">
            Warranty and returns depend on the product, order details and the applicable GoldPlus policy. Ask support to confirm what applies before purchase or before returning an item.
          </p>
          <nav aria-label="Customer policy help" class="mt-6 flex flex-wrap gap-3">
            <a href="#returns-warranty" class="inline-flex min-h-11 items-center rounded-full border border-slate-300 bg-white px-5 py-3 text-xs font-bold text-slate-800 outline-none hover:border-slate-900 focus-visible:ring-2 focus-visible:ring-brand-primary">Returns help</a>
            <a href="#returns-warranty" class="inline-flex min-h-11 items-center rounded-full border border-slate-300 bg-white px-5 py-3 text-xs font-bold text-slate-800 outline-none hover:border-slate-900 focus-visible:ring-2 focus-visible:ring-brand-primary">Warranty help</a>
            <a href="#terms-guidance" class="inline-flex min-h-11 items-center rounded-full border border-slate-300 bg-white px-5 py-3 text-xs font-bold text-slate-800 outline-none hover:border-slate-900 focus-visible:ring-2 focus-visible:ring-brand-primary">Terms guidance</a>
            <a href="#privacy-guidance" class="inline-flex min-h-11 items-center rounded-full border border-slate-300 bg-white px-5 py-3 text-xs font-bold text-slate-800 outline-none hover:border-slate-900 focus-visible:ring-2 focus-visible:ring-brand-primary">Privacy guidance</a>
          </nav>
          <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2">
            <article id="terms-guidance" class="scroll-mt-24 rounded-xl border border-slate-200 bg-white p-5">
              <h3 class="font-black text-gray-900">Terms guidance</h3>
              <p class="mt-2 text-sm leading-relaxed text-slate-600">Ask support to confirm the terms that apply to your product and order before you buy, return or request warranty help.</p>
            </article>
            <article id="privacy-guidance" class="scroll-mt-24 rounded-xl border border-slate-200 bg-white p-5">
              <h3 class="font-black text-gray-900">Privacy guidance</h3>
              <p class="mt-2 text-sm leading-relaxed text-slate-600">Share only the details needed to identify your order. Never send passwords, payment credentials or one-time codes to support.</p>
            </article>
          </div>
        </div>
      </div>
    </section>

    <section aria-labelledby="support-expectations" class="container mx-auto px-4 py-10 sm:py-14 lg:px-8">
      <div class="mx-auto max-w-4xl rounded-2xl border border-amber-200 bg-amber-50/60 p-6 sm:p-8">
        <h2 id="support-expectations" class="text-lg font-black text-amber-950">What support can confirm</h2>
        <p class="mt-3 text-sm leading-relaxed text-amber-900">
          Support can help check the information available for your order. Delivery timing and support options depend on your order details, product availability and location. An order reference alone is not proof of payment, confirmation or dispatch.
        </p>
      </div>
    </section>
  </main>
</BaseLayout>
