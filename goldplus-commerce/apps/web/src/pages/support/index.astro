import BaseLayout from "../../layouts/BaseLayout.astro";
import { whatsappSupportNumber } from "../../lib/api";
---

<BaseLayout title="Customer Support - GoldPlus">
  <div class="bg-gray-50 py-16 border-b border-gray-200">
    <div class="container mx-auto px-4 lg:px-8 text-center">
      <h1 class="text-3xl md:text-5xl font-black tracking-tight text-brand-dark mb-4">How can we help?</h1>
      <p class="text-gray-600 max-w-2xl mx-auto text-lg">Our Ugandan support team is dedicated to ensuring you have the best experience with GoldPlus electronics.</p>
    </div>
  </div>

  <div class="container mx-auto px-4 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      
      <div class="bg-white p-8 rounded-2xl border border-gray-200 hover:border-brand-gold transition-colors shadow-sm">
        <div class="w-14 h-14 bg-brand-green/10 text-brand-green rounded-xl flex items-center justify-center mb-6">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
        </div>
        <h2 class="text-2xl font-bold text-brand-dark mb-3">Technical Support</h2>
        <p class="text-gray-600 mb-6 text-sm">Need help setting up your charger or troubleshooting a sound device? We're here.</p>
        <a href="/support/issue" class="text-brand-green font-bold hover:underline">Report an Issue &rarr;</a>
      </div>

      <div class="bg-white p-8 rounded-2xl border border-gray-200 hover:border-red-500 transition-colors shadow-sm">
        <div class="w-14 h-14 bg-red-50 text-red-600 rounded-xl flex items-center justify-center mb-6">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
        </div>
        <h2 class="text-2xl font-bold text-brand-dark mb-3">Report Counterfeit</h2>
        <p class="text-gray-600 mb-6 text-sm">Found a fake GoldPlus product? Report it to protect others and maintain quality standards.</p>
        <a href="/support/fake" class="text-red-600 font-bold hover:underline">Report Fake &rarr;</a>
      </div>

      <div class="bg-white p-8 rounded-2xl border border-gray-200 hover:border-brand-dark transition-colors shadow-sm">
        <div class="w-14 h-14 bg-gray-100 text-brand-dark rounded-xl flex items-center justify-center mb-6">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path></svg>
        </div>
        <h2 class="text-2xl font-bold text-brand-dark mb-3">WhatsApp Support</h2>
        <p class="text-gray-600 mb-6 text-sm">Quick questions? Chat with our team directly on WhatsApp for instant assistance.</p>
        <a href={`https://wa.me/${whatsappSupportNumber}`} class="text-brand-dark font-bold hover:underline">Chat with us &rarr;</a>
      </div>

    </div>
  </div>
</BaseLayout>
