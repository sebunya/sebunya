---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Report an Issue - GoldPlus">
  <div class="container mx-auto px-4 lg:px-8 py-12">
    <div class="max-w-2xl mx-auto">
      <h1 class="text-3xl font-black text-brand-dark mb-2">Report a Technical Issue</h1>
      <p class="text-gray-600 mb-8">Tell us what's wrong, and our technical team will help you resolve it. Please be as descriptive as possible.</p>

      <form class="space-y-6">
        <div class="bg-white p-8 rounded-2xl border border-gray-200 shadow-sm">
          <div class="space-y-4">
            <div>
              <label for="subject" class="block text-sm font-bold text-brand-dark mb-2">Issue Subject</label>
              <input type="text" id="subject" name="subject" required placeholder="e.g. Charger not fast charging" class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-lg focus:ring-2 focus:ring-brand-green focus:border-brand-green outline-none transition-all">
            </div>
            <div>
              <label for="product" class="block text-sm font-bold text-brand-dark mb-2">Product Model (if known)</label>
              <input type="text" id="product" name="product" placeholder="e.g. GoldPlus GP-CH-01" class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-lg focus:ring-2 focus:ring-brand-green focus:border-brand-green outline-none transition-all">
            </div>
            <div>
              <label for="description" class="block text-sm font-bold text-brand-dark mb-2">Description of the problem</label>
              <textarea id="description" name="description" rows="5" required placeholder="Describe what happened..." class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-lg focus:ring-2 focus:ring-brand-green focus:border-brand-green outline-none transition-all"></textarea>
            </div>
            <div>
              <label for="contact" class="block text-sm font-bold text-brand-dark mb-2">Your Contact (Phone or Email)</label>
              <input type="text" id="contact" name="contact" required class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-lg focus:ring-2 focus:ring-brand-green focus:border-brand-green outline-none transition-all">
            </div>
          </div>
        </div>

        <div class="flex items-center gap-4">
          <button type="submit" class="bg-brand-dark text-white px-8 py-3 rounded-xl font-bold hover:bg-black transition-all">
            Submit Issue
          </button>
          <a href="/support" class="text-sm font-bold text-gray-500 hover:text-brand-dark transition-colors">Cancel</a>
        </div>
      </form>
    </div>
  </div>
</BaseLayout>
