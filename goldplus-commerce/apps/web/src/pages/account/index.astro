---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatUgx } from "../../lib/money";
import AccountNav from '../../components/AccountNav.astro';
import EmptyState from '../../components/EmptyState.astro';
import Notice from '../../components/Notice.astro';
import { apiBase } from '../../lib/api';
import { readSessionToken, SESSION_COOKIE_NAME } from '../../lib/session';
import { orderStatusCopy, STATUS_TONE_CLASS } from '../../lib/orderStatusCopy';

const token = readSessionToken(Astro.request);
if (!token) {
  return Astro.redirect('/login?returnTo=/account', 303);
}

// The hub is ONE read: /account/overview composes profile, loyalty, rewards,
// orders and addresses server-side from the same use cases the detail pages
// use, so this page can never disagree with them.
let overview: any = null;
let unauthorised = false;
let loadError = '';
try {
  const res = await fetch(`${apiBase}/account/overview`, {
    headers: { Authorization: `Bearer ${token}` },
    signal: AbortSignal.timeout(6000),
  });
  if (res.status === 401) {
    unauthorised = true;
  } else {
    const json: any = await res.json().catch(() => null);
    if (json?.success) overview = json.data;
    else loadError = json?.error?.message ?? 'Could not load your account.';
  }
} catch {
  loadError = 'The account service is unreachable right now.';
}

if (unauthorised) {
  Astro.cookies.delete(SESSION_COOKIE_NAME, { path: '/' });
  return Astro.redirect('/login?returnTo=/account', 303);
}

const formatDate = (iso: string) => new Date(iso).toLocaleDateString('en-GB');

---

<BaseLayout robotsMeta="noindex,follow" title="My account">
  <div class="container mx-auto px-4 lg:px-8 py-10 lg:py-14">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3 mb-6 pb-6 border-b border-brand-borderGrey">
      <div>
        <h1 class="text-2xl md:text-3xl font-black text-brand-charcoal tracking-tight">My account</h1>
        {overview && <p class="text-sm text-brand-mutedGrey mt-1">{overview.profile.email}</p>}
      </div>
      <a href="/logout" class="text-sm font-bold text-brand-mutedGrey hover:text-brand-charcoal">Sign out &rarr;</a>
    </div>

    <AccountNav active="overview" />

    {loadError && <Notice kind="not-configured" title="Account unavailable" message={loadError} />}

    {overview && (
      <div class="space-y-6">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <a href="/account/loyalty" class="block bg-white border border-brand-borderGrey rounded-2xl p-6 hover:border-brand-charcoal transition-all">
            <h2 class="text-xs font-bold uppercase tracking-widest text-brand-mutedGrey mb-2">GoldPlus points</h2>
            {overview.loyalty.programmeActive ? (
              <>
                <p class="text-3xl font-black text-brand-charcoal">{overview.loyalty.balance.available.toLocaleString('en-UG')}</p>
                <p class="text-xs text-brand-mutedGrey mt-1.5">
                  {overview.loyalty.soonestExpiry
                    ? `Earliest points expire ${formatDate(overview.loyalty.soonestExpiry)}.`
                    : 'Earn points on every paid order.'}
                </p>
              </>
            ) : (
              <p class="text-sm text-brand-mutedGrey">The loyalty programme is not active right now.</p>
            )}
          </a>

          <a href="/account/rewards" class="block bg-white border border-brand-borderGrey rounded-2xl p-6 hover:border-brand-charcoal transition-all">
            <h2 class="text-xs font-bold uppercase tracking-widest text-brand-mutedGrey mb-2">Rewards</h2>
            <p class="text-3xl font-black text-brand-charcoal">{overview.rewards.badgeCount}</p>
            <p class="text-xs text-brand-mutedGrey mt-1.5">
              badge{overview.rewards.badgeCount === 1 ? '' : 's'} earned ·
              {overview.rewards.missionCount > 0
                ? ` ${overview.rewards.missionsCompleted}/${overview.rewards.missionCount} missions complete`
                : ' no missions running yet'}
            </p>
          </a>

          <a href="/account/orders" class="block bg-white border border-brand-borderGrey rounded-2xl p-6 hover:border-brand-charcoal transition-all">
            <h2 class="text-xs font-bold uppercase tracking-widest text-brand-mutedGrey mb-2">Orders</h2>
            <p class="text-3xl font-black text-brand-charcoal">{overview.orderCount}</p>
            <p class="text-xs text-brand-mutedGrey mt-1.5">order{overview.orderCount === 1 ? '' : 's'} on this account</p>
          </a>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
          <section class="bg-white border border-brand-borderGrey rounded-2xl p-6 lg:col-span-2">
            <div class="flex items-center justify-between mb-3">
              <h2 class="text-xs font-bold uppercase tracking-widest text-brand-mutedGrey">Recent orders</h2>
              {overview.orderCount > 0 && <a href="/account/orders" class="text-xs font-bold text-brand-mutedGrey hover:text-brand-charcoal">View all &rarr;</a>}
            </div>
            {overview.recentOrders.length === 0 ? (
              <EmptyState title="No orders yet" message="Orders placed while signed in appear here — and earn GoldPlus points when paid. Ordered as a guest? Look it up with your order reference.">
                <div class="flex flex-col sm:flex-row gap-3 justify-center">
                  <a href="/shop" class="inline-flex items-center justify-center rounded-full bg-brand-charcoal px-5 py-2.5 text-xs font-bold uppercase tracking-wider text-white hover:bg-black">Start shopping</a>
                  <a href="/track-order" class="inline-flex items-center justify-center rounded-full border border-brand-borderGrey px-5 py-2.5 text-xs font-bold uppercase tracking-wider text-brand-charcoal hover:bg-brand-softGrey">Find a guest order</a>
                </div>
              </EmptyState>
            ) : (
              <ul class="divide-y divide-brand-borderGrey">
                {overview.recentOrders.map((o: any) => (
                  <li class="py-3 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
                    <div class="min-w-0">
                      <a href={`/orders/${o.id}`} class="font-bold text-brand-charcoal hover:underline">{o.orderNumber}</a>
                      <p class="text-xs text-brand-mutedGrey mt-1">{formatDate(o.createdAt)} · {o.itemCount} item{o.itemCount === 1 ? '' : 's'}</p>
                    </div>
                    <div class="flex items-center gap-3">
                      <span class={`inline-flex items-center px-2 py-1 rounded border text-[10px] font-bold uppercase tracking-widest ${STATUS_TONE_CLASS[orderStatusCopy(o.status).tone]}`}>{orderStatusCopy(o.status).label}</span>
                      <span class="font-bold text-brand-charcoal whitespace-nowrap">{formatUgx(o.totalAmountUgx)}</span>
                    </div>
                  </li>
                ))}
              </ul>
            )}
          </section>

          <section class="bg-white border border-brand-borderGrey rounded-2xl p-6">
            <div class="flex items-center justify-between mb-3">
              <h2 class="text-xs font-bold uppercase tracking-widest text-brand-mutedGrey">Delivery address</h2>
              <a href="/account/addresses" class="text-xs font-bold text-brand-mutedGrey hover:text-brand-charcoal">Manage &rarr;</a>
            </div>
            {overview.defaultAddress ? (
              <div>
                <p class="font-bold text-brand-charcoal">{overview.defaultAddress.label}</p>
                <p class="text-sm text-brand-charcoal mt-1">{overview.defaultAddress.recipientName}</p>
                <p class="text-sm text-brand-mutedGrey">{overview.defaultAddress.areaDetails}, {overview.defaultAddress.district}</p>
                <p class="text-xs text-brand-mutedGrey mt-1">{overview.defaultAddress.phone}</p>
                <p class="text-[11px] text-brand-mutedGrey mt-3 leading-relaxed">Checkout opens pre-filled with this address.</p>
              </div>
            ) : (
              <EmptyState title="No addresses saved" message="Save a delivery address and checkout fills itself in." />
            )}
            <p class="text-xs text-brand-mutedGrey mt-4 pt-4 border-t border-brand-borderGrey">
              Member since {formatDate(overview.profile.createdAt)}{overview.profile.phone ? ` · ${overview.profile.phone}` : ''}
            </p>
          </section>
        </div>
      </div>
    )}
  </div>
</BaseLayout>
