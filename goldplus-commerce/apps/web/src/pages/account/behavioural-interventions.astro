---
import BaseLayout from '../../layouts/BaseLayout.astro'; import { apiBase } from '../../lib/api'; import { readSessionToken } from '../../lib/session';
const token = readSessionToken(Astro.request); if (!token) return Astro.redirect('/login?returnTo=/account/behavioural-interventions', 303); const headers = { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' }; let notice = ''; let shown: any = null;
let candidates: any[] = []; try { const response = await fetch(`${apiBase}/account/behavioural-interventions`, { headers }); const body = await response.json().catch(() => null); candidates = body?.success ? body.data : []; } catch { notice = 'Guidance is temporarily unavailable. Nothing was recorded.'; }
if (Astro.request.method === 'POST') { const form = await Astro.request.formData(); const operation = String(form.get('operation')); try { if (operation === 'expose') { const definitionId = String(form.get('definitionId')); const candidate = candidates.find((item) => item.definition.id === definitionId); if (!candidate) throw new Error('This guidance is no longer eligible.'); const deliveryKey = `account:${definitionId}:${crypto.randomUUID()}`; const response = await fetch(`${apiBase}/account/behavioural-interventions/${definitionId}/exposures`, { method: 'POST', headers, body: JSON.stringify({ deliveryKey }) }); const body = await response.json(); if (!body?.success) throw new Error(body?.error?.message ?? 'Guidance is suppressed.'); shown = { candidate, exposure: body.data.exposure }; } else { const response = await fetch(`${apiBase}/account/behavioural-interventions/exposures/${form.get('exposureId')}/outcomes`, { method: 'POST', headers, body: JSON.stringify({ outcomeKey: `account:${form.get('exposureId')}:${operation}`, outcome: operation }) }); const body = await response.json(); if (!body?.success) throw new Error(body?.error?.message ?? 'Outcome was not recorded.'); if (operation === 'ENGAGED' && /^\/(?!\/)/.test(body.data.ctaPath)) return Astro.redirect(body.data.ctaPath, 303); notice = 'Closed. We will not show you that one again.'; } } catch (error) { notice = error instanceof Error ? error.message : 'Nothing was recorded.'; } }
---
<BaseLayout robotsMeta="noindex,follow" title="Guidance | GoldPlus"><main class="container mx-auto px-6 py-10 max-w-4xl"><h1 class="text-3xl font-black">Tips and offers for you</h1><p class="text-sm text-gray-600 mb-6">Suggestions based on what you have told us. You can close any of them, and they will not come back.</p>{notice && <div class="border rounded-xl p-4 mb-5" aria-live="polite">{notice}</div>}{shown ? <section class="bg-white border rounded-2xl p-6"><p class="text-xs text-gray-500">{shown.candidate.version.content.disclosure}</p><h2 class="text-xl font-black mt-2">{shown.candidate.version.content.title}</h2><p class="mt-2">{shown.candidate.version.content.body}</p><div class="flex gap-3 mt-5"><form method="POST"><input type="hidden" name="operation" value="ENGAGED"/><input type="hidden" name="exposureId" value={shown.exposure.id}/><button class="bg-brand-gold rounded px-4 py-2 font-black">{shown.candidate.version.content.ctaLabel}</button></form><form method="POST"><input type="hidden" name="operation" value="DISMISSED"/><input type="hidden" name="exposureId" value={shown.exposure.id}/><button class="border rounded px-4 py-2">Dismiss</button></form></div></section> : <>{candidates.length === 0 && <div class="bg-white border rounded-2xl p-8 text-center text-gray-500">Nothing for you right now. <a href="/shop" class="font-bold underline">Back to the shop</a></div>}{candidates.map((item) => <form method="POST" class="bg-white border rounded-2xl p-5 mb-4"><input type="hidden" name="operation" value="expose"/><input type="hidden" name="definitionId" value={item.definition.id}/><h2 class="font-black">{item.version.name}</h2><p class="text-sm text-gray-600">Optional. Open it if you are interested.</p><button class="border rounded px-4 py-2 mt-3">Open</button></form>)}</>}</main></BaseLayout>
