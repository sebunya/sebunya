---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { formatUgx } from '../../../lib/money';
import { apiBase } from '../../../lib/api';
import { readSessionToken, SESSION_COOKIE_NAME } from '../../../lib/session';
import { getBusinessInfo } from '../../../lib/businessInfo';
import type { OrderDetailDto, ApiResponse } from '@goldplus/shared';

/**
 * A printable receipt for a paid order (gap analysis #7). Signed-in customers only, their own orders only (the
 * API answers /account/orders/:id for the owner and 404 otherwise). "Print or save as PDF" uses the browser's own
 * print dialog, so there is no PDF library to keep. It is a payment receipt, not a URA EFRIS fiscal invoice; it
 * says so rather than imitate one.
 */
const { id } = Astro.params;
const token = readSessionToken(Astro.request);
if (!token) return Astro.redirect(`/login?returnTo=/account/receipts/${encodeURIComponent(id ?? '')}`, 303);

let order: OrderDetailDto | null = null;
let problem = '';
try {
  const res = await fetch(`${apiBase}/account/orders/${encodeURIComponent(id ?? '')}`, {
    signal: AbortSignal.timeout(8_000),
    headers: { Authorization: `Bearer ${token}` },
  });
  if (res.status === 401) {
    Astro.cookies.delete(SESSION_COOKIE_NAME, { path: '/' });
    return Astro.redirect(`/login?returnTo=/account/receipts/${encodeURIComponent(id ?? '')}`, 303);
  }
  if (res.status === 404) problem = 'We could not find that order on your account.';
  else if (!res.ok) problem = 'We could not load this receipt right now. Please try again in a moment.';
  else {
    const json = (await res.json()) as ApiResponse<OrderDetailDto>;
    order = json.success ? json.data : null;
    if (!order) problem = 'We could not load this receipt right now. Please try again in a moment.';
  }
} catch {
  problem = 'We could not reach our order system right now. Please try again in a moment.';
}

const paid = order?.paymentStatus === 'paid';
if (order && !paid) problem = 'A receipt is ready once the order is paid.';
const biz = await getBusinessInfo().catch(() => null);
const r = order?.receipt;
// Only show the arithmetic when it adds up exactly; otherwise the total alone (never a sum that does not add up).
const addsUp = Boolean(order && r && r.subtotalUgx + r.deliveryFeeUgx === order.totalAmountUgx);
// The price actually charged per unit, so a discounted line reads as it was charged (the list price beneath it).
const chargedUnit = (item: OrderDetailDto['items'][number]) =>
  item.lineTotalUgx !== undefined && item.quantity > 0 ? Math.round(item.lineTotalUgx / item.quantity) : item.unitPriceUgx;
const fmtDate = (iso: string) => new Date(iso).toLocaleString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit', timeZone: 'Africa/Kampala' });
const method = order?.paymentMethod === 'pesapal' ? 'Paid online (Mobile Money or card, via Pesapal)' : order?.paymentMethod === 'offline' ? 'Paid on delivery or at the shop' : 'Paid';
---

<BaseLayout title={order ? `Receipt ${order.orderNumber} | GoldPlus` : 'Receipt | GoldPlus'} description="Your GoldPlus order receipt." robotsMeta="noindex,nofollow">
  <style is:global>
    @media print {
      header, footer, nav, [data-site-chrome], .print\:hidden { display: none !important; }
      body { background: #fff !important; }
    }
  </style>
  <div class="mx-auto max-w-2xl px-4 py-8 sm:py-12 print:p-0">
    {problem ? (
      <section class="rounded-2xl border border-slate-200 bg-white p-6 text-center">
        <h1 class="text-xl font-black text-slate-900">Receipt</h1>
        <p class="mt-2 text-sm text-slate-700">{problem}</p>
        <p class="mt-4 flex justify-center gap-3 text-sm">
          {order && <a class="font-bold underline" href={`/orders/${order.id}`}>Back to the order</a>}
          <a class="font-bold underline" href="/account/orders">My orders</a>
        </p>
      </section>
    ) : order && (
      <article class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-8 print:border-0 print:p-0" data-receipt>
        <div class="flex flex-wrap items-start justify-between gap-4 border-b border-slate-200 pb-5">
          <div>
            <p class="text-2xl font-black tracking-tight text-slate-950">GoldPlus</p>
            {biz?.addressLine1 && <p class="mt-1 text-xs text-slate-600">{biz.addressLine1}</p>}
            {biz?.phoneDisplay && <p class="text-xs text-slate-600">Phone {biz.phoneDisplay} · shopgoldplus.com</p>}
          </div>
          <div class="text-right">
            <h1 class="text-lg font-black text-slate-950">Receipt</h1>
            <p class="text-sm font-bold text-slate-800">{order.orderNumber}</p>
            <p class="text-xs text-slate-600">Ordered {fmtDate(order.createdAt)}</p>
            {r?.paidAt && <p class="text-xs text-slate-600">Paid {fmtDate(r.paidAt)}</p>}
          </div>
        </div>

        <div class="mt-5 grid gap-1 text-sm text-slate-800">
          {r?.customerName && <p><span class="text-slate-500">Customer:</span> {r.customerName}</p>}
          {order.customer.phone && <p><span class="text-slate-500">Phone:</span> {order.customer.phone}</p>}
          {r?.deliveryArea && <p><span class="text-slate-500">Delivery to:</span> {r.deliveryArea}</p>}
          <p><span class="text-slate-500">Payment:</span> {method}</p>
        </div>

        <table class="mt-6 w-full text-sm">
          <thead>
            <tr class="border-b border-slate-300 text-left text-xs uppercase tracking-wide text-slate-500">
              <th class="py-2 font-bold">Item</th>
              <th class="py-2 text-right font-bold">Qty</th>
              <th class="py-2 text-right font-bold">Unit price</th>
              <th class="py-2 text-right font-bold">Amount</th>
            </tr>
          </thead>
          <tbody>
            {order.items.map((item) => (
              <tr class="border-b border-slate-100 align-top">
                <td class="py-2 pr-2 text-slate-900">{item.nameAtPurchase ?? item.productName}{item.sku && <span class="block text-xs text-slate-500">SKU {item.sku}</span>}</td>
                <td class="py-2 text-right tabular-nums">{item.quantity}</td>
                <td class="py-2 text-right tabular-nums">
                  {formatUgx(chargedUnit(item))}
                  {chargedUnit(item) !== item.unitPriceUgx && <span class="block text-xs text-slate-500">was {formatUgx(item.unitPriceUgx)}</span>}
                </td>
                <td class="py-2 text-right tabular-nums">{formatUgx(item.lineTotalUgx ?? item.unitPriceUgx * item.quantity)}</td>
              </tr>
            ))}
          </tbody>
          <tfoot class="text-sm">
            {addsUp && r && (
              <>
                <tr><td colspan="3" class="pt-3 text-right text-slate-600">Items</td><td class="pt-3 text-right tabular-nums">{formatUgx(r.subtotalUgx)}</td></tr>
                <tr><td colspan="3" class="text-right text-slate-600">Delivery</td><td class="text-right tabular-nums">{r.deliveryFeeUgx > 0 ? formatUgx(r.deliveryFeeUgx) : 'Free'}</td></tr>
              </>
            )}
            <tr class="text-base font-black text-slate-950"><td colspan="3" class="pt-2 text-right">Total paid</td><td class="pt-2 text-right tabular-nums">{formatUgx(order.totalAmountUgx)}</td></tr>
            {r && r.discountUgx > 0 && <tr><td colspan="4" class="pt-1 text-right text-xs text-emerald-700">You saved {formatUgx(r.discountUgx)} on this order.</td></tr>}
          </tfoot>
        </table>

        <p class="mt-6 text-xs text-slate-500">This is a receipt for your payment to GoldPlus. It is not a URA EFRIS e-invoice. For questions about this order call {biz?.phoneDisplay ?? 'us'}.</p>

        <div class="mt-6 flex flex-wrap gap-3 print:hidden">
          <button type="button" data-action="print" class="inline-flex min-h-11 items-center rounded-full bg-brand-charcoal px-5 text-sm font-bold text-white hover:bg-black">Print or save as PDF</button>
          <a href={`/orders/${order.id}`} class="inline-flex min-h-11 items-center rounded-full border border-slate-300 px-5 text-sm font-bold text-slate-800">Back to the order</a>
        </div>
      </article>
    )}
  </div>
</BaseLayout>
