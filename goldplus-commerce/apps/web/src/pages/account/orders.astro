---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatUgx } from "../../lib/money";
import AccountNav from '../../components/AccountNav.astro';
import EmptyState from '../../components/EmptyState.astro';
import Notice from '../../components/Notice.astro';
import { apiBase } from '../../lib/api';
import { readSessionToken, SESSION_COOKIE_NAME } from '../../lib/session';
import { offersOnlinePayment } from '@goldplus/shared';
import type { OrderSummaryDto } from '@goldplus/shared';
import { orderStatusCopy, STATUS_TONE_CLASS } from '../../lib/orderStatusCopy';

const token = readSessionToken(Astro.request);
if (!token) {
  return Astro.redirect('/login?returnTo=/account/orders', 303);
}

// "Pay for this order" follows the same rule as the order page's Pay button
// (offersOnlinePayment): nothing writes a pending-payment order status, so the
// old check never showed it, not even for a received order whose online
// payment failed.
let orders: OrderSummaryDto[] = [];
let loadError = '';
try {
  const res = await fetch(`${apiBase}/account/orders`, {
    headers: { Authorization: `Bearer ${token}` },
    signal: AbortSignal.timeout(6000),
  });
  if (res.status === 401) {
    Astro.cookies.delete(SESSION_COOKIE_NAME, { path: '/' });
    return Astro.redirect('/login?returnTo=/account/orders', 303);
  }
  const json: any = await res.json().catch(() => null);
  if (json?.success) orders = json.data ?? [];
  else loadError = json?.error?.message ?? 'Could not load your orders.';
} catch {
  loadError = 'The account service is unreachable right now.';
}

---

<BaseLayout robotsMeta="noindex,follow" title="My orders">
  <div class="container mx-auto px-4 lg:px-8 py-10 lg:py-14">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3 mb-6 pb-6 border-b border-brand-borderGrey">
      <h1 class="text-2xl md:text-3xl font-black text-brand-charcoal tracking-tight">My orders</h1>
      <a href="/logout" class="text-sm font-bold text-brand-mutedGrey hover:text-brand-charcoal">Sign out &rarr;</a>
    </div>

    <AccountNav active="orders" />

    {loadError && <Notice kind="warning" title="We could not load your orders" message="Please try again in a moment. If you need an order urgently, look it up on the track-order page with its reference, or contact us." />}

    {!loadError && (
      orders.length === 0 ? (
        <EmptyState title="No orders yet" message="Orders placed while signed in appear here. Ordered as a guest? Look it up with your order reference.">
          <div class="flex flex-col sm:flex-row gap-3 justify-center">
            <a href="/shop" class="inline-flex items-center justify-center rounded-full bg-brand-charcoal px-5 py-2.5 text-xs font-bold uppercase tracking-wider text-white hover:bg-black">Start shopping</a>
            <a href="/track-order" class="inline-flex items-center justify-center rounded-full border border-brand-borderGrey px-5 py-2.5 text-xs font-bold uppercase tracking-wider text-brand-charcoal hover:bg-brand-softGrey">Find a guest order</a>
          </div>
        </EmptyState>
      ) : (
        <section class="bg-white border border-brand-borderGrey rounded-2xl p-6">
          <ul class="divide-y divide-brand-borderGrey">
            {orders.map((o) => (
              <li class="py-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
                <div class="min-w-0">
                  <a href={`/orders/${o.id}`} class="font-bold text-brand-charcoal hover:underline">{o.orderNumber}</a>
                  <p class="text-xs text-brand-mutedGrey mt-1">
                    {new Date(o.createdAt).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'Africa/Kampala' })} · {o.itemCount} item{o.itemCount === 1 ? '' : 's'}
                  </p>
                </div>
                <div class="flex items-center gap-3">
                  <span class={`inline-flex items-center px-2 py-1 rounded border text-[10px] font-bold uppercase tracking-widest ${STATUS_TONE_CLASS[orderStatusCopy(o.status).tone]}`}>{orderStatusCopy(o.status).label}</span>
                  <span class="font-bold text-brand-charcoal whitespace-nowrap">{formatUgx(o.totalAmountUgx)}</span>
                  {offersOnlinePayment(o) ? (
                    <a href={`/orders/${o.id}#pay`} class="inline-flex items-center rounded-full bg-brand-charcoal px-3 py-1.5 text-xs font-bold text-white hover:bg-black whitespace-nowrap">Pay for this order</a>
                  ) : (
                    <a href={`/orders/${o.id}`} class="text-xs font-bold text-brand-mutedGrey hover:text-brand-charcoal whitespace-nowrap">Details &rarr;</a>
                  )}
                </div>
              </li>
            ))}
          </ul>
        </section>
      )
    )}
  </div>
</BaseLayout>
