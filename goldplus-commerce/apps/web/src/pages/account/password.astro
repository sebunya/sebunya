---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AccountNav from '../../components/AccountNav.astro';
import FormFeedback from '../../components/FormFeedback.astro';
import { apiBase } from '../../lib/api';
import { readSessionToken, clearSessionCookie } from '../../lib/session';
import { checkRequestOrigin, CROSS_SITE_MESSAGE } from '../../lib/requestOrigin';

/**
 * Change password while signed in (POST /account/password). The current
 * password is required. Success signs the account out on every device, this
 * one included, so the page ends at the sign-in form.
 */
const token = readSessionToken(Astro.request);
if (!token) {
  return Astro.redirect('/login?returnTo=/account/password', 303);
}

const MIN_LENGTH = 8;
let status: 'success' | 'error' | null = null;
let message: string | undefined;

if (Astro.request.method === 'POST') {
  const origin = checkRequestOrigin(Astro.request, import.meta.env as unknown as Record<string, string | undefined>);
  const form = await Astro.request.formData().catch(() => null);
  const currentPassword = String(form?.get('currentPassword') ?? '');
  const newPassword = String(form?.get('newPassword') ?? '');
  const confirmPassword = String(form?.get('confirmPassword') ?? '');
  status = 'error';
  if (!origin.allowed) {
    message = CROSS_SITE_MESSAGE;
  } else if (!currentPassword || !newPassword) {
    message = 'Enter your current password and a new one.';
  } else if (newPassword.length < MIN_LENGTH) {
    message = `The new password must be at least ${MIN_LENGTH} characters.`;
  } else if (newPassword !== confirmPassword) {
    message = 'The two new passwords do not match.';
  } else {
    try {
      const res = await fetch(`${apiBase}/account/password`, {
        method: 'POST',
        headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' },
        signal: AbortSignal.timeout(8000),
        body: JSON.stringify({ currentPassword, newPassword }),
      });
      const json = await res.json().catch(() => null);
      if (res.ok && json?.success) {
        return new Response(null, {
          status: 303,
          headers: { Location: '/login?passwordChanged=1', 'Set-Cookie': clearSessionCookie() },
        });
      }
      if (res.status === 401) return Astro.redirect('/login?returnTo=/account/password', 303);
      message = typeof json?.error?.message === 'string' && json.error.message.length < 200
        ? json.error.message
        : 'Your password was not changed. Please try again.';
    } catch {
      message = 'We could not reach our servers. Your password was not changed. Please try again.';
    }
  }
}
---

<BaseLayout robotsMeta="noindex,nofollow" title="Change password">
  <div class="container mx-auto px-4 lg:px-8 py-10 max-w-3xl">
    <header class="mb-8">
      <h1 class="text-2xl md:text-3xl font-black text-brand-charcoal tracking-tight">Change password</h1>
      <p class="mt-2 text-sm text-brand-mutedGrey">Changing your password signs you out on every device, including this one. You will sign in again with the new password.</p>
    </header>

    <AccountNav active="password" />

    <FormFeedback status={status} message={message} />

    <form method="POST" class="bg-white border border-brand-borderGrey rounded-2xl p-6 space-y-5">
      <div>
        <label for="currentPassword" class="block text-sm font-bold text-brand-charcoal mb-1">Current password</label>
        <input id="currentPassword" name="currentPassword" type="password" required autocomplete="current-password"
          class="w-full rounded-xl border border-brand-borderGrey px-4 py-3 text-base focus:border-brand-charcoal focus:outline-none" />
      </div>
      <div>
        <label for="newPassword" class="block text-sm font-bold text-brand-charcoal mb-1">New password</label>
        <input id="newPassword" name="newPassword" type="password" required minlength={MIN_LENGTH} maxlength="200" autocomplete="new-password" aria-describedby="newPassword-hint"
          class="w-full rounded-xl border border-brand-borderGrey px-4 py-3 text-base focus:border-brand-charcoal focus:outline-none" />
        <p id="newPassword-hint" class="mt-1 text-xs text-brand-mutedGrey">At least {MIN_LENGTH} characters, and different from your current password.</p>
      </div>
      <div>
        <label for="confirmPassword" class="block text-sm font-bold text-brand-charcoal mb-1">New password again</label>
        <input id="confirmPassword" name="confirmPassword" type="password" required minlength={MIN_LENGTH} maxlength="200" autocomplete="new-password"
          class="w-full rounded-xl border border-brand-borderGrey px-4 py-3 text-base focus:border-brand-charcoal focus:outline-none" />
      </div>
      <div class="flex flex-wrap items-center gap-4">
        <button type="submit" class="inline-flex items-center justify-center rounded-full bg-brand-charcoal px-6 py-3 text-xs font-bold uppercase tracking-wider text-white hover:opacity-90">Change password</button>
        <a href="/forgot-password" class="text-sm font-bold text-brand-mutedGrey underline hover:text-brand-charcoal">Forgot your current password?</a>
      </div>
    </form>
  </div>
</BaseLayout>
