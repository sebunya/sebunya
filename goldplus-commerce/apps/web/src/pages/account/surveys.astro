---
import BaseLayout from '../../layouts/BaseLayout.astro'; import { apiBase } from '../../lib/api'; import { readSessionToken } from '../../lib/session';
const token = readSessionToken(Astro.request); if (!token) return Astro.redirect('/login?returnTo=/account/surveys', 303); const headers = { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' }; let notice = '';
let surveys: any[] = []; try { const response = await fetch(`${apiBase}/account/surveys`, { headers }); const body = await response.json().catch(() => null); surveys = body?.success ? body.data : []; } catch { notice = 'Surveys are temporarily unavailable. No response was saved.'; }
if (Astro.request.method === 'POST') { const form = await Astro.request.formData(); const definitionId = String(form.get('definitionId') ?? ''); const selected = surveys.find((item) => item.definition.id === definitionId); if (selected) { const answers: Record<string, unknown> = {}; for (const question of selected.version.questions) { const values = form.getAll(`q:${question.key}`).map(String); answers[question.key] = question.type === 'MULTI_CHOICE' ? values : question.type === 'SCALE' ? Number(values[0]) : values[0]; } try { const startResponse = await fetch(`${apiBase}/account/surveys/${definitionId}/start`, { method: 'POST', headers }); const startBody = await startResponse.json(); if (!startBody?.success) throw new Error(startBody?.error?.message ?? 'Survey could not start.'); const saveResponse = await fetch(`${apiBase}/account/surveys/responses/${startBody.data.id}`, { method: 'PUT', headers, body: JSON.stringify({ expectedVersion: startBody.data.version, answers }) }); const saveBody = await saveResponse.json(); if (!saveBody?.success) throw new Error(saveBody?.error?.message ?? 'Answers were not saved.'); const completeResponse = await fetch(`${apiBase}/account/surveys/responses/${startBody.data.id}/complete`, { method: 'POST', headers, body: JSON.stringify({ expectedVersion: saveBody.data.version }) }); const completeBody = await completeResponse.json(); if (!completeBody?.success) throw new Error(completeBody?.error?.message ?? 'Response was not completed.'); notice = 'Thank you. Your response was recorded without contact details.'; surveys = surveys.filter((item) => item.definition.id !== definitionId); } catch (error) { notice = error instanceof Error ? error.message : 'No response was saved.'; } } }
---
<BaseLayout robotsMeta="noindex,follow" title="Surveys | GoldPlus"><main class="container mx-auto px-6 py-10 max-w-4xl"><h1 class="text-3xl font-black">A few questions</h1><p class="text-sm text-gray-600 mb-6">Short questions we sometimes ask to make the shop better. Answering is optional, and we never ask for contact details.</p>{notice && <div class="border rounded-xl p-4 mb-5" aria-live="polite">{notice}</div>}{surveys.length === 0 && <div class="bg-white border rounded-2xl p-8 text-center text-gray-500">Nothing to answer right now. <a href="/shop" class="font-bold underline">Back to the shop</a></div>}{surveys.map((item) => <form method="POST" class="bg-white border rounded-2xl p-6 mb-5 space-y-5"><input type="hidden" name="definitionId" value={item.definition.id}/><h2 class="text-xl font-black">{item.version.title}</h2><p>{item.version.description}</p>{item.version.questions.map((question) => <fieldset class="border-t pt-4"><legend class="font-bold">{question.prompt}{question.required ? ' *' : ''}</legend>{question.type === 'SCALE' ? <input name={`q:${question.key}`} type="number" min={question.min} max={question.max} required={question.required} class="border rounded p-2 mt-2"/> : question.options.map((option) => <label class="block mt-2"><input name={`q:${question.key}`} type={question.type === 'MULTI_CHOICE' ? 'checkbox' : 'radio'} value={option} required={question.required && question.type === 'SINGLE_CHOICE'}/> {option}</label>)}</fieldset>)}<button class="bg-brand-gold font-black rounded-xl px-5 py-3">Submit response</button></form>)}</main></BaseLayout>
