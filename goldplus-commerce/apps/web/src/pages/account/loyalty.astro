---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AccountNav from '../../components/AccountNav.astro';
import EmptyState from '../../components/EmptyState.astro';
import Notice from '../../components/Notice.astro';
import { apiBase } from '../../lib/api';
import { readSessionToken, SESSION_COOKIE_NAME } from '../../lib/session';

const token = readSessionToken(Astro.request);
if (!token) {
  return Astro.redirect('/login?returnTo=/account/loyalty', 303);
}

let history: any = null;
let programme: any = null;
let gamification: any = null;
let referral: any = null;
let loadError = '';
try {
  const authed = { headers: { Authorization: `Bearer ${token}` }, signal: AbortSignal.timeout(6000) };
  const [historyRes, programmeRes, gamificationRes, referralRes] = await Promise.all([
    fetch(`${apiBase}/account/loyalty`, authed),
    fetch(`${apiBase}/commerce/loyalty-programme`, { signal: AbortSignal.timeout(4000) }),
    // 0087: badges + mission progress and the referral card. Neither is
    // load-bearing for the balance, so both fail quietly.
    fetch(`${apiBase}/account/gamification`, authed).catch(() => null),
    fetch(`${apiBase}/account/referral`, authed).catch(() => null),
  ]);
  if (historyRes.status === 401) {
    Astro.cookies.delete(SESSION_COOKIE_NAME, { path: '/' });
    return Astro.redirect('/login?returnTo=/account/loyalty', 303);
  }
  const historyJson: any = await historyRes.json().catch(() => null);
  const programmeJson: any = await programmeRes.json().catch(() => null);
  if (historyJson?.success) history = historyJson.data;
  else loadError = historyJson?.error?.message ?? 'Could not load your points.';
  if (programmeJson?.success) programme = programmeJson.data;
  const gamificationJson: any = gamificationRes ? await gamificationRes.json().catch(() => null) : null;
  if (gamificationJson?.success) gamification = gamificationJson.data;
  const referralJson: any = referralRes ? await referralRes.json().catch(() => null) : null;
  if (referralJson?.success && referralJson.data?.active) referral = referralJson.data;
} catch {
  loadError = 'The loyalty service is unreachable right now.';
}

const shareUrl = referral ? `https://shopgoldplus.com/register?ref=${referral.code}` : '';

const typeLabel: Record<string, string> = {
  earn: 'Earned',
  redeem: 'Redeemed',
  reversal: 'Reversed',
  expiry: 'Expired',
  adjustment: 'Adjustment',
};
const typeTone: Record<string, string> = {
  earn: 'text-green-700',
  redeem: 'text-blue-700',
  reversal: 'text-red-700',
  expiry: 'text-gray-500',
  adjustment: 'text-brand-charcoal',
};
const formatDate = (iso: string) => new Date(iso).toLocaleDateString('en-GB');
---

<BaseLayout robotsMeta="noindex,follow" title="GoldPlus points">
  <div class="container mx-auto px-4 lg:px-8 py-10 lg:py-14">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3 mb-6 pb-6 border-b border-brand-borderGrey">
      <h1 class="text-2xl md:text-3xl font-black text-brand-charcoal tracking-tight">GoldPlus points</h1>
      <a href="/logout" class="text-sm font-bold text-brand-mutedGrey hover:text-brand-charcoal">Sign out &rarr;</a>
    </div>

    <AccountNav active="loyalty" />

    {loadError && <Notice kind="not-configured" title="Points unavailable" message={loadError} />}

    {history && !history.programmeActive && (
      <Notice kind="not-configured" title="Programme not active" message="The loyalty programme is not running right now. Any points shown below keep their history and become usable if it is reactivated." />
    )}

    {history && (
      <div class="space-y-6">
        <div class="grid grid-cols-2 md:grid-cols-5 gap-4">
          <div class="bg-white border border-brand-borderGrey rounded-2xl p-5">
            <p class="text-xs font-bold uppercase tracking-widest text-brand-mutedGrey">Available</p>
            <p class="text-2xl font-black text-brand-charcoal mt-1">{history.balance.available.toLocaleString('en-UG')}</p>
          </div>
          <div class="bg-white border border-brand-borderGrey rounded-2xl p-5">
            <p class="text-xs font-bold uppercase tracking-widest text-brand-mutedGrey">Pending</p>
            <p class="text-2xl font-black text-brand-charcoal mt-1">{Number((history as any).pendingPoints ?? 0).toLocaleString('en-UG')}</p>
            <p class="text-[10px] text-brand-mutedGrey mt-0.5">available on delivery</p>
          </div>
          <div class="bg-white border border-brand-borderGrey rounded-2xl p-5">
            <p class="text-xs font-bold uppercase tracking-widest text-brand-mutedGrey">Lifetime earned</p>
            <p class="text-2xl font-black text-brand-charcoal mt-1">{history.balance.lifetimeEarned.toLocaleString('en-UG')}</p>
          </div>
          <div class="bg-white border border-brand-borderGrey rounded-2xl p-5">
            <p class="text-xs font-bold uppercase tracking-widest text-brand-mutedGrey">Lifetime redeemed</p>
            <p class="text-2xl font-black text-brand-charcoal mt-1">{history.balance.lifetimeRedeemed.toLocaleString('en-UG')}</p>
          </div>
          <div class="bg-white border border-brand-borderGrey rounded-2xl p-5">
            <p class="text-xs font-bold uppercase tracking-widest text-brand-mutedGrey">Pending expiry</p>
            <p class="text-2xl font-black text-brand-charcoal mt-1">{history.balance.pendingExpiry.toLocaleString('en-UG')}</p>
          </div>
        </div>

        {programme?.active && (
          <div class="rounded-2xl border border-amber-200/70 bg-amber-50 px-5 py-4">
            <p class="text-sm font-bold text-amber-900">How earning works</p>
            <p class="text-xs text-amber-800 mt-1 leading-relaxed">
              Every order earns <strong>{programme.earnRatePer1000Ugx} points per 1,000 UGX</strong> of the order total. Points move from pending to available when the order is delivered.
              Points expire <strong>{programme.expiryDays} days</strong> after they are earned. Orders must be placed while
              signed in to earn. Guest orders cannot be credited to an account.
            </p>
          </div>
        )}

        {referral && (
          <section class="bg-white border border-brand-borderGrey rounded-2xl p-6" data-referral-card>
            <h2 class="text-xs font-bold uppercase tracking-widest text-brand-mutedGrey mb-3">Introduce a friend</h2>
            <p class="text-sm text-brand-charcoal leading-relaxed">
              Share your code. You earn <strong>{referral.referrerPoints.toLocaleString('en-UG')} points</strong> when their first
              order is delivered{referral.refereePoints ? <>, and they start with <strong>{referral.refereePoints.toLocaleString('en-UG')} points</strong></> : null}.
              Nothing is paid before that delivery.
            </p>
            <div class="mt-4 flex flex-wrap items-center gap-3">
              <code class="rounded-xl border border-brand-borderGrey bg-gray-50 px-4 py-2.5 text-base font-black tracking-widest text-brand-charcoal" data-referral-code>{referral.code}</code>
              <button type="button" class="min-h-11 rounded-full bg-brand-charcoal px-5 py-2.5 text-xs font-black uppercase tracking-wider text-white" data-copy-referral data-share-url={shareUrl}>Copy invite link</button>
              <a class="min-h-11 inline-flex items-center rounded-full border border-brand-borderGrey px-5 py-2.5 text-xs font-black uppercase tracking-wider text-brand-charcoal" href={`https://wa.me/?text=${encodeURIComponent(`Get genuine electronics from GoldPlus. Use my code ${referral.code} when you sign up: ${shareUrl}`)}`} target="_blank" rel="noopener noreferrer">Share on WhatsApp</a>
              <span class="text-xs text-brand-mutedGrey" data-copy-status role="status" aria-live="polite"></span>
            </div>
            <p class="mt-3 text-xs text-brand-mutedGrey">
              {referral.referred.toLocaleString('en-UG')} signed up with your code · {referral.awarded.toLocaleString('en-UG')} delivered and paid out · {referral.pending.toLocaleString('en-UG')} waiting on a first delivery.
            </p>
          </section>
        )}

        {gamification?.badges?.length > 0 && (
          <section class="bg-white border border-brand-borderGrey rounded-2xl p-6">
            <h2 class="text-xs font-bold uppercase tracking-widest text-brand-mutedGrey mb-3">Your badges</h2>
            <div class="flex flex-wrap gap-2">
              {gamification.badges.map((b: any) => (
                <span class="rounded-full border border-brand-primary/40 bg-brand-primary/10 px-4 py-2 text-xs font-black uppercase tracking-wider text-brand-charcoal" title={b.description ?? ''}>{b.title}</span>
              ))}
            </div>
            <a href="/account/rewards" class="mt-4 inline-block text-sm font-bold text-brand-charcoal underline underline-offset-4">Missions and progress &rarr;</a>
          </section>
        )}

        <section class="bg-white border border-brand-borderGrey rounded-2xl p-6">
          <h2 class="text-xs font-bold uppercase tracking-widest text-brand-mutedGrey mb-3">Points history</h2>
          {history.entries.length === 0 ? (
            <EmptyState title="No points activity yet" message="Place an order while signed in. Points are credited when the order is paid." />
          ) : (
            <div class="overflow-x-auto">
              <table class="w-full text-sm">
                <thead>
                  <tr class="text-left text-[10px] font-bold uppercase tracking-widest text-brand-mutedGrey border-b border-brand-borderGrey">
                    <th class="py-2 pr-4">Date</th>
                    <th class="py-2 pr-4">Activity</th>
                    <th class="py-2 pr-4">Points</th>
                    <th class="py-2 pr-4">Expires</th>
                    <th class="py-2">Detail</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-brand-borderGrey">
                  {history.entries.map((e: any) => (
                    <tr>
                      <td class="py-2.5 pr-4 whitespace-nowrap text-brand-mutedGrey">{formatDate(e.createdAt)}</td>
                      <td class={`py-2.5 pr-4 font-bold ${typeTone[e.type] ?? 'text-brand-charcoal'}`}>{typeLabel[e.type] ?? e.type}</td>
                      <td class="py-2.5 pr-4 font-bold text-brand-charcoal whitespace-nowrap">{e.points > 0 ? `+${e.points.toLocaleString('en-UG')}` : e.points.toLocaleString('en-UG')}</td>
                      <td class="py-2.5 pr-4 whitespace-nowrap text-brand-mutedGrey">{e.expiresAt ? formatDate(e.expiresAt) : '—'}</td>
                      <td class="py-2.5 text-brand-mutedGrey">{e.reason}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </section>
      </div>
    )}
  </div>

  {/* Referral copy — plain progressive enhancement, no framework (single-digit KB budget). */}
  <script is:inline>
    (function () {
      var btn = document.querySelector('[data-copy-referral]');
      if (!btn) return;
      var status = document.querySelector('[data-copy-status]');
      btn.addEventListener('click', function () {
        var url = btn.getAttribute('data-share-url') || '';
        var done = function (msg) {
          if (status) {
            status.textContent = msg;
            setTimeout(function () { status.textContent = ''; }, 4000);
          }
        };
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(url).then(function () { done('Invite link copied.'); }, function () { done(url); });
        } else {
          done(url);
        }
      });
    })();
  </script>
</BaseLayout>
