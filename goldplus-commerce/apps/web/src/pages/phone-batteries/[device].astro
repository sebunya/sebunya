---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CheckYourPhoneNote from '../../components/CheckYourPhoneNote.astro';
import { SITE_ORIGIN } from '../../lib/sitemap';
import { getBusinessInfo } from '../../lib/businessInfo';
import { serializeJsonLd, breadcrumbJsonLd } from '../../lib/jsonld';
import { publicBattery, DEVICE_COOKIE, serialiseDeviceCookie, ugx, FIT_BADGE } from '../../lib/batteries';
import {
  isDeviceSlug, phoneBatteryPath, phonePageIndexable, phonePageTitle, phonePageH1, phonePageDescription, phoneGuides, phonePageItemListJsonLd,
} from '../../lib/phoneBatteryPage';
import type { BatteryFinderConfig, FinderBatteryResultDto, FinderDeviceDto, FinderFitIndexDto } from '@goldplus/shared';

/**
 * One phone, the batteries that fit it, and how to be sure before ordering.
 * The indexable answer to "<phone> battery" (organic programme 2026-10-28,
 * docs/growth/README.md). Everything shown comes from the finder's own
 * answer for this device: no fit, price or capacity is stated that the
 * catalogue does not hold. record=0: a page view is not a customer choosing
 * a phone in the finder; the browser sends RESULT_VIEWED instead, which is
 * what the demand report's funnel reads.
 */
const slug = (Astro.params.device ?? '').trim();
if (!isDeviceSlug(slug)) return Astro.redirect('/404', 404);

const [deviceRes, indexRes, biz] = await Promise.all([
  publicBattery<{ device: FinderDeviceDto; results: FinderBatteryResultDto[]; config: BatteryFinderConfig }>(`/finder/devices/${encodeURIComponent(slug)}?record=0`),
  publicBattery<FinderFitIndexDto>('/finder/fit-index'),
  getBusinessInfo(),
]);

if (!deviceRes.ok && deviceRes.status === 404) return Astro.redirect('/404', 404);
const unavailable = !deviceRes.ok;
const device = deviceRes.ok ? deviceRes.data.device : null;
const results = deviceRes.ok ? deviceRes.data.results : [];
const cfg = deviceRes.ok ? deviceRes.data.config : null;
if (unavailable) Astro.response.status = 503;

// Same cookie the finder sets: the product page then shows "Buying for your <phone>".
if (device) {
  Astro.cookies.set(DEVICE_COOKIE, serialiseDeviceCookie({ slug: device.slug, label: device.label }), {
    path: '/', httpOnly: false, sameSite: 'lax', secure: Astro.url.protocol === 'https:', maxAge: 60 * 60 * 24 * 30,
  });
}

const canonicalUrl = `${SITE_ORIGIN}${phoneBatteryPath(slug)}`;
const indexable = !!device && phonePageIndexable(results);
const robotsMeta = indexable ? undefined : 'noindex,follow';
const title = device ? phonePageTitle(device) : 'Phone battery | GoldPlus';
const h1 = device ? phonePageH1(device) : 'Replacement phone battery';
const description = device ? phonePageDescription(device, results) : 'Find the replacement battery for your phone at GoldPlus, Kampala.';

const allAwaiting = results.length > 0 && results.every((r) => r.fitState === 'AWAITING_VERIFICATION');
const anyVerified = results.some((r) => r.fitState === 'VERIFIED_IN_STOCK' || r.fitState === 'VERIFIED_OUT_OF_STOCK');
const guides = device ? phoneGuides(device.brandName) : [];
const waHref = (text: string) => `${biz.whatsappUrl}?text=${encodeURIComponent(text)}`;
const waText = `${cfg?.whatsappPrefill ?? 'Hello GoldPlus, I need a battery for my '}${device?.label ?? ''}`;
const cutoff = `${biz.sameDayCutoffHour % 12 || 12}${biz.sameDayCutoffHour >= 12 ? 'pm' : 'am'}`;

// Other phones of the same brand that have a battery: the brand's own index, one hop away.
const siblings = device && indexRes.ok
  ? (indexRes.data.brands.find((b) => b.name.toLowerCase() === device.brandName.toLowerCase())?.devices ?? []).filter((d) => d.slug !== device.slug).slice(0, 24)
  : [];

const crumbs = [
  { name: 'Home', url: `${SITE_ORIGIN}/` },
  { name: 'Phone batteries', url: `${SITE_ORIGIN}/phone-batteries` },
  ...(device ? [{ name: device.label, url: canonicalUrl }] : []),
];
const brandName = device?.brandName ?? '';
---

<BaseLayout title={title} description={description} canonicalUrl={canonicalUrl} robotsMeta={robotsMeta}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={serializeJsonLd(breadcrumbJsonLd(crumbs))} />
    {device && results.length > 0 && <script type="application/ld+json" set:html={serializeJsonLd(phonePageItemListJsonLd(device, results))} />}
  </Fragment>

  <div class="container mx-auto px-4 py-8 sm:py-10 max-w-4xl" data-phone-page data-device-slug={device?.slug ?? ''} data-outcome={results[0]?.fitState ?? 'NO_RESULT'}>
    <nav aria-label="Breadcrumb" class="text-xs font-semibold text-slate-500">
      <a href="/" class="hover:text-brand-dark">Home</a>
      <span aria-hidden="true"> / </span>
      <a href="/phone-batteries" class="hover:text-brand-dark">Phone batteries</a>
      {device && (<><span aria-hidden="true"> / </span><span class="text-slate-800">{device.label}</span></>)}
    </nav>

    <h1 class="mt-3 text-2xl sm:text-3xl font-black text-brand-dark tracking-tight">{h1}</h1>

    {unavailable && (
      <div role="status" class="mt-6 rounded-xl border border-dashed border-gray-300 bg-gray-50 p-6 text-sm text-gray-600">
        The battery finder is temporarily unavailable. <a href={waHref(waText)} class="font-bold underline">Message us on WhatsApp</a> with your phone model and we will check the fit for you.
      </div>
    )}

    {device && (
      <>
        {device.modelNumber && (
          <p class="mt-2 text-sm text-slate-600">Model number <span class="font-mono font-bold text-slate-800">{device.modelNumber}</span>{device.variant ? ` · ${device.variant}` : ''}. Check yours in Settings, under About phone, before you order.</p>
        )}

        {results.length > 0 ? (
          <section class="mt-6" aria-labelledby="fits-heading">
            <h2 id="fits-heading" class="text-lg font-black text-brand-dark">{results.length === 1 ? 'The battery that fits' : `${results.length} batteries that fit`}</h2>
            <p class="mt-1 text-sm text-slate-600">
              {allAwaiting
                ? "Listed for this phone in our supplier's compatibility list. Compare the pack code with the code on your old battery, or message us and we confirm it before you order."
                : anyVerified
                  ? 'Checked against this phone by GoldPlus. Compare the pack code with the code on your old battery if you can see it.'
                  : 'Read the condition on each battery before you order.'}
            </p>
            <div class="mt-4 space-y-3">
              {results.map((r) => (
                <article class="rounded-2xl border border-gray-200 bg-white p-5 flex flex-wrap items-center gap-4">
                  {r.imageUrl && <img src={r.imageUrl} alt={r.name} width="72" height="72" loading="lazy" class="rounded-xl object-cover" />}
                  <div class="flex-1 min-w-[200px]">
                    <h3 class="font-black text-brand-dark">{r.name}</h3>
                    <p class="text-xs text-gray-500 mt-1">Pack code <span class="font-mono">{r.canonicalCode}</span>{r.capacityMah ? ` · ${r.capacityMah} mAh` : ''}{r.nominalVoltageMv ? ` · ${(r.nominalVoltageMv / 1000).toFixed(2)} V` : ''}</p>
                    <span class={`inline-block mt-2 rounded-full border px-3 py-1 text-[11px] font-bold ${FIT_BADGE[r.fitState] ?? ''}`}>{r.fitLabel}</span>
                    {r.fitState === 'CONDITIONAL' && r.condition && <p class="mt-2 text-xs text-amber-900">{cfg?.conditionalNote} {r.condition}</p>}
                    {r.fitState === 'VERIFIED_OUT_OF_STOCK' && <p class="mt-2 text-xs text-gray-600">{cfg?.outOfStockNote}</p>}
                  </div>
                  <div class="text-right">
                    {r.regularPriceUgx != null && <p class="text-xs font-semibold text-slate-600 line-through tabular-nums"><span class="sr-only">Was </span>{ugx(r.regularPriceUgx)}</p>}
                    <p class="font-black text-brand-dark">{r.regularPriceUgx != null && <span class="sr-only">Now </span>}{ugx(r.priceUgx)}</p>
                    <a href={`/products/${r.slug}?device=${encodeURIComponent(device.slug)}`} data-fit-product={r.productId} class="mt-2 inline-block rounded-xl bg-brand-dark px-4 py-2 text-sm font-bold text-white hover:opacity-90">View and buy</a>
                  </div>
                </article>
              ))}
            </div>
          </section>
        ) : (
          <section class="mt-6 rounded-xl border border-amber-200 bg-amber-50 p-5" role="status">
            <h2 class="font-bold text-amber-900">{cfg?.noResultHeadline ?? 'We have not matched a battery to this phone yet'}</h2>
            <p class="mt-1 text-sm text-amber-900">{cfg?.noResultBody}</p>
            <div class="mt-4 flex flex-wrap gap-3">
              <a href={`/battery-finder?device=${encodeURIComponent(device.slug)}&help=1#request-heading`} class="rounded-xl bg-brand-dark px-5 py-2.5 text-sm font-bold text-white hover:opacity-90">Ask us to find this battery</a>
              <a href={waHref(waText)} class="rounded-xl border border-amber-300 bg-white px-5 py-2.5 text-sm font-bold text-brand-dark hover:border-brand-primary">Send a photo on WhatsApp</a>
            </div>
          </section>
        )}

        <section class="mt-8" aria-labelledby="sure-heading">
          <h2 id="sure-heading" class="text-lg font-black text-brand-dark">Be sure before you order</h2>
          <ol class="mt-3 space-y-3 text-sm text-slate-700">
            <li class="rounded-xl border border-slate-200 bg-white p-4"><span class="font-bold text-slate-900">1. Check the exact model number.</span> {cfg?.modelNumberHelp} One phone name can cover more than one version.</li>
            <li class="rounded-xl border border-slate-200 bg-white p-4"><span class="font-bold text-slate-900">2. Compare the pack code, if you can see it.</span> On a phone with a removable back, the code is printed on the old battery. The code decides the fit; shape, size and mAh alone do not. Never open a sealed phone or remove a swollen battery to find it.</li>
            <li class="rounded-xl border border-slate-200 bg-white p-4"><span class="font-bold text-slate-900">3. Not sure? Ask first.</span> <a href={waHref(waText)} class="font-bold underline">Message us on WhatsApp</a> with the model number or a photo of the old battery's label, and we confirm the right battery before you order.</li>
          </ol>
          <CheckYourPhoneNote class="mt-4" />
        </section>

        <section class="mt-8 rounded-2xl border border-slate-200 bg-slate-50 p-5" aria-labelledby="buying-heading">
          <h2 id="buying-heading" class="text-base font-black text-brand-dark">Buying from GoldPlus</h2>
          <ul class="mt-3 grid gap-2 text-sm text-slate-700 sm:grid-cols-2">
            <li><span class="font-bold text-slate-900">Delivery:</span> {biz.deliveryNote} Order before {cutoff} on a delivery day ({biz.openDays}) and it goes out on that day's run; the fee and the window are shown before you pay. <a href="/delivery/kampala-wakiso" class="font-bold underline">Delivery details</a></li>
            <li><span class="font-bold text-slate-900">Collect:</span> from the GoldPlus shop, 4th floor, Zainab Aziza Building, Burton Street, Kampala. <a href="/locations/zainab-aziza" class="font-bold underline">Shop details</a></li>
            <li><span class="font-bold text-slate-900">Returns:</span> 14 days to change your mind; a faulty battery is replaced or refunded at our cost. <a href="/returns" class="font-bold underline">Returns</a> · <a href="/warranty" class="font-bold underline">Warranty</a></li>
            <li><span class="font-bold text-slate-900">Genuine GoldPlus:</span> every pack carries a hologram code you can <a href="/verification" class="font-bold underline">check on this site</a>.</li>
          </ul>
        </section>

        <section class="mt-8" aria-labelledby="faq-heading">
          <h2 id="faq-heading" class="text-lg font-black text-brand-dark">Common questions</h2>
          <div class="mt-3 space-y-3">
            <details class="rounded-2xl border border-slate-200 bg-white p-5">
              <summary class="cursor-pointer text-sm font-black text-slate-900">Is this an original {brandName} battery?</summary>
              <p class="mt-2 text-sm leading-relaxed text-slate-600">No. GoldPlus sells GoldPlus-branded replacement batteries, not batteries made by {brandName}. The pack code on the listing is the reference that matches it to the {device.label}; the fit comes from our own checks or from our supplier's compatibility list, and each battery says which.</p>
            </details>
            <details class="rounded-2xl border border-slate-200 bg-white p-5">
              <summary class="cursor-pointer text-sm font-black text-slate-900">My phone is a different version of the {device.model}. Will it still fit?</summary>
              <p class="mt-2 text-sm leading-relaxed text-slate-600">Not necessarily. Phone makers sometimes change the battery between versions of the same name, so match the model number{device.modelNumber ? ` (this page is for ${device.modelNumber})` : ''} or the pack code, or ask us before you order.</p>
            </details>
            <details class="rounded-2xl border border-slate-200 bg-white p-5">
              <summary class="cursor-pointer text-sm font-black text-slate-900">Can you confirm the fit before I pay?</summary>
              <p class="mt-2 text-sm leading-relaxed text-slate-600">Yes, if you ask. Send the model number or a photo of the old battery's label on <a href={waHref(waText)} class="font-bold underline">WhatsApp</a> and we confirm the right battery before you order. If you order without asking, the 14-day return still applies.</p>
            </details>
            <details class="rounded-2xl border border-slate-200 bg-white p-5">
              <summary class="cursor-pointer text-sm font-black text-slate-900">Do you fit the battery?</summary>
              <p class="mt-2 text-sm leading-relaxed text-slate-600">We sell the battery. A phone with a sealed back should be opened by a technician; a phone with a removable back you can usually do yourself. Never use or charge a swollen battery.</p>
            </details>
          </div>
        </section>

        {guides.length > 0 && (
          <section class="mt-8" aria-labelledby="guides-heading">
            <h2 id="guides-heading" class="text-base font-black text-brand-dark">Read before you choose</h2>
            <div class="mt-3 flex flex-wrap gap-2">
              {guides.map((g) => (
                <a href={g.href} class="rounded-full border border-slate-300 bg-white px-4 py-2 text-sm font-bold text-slate-700 hover:border-brand-primary">{g.label}</a>
              ))}
            </div>
          </section>
        )}

        <section class="mt-8" aria-labelledby="more-heading">
          <h2 id="more-heading" class="text-base font-black text-brand-dark">{siblings.length > 0 ? `Other ${brandName} phones we have batteries for` : 'Find a battery for another phone'}</h2>
          {siblings.length > 0 && (
            <ul class="mt-3 flex flex-wrap gap-2">
              {siblings.map((d) => (
                <li><a href={phoneBatteryPath(d.slug)} class="inline-block rounded-full border border-gray-300 px-4 py-2 text-sm font-bold text-brand-dark hover:border-brand-primary">{d.model}{d.modelNumber ? ` (${d.modelNumber})` : ''}</a></li>
              ))}
            </ul>
          )}
          <div class="mt-3 flex flex-wrap gap-3 text-sm font-bold">
            <a href="/battery-finder" class="rounded-full bg-slate-950 px-5 py-2.5 text-white hover:bg-brand-primary hover:text-slate-950">Search by phone or battery code</a>
            <a href="/phone-batteries" class="rounded-full border border-slate-300 bg-white px-5 py-2.5 text-slate-800 hover:border-brand-primary">All phone batteries</a>
          </div>
        </section>
      </>
    )}
  </div>
</BaseLayout>

<script>
  import { sendFinderEvent } from '../../lib/finderEvents';
  const root = document.querySelector<HTMLElement>('[data-phone-page]');
  const deviceSlug = root?.dataset.deviceSlug || null;
  if (root && deviceSlug) {
    sendFinderEvent({ eventType: 'RESULT_VIEWED', mode: 'FIND_BY_PHONE', deviceSlug, outcome: root.dataset.outcome || null });
    for (const a of root.querySelectorAll<HTMLAnchorElement>('a[data-fit-product]')) {
      a.addEventListener('click', () => sendFinderEvent({ eventType: 'PRODUCT_VIEWED', mode: 'FIND_BY_PHONE', deviceSlug, productId: a.dataset.fitProduct || null }));
    }
  }
</script>
