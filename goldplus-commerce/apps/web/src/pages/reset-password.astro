---
import BaseLayout from '../layouts/BaseLayout.astro';
import FormField from '../components/FormField.astro';
import FormFeedback from '../components/FormFeedback.astro';
import { apiBase } from '../lib/api';

/**
 * Set a new password from a reset link (0106).
 *
 * The token arrives in the query string, is carried through the form as a
 * hidden field, and is POSTed from the SERVER — it never reaches client-side
 * JavaScript and is never put anywhere it could be logged.
 *
 * A used or expired link says so plainly and offers a new one, rather than
 * failing with something the customer cannot act on.
 */

const token = Astro.url.searchParams.get('token') ?? '';

let status: 'success' | 'error' | null = null;
let message = '';
let done = false;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const submittedToken = String(form.get('token') ?? '');
  const password = String(form.get('password') ?? '');
  const confirm = String(form.get('confirmPassword') ?? '');

  if (password !== confirm) {
    status = 'error';
    message = 'The two passwords do not match.';
  } else {
    try {
      const res = await fetch(`${apiBase}/auth/password/reset`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ token: submittedToken, password }),
      });
      const json = await res.json().catch(() => null);
      if (json?.success) {
        status = 'success';
        done = true;
        message = json.data?.message ?? 'Your password has been changed.';
      } else {
        status = 'error';
        message = json?.error?.message ?? 'This reset link is not valid. Request a new one.';
      }
    } catch {
      status = 'error';
      message = 'We could not reach the server. Please try again shortly.';
    }
  }
}

const missingToken = !token && Astro.request.method !== 'POST';
---

<BaseLayout robotsMeta="noindex,follow" title="Set a new password" description="Choose a new password for your GoldPlus account.">
  <div class="min-h-[60vh] flex items-center justify-center bg-slate-50 py-16 px-6">
    <div class="w-full max-w-md">
      <h1 class="text-2xl font-black tracking-tight text-brand-charcoal mb-2">Set a new password</h1>

      {missingToken ? (
        <div class="bg-white p-8 rounded-2xl border border-slate-200/80 shadow-xs">
          <p class="text-sm text-slate-600 leading-relaxed">
            This page only works from a reset link. Request one, or contact us if you are stuck.
          </p>
          <div class="mt-5 flex flex-col sm:flex-row gap-3">
            <a href="/forgot-password" class="inline-block bg-brand-primary text-gray-955 px-5 py-2.5 rounded-full font-bold text-xs tracking-wider uppercase text-center">
              Request a reset link
            </a>
            <a href="/support" class="inline-block border border-slate-300 text-slate-700 px-5 py-2.5 rounded-full font-bold text-xs tracking-wider uppercase text-center">
              Contact support
            </a>
          </div>
        </div>
      ) : done ? (
        <div class="bg-white p-8 rounded-2xl border border-slate-200/80 shadow-xs">
          <FormFeedback status="success" message={message} />
          <p class="text-sm text-slate-600 leading-relaxed mt-4">
            For your safety you have been signed out on every device, including any you did not recognise.
          </p>
          <a href="/login" class="mt-5 inline-block bg-brand-primary text-gray-955 px-5 py-2.5 rounded-full font-bold text-xs tracking-wider uppercase">
            Sign in
          </a>
        </div>
      ) : (
        <>
          <p class="text-slate-500 mb-6 text-sm leading-relaxed">
            Choose a password of at least 8 characters. Setting it signs you out everywhere else.
          </p>
          <FormFeedback status={status} message={message} />
          <form method="POST" action="/reset-password" novalidate class="bg-white p-8 rounded-2xl border border-slate-200/80 shadow-xs space-y-5">
            <input type="hidden" name="token" value={token || Astro.url.searchParams.get('token') || ''} />
            <FormField id="password" name="password" label="New password" type="password" required autocomplete="new-password" />
            <FormField id="confirmPassword" name="confirmPassword" label="Confirm new password" type="password" required autocomplete="new-password" />
            <button
              type="submit"
              class="w-full bg-brand-primary text-gray-955 py-2.5 rounded-full font-bold text-xs tracking-wider uppercase hover:shadow-lg hover:shadow-brand-primary/20 transition-all outline-none cursor-pointer focus-visible:ring-4 focus-visible:ring-brand-primary/30"
            >
              Set new password
            </button>
            {status === 'error' && (
              <p class="text-xs text-slate-400 text-center leading-relaxed">
                Link expired or already used?
                <a href="/forgot-password" class="font-bold text-slate-600 underline hover:text-gray-900">Request a new one</a>
              </p>
            )}
          </form>
        </>
      )}
    </div>
  </div>
</BaseLayout>
