---
import { jsonApiHeaders } from '../lib/forwardClient';
import BaseLayout from '../layouts/BaseLayout.astro';
import FormField from '../components/FormField.astro';
import FormFeedback from '../components/FormFeedback.astro';
import { apiBase } from '../lib/api';

/**
 * The visitor's address, forwarded so abuse control counts THEM and not this
 * container. Reading it can throw in a prerendered context, so it degrades to
 * the shared bucket rather than breaking the page.
 */
let clientAddress: string | null = null;
try {
  clientAddress = Astro.clientAddress ?? null;
} catch {
  clientAddress = null;
}


/**
 * Set a new password, from an SMS code or from an email link.
 *
 * SMS: the phone and the 6 digit code arrive by POST from /forgot-password
 * and are carried through this form as hidden fields if the customer needs a
 * second try (mismatched passwords, a weak password).
 *
 * Email: the token arrives in the query string, is carried through the form
 * as a hidden field, and is POSTed from the SERVER. It never reaches
 * client-side JavaScript and is never put anywhere it could be logged.
 *
 * A used or expired code or link says so plainly and offers a new one, rather
 * than failing with something the customer cannot act on.
 */

/**
 * The email link's token is moved OUT of the address bar before the page
 * renders. Every page loads the measurement tags, and GA4's page_view (and our
 * own telemetry) send page_location — the full URL, query string included — so
 * `?token=` handed a single-use account-takeover secret to the analytics
 * pipeline and its logs. The GET with a token answers with a redirect to the
 * bare path and keeps the token in a short-lived HttpOnly cookie scoped to this
 * page; the page reads it from there. The form still POSTs it from the server.
 */
const RESET_TOKEN_COOKIE = 'gp_reset_token';
const queryToken = Astro.url.searchParams.get('token') ?? '';
if (Astro.request.method === 'GET' && queryToken) {
  Astro.cookies.set(RESET_TOKEN_COOKIE, queryToken.slice(0, 512), {
    path: '/reset-password',
    httpOnly: true,
    sameSite: 'lax',
    secure: import.meta.env.PROD,
    maxAge: 15 * 60,
  });
  return Astro.redirect('/reset-password', 303);
}
const token = Astro.cookies.get(RESET_TOKEN_COOKIE)?.value ?? '';

let status: 'success' | 'error' | null = null;
let message = '';
let done = false;
let phone = '';
let mode: 'sms' | 'link' = token ? 'link' : 'sms';
let carriedToken = token;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const submittedToken = String(form.get('token') ?? '');
  phone = String(form.get('phone') ?? '').trim();
  const code = String(form.get('code') ?? '').trim();
  const password = String(form.get('password') ?? '');
  const confirm = String(form.get('confirmPassword') ?? '');
  mode = submittedToken ? 'link' : 'sms';
  carriedToken = submittedToken;

  if (password !== confirm) {
    status = 'error';
    message = 'The two passwords do not match.';
  } else {
    try {
      const res =
        mode === 'link'
          ? await fetch(`${apiBase}/auth/password/reset`, {
              method: 'POST',
              headers: jsonApiHeaders(clientAddress),
              body: JSON.stringify({ token: submittedToken, password }),
            })
          : await fetch(`${apiBase}/auth/password/reset-sms`, {
              method: 'POST',
              headers: jsonApiHeaders(clientAddress),
              body: JSON.stringify({ phone, code, password }),
            });
      const json = await res.json().catch(() => null);
      if (json?.success) {
        status = 'success';
        done = true;
        // The token is spent; nothing of it stays in the browser.
        Astro.cookies.delete(RESET_TOKEN_COOKIE, { path: '/reset-password' });
        message = json.data?.message ?? 'Your password has been changed.';
      } else {
        status = 'error';
        message =
          json?.error?.message ??
          (mode === 'link' ? 'This reset link is not valid. Request a new one.' : 'That code is not correct or has expired. Ask for a new code and try again.');
      }
    } catch {
      status = 'error';
      message = 'We could not reach the server. Please try again shortly.';
    }
  }
}

// Nothing to work with: no link token and no phone from the SMS journey.
const nothingToResume = !carriedToken && !phone && Astro.request.method !== 'POST';
---

<BaseLayout robotsMeta="noindex,follow" title="Set a new password" description="Choose a new password for your GoldPlus account.">
  <div class="container mx-auto px-4 lg:px-8 py-12 md:py-20">
    <div class="max-w-md mx-auto">
      <h1 class="text-2xl md:text-3xl font-black text-gray-900 mb-2 tracking-tight">Set a new password</h1>

      {nothingToResume ? (
        <div class="bg-white p-8 rounded-2xl border border-slate-200/80">
          <p class="text-sm text-slate-600 leading-relaxed">
            This page works from the SMS code or the email link we send you. Ask for one, or contact us if you are stuck.
          </p>
          <div class="mt-5 flex flex-col sm:flex-row gap-3">
            <a href="/forgot-password" class="inline-flex min-h-12 items-center justify-center bg-brand-primary text-gray-950 px-5 py-3 rounded-full font-bold text-sm text-center">
              Get a code or link
            </a>
            <a href="/support" class="inline-flex min-h-12 items-center justify-center border border-slate-300 text-slate-700 px-5 py-3 rounded-full font-bold text-sm text-center">
              Contact support
            </a>
          </div>
        </div>
      ) : done ? (
        <div class="bg-white p-8 rounded-2xl border border-slate-200/80">
          <FormFeedback status="success" message={message} />
          <p class="text-sm text-slate-600 leading-relaxed mt-4">
            For your safety you have been signed out on every device, including any you did not recognise.
          </p>
          <a href="/login" class="mt-5 inline-flex min-h-12 items-center justify-center bg-brand-primary text-gray-950 px-5 py-3 rounded-full font-bold text-sm">
            Sign in
          </a>
        </div>
      ) : (
        <>
          <p class="text-slate-500 mb-6 text-sm leading-relaxed">
            Choose a password of at least 8 characters. Setting it signs you out everywhere else.
          </p>
          <FormFeedback status={status} message={message} />
          <form method="POST" action="/reset-password" novalidate class="bg-white p-8 rounded-2xl border border-slate-200/80 space-y-5">
            {mode === 'link' ? (
              <input type="hidden" name="token" value={carriedToken} />
            ) : (
              <>
                <input type="hidden" name="phone" value={phone} />
                <FormField id="code" name="code" label="6 digit code from the SMS" type="text" required autocomplete="one-time-code" inputmode="numeric" placeholder="123456" />
              </>
            )}
            <FormField id="password" name="password" label="New password" type="password" required autocomplete="new-password" />
            <FormField id="confirmPassword" name="confirmPassword" label="Confirm new password" type="password" required autocomplete="new-password" />
            <button
              type="submit"
              class="w-full min-h-12 bg-brand-primary text-gray-950 py-3 rounded-full font-bold text-sm hover:shadow-lg hover:shadow-brand-primary/20 transition-all outline-none cursor-pointer focus-visible:ring-4 focus-visible:ring-brand-primaryInk"
            >
              Set new password
            </button>
            {status === 'error' && (
              <p class="text-xs text-slate-500 text-center leading-relaxed">
                {mode === 'link' ? 'Link expired or already used?' : 'Code expired or not arrived?'}
                <a href="/forgot-password" class="font-bold text-slate-600 underline hover:text-gray-900">Ask for a new one</a>
              </p>
            )}
          </form>
        </>
      )}
    </div>
  </div>
</BaseLayout>
