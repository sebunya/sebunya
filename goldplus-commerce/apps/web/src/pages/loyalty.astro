---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  BADGE_CONCEPTS,
  BADGE_PREVIEW_STATES,
  DISCOUNT_GOVERNANCE_PRINCIPLES,
  FUTURE_PREMIUM_CONCEPTS,
  LAUNCH_READINESS_CHECKLIST,
  LOYALTY_FOUNDATION_GUARDRAILS,
  LOYALTY_PROGRAMME_STATUS,
  MEMORY_LANE_CONCEPT,
  MYSTERY_REVEAL_CONCEPTS,
  QUEST_CONCEPTS,
  RISK_CONTROLS_CHECKLIST,
  TIER_PREVIEWS,
  UTILISATION_OFFER_RULES,
  VISUAL_PROGRESS_PREVIEW,
} from "../lib/loyalty-foundation";

const statusClass = "inline-flex rounded-full border border-amber-200 bg-amber-50 px-3 py-1 text-[10px] font-black uppercase tracking-wider text-amber-900";

// The status section states what the programme IS, from the API, not from copy
// frozen at authoring time. If the programme is off (or unreachable) the page
// falls back to the honest dormant messaging it always carried.
import { apiBase } from "../lib/api";
let programme: { active: boolean; earnRatePer1000Ugx: number; expiryDays: number } | null = null;
try {
  const res = await fetch(`${apiBase}/commerce/loyalty-programme`, { signal: AbortSignal.timeout(3000) });
  const json: any = res.ok ? await res.json().catch(() => null) : null;
  if (json?.success && json.data?.active) programme = json.data;
} catch {
  /* dormant messaging is the safe fallback */
}
---

<BaseLayout
  title={programme ? "GoldPlus Rewards | Earn points on every paid order" : "GoldPlus Rewards preview | Loyalty foundation"}
  description={programme
    ? `GoldPlus Rewards is live: earn ${programme.earnRatePer1000Ugx} points per 1,000 UGX on every paid order placed while signed in.`
    : "A transparent preview of future GoldPlus quests, badges, Memory Lane and governed offers. The programme is not active."}
>
  <main data-loyalty-foundation>
    <section class="relative overflow-hidden border-b border-slate-200 bg-slate-950 text-white">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(150,204,6,0.18),transparent_38%)]"></div>
      <div class="container relative mx-auto px-4 py-16 sm:py-20 lg:px-8 lg:py-24">
        <div class="max-w-4xl">
          {programme ? (
            <>
              <span class="inline-flex rounded-full border border-brand-primary/40 bg-brand-primary/10 px-4 py-2 text-xs font-black uppercase tracking-[0.18em] text-brand-primary">Live programme</span>
              <h1 class="mt-6 text-4xl font-black tracking-tight sm:text-5xl lg:text-6xl">GoldPlus Rewards is live.</h1>
              <p class="mt-5 max-w-3xl text-base leading-relaxed text-slate-300 sm:text-lg">
                Every paid order placed while signed in earns <strong class="text-white">{programme.earnRatePer1000Ugx} points per 1,000 UGX</strong> of the order total.
                Points stay valid for <strong class="text-white">{programme.expiryDays} days</strong> from the day they are earned.
              </p>
              <div class="mt-8 rounded-2xl border border-brand-primary/30 bg-brand-primary/10 p-5" role="status" aria-label="GoldPlus Rewards current status">
                <p class="font-black text-brand-primary">Programme status: Active</p>
                <p class="mt-2 text-sm leading-relaxed text-slate-200">Create a free account and sign in before you check out — guest orders cannot be credited with points. Your balance and full points history live in your account.</p>
              </div>
              <div class="mt-8 flex flex-wrap gap-3">
                <a href="/register?returnTo=/account/loyalty" class="inline-flex min-h-11 items-center rounded-full bg-brand-primary px-6 py-3 text-xs font-black uppercase tracking-wider text-slate-950 outline-none focus-visible:ring-2 focus-visible:ring-white">Create your account</a>
                <a href="/account/loyalty" class="inline-flex min-h-11 items-center rounded-full border border-slate-600 px-6 py-3 text-xs font-black uppercase tracking-wider text-white outline-none hover:border-slate-300 focus-visible:ring-2 focus-visible:ring-brand-primary">View my points</a>
              </div>
            </>
          ) : (
            <>
              <span class="inline-flex rounded-full border border-brand-primary/40 bg-brand-primary/10 px-4 py-2 text-xs font-black uppercase tracking-[0.18em] text-brand-primary">Foundation preview · not active</span>
              <h1 class="mt-6 text-4xl font-black tracking-tight sm:text-5xl lg:text-6xl">GoldPlus Rewards is being prepared.</h1>
              <p class="mt-5 max-w-3xl text-base leading-relaxed text-slate-300 sm:text-lg">
                A future programme may help customers buy smarter, care for devices and explore useful product knowledge. Benefits and rules will be confirmed before launch.
              </p>
              <div class="mt-8 rounded-2xl border border-amber-300/30 bg-amber-100/10 p-5" role="status" aria-label="GoldPlus Rewards current status">
                <p class="font-black text-amber-200">Programme status: {LOYALTY_PROGRAMME_STATUS.label}</p>
                <p class="mt-2 text-sm leading-relaxed text-slate-200">{LOYALTY_PROGRAMME_STATUS.truthMessage}</p>
                <p class="mt-1 text-sm leading-relaxed text-slate-300">{LOYALTY_PROGRAMME_STATUS.termsMessage}</p>
              </div>
              <div class="mt-8 flex flex-wrap gap-3">
                <a href="#foundation-preview" class="inline-flex min-h-11 items-center rounded-full bg-brand-primary px-6 py-3 text-xs font-black uppercase tracking-wider text-slate-950 outline-none focus-visible:ring-2 focus-visible:ring-white">Explore the preview</a>
                <a href="/support" class="inline-flex min-h-11 items-center rounded-full border border-slate-600 px-6 py-3 text-xs font-black uppercase tracking-wider text-white outline-none hover:border-slate-300 focus-visible:ring-2 focus-visible:ring-brand-primary">Confirm current offers</a>
              </div>
            </>
          )}
        </div>
      </div>
    </section>

    <section id="foundation-preview" aria-labelledby="expect-heading" class="container mx-auto scroll-mt-24 px-4 py-14 lg:px-8">
      <div class="grid gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:items-start">
        <div>
          <p class="text-xs font-black uppercase tracking-[0.18em] text-brand-primary">Built around customer value</p>
          <h2 id="expect-heading" class="mt-3 text-3xl font-black tracking-tight text-slate-950">What customers may expect later</h2>
          <p class="mt-4 text-sm leading-relaxed text-slate-600">Helpful journeys could support safe charging, warranty awareness, storage protection, product comparison and support confidence. Every mechanic remains subject to approved rules.</p>
        </div>
        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {FUTURE_PREMIUM_CONCEPTS.map((concept) => (
            <div class="rounded-xl border border-slate-200 bg-white p-4 text-sm font-bold text-slate-800 shadow-sm">
              {concept}<span class="mt-2 block text-[10px] font-black uppercase tracking-wide text-slate-400">Future concept</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section aria-labelledby="progress-heading" class="border-y border-slate-200 bg-slate-50">
      <div class="container mx-auto px-4 py-14 lg:px-8">
        <div class="mx-auto max-w-5xl rounded-3xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
          <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
            <div><p class="text-xs font-black uppercase tracking-wider text-brand-primary">Visual progress preview</p><h2 id="progress-heading" class="mt-2 text-2xl font-black text-slate-950">{VISUAL_PROGRESS_PREVIEW.title}</h2></div>
            <span class={statusClass}>{VISUAL_PROGRESS_PREVIEW.label}</span>
          </div>
          <div class="mt-7" aria-label={`Programme foundation setup preview: ${VISUAL_PROGRESS_PREVIEW.setupPercent} percent`}>
            <div class="h-3 overflow-hidden rounded-full bg-slate-200"><div class="h-full rounded-full bg-brand-primary" style={`width:${VISUAL_PROGRESS_PREVIEW.setupPercent}%`}></div></div>
            <p class="mt-2 text-xs font-bold text-slate-500">This bar represents foundation setup, not points, spend or customer progress.</p>
          </div>
          <ol class="mt-7 grid gap-4 sm:grid-cols-2">
            {VISUAL_PROGRESS_PREVIEW.steps.map((step, index) => (
              <li class="rounded-xl border border-slate-200 p-4"><span class="text-[10px] font-black uppercase tracking-wider text-slate-400">Step {index + 1}</span><p class="mt-1 font-black text-slate-900">{step.label}</p><p class="mt-1 text-xs text-slate-500">{step.state}</p></li>
            ))}
          </ol>
          <p class="mt-6 rounded-xl bg-blue-50 p-4 text-sm leading-relaxed text-blue-950">{VISUAL_PROGRESS_PREVIEW.technicalNote}</p>
        </div>
      </div>
    </section>

    <section aria-labelledby="quests-heading" class="container mx-auto px-4 py-14 lg:px-8">
      <div class="max-w-3xl"><p class="text-xs font-black uppercase tracking-wider text-brand-primary">Helpful actions before incentives</p><h2 id="quests-heading" class="mt-2 text-3xl font-black text-slate-950">Quest concepts for future approved benefits</h2><p class="mt-3 text-sm leading-relaxed text-slate-600">Future quests may help customers qualify for approved benefits only after identity, ledger, consent, fraud, policy and support controls are live. These cards do not record completion.</p></div>
      <div class="mt-8 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
        {QUEST_CONCEPTS.map((quest) => (
          <article class="flex flex-col rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <div class="flex items-start justify-between gap-3"><h3 class="font-black text-slate-950">{quest.name}</h3><span class={statusClass}>{quest.status}</span></div>
            <p class="mt-4 text-sm leading-relaxed text-slate-600">{quest.purpose}</p>
            <dl class="mt-5 space-y-3 text-xs leading-relaxed"><div><dt class="font-black text-slate-500">Possible future path</dt><dd class="mt-1 text-slate-700">{quest.futureUnlockConcept}</dd></div><div><dt class="font-black text-slate-500">Before activation</dt><dd class="mt-1 text-slate-700">{quest.activationBlocker}</dd></div></dl>
            <p class="mt-5 border-t border-slate-100 pt-4 text-xs font-bold text-amber-800">No completion action and no benefit is active.</p>
          </article>
        ))}
      </div>
    </section>

    <section aria-labelledby="badges-heading" class="border-y border-slate-200 bg-slate-950 text-white">
      <div class="container mx-auto px-4 py-14 lg:px-8">
        <div class="max-w-3xl"><p class="text-xs font-black uppercase tracking-wider text-brand-primary">Non-financial recognition</p><h2 id="badges-heading" class="mt-2 text-3xl font-black">Badge concepts and future states</h2><p class="mt-3 text-sm leading-relaxed text-slate-300">In a future programme, badges may recognise helpful shopping and device-care actions. Undiscovered states may introduce useful areas that have not been explored. No customer badges are active in this foundation release.</p></div>
        <div class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
          {BADGE_PREVIEW_STATES.map((state) => <article class="rounded-xl border border-slate-700 bg-slate-900 p-4"><p class="font-black text-white">{state.label}</p><p class="mt-2 text-xs leading-relaxed text-slate-400">{state.meaning}</p></article>)}
        </div>
        <div class="mt-8 flex flex-wrap gap-3" aria-label="Badge concept examples">
          {BADGE_CONCEPTS.map((badge) => <span class="rounded-full border border-brand-primary/30 bg-brand-primary/10 px-4 py-2 text-xs font-bold text-brand-primary">{badge} · preview</span>)}
        </div>
      </div>
    </section>

    <section aria-labelledby="tiers-heading" class="container mx-auto px-4 py-14 lg:px-8">
      <div class="max-w-3xl"><p class="text-xs font-black uppercase tracking-wider text-brand-primary">Tier preview</p><h2 id="tiers-heading" class="mt-2 text-3xl font-black text-slate-950">Possible service tiers—not customer assignments</h2><p class="mt-3 text-sm leading-relaxed text-slate-600">All names and benefits are previews, not active statuses. They are subject to policy, fairness, liability and support approval.</p></div>
      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">{TIER_PREVIEWS.map((tier) => <article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm"><span class={statusClass}>{tier.status}</span><h3 class="mt-4 text-xl font-black text-slate-950">{tier.name}</h3><p class="mt-3 text-sm leading-relaxed text-slate-600">{tier.description}</p><p class="mt-4 text-xs font-bold text-slate-500">Not active · not customer-specific · benefits subject to approval</p></article>)}</div>
    </section>

    <section aria-labelledby="memory-heading" class="bg-gradient-to-br from-indigo-950 to-slate-950 text-white">
      <div class="container mx-auto grid gap-8 px-4 py-14 lg:grid-cols-[0.8fr_1.2fr] lg:px-8">
        <div><p class="text-xs font-black uppercase tracking-wider text-brand-primary">Annual journey concept</p><h2 id="memory-heading" class="mt-2 text-3xl font-black">Future GoldPlus Memory Lane</h2><p class="mt-4 text-sm leading-relaxed text-slate-300">Future Memory Lane may help customers reflect on electronics, device care and smart-buying learning over time.</p><div class="mt-5 rounded-xl border border-amber-300/30 bg-amber-100/10 p-4 text-sm leading-relaxed text-amber-100"><strong>{MEMORY_LANE_CONCEPT.status}.</strong> {MEMORY_LANE_CONCEPT.message} {MEMORY_LANE_CONCEPT.launchRequirements}</div></div>
        <div class="grid gap-3 sm:grid-cols-2">{MEMORY_LANE_CONCEPT.possibleInsights.map((insight) => <div class="rounded-xl border border-white/10 bg-white/5 p-4 text-sm text-slate-200">{insight}<span class="mt-2 block text-[10px] font-black uppercase tracking-wide text-slate-500">Anonymised concept example</span></div>)}</div>
      </div>
    </section>

    <section aria-labelledby="offers-heading" class="container mx-auto px-4 py-14 lg:px-8">
      <div class="max-w-4xl"><p class="text-xs font-black uppercase tracking-wider text-brand-primary">Future utilisation-aware offers</p><h2 id="offers-heading" class="mt-2 text-3xl font-black text-slate-950">Smarter offer governance before price cuts</h2><p class="mt-4 text-sm leading-relaxed text-slate-600">Future offers should be based on approved rules, margin protection, customer consent, inventory context, reward-liability controls and support capacity. No utilisation-based discount is live in this foundation release.</p></div>
      <div class="mt-8 overflow-x-auto rounded-2xl border border-slate-200 bg-white shadow-sm">
        <table class="min-w-[1080px] w-full text-left text-xs"><caption class="sr-only">Future utilisation offer rules matrix</caption><thead class="bg-slate-950 text-white"><tr>{["Utilisation signal", "Future use", "Data required", "Approval required", "Risk control", "Status"].map((heading) => <th scope="col" class="px-4 py-4 font-black">{heading}</th>)}</tr></thead><tbody class="divide-y divide-slate-100">{UTILISATION_OFFER_RULES.map((rule) => <tr><th scope="row" class="px-4 py-4 font-black text-slate-950">{rule.signal}</th><td class="px-4 py-4 text-slate-600">{rule.futureUse}</td><td class="px-4 py-4 text-slate-600">{rule.dataRequired}</td><td class="px-4 py-4 text-slate-600">{rule.approvalRequired}</td><td class="px-4 py-4 text-slate-600">{rule.riskControl}</td><td class="px-4 py-4"><span class={statusClass}>{rule.status}</span></td></tr>)}</tbody></table>
      </div>
      <div class="mt-10 rounded-2xl border border-emerald-200 bg-emerald-50 p-6"><h3 class="text-xl font-black text-emerald-950">Discount governance principles</h3><ul class="mt-5 grid gap-3 md:grid-cols-2">{DISCOUNT_GOVERNANCE_PRINCIPLES.map((principle) => <li class="flex gap-3 text-sm leading-relaxed text-emerald-950"><span aria-hidden="true" class="font-black">✓</span><span>{principle}</span></li>)}</ul></div>
    </section>

    <section aria-labelledby="reveal-heading" class="border-y border-slate-200 bg-slate-50">
      <div class="container mx-auto px-4 py-14 lg:px-8"><div class="max-w-3xl"><p class="text-xs font-black uppercase tracking-wider text-brand-primary">Mystery reveal concepts</p><h2 id="reveal-heading" class="mt-2 text-3xl font-black text-slate-950">Surprise mechanics need rules before theatre</h2><p class="mt-3 text-sm leading-relaxed text-slate-600">Mystery reveal mechanics are being considered for future campaigns. They will not go live until rules, eligibility, odds, expiry, fraud controls, support handling and margin approval are confirmed.</p></div><div class="mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-3">{MYSTERY_REVEAL_CONCEPTS.map((mechanic) => <article class="rounded-2xl border border-slate-200 bg-white p-6"><span class={statusClass}>{mechanic.status}</span><h3 class="mt-4 font-black text-slate-950">{mechanic.name}</h3><p class="mt-3 text-xs leading-relaxed text-slate-500">No live discount · No prize generated · No code issued · No data collected</p></article>)}</div></div>
    </section>

    <section aria-labelledby="protection-heading" class="container mx-auto px-4 py-14 lg:px-8">
      <div class="grid gap-8 lg:grid-cols-2">
        <div class="rounded-2xl border border-blue-200 bg-blue-50 p-6 sm:p-8"><h2 id="protection-heading" class="text-2xl font-black text-blue-950">How GoldPlus will protect customers before launch</h2><ul class="mt-6 space-y-3">{LOYALTY_FOUNDATION_GUARDRAILS.map((item) => <li class="flex gap-3 text-sm leading-relaxed text-blue-950"><span aria-hidden="true" class="font-black">—</span><span>{item}</span></li>)}</ul></div>
        <div class="rounded-2xl border border-amber-200 bg-amber-50 p-6 sm:p-8"><h2 class="text-2xl font-black text-amber-950">Risk controls before activation</h2><ul class="mt-6 max-h-[430px] space-y-3 overflow-y-auto pr-2">{RISK_CONTROLS_CHECKLIST.map((item) => <li class="flex gap-3 text-sm leading-relaxed text-amber-950"><span aria-hidden="true" class="font-black">□</span><span>{item}</span></li>)}</ul></div>
      </div>
    </section>

    <section aria-labelledby="readiness-heading" class="bg-slate-950 text-white">
      <div class="container mx-auto px-4 py-14 lg:px-8"><div class="max-w-3xl"><p class="text-xs font-black uppercase tracking-wider text-brand-primary">Launch readiness</p><h2 id="readiness-heading" class="mt-2 text-3xl font-black">What must be approved before rewards go live</h2><p class="mt-3 text-sm leading-relaxed text-slate-300">This is a checklist, not an activation control. Every item remains subject to evidence and accountable approval.</p></div><ol class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">{LAUNCH_READINESS_CHECKLIST.map((item, index) => <li class="flex gap-3 rounded-xl border border-slate-800 bg-slate-900 p-4 text-sm text-slate-200"><span class="font-black text-brand-primary">{String(index + 1).padStart(2, "0")}</span><span>{item}</span></li>)}</ol></div>
    </section>

    <section aria-labelledby="current-guidance" class="container mx-auto px-4 py-14 lg:px-8">
      <div class="mx-auto max-w-4xl rounded-3xl border border-slate-200 bg-white p-7 text-center shadow-sm sm:p-10"><p class="text-xs font-black uppercase tracking-wider text-brand-primary">Current guidance</p><h2 id="current-guidance" class="mt-3 text-2xl font-black text-slate-950">Need help with today’s offers or policies?</h2><p class="mx-auto mt-4 max-w-2xl text-sm leading-relaxed text-slate-600">Current offers, if any, will be confirmed by GoldPlus support. Progress, quests, badges, tiers, Memory Lane, utilisation-aware offers and reveal mechanics shown here are previews only.</p><nav aria-label="Rewards support and policy links" class="mt-7 flex flex-wrap justify-center gap-3"><a href="/support" class="inline-flex min-h-11 items-center rounded-full bg-slate-950 px-6 py-3 text-xs font-black uppercase tracking-wider text-white">Contact support</a><a href="/terms" class="inline-flex min-h-11 items-center rounded-full border border-slate-300 px-6 py-3 text-xs font-black uppercase tracking-wider text-slate-800">Read terms</a><a href="/privacy" class="inline-flex min-h-11 items-center rounded-full border border-slate-300 px-6 py-3 text-xs font-black uppercase tracking-wider text-slate-800">Read privacy guidance</a></nav></div>
    </section>
  </main>
</BaseLayout>
