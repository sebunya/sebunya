---
import BaseLayout from "../layouts/BaseLayout.astro";
import { apiBase } from "../lib/api";
import { resolveAuthenticatedUserId } from "../lib/customerAuth";

/**
 * GoldPlus Rewards (loyalty brief PART Q rebuild).
 *
 * The LIVE programme is the page: rate, what a point is worth, expiry, how to
 * redeem, and — signed in — your balance. Every preview card for unshipped
 * mechanics is gone (the concepts are archived in lib/loyalty-foundation.ts,
 * which admin previews still read). Safeguards live below the fold, short.
 * Anything not configured yet is stated as exactly that — never defaulted.
 */
interface Programme {
  active: boolean;
  earnRatePer1000Ugx: number;
  expiryDays: number;
  redemption: { configured: boolean; pointValueUgx?: number; minPoints?: number; maxShareBps?: number };
  vesting?: string;
  /** 0087: only ACTIVE earn sources arrive here — nothing unshipped is listed. */
  earnSources?: {
    verificationScan: number | null;
    counterfeitReport: number | null;
    phoneVerification: number | null;
    referral: { referrer: number | null; referee: number | null } | null;
    birthday: number | null;
    streak: { orders: number; windowDays: number | null; points: number } | null;
  } | null;
  tiers?: Array<{ code: string; name: string; threshold: number; benefits: Record<string, boolean> }>;
  termsVersion?: string | null;
}
let programme: Programme | null = null;
try {
  const res = await fetch(`${apiBase}/commerce/loyalty-programme`, { signal: AbortSignal.timeout(3000) });
  const json: any = res.ok ? await res.json().catch(() => null) : null;
  if (json?.success && json.data?.active) programme = json.data;
} catch {
  /* dormant messaging is the safe fallback */
}

// Signed-in balance: the one number a member actually came for.
const userId = await resolveAuthenticatedUserId(Astro.cookies);
const sessionToken = Astro.cookies.get("goldplus_session")?.value ?? null;
let balance: { available: number; pendingPoints: number } | null = null;
if (userId && sessionToken && programme) {
  try {
    const res = await fetch(`${apiBase}/account/loyalty`, {
      headers: { Authorization: `Bearer ${sessionToken}` },
      signal: AbortSignal.timeout(2500),
    });
    const json: any = res.ok ? await res.json().catch(() => null) : null;
    if (json?.success) {
      balance = {
        available: Number(json.data?.balance?.available ?? 0),
        pendingPoints: Number(json.data?.pendingPoints ?? 0),
      };
    }
  } catch {
    /* balance card simply hides */
  }
}

const fmtUgx = (n: number) => new Intl.NumberFormat("en-UG", { style: "currency", currency: "UGX", maximumFractionDigits: 0 }).format(n);
const pointValue = programme?.redemption.configured ? programme.redemption.pointValueUgx ?? null : null;

// Ways to earn: built from the LIVE config only. A source whose value is unset
// is simply absent — the page never lists a mechanic that would not pay out.
const src = programme?.earnSources ?? null;
const earnWays: Array<{ label: string; detail: string; points: string }> = [];
if (programme) {
  earnWays.push({
    label: "Every delivered order",
    detail: "Points vest the day your order is delivered. Placed while signed in.",
    points: `${programme.earnRatePer1000Ugx} pts / 1,000 UGX`,
  });
}
if (src?.verificationScan) {
  earnWays.push({
    label: "Verify a genuine product",
    detail: "Scan the hologram code on any GoldPlus product — including one you are checking before you buy it.",
    points: `${src.verificationScan} pts per scan`,
  });
}
if (src?.counterfeitReport) {
  earnWays.push({
    label: "Report a counterfeit we confirm",
    detail: "Report a fake you found in the market. Points are awarded when our team confirms it, and support follows up with you.",
    points: `${src.counterfeitReport} pts`,
  });
}
if (src?.phoneVerification) {
  earnWays.push({
    label: "Verify your phone number",
    detail: "One-off. Your verified number is how we keep one account per customer.",
    points: `${src.phoneVerification} pts once`,
  });
}
if (src?.referral?.referrer) {
  earnWays.push({
    label: "Introduce a friend",
    detail: `You earn when their first order is delivered${src.referral.referee ? `, and they start with ${src.referral.referee} points` : ""}. Not before.`,
    points: `${src.referral.referrer} pts`,
  });
}
if (src?.streak) {
  earnWays.push({
    label: "Keep a delivery streak",
    detail: `${src.streak.orders} delivered orders in a row, each within ${src.streak.windowDays ?? 90} days of the last.`,
    points: `${src.streak.points} pts`,
  });
}
if (src?.birthday) {
  earnWays.push({
    label: "Your birthday",
    detail: "Add your date of birth to your account and we mark the day. Once a year.",
    points: `${src.birthday} pts`,
  });
}
// 0088: the scratch card is listed only when draws are actually running, and
// described honestly — it is a bonus ON TOP of the points the order already
// earned, it costs nothing, and every card wins.
let drawInfo: { name: string; tokenExpiryDays: number } | null = null;
try {
  const res = await fetch(`${apiBase}/commerce/reward-draw`, { signal: AbortSignal.timeout(2500) });
  const json: any = res.ok ? await res.json().catch(() => null) : null;
  if (json?.success && json.data?.enabled) drawInfo = json.data;
} catch {
  /* the card simply isn't advertised */
}
if (drawInfo) {
  earnWays.push({
    label: "A scratch card with every delivery",
    detail: `Free, on top of the points the order already earned. Every card wins — only the amount varies, and the odds are published. Cards expire after ${drawInfo.tokenExpiryDays} days.`,
    points: "Bonus points",
  });
}

const tiers = (programme?.tiers ?? []).slice().sort((a, b) => a.threshold - b.threshold);
const BENEFIT_LABELS: Record<string, string> = {
  prioritySupport: "Priority support queue",
  extendedWarrantyHandling: "Extended warranty handling",
  earlyAccess: "Early access to new stock",
};
---

<BaseLayout
  title={programme ? "GoldPlus Rewards | Earn points on every delivered order" : "GoldPlus Rewards | Coming soon"}
  description={programme
    ? `GoldPlus Rewards is live: earn ${programme.earnRatePer1000Ugx} points per 1,000 UGX on every delivered order placed while signed in.`
    : "GoldPlus Rewards is being prepared. Nothing is live yet."}
>
  <main>
    <section class="relative overflow-hidden border-b border-slate-200 bg-slate-950 text-white">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(150,204,6,0.18),transparent_38%)]"></div>
      <div class="container relative mx-auto px-4 py-16 sm:py-20 lg:px-8">
        <div class="max-w-4xl">
          {programme ? (
            <>
              <span class="inline-flex rounded-full border border-brand-primary/40 bg-brand-primary/10 px-4 py-2 text-xs font-black uppercase tracking-[0.18em] text-brand-primary">Live programme</span>
              <h1 class="mt-6 text-4xl font-black tracking-tight sm:text-5xl">GoldPlus Rewards is live.</h1>

              {balance && (
                <div class="mt-8 rounded-2xl border border-brand-primary/40 bg-brand-primary/15 p-6" role="status" aria-label="Your points balance">
                  <p class="text-xs font-black uppercase tracking-wider text-brand-primary">Your balance</p>
                  <p class="mt-1 text-3xl font-black text-white">
                    {balance.available.toLocaleString("en-UG")} points
                    {pointValue !== null && <span class="text-lg font-bold text-slate-300"> · worth {fmtUgx(balance.available * pointValue)}</span>}
                  </p>
                  {balance.pendingPoints > 0 && (
                    <p class="mt-1 text-sm text-slate-300">+ {balance.pendingPoints.toLocaleString("en-UG")} pending — they become available when your order is delivered.</p>
                  )}
                  <a href="/account/loyalty" class="mt-3 inline-block text-sm font-bold text-brand-primary underline underline-offset-4">Full history →</a>
                </div>
              )}

              <dl class="mt-10 grid gap-4 sm:grid-cols-3">
                <div class="rounded-2xl border border-white/10 bg-white/5 p-5">
                  <dt class="text-xs font-black uppercase tracking-wider text-slate-400">Earning</dt>
                  <dd class="mt-2 text-sm leading-relaxed text-slate-200">
                    <strong class="text-white">{programme.earnRatePer1000Ugx} points per 1,000 UGX</strong> of the order total, on every order placed while signed in.
                    Points become available when the order is <strong class="text-white">delivered</strong>.
                  </dd>
                </div>
                <div class="rounded-2xl border border-white/10 bg-white/5 p-5">
                  <dt class="text-xs font-black uppercase tracking-wider text-slate-400">What a point is worth</dt>
                  <dd class="mt-2 text-sm leading-relaxed text-slate-200">
                    {programme.redemption.configured ? (
                      <>
                        <strong class="text-white">{fmtUgx(pointValue ?? 0)} per point</strong>, redeemable as a discount at checkout
                        (from {programme.redemption.minPoints?.toLocaleString("en-UG")} points, up to {Math.floor((programme.redemption.maxShareBps ?? 0) / 100)}% of the goods total).
                      </>
                    ) : (
                      <>The redemption value is being finalised. Your points are safe and every one is recorded — redemption opens for all members at once.</>
                    )}
                  </dd>
                </div>
                <div class="rounded-2xl border border-white/10 bg-white/5 p-5">
                  <dt class="text-xs font-black uppercase tracking-wider text-slate-400">Validity</dt>
                  <dd class="mt-2 text-sm leading-relaxed text-slate-200">
                    Points stay valid for <strong class="text-white">{programme.expiryDays} days</strong> from the day they are earned.
                    We warn you before anything expires — oldest points are always spent first.
                  </dd>
                </div>
              </dl>

              <div class="mt-8 flex flex-wrap gap-3">
                {!userId && (
                  <a href="/register?returnTo=/account/loyalty" class="inline-flex min-h-11 items-center rounded-full bg-brand-primary px-6 py-3 text-xs font-black uppercase tracking-wider text-slate-950">Create your account</a>
                )}
                <a href="/shop" class="inline-flex min-h-11 items-center rounded-full border border-white/20 px-6 py-3 text-xs font-black uppercase tracking-wider text-white">Shop and earn</a>
              </div>

            </>
          ) : (
            <>
              <span class="inline-flex rounded-full border border-amber-200/40 bg-amber-50/10 px-4 py-2 text-xs font-black uppercase tracking-[0.18em] text-amber-200">Not yet active</span>
              <h1 class="mt-6 text-4xl font-black tracking-tight sm:text-5xl">GoldPlus Rewards is being prepared.</h1>
              <p class="mt-5 max-w-3xl text-base leading-relaxed text-slate-300">
                No points are being issued and no benefit is active. When the programme starts, this page will state the exact earning rate, what a point is worth, and how to redeem — nothing will be promised before it works.
              </p>
            </>
          )}
        </div>
      </div>
    </section>

    {programme && earnWays.length > 1 && (
      <section class="border-b border-slate-200 bg-white">
        <div class="container mx-auto px-4 py-14 lg:px-8">
          <div class="max-w-4xl">
            <h2 class="text-2xl font-black tracking-tight text-slate-900">Every way to earn</h2>
            <p class="mt-2 text-sm leading-relaxed text-gray-600">
              This is the complete list. If a way to earn is not on this page, it does not exist yet.
            </p>
            <ul class="mt-6 divide-y divide-gray-200 rounded-2xl border border-gray-200">
              {earnWays.map((way) => (
                <li class="flex flex-col gap-2 p-5 sm:flex-row sm:items-center sm:justify-between">
                  <div class="sm:pr-6">
                    <p class="text-sm font-black text-slate-900">{way.label}</p>
                    <p class="mt-1 text-sm leading-relaxed text-gray-600">{way.detail}</p>
                  </div>
                  <span class="inline-flex shrink-0 items-center self-start rounded-full bg-brand-primary/15 px-4 py-2 text-xs font-black uppercase tracking-wider text-slate-900 sm:self-center">
                    {way.points}
                  </span>
                </li>
              ))}
            </ul>
            <p class="mt-4 text-xs text-gray-500">
              Verification and reporting earn caps apply so the programme stays fair — scans are capped per day, and a code can only ever earn once.
            </p>
          </div>
        </div>
      </section>
    )}

    {programme && tiers.length > 0 && (
      <section class="border-b border-slate-200 bg-slate-50">
        <div class="container mx-auto px-4 py-14 lg:px-8">
          <div class="max-w-4xl">
            <h2 class="text-2xl font-black tracking-tight text-slate-900">Membership levels</h2>
            <p class="mt-2 text-sm leading-relaxed text-gray-600">
              Levels are earned on the points you have earned over your lifetime — spending them never costs you a level.
              Every benefit is a service benefit: better handling, not a bigger discount.
            </p>
            <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
              {tiers.map((tier) => {
                const active = Object.entries(tier.benefits ?? {}).filter(([, on]) => on).map(([k]) => BENEFIT_LABELS[k] ?? k);
                return (
                  <div class="rounded-2xl border border-gray-200 bg-white p-5">
                    <p class="text-xs font-black uppercase tracking-wider text-brand-mutedGrey">{tier.name}</p>
                    <p class="mt-2 text-sm font-black text-slate-900">
                      {tier.threshold === 0 ? "From your first point" : `${tier.threshold.toLocaleString("en-UG")} lifetime points`}
                    </p>
                    {active.length > 0 ? (
                      <ul class="mt-3 space-y-1 text-sm leading-relaxed text-gray-700">
                        {active.map((b) => <li>· {b}</li>)}
                      </ul>
                    ) : (
                      <p class="mt-3 text-sm leading-relaxed text-gray-500">Membership and full points earning.</p>
                    )}
                  </div>
                );
              })}
            </div>
          </div>
        </div>
      </section>
    )}

    {programme && (
      <section class="border-b border-slate-200 bg-white">
        <div class="container mx-auto px-4 py-14 lg:px-8">
          <div class="max-w-3xl">
            <h2 class="text-2xl font-black tracking-tight text-slate-900">Recognition</h2>
            <p class="mt-2 text-sm leading-relaxed text-gray-600">
              Badges are awarded on things we can verify — a scan that checked out, a counterfeit our team confirmed,
              a delivery that actually arrived. They cost nothing and carry no expiry.
            </p>
            <div class="mt-6 flex flex-wrap gap-2">
              {["Authenticator", "Counterfeit Hunter", "Verified Buyer", "First Delivery", "Loyal Customer", "Connector"].map((b) => (
                <span class="rounded-full border border-gray-200 bg-gray-50 px-4 py-2 text-xs font-black uppercase tracking-wider text-gray-700">{b}</span>
              ))}
            </div>
            <a href="/account/loyalty" class="mt-6 inline-block text-sm font-bold text-slate-900 underline underline-offset-4">See your badges and progress →</a>
          </div>
        </div>
      </section>
    )}

    {/* Safeguards — kept, compressed, below the fold (PART Q) */}
    <section class="container mx-auto px-4 py-12 lg:px-8">
      <div class="max-w-3xl">
        <h2 class="text-sm font-black uppercase tracking-widest text-brand-mutedGrey">How your points are protected</h2>
        <ul class="mt-4 grid gap-3 text-sm leading-relaxed text-gray-700 sm:grid-cols-2">
          <li class="rounded-xl border border-gray-200 bg-white p-4">Every point lives in an append-only ledger — balances are computed from recorded history, never typed in by anyone.</li>
          <li class="rounded-xl border border-gray-200 bg-white p-4">Points come only from real delivered orders. A cancelled or refunded order returns its points to the pool.</li>
          <li class="rounded-xl border border-gray-200 bg-white p-4">Oldest points are spent first, and you are warned 30, 7 and 1 day before anything expires.</li>
          <li class="rounded-xl border border-gray-200 bg-white p-4">Points convert to a discount on your order — never cash, never transferable, never sold.</li>
        </ul>
        <p class="mt-6 text-xs text-gray-500">
          Questions? <a href="/support" class="font-bold underline underline-offset-2">Support</a> ·
          <a href="/loyalty-terms" class="font-bold underline underline-offset-2">Rewards terms</a> ·
          <a href="/terms" class="font-bold underline underline-offset-2">Terms of sale</a> ·
          <a href="/privacy" class="font-bold underline underline-offset-2">Privacy</a>
        </p>
      </div>
    </section>
  </main>
</BaseLayout>
