---
import BaseLayout from '../layouts/BaseLayout.astro';
import { policyBySlug, POLICY_STATUS_LABEL } from '../lib/legal-policies';
const policy = policyBySlug('privacy')!;
import CmsPolicyDocument from '../components/CmsPolicyDocument.astro';
import { fetchPublishedPolicy } from '../lib/legalCms';
// Wave 2C: a PUBLISHED CMS version replaces the wording below; until one
// exists this page is the authoritative published privacy policy.
const cms = await fetchPublishedPolicy('privacy');
---

<BaseLayout title="Privacy policy | GoldPlus">
  <main id="main-content">
    {cms ? <CmsPolicyDocument policy={cms} /> : <>
    <header class="border-b border-slate-200 bg-gradient-to-b from-slate-50 to-white py-12 sm:py-16">
      <div class="container mx-auto max-w-4xl px-4 lg:px-8">
        <p class="text-xs font-black uppercase tracking-[0.18em] text-brand-primary">Customer policy</p>
        <h1 class="mt-3 text-3xl font-black tracking-tight text-gray-900 sm:text-4xl">Privacy policy</h1>
        <p class="mt-4 max-w-3xl text-sm leading-relaxed text-slate-600 sm:text-base">
          This policy explains what information GoldPlus handles, how it is used, and how information from any Google
          account connected to GoldPlus is accessed, stored and deleted.
        </p>
        <p class="mt-4 inline-flex flex-wrap items-center gap-2 text-xs font-bold text-slate-600">
          <span class="rounded-full border border-emerald-300 bg-emerald-50 px-3 py-1 text-emerald-900">{POLICY_STATUS_LABEL[policy.status]}</span>
          <span class="rounded-full border border-slate-200 bg-slate-50 px-3 py-1">Version {policy.version}</span>
          <span class="rounded-full border border-slate-200 bg-slate-50 px-3 py-1">Effective date: {policy.effectiveDate}</span>
        </p>
      </div>
    </header>

    <div class="container mx-auto max-w-4xl px-4 py-10 sm:py-14 lg:px-8">
      <nav aria-label="Privacy sections" class="mb-10 rounded-2xl border border-slate-200 bg-slate-50 p-5">
        <h2 class="font-black text-gray-900">On this page</h2>
        <ul class="mt-3 flex flex-wrap gap-x-5 gap-y-3 text-sm font-bold">
          <li><a class="text-slate-700 underline decoration-slate-300 underline-offset-4 hover:text-gray-950 focus-visible:ring-2 focus-visible:ring-brand-primary" href="#information">Information</a></li>
          <li><a class="text-slate-700 underline decoration-slate-300 underline-offset-4 hover:text-gray-950 focus-visible:ring-2 focus-visible:ring-brand-primary" href="#use">How it is used</a></li>
          <li><a class="text-slate-700 underline decoration-slate-300 underline-offset-4 hover:text-gray-950 focus-visible:ring-2 focus-visible:ring-brand-primary" href="#sharing">Service providers</a></li>
          <li><a class="text-slate-700 underline decoration-slate-300 underline-offset-4 hover:text-gray-950 focus-visible:ring-2 focus-visible:ring-brand-primary" href="#google">Google account data</a></li>
          <li><a class="text-slate-700 underline decoration-slate-300 underline-offset-4 hover:text-gray-950 focus-visible:ring-2 focus-visible:ring-brand-primary" href="#choices">Your choices</a></li>
        </ul>
      </nav>

      <div class="space-y-10 text-sm leading-relaxed text-slate-700 sm:text-base">
        <section id="information" aria-labelledby="information-heading" class="scroll-mt-24">
          <h2 id="information-heading" class="text-xl font-black text-gray-900">Information involved</h2>
          <p class="mt-3">
            Information may include contact details, order and delivery details, support messages, product enquiries, and technical information needed to operate and protect the website.
          </p>
        </section>

        <section id="use" aria-labelledby="use-heading" class="scroll-mt-24">
          <h2 id="use-heading" class="text-xl font-black text-gray-900">How information may be used</h2>
          <p class="mt-3">
            We use order and contact details to process purchases, provide support and improve the service. Information may also be used to protect customers, investigate problems and maintain reliable website operations.
          </p>
          <p class="mt-3">
            To give you a more relevant, personalised experience, GoldPlus uses your own activity on this site. What you browse, your order history, your loyalty and your saved delivery details. To tailor what the storefront shows you. This is <strong>first-party personalisation only</strong>: it happens on our own website, and your personal information is never sold or shared with advertisers or other third parties for their own use.
          </p>
        </section>

        <section id="sharing" aria-labelledby="sharing-heading" class="scroll-mt-24">
          <h2 id="sharing-heading" class="text-xl font-black text-gray-900">Service providers and fulfilment</h2>
          <p class="mt-3">
            Information may be handled by service providers where needed to operate the website, process an order, support a customer or arrange fulfilment. The information involved depends on the service and the customer request.
          </p>
        </section>

        <section id="google" aria-labelledby="google-heading" class="scroll-mt-24">
          <h2 id="google-heading" class="text-xl font-black text-gray-900">Google account data</h2>
          <p class="mt-3">
            GoldPlus can connect to Google services that a GoldPlus administrator owns or manages, so that search and
            catalogue performance can be reviewed inside the GoldPlus admin console. These connections are made
            deliberately by an administrator; they are never created automatically, and they are not part of shopping
            on this website.
          </p>
          <p class="mt-3">
            Where an administrator connects a Google account, GoldPlus may request access to:
          </p>
          <ul class="mt-3 list-disc space-y-2 pl-6">
            <li><strong>Search Console</strong>. Read-only access to search performance and indexing data for websites the account already owns.</li>
            <li><strong>Analytics</strong>. Read-only access to aggregated website traffic reports for properties the account already owns.</li>
            <li><strong>Merchant Center</strong>. Access to product listing and account status information for the merchant account.</li>
            <li><strong>Business Profile</strong>. Access to the business listing information the account already manages.</li>
          </ul>
          <p class="mt-3">
            <strong>How this data is used.</strong> Google account data is used only to display and analyse that
            account's own performance inside the GoldPlus admin console, for example showing which search queries
            lead to the site, or whether product listings are being accepted. GoldPlus does not use it for advertising,
            does not use it to build profiles of individual people, and does not use it to train machine-learning or
            AI models.
          </p>
          <p class="mt-3">
            <strong>How it is stored.</strong> Authorisation credentials and tokens are encrypted before they are
            stored, and are never displayed again after they are saved, the admin console shows only a masked
            reference. They are used solely by GoldPlus servers to make the requests described above.
          </p>
          <p class="mt-3">
            <strong>Sharing.</strong> GoldPlus does not sell Google account data, does not transfer it to third
            parties, and does not allow humans to read it except where necessary for security, to comply with the law,
            or with the administrator's explicit request for support.
          </p>
          <p class="mt-3">
            <strong>Retention and removal.</strong> An administrator can revoke a stored credential or disconnect a
            provider at any time from the GoldPlus admin console; doing so deletes the stored credentials for that
            connection. Access can also be withdrawn at any time from the Google account's own security settings at
            <a class="underline decoration-slate-300 underline-offset-4 hover:text-gray-950" href="https://myaccount.google.com/permissions" rel="noopener noreferrer" target="_blank">myaccount.google.com/permissions</a>.
          </p>
          <p class="mt-3">
            GoldPlus's use and transfer of information received from Google APIs adheres to the
            <a class="underline decoration-slate-300 underline-offset-4 hover:text-gray-950" href="https://developers.google.com/terms/api-services-user-data-policy" rel="noopener noreferrer" target="_blank">Google API Services User Data Policy</a>,
            including the Limited Use requirements.
          </p>
        </section>

        <section aria-labelledby="security-heading">
          <h2 id="security-heading" class="text-xl font-black text-gray-900">Protecting your details</h2>
          <p class="mt-3">
            GoldPlus uses reasonable operational and technical measures to protect customer information. No online service can promise absolute security. Never send passwords, payment credentials or one-time codes to support.
          </p>
        </section>

        <section id="choices" aria-labelledby="choices-heading" class="scroll-mt-24">
          <h2 id="choices-heading" class="text-xl font-black text-gray-900">Questions and corrections</h2>
          <p class="mt-3">
            Contact GoldPlus support if you need help understanding this policy, or to correct contact or order
            information you previously provided. Support may need to verify the request before discussing customer
            details.
          </p>
        </section>

        <section aria-labelledby="privacy-updates-heading">
          <h2 id="privacy-updates-heading" class="text-xl font-black text-gray-900">Updates to this policy</h2>
          <p class="mt-3">
            GoldPlus may update this policy as its services change. The version and effective date shown at the top of
            this page identify the policy currently in force, and that version is the one that applies.
          </p>
        </section>
      </div>

      <aside aria-labelledby="privacy-help" class="mt-12 rounded-2xl border border-amber-200 bg-amber-50/60 p-6 sm:p-8">
        <h2 id="privacy-help" class="text-lg font-black text-amber-950">Need privacy or order help?</h2>
        <p class="mt-2 text-sm leading-relaxed text-amber-900">Use the public support route and share only the information needed for your request.</p>
        <div class="mt-5 flex flex-col gap-3 sm:flex-row">
          <a href="/support" class="inline-flex min-h-11 items-center justify-center rounded-full bg-slate-900 px-6 py-3 text-center text-sm font-bold text-white outline-none hover:bg-black focus-visible:ring-2 focus-visible:ring-slate-900 focus-visible:ring-offset-2">Contact support</a>
          <a href="/terms" class="inline-flex min-h-11 items-center justify-center rounded-full border border-amber-300 bg-white px-6 py-3 text-center text-sm font-bold text-amber-950 outline-none hover:border-amber-500 focus-visible:ring-2 focus-visible:ring-brand-primary">Terms of service</a>
        </div>
      </aside>
    </div>
  </>}
  </main>
</BaseLayout>
