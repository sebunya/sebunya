---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getBusinessInfo } from '../../../lib/businessInfo';
import { apiBase } from '../../../lib/api';
import {
  normalisePaymentReturnKind,
  orderNumberFromMerchantReference,
  paymentReturnCopy,
} from '../../../lib/paymentReturn';

/**
 * Where PesaPal sends the customer back.
 *
 * The API has already settled (or parked) the payment before redirecting here,
 * and passes the settlement KIND as `status`. Every kind gets its own words —
 * see paymentReturn.ts for why. The `message` query parameter the old page
 * printed verbatim is deliberately ignored: it was raw provider or exception
 * text on a page the customer reads.
 */
const reference = Astro.url.searchParams.get('reference') || Astro.url.searchParams.get('OrderMerchantReference') || '';
const trackingId = Astro.url.searchParams.get('trackingId') || Astro.url.searchParams.get('OrderTrackingId') || '';

/**
 * The status in the URL is what was true at the instant PesaPal redirected.
 * A payment that settles a moment later — the common case when an instrument
 * declines and the customer pays with another — left this page saying "we
 * could not confirm your payment" for ever, on an order that was paid.
 * So we ask the API what the settlement says NOW; settlement is idempotent,
 * and the URL's status is only the fallback when we cannot ask.
 */
let kind = normalisePaymentReturnKind(Astro.url.searchParams.get('status') || '');
if (trackingId && reference) {
  try {
    const res = await fetch(
      `${apiBase}/commerce/payments/pesapal/return-state?OrderTrackingId=${encodeURIComponent(trackingId)}&OrderMerchantReference=${encodeURIComponent(reference)}`,
      { headers: { Accept: 'application/json' } },
    );
    const json = await res.json().catch(() => null);
    if (res.ok && json?.success && typeof json.data?.kind === 'string') {
      kind = normalisePaymentReturnKind(json.data.kind);
    }
  } catch {
    // Keep the redirect's verdict rather than inventing a happier one.
  }
}
const orderNumber = orderNumberFromMerchantReference(reference);
const copy = paymentReturnCopy(kind, orderNumber);

if (kind === 'success' || kind === 'already_settled') {
  // The basket has become a paid order; leaving the cookie would re-add the
  // same items to the next checkout.
  Astro.cookies.delete('goldplus_cart_data', { path: '/' });
}

const biz = await getBusinessInfo();
const helpPrefill = orderNumber
  ? `Hello GoldPlus, I need help with the payment for order ${orderNumber}.`
  : 'Hello GoldPlus, I need help with a payment I just made.';
const helpHref = `${biz.whatsappUrl}?text=${encodeURIComponent(helpPrefill)}`;

const tone = {
  success: { ring: 'bg-green-100 text-green-600', glyph: 'M5 13l4 4L19 7', width: 3 },
  wait: { ring: 'bg-amber-100 text-amber-700', glyph: 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z', width: 2 },
  failed: { ring: 'bg-red-100 text-red-600', glyph: 'M6 18L18 6M6 6l12 12', width: 2 },
}[copy.tone];
---

<BaseLayout robotsMeta="noindex,follow" title={copy.title}>
  <div class="bg-brand-softGrey py-10 border-b border-brand-borderGrey">
    <div class="container mx-auto px-4 lg:px-8 text-center">
      <h1 class="text-2xl md:text-3xl font-black tracking-tight text-brand-charcoal mb-2">{copy.title}</h1>
      {orderNumber && <p class="text-brand-mutedGrey">Order <strong class="font-mono text-brand-charcoal">{orderNumber}</strong></p>}
    </div>
  </div>

  <div class="container mx-auto px-4 lg:px-8 py-16">
    <div class="max-w-xl mx-auto bg-white border border-brand-borderGrey rounded-3xl shadow-sm p-8 text-center">
      <div class={`w-16 h-16 ${tone.ring} rounded-full flex items-center justify-center mx-auto mb-6`}>
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width={tone.width} d={tone.glyph}></path>
        </svg>
      </div>

      <p class="text-lg font-bold text-brand-charcoal mb-3" role="status">{copy.money}</p>
      <p class="text-gray-600 mb-8 leading-relaxed">{copy.next}</p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href={copy.primaryCta.href} class="bg-brand-charcoal text-white px-6 py-3 rounded-xl font-bold hover:bg-black transition-all">{copy.primaryCta.label}</a>
        <a href={copy.secondaryCta.href} class="border border-brand-borderGrey text-brand-charcoal px-6 py-3 rounded-xl font-bold hover:bg-brand-softGrey transition-all">{copy.secondaryCta.label}</a>
      </div>

      {copy.offerHelp && (
        <p class="mt-8 text-sm text-gray-600">
          Not sure what happened? <a href={helpHref} class="font-bold text-brand-charcoal underline">Ask us on WhatsApp</a> or call {biz.phoneDisplay}. Have your order number ready.
        </p>
      )}
    </div>
  </div>
</BaseLayout>
