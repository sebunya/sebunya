---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatUgx } from '../../lib/money';
import { getBusinessInfo } from '../../lib/businessInfo';
import { resolveAuthenticatedUserId } from '../../lib/customerAuth';
import {
  openOrderReceipt,
  orderReceiptSigner,
  ORDER_NUMBER_PATTERN,
  ORDER_RECEIPT_COOKIE,
} from '../../lib/checkout';
import FormField from '../../components/FormField.astro';
import { apiBase, postJson } from '../../lib/api';
import { jsonApiHeaders, readClientAddress } from '../../lib/forwardClient';
import { checkRequestOrigin, CROSS_SITE_MESSAGE } from '../../lib/requestOrigin';
import { readSessionToken, setSignInCookies } from '../../lib/session';
import { readGuestMemory } from '../../lib/guestMemory';
import { mergeGuestSavedIntoAccount } from '../../lib/guestSaved';
import { validateRegistration, firstErrorField, fieldErrorsFromBadInput, type RegisterFieldErrors } from '../../lib/registerForm';

/**
 * The order confirmation, as its own page (Post/Redirect/Get).
 *
 * It used to be rendered inside the checkout POST's response, so a refresh
 * re-POSTed into an empty basket and the customer landed on "Your cart is
 * empty" with their order number gone; the page was still titled "Checkout"
 * and recapped nothing, so a mistyped phone number could not be caught.
 *
 * What is recapped comes from a sealed, httpOnly cookie the checkout set on
 * THIS device when the order was placed (see lib/checkout.ts). The URL only
 * carries the order number, and a number alone shows nothing but itself and
 * the way to track it, so a shared link reveals no one's details.
 */
const refParam = (Astro.url.searchParams.get('ref') ?? '').trim().toUpperCase();
const sign = orderReceiptSigner({
  CHECKOUT_INTENT_SECRET: process.env.CHECKOUT_INTENT_SECRET || import.meta.env.CHECKOUT_INTENT_SECRET,
  JWT_SECRET: process.env.JWT_SECRET || import.meta.env.JWT_SECRET,
});
const opened = sign ? openOrderReceipt(Astro.cookies.get(ORDER_RECEIPT_COOKIE)?.value, sign, Date.now()) : null;
const receipt = opened && opened.ref.toUpperCase() === refParam ? opened : null;
const reference = receipt?.ref ?? (ORDER_NUMBER_PATTERN.test(refParam) ? refParam : null);
if (!reference) {
  return Astro.redirect('/track-order', 303);
}

const userId = await resolveAuthenticatedUserId(Astro.cookies);

/*
 * Baymard A1: the account offered here keeps THIS order. One field (a password); the phone and email are the ones
 * the order was placed with, from the device's checkout memory, and can be changed. The order is attached through
 * POST /account/orders/claim, which needs the same proof as order tracking (order number + the phone or email on
 * the order), so a typed contact that is not the order's cannot claim it. A customer who signs in on the way back
 * here gets the same claim, silently, from the remembered contact.
 */
const memory = readGuestMemory(Astro.cookies, Astro.request);
const confirmedPath = `/checkout/confirmed?ref=${encodeURIComponent(reference)}`;
let joinErrors: RegisterFieldErrors = {};
let joinMessage = '';
let joinStatus: 'idle' | 'error' | 'exists' = 'idle';
let joinValues = { email: memory.email ?? '', phone: memory.phone ?? '' };
const lastDigits = (v: string) => v.replace(/\D/g, '').slice(-3);
/** The contact that proves the order: the phone when it ends like the order's, else the email. */
const proofContact = (phone: string, email: string) =>
  phone && receipt?.phoneMasked && receipt.phoneMasked.endsWith(lastDigits(phone)) ? phone : email || phone;
const claimOrder = async (token: string, contact: string) =>
  contact ? postJson('/account/orders/claim', { reference, contact }, token, readClientAddress(Astro)) : null;

if (Astro.request.method === 'POST' && !userId) {
  const form = await Astro.request.formData();
  const email = String(form.get('email') ?? '').trim();
  const phone = String(form.get('phone') ?? '').trim();
  const password = String(form.get('password') ?? '');
  joinValues = { email, phone };
  const origin = checkRequestOrigin(Astro.request, import.meta.env as unknown as Record<string, string | undefined>);
  joinErrors = validateRegistration({ email, phone, password, confirmPassword: password });
  if (!origin.allowed) {
    joinStatus = 'error';
    joinMessage = CROSS_SITE_MESSAGE;
  } else if (firstErrorField(joinErrors)) {
    joinStatus = 'error';
    joinMessage = 'Please check the details below.';
  } else {
    try {
      const res = await fetch(`${apiBase}/auth/register`, {
        method: 'POST',
        signal: AbortSignal.timeout(8000),
        headers: jsonApiHeaders(readClientAddress(Astro)),
        body: JSON.stringify({ email, phone, password }),
      });
      const json: any = await res.json().catch(() => null);
      if (res.ok && json?.success && json.data?.token) {
        setSignInCookies(Astro.cookies, json.data);
        await mergeGuestSavedIntoAccount(Astro.cookies, json.data.token).catch(() => 0);
        const claimed = await claimOrder(json.data.token, proofContact(phone, email));
        return Astro.redirect(claimed?.ok && receipt?.orderId ? `/orders/${receipt.orderId}?claimed=1` : '/account/orders', 303);
      }
      if (json?.error?.code === 'ALREADY_REGISTERED') {
        joinStatus = 'exists';
        joinMessage = json.error.message;
      } else if (json?.error?.code === 'BAD_INPUT') {
        joinErrors = fieldErrorsFromBadInput(json.error.message);
        joinStatus = 'error';
        joinMessage = String(json.error.message);
      } else {
        joinStatus = 'error';
        joinMessage = 'We could not create the account just now. Your order is safe; you can create one later from the account page.';
      }
    } catch {
      joinStatus = 'error';
      joinMessage = 'We could not reach our account service just now. Your order is safe.';
    }
  }
} else if (userId && receipt && !receipt.orderId) {
  // Nothing to attach without the order id.
} else if (userId && receipt?.orderId) {
  // Signed in with the order's receipt on this device: attach it once (idempotent) using the remembered contact.
  const token = readSessionToken(Astro.request);
  const contact = proofContact(memory.phone ?? '', memory.email ?? '');
  if (token && contact) await claimOrder(token, contact).catch(() => null);
}

const orderHref = userId && receipt?.orderId
  ? `/orders/${receipt.orderId}`
  : `/track-order?reference=${encodeURIComponent(reference)}`;
const orderLabel = receipt?.actionLabel || 'Track this order';
/*
 * The recap names what was ordered and the ONE total the server recorded.
 * It used to price each line from the basket's list price, which ignores the
 * sale price, a promo code and points, while the total below it was the
 * server's figure with all of those (and any delivery fee) in it: with a sale
 * running the lines added up to more than the total, with no row to explain
 * the gap. So no per-line prices, and the total says what it includes.
 */
const feeConfirmed = receipt?.deliveryFeeConfirmed === true;

const biz = await getBusinessInfo();
const helpHref = biz.whatsappUrl
  ? `${biz.whatsappUrl}?text=${encodeURIComponent(`Hello GoldPlus, I need to correct a detail on order ${reference}.`)}`
  : null;
---

<BaseLayout robotsMeta="noindex,nofollow" title="Order received">
  <div class="bg-gradient-to-b from-slate-50 to-white py-10 border-b border-slate-100">
    <div class="container mx-auto px-4 lg:px-8 text-center">
      <div class="w-14 h-14 bg-emerald-50 text-emerald-600 rounded-full flex items-center justify-center mx-auto mb-5 border border-emerald-100">
        <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
      </div>
      <h1 class="text-2xl md:text-3xl font-black tracking-tight text-gray-900">We have your order</h1>
      <p class="mt-3 text-slate-600">
        Order number <strong class="font-mono text-gray-900 bg-white px-2 py-0.5 rounded border border-slate-200 whitespace-nowrap">{reference}</strong>
      </p>
    </div>
  </div>

  <div class="container mx-auto px-4 lg:px-8 py-10">
    <div class="max-w-2xl mx-auto space-y-6">
      {receipt?.message && (
        <p class="text-center text-base text-slate-700 leading-relaxed" role="status">{receipt.message}</p>
      )}

      {receipt ? (
        <section aria-labelledby="recap-heading" class="bg-white border border-slate-200/80 rounded-2xl shadow-sm p-6">
          <h2 id="recap-heading" class="text-base font-black text-gray-900">What you ordered</h2>
          <ul class="mt-4 space-y-3 text-sm" aria-label="Order items">
            {receipt.items.map((item) => (
              <li class="flex items-start justify-between gap-3">
                <span class="min-w-0 text-gray-900"><span class="font-bold">{item.name}</span> <span class="text-slate-600 whitespace-nowrap">× {item.quantity}</span></span>
              </li>
            ))}
          </ul>
          <dl class="mt-4 space-y-2 border-t border-slate-100 pt-4 text-sm">
            <div class="flex items-baseline justify-between gap-3">
              <dt class="text-slate-600">Delivery</dt>
              <dd class="text-right text-slate-700">{feeConfirmed ? 'Included in the total' : 'Fee confirmed by phone before dispatch'}</dd>
            </div>
            {receipt.totalUgx !== null && (
              <div class="flex items-baseline justify-between gap-3">
                <dt class="font-bold text-gray-900">{feeConfirmed ? 'Total to pay' : 'Total (delivery fee confirmed by phone)'}</dt>
                <dd class="font-black text-gray-900 text-lg tabular-nums">{formatUgx(receipt.totalUgx)}</dd>
              </div>
            )}
            {receipt.deliveryPlace && (
              <div class="flex items-baseline justify-between gap-3">
                <dt class="text-slate-600">Delivering to</dt>
                <dd class="text-right font-semibold text-gray-900 break-words min-w-0">{receipt.deliveryPlace}</dd>
              </div>
            )}
            {receipt.phoneMasked && (
              <div class="flex items-baseline justify-between gap-3">
                <dt class="text-slate-600">Phone on the order</dt>
                <dd class="text-right font-semibold text-gray-900 tabular-nums">{receipt.phoneMasked}</dd>
              </div>
            )}
          </dl>
          {helpHref && (
            <p class="mt-4 text-xs text-slate-600">
              Something wrong, like the phone number? <a href={helpHref} class="font-bold underline underline-offset-2 text-gray-900">Message us on WhatsApp</a>{biz.phoneDisplay && <> or call {biz.phoneDisplay}</>} and quote the order number.
            </p>
          )}
        </section>
      ) : (
        <p class="text-center text-sm text-slate-600 leading-relaxed">
          Keep this order number. You can check the order at any time with it and the phone number or email you used at checkout.
        </p>
      )}

      {/* Baymard: a confirmation page says what happens next. Each step is one we already text about, so none is a promise
          we do not keep: preparation (ORDER_PAYMENT_SUCCESS), dispatch with a tracking link (ORDER_DISPATCHED), the rider's call. */}
      <section aria-labelledby="next-heading" class="bg-white border border-slate-200/80 rounded-2xl shadow-sm p-6">
        <h2 id="next-heading" class="text-base font-black text-gray-900">What happens next</h2>
        <ol class="mt-3 space-y-2 text-sm text-slate-700 list-decimal pl-5">
          <li>We prepare your order at our shop. You get a text or WhatsApp message at each step.</li>
          <li>When it leaves with our rider, or is ready to collect at our shop, we text you.</li>
          <li>Keep your phone on: the rider reaches you on the number above when they are close.</li>
        </ol>
      </section>

      <div class="flex flex-col sm:flex-row items-stretch sm:justify-center gap-3">
        <a href={orderHref} class="inline-flex h-12 items-center justify-center rounded-full px-8 text-[15px] font-semibold outline-none focus-visible:ring-4 focus-visible:ring-brand-primaryInk transition-all active:scale-[0.985]" style="background:#93D500;color:#0A0A0A">{orderLabel}</a>
        <a href="/shop" class="inline-flex h-12 items-center justify-center rounded-full bg-slate-900 px-8 text-[15px] font-semibold text-white outline-none hover:bg-black focus-visible:ring-4 focus-visible:ring-brand-primaryInk transition-all">Continue shopping</a>
      </div>

      <p class="text-center text-xs text-slate-600">
        Need a receipt? <a href={userId && receipt?.orderId ? `/account/receipts/${receipt.orderId}` : `/receipt?reference=${encodeURIComponent(reference)}`} class="font-bold underline underline-offset-2 text-gray-900">Get a receipt for this order</a>
      </p>

      {!userId && (
        <section aria-labelledby="join-h" class="mx-auto max-w-md rounded-xl border border-amber-200/60 bg-amber-50 px-5 py-4">
          <h2 id="join-h" class="text-sm font-bold text-amber-900">Keep this order in a free account</h2>
          <p class="text-xs text-amber-800 mt-1.5 leading-relaxed">One password is all it takes. This order goes into the account, you track orders in one place, check out faster next time, and earn GoldPlus points on every delivered order, starting with this one.</p>
          {joinMessage && (
            <p role="alert" class={`mt-3 text-sm font-semibold ${joinStatus === 'exists' ? 'text-amber-900' : 'text-red-700'}`}>
              {joinMessage}{' '}
              {joinStatus === 'exists' && <a href={`/login?returnTo=${encodeURIComponent(confirmedPath)}`} class="font-bold underline underline-offset-2">Sign in and this order joins your account</a>}
            </p>
          )}
          <form method="POST" action={confirmedPath} class="mt-3 space-y-3" data-join-order>
            <FormField id="join-password" name="password" label="Choose a password" type="password" required autocomplete="new-password" helperText="At least 8 characters." errorMessage={joinErrors.password} />
            <details class="text-xs" open={Boolean(joinErrors.email || joinErrors.phone || !joinValues.phone || !joinValues.email)}>
              <summary class="min-h-11 flex items-center cursor-pointer font-semibold text-amber-900">
                {joinValues.phone ? `Using ${joinValues.phone}${joinValues.email ? ` and ${joinValues.email}` : ''}. Change` : 'Your phone and email'}
              </summary>
              <div class="mt-2 space-y-3">
                <FormField id="join-phone" name="phone" label="Phone" type="tel" required inputmode="tel" autocomplete="tel" placeholder="07XX XXX XXX" defaultValue={joinValues.phone} errorMessage={joinErrors.phone} />
                <FormField id="join-email" name="email" label="Email" type="email" required autocomplete="email" helperText="For receipts and sign-in." defaultValue={joinValues.email} errorMessage={joinErrors.email} />
              </div>
            </details>
            <button type="submit" class="inline-flex min-h-11 items-center rounded-full bg-brand-dark px-5 text-sm font-bold text-white hover:bg-black outline-none focus-visible:ring-4 focus-visible:ring-brand-primaryInk">Create my account</button>
          </form>
        </section>
      )}
    </div>
  </div>
</BaseLayout>
