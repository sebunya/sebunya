---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Admin Dashboard">
  <div class="py-8">
    <h1 class="text-3xl font-bold mb-6 text-red-600">Admin Area</h1>
    <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-200">
      <p class="mb-4">Welcome to the GoldPlus Admin Dashboard. This area is strictly cache-busted by the Service Worker.</p>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-6">
        <div class="p-4 border rounded hover:bg-gray-50 cursor-pointer">
          <h2 class="font-bold">Products</h2>
          <p class="text-sm text-gray-600">Manage catalog and stock</p>
        </div>
        <div class="p-4 border rounded hover:bg-gray-50 cursor-pointer">
          <h2 class="font-bold">Orders</h2>
          <p class="text-sm text-gray-600">View and fulfill orders</p>
        </div>
        <div class="p-4 border rounded hover:bg-gray-50 cursor-pointer">
          <h2 class="font-bold">Advertising</h2>
          <p class="text-sm text-gray-600">Manage campaigns and feeds</p>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
