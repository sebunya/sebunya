---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  communicationPreferences,
  customerChannelGuidance,
  customerRightsGuidance,
  dataUsePrinciples,
  preferenceCentreStatus,
  servicePreferences,
  supportActions,
} from "../lib/preference-centre";

/**
 * The public Preference Centre.
 *
 * This page answers two customer questions and nothing else: what does GoldPlus
 * send me, and how do I change it. The internal readiness model that also lives
 * in `preference-centre.ts` — activation blockers, risk controls, launch gates,
 * unreleased programme concepts — is deliberately not imported here. See the
 * header comment in that file for why.
 */

// Only the categories that describe what happens today. The two "future
// optional" entries are roadmap, and a customer cannot act on a roadmap.
const messagesWeSend = communicationPreferences.filter((item) =>
  ["essential-service", "support-follow-up"].includes(item.id),
);
---

<BaseLayout
  title="Your GoldPlus preferences"
  description="What GoldPlus sends you, what it never sends, and how to change your communication settings."
>
  <main data-preference-centre>
    <section class="relative overflow-hidden border-b border-slate-800 bg-slate-950 text-white">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(150,204,6,0.18),transparent_40%)]"></div>
      <div class="container relative mx-auto max-w-6xl px-4 py-16 sm:py-20 lg:px-8 lg:py-24">
        <h1 class="max-w-4xl text-4xl font-black tracking-tight sm:text-5xl lg:text-6xl">Your GoldPlus preferences</h1>
        <p class="mt-5 max-w-3xl text-lg leading-relaxed text-slate-300">{preferenceCentreStatus.publicMessage}</p>
        <div class="mt-8 grid gap-3 sm:grid-cols-2" role="status" aria-label="Communication summary">
          <p class="rounded-xl border border-emerald-300/30 bg-emerald-100/10 p-4 text-sm font-bold text-emerald-100">{preferenceCentreStatus.sendMessage}</p>
          <p class="rounded-xl border border-slate-300/20 bg-white/5 p-4 text-sm font-bold text-slate-100">{preferenceCentreStatus.verificationMessage}</p>
        </div>
        <div class="mt-8">
          <a href="/account/preferences" class="inline-flex min-h-12 items-center justify-center rounded-full px-6 text-sm font-bold outline-none focus-visible:ring-4 focus-visible:ring-white/40" style="background:#93D500;color:#0A0A0A">Manage your preferences &rarr;</a>
          <p class="mt-2 text-xs text-slate-400">{preferenceCentreStatus.signedInMessage}</p>
        </div>
        <nav aria-label="Preference Centre sections" class="mt-8 flex flex-wrap gap-3 text-sm font-bold">
          <a href="#communication" class="rounded-full border border-slate-600 px-4 py-3 text-white focus-visible:ring-2 focus-visible:ring-brand-primary">What we send</a>
          <a href="#channels" class="rounded-full border border-slate-600 px-4 py-3 text-white focus-visible:ring-2 focus-visible:ring-brand-primary">Channels</a>
          <a href="#data-use" class="rounded-full border border-slate-600 px-4 py-3 text-white focus-visible:ring-2 focus-visible:ring-brand-primary">Data use</a>
          <a href="#support" class="rounded-full bg-brand-primary px-4 py-3 text-slate-950 focus-visible:ring-2 focus-visible:ring-white">Get help</a>
        </nav>
      </div>
    </section>

    <section id="communication" aria-labelledby="communication-heading" class="scroll-mt-24 bg-slate-50">
      <div class="container mx-auto max-w-6xl px-4 py-14 lg:px-8">
        <div class="max-w-3xl">
          <p class="text-sm font-bold text-brand-primary">What GoldPlus sends you</p>
          <h2 id="communication-heading" class="mt-2 text-3xl font-black text-slate-950">Messages about your orders, and replies when you ask for help</h2>
          <p class="mt-3 text-sm leading-relaxed text-slate-600">These are the messages tied to something you started — an order you placed or a question you sent us.</p>
        </div>
        <div class="mt-8 grid gap-5 md:grid-cols-2">
          {messagesWeSend.map((item) => (
            <article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
              <h3 class="text-lg font-black text-slate-950">{item.title}</h3>
              <p class="mt-4 text-sm leading-relaxed text-slate-600">{item.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="service" aria-labelledby="service-heading" class="bg-white">
      <div class="container mx-auto max-w-6xl px-4 py-14 lg:px-8">
        <div class="max-w-3xl">
          <p class="text-sm font-bold text-brand-primary">Getting help</p>
          <h2 id="service-heading" class="mt-2 text-3xl font-black text-slate-950">What support can help you with</h2>
          <p class="mt-3 text-sm leading-relaxed text-slate-600">Support may ask for an order reference, or confirm who you are, before discussing details tied to your account.</p>
        </div>
        <div class="mt-8 grid gap-5 md:grid-cols-3">
          {servicePreferences.map((item) => (
            <article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
              <h3 class="text-lg font-black text-slate-950">{item.title}</h3>
              <p class="mt-4 text-sm leading-relaxed text-slate-600">{item.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="channels" aria-labelledby="channels-heading" class="scroll-mt-24 border-y border-slate-200 bg-slate-50">
      <div class="container mx-auto max-w-6xl px-4 py-14 lg:px-8">
        <div class="max-w-3xl">
          <p class="text-sm font-bold text-brand-primary">Channels</p>
          <h2 id="channels-heading" class="mt-2 text-3xl font-black text-slate-950">How GoldPlus uses each channel</h2>
          <p class="mt-3 text-sm leading-relaxed text-slate-600">{preferenceCentreStatus.sendMessage} Each channel below is used only for the purpose described.</p>
        </div>
        <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {customerChannelGuidance.map((channel) => (
            <article class="rounded-2xl border border-slate-200 bg-white p-5">
              <h3 class="font-black text-slate-950">{channel.name}</h3>
              <p class="mt-3 text-sm leading-relaxed text-slate-600">{channel.usedFor}</p>
              <p class="mt-4 border-t border-slate-100 pt-3 text-xs leading-relaxed text-slate-500">{channel.note}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="data-use" aria-labelledby="data-heading" class="scroll-mt-24 bg-white">
      <div class="container mx-auto grid max-w-6xl gap-8 px-4 py-14 lg:grid-cols-[0.8fr_1.2fr] lg:px-8">
        <div>
          <p class="text-sm font-bold text-brand-primary">Data use</p>
          <h2 id="data-heading" class="mt-2 text-3xl font-black text-slate-950">How GoldPlus treats your preference information</h2>
        </div>
        <ul class="grid gap-3 sm:grid-cols-2">
          {dataUsePrinciples.map((item) => (
            <li class="rounded-xl border border-slate-200 p-4 text-sm leading-relaxed text-slate-700">{item}</li>
          ))}
        </ul>
      </div>
    </section>

    <section aria-labelledby="rights-heading" class="border-y border-slate-200 bg-slate-50">
      <div class="container mx-auto grid max-w-6xl gap-8 px-4 py-14 lg:grid-cols-[0.8fr_1.2fr] lg:px-8">
        <div>
          <p class="text-sm font-bold text-brand-primary">Your choices</p>
          <h2 id="rights-heading" class="mt-2 text-3xl font-black text-slate-950">Questions you can raise with GoldPlus</h2>
        </div>
        <ul class="grid gap-3 sm:grid-cols-2">
          {customerRightsGuidance.map((item) => (
            <li class="rounded-xl border border-slate-200 bg-white p-4 text-sm leading-relaxed text-slate-700">{item}</li>
          ))}
        </ul>
      </div>
    </section>

    <section id="support" aria-labelledby="support-heading" class="scroll-mt-24 bg-white">
      <div class="container mx-auto max-w-5xl px-4 py-14 lg:px-8">
        <div class="rounded-3xl border border-slate-200 bg-slate-50 p-7 text-center shadow-sm sm:p-10">
          <p class="text-sm font-bold text-brand-primary">Changing a preference</p>
          <h2 id="support-heading" class="mt-3 text-3xl font-black text-slate-950">Two ways to change your settings</h2>
          <p class="mx-auto mt-4 max-w-3xl text-sm leading-relaxed text-slate-600">
            {preferenceCentreStatus.signedInMessage} {preferenceCentreStatus.supportMessage}
          </p>
          <nav aria-label="Preference support and policy links" class="mt-8 flex flex-wrap justify-center gap-3">
            <a href="/account/preferences" class="inline-flex min-h-11 items-center rounded-full bg-slate-950 px-6 py-3 text-sm font-bold text-white outline-none focus-visible:ring-2 focus-visible:ring-brand-primary">Manage in your account</a>
            {supportActions.map((action) => (
              <a href={action.href} title={action.description} class="inline-flex min-h-11 items-center rounded-full border border-slate-300 px-6 py-3 text-sm font-bold text-slate-800 outline-none focus-visible:ring-2 focus-visible:ring-brand-primary">{action.label}</a>
            ))}
          </nav>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
