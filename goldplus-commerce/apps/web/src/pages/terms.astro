---
import BaseLayout from '../layouts/BaseLayout.astro';
import { policyBySlug, POLICY_STATUS_LABEL } from '../lib/legal-policies';
const policy = policyBySlug('terms')!;
import CmsPolicyDocument from '../components/CmsPolicyDocument.astro';
import { fetchPublishedPolicy } from '../lib/legalCms';
// Wave 2C: a PUBLISHED CMS version replaces the wording below; until one
// exists this page is the authoritative published policy.
const cms = await fetchPublishedPolicy('terms');
---

<BaseLayout title="Terms of service | GoldPlus">
  <main id="main-content">
    {cms ? <CmsPolicyDocument policy={cms} /> : <>
    <header class="border-b border-slate-200 bg-gradient-to-b from-slate-50 to-white py-12 sm:py-16">
      <div class="container mx-auto max-w-4xl px-4 lg:px-8">
        <p class="text-xs font-black uppercase tracking-[0.18em] text-brand-primary">Customer policy</p>
        <h1 class="mt-3 text-3xl font-black tracking-tight text-gray-900 sm:text-4xl">Terms of service</h1>
        <p class="mt-4 max-w-3xl text-sm leading-relaxed text-slate-600 sm:text-base">
          These terms apply to your use of the GoldPlus website and to orders placed through it.
        </p>
        <p class="mt-4 inline-flex flex-wrap items-center gap-2 text-xs font-bold text-slate-600">
          <span class="rounded-full border border-emerald-300 bg-emerald-50 px-3 py-1 text-emerald-900">{POLICY_STATUS_LABEL[policy.status]}</span>
          <span class="rounded-full border border-slate-200 bg-slate-50 px-3 py-1">Version {policy.version}</span>
          <span class="rounded-full border border-slate-200 bg-slate-50 px-3 py-1">Effective date: {policy.effectiveDate}</span>
        </p>
      </div>
    </header>

    <div class="container mx-auto max-w-4xl px-4 py-10 sm:py-14 lg:px-8">
      <nav aria-label="Terms sections" class="mb-10 rounded-2xl border border-slate-200 bg-slate-50 p-5">
        <h2 class="font-black text-gray-900">On this page</h2>
        <ul class="mt-3 flex flex-wrap gap-x-5 gap-y-3 text-sm font-bold">
          <li><a class="text-slate-700 underline decoration-slate-300 underline-offset-4 hover:text-gray-950 focus-visible:ring-2 focus-visible:ring-brand-primary" href="#orders">Orders</a></li>
          <li><a class="text-slate-700 underline decoration-slate-300 underline-offset-4 hover:text-gray-950 focus-visible:ring-2 focus-visible:ring-brand-primary" href="#delivery">Delivery</a></li>
          <li><a class="text-slate-700 underline decoration-slate-300 underline-offset-4 hover:text-gray-950 focus-visible:ring-2 focus-visible:ring-brand-primary" href="#returns">Returns and warranty</a></li>
          <li><a class="text-slate-700 underline decoration-slate-300 underline-offset-4 hover:text-gray-950 focus-visible:ring-2 focus-visible:ring-brand-primary" href="#updates">Updates</a></li>
        </ul>
      </nav>

      <div class="space-y-10 text-sm leading-relaxed text-slate-700 sm:text-base">
        <section aria-labelledby="using-goldplus">
          <h2 id="using-goldplus" class="text-xl font-black text-gray-900">Using GoldPlus</h2>
          <p class="mt-3">
            Please use the website lawfully and provide accurate information when placing an order or asking for support. Product information, availability and order details should be checked where the website asks you to confirm them.
          </p>
        </section>

        <section id="orders" aria-labelledby="orders-heading" class="scroll-mt-24">
          <h2 id="orders-heading" class="text-xl font-black text-gray-900">Orders and payment information</h2>
          <p class="mt-3">
            An order reference helps identify a request, but it is not by itself proof that an order is paid, confirmed or dispatched. For order-specific support, contact GoldPlus support with the reference and the contact detail used at checkout.
          </p>
        </section>

        <section id="delivery" aria-labelledby="delivery-heading" class="scroll-mt-24">
          <h2 id="delivery-heading" class="text-xl font-black text-gray-900">Delivery</h2>
          <p class="mt-3">
            Delivery timing, cost and support depend on your location, product availability and order details. GoldPlus support can help confirm the information available for a specific order.
          </p>
        </section>

        <section id="returns" aria-labelledby="returns-heading" class="scroll-mt-24">
          <h2 id="returns-heading" class="text-xl font-black text-gray-900">Returns, warranty and replacements</h2>
          <p class="mt-3">
            Warranty, returns and replacements depend on the product, order details and applicable GoldPlus policy. Contact support before returning an item so the relevant details and next steps can be checked.
          </p>
        </section>

        <section aria-labelledby="support-heading">
          <h2 id="support-heading" class="text-xl font-black text-gray-900">Customer support</h2>
          <p class="mt-3">
            Support can help review product and order information. Never send passwords, payment credentials or one-time codes when requesting help.
          </p>
        </section>

        <section id="updates" aria-labelledby="updates-heading" class="scroll-mt-24">
          <h2 id="updates-heading" class="text-xl font-black text-gray-900">Updates to this guidance</h2>
          <p class="mt-3">
            GoldPlus may update these terms from time to time as products, services and formal policy wording develop. The version published on this page is the current public guidance.
          </p>
        </section>
      </div>

      <aside aria-labelledby="terms-help" class="mt-12 rounded-2xl border border-amber-200 bg-amber-50/60 p-6 sm:p-8">
        <h2 id="terms-help" class="text-lg font-black text-amber-950">Need order-specific help?</h2>
        <p class="mt-2 text-sm leading-relaxed text-amber-900">Have your order reference ready and ask support to verify what applies to your order.</p>
        <div class="mt-5 flex flex-col gap-3 sm:flex-row">
          <a href="/support" class="inline-flex min-h-11 items-center justify-center rounded-full bg-slate-900 px-6 py-3 text-center text-sm font-bold text-white outline-none hover:bg-black focus-visible:ring-2 focus-visible:ring-slate-900 focus-visible:ring-offset-2">Contact support</a>
          <a href="/privacy" class="inline-flex min-h-11 items-center justify-center rounded-full border border-amber-300 bg-white px-6 py-3 text-center text-sm font-bold text-amber-950 outline-none hover:border-amber-500 focus-visible:ring-2 focus-visible:ring-brand-primary">Privacy guidance</a>
        </div>
      </aside>
    </div>
  </>}
  </main>
</BaseLayout>
