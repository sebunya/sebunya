---
import { jsonApiHeaders } from '../lib/forwardClient';
import BaseLayout from '../layouts/BaseLayout.astro';
import FormField from '../components/FormField.astro';
import FormFeedback from '../components/FormFeedback.astro';
import { apiBase } from '../lib/api';
import { getBusinessInfo } from '../lib/businessInfo';

/**
 * The visitor's address, forwarded so abuse control counts THEM and not this
 * container. Reading it can throw in a prerendered context, so it degrades to
 * the shared bucket rather than breaking the page.
 */
let clientAddress: string | null = null;
try {
  clientAddress = Astro.clientAddress ?? null;
} catch {
  clientAddress = null;
}


const biz = await getBusinessInfo();

/**
 * Forgot password.
 *
 * Phone first. The phone number is the account for most customers and an SMS
 * arrives; email is kept as the second option for customers who signed up
 * with one. Either way this page tells you the same thing whatever you type:
 * a page that says "no account with that number" is a free customer list.
 *
 * After a phone request the customer stays on the same journey: the code
 * form is shown here, posts to /reset-password, and carries the phone as a
 * hidden field so nothing has to be typed twice.
 */

type Channel = 'phone' | 'email';

let channel: Channel = 'phone';
let status: 'success' | 'error' | null = null;
let message = '';
let submittedPhone = '';
let submittedEmail = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  channel = String(form.get('channel') ?? 'phone') === 'email' ? 'email' : 'phone';
  submittedPhone = String(form.get('phone') ?? '').trim();
  submittedEmail = String(form.get('email') ?? '').trim();

  try {
    const res =
      channel === 'phone'
        ? await fetch(`${apiBase}/auth/password/forgot-sms`, {
            method: 'POST',
            headers: jsonApiHeaders(clientAddress),
            body: JSON.stringify({ phone: submittedPhone }),
          })
        : await fetch(`${apiBase}/auth/password/forgot`, {
            method: 'POST',
            headers: jsonApiHeaders(clientAddress),
            body: JSON.stringify({ email: submittedEmail }),
          });
    const json = await res.json().catch(() => null);
    if (json?.success) {
      status = 'success';
      message =
        json.data?.message ??
        (channel === 'phone'
          ? 'If that number is on a GoldPlus account, we have sent it a 6 digit code by SMS.'
          : 'If that email address has an account, we have made a reset link for it.');
    } else {
      status = 'error';
      message = 'We could not process that request. Please try again shortly.';
    }
  } catch {
    status = 'error';
    message = 'We could not reach the server. Please try again shortly.';
  }
}

const phoneSent = status === 'success' && channel === 'phone';
const emailSent = status === 'success' && channel === 'email';
---

<BaseLayout robotsMeta="noindex,follow" title="Reset your password" description="Get a code by SMS, or a link by email, to set a new GoldPlus password.">
  <div class="min-h-[60vh] flex items-center justify-center bg-slate-50 py-16 px-6">
    <div class="w-full max-w-md">
      <h1 class="text-2xl font-black tracking-tight text-brand-charcoal mb-2">Reset your password</h1>

      {status !== 'success' && (
        <>
          <p class="text-slate-500 mb-6 text-sm leading-relaxed">
            Enter the phone number on your account and we send you a 6 digit code by SMS. The code works once and expires in 10 minutes.
          </p>

          <FormFeedback status={status} message={message} />

          <form method="POST" action="/forgot-password" novalidate class="bg-white p-8 rounded-2xl border border-slate-200/80 shadow-xs space-y-5">
            <input type="hidden" name="channel" value="phone" />
            <FormField id="phone" name="phone" label="Phone number" type="tel" required autocomplete="tel" defaultValue={submittedPhone} placeholder="07XX XXX XXX" />
            <button
              type="submit"
              class="w-full bg-brand-primary text-gray-955 py-2.5 rounded-full font-bold text-xs tracking-wider uppercase hover:shadow-lg hover:shadow-brand-primary/20 transition-all outline-none cursor-pointer focus-visible:ring-4 focus-visible:ring-brand-primary/30"
            >
              Send me a code
            </button>
            <p class="text-xs text-slate-400 text-center leading-relaxed">
              Remembered it? <a href="/login" class="font-bold text-slate-600 underline hover:text-gray-900">Sign in</a>
            </p>
          </form>

          <details class="mt-6 bg-white rounded-2xl border border-slate-200/80 shadow-xs" open={channel === 'email' && status === 'error'}>
            <summary class="cursor-pointer px-6 py-4 text-sm font-bold text-slate-700">Prefer a link by email?</summary>
            <form method="POST" action="/forgot-password" novalidate class="px-6 pb-6 space-y-4">
              <input type="hidden" name="channel" value="email" />
              <p class="text-xs text-slate-500 leading-relaxed">
                We make a reset link for the email you signed up with. Email does not always arrive, so the SMS code above is usually faster.
              </p>
              <FormField id="email" name="email" label="Email" type="email" required autocomplete="email" defaultValue={submittedEmail} />
              <button
                type="submit"
                class="w-full border border-slate-300 text-slate-700 py-2.5 rounded-full font-bold text-xs tracking-wider uppercase hover:bg-slate-50 transition-all outline-none cursor-pointer focus-visible:ring-4 focus-visible:ring-brand-primary/30"
              >
                Send reset link
              </button>
            </form>
          </details>
        </>
      )}

      {phoneSent && (
        <>
          <p class="text-slate-500 mb-6 text-sm leading-relaxed">{message}</p>
          <form method="POST" action="/reset-password" novalidate class="bg-white p-8 rounded-2xl border border-slate-200/80 shadow-xs space-y-5">
            <input type="hidden" name="phone" value={submittedPhone} />
            <FormField id="code" name="code" label="6 digit code from the SMS" type="text" required autocomplete="one-time-code" inputmode="numeric" placeholder="123456" />
            <FormField id="password" name="password" label="New password" type="password" required autocomplete="new-password" />
            <FormField id="confirmPassword" name="confirmPassword" label="Confirm new password" type="password" required autocomplete="new-password" />
            <button
              type="submit"
              class="w-full bg-brand-primary text-gray-955 py-2.5 rounded-full font-bold text-xs tracking-wider uppercase hover:shadow-lg hover:shadow-brand-primary/20 transition-all outline-none cursor-pointer focus-visible:ring-4 focus-visible:ring-brand-primary/30"
            >
              Set new password
            </button>
            <p class="text-xs text-slate-400 text-center leading-relaxed">
              No SMS after a minute? <a href="/forgot-password" class="font-bold text-slate-600 underline hover:text-gray-900">Ask for another code</a>
              or call us on <a href={biz.phoneDial} class="font-bold text-slate-600 underline">{biz.phoneDisplay}</a>.
            </p>
          </form>
        </>
      )}

      {emailSent && (
        <div class="bg-white p-8 rounded-2xl border border-slate-200/80 shadow-xs">
          <FormFeedback status="success" message={message} />
          <p class="text-sm text-slate-600 leading-relaxed mt-4">
            Check your inbox and your spam folder. If nothing arrives within a few minutes,
            <a href="/forgot-password" class="font-bold text-slate-700 underline">ask for a code by SMS instead</a>, or call us on
            <a href={biz.phoneDial} class="font-bold text-slate-700 underline">{biz.phoneDisplay}</a> and we will get you back in.
          </p>
          <a href="/login" class="mt-5 inline-block text-xs font-bold text-slate-600 underline">Back to sign in</a>
        </div>
      )}
    </div>
  </div>
</BaseLayout>
