---
import BaseLayout from '../layouts/BaseLayout.astro';
import FormField from '../components/FormField.astro';
import FormFeedback from '../components/FormFeedback.astro';
import { apiBase } from '../lib/api';
import { getBusinessInfo } from '../lib/businessInfo';

const biz = await getBusinessInfo();

/**
 * Forgot password (0106).
 *
 * A customer who forgot their password had no way back into their account.
 *
 * This page tells you the same thing whatever you type. That is not vagueness
 * — a page that says "no account with that email" is a free customer list, and
 * it is how credential stuffing picks its targets. The acknowledgement is
 * deliberately identical for an address that exists and one that does not.
 */

let status: 'success' | 'error' | null = null;
let message = '';
let submittedEmail = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  submittedEmail = String(form.get('email') ?? '').trim();

  try {
    const res = await fetch(`${apiBase}/auth/password/forgot`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email: submittedEmail }),
    });
    const json = await res.json().catch(() => null);
    if (json?.success) {
      status = 'success';
      message = json.data?.message ?? 'If that email address has an account, a reset link is on its way.';
    } else {
      status = 'error';
      message = 'We could not process that request. Please try again shortly.';
    }
  } catch {
    status = 'error';
    message = 'We could not reach the server. Please try again shortly.';
  }
}
---

<BaseLayout robotsMeta="noindex,follow" title="Reset your password" description="Get a link to set a new GoldPlus password.">
  <div class="min-h-[60vh] flex items-center justify-center bg-slate-50 py-16 px-6">
    <div class="w-full max-w-md">
      <h1 class="text-2xl font-black tracking-tight text-brand-charcoal mb-2">Reset your password</h1>
      <p class="text-slate-500 mb-6 text-sm leading-relaxed">
        Enter the email you signed up with and we will make a reset link for it. Email does not always arrive, so if
        nothing comes within a few minutes, call us and we will get you back in.
      </p>

      <FormFeedback status={status} message={message} />

      {status !== 'success' && (
        <form method="POST" action="/forgot-password" novalidate class="bg-white p-8 rounded-2xl border border-slate-200/80 shadow-xs space-y-5">
          <FormField id="email" name="email" label="Email" type="email" required autocomplete="email" defaultValue={submittedEmail} />
          <button
            type="submit"
            class="w-full bg-brand-primary text-gray-955 py-2.5 rounded-full font-bold text-xs tracking-wider uppercase hover:shadow-lg hover:shadow-brand-primary/20 transition-all outline-none cursor-pointer focus-visible:ring-4 focus-visible:ring-brand-primary/30"
          >
            Send reset link
          </button>
          <p class="text-xs text-slate-400 text-center leading-relaxed">
            Remembered it? <a href="/login" class="font-bold text-slate-600 underline hover:text-gray-900">Sign in</a>
          </p>
        </form>
      )}

      {status === 'success' && (
        <div class="bg-white p-8 rounded-2xl border border-slate-200/80 shadow-xs">
          {/*
            No "the address may not have an account — create one": that
            diagnosis was guessed, and the advice it led to (registering a
            second account on an email they already own) either fails on the
            unique email or orphans their orders and points. The only honest
            next step when nothing arrives is a person.
          */}
          <p class="text-sm text-slate-600 leading-relaxed">
            Check your inbox and your spam folder. If nothing arrives within a few minutes, call us on
            <a href={biz.phoneDial} class="font-bold text-slate-700 underline">{biz.phoneDisplay}</a> or
            <a href="/support" class="font-bold text-slate-700 underline">contact support</a> and we will get you back in.
          </p>
          <a href="/login" class="mt-5 inline-block text-xs font-bold text-slate-600 underline">Back to sign in</a>
        </div>
      )}
    </div>
  </div>
</BaseLayout>
