---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getBusinessInfo } from '../../lib/businessInfo';
import { serializeJsonLd, breadcrumbJsonLd } from '../../lib/jsonld';
import { SITE_ORIGIN } from '../../lib/sitemap';
import { evaluateLocalPageGate } from '../../lib/categoryHubs';

/**
 * Sharp L4 (physical availability): say plainly that GoldPlus reaches beyond Kampala. Described qualitatively, like the
 * Kampala & Wakiso page: no fares here, because the bus/taxi fare depends on the town and the parcel and is shown at
 * checkout by the one quoting service (docs/delivery/CONTRACT.md). Same gate as the Kampala page.
 */
const biz = await getBusinessInfo();
const gatePass = evaluateLocalPageGate(biz);
const canonicalUrl = `${SITE_ORIGIN}/delivery/upcountry`;
const crumbs = [
  { name: 'Home', url: `${SITE_ORIGIN}/` },
  { name: 'Delivery upcountry', url: canonicalUrl },
];
---
<BaseLayout
  title="Delivery Upcountry by Bus and Taxi, Across Uganda | GoldPlus"
  description="GoldPlus sends orders upcountry by bus and taxi parcel. Choose your town at checkout, pay for the goods online and the fare to the carrier when you collect."
  canonicalUrl={canonicalUrl}
  robotsMeta={gatePass ? undefined : 'noindex,follow'}
>
  <script type="application/ld+json" set:html={serializeJsonLd(breadcrumbJsonLd(crumbs))} />
  <header class="border-b border-slate-800 bg-slate-950 py-10 text-white sm:py-12" data-upcountry-page>
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl font-black tracking-tight sm:text-4xl">Delivery upcountry</h1>
      <p class="mt-3 max-w-2xl text-sm leading-relaxed text-slate-300 sm:text-base">Outside Kampala and Wakiso, GoldPlus sends your order as a bus or taxi parcel to your town, and you collect it from the carrier.</p>
    </div>
  </header>
  <main class="mx-auto w-full min-w-0 max-w-7xl px-4 py-7 sm:px-6 sm:py-10 lg:px-8">
    <ol class="grid grid-cols-1 gap-5 sm:grid-cols-3">
      <li class="rounded-2xl border border-slate-200 bg-white p-6">
        <h2 class="text-base font-black text-slate-900">1. Choose your town at checkout</h2>
        <p class="mt-2 text-sm leading-relaxed text-slate-600">Pick upcountry delivery and your town. Where the carrier's fare is known, checkout shows it before you order.</p>
      </li>
      <li class="rounded-2xl border border-slate-200 bg-white p-6">
        <h2 class="text-base font-black text-slate-900">2. Pay for the goods</h2>
        <p class="mt-2 text-sm leading-relaxed text-slate-600">You pay for the goods online. The fare is not added to your order: you pay it to the carrier when you collect.</p>
      </li>
      <li class="rounded-2xl border border-slate-200 bg-white p-6">
        <h2 class="text-base font-black text-slate-900">3. Collect it</h2>
        <p class="mt-2 text-sm leading-relaxed text-slate-600">We text you when your order is dispatched, and call if anything about the parcel needs confirming.{biz.phoneDisplay ? ` Questions? Call ${biz.phoneDisplay}.` : ''}</p>
      </li>
    </ol>
    <section class="mt-8 rounded-2xl border border-slate-200 bg-white p-6">
      <h2 class="text-base font-black text-slate-900">Buying for a shop upcountry?</h2>
      <p class="mt-2 text-sm leading-relaxed text-slate-600">Shops can stock GoldPlus at dealer prices. <a href="/dealers/apply" class="underline">Apply to be a dealer</a> or see <a href="/bulk" class="underline">bulk prices</a>.</p>
      <div class="mt-4 flex flex-wrap gap-3 text-sm font-bold">
        <a href="/shop" class="rounded-full bg-slate-950 px-5 py-2.5 text-white hover:bg-brand-primary hover:text-slate-950">Browse the shop</a>
        <a href="/delivery/kampala-wakiso" class="rounded-full border border-slate-300 px-5 py-2.5 text-slate-700 hover:border-brand-primary">Delivery in Kampala &amp; Wakiso</a>
      </div>
    </section>
  </main>
</BaseLayout>
