---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BulkRequestSummary from '../../components/bulk/BulkRequestSummary.astro';
import { lookupBulkQuote, type BulkQuoteBuyerView } from '../../lib/bulkQuoteView';
import { whatsappSupportNumber } from '../../lib/api';

/**
 * A buyer checks a bulk quote request with the reference and the phone number
 * they gave, the way /track-order works. The API answers one generic "not
 * found" for any mismatch; the storefront budgets POSTs per visitor.
 */
Astro.response.headers.set('Cache-Control', 'no-store');

let request: BulkQuoteBuyerView | null = null;
let errorMsg: string | null = null;
let reference = (Astro.url.searchParams.get('reference') ?? '').trim().toUpperCase().slice(0, 16);
let phone = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  reference = String(form.get('reference') ?? '').trim().toUpperCase().slice(0, 16);
  phone = String(form.get('phone') ?? '').trim().slice(0, 32);
  if (!reference || !phone) {
    errorMsg = 'Enter both your reference and the phone number you gave.';
  } else {
    const found = await lookupBulkQuote(reference, phone);
    if (found.ok) request = found.request;
    else errorMsg = found.message;
  }
}
const whatsappUrl = `https://wa.me/${whatsappSupportNumber}?text=${encodeURIComponent('Hello GoldPlus, I have a question about my bulk quote request.')}`;
---

<BaseLayout title="Bulk request status | GoldPlus" description="Check a bulk quote request with your reference and phone number." robotsMeta="noindex,nofollow">
  <div class="container mx-auto max-w-3xl px-4 py-10 lg:px-8">
    <h1 class="text-2xl font-black tracking-tight text-gray-950 sm:text-3xl">Bulk request status</h1>
    <p class="mt-3 text-base leading-relaxed text-slate-700">
      Enter the reference from your text message (it starts with BQ) and the phone number you gave.
    </p>

    <form method="POST" action="/bulk/status" class="mt-6 grid grid-cols-1 gap-4 rounded-2xl border border-slate-200 bg-white p-5 sm:grid-cols-2 sm:p-6" novalidate>
      <div>
        <label for="bulk-ref" class="block text-sm font-bold text-gray-950">Reference</label>
        <input id="bulk-ref" name="reference" value={reference} required autocomplete="off" autocapitalize="characters" spellcheck="false" placeholder="BQ-7K3M9P"
          aria-describedby={errorMsg ? 'bulk-status-error' : undefined}
          class="mt-1 block min-h-11 w-full rounded-xl border border-slate-300 px-3 font-mono text-base uppercase outline-none focus-visible:border-slate-900 focus-visible:ring-2 focus-visible:ring-brand-primaryInk" />
      </div>
      <div>
        <label for="bulk-phone" class="block text-sm font-bold text-gray-950">Phone number</label>
        <input id="bulk-phone" name="phone" type="tel" inputmode="tel" value={phone} required autocomplete="tel" placeholder="07XX XXX XXX"
          aria-describedby={errorMsg ? 'bulk-status-error' : undefined}
          class="mt-1 block min-h-11 w-full rounded-xl border border-slate-300 px-3 text-base outline-none focus-visible:border-slate-900 focus-visible:ring-2 focus-visible:ring-brand-primaryInk" />
      </div>
      {errorMsg && <p id="bulk-status-error" role="alert" class="text-sm font-bold text-red-700 sm:col-span-2">{errorMsg}</p>}
      <button type="submit" class="min-h-11 rounded-full bg-slate-900 px-6 py-3 text-sm font-bold text-white outline-none hover:bg-black focus-visible:ring-2 focus-visible:ring-slate-900 focus-visible:ring-offset-2 sm:col-span-2">Check status</button>
    </form>

    {request && <div class="mt-8"><BulkRequestSummary request={request} /></div>}

    <p class="mt-8 text-sm text-slate-700">
      Questions about a request? <a class="font-bold underline underline-offset-4" href={whatsappUrl}>Ask us on WhatsApp</a>, or <a class="font-bold underline underline-offset-4" href="/bulk">start a new bulk list</a>.
    </p>
  </div>
</BaseLayout>
