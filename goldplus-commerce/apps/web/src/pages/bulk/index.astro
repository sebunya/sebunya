---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Notice from '../../components/Notice.astro';
import { apiBase, whatsappSupportNumber } from '../../lib/api';
import { fetchApprovedCatalogueWithStatus } from '../../lib/catalogue';
import { getTaxonomy } from '../../lib/taxonomy';
import { toBulkRows, filterGroups, searchTextOf } from '../../lib/bulkCatalogue';
import { formatUgx } from '../../lib/money';
import { productSrcset } from '../../lib/imageSrcset';
import { UGANDA_DISTRICTS } from '@goldplus/shared';
import { CART_LINE_QUANTITY_CAP, MAX_BULK_LINES, MAX_BULK_LINE_QUANTITY } from '../../lib/bulkList';

/**
 * Bulk order builder (docs/bulk-buying/DESIGN.md).
 *
 * Every approved public product in one compact list with a quantity box each.
 * Rows are real server-rendered HTML; the client module (lib/bulkBuilderClient)
 * adds filtering, steppers, paste, the saved list and the two ways out: the
 * basket for lines of 99 or fewer, and a quote request for everything.
 *
 * Public facts only: list price and in/out of stock. No stock counts, no floor,
 * no dealer price, no cost (the rows come from lib/bulkCatalogue's BulkRow).
 */
const taxonomy = await getTaxonomy();
const read = await fetchApprovedCatalogueWithStatus(apiBase);
const rows = toBulkRows(read.products, taxonomy);
const groups = filterGroups(rows, taxonomy);
const partial = rows.length > 0 && !read.complete;
if (partial || rows.length === 0) Astro.response.headers.set('Cache-Control', 'no-store');

const buyerParam = Astro.url.searchParams.get('buyer');
const initialBuyer = ['retail', 'wholesale', 'corporate', 'dealer'].includes(buyerParam ?? '') ? buyerParam : '';
const buyerOptions = [
  { v: 'wholesale', l: 'Shop or reseller' },
  { v: 'corporate', l: 'Business, school or office' },
  { v: 'dealer', l: 'Existing GoldPlus dealer' },
  { v: 'retail', l: 'Personal or other' },
];
const districts = [...UGANDA_DISTRICTS].sort((a, b) => a.localeCompare(b));
// Kampala's today, for the needed-by date's minimum.
const todayKampala = new Date(Date.now() + 3 * 60 * 60 * 1000).toISOString().slice(0, 10);
const groupsAttr = JSON.stringify(groups.map((g) => ({ slug: g.slug, subs: g.subcategories.map((s) => ({ slug: s.slug, name: s.name, count: s.count })) })));
const whatsappUrl = `https://wa.me/${whatsappSupportNumber}?text=${encodeURIComponent('Hello GoldPlus, I would like help with a bulk order.')}`;
---

<BaseLayout
  title="Bulk order builder | GoldPlus"
  description="Build a bulk order across every GoldPlus category: pick quantities for many products, add small quantities to your basket or send the whole list for a volume quote."
>
  <div class="border-b border-slate-200 bg-slate-50">
    <div class="container mx-auto px-4 py-8 lg:px-8">
      <p class="text-xs font-black uppercase tracking-[0.18em] text-brand-primaryInk">Bulk and dealer orders</p>
      <h1 class="mt-2 text-2xl font-black tracking-tight text-gray-950 sm:text-3xl">Bulk order builder</h1>
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-slate-700 sm:text-base">
        Type a quantity next to every product you need, across all categories. Your list is saved on this device.
        Buy up to {CART_LINE_QUANTITY_CAP} of a product straight from your basket, or send the whole list and our sales team will call you with a volume price.
      </p>
      <p class="mt-2 text-sm text-slate-700">
        Already sent a list? <a class="font-bold underline underline-offset-4" href="/bulk/status">Check its status</a>.
      </p>
    </div>
  </div>

  <noscript>
    <div class="container mx-auto px-4 pt-6 lg:px-8">
      <p class="rounded-xl border border-amber-300 bg-amber-50 p-4 text-sm text-amber-900">
        The bulk builder needs JavaScript. You can still <a class="font-bold underline" href="/quote-request">request a quote with our simple form</a> or <a class="font-bold underline" href={whatsappUrl}>message us on WhatsApp</a>.
      </p>
    </div>
  </noscript>

  <div class="container mx-auto px-4 pb-28 pt-6 lg:px-8 lg:pb-12" id="bulk-root" data-groups={groupsAttr}>
    {partial && <div class="mb-4"><Notice kind="warning" message="Some products could not be loaded just now, so this list may be incomplete. Please refresh the page." /></div>}
    {rows.length === 0 && <div class="mb-4"><Notice kind="warning" message="The product list is not available right now. Please try again shortly, or message us on WhatsApp." /></div>}

    <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_380px] lg:gap-8">
      <section aria-labelledby="bulk-products-heading" class="min-w-0">
        <h2 id="bulk-products-heading" class="sr-only">Products</h2>

        <details class="mb-4 rounded-2xl border border-slate-200 bg-white">
          <summary class="flex min-h-11 cursor-pointer items-center px-4 py-3 text-sm font-bold text-gray-950">Paste a list of codes</summary>
          <div class="border-t border-slate-100 p-4">
            <label for="bulk-paste" class="block text-sm font-bold text-gray-950">One product per line: code and quantity</label>
            <p id="bulk-paste-help" class="mt-1 text-xs text-slate-600">For example <span class="font-mono">GP-C08, 50</span> or <span class="font-mono">GP-C08 x50</span>. You can paste two columns straight from a spreadsheet.</p>
            <textarea id="bulk-paste" rows="5" aria-describedby="bulk-paste-help" class="mt-2 block w-full rounded-xl border border-slate-300 p-3 font-mono text-sm outline-none focus-visible:border-slate-900 focus-visible:ring-2 focus-visible:ring-brand-primaryInk" spellcheck="false" autocapitalize="characters"></textarea>
            <button type="button" id="bulk-paste-add" class="mt-3 min-h-11 rounded-full bg-slate-900 px-5 text-sm font-bold text-white outline-none hover:bg-black focus-visible:ring-2 focus-visible:ring-slate-900 focus-visible:ring-offset-2">Add to my list</button>
            <div id="bulk-paste-result" class="mt-3 text-sm" role="status" aria-live="polite"></div>
          </div>
        </details>

        <div class="mb-3 grid grid-cols-1 gap-3 sm:grid-cols-3">
          <div class="sm:col-span-3">
            <label for="bulk-search" class="block text-sm font-bold text-gray-950">Search by name or model code</label>
            <input id="bulk-search" type="search" autocomplete="off" placeholder="e.g. power bank, GP-C08" class="mt-1 block min-h-11 w-full rounded-xl border border-slate-300 px-3 text-base outline-none focus-visible:border-slate-900 focus-visible:ring-2 focus-visible:ring-brand-primaryInk" />
          </div>
          <div>
            <label for="bulk-cat" class="block text-sm font-bold text-gray-950">Category</label>
            <select id="bulk-cat" class="mt-1 block min-h-11 w-full rounded-xl border border-slate-300 bg-white px-3 text-base outline-none focus-visible:ring-2 focus-visible:ring-brand-primaryInk">
              <option value="">All categories ({rows.length})</option>
              {groups.map((g) => <option value={g.slug}>{g.name} ({g.count})</option>)}
            </select>
          </div>
          <div>
            <label for="bulk-sub" class="block text-sm font-bold text-gray-950">Type</label>
            <select id="bulk-sub" disabled class="mt-1 block min-h-11 w-full rounded-xl border border-slate-300 bg-white px-3 text-base outline-none focus-visible:ring-2 focus-visible:ring-brand-primaryInk disabled:bg-slate-100 disabled:text-slate-500">
              <option value="">All types</option>
            </select>
          </div>
          <div class="flex items-end">
            <label class="flex min-h-11 w-full cursor-pointer items-center gap-3 rounded-xl border border-slate-300 bg-white px-3 text-sm font-bold text-gray-950">
              <input id="bulk-only-list" type="checkbox" class="h-5 w-5 accent-slate-900" />
              Only my list
            </label>
          </div>
        </div>
        <p id="bulk-count" class="mb-2 text-sm text-slate-600" aria-live="polite">Showing {rows.length} products</p>

        <ul id="bulk-rows" class="divide-y divide-slate-100 rounded-2xl border border-slate-200 bg-white">
          {rows.map((row) => (
            <li
              data-bulk-row
              data-id={row.productId}
              data-name={row.name}
              data-code={row.code ?? ''}
              data-sku={row.sku ?? ''}
              data-model={row.modelNumber ?? ''}
              data-price={row.unitPriceUgx ?? ''}
              data-instock={row.inStock ? '1' : '0'}
              data-cat={row.categorySlug}
              data-sub={row.subcategorySlug}
              data-search={searchTextOf(row)}
              class="grid grid-cols-[48px_minmax(0,1fr)] gap-x-3 gap-y-2 p-3 sm:grid-cols-[56px_minmax(0,1fr)_auto] sm:items-center"
            >
              <div class="h-12 w-12 overflow-hidden rounded-lg border border-slate-100 bg-slate-50 sm:h-14 sm:w-14">
                {row.imageUrl
                  ? <img src={row.imageUrl} srcset={productSrcset(row.imageUrl) ?? undefined} sizes={productSrcset(row.imageUrl) ? '56px' : undefined} alt="" width="56" height="56" loading="lazy" decoding="async" class="h-full w-full object-cover" />
                  : <span class="flex h-full w-full items-center justify-center text-[10px] font-bold uppercase text-slate-500">No photo</span>}
              </div>
              <div class="min-w-0">
                <a href={`/products/${row.slug}`} class="block break-words text-sm font-bold leading-snug text-gray-950 underline-offset-4 hover:underline">{row.name}</a>
                <p class="mt-0.5 text-xs text-slate-600">
                  {row.code && <span class="font-mono">{row.code}</span>}
                  {row.code && (row.subcategoryName || row.categoryName) && ' · '}
                  {row.subcategoryName || row.categoryName}
                </p>
                <p class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm">
                  <span class="font-black text-gray-950">{row.unitPriceUgx === null ? 'Price on request' : formatUgx(row.unitPriceUgx)}</span>
                  <span class={`rounded-full px-2 py-0.5 text-[11px] font-bold ${row.inStock ? 'bg-green-50 text-green-800' : 'bg-slate-100 text-slate-700'}`}>{row.stockLabel}</span>
                </p>
              </div>
              <div class="col-start-2 flex items-center gap-1 sm:col-start-3" role="group" aria-label={`Quantity of ${row.name}`}>
                <button type="button" data-step="-1" aria-label={`One fewer ${row.name}`} class="flex h-11 w-11 items-center justify-center rounded-full border border-slate-300 bg-white text-lg font-black text-gray-950 outline-none hover:border-slate-500 focus-visible:ring-2 focus-visible:ring-brand-primaryInk">−</button>
                <input data-qty type="text" inputmode="numeric" pattern="[0-9]*" maxlength="6" autocomplete="off" placeholder="0" aria-label={`Quantity of ${row.name}`}
                  class="h-11 w-20 rounded-xl border border-slate-300 px-2 text-center text-base font-bold outline-none focus-visible:border-slate-900 focus-visible:ring-2 focus-visible:ring-brand-primaryInk" />
                <button type="button" data-step="1" aria-label={`One more ${row.name}`} class="flex h-11 w-11 items-center justify-center rounded-full border border-slate-300 bg-white text-lg font-black text-gray-950 outline-none hover:border-slate-500 focus-visible:ring-2 focus-visible:ring-brand-primaryInk">+</button>
              </div>
            </li>
          ))}
        </ul>
        <p id="bulk-empty-filter" hidden class="mt-3 rounded-xl bg-slate-50 p-4 text-sm text-slate-700">No products match. Clear the search or choose another category.</p>
      </section>

      <aside id="bulk-review" aria-labelledby="bulk-review-heading" tabindex="-1" class="mt-8 scroll-mt-4 outline-none lg:sticky lg:top-4 lg:mt-0 lg:max-h-[calc(100vh-2rem)] lg:self-start lg:overflow-y-auto">
        <div class="rounded-2xl border border-slate-200 bg-white p-4 sm:p-5">
          <h2 id="bulk-review-heading" class="text-lg font-black text-gray-950">Your bulk list</h2>
          <p id="bulk-summary" class="mt-1 text-sm text-slate-700">No products yet. Type a quantity next to any product.</p>
          <ul id="bulk-lines" class="mt-3 divide-y divide-slate-100"></ul>
          <div id="bulk-estimate" class="mt-3 rounded-xl bg-slate-50 p-3 text-sm" hidden>
            <p class="font-bold text-gray-950">Estimated total at list price: <span id="bulk-estimate-total"></span></p>
            <p class="mt-1 text-slate-700">An estimate at our listed prices, not a bill. Volume pricing is confirmed by our sales team.</p>
            <p id="bulk-estimate-unpriced" class="mt-1 text-slate-700" hidden></p>
          </div>
          <button type="button" id="bulk-clear" hidden class="mt-3 min-h-11 rounded-full border border-slate-300 px-4 text-sm font-bold text-slate-800 outline-none hover:border-slate-500 focus-visible:ring-2 focus-visible:ring-brand-primaryInk">Clear list</button>
        </div>

        <div class="mt-4 rounded-2xl border border-slate-200 bg-white p-4 sm:p-5">
          <h3 class="text-base font-black text-gray-950">Buy now at listed prices</h3>
          <p class="mt-1 text-sm text-slate-700">Adds products with {CART_LINE_QUANTITY_CAP} or fewer to your basket. Larger quantities stay in this list for a quote.</p>
          <button type="button" id="bulk-add-cart" disabled class="mt-3 min-h-11 w-full rounded-full bg-brand-primary px-5 text-sm font-bold text-gray-950 outline-none hover:opacity-90 focus-visible:ring-2 focus-visible:ring-brand-primaryInk focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50">Add to basket</button>
          <div id="bulk-cart-result" class="mt-3 text-sm" role="status" aria-live="polite"></div>
        </div>

        <form id="bulk-quote-form" class="mt-4 rounded-2xl border border-slate-200 bg-white p-4 sm:p-5" novalidate>
          <h3 class="text-base font-black text-gray-950">Ask for a volume quote</h3>
          <p class="mt-1 text-sm text-slate-700">Send the whole list, any quantity up to {MAX_BULK_LINE_QUANTITY.toLocaleString('en-US')} a product and {MAX_BULK_LINES} products. Our sales team calls you with a price. Nothing is charged.</p>
          <div id="bulk-form-error" class="mt-3 text-sm font-bold text-red-700" role="alert"></div>

          <div class="mt-3 space-y-3">
            <div>
              <label for="bq-name" class="block text-sm font-bold text-gray-950">Your name</label>
              <input id="bq-name" name="customerName" required autocomplete="name" maxlength="100" class="mt-1 block min-h-11 w-full rounded-xl border border-slate-300 px-3 text-base outline-none focus-visible:border-slate-900 focus-visible:ring-2 focus-visible:ring-brand-primaryInk" />
            </div>
            <div>
              <label for="bq-business" class="block text-sm font-bold text-gray-950">Business name (optional)</label>
              <input id="bq-business" name="businessName" autocomplete="organization" maxlength="160" class="mt-1 block min-h-11 w-full rounded-xl border border-slate-300 px-3 text-base outline-none focus-visible:border-slate-900 focus-visible:ring-2 focus-visible:ring-brand-primaryInk" />
            </div>
            <div>
              <label for="bq-phone" class="block text-sm font-bold text-gray-950">Phone number</label>
              <input id="bq-phone" name="phone" type="tel" inputmode="tel" required autocomplete="tel" placeholder="07XX XXX XXX" maxlength="20" class="mt-1 block min-h-11 w-full rounded-xl border border-slate-300 px-3 text-base outline-none focus-visible:border-slate-900 focus-visible:ring-2 focus-visible:ring-brand-primaryInk" />
            </div>
            <div>
              <label for="bq-email" class="block text-sm font-bold text-gray-950">Email (optional)</label>
              <input id="bq-email" name="email" type="email" autocomplete="email" maxlength="255" class="mt-1 block min-h-11 w-full rounded-xl border border-slate-300 px-3 text-base outline-none focus-visible:border-slate-900 focus-visible:ring-2 focus-visible:ring-brand-primaryInk" />
            </div>
            <fieldset>
              <legend class="text-sm font-bold text-gray-950">Which best describes you?</legend>
              <div class="mt-1 grid grid-cols-1 gap-2 sm:grid-cols-2">
                {buyerOptions.map((opt) => (
                  <label class="flex min-h-11 cursor-pointer items-center gap-3 rounded-xl border border-slate-300 px-3 text-sm text-gray-950">
                    <input type="radio" name="buyerType" value={opt.v} checked={initialBuyer === opt.v} class="h-5 w-5 accent-slate-900" />
                    {opt.l}
                  </label>
                ))}
              </div>
            </fieldset>
            <div>
              <label for="bq-district" class="block text-sm font-bold text-gray-950">Delivery district (optional)</label>
              <select id="bq-district" name="deliveryDistrict" class="mt-1 block min-h-11 w-full rounded-xl border border-slate-300 bg-white px-3 text-base outline-none focus-visible:ring-2 focus-visible:ring-brand-primaryInk">
                <option value="">Choose a district</option>
                {districts.map((d) => <option value={d}>{d}</option>)}
              </select>
            </div>
            <div>
              <label for="bq-needed" class="block text-sm font-bold text-gray-950">Needed by (optional)</label>
              <input id="bq-needed" name="neededBy" type="date" min={todayKampala} class="mt-1 block min-h-11 w-full rounded-xl border border-slate-300 px-3 text-base outline-none focus-visible:ring-2 focus-visible:ring-brand-primaryInk" />
            </div>
            <div>
              <label for="bq-notes" class="block text-sm font-bold text-gray-950">Notes for our sales team (optional)</label>
              <textarea id="bq-notes" name="notes" rows="3" maxlength="2000" placeholder="Branding, packaging, delivery address, anything else" class="mt-1 block w-full rounded-xl border border-slate-300 p-3 text-base outline-none focus-visible:border-slate-900 focus-visible:ring-2 focus-visible:ring-brand-primaryInk"></textarea>
            </div>
          </div>
          <button type="submit" id="bulk-quote-submit" class="mt-4 min-h-11 w-full rounded-full bg-slate-900 px-5 text-sm font-bold text-white outline-none hover:bg-black focus-visible:ring-2 focus-visible:ring-slate-900 focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-60">Send quote request</button>
          <p class="mt-3 text-xs text-slate-600">We use your details only to reply about this request. See our <a class="underline" href="/privacy">privacy notice</a>.</p>
        </form>

        <p class="mt-4 text-sm text-slate-700">Prefer to talk? <a class="font-bold underline underline-offset-4" href={whatsappUrl}>Message us on WhatsApp</a>.</p>
      </aside>
    </div>
  </div>

  <div id="bulk-bar" class="fixed inset-x-0 bottom-0 z-30 border-t border-slate-200 bg-white/95 px-4 py-2 shadow-[0_-4px_16px_rgba(0,0,0,0.06)] backdrop-blur lg:hidden">
    <div class="mx-auto flex max-w-3xl items-center justify-between gap-3">
      <p id="bulk-bar-text" class="min-w-0 text-sm text-gray-950"><span class="font-bold">Your list is empty</span></p>
      <a href="#bulk-review" id="bulk-bar-link" class="inline-flex min-h-11 shrink-0 items-center rounded-full bg-slate-900 px-4 text-sm font-bold text-white outline-none focus-visible:ring-2 focus-visible:ring-slate-900 focus-visible:ring-offset-2">Review list</a>
    </div>
  </div>
  <p id="bulk-live" class="sr-only" aria-live="polite"></p>
</BaseLayout>

<script>
  import { initBulkBuilder } from '../../lib/bulkBuilderClient';
  initBulkBuilder();
</script>
