---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Your Cart - GoldPlus">
  <div class="container mx-auto px-4 lg:px-8 py-12">
    <!-- Empty State (Hidden by Default) -->
    <div id="empty-cart-msg" class="hidden text-center py-20 bg-white rounded-2xl border border-gray-200">
      <svg class="w-20 h-20 mx-auto text-gray-200 mb-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
      <h2 class="text-2xl font-bold text-brand-dark mb-2">Your cart is empty</h2>
      <p class="text-gray-500 mb-8">Looks like you haven't added any premium electronics yet.</p>
      <a href="/shop" class="inline-block px-8 py-3 bg-brand-green text-white rounded-lg font-bold hover:bg-green-700 transition-colors">Start Shopping</a>
    </div>

    <!-- Active Cart Grid (Hidden by Default) -->
    <div id="cart-grid" class="hidden flex flex-col lg:flex-row gap-12">
      <div class="w-full lg:w-2/3">
        <div class="bg-white rounded-2xl border border-gray-200 overflow-hidden shadow-sm">
          <ul id="cart-list" class="divide-y divide-gray-100">
            <!-- Dynamically Injected -->
          </ul>
        </div>
      </div>

      <!-- Summary Sidebar -->
      <div class="w-full lg:w-1/3">
        <div class="bg-white p-8 rounded-2xl border border-gray-200 shadow-sm sticky top-24">
          <h2 class="text-xl font-bold text-brand-dark mb-6">Order Summary</h2>
          <div class="space-y-4 mb-6">
            <div class="flex justify-between text-gray-600">
              <span>Subtotal</span>
              <span id="summary-subtotal" class="font-bold text-brand-dark">UGX 0</span>
            </div>
            <div class="flex justify-between text-gray-600">
              <span>Shipping</span>
              <span class="text-sm italic">Calculated at checkout</span>
            </div>
            <div class="border-t border-gray-100 pt-4 flex justify-between items-end">
              <span class="text-lg font-bold text-brand-dark">Total</span>
              <span id="summary-total" class="text-2xl font-black text-brand-green">UGX 0</span>
            </div>
          </div>
          <a href="/checkout" class="block w-full text-center bg-brand-dark text-white py-4 rounded-xl font-bold text-lg hover:bg-black transition-all transform hover:-translate-y-1 shadow-lg shadow-gray-200">
            Proceed to Checkout
          </a>
          <p class="text-center text-xs text-gray-400 mt-6">Cart persistently stored in your local browser.</p>
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    const formatter = new Intl.NumberFormat('en-UG', { style: 'currency', currency: 'UGX', maximumFractionDigits: 0 });
    
    function loadCart() {
      const cart = JSON.parse(localStorage.getItem('gp_cart') || '[]');
      const list = document.getElementById('cart-list');
      const emptyMsg = document.getElementById('empty-cart-msg');
      const grid = document.getElementById('cart-grid');
      const summarySub = document.getElementById('summary-subtotal');
      const summaryTotal = document.getElementById('summary-total');

      if (cart.length === 0) {
        emptyMsg.classList.remove('hidden');
        grid.classList.add('hidden');
        return;
      }

      emptyMsg.classList.add('hidden');
      grid.classList.remove('hidden');

      let html = '';
      let total = 0;

      cart.forEach((item, index) => {
        const lineTotal = item.priceUgx * item.quantity;
        total += lineTotal;
        html += `
          <li class="p-6 flex flex-col sm:flex-row items-center gap-6">
            <div class="w-24 h-24 bg-gray-50 rounded-xl flex-shrink-0 flex items-center justify-center text-[10px] text-gray-400 font-bold border border-gray-100 uppercase text-center p-2">
              No Image
            </div>
            <div class="flex-grow text-center sm:text-left">
              <p class="text-xs font-bold text-brand-green uppercase tracking-widest mb-1">${item.category || 'General'}</p>
              <h3 class="text-lg font-bold text-brand-dark mb-1">${item.name}</h3>
              <p class="text-brand-dark font-black">${formatter.format(item.priceUgx)}</p>
            </div>
            <div class="flex items-center gap-4 bg-gray-50 rounded-lg p-1 border border-gray-200">
              <button onclick="window.updateQty(${index}, -1)" class="w-8 h-8 flex items-center justify-center font-bold text-gray-500 hover:text-brand-dark transition-colors">-</button>
              <span class="w-8 text-center font-bold text-brand-dark">${item.quantity}</span>
              <button onclick="window.updateQty(${index}, 1)" class="w-8 h-8 flex items-center justify-center font-bold text-gray-500 hover:text-brand-dark transition-colors">+</button>
            </div>
            <div class="text-right min-w-[120px]">
              <p class="text-lg font-black text-brand-dark">${formatter.format(lineTotal)}</p>
              <button onclick="window.removeCartItem(${index})" class="text-sm font-bold text-red-500 hover:text-red-700 transition-colors mt-1">Remove</button>
            </div>
          </li>
        `;
      });

      list.innerHTML = html;
      summarySub.innerText = formatter.format(total);
      summaryTotal.innerText = formatter.format(total);
    }

    window.updateQty = (index, delta) => {
      const cart = JSON.parse(localStorage.getItem('gp_cart') || '[]');
      if (!cart[index]) return;
      cart[index].quantity += delta;
      if (cart[index].quantity <= 0) {
        cart.splice(index, 1);
      }
      localStorage.setItem('gp_cart', JSON.stringify(cart));
      loadCart();
    };

    window.removeCartItem = (index) => {
      const cart = JSON.parse(localStorage.getItem('gp_cart') || '[]');
      cart.splice(index, 1);
      localStorage.setItem('gp_cart', JSON.stringify(cart));
      loadCart();
    };

    // Initial Load
    document.addEventListener('DOMContentLoaded', loadCart);
    loadCart();
  </script>
</BaseLayout>

