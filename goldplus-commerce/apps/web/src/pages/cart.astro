---
import BaseLayout from '../layouts/BaseLayout.astro';
import EmptyState from '../components/EmptyState.astro';
import Notice from '../components/Notice.astro';
import { apiBase } from '../lib/api';
import { readCartSessionId } from '../lib/cart-session';
import type { ApiEnvelope } from '@goldplus/shared';
import CartAddonRail from '../components/recommendations/CartAddonRail.astro';
import PopularNowRail from '../components/recommendations/PopularNowRail.astro';
import { LOCAL_SEED_PRODUCTS } from '../lib/catalog/catalog';
import { parseLocalCartCookie } from '../lib/cart';
import { cartClient, cartMessageFor } from '../lib/cartClient';
import { resolveCartCredential } from '../lib/cartCredential';
import { resolveAuthenticatedUserId } from '../lib/customerAuth';
import { checkRequestOrigin, CROSS_SITE_MESSAGE } from '../lib/requestOrigin';

import crypto from 'node:crypto';

interface CartItem {
  productId: string;
  slug: string;
  name: string;
  categoryName: string | null;
  quantity: number;
  unitPriceUgx: number;
}

interface CartResponse {
  id: string;
  items: CartItem[];
  subtotalUgx: number;
}

let sessionId = readCartSessionId(Astro.request);
let isNewSession = false;

/** Set when a server write was refused, so the customer is told rather than misled. */
let cartNotice: string | null = null;

// Cross-site refusal comes FIRST, before the credential is resolved, because resolving
// MINTS one. The credential cookie is SameSite=Lax, so a cross-site POST arrives
// without it — and answering a missing cookie by manufacturing a basket identity is
// exactly backwards for a request the browser has already labelled cross-site.
const cartOrigin =
  Astro.request.method === 'POST'
    ? checkRequestOrigin(Astro.request, import.meta.env as unknown as Record<string, string | undefined>)
    : ({ allowed: true, basis: 'SEC_FETCH_SITE' } as const);

if (!cartOrigin.allowed) {
  cartNotice = CROSS_SITE_MESSAGE;
}

// The signed basket credential. The cart id lives inside the signed claims, so the
// browser never names a cart and knowing an id is no longer authority over it.
const cartUserId = cartOrigin.allowed ? await resolveAuthenticatedUserId(Astro.cookies) : null;
const cartCredential = cartOrigin.allowed
  ? resolveCartCredential(Astro.cookies, cartUserId)
  : null;

// Handle Add, Update, and Remove POST submissions
if (Astro.request.method === 'POST' && cartOrigin.allowed) {
  try {
    const formData = await Astro.request.formData();
    const action = formData.get('action')?.toString() || 'add';
    const productId = formData.get('productId')?.toString();
    const slug = formData.get('slug')?.toString() || '';
    const name = formData.get('name')?.toString() || '';
    const categoryName = formData.get('categoryName')?.toString() || '';
    const priceUgx = Number(formData.get('priceUgx') || 0);
    const searchQuery = formData.get('searchQuery')?.toString() || '';
    const searchRank = Number(formData.get('searchRank') || 0);

    if (productId) {
      if (!sessionId) {
        sessionId = crypto.randomUUID();
        isNewSession = true;
      }

      // 1. Load active fallback items from cookie
      const localDataCookie = Astro.cookies.get('goldplus_cart_data')?.value;
      let localItems = parseLocalCartCookie(localDataCookie) as any[];

      // 2. Perform cart actions
      if (action === 'add') {
        const existing = localItems.find(i => i.productId === productId);
        if (existing) {
          existing.quantity += 1;
        } else {
          localItems.push({
            productId,
            slug,
            name,
            categoryName: categoryName || null,
            quantity: 1,
            unitPriceUgx: priceUgx
          });
        }

        // Typed, credential-scoped, and the RESULT IS READ. The previous call sent
        // the cart id in the body, discarded the response and swallowed failures into
        // a console warning while updating the local cookie regardless — so a rejected
        // server write looked exactly like an accepted one. The customer saw their
        // basket change and the server's basket did not, which surfaced at checkout
        // where the server's cart is the authority.
        if (cartCredential) {
          const result = await cartClient.add(
            cartCredential.token,
            { productId, quantity: 1 },
            Astro.cookies.get('goldplus_session')?.value ?? null,
          );
          if (!result.ok) cartNotice = cartMessageFor(result.code);
        }

        if (searchQuery && Number.isInteger(searchRank) && searchRank >= 1 && searchRank <= 50) {
          await fetch(`${apiBase}/products/search-interactions`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ query: searchQuery, productId, rank: searchRank, type: 'add_to_cart' }),
            signal: AbortSignal.timeout(500),
          }).catch(() => {});
        }

      } else if (action === 'update') {
        const qty = Number(formData.get('quantity') || 1);
        const validatedQty = qty < 1 ? 1 : qty;
        
        const existing = localItems.find(i => i.productId === productId);
        if (existing) {
          existing.quantity = validatedQty;
        }

        if (cartCredential) {
          const result = await cartClient.update(
            cartCredential.token,
            { productId, quantity: validatedQty },
            Astro.cookies.get('goldplus_session')?.value ?? null,
          );
          if (!result.ok) cartNotice = cartMessageFor(result.code);
        }

      } else if (action === 'remove') {
        localItems = localItems.filter(i => i.productId !== productId);

        if (cartCredential) {
          const result = await cartClient.remove(
            cartCredential.token,
            { productId },
            Astro.cookies.get('goldplus_session')?.value ?? null,
          );
          if (!result.ok) cartNotice = cartMessageFor(result.code);
        }
      }

      // 3. Save synchronized list to cookie
      Astro.cookies.set('goldplus_cart_data', JSON.stringify(localItems), {
        path: '/',
        maxAge: 60 * 60 * 24 * 365, // 1 year
        sameSite: 'lax',
        httpOnly: false
      });

      if (isNewSession) {
        Astro.cookies.set('goldplus_cart_id', sessionId, {
          path: '/',
          maxAge: 60 * 60 * 24 * 365,
          sameSite: 'lax',
          httpOnly: false
        });
      }

      return Astro.redirect('/cart', 303);
    }
  } catch (err) {
    console.error('[CART_POST_ERROR] Failed to handle cart post:', err);
  }
}

let cart: CartResponse | null = null;
let fetchError: string | null = null;

if (cartCredential) {
  const result = await cartClient.read(
    cartCredential.token,
    Astro.cookies.get('goldplus_session')?.value ?? null,
  );
  if (result.ok) {
    cart = {
      id: result.cart.id,
      items: result.cart.items.map((line) => ({
        productId: line.productId,
        slug: '',
        name: line.name,
        categoryName: null,
        quantity: line.quantity,
        unitPriceUgx: line.unitPriceUgx,
      })),
      subtotalUgx: result.cart.subtotalUgx,
    };
  } else if (result.code !== 'CART_NOT_FOUND') {
    // A missing basket is not an error to show: a first visit has none. Anything else
    // is, and it is named through the exhaustive mapper rather than by passing the
    // server's own message to the customer.
    fetchError = cartMessageFor(result.code);
  }
}

// Fallback to local cookie state if API failed or returned empty while cookie has items!
let items: CartItem[] = cart?.items ?? [];
if (items.length === 0) {
  const localDataCookie = Astro.cookies.get('goldplus_cart_data')?.value;
  items = parseLocalCartCookie(localDataCookie) as any[];
  if (items.length > 0) {
    fetchError = null; // Clear fetchError since we successfully recovered from fallback!
  }
}

const cartProductIds = items.map(i => i.productId);
const subtotal = items.reduce((acc, item) => acc + (item.unitPriceUgx * item.quantity), 0);

const formatUgx = (n: number): string =>
  new Intl.NumberFormat('en-UG', { style: 'currency', currency: 'UGX', maximumFractionDigits: 0 }).format(n);
---

<BaseLayout title="Your cart">
  <div class="container mx-auto px-4 lg:px-8 py-10 lg:py-14">
    <h1 class="text-2xl md:text-3xl font-black text-gray-900 mb-8 tracking-tight">Your cart</h1>

    {cartNotice && (
      <div class="mb-6">
        {/*
          A refused server write must be visible. Setting a notice and never rendering
          it is the same silence the discarded fetch responses produced: the customer's
          view updates from the local cookie while the server rejected the change.
        */}
        <Notice kind="not-configured" title="Basket not updated" message={cartNotice} />
      </div>
    )}

    {fetchError && (
      <div class="mb-6">
        <Notice kind="not-configured" title="Cart service unavailable" message={fetchError} />
      </div>
    )}

    {items.length === 0 ? (
      <>
        <div class="py-8">
          <EmptyState
            title="Your cart is empty"
            message="Browse the shop and add a product to get started."
          >
            <a href="/shop" class="inline-flex items-center justify-center min-w-[200px] h-12 px-6 bg-brand-charcoal text-white rounded-full font-bold hover:bg-black transition-colors text-sm outline-none focus-visible:ring-4 focus-visible:ring-brand-primary/30">
              Shop all products
            </a>
          </EmptyState>
        </div>
        <div class="mt-16 pt-8 border-t border-slate-100">
          <PopularNowRail />
        </div>
      </>
    ) : (
      <div class="flex flex-col lg:flex-row gap-10">
        <div class="w-full lg:w-2/3">
          <div class="bg-white rounded-2xl border border-slate-200/80 overflow-hidden shadow-xs">
            <ul class="divide-y divide-slate-100" aria-label="Cart items">
              {items.map((item) => {
                // Recover matching local product image
                const localProd = LOCAL_SEED_PRODUCTS.find(p => p.id === item.productId || p.slug === item.slug);
                const imageUrl = localProd?.primaryImageUrl ?? null;
                
                return (
                  <li class="p-5 md:p-6 flex flex-col sm:flex-row items-start sm:items-center gap-4 sm:gap-6">
                    <a href={`/products/${item.slug}`} class="flex-shrink-0 outline-none focus-visible:ring-4 focus-visible:ring-brand-primary/30 rounded-2xl block">
                      {imageUrl ? (
                        <img 
                          src={imageUrl} 
                          alt={item.name} 
                          class="w-24 h-24 object-cover bg-slate-50/50 rounded-2xl border border-slate-200/60 p-1 hover:border-brand-primary transition-colors"
                        />
                      ) : (
                        <div class="w-24 h-24 bg-slate-50 rounded-2xl flex items-center justify-center text-[10px] text-slate-400 font-bold border border-slate-200/60 uppercase text-center p-2 hover:border-brand-primary transition-colors">
                          No image
                        </div>
                      )}
                    </a>
                    
                    <div class="flex-grow min-w-0 flex flex-col justify-center">
                      {item.categoryName && (
                        <p class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1">{item.categoryName}</p>
                      )}
                      <a href={`/products/${item.slug}`} class="font-bold text-gray-900 hover:text-brand-primary transition-colors line-clamp-2 outline-none focus-visible:ring-2 focus-visible:ring-brand-primary/50 rounded leading-snug">{item.name}</a>
                      <p class="text-sm font-bold text-brand-primary mt-1.5">{formatUgx(item.unitPriceUgx)} <span class="text-xs font-normal text-slate-400 ml-1">each</span></p>
                    </div>
                    
                    {/* Quantity Selector controls */}
                    <div class="flex items-center gap-3">
                      <form method="POST" action="/cart" class="flex items-center gap-2">
                        <input type="hidden" name="action" value="update" />
                        <input type="hidden" name="productId" value={item.productId} />
                        
                        <button 
                          type="submit" 
                          name="quantity" 
                          value={item.quantity - 1} 
                          aria-label={`Decrease quantity of ${item.name}`}
                          class="w-11 h-11 sm:w-9 sm:h-9 rounded-full border border-slate-200 flex items-center justify-center font-bold text-gray-700 hover:bg-slate-50 hover:border-slate-300 transition-colors outline-none focus-visible:ring-4 focus-visible:ring-brand-primary/30 active:scale-95 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
                          disabled={item.quantity <= 1}
                        >
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4"/></svg>
                        </button>
                        
                        <span class="w-8 text-center font-bold text-gray-900 text-base" aria-label={`Quantity: ${item.quantity}`}>
                          {item.quantity}
                        </span>
                        
                        <button 
                          type="submit" 
                          name="quantity" 
                          value={item.quantity + 1} 
                          aria-label={`Increase quantity of ${item.name}`}
                          class="w-11 h-11 sm:w-9 sm:h-9 rounded-full border border-slate-200 flex items-center justify-center font-bold text-gray-700 hover:bg-slate-50 hover:border-slate-300 transition-colors outline-none focus-visible:ring-4 focus-visible:ring-brand-primary/30 active:scale-95 cursor-pointer"
                        >
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                        </button>
                      </form>
                      
                      <form method="POST" action="/cart" class="ml-auto sm:ml-0">
                        <input type="hidden" name="action" value="remove" />
                        <input type="hidden" name="productId" value={item.productId} />
                        <button 
                          type="submit" 
                          aria-label={`Remove ${item.name} from cart`}
                          class="p-2.5 sm:p-2 text-slate-400 hover:text-red-500 transition-colors rounded-full hover:bg-red-50 outline-none focus-visible:ring-4 focus-visible:ring-red-500/30 cursor-pointer"
                        >
                          <svg class="w-5 h-5 sm:w-4 sm:h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                          </svg>
                        </button>
                      </form>
                    </div>

                    <p class="font-bold text-gray-900 whitespace-nowrap text-right min-w-[80px] text-sm md:text-base">{formatUgx(item.unitPriceUgx * item.quantity)}</p>
                  </li>
                );
              })}
            </ul>
          </div>
        </div>

        <aside class="w-full lg:w-1/3">
          <div class="bg-white rounded-3xl border border-slate-200/60 p-6 sm:p-8 sticky top-24 shadow-lg shadow-slate-100/50">
            <h2 class="text-xl font-black tracking-tight text-gray-900 mb-6">Summary</h2>
            <dl class="space-y-4 text-sm mb-8">
              <div class="flex items-center justify-between">
                <dt class="text-slate-500 font-medium">Subtotal</dt>
                <dd class="font-bold text-gray-900">{formatUgx(subtotal)}</dd>
              </div>
              <div class="flex items-center justify-between">
                <dt class="text-slate-500 font-medium">Delivery</dt>
                <dd class="text-slate-400 italic">Calculated at checkout</dd>
              </div>
              <div class="flex items-center justify-between pt-4 border-t border-slate-100">
                <dt class="font-black text-gray-900 text-base">Total</dt>
                <dd class="font-black text-brand-primary text-xl tracking-tight">{formatUgx(subtotal)}</dd>
              </div>
            </dl>

            <a
              href="/checkout"
              class="flex items-center justify-center w-full h-14 px-6 bg-brand-charcoal text-white rounded-full font-bold hover:bg-black outline-none focus-visible:ring-4 focus-visible:ring-brand-primary/30 transition-all shadow-md active:scale-95 text-base cursor-pointer"
            >
              Continue to checkout
            </a>
            <a 
              href="/shop" 
              class="flex items-center justify-center w-full h-12 mt-3 text-sm font-bold text-slate-500 hover:text-gray-900 hover:bg-slate-50 rounded-full transition-colors outline-none focus-visible:ring-4 focus-visible:ring-slate-200 cursor-pointer"
            >
              Continue shopping
            </a>
            
            {/* Compact Trust Strip */}
            <div class="mt-8 pt-6 border-t border-slate-100/80">
              <ul class="space-y-4">
                <li class="flex items-center gap-3 text-sm text-slate-600 font-medium">
                  <div class="w-8 h-8 rounded-full bg-slate-50 flex items-center justify-center text-brand-charcoal flex-shrink-0">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                  </div>
                  Original GoldPlus products
                </li>
                <li class="flex items-center gap-3 text-sm text-slate-600 font-medium">
                  <div class="w-8 h-8 rounded-full bg-slate-50 flex items-center justify-center text-brand-charcoal flex-shrink-0">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" /></svg>
                  </div>
                  Support available on WhatsApp
                </li>
              </ul>
            </div>
          </div>
        </aside>
      </div>
    )}

    {/* Smart Upsell Area */}
    {items.length > 0 && (
      <div class="mt-16 pt-8 border-t border-slate-100">
        <CartAddonRail cartProductIds={cartProductIds} />
      </div>
    )}
  </div>
</BaseLayout>
