---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { apiBase } from '../../lib/api';
import { readSessionToken } from '../../lib/session';
import { STOP_CHANNELS, buildLiftRequest, buildStopIntakeRequest, maskEndpointRef } from '../../lib/admin-stop-intake';

const token = readSessionToken(Astro.request);
if (!token) {
  return Astro.redirect('/admin/login?returnTo=/admin/consent-operating', 303);
}

interface Readiness {
  commands_enabled: boolean;
  preference_centre_save_enabled: boolean;
  admin_workflow_enabled: boolean;
  support_workflow_enabled: boolean;
  provider_suppression_intake_enabled: boolean;
  provider_dry_run_enabled: boolean;
  provider_live_sends_enabled: boolean;
  legacy_migration_dry_run_enabled: boolean;
  production_migration_required: boolean;
  specialist_approvals_pending: boolean;
  no_send_status: 'pass' | 'fail';
  live_send_readiness: 'blocked';
  reasons: string[];
}

const disabledReadiness: Readiness = {
  commands_enabled: false,
  preference_centre_save_enabled: false,
  admin_workflow_enabled: false,
  support_workflow_enabled: false,
  provider_suppression_intake_enabled: false,
  provider_dry_run_enabled: false,
  provider_live_sends_enabled: false,
  legacy_migration_dry_run_enabled: false,
  production_migration_required: true,
  specialist_approvals_pending: true,
  no_send_status: 'pass',
  live_send_readiness: 'blocked',
  reasons: ['consent operating service did not respond; fail-closed display used'],
};

let readiness = disabledReadiness;
try {
  const response = await fetch(`${apiBase}/admin/consent-operating/readiness`, {
    headers: { Authorization: `Bearer ${token}` },
  });
  if (response.ok) readiness = await response.json();
} catch {
  // The dashboard remains fail-closed when the API is unavailable.
}

// ---------- STOP / unsubscribe intake (operator-recorded) ----------
// No inbound webhook exists (Zoho CPaaS does not deliver replies), so the
// operator records a STOP seen in the provider console through the existing
// gated POST /admin/consent-operating/provider-suppressions.
let intakeNotice: { kind: 'ok' | 'error'; messages: string[] } | null = null;
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  if (form.get('intent') === 'lift') {
    // Lift a suppression (POST /admin/consent-operating/suppressions/:id/lift).
    const lift = buildLiftRequest(form);
    if (!lift.ok) {
      intakeNotice = { kind: 'error', messages: lift.errors };
    } else {
      try {
        const res = await fetch(`${apiBase}/admin/consent-operating/suppressions/${encodeURIComponent(lift.suppressionId)}/lift`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
          body: JSON.stringify({ reason: lift.reason }),
        });
        const body = await res.json().catch(() => null);
        intakeNotice = res.ok && body?.ok
          ? { kind: 'ok', messages: ['Suppression lifted. It grants nothing by itself: marketing on that channel still needs the customer\'s consent.'] }
          : { kind: 'error', messages: [res.status === 403 ? 'Your role cannot lift suppressions (settings.manage required).' : `Not lifted (HTTP ${res.status}).`, ...((body?.reasons as string[] | undefined) ?? [])] };
      } catch {
        intakeNotice = { kind: 'error', messages: ['The consent API did not answer; nothing was changed.'] };
      }
    }
  } else if (!readiness.provider_suppression_intake_enabled) {
    intakeNotice = { kind: 'error', messages: ['Provider suppression intake is disabled (CONSENT_PROVIDER_SUPPRESSION_INTAKE_ENABLED); nothing was recorded.'] };
  } else {
    const built = buildStopIntakeRequest(form, crypto.randomUUID());
    if (!built.ok) {
      intakeNotice = { kind: 'error', messages: built.errors };
    } else {
      try {
        const res = await fetch(`${apiBase}/admin/consent-operating/provider-suppressions`, {
          method: 'POST',
          headers: { ...built.request.headers, Authorization: `Bearer ${token}` },
          body: JSON.stringify(built.request.body),
        });
        const body = await res.json().catch(() => null);
        intakeNotice = res.ok && body?.ok
          ? { kind: 'ok', messages: ['Suppression recorded. This contact will no longer receive marketing on that channel. Order and account messages are not affected.'] }
          : { kind: 'error', messages: [`Not recorded (HTTP ${res.status}).`, ...((body?.reasons as string[] | undefined) ?? [])] };
      } catch {
        intakeNotice = { kind: 'error', messages: ['The consent API did not answer; nothing was recorded.'] };
      }
    }
  }
}

type SuppressionRead = { state: 'available'; rows: Array<Record<string, unknown>> } | { state: 'disabled' | 'error'; reason: string };
let suppressions: SuppressionRead = { state: 'error', reason: 'Not read.' };
try {
  const res = await fetch(`${apiBase}/admin/consent-operating/suppressions`, { headers: { Authorization: `Bearer ${token}` } });
  const body = await res.json().catch(() => null);
  if (res.ok && body?.status === 'available') suppressions = { state: 'available', rows: (body.suppressions ?? []).slice(0, 25) };
  else if (body?.status === 'disabled') suppressions = { state: 'disabled', reason: (body.reasons ?? []).join(', ') || 'gate disabled' };
  else suppressions = { state: 'error', reason: res.status === 403 ? 'Your role cannot read suppressions (audit.read required).' : `HTTP ${res.status}` };
} catch {
  suppressions = { state: 'error', reason: 'The consent API did not answer.' };
}
const intakeIdempotencyKey = crypto.randomUUID();

const gates = [
  ['Persistence commands', readiness.commands_enabled],
  ['Preference Centre save', readiness.preference_centre_save_enabled],
  ['Admin workflow', readiness.admin_workflow_enabled],
  ['Support workflow', readiness.support_workflow_enabled],
  ['Provider suppression intake', readiness.provider_suppression_intake_enabled],
  ['Provider eligibility dry-run', readiness.provider_dry_run_enabled],
  ['Legacy migration dry-run', readiness.legacy_migration_dry_run_enabled],
  ['Provider live sends', readiness.provider_live_sends_enabled],
] as const;

const workflowCards = [
  ['Consent overview', 'Purpose, channel and source catalogues remain protected behind the admin workflow gate.'],
  ['Audit timeline', 'Customer consent events are chronological, redacted by route scope and append-only.'],
  ['Support request queue', 'Support may record a verified request; it cannot silently create campaign consent.'],
  ['Conflict resolution', 'Preview is restrictive. Resolution requires an admin reason, idempotency key and audit event.'],
  ['Provider suppressions', 'Verified STOP and unsubscribe evidence suppresses the affected channel without calling a provider.'],
  ['Eligibility dry-run', 'Returns ordered reasons only. It has no provider transport and cannot send.'],
] as const;
---

<AdminLayout title="Consent Operating Layer P0" description="Protected consent workflow and no-send readiness.">
  <div class="container mx-auto max-w-7xl px-6 lg:px-8">
    <header class="mb-8 border-b border-slate-200 pb-6">
      <p class="text-xs font-black uppercase tracking-wider text-brand-primaryInk">Slice 9-X PRIME · gated P0</p>
      <h1 class="mt-2 text-3xl font-black text-slate-950">Consent Operating Layer</h1>
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-slate-600">
        Local persistence workflows, audit review, suppression intake and eligibility previews. This dashboard contains no live-send control.
      </p>
    </header>

    <section class:list={[
      'mb-8 rounded-2xl border p-6',
      readiness.no_send_status === 'pass' ? 'border-emerald-200 bg-emerald-50' : 'border-red-300 bg-red-50',
    ]}>
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h2 class="text-xl font-black text-slate-950">No-send release gate</h2>
        <span class="rounded-full border border-current px-3 py-1 text-xs font-black uppercase">
          {readiness.no_send_status === 'pass' ? 'No-send boundary passes' : 'Unsafe configuration'}
        </span>
      </div>
      <p class="mt-3 text-sm text-slate-700">Live-send readiness: <strong>{readiness.live_send_readiness}</strong>. Production migration required: <strong>{String(readiness.production_migration_required)}</strong>.</p>
      <ul class="mt-4 grid gap-2 text-sm text-slate-700">{readiness.reasons.map(reason => <li>— {reason}</li>)}</ul>
    </section>

    <section aria-labelledby="gates-title">
      <h2 id="gates-title" class="text-xl font-black text-slate-950">Feature gates</h2>
      <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {gates.map(([label, enabled]) => (
          <article class="rounded-xl border border-slate-200 bg-white p-4">
            <p class="text-xs font-black uppercase tracking-wide text-slate-500">{label}</p>
            <p class:list={['mt-2 font-black', enabled ? 'text-blue-700' : 'text-slate-700']}>{enabled ? 'Enabled for gated environment' : 'Disabled'}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-10" aria-labelledby="workflows-title">
      <h2 id="workflows-title" class="text-xl font-black text-slate-950">Protected admin and support workflow</h2>
      <div class="mt-4 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {workflowCards.map(([title, description]) => (
          <article class="rounded-2xl border border-slate-200 bg-white p-5">
            <h3 class="font-black text-slate-950">{title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{description}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-10 rounded-2xl border border-slate-200 bg-white p-6" aria-labelledby="stop-title" id="stop-intake" data-testid="stop-intake">
      <h2 id="stop-title" class="text-xl font-black text-slate-950">Record a STOP or unsubscribe</h2>
      <p class="mt-2 max-w-3xl text-sm text-slate-600">
        Inbound replies are not delivered to us by the provider. When a customer sends STOP (or asks to unsubscribe), check the message in the provider console and record it here. The contact is suppressed on that channel; no message is sent.
      </p>
      {intakeNotice && (
        <div role="status" class:list={['mt-4 rounded-xl border p-4 text-sm', intakeNotice.kind === 'ok' ? 'border-emerald-200 bg-emerald-50 text-emerald-900' : 'border-red-200 bg-red-50 text-red-900']}>
          <ul>{intakeNotice.messages.map(m => <li>{m}</li>)}</ul>
        </div>
      )}
      {!readiness.provider_suppression_intake_enabled ? (
        <div class="mt-4 rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-950" data-testid="stop-intake-disabled">
          <strong>Intake disabled.</strong> The feature gate CONSENT_PROVIDER_SUPPRESSION_INTAKE_ENABLED is off (or the consent service did not answer), so the API would refuse this form. Ask an engineer to enable the gate for this environment; until then, keep the evidence and record it once enabled.
        </div>
      ) : null}
      <form method="POST" action="/admin/consent-operating#stop-intake" class="mt-6 grid gap-4 md:grid-cols-2">
        <fieldset disabled={!readiness.provider_suppression_intake_enabled} class="contents">
          <input type="hidden" name="idempotency_key" value={intakeIdempotencyKey} />
          <label class="grid gap-1 text-sm font-bold text-slate-700">Channel
            <select name="channel" required class="rounded-lg border border-slate-300 px-3 py-2 font-normal">
              {STOP_CHANNELS.map(ch => <option value={ch}>{ch === 'whatsapp' ? 'WhatsApp' : ch === 'sms' ? 'SMS' : 'Email'}</option>)}
            </select>
          </label>
          <label class="grid gap-1 text-sm font-bold text-slate-700">Phone number or email
            <input name="contact" required autocomplete="off" placeholder="0772 123456 or name@example.com" class="rounded-lg border border-slate-300 px-3 py-2 font-normal" />
          </label>
          <label class="grid gap-1 text-sm font-bold text-slate-700">Signal
            <select name="event_type" class="rounded-lg border border-slate-300 px-3 py-2 font-normal">
              <option value="stop">STOP reply</option>
              <option value="unsubscribe">Unsubscribe request</option>
            </select>
          </label>
          <label class="grid gap-1 text-sm font-bold text-slate-700">Provider
            <input name="provider_key" value="zoho_cpaas" required class="rounded-lg border border-slate-300 px-3 py-2 font-normal" />
          </label>
          <label class="grid gap-1 text-sm font-bold text-slate-700">Provider message / ticket reference
            <input name="provider_event_ref" required class="rounded-lg border border-slate-300 px-3 py-2 font-normal" />
          </label>
          <label class="grid gap-1 text-sm font-bold text-slate-700">When the customer sent it (Kampala time)
            <input type="datetime-local" name="provider_occurred_at" required class="rounded-lg border border-slate-300 px-3 py-2 font-normal" />
          </label>
          <label class="grid gap-1 text-sm font-bold text-slate-700 md:col-span-2">Evidence note
            <textarea name="evidence" required minlength="5" rows="3" placeholder="Customer replied STOP to the order-update message; seen in Zoho console." class="rounded-lg border border-slate-300 px-3 py-2 font-normal"></textarea>
          </label>
          <label class="flex gap-2 text-sm text-slate-700 md:col-span-2"><input type="checkbox" name="authenticity_verified" required /> I saw this message myself in the provider console.</label>
          <label class="flex gap-2 text-sm text-slate-700 md:col-span-2"><input type="checkbox" name="freshness_verified" required /> The message is recent and the customer has not since opted back in.</label>
          <div class="md:col-span-2">
            <button class="rounded-xl bg-slate-950 px-5 py-2 text-sm font-black text-white disabled:opacity-50">Record suppression</button>
          </div>
        </fieldset>
      </form>

      <h3 class="mt-8 text-sm font-black uppercase tracking-wide text-slate-500">Recent active suppressions</h3>
      {suppressions.state === 'available' ? (
        suppressions.rows.length === 0 ? (
          <p class="mt-2 text-sm text-slate-600">No active suppressions recorded.</p>
        ) : (
          <div class="mt-2 overflow-x-auto">
            <table class="w-full text-sm" data-testid="suppression-list">
              <thead class="text-left text-xs uppercase text-slate-500"><tr><th class="py-2 pr-4">Effective</th><th class="py-2 pr-4">Channel</th><th class="py-2 pr-4">Contact</th><th class="py-2 pr-4">Source</th><th class="py-2">Lift</th></tr></thead>
              <tbody>
                {suppressions.rows.map(row => (
                  <tr class="border-t border-slate-100 align-top">
                    <td class="py-2 pr-4 whitespace-nowrap">{row.effectiveAt ? new Date(String(row.effectiveAt)).toLocaleString('en-GB', { timeZone: 'Africa/Kampala' }) : '—'}</td>
                    <td class="py-2 pr-4">{String(row.channelKey ?? '—')}</td>
                    <td class="py-2 pr-4 font-mono text-xs">{maskEndpointRef(row.endpointRef)}</td>
                    <td class="py-2 pr-4 text-xs">{String(row.sourceSurface ?? '—')}</td>
                    <td class="py-2">
                      <form method="POST" action="/admin/consent-operating#stop-intake" class="flex flex-wrap items-center gap-2" data-testid="suppression-lift-form">
                        <input type="hidden" name="intent" value="lift" />
                        <input type="hidden" name="suppression_id" value={String(row.id ?? '')} />
                        <input name="lift_reason" required minlength="5" maxlength="500" placeholder="Reason (no phone or email)" aria-label="Reason for lifting this suppression" class="w-40 rounded-lg border border-slate-300 px-2 py-1 text-xs font-normal" />
                        <button class="rounded-lg border border-slate-300 px-3 py-1 text-xs font-black text-slate-700 hover:border-slate-900">Lift</button>
                      </form>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )
      ) : (
        <p class="mt-2 text-sm text-slate-600" data-testid="suppression-unavailable">Suppression list {suppressions.state === 'disabled' ? 'disabled' : 'unavailable'}: {suppressions.reason}</p>
      )}
    </section>

    <aside class="mt-10 rounded-2xl border border-amber-200 bg-amber-50 p-6 text-sm leading-relaxed text-amber-950">
      Specialist approvals remain pending. Dry-run readiness is not live-send readiness. No provider, queue, email, SMS or WhatsApp transport is reachable from this module.
    </aside>
  </div>
</AdminLayout>
