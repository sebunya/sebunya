---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { readSessionToken } from "../../lib/session";
import { LEGAL_POLICIES, POLICY_STATUS_LABEL } from "../../lib/legal-policies";

const token = readSessionToken(Astro.request);
if (!token) {
  return Astro.redirect("/admin/login?returnTo=/admin/legal", 303);
}
---

<AdminLayout
  title="Legal Policies"
  description="Policy registry: versions, review status, and effective dates."
>
  <div class="container mx-auto px-6 lg:px-8 max-w-5xl">
    <div class="mb-8 pb-6 border-b border-gray-200">
      <h2 class="text-2xl font-black text-brand-dark tracking-tight">Policy Registry</h2>
      <p class="text-sm text-gray-500 mt-1 max-w-2xl">
        Single source of truth for public policy pages. Effective dates are set only after
        formal legal review — drafts state their status plainly and invent no commitments.
        Returns and warranty claims route through the existing support workflow.
      </p>
    </div>

    <div class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="bg-gray-50 border-b border-gray-100 text-[10px] uppercase font-black text-gray-400 tracking-widest">
            <th class="p-5">Policy</th>
            <th class="p-5">Version</th>
            <th class="p-5">Status</th>
            <th class="p-5">Effective date</th>
            <th class="p-5 text-right">Page</th>
          </tr>
        </thead>
        <tbody class="text-xs">
          {LEGAL_POLICIES.map((p) => (
            <tr class="border-b border-gray-50 hover:bg-gray-50/50 transition-colors">
              <td class="p-5">
                <div class="font-bold text-brand-dark">{p.title}</div>
                <div class="text-[10px] text-gray-400 mt-0.5">{p.summary}</div>
              </td>
              <td class="p-5 font-mono">{p.version}</td>
              <td class="p-5">
                <span class={`text-[9px] font-black px-2.5 py-1 rounded uppercase tracking-widest border ${p.status === "interim_guidance" ? "border-blue-200 bg-blue-50 text-blue-700" : "border-amber-200 bg-amber-50 text-amber-800"}`}>
                  {POLICY_STATUS_LABEL[p.status]}
                </span>
              </td>
              <td class="p-5 text-gray-500">{p.effectiveDate ?? "Pending legal review"}</td>
              <td class="p-5 text-right">
                <a href={p.path} class="text-[10px] font-black uppercase tracking-widest text-brand-dark hover:text-brand-primary">View</a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <p class="mt-6 text-xs text-gray-500">
      Next operator action: legal review of the three draft policies, then set versions to
      1.0 with real effective dates in <code class="font-mono">apps/web/src/lib/legal-policies.ts</code>.
    </p>
  </div>
</AdminLayout>
