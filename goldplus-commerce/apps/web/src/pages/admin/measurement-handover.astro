---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminPageHeader from '../../components/AdminPageHeader.astro';
import HandoverShell from '../../components/admin/measurement-handover/HandoverShell.astro';
import { readSessionToken } from '../../lib/session';

const token = readSessionToken(Astro.request);
if (!token) {
  return Astro.redirect('/admin/login?returnTo=/admin/measurement-handover', 303);
}

/* Read-only by design: an index of the measurement runbooks and the exact
   verification commands. There is no data path to complete here — the value is
   that an operator can find the right procedure without searching the repo. */
---

<AdminLayout title="Measurement Operations Handbook">
  <AdminPageHeader 
    title="Measurement Operations Handbook" 
    description="Runbooks and verification commands for operating the measurement pipeline." 
  />
  <div class="px-4 sm:px-6 lg:px-8 mt-6">
    <HandoverShell />
  </div>
</AdminLayout>
