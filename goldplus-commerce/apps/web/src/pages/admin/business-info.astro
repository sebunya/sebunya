---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { readSessionToken } from '../../lib/session';
import { apiBase } from '../../lib/api';
import { BUSINESS_SOCIAL_KEYS } from '@goldplus/shared';

/**
 * Business / contact info editor (0112). Address, hours, phone, WhatsApp, the
 * delivery window and social links — the footer reads these from the DB, so an
 * edit here goes live with no deploy.
 */
const token = readSessionToken(Astro.request);
if (!token) return Astro.redirect('/admin/login?returnTo=/admin/business-info', 303);

const authed = (path: string, init?: RequestInit) =>
  fetch(`${apiBase}${path}`, { ...init, headers: { ...init?.headers, Authorization: `Bearer ${token}`, Accept: 'application/json' } });

let notice: { kind: 'ok' | 'error'; message: string } | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  try {
    const socials = BUSINESS_SOCIAL_KEYS.map((key) => ({
      key,
      label: key.charAt(0).toUpperCase() + key.slice(1),
      href: String(form.get(`social.${key}.href`) ?? '').trim(),
      enabled: form.get(`social.${key}.enabled`) === 'on',
    }));
    const config = {
      phoneDisplay: String(form.get('phoneDisplay') ?? '').trim(),
      phoneDial: String(form.get('phoneDial') ?? '').trim(),
      whatsappNumber: String(form.get('whatsappNumber') ?? '').trim(),
      whatsappUrl: String(form.get('whatsappUrl') ?? '').trim(),
      whatsappChannelUrl: String(form.get('whatsappChannelUrl') ?? '').trim(),
      addressLine1: String(form.get('addressLine1') ?? '').trim(),
      addressLine2: String(form.get('addressLine2') ?? '').trim(),
      mapUrl: String(form.get('mapUrl') ?? '').trim(),
      shopHours: String(form.get('shopHours') ?? '').trim(),
      deliveryHours: String(form.get('deliveryHours') ?? '').trim(),
      deliveryNote: String(form.get('deliveryNote') ?? '').trim(),
      openDays: String(form.get('openDays') ?? '').trim(),
      socials,
    };
    const res = await authed('/admin/business-info', { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ config }) });
    const json: any = await res.json().catch(() => null);
    notice = res.ok && json?.success
      ? { kind: 'ok', message: `Saved (version ${json.data.version}). Live in the footer within a minute.` }
      : { kind: 'error', message: json?.error?.message ?? 'Could not save.' };
  } catch (e) {
    notice = { kind: 'error', message: e instanceof Error ? e.message : 'Could not save.' };
  }
}

let cfg: any = null; let loadError = '';
try {
  const res = await authed('/admin/business-info');
  if (res.status === 401 || res.status === 403) return Astro.redirect('/admin/login?returnTo=/admin/business-info', 303);
  const json: any = await res.json().catch(() => null);
  if (res.ok && json?.success) cfg = json.data.config;
  else loadError = json?.error?.message ?? 'Could not load business info.';
} catch { loadError = 'The service is unreachable right now.'; }

const socialFor = (key: string) => (cfg?.socials ?? []).find((s: any) => s.key === key) ?? { href: '', enabled: false };
const field = (name: string, label: string, value: string, ph = '') =>
  ({ name, label, value: value ?? '', ph });
const scalarFields = cfg ? [
  field('addressLine1', 'Address line 1', cfg.addressLine1, 'Wilson Road, Kampala'),
  field('addressLine2', 'Address line 2 (directions)', cfg.addressLine2),
  field('mapUrl', 'Map link', cfg.mapUrl),
  field('phoneDisplay', 'Phone (display)', cfg.phoneDisplay, '0705 004545'),
  field('phoneDial', 'Phone (dial, tel:+256…)', cfg.phoneDial, 'tel:+256705004545'),
  field('whatsappNumber', 'WhatsApp number (256…)', cfg.whatsappNumber),
  field('whatsappUrl', 'WhatsApp chat link', cfg.whatsappUrl),
  field('whatsappChannelUrl', 'WhatsApp channel link', cfg.whatsappChannelUrl),
  field('shopHours', 'Shop hours', cfg.shopHours, '8:30am–6:00pm'),
  field('deliveryHours', 'Delivery hours', cfg.deliveryHours, '8:30am–8:00pm'),
  field('openDays', 'Open days', cfg.openDays, 'Monday to Saturday'),
  field('deliveryNote', 'Delivery note', cfg.deliveryNote),
] : [];
---
<AdminLayout title="Business info">
  <div class="mx-auto max-w-3xl px-4 py-8">
    <h1 class="text-2xl font-black text-slate-900">Business & contact info</h1>
    <p class="mt-2 text-sm text-slate-600">Address, hours, phone, WhatsApp and social links shown in the footer. Changes go live within a minute, no deploy.</p>

    {notice && (
      <div class:list={["mt-6 rounded-xl border p-4 text-sm", notice.kind === 'ok' ? 'border-emerald-300 bg-emerald-50 text-emerald-900' : 'border-red-300 bg-red-50 text-red-900']}>
        <p class="font-bold">{notice.message}</p>
      </div>
    )}
    {loadError && <div class="mt-6 rounded-xl border border-red-300 bg-red-50 p-4 text-sm text-red-900">{loadError}</div>}

    {cfg && (
      <form method="POST" class="mt-8 space-y-8">
        <section class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {scalarFields.map((f) => (
            <label class="text-xs block">{f.label}
              <input class="mt-1 w-full rounded border px-3 py-2 text-sm" name={f.name} value={f.value} placeholder={f.ph} />
            </label>
          ))}
        </section>

        <section>
          <h2 class="text-sm font-black uppercase tracking-wider text-slate-500">Social links</h2>
          <p class="text-xs text-slate-500">Tick to show the icon in the footer; paste the full profile URL.</p>
          <div class="mt-3 space-y-2">
            {BUSINESS_SOCIAL_KEYS.map((key) => {
              const s = socialFor(key);
              return (
                <div class="grid grid-cols-[110px_auto_1fr] items-center gap-2 rounded-lg border border-slate-200 p-2">
                  <span class="text-xs font-mono text-slate-500 capitalize">{key}</span>
                  <label class="text-xs flex items-center gap-1"><input type="checkbox" name={`social.${key}.enabled`} checked={s.enabled} /> show</label>
                  <input class="w-full rounded border px-2 py-1 text-sm" name={`social.${key}.href`} value={s.href} placeholder={`https://${key}.com/ShopGoldPlus`} />
                </div>
              );
            })}
          </div>
        </section>

        <button type="submit" class="rounded-full bg-slate-900 px-6 py-3 text-sm font-bold text-white">Save business info</button>
      </form>
    )}
  </div>
</AdminLayout>
