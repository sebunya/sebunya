---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { readSessionToken } from '../../../lib/session';

const token = readSessionToken(Astro.request);
if (!token) {
  return Astro.redirect("/admin/login?returnTo=/admin/categories", 303);
}
---

<AdminLayout 
  title="Categories — not yet available" 
  description="Category management is not available in this admin yet."
>
  <div class="container mx-auto px-6 lg:px-8 max-w-7xl">
    
    <div class="flex flex-col sm:flex-row sm:items-center justify-between mb-8 gap-4 pb-6 border-b border-gray-200">
      <div>
        <h2 class="text-2xl font-black text-brand-dark tracking-tight">Categories</h2>
        <p class="text-sm text-gray-500 mt-1">Category management is not available in this admin yet.</p>
      </div>
    </div>

    <div class="mt-12 p-16 border border-dashed border-gray-300 bg-gray-50 rounded-2xl text-center max-w-3xl mx-auto flex flex-col items-center justify-center">
      <h4 class="font-black text-brand-dark text-base">Feature Under Construction</h4>
      <p class="text-xs text-gray-500 mt-2 max-w-md leading-relaxed font-medium">
        Category configurations and taxonomy hierarchies are managed directly within the seed files and database layer. They are not yet exposed as a live, modifiable module.
      </p>
      <a href="/admin" class="mt-6 text-xs font-bold text-white bg-brand-dark hover:bg-black px-5 py-2.5 rounded-xl transition-colors shadow-sm">
        Return to Control Centre
      </a>
    </div>

  </div>
</AdminLayout>


