---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import Notice from "../../../components/Notice.astro";
import { apiBase } from "../../../lib/api";
import { readSessionToken, clearSessionCookie } from "../../../lib/session";

const { id } = Astro.params;
const token = readSessionToken(Astro.request);
if (!token) {
  return Astro.redirect(`/admin/login?returnTo=/admin/products/${encodeURIComponent(id ?? '')}`, 303);
}

// The products list links by id, but /products/:slug matches on SLUG ONLY, so
// passing the uuid always returned NOT_FOUND and this page rendered empty.
// Resolve the id to its slug on the admin route first, then read the same
// public view the page has always rendered.
async function resolveSlug(productId: string): Promise<string | null> {
  try {
    const res = await fetch(`${apiBase}/admin/products/${encodeURIComponent(productId)}`, {
      headers: { 'Authorization': `Bearer ${token}` }
    });
    const json = await res.json().catch(() => null);
    return json?.success ? (json.data?.slug ?? null) : null;
  } catch {
    return null;
  }
}

async function fetchProduct(productId: string) {
  try {
    const slug = await resolveSlug(productId);
    if (!slug) return null;
    const res = await fetch(`${apiBase}/products/${encodeURIComponent(slug)}`, {
      headers: { 'Authorization': `Bearer ${token}` }
    });
    const json = await res.json().catch(() => null);
    if (res.status === 401 || res.status === 403) return { authError: true };
    return json?.success ? json.data : null;
  } catch {
    return null;
  }
}

const product = await fetchProduct(id || '');

if (product && (product as any).authError) {
  Astro.response.headers.set('Set-Cookie', clearSessionCookie());
  return Astro.redirect(`/admin/login?returnTo=/admin/products/${encodeURIComponent(id ?? '')}`, 303);
}

import { formatUgx } from '../../../lib/money';
// UGX code format via the single money source (en-UG's currency symbol is "USh").
const formatter = { format: (n: unknown) => formatUgx(n) };
---

<AdminLayout 
  title={product ? `${product.name} - Details` : 'Product details'} 
  description="Review complete product specification, stock status, and attributes."
>
  <div class="container mx-auto px-6 lg:px-8 max-w-7xl">
    
    <div class="flex flex-col sm:flex-row sm:items-center justify-between mb-8 gap-4 pb-6 border-b border-gray-200">
      <div class="flex items-center gap-3">
        <a href="/admin/products" class="w-8 h-8 rounded-lg border border-gray-200 bg-white hover:bg-gray-50 flex items-center justify-center text-gray-500 transition-colors shadow-xs font-bold">
          &larr;
        </a>
        <div>
          <h2 class="text-2xl font-black text-brand-dark tracking-tight">Product details</h2>
          <p class="text-sm text-gray-500 mt-1">Inspect technical specifications and live visibility states.</p>
        </div>
      </div>
      
      {product && (
        <div class="flex items-center gap-3">
          <a 
            href={`/products/${product.slug}`} 
            target="_blank" 
            class="bg-white border border-gray-200 hover:bg-gray-50 text-brand-dark font-bold text-xs px-4 py-2 rounded-xl transition-colors shadow-xs flex items-center gap-2"
          >
            Public Storefront &rarr;
          </a>
          <a 
            href={`/admin/products/${product.id}/listing`} 
            class="bg-white hover:bg-gray-50 text-brand-dark font-black text-xs px-4 py-2 rounded-xl transition-colors shadow-xs uppercase tracking-wider border border-gray-300"
          >
            Listing
          </a>
          <a 
            href={`/admin/products/${product.id}/edit-properties`} 
            class="bg-white hover:bg-gray-50 text-brand-dark font-black text-xs px-4 py-2 rounded-xl transition-colors shadow-xs uppercase tracking-wider border border-gray-300"
          >
            Edit Properties
          </a>
          <a 
            href={`/admin/products/${product.id}/edit`} 
            class="bg-brand-dark hover:bg-black text-white font-black text-xs px-4 py-2 rounded-xl transition-colors shadow-xs uppercase tracking-wider"
          >
            Edit Assets
          </a>
        </div>
      )}
    </div>

    {!product ? (
      <Notice kind="not-configured" title="Product Not Found" message="The requested product could not be located in the central database. It may have been removed or archived." />
    ) : (
      <div class="space-y-8 mb-12">
        
        {/* Primary Header Info Card */}
        <div class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden grid grid-cols-1 lg:grid-cols-3">
          
          {/* Left: Primary Image Section */}
          <div class="p-8 border-b lg:border-b-0 lg:border-r border-gray-100 flex flex-col items-center justify-center bg-gray-50/30">
            <div class="w-64 h-64 bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden flex items-center justify-center p-4">
              {product.images && product.images.length > 0 ? (
                <img src={product.images[0].url} alt={product.images[0].alt || product.name} class="max-w-full max-h-full object-contain" />
              ) : (
                <div class="flex flex-col items-center gap-2 text-gray-400">
                  <span class="text-[10px] font-black uppercase tracking-widest">No media bound</span>
                </div>
              )}
            </div>
            {product.images && product.images.length > 1 && (
              <div class="flex gap-3 mt-6 overflow-x-auto max-w-full pb-2">
                {product.images.slice(1, 5).map((img: any) => (
                  <div class="w-12 h-12 rounded-lg border border-gray-200 bg-white p-1 flex-shrink-0 overflow-hidden flex items-center justify-center">
                     <img src={img.url} class="max-w-full max-h-full object-contain" alt="" />
                  </div>
                ))}
              </div>
            )}
          </div>

          {/* Right: Product Information Fields */}
          <div class="p-8 lg:col-span-2 space-y-6">
            
            <div class="flex justify-between items-start gap-4">
              <div>
                <span class="text-[9px] font-black text-brand-gold uppercase tracking-widest border border-brand-gold/20 bg-brand-gold/5 px-2 py-0.5 rounded">{product.categoryName || 'General'}</span>
                <h3 class="text-xl font-black text-brand-dark mt-2 leading-snug">{product.name}</h3>
                <code class="text-[10px] text-gray-400 font-mono bg-gray-50 px-2 py-0.5 rounded border border-gray-100 inline-block mt-1.5">UUID: {product.id}</code>
              </div>
              <div class="text-right">
                 <p class="text-[9px] font-black text-gray-400 uppercase tracking-widest">Retail Price</p>
                 <p class="text-2xl font-black text-brand-dark mt-1">{product.priceUgx ? formatter.format(product.priceUgx) : '—'}</p>
              </div>
            </div>

            <div class="grid grid-cols-2 sm:grid-cols-4 gap-6 py-6 border-y border-gray-100">
              <div>
                <span class="text-[9px] font-bold text-gray-400 uppercase tracking-wider block mb-1">SKU Reference</span>
                <span class="text-sm font-black font-mono text-brand-dark">{product.sku || '—'}</span>
              </div>
              <div>
                <span class="text-[9px] font-bold text-gray-400 uppercase tracking-wider block mb-1">Stock Status</span>
                <span class={`inline-block px-2 py-0.5 rounded-full text-[8px] font-black uppercase tracking-wider border ${
                  product.stockStatus === 'in_stock' ? 'bg-green-50 text-green-700 border-green-100' : 'bg-red-50 text-red-700 border-red-100'
                }`}>
                  {(product.stockStatus || 'out_of_stock').replace('_', ' ')}
                </span>
              </div>
              <div>
                <span class="text-[9px] font-bold text-gray-400 uppercase tracking-wider block mb-1">Visibility State</span>
                <span class={`inline-block px-2 py-0.5 rounded text-[9px] font-black uppercase border ${product.active ? 'bg-brand-dark text-white border-brand-dark' : 'bg-gray-100 text-gray-400 border-gray-200'}`}>
                  {product.active ? 'Active' : 'Hidden'}
                </span>
              </div>
              <div>
                <span class="text-[9px] font-bold text-gray-400 uppercase tracking-wider block mb-1">Approval Step</span>
                <span class="text-[10px] font-bold text-gray-600 uppercase tracking-widest">{product.approvalStatus || 'Draft'}</span>
              </div>
            </div>

            <div class="space-y-3">
               <h4 class="text-[10px] font-black uppercase tracking-widest text-gray-400">Product Routing Mapping</h4>
               <div class="bg-gray-50 border border-gray-100 rounded-xl p-4 grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
                  <div>
                     <span class="text-[9px] text-gray-400 block font-bold uppercase mb-1">Storefront Slug</span>
                     <span class="font-mono text-brand-dark font-bold font-medium">/{product.slug}</span>
                  </div>
                  <div>
                     <span class="text-[9px] text-gray-400 block font-bold uppercase mb-1">Featured Promotion</span>
                     <span class="text-brand-dark font-medium">{product.isFeatured ? 'Enforced Featured Active' : 'Standard Catalogue Placement'}</span>
                  </div>
               </div>
            </div>

          </div>

        </div>

        {/* Specification Tables */}
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
          
          {/* Section A: Verified Attributes */}
          <div class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden">
             <div class="p-5 bg-gray-50 border-b border-gray-100">
                <h3 class="text-[10px] font-black uppercase tracking-widest text-brand-dark">Specifications & Attributes</h3>
             </div>
             <div class="p-6">
               {product.attributeValues && product.attributeValues.length > 0 ? (
                 <div class="border border-gray-100 rounded-xl overflow-hidden text-xs">
                    <table class="w-full text-left border-collapse">
                       <thead>
                          <tr class="bg-gray-50/50 font-black uppercase text-[8px] text-gray-400 border-b border-gray-100">
                             <th class="p-3 pl-4">Property</th>
                             <th class="p-3">Value</th>
                             <th class="p-3 text-right">Verified</th>
                          </tr>
                       </thead>
                       <tbody class="divide-y divide-gray-50 font-medium text-gray-700">
                          {product.attributeValues.map((attr: any) => (
                            <tr>
                               <td class="p-3 pl-4 font-bold text-brand-dark uppercase text-[9px] tracking-wider">{attr.name}</td>
                               <td class="p-3">{attr.value}{attr.unit ? ` ${attr.unit}` : ''}</td>
                               <td class="p-3 text-right">
                                 <span class={`inline-block w-2 h-2 rounded-full ${attr.isVerified ? 'bg-green-500' : 'bg-yellow-400'}`}></span>
                               </td>
                            </tr>
                          ))}
                       </tbody>
                    </table>
                 </div>
               ) : (
                 <div class="text-center py-8 bg-gray-50 border border-dashed border-gray-200 rounded-xl text-xs text-gray-400">
                   No dynamic specifications configured for this catalog entry.
                 </div>
               )}
             </div>
          </div>

          {/* Section B: Syndicated Media Alt Texts */}
          <div class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden flex flex-col">
             <div class="p-5 bg-gray-50 border-b border-gray-100">
                <h3 class="text-[10px] font-black uppercase tracking-widest text-brand-dark">Bound Media Assets</h3>
             </div>
             <div class="p-6 flex-1">
               {product.images && product.images.length > 0 ? (
                 <div class="space-y-4">
                   {product.images.map((img: any, idx: number) => (
                      <div class="flex gap-3 items-start bg-gray-50 p-3 border border-gray-100 rounded-xl text-xs">
                         <div class="w-10 h-10 rounded bg-white border border-gray-200 flex-shrink-0 overflow-hidden flex items-center justify-center">
                            <img src={img.url} class="max-w-full max-h-full object-contain" alt="" />
                         </div>
                         <div class="min-w-0">
                            <div class="flex items-center gap-2">
                               <span class="font-black uppercase text-[8px] tracking-wider text-gray-400">Slot {idx + 1}</span>
                               {idx === 0 && <span class="bg-brand-gold/10 text-brand-gold text-[7px] font-black uppercase px-1 rounded">Primary</span>}
                            </div>
                            <p class="text-[9px] text-gray-500 italic truncate max-w-xs mt-0.5">{img.url}</p>
                            <p class="text-brand-dark font-medium text-[10px] mt-1 font-bold">Alt: {img.alt || 'No context descriptive text provided'}</p>
                         </div>
                      </div>
                   ))}
                 </div>
               ) : (
                 <div class="flex-1 flex items-center justify-center py-8 bg-gray-50 border border-dashed border-gray-200 rounded-xl text-xs text-gray-400">
                   Zero visual binary references stored.
                 </div>
               )}
             </div>
          </div>

        </div>

      </div>
    )}

  </div>
</AdminLayout>
