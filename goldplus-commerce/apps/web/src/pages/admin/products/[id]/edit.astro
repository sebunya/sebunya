---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import FormField from '../../../../components/FormField.astro';
import FormFeedback from '../../../../components/FormFeedback.astro';
import Notice from '../../../../components/Notice.astro';
import { apiBase } from '../../../../lib/api';
import { readSessionToken, clearSessionCookie } from '../../../../lib/session';
import type { ProductPublicDto } from '@goldplus/shared';

const { id } = Astro.params;
const token = readSessionToken(Astro.request);
if (!token) {
  return Astro.redirect(`/admin/login?returnTo=/admin/products/${encodeURIComponent(id ?? '')}/edit`, 303);
}

let status: 'success' | 'error' | null = null;
let message: string | undefined;

async function authedJson<T>(path: string, init?: RequestInit): Promise<{ status: number; data: T | null; error?: string }> {
  const res = await fetch(`${apiBase}${path}`, {
    ...(init ?? {}),
    headers: { ...(init?.headers as any ?? {}), Authorization: `Bearer ${token}` },
  });
  const json = await res.json().catch(() => null);
  return { status: res.status, data: json?.success ? (json.data as T) : null, error: json?.error?.message };
}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('_action') ?? '');

  if (action === 'add_image') {
    const url = String(form.get('url') ?? '').trim();
    const altText = String(form.get('altText') ?? '').trim() || null;
    const makePrimary = form.get('makePrimary') === 'on';
    const res = await authedJson(`/admin/products/${encodeURIComponent(id ?? '')}/images`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ url, altText, makePrimary }),
    });
    if (res.status >= 200 && res.status < 300) {
      status = 'success';
      message = 'Image URL linked.';
    } else {
      status = 'error';
      message = res.error ?? `Could not add image (HTTP ${res.status}).`;
    }
  } else if (action === 'upload_images') {
    const apiFormData = new FormData();
    const allFiles = form.getAll('files');
    
    let validFiles = 0;
    allFiles.forEach((f) => {
      if (f instanceof File && f.size > 0) {
        apiFormData.append('files', f);
        validFiles++;
      }
    });

    if (validFiles === 0) {
      status = 'error';
      message = 'Please select at least one valid image file to upload.';
    } else {
      apiFormData.append('altText', String(form.get('altText') ?? ''));
      apiFormData.append('makeFirstPrimary', form.get('makePrimary') === 'on' ? 'true' : 'false');

      const res = await fetch(`${apiBase}/admin/products/${encodeURIComponent(id ?? '')}/images/upload`, {
        method: 'POST',
        headers: { Authorization: `Bearer ${token}` },
        body: apiFormData,
      });
      const json = await res.json().catch(() => ({ error: { message: 'Network error.' } }));

      if (res.ok) {
        status = 'success';
        message = 'Images uploaded successfully.';
      } else {
        status = 'error';
        message = json.error?.message ?? 'Failed to upload images.';
      }
    }
  } else if (action === 'set_attribute') {
    const attributeId = String(form.get('attributeId') ?? '').trim();
    const value = String(form.get('value') ?? '').trim();
    const isVerified = form.get('isVerified') === 'on';
    const res = await authedJson(`/admin/products/${encodeURIComponent(id ?? '')}/attribute-values`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ attributeId, value, isVerified }),
    });
    if (res.status >= 200 && res.status < 300) {
      status = 'success';
      message = 'Attribute value set.';
    } else {
      status = 'error';
      message = res.error ?? `Could not set attribute value (HTTP ${res.status}).`;
    }
  }
}

// /products/:slug matches on SLUG ONLY; this page is reached by id, so the
// uuid has to be resolved to its slug on the admin route first.
const adminProductRes = await authedJson<{ slug?: string }>(`/admin/products/${encodeURIComponent(id ?? '')}`);
const productSlug = adminProductRes.data?.slug ?? '';
const productRes = productSlug
  ? await authedJson<ProductPublicDto>(`/products/${encodeURIComponent(productSlug)}`)
  : { status: adminProductRes.status, data: null as ProductPublicDto | null };
if (adminProductRes.status === 401 || adminProductRes.status === 403 || productRes.status === 401 || productRes.status === 403) {
  Astro.response.headers.set('Set-Cookie', clearSessionCookie());
  return Astro.redirect(`/admin/login?returnTo=/admin/products/${encodeURIComponent(id ?? '')}/edit`, 303);
}
const product = productRes.data;
---

<AdminLayout 
  title={product ? `Edit SKU` : 'Asset Management'} 
  description="Manage dynamic configurations and physical assets."
>
  <div class="container mx-auto px-6 lg:px-8 max-w-7xl">
    
    <div class="flex flex-col sm:flex-row sm:items-center justify-between mb-8 gap-4 pb-6 border-b border-gray-200">
      <div>
        <h2 class="text-2xl font-black text-brand-dark tracking-tight">
          {product ? product.name : 'Direct Catalogue Mutation'}
        </h2>
        <p class="text-sm text-gray-500 mt-1">Mutate structural specifications and syndication media assets.</p>
      </div>
      <a href="/admin/products" class="text-xs font-bold text-gray-400 hover:text-brand-dark border border-gray-200 px-3 py-1.5 rounded-lg bg-white transition-colors">
        &larr; Product List
      </a>
    </div>

    {!product ? (
      <Notice kind="not-configured" title="Asset Unavailable" message="The requested product listing was not fetched from the core relational datastore." />
    ) : (
      <div class="space-y-8">
        <FormFeedback status={status} message={message} />

        <section class="bg-white border border-gray-200 rounded-2xl p-6 shadow-sm">
          <h2 class="text-[10px] font-black uppercase tracking-widest text-gray-400 mb-6">Syndication Images ({product.images.length})</h2>

          {product.images.length === 0 ? (
            <p class="text-xs text-gray-400 italic mb-6 font-medium">No binary media attached. Establish primary links below.</p>
          ) : (
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-8 border-b border-gray-100 pb-8">
              {product.images.map((img, idx) => (
                <div class="border border-gray-200 rounded-2xl overflow-hidden bg-gray-50 flex flex-col shadow-sm">
                  <div class="aspect-square bg-white flex items-center justify-center p-3">
                    <img src={img.url} alt={img.alt ?? ''} class="max-w-full max-h-full object-contain mix-blend-multiply" />
                  </div>
                  <div class="p-3 text-[8px] font-mono text-gray-400 break-all border-t border-gray-100 bg-white flex-grow">
                    {idx === 0 && <span class="inline-block px-1.5 py-0.5 mr-1.5 rounded bg-brand-green text-brand-dark font-black text-[7px] uppercase tracking-wide">Primary</span>}
                    {img.url.length > 50 ? img.url.slice(0, 50) + '…' : img.url}
                  </div>
                </div>
              ))}
            </div>
          )}

          <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mt-6">
            <div>
              <h3 class="text-xs font-black text-brand-dark uppercase tracking-wider mb-4">Local File Upload</h3>
              <form method="POST" action={Astro.url.pathname} enctype="multipart/form-data" class="space-y-4">
                <input type="hidden" name="_action" value="upload_images" />
                
                <div class="border-2 border-dashed border-gray-200 rounded-2xl p-8 text-center hover:border-brand-green/50 transition-colors cursor-pointer relative bg-gray-50">
                  <input 
                    type="file" 
                    name="files" 
                    multiple 
                    accept="image/jpeg,image/png,image/webp" 
                    class="absolute inset-0 w-full h-full opacity-0 cursor-pointer" 
                    required
                  />
                  <div class="pointer-events-none">
                    <div class="text-xs font-black text-gray-400 mb-3 uppercase tracking-widest">Upload Area</div>
                    <p class="text-xs font-black text-brand-dark">Click or Drag File Binaries</p>
                    <p class="text-[9px] text-gray-400 mt-1 leading-relaxed">JPG, PNG, or WebP. Maximum batch count 8.</p>
                  </div>
                </div>

                <FormField id="upAltText" name="altText" label="Context Accessibility Alt Text" placeholder="Description of visual frame..." />
                <label class="flex items-center gap-3 cursor-pointer">
                  <input type="checkbox" name="makePrimary" class="w-4 h-4 rounded-lg border-gray-300 text-brand-green focus:ring-brand-green" />
                  <span class="text-xs font-bold text-brand-dark">Designate leading batch item as primary</span>
                </label>
                
                <button type="submit" class="w-full bg-brand-dark text-white py-3 rounded-xl font-black text-xs uppercase tracking-wider hover:bg-black transition-colors shadow-sm mt-2">
                  Stream to Storage
                </button>
              </form>
            </div>

            <div class="border-t md:border-t-0 md:border-l border-gray-100 pt-8 md:pt-0 md:pl-8 flex flex-col justify-between">
              <div>
                <h3 class="text-xs font-black text-brand-dark uppercase tracking-wider mb-4">Synthesize External URL</h3>
                <form method="POST" action={Astro.url.pathname} class="space-y-4">
                  <input type="hidden" name="_action" value="add_image" />
                  <FormField id="url" name="url" label="Fully Qualified Resource Link (HTTPS)" type="url" required placeholder="https://static.brand.cdn/img.jpg" />
                  <FormField id="altText" name="altText" label="Context Accessibility Text" />
                  <label class="flex items-center gap-3 cursor-pointer">
                    <input type="checkbox" name="makePrimary" class="w-4 h-4 rounded-lg border-gray-300 text-brand-green focus:ring-brand-green" />
                    <span class="text-xs font-bold text-brand-dark">Override current leading image</span>
                  </label>
                  <button type="submit" class="w-full bg-white border border-gray-200 text-brand-dark py-3 rounded-xl font-black text-xs uppercase tracking-wider hover:bg-gray-50 transition-colors shadow-sm mt-2">
                    Register URL Reference
                  </button>
                </form>
              </div>
            </div>
          </div>
        </section>

        <section class="bg-white border border-gray-200 rounded-2xl p-6 shadow-sm">
          <h2 class="text-[10px] font-black uppercase tracking-widest text-gray-400 mb-6">Attribute Specification Logs ({product.attributeValues.length})</h2>

          {product.attributeValues.length === 0 ? (
            <p class="text-xs text-gray-400 italic mb-6 font-medium">No specific metadata rows bound.</p>
          ) : (
            <div class="border border-gray-100 rounded-2xl overflow-hidden mb-6 text-xs">
              <table class="w-full border-collapse text-left">
                <thead>
                  <tr class="bg-gray-50 text-[9px] uppercase font-black text-gray-400 border-b border-gray-100">
                    <th class="p-4">Label</th>
                    <th class="p-4">Registered Specification</th>
                    <th class="p-4 text-right">Origin Status</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-gray-50">
                  {product.attributeValues.map((v) => (
                    <tr>
                      <td class="p-4 font-black text-brand-dark uppercase tracking-wide text-[10px]">{v.name}</td>
                      <td class="p-4 font-medium text-gray-600">{v.value}{v.unit ? ` ${v.unit}` : ''}</td>
                      <td class="p-4 text-right">
                        <span class={`inline-block px-2 py-0.5 rounded text-[9px] font-black border uppercase tracking-wide ${
                          v.isVerified ? 'bg-green-50 text-green-700 border-green-100' : 'bg-yellow-50 text-yellow-700 border-yellow-100'
                        }`}>
                          {v.isVerified ? 'Verified Trace' : 'Self-Asserted'}
                        </span>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}

          <div class="bg-blue-50 border border-blue-100 p-5 rounded-2xl flex items-start gap-3 mb-6">
            <span class="w-1.5 h-1.5 bg-blue-600 rounded-full inline-block mt-1.5 flex-shrink-0"></span>
            <p class="text-[10px] text-blue-700 leading-relaxed font-medium">
              <strong>Structural Restraint:</strong> Establishing NEW specifications keys requires explicit relational migration hooks. The form below modifies state against designated existing registry slots.
            </p>
          </div>

          <form method="POST" action={Astro.url.pathname} class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-4">
            <input type="hidden" name="_action" value="set_attribute" />
            <FormField id="attributeId" name="attributeId" label="Static Core Attribute Identifier (UUID)" required />
            <FormField id="value" name="value" label="Mutation Value" placeholder="e.g. 20V / Carbon" required />
            <div class="sm:col-span-2 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-t border-gray-100 pt-4 mt-2">
              <label class="flex items-center gap-3 cursor-pointer">
                <input type="checkbox" name="isVerified" class="w-4 h-4 rounded-lg border-gray-300 text-brand-green focus:ring-brand-green" />
                <span class="text-xs font-bold text-brand-dark">Enforce formal verification signature</span>
              </label>
              <button type="submit" class="bg-brand-dark text-white px-6 py-2.5 rounded-xl font-black text-xs uppercase tracking-wider hover:bg-black transition-colors shadow-sm">
                Set Registry Value
              </button>
            </div>
          </form>
        </section>
      </div>
    )}
  </div>
</AdminLayout>

