---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { tryFetchAdminList } from "../../../lib/api";
import { readSessionToken } from "../../../lib/session";

const token = readSessionToken(Astro.request);
if (!token) {
  return Astro.redirect("/admin/login?returnTo=/admin/products", 303);
}

const fallbackProducts = [
  {
    id: "p1",
    name: "Generic Fast Charger",
    sku: "GP-CHG-001",
    modelNumber: "GP-001",
    categoryName: "Power",
    stockStatus: "in_stock",
    priceUgx: 50000,
    active: true,
    approvalStatus: "approved"
  }
];

// Call central governance endpoint which lists all products truthfully
const result = await tryFetchAdminList('/governance/admin/products', fallbackProducts);
const products = result.items;
const formatter = new Intl.NumberFormat('en-UG', { style: 'currency', currency: 'UGX', maximumFractionDigits: 0 });
---

<AdminLayout 
  title="Product Management" 
  description="Manage physical catalogue items, definitions and specs."
>
  <div class="container mx-auto px-6 lg:px-8 max-w-7xl">
    
    <div class="flex flex-col sm:flex-row sm:items-center justify-between mb-8 gap-4 pb-6 border-b border-gray-200">
      <div>
        <h2 class="text-2xl font-black text-brand-dark tracking-tight">Product Catalog</h2>
        <p class="text-sm text-gray-500 mt-1">Manage physical SKU definitions, categories and active state overrides.</p>
      </div>
      <div class="flex items-center gap-2">
        <span class="bg-gray-100 text-gray-600 border border-gray-200 text-xs font-bold px-3 py-1.5 rounded-lg font-mono">
          COUNT: {products.length}
        </span>
      </div>
    </div>

    {result.isSample && (
      <div class="bg-blue-50 border border-blue-200 text-blue-800 px-6 py-4 rounded-2xl mb-8 flex items-center gap-4">
        <span class="text-2xl">💡</span>
        <div class="text-xs leading-relaxed"><strong>Offline Sandbox Note:</strong> {result.reason}</div>
      </div>
    )}

    <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-gray-50 text-[10px] uppercase font-black text-gray-400 tracking-widest border-b border-gray-100">
              <th class="p-6">Product Spec</th>
              <th class="p-6">Category</th>
              <th class="p-6">Stock Status</th>
              <th class="p-6 text-right">Ugandan Price</th>
              <th class="p-6 text-center">Active</th>
            </tr>
          </thead>
          <tbody class="text-xs divide-y divide-gray-50">
            {products.map(p => (
              <tr class="hover:bg-gray-50 transition-colors">
                <td class="p-6">
                  <div class="font-bold text-brand-dark text-sm">{p.name}</div>
                  <div class="text-[10px] font-mono text-gray-400 mt-1 flex items-center gap-2">
                    <span class="bg-gray-100 px-1 rounded border border-gray-200">SKU: {p.sku}</span>
                    <span class="bg-gray-100 px-1 rounded border border-gray-200">MOD: {p.modelNumber || 'N/A'}</span>
                  </div>
                </td>
                <td class="p-6 text-gray-600 font-medium">
                  {p.categoryName || p.category || 'Uncategorized'}
                </td>
                <td class="p-6">
                  <span class={`px-2.5 py-1 rounded-lg font-black text-[9px] uppercase tracking-wider border ${p.stockStatus === 'in_stock' ? 'bg-green-50 text-green-700 border-green-100' : 'bg-red-50 text-red-700 border-red-100'}`}>
                    {p.stockStatus.replace('_', ' ')}
                  </span>
                </td>
                <td class="p-6 font-black text-right text-brand-dark text-sm">
                  {p.priceUgx ? formatter.format(p.priceUgx) : 'Quote Required'}
                </td>
                <td class="p-6 text-center">
                  {p.active ? (
                    <span class="bg-brand-green/10 text-brand-green text-[9px] px-2 py-0.5 rounded font-black uppercase tracking-wide border border-brand-green/20">Active</span>
                  ) : (
                    <span class="bg-gray-100 text-gray-400 text-[9px] px-2 py-0.5 rounded font-black uppercase tracking-wide border border-gray-200">Disabled</span>
                  )}
                </td>
              </tr>
            ))}
            {products.length === 0 && (
              <tr>
                <td colspan="5" class="p-20 text-center text-gray-400 italic text-xs leading-relaxed">
                  No physically seeded products matched current relational dataset query.
                </td>
              </tr>
            )}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</AdminLayout>

