---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { tryFetchAdminList } from "../../../lib/api";
import { readSessionToken } from "../../../lib/session";

const token = readSessionToken(Astro.request);
if (!token) {
  return Astro.redirect("/admin/login?returnTo=/admin/products", 303);
}

const fallbackProducts = [
  {
    id: "p1",
    name: "Generic Fast Charger",
    sku: "GP-CHG-001",
    modelNumber: "GP-001",
    category: "Power",
    stockStatus: "in_stock",
    priceUgx: 50000,
    active: true,
    approvalStatus: "approved",
    slug: "generic-fast-charger",
    imageUrl: undefined
  }
];

// Call central governance endpoint which lists all products
const result = await tryFetchAdminList('/governance/admin/products', fallbackProducts);
const products = result.items || [];

// 1. Extract unique values for contextual filter selections
const categories = Array.from(new Set(products.map(p => p.category).filter(Boolean))) as string[];
const stockStatuses = Array.from(new Set(products.map(p => p.stockStatus).filter(Boolean))) as string[];
const approvalStatuses = Array.from(new Set(products.map(p => p.approvalStatus).filter(Boolean))) as string[];

// 2. Parse search query parameters
const url = new URL(Astro.request.url);
const q = url.searchParams.get('q')?.trim() || '';
const cat = url.searchParams.get('cat')?.trim() || '';
const stock = url.searchParams.get('stock')?.trim() || '';
const visible = url.searchParams.get('visible')?.trim() || '';
const appr = url.searchParams.get('appr')?.trim() || '';

// 3. Apply client server-side filtering logic
let filteredProducts = [...products];
if (q) {
  const lowerQ = q.toLowerCase();
  filteredProducts = filteredProducts.filter(p => 
    (p.name || '').toLowerCase().includes(lowerQ) || 
    (p.sku || '').toLowerCase().includes(lowerQ)
  );
}
if (cat) {
  filteredProducts = filteredProducts.filter(p => p.category === cat);
}
if (stock) {
  filteredProducts = filteredProducts.filter(p => p.stockStatus === stock);
}
if (visible) {
  const isVisible = visible === 'true';
  filteredProducts = filteredProducts.filter(p => p.active === isVisible);
}
if (appr) {
  filteredProducts = filteredProducts.filter(p => p.approvalStatus === appr);
}

const formatter = new Intl.NumberFormat('en-UG', { style: 'currency', currency: 'UGX', maximumFractionDigits: 0 });
const isFiltered = q || cat || stock || visible || appr;
---

<AdminLayout 
  title="Products" 
  description="Review and manage products in your store catalog."
>
  <div class="container mx-auto px-6 lg:px-8 max-w-7xl">
    
    <div class="flex flex-col sm:flex-row sm:items-center justify-between mb-8 gap-4 pb-6 border-b border-gray-200">
      <div>
        <h2 class="text-2xl font-black text-brand-dark tracking-tight">Products</h2>
        <p class="text-sm text-gray-500 mt-1">Review and manage products in your store catalog.</p>
      </div>
      <div class="flex items-center gap-3 flex-wrap sm:flex-nowrap">
        <span class="bg-gray-100 text-gray-600 border border-gray-200 text-xs font-bold px-3 py-1.5 rounded-lg font-mono">
          Matched: {filteredProducts.length} / {products.length}
        </span>
        
        <div class="flex flex-col items-end">
          <span class="text-[10px] font-black text-gray-400 bg-gray-50 border border-gray-200 px-3 py-1.5 rounded-lg shadow-xs select-none cursor-not-allowed opacity-80" title="Product creation not active">
             Catalog Import Managed
          </span>
        </div>
      </div>
    </div>

    {result.isSample && (
      <div class="bg-blue-50 border border-blue-200 text-blue-800 px-6 py-4 rounded-2xl mb-8 flex items-center gap-4 shadow-xs">
        <div class="text-xs leading-relaxed"><strong>Note:</strong> {result.reason}</div>
      </div>
    )}

    {/* ADVANCED BUSINESS FILTERS CONSOLE */}
    <div class="bg-white border border-gray-200 rounded-2xl shadow-sm p-5 mb-8">
      <h3 class="text-[10px] font-black uppercase tracking-widest text-gray-400 mb-4 flex items-center gap-2">
         Advanced Filters
      </h3>
      <form method="GET" action="/admin/products" class="grid grid-cols-1 md:grid-cols-6 gap-4">
        
        <div class="md:col-span-2">
          <label for="q" class="block text-[9px] font-bold text-gray-400 uppercase mb-1.5">Search Keywords</label>
          <input 
            type="text" 
            name="q" 
            id="q"
            value={q}
            placeholder="Name or SKU..." 
            class="w-full bg-gray-50 border border-gray-200 rounded-xl px-3.5 py-2 text-xs text-brand-dark font-semibold focus:border-brand-gold outline-none" 
          />
        </div>

        <div>
          <label for="cat" class="block text-[9px] font-bold text-gray-400 uppercase mb-1.5">Category</label>
          <select name="cat" id="cat" class="w-full bg-gray-50 border border-gray-200 rounded-xl px-3 py-2 text-xs font-bold text-brand-dark outline-none focus:border-brand-gold">
            <option value="">All</option>
            {categories.map(c => <option value={c} selected={cat === c}>{c}</option>)}
          </select>
        </div>

        <div>
          <label for="stock" class="block text-[9px] font-bold text-gray-400 uppercase mb-1.5">Stock</label>
          <select name="stock" id="stock" class="w-full bg-gray-50 border border-gray-200 rounded-xl px-3 py-2 text-xs font-bold text-brand-dark outline-none focus:border-brand-gold">
            <option value="">All</option>
            {stockStatuses.map(s => <option value={s} selected={stock === s}>{s.replace('_', ' ')}</option>)}
          </select>
        </div>

        <div>
          <label for="visible" class="block text-[9px] font-bold text-gray-400 uppercase mb-1.5">Visibility</label>
          <select name="visible" id="visible" class="w-full bg-gray-50 border border-gray-200 rounded-xl px-3 py-2 text-xs font-bold text-brand-dark outline-none focus:border-brand-gold">
            <option value="">All</option>
            <option value="true" selected={visible === 'true'}>Active</option>
            <option value="false" selected={visible === 'false'}>Hidden</option>
          </select>
        </div>

        <div>
          <label for="appr" class="block text-[9px] font-bold text-gray-400 uppercase mb-1.5">Approval</label>
          <select name="appr" id="appr" class="w-full bg-gray-50 border border-gray-200 rounded-xl px-3 py-2 text-xs font-bold text-brand-dark outline-none focus:border-brand-gold">
            <option value="">All</option>
            {approvalStatuses.map(s => <option value={s} selected={appr === s}>{s}</option>)}
          </select>
        </div>

        <div class="md:col-span-6 flex justify-end items-center gap-3 pt-3 border-t border-gray-100 mt-1">
          {isFiltered && (
            <a href="/admin/products" class="text-xs text-gray-500 hover:text-brand-dark font-bold underline decoration-dotted decoration-2 underline-offset-2">
              Clear Filters
            </a>
          )}
          <button type="submit" class="bg-brand-dark hover:bg-black text-white font-black text-xs py-2 px-6 rounded-xl shadow-sm transition-colors uppercase tracking-wider">
             Apply Filters
          </button>
        </div>
      </form>
    </div>

    {/* PRODUCT DATA TABLE */}
    <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden mb-8">
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-gray-50 text-[10px] uppercase font-black text-gray-400 tracking-widest border-b border-gray-100">
              <th class="p-5 w-16">Image</th>
              <th class="p-5">Product Details</th>
              <th class="p-5">Category & SKU</th>
              <th class="p-5">Stock status</th>
              <th class="p-5 text-right">Retail Price</th>
              <th class="p-5 text-center">State</th>
              <th class="p-5 text-center">Actions</th>
            </tr>
          </thead>
          <tbody class="text-xs divide-y divide-gray-50 font-medium">
            {filteredProducts.map(p => (
              <tr class="hover:bg-gray-50/30 transition-colors">
                <td class="p-5">
                  <div class="w-12 h-12 rounded-xl border border-gray-200 bg-gray-50 overflow-hidden flex items-center justify-center shadow-xs bg-white">
                    {p.imageUrl ? (
                      <img src={p.imageUrl} alt={p.name} class="w-full h-full object-contain" />
                    ) : (
                      <span class="text-gray-300 text-[9px] font-black uppercase">No Img</span>
                    )}
                  </div>
                </td>
                <td class="p-5">
                  <div class="font-bold text-brand-dark text-sm max-w-xs truncate">{p.name}</div>
                  <div class="text-[9px] text-gray-400 mt-1 flex items-center gap-2">
                     <span class="font-mono tracking-tighter bg-gray-100 px-1.5 py-0.5 rounded">ID: {p.id.slice(0, 8)}…</span>
                  </div>
                </td>
                <td class="p-5">
                  <div class="text-brand-dark font-bold">{p.category || 'Uncategorized'}</div>
                  <div class="text-[9px] font-mono font-bold text-gray-400 mt-0.5">SKU: {p.sku}</div>
                </td>
                <td class="p-5">
                   <span class={`inline-block px-2 py-0.5 rounded-full font-black text-[8px] uppercase border tracking-wider ${
                     p.stockStatus === 'in_stock' ? 'bg-green-50 text-green-700 border-green-100' : 'bg-red-50 text-red-700 border-red-100'
                   }`}>
                     {(p.stockStatus || 'out_of_stock').replace('_', ' ')}
                   </span>
                </td>
                <td class="p-5 font-black text-right text-brand-dark text-sm">
                  {p.priceUgx ? formatter.format(p.priceUgx) : '—'}
                </td>
                <td class="p-5 text-center">
                  <div class="flex flex-col items-center gap-1">
                    <span class={`px-2 py-0.5 rounded font-black text-[9px] uppercase border ${p.active ? 'bg-brand-dark text-white border-brand-dark' : 'bg-gray-100 text-gray-400 border-gray-200'}`}>
                      {p.active ? 'Active' : 'Hidden'}
                    </span>
                    <span class="text-[8px] font-bold text-gray-400 tracking-widest uppercase mt-0.5">
                      {p.approvalStatus || 'Draft'}
                    </span>
                  </div>
                </td>
                <td class="p-5 text-center">
                  <div class="flex items-center justify-center gap-2">
                    <a 
                      href={`/admin/products/${p.id}`} 
                      class="text-brand-dark hover:bg-gray-100 border border-gray-200 font-bold text-[10px] px-2.5 py-1.5 rounded-lg transition-colors bg-white shadow-xs"
                    >
                      View Details
                    </a>
                    <a 
                      href={`/products/${p.slug}`} 
                      target="_blank" 
                      class="text-gray-500 hover:text-brand-dark border border-gray-200 font-bold text-[10px] px-2 py-1.5 rounded-lg transition-colors bg-white"
                    >
                      Public &rarr;
                    </a>
                  </div>
                </td>
              </tr>
            ))}
            
            {filteredProducts.length === 0 && (
              <tr>
                <td colspan="7" class="p-20 text-center space-y-3 bg-gray-50/30">
                  <div class="font-black text-brand-dark text-sm">No matching products found</div>
                  <p class="text-xs text-gray-500 max-w-sm mx-auto leading-relaxed">
                    Adjust or clear your filters to locate catalog records. Make sure to double check spelling or SKU combinations.
                  </p>
                  <div class="pt-4">
                    <a href="/admin/products" class="bg-brand-dark text-white text-[10px] font-black uppercase tracking-widest px-5 py-2 rounded-xl shadow-sm inline-block">
                       Clear All Filters
                    </a>
                  </div>
                </td>
              </tr>
            )}
          </tbody>
        </table>
      </div>
    </div>

    {/* Disclaimer Note */}
    <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 text-xs text-gray-500 leading-relaxed mb-12 max-w-3xl">
       <p class="font-bold text-brand-dark mb-1">Product Data Administration Notice:</p>
       <p>
         Product creation and catalog deletion APIs are not available via console dashboard. Operational creation and heavy inventory updates must be executed via bulk-upload configurations or directly through product registry imports by engineering staff.
       </p>
    </div>

  </div>
</AdminLayout>
