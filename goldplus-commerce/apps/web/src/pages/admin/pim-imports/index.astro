---
import AdminLayout from '../../../layouts/AdminLayout.astro'; import { apiBase } from '../../../lib/api'; import { readSessionToken } from '../../../lib/session';
const token = readSessionToken(Astro.request); if (!token) return Astro.redirect('/admin/login?returnTo=/admin/pim-imports', 303); const headers = { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' }; let notice = '';
if (Astro.request.method === 'POST') { const form = await Astro.request.formData(); try { const rows = JSON.parse(String(form.get('rows') ?? '[]')); const response = await fetch(`${apiBase}/admin/pim-imports`, { method: 'POST', headers, body: JSON.stringify({ name: form.get('name'), sourceFilename: form.get('sourceFilename'), sourceSha256: form.get('sourceSha256'), mode: form.get('mode'), rows }) }); const body = await response.json().catch(() => null); notice = body?.success ? 'Immutable import source ingested.' : body?.error?.message ?? 'Import ingestion failed.'; } catch { notice = 'Rows must be a valid JSON array.'; } }
let sessions: any[] = []; let denied = false; let failed = false; try { const response = await fetch(`${apiBase}/admin/pim-imports`, { headers }); denied = response.status === 403; const body = await response.json().catch(() => null); sessions = body?.success ? body.data : []; failed = !body?.success && !denied; } catch { failed = true; }
const tone = (state: string) => ['APPLIED','ROLLED_BACK'].includes(state) ? 'bg-emerald-50 text-emerald-800' : ['FAILED','ROLLBACK_PARTIAL','REJECTED'].includes(state) ? 'bg-red-50 text-red-800' : ['READY_FOR_APPROVAL','APPROVED','PARTIALLY_APPLIED'].includes(state) ? 'bg-amber-50 text-amber-900' : 'bg-slate-100 text-slate-700';
---
<AdminLayout title="PIM Imports" description="Governed catalogue ingestion, preview, approval, apply and rollback."><div class="container mx-auto px-6 max-w-7xl"><h2 class="text-2xl font-black">PIM Import control room</h2><p class="text-sm text-gray-500 mb-6">No overwrite without a persisted preview and independent approval. New products remain hidden drafts.</p>{notice && <div class="border rounded-xl p-3 mb-4">{notice}</div>}{denied && <div class="bg-red-50 text-red-800 p-4 rounded-xl">Permission denied: pim.read required.</div>}{failed && <div class="bg-red-50 text-red-800 p-4 rounded-xl">Unavailable — no sample import data shown.</div>}
{!denied && <div class="grid xl:grid-cols-[1fr_2fr] gap-6"><form method="POST" class="bg-white border rounded-2xl p-5 space-y-3"><h3 class="font-black">Ingest immutable source</h3><input name="name" required placeholder="Import name" class="w-full border rounded-xl p-2"/><input name="sourceFilename" required placeholder="catalogue.json" class="w-full border rounded-xl p-2"/><input name="sourceSha256" required pattern="[a-f0-9]{64}" placeholder="SHA-256" class="w-full border rounded-xl p-2 font-mono"/><select name="mode" class="w-full border rounded-xl p-2"><option>CREATE_ONLY</option><option>UPSERT</option></select><textarea name="rows" required rows="10" placeholder='[{"sku":"SKU-1",...}]' class="w-full border rounded-xl p-2 font-mono text-xs"></textarea><button class="bg-brand-gold font-black rounded-xl px-4 py-2">Ingest only</button><p class="text-xs text-gray-500">Requires pim.create. This does not write catalogue products.</p></form><section><h3 class="font-black mb-3">Import sessions</h3>{sessions.length === 0 && !failed && <div class="bg-white border rounded-2xl p-8 text-center text-gray-500">Empty — no import sessions exist.</div>}<div class="space-y-3">{sessions.map((item) => <a href={`/admin/pim-imports/${item.id}`} class="block bg-white border rounded-2xl p-5"><div class="flex justify-between"><div><strong>{item.name}</strong><div class="text-xs text-gray-500">{item.sourceFilename} · {item.totalRows} rows · v{item.version}</div></div><span class={`rounded-lg px-2 py-1 text-xs font-bold ${tone(item.status)}`}>{item.status}</span></div></a>)}</div></section></div>}
<details class="bg-white border rounded-2xl p-5 mt-8"><summary class="font-black">Truthful states</summary><div class="flex flex-wrap gap-2 mt-3">{['UPLOADED','MAPPED','READY_FOR_APPROVAL','APPROVED','APPLYING','APPLIED','PARTIALLY_APPLIED','FAILED','ROLLED_BACK','ROLLBACK_PARTIAL','REJECTED','Permission denied','Unavailable','Empty','Stale conflict'].map((s)=><span class={`px-2 py-1 rounded text-xs ${tone(s)}`}>{s}</span>)}</div><p class="text-xs text-gray-500 mt-3">Inventory and fabricated attribute import are disabled.</p></details></div></AdminLayout>
