---
import AdminLayout from '../../../layouts/AdminLayout.astro'; import { apiBase } from '../../../lib/api'; import { readSessionToken } from '../../../lib/session';
const token = readSessionToken(Astro.request); const id = Astro.params.id!; if (!token) return Astro.redirect(`/admin/login?returnTo=/admin/pim-imports/${id}`, 303); const headers = { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' }; let notice = '';
if (Astro.request.method === 'POST') { const form = await Astro.request.formData(); const operation = String(form.get('operation')); let payload: any = { expectedVersion: Number(form.get('expectedVersion')) }; if (operation === 'mapping') payload.mapping = Object.fromEntries([...['sku','modelNumber','name','slug','categorySlug','shortDescription','longDescription','retailPriceUgx'].map((field) => [field, String(form.get(field) ?? field)]), ...['floorPriceUgx','tierBPriceUgx','tierCPriceUgx'].map((field) => [field, String(form.get(field) ?? '').trim()]).filter(([, v]) => v)]); if (operation === 'approval') { payload.decision = form.get('decision'); payload.reason = form.get('reason'); } if (operation === 'rollback') payload.reason = form.get('reason'); const response = await fetch(`${apiBase}/admin/pim-imports/${id}/${operation}`, { method: 'POST', headers, body: JSON.stringify(payload) }); const body = await response.json().catch(() => null); notice = response.status === 409 ? `Stale conflict: ${body?.error?.message ?? ''}` : body?.success ? `${operation} completed.` : body?.error?.message ?? 'Operation failed.'; }
let detail: any = null; let denied = false; try { const response = await fetch(`${apiBase}/admin/pim-imports/${id}`, { headers }); denied = response.status === 403; const body = await response.json().catch(() => null); detail = body?.success ? body.data : null; } catch {}
---
<AdminLayout title="PIM Import detail" description="Persisted mapping, row preview, approval, apply and rollback evidence."><div class="container mx-auto px-6 max-w-7xl">{notice && <div class="border rounded-xl p-3 mb-4">{notice}</div>}{denied && <div class="bg-red-50 text-red-800 p-4 rounded-xl">Permission denied: pim.read required.</div>}{!denied && !detail && <div class="bg-red-50 text-red-800 p-4 rounded-xl">Unavailable — persisted import evidence could not be loaded.</div>}{detail && <><a href="/admin/pim-imports" class="text-sm">← PIM Imports</a><section class="bg-white border rounded-2xl p-6 mt-4"><div class="flex justify-between"><div><h2 class="text-2xl font-black">{detail.session.name}</h2><p class="text-xs text-gray-500">{detail.session.sourceSha256} · {detail.session.mode} · v{detail.session.version}</p></div><strong>{detail.session.status}</strong></div><div class="grid grid-cols-3 md:grid-cols-6 gap-2 mt-4 text-xs"><span>{detail.session.totalRows} total</span><span>{detail.session.validRows} valid</span><span>{detail.session.invalidRows} invalid</span><span>{detail.session.createRows} create</span><span>{detail.session.updateRows} update</span><span>{detail.session.appliedRows} applied</span></div><p class="text-xs mt-3">Preview required · independent approval required · new products hidden drafts · inventory import disabled · fabricated attributes forbidden.</p></section>
{['UPLOADED','MAPPED'].includes(detail.session.status) && <form method="POST" class="bg-white border rounded-2xl p-5 mt-5"><input type="hidden" name="operation" value="mapping"/><input type="hidden" name="expectedVersion" value={detail.session.version}/><h3 class="font-black">Explicit source mapping</h3><div class="grid md:grid-cols-4 gap-2 mt-3">{['sku','modelNumber','name','slug','categorySlug','shortDescription','longDescription','retailPriceUgx'].map((field)=><label class="text-xs">{field}<input name={field} value={field} required class="w-full border rounded p-2 mt-1"/></label>)}{['floorPriceUgx','tierBPriceUgx','tierCPriceUgx'].map((field)=><label class="text-xs">{field} <span class="text-slate-400">(optional)</span><input name={field} placeholder="source column, or blank" class="w-full border rounded p-2 mt-1"/></label>)}</div><button class="bg-brand-gold font-black rounded-xl px-4 py-2 mt-4">Save mapping</button></form>}
{detail.session.status === 'MAPPED' && <form method="POST" class="mt-4"><input type="hidden" name="operation" value="preview"/><input type="hidden" name="expectedVersion" value={detail.session.version}/><button class="border rounded-xl px-4 py-2 font-black">Run dry preview</button></form>}
{detail.session.status === 'READY_FOR_APPROVAL' && <form method="POST" class="bg-white border rounded-2xl p-5 mt-5"><input type="hidden" name="operation" value="approval"/><input type="hidden" name="expectedVersion" value={detail.session.version}/><select name="decision" class="border rounded p-2"><option>APPROVED</option><option>REJECTED</option></select><input name="reason" required placeholder="Independent decision reason" class="border rounded p-2 ml-2"/><button class="bg-brand-gold rounded px-4 py-2 ml-2 font-black">Record decision</button></form>}
{detail.session.status === 'APPROVED' && <form method="POST" class="mt-4"><input type="hidden" name="operation" value="apply"/><input type="hidden" name="expectedVersion" value={detail.session.version}/><button class="bg-brand-dark text-white rounded-xl px-4 py-2 font-black">Apply approved preview</button></form>}
{['APPLIED','PARTIALLY_APPLIED'].includes(detail.session.status) && <form method="POST" class="mt-4"><input type="hidden" name="operation" value="rollback"/><input type="hidden" name="expectedVersion" value={detail.session.version}/><input name="reason" required placeholder="Rollback reason" class="border rounded p-2"/><button class="border border-red-300 text-red-800 rounded-xl px-4 py-2 font-black ml-2">Rollback unchanged rows</button></form>}
<section class="bg-white border rounded-2xl p-5 mt-5 overflow-x-auto"><div class="flex items-center justify-between mb-3"><h3 class="font-black">Row preview and outcomes</h3>{detail.session.invalidRows > 0 && <a href={`/api/admin/pim/${detail.session.id}/error-report`} class="rounded-lg border border-gray-300 bg-white px-3 py-1.5 text-[10px] font-black uppercase tracking-widest text-gray-700 hover:bg-gray-50">Download error report (CSV)</a>}</div><table class="w-full text-xs"><thead><tr><th>Row</th><th>SKU</th><th>Action</th><th>Status</th><th>Errors</th></tr></thead><tbody>{detail.rows.map((row)=><tr class="border-t"><td class="p-2">{row.rowNumber}</td><td>{row.normalizedData?.sku ?? '—'}</td><td>{row.action}</td><td>{row.status}</td><td>{row.validationErrors.join(' · ') || row.error || '—'}</td></tr>)}</tbody></table></section><section class="bg-white border rounded-2xl p-5 mt-5"><h3 class="font-black">Immutable event timeline</h3>{detail.events.map((event)=><div class="border-t py-2 text-xs"><strong>{event.action}</strong> · {event.reason}</div>)}</section></>}</div></AdminLayout>
