---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { readSessionToken } from "../../lib/session";
import { apiBase } from "../../lib/api";

/**
 * Customer segments (0155): rule-based groups of customers, recalculated every
 * night (02:00–06:00 Kampala) or on "Recalculate now". A segment only says who
 * matches; advertising and messaging apply each customer's consent when they
 * read it. A count that was never calculated says so — it is never shown as 0.
 */
const token = readSessionToken(Astro.request);
if (!token) return Astro.redirect("/admin/login?returnTo=/admin/segments", 303);

async function call(method: string, path: string, body?: unknown) {
  try {
    const res = await fetch(`${apiBase}/admin/first-party${path}`, { method, headers: { Accept: "application/json", Authorization: `Bearer ${token}`, ...(body !== undefined ? { "Content-Type": "application/json" } : {}) }, body: body !== undefined ? JSON.stringify(body) : undefined });
    const json = await res.json().catch(() => null);
    if (res.status === 403) return { ok: false as const, status: 403, message: "Your account is not permitted to do this." };
    return res.ok && json?.success ? { ok: true as const, status: res.status, data: json.data } : { ok: false as const, status: res.status, message: [json?.error?.message ?? `The API declined the request (HTTP ${res.status}).`, ...(Array.isArray(json?.error?.details) ? json.error.details : [])].join(" ") };
  } catch { return { ok: false as const, status: 0, message: "Could not reach the API." }; }
}

const RULE_KINDS: Array<[string, string]> = [
  ["BOUGHT_IN_CATEGORY", "Bought in a category, at least N days ago"],
  ["ABANDONED_BASKET", "Left a basket in the last N days"],
  ["LIFETIME_SPEND_AT_LEAST", "Paid or delivered spend of at least UGX"],
  ["BULK_BUYER", "Has sent a bulk quote request"],
  ["REPEAT_BUYER", "Placed at least N orders"],
  ["LAPSED", "Has ordered, but not in the last N days"],
  ["RFM_SEGMENT", "RFM segment is (value: one or more, e.g. At Risk, Can't Lose)"],
  ["PAYMENT_HABIT", "Usually pays (value: cash on delivery, online or both)"],
  ["DISTRICT", "Most deliveries go to a district (value: the district)"],
];
const RFM_NAMES = ["Champions", "Loyal", "Potential Loyalist", "New", "Promising", "Needs Attention", "At Risk", "Can't Lose", "Hibernating", "Lost"];
const rfmFrom = (v: string) => v.split(",").map((x) => x.trim().toLowerCase().replace(/[’`]/g, "'")).filter(Boolean)
  .map((x) => RFM_NAMES.find((n) => n.toLowerCase() === x) ?? x);
const habitFrom = (v: string) => {
  const x = v.trim().toLowerCase();
  return x === "cash on delivery" || x === "cod" || x === "cash" ? "CASH_ON_DELIVERY" : x === "online" ? "ONLINE" : x === "both" || x === "mixed" ? "MIXED" : v.trim().toUpperCase();
};

function definitionFrom(f: FormData) {
  const rules: Record<string, unknown>[] = [];
  for (let i = 0; i < 3; i++) {
    const kind = String(f.get(`rule${i}.kind`) ?? "");
    if (!kind) continue;
    const n = String(f.get(`rule${i}.number`) ?? "").trim();
    const categoryId = String(f.get(`rule${i}.categoryId`) ?? "");
    const value = String(f.get(`rule${i}.value`) ?? "").trim();
    if (kind === "BOUGHT_IN_CATEGORY") rules.push({ kind, categoryId, moreThanDaysAgo: n });
    else if (kind === "ABANDONED_BASKET") rules.push({ kind, withinDays: n });
    else if (kind === "LIFETIME_SPEND_AT_LEAST") rules.push({ kind, amountUgx: n });
    else if (kind === "REPEAT_BUYER") rules.push({ kind, minOrders: n || "2" });
    else if (kind === "LAPSED") rules.push({ kind, noOrderForDays: n });
    else if (kind === "RFM_SEGMENT") rules.push({ kind, segments: rfmFrom(value) });
    else if (kind === "PAYMENT_HABIT") rules.push({ kind, habit: habitFrom(value) });
    else if (kind === "DISTRICT") rules.push({ kind, district: value });
    else rules.push({ kind });
  }
  return { match: String(f.get("match") ?? "ALL") === "ANY" ? "ANY" : "ALL", rules };
}

let notice: string | null = null;
let formError: string | null = null;
let preview: { count: number; customersEvaluated: number; sample: string[] } | null = null;
let draft: { name: string; description: string; match: string; rules: Array<{ kind: string; number: string; categoryId: string; value: string }> } = { name: "", description: "", match: "ALL", rules: [] };

if (Astro.request.method === "POST") {
  const f = await Astro.request.formData();
  const intent = String(f.get("intent") ?? "");
  draft = {
    name: String(f.get("name") ?? ""), description: String(f.get("description") ?? ""), match: String(f.get("match") ?? "ALL"),
    rules: [0, 1, 2].map((i) => ({ kind: String(f.get(`rule${i}.kind`) ?? ""), number: String(f.get(`rule${i}.number`) ?? ""), categoryId: String(f.get(`rule${i}.categoryId`) ?? ""), value: String(f.get(`rule${i}.value`) ?? "") })),
  };
  if (intent === "preview") {
    const r = await call("POST", "/segments/preview", { definition: definitionFrom(f) });
    if (r.ok) preview = r.data; else formError = r.message;
  } else if (intent === "create") {
    const r = await call("POST", "/segments", { name: draft.name, description: draft.description || null, definition: definitionFrom(f) });
    if (r.ok) { notice = "Segment saved. Its members are calculated on the next run (tonight, or press Recalculate now)."; draft = { name: "", description: "", match: "ALL", rules: [] }; } else formError = r.message;
  } else if (intent === "archive" || intent === "restore") {
    const r = await call("POST", `/segments/${encodeURIComponent(String(f.get("id") ?? ""))}/archive`, { archived: intent === "archive" });
    if (r.ok) notice = intent === "archive" ? "Segment archived." : "Segment restored."; else formError = r.message;
  } else if (intent === "run") {
    const r = await call("POST", "/segments/run", {});
    if (r.ok) notice = "Recalculated."; else formError = r.message;
  }
}

const showArchived = Astro.url.searchParams.get("archived") === "1";
const list = await call("GET", `/segments${showArchived ? "?archived=1" : ""}`);
const segments: any[] = list.ok ? list.data.segments : [];
const runs: any[] = list.ok ? list.data.runs : [];
const categories: Array<{ id: string; name: string }> = list.ok ? list.data.categories : [];
const when = (iso: unknown) => (typeof iso === "string" && iso ? new Date(iso).toLocaleString("en-GB", { day: "numeric", month: "short", hour: "2-digit", minute: "2-digit", timeZone: "Africa/Kampala" }) : "—");
const ruleRows = [0, 1, 2].map((i) => draft.rules[i] ?? { kind: "", number: "", categoryId: "", value: "" });
---
<AdminLayout title="Customer segments" description="Rule-based customer groups, recalculated nightly; consent is applied by whoever uses them.">
  <div class="container mx-auto px-6 lg:px-8 max-w-5xl">
    <h2 class="text-2xl font-black text-brand-dark tracking-tight mb-2">Customer segments</h2>
    <p class="text-sm text-gray-600 mb-6 max-w-3xl">A segment is a rule, such as "left a basket in the last 7 days". Members are recalculated every night between 02:00 and 06:00 (Kampala), or when you press Recalculate now. A segment decides who matches, not who may be contacted: advertising and WhatsApp offers each check the customer's own consent when they use it.</p>
    {notice && <div role="status" class="mb-6 rounded-xl border border-emerald-300 bg-emerald-50 p-4 text-sm text-emerald-900">{notice}</div>}
    {formError && <div role="alert" class="mb-6 rounded-xl border border-red-300 bg-red-50 p-4 text-sm text-red-900">{formError}</div>}
    {!list.ok && <p role="alert" class="mb-6 rounded-xl border border-red-300 bg-red-50 p-4 text-sm text-red-900">{list.message}</p>}

    {list.ok && (
      <section class="mb-10" aria-labelledby="h-list">
        <div class="flex flex-wrap items-center justify-between gap-3 mb-3">
          <h3 id="h-list" class="text-lg font-black text-brand-dark">Segments</h3>
          <div class="flex items-center gap-3">
            <a href={showArchived ? "/admin/segments" : "/admin/segments?archived=1"} class="text-sm font-bold underline">{showArchived ? "Hide archived" : "Show archived"}</a>
            <form method="POST"><button name="intent" value="run" class="inline-flex min-h-11 items-center rounded-full border border-gray-300 px-5 text-sm font-bold">Recalculate now</button></form>
          </div>
        </div>
        {segments.length === 0 ? (
          <p class="rounded-2xl border border-gray-200 bg-white p-6 text-sm text-gray-600">No segments yet. Create one below.</p>
        ) : (
          <div class="grid gap-3">
            {segments.map((s) => (
              <article class="rounded-2xl border border-gray-200 bg-white p-5">
                <div class="flex flex-wrap items-start justify-between gap-3">
                  <div>
                    <h4 class="font-black text-brand-dark">{s.name}{s.status === "ARCHIVED" && <span class="ml-2 rounded-full bg-gray-100 px-2 py-0.5 text-xs text-gray-600">Archived</span>}</h4>
                    {s.description && <p class="text-sm text-gray-600">{s.description}</p>}
                    <p class="mt-1 text-xs text-gray-500">{s.definition.match === "ANY" ? "Any of" : "All of"}: {s.rulesDescribed.join(" · ")}</p>
                  </div>
                  <div class="text-right">
                    <p class="text-lg font-black text-brand-dark">{s.memberCount === null ? "Not yet calculated" : `${s.memberCount} customer${s.memberCount === 1 ? "" : "s"}`}</p>
                    <p class="text-xs text-gray-500">Last calculated {when(s.lastMaterialisedAt)}</p>
                  </div>
                </div>
                <form method="POST" class="mt-3">
                  <input type="hidden" name="id" value={s.id} />
                  {s.status === "ARCHIVED"
                    ? <button name="intent" value="restore" class="text-sm font-bold underline">Restore</button>
                    : <button name="intent" value="archive" class="text-sm font-bold text-red-800 underline">Archive</button>}
                </form>
              </article>
            ))}
          </div>
        )}
      </section>
    )}

    <section class="mb-10 rounded-2xl border border-gray-200 bg-white p-5" aria-labelledby="h-new">
      <h3 id="h-new" class="text-lg font-black text-brand-dark mb-3">New segment</h3>
      <form method="POST" class="grid gap-4">
        <label class="text-xs font-bold text-gray-700">Name<input name="name" value={draft.name} maxlength="120" class="mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm font-normal" /></label>
        <label class="text-xs font-bold text-gray-700">Description (optional)<input name="description" value={draft.description} maxlength="1000" class="mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm font-normal" /></label>
        <fieldset class="text-xs font-bold text-gray-700">
          <legend>A customer is in the segment when they match</legend>
          <label class="mr-4 font-normal"><input type="radio" name="match" value="ALL" checked={draft.match !== "ANY"} /> all rules</label>
          <label class="font-normal"><input type="radio" name="match" value="ANY" checked={draft.match === "ANY"} /> any rule</label>
        </fieldset>
        {ruleRows.map((r, i) => (
          <fieldset class="grid gap-2 rounded-xl border border-gray-200 p-3 sm:grid-cols-4">
            <legend class="px-1 text-xs font-bold text-gray-700">Rule {i + 1}{i > 0 && " (optional)"}</legend>
            <label class="text-xs font-bold text-gray-700">Rule
              <select name={`rule${i}.kind`} class="mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm font-normal">
                <option value="">{i === 0 ? "Choose a rule" : "No rule"}</option>
                {RULE_KINDS.map(([k, label]) => <option value={k} selected={r.kind === k}>{label}</option>)}
              </select>
            </label>
            <label class="text-xs font-bold text-gray-700">Number (days, UGX or orders)<input name={`rule${i}.number`} value={r.number} inputmode="numeric" class="mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm font-normal" /></label>
            <label class="text-xs font-bold text-gray-700">Category (category rule only)
              <select name={`rule${i}.categoryId`} class="mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm font-normal">
                <option value="">—</option>
                {categories.map((c) => <option value={c.id} selected={r.categoryId === c.id}>{c.name}</option>)}
              </select>
            </label>
            <label class="text-xs font-bold text-gray-700">Value (RFM, payment or district rule)<input name={`rule${i}.value`} value={r.value} maxlength="200" class="mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm font-normal" /></label>
          </fieldset>
        ))}
        {preview && (
          <div role="status" class="rounded-xl border border-blue-200 bg-blue-50 p-4 text-sm text-blue-900">
            {preview.customersEvaluated === 0
              ? "No data: there are no customer profiles to match yet. Profiles appear as customers sign in and order, and after the nightly run links past orders."
              : `${preview.count} of ${preview.customersEvaluated} customers match right now.`}
            {preview.sample.length > 0 && <span class="block mt-1 font-mono text-xs">{preview.sample.join(" · ")}</span>}
          </div>
        )}
        <div class="flex flex-wrap gap-2">
          <button name="intent" value="preview" class="inline-flex min-h-11 items-center rounded-full border border-gray-300 px-5 text-sm font-bold">Preview count</button>
          <button name="intent" value="create" class="inline-flex min-h-11 items-center rounded-full bg-brand-dark px-5 text-sm font-bold text-white">Save segment</button>
        </div>
      </form>
    </section>

    {list.ok && (
      <section aria-labelledby="h-runs" class="mb-12">
        <h3 id="h-runs" class="text-lg font-black text-brand-dark mb-3">Recent runs</h3>
        {runs.length === 0 ? <p class="text-sm text-gray-600">No run yet. The first runs tonight, or press Recalculate now.</p> : (
          <table class="w-full text-left text-sm">
            <thead><tr class="text-xs uppercase text-gray-500"><th class="py-2">Started</th><th>Trigger</th><th>Result</th><th>Customers</th><th>Orders linked</th></tr></thead>
            <tbody>
              {runs.map((r) => (
                <tr class="border-t border-gray-100"><td class="py-2">{when(r.startedAt)}</td><td>{r.trigger}</td><td>{r.status}{r.error && <span class="block text-xs text-red-700">{r.error}</span>}</td><td>{r.customersEvaluated ?? "—"}</td><td>{r.ordersStitched ?? "—"}</td></tr>
              ))}
            </tbody>
          </table>
        )}
      </section>
    )}
  </div>
</AdminLayout>
