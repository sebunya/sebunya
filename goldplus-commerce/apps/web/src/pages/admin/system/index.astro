---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { readSessionToken } from "../../../lib/session";
import InfoTooltip from "../../../components/admin/InfoTooltip.astro";
import { apiBase } from "../../../lib/api";

const token = readSessionToken(Astro.request);
if (!token) {
  return Astro.redirect("/admin/login?returnTo=/admin/system", 303);
}

// Master Definition of all 8 Required Domains
const checks = [
  { id: 'web-app', name: 'Web app', desc: 'Storefront and administrative control console framework.', status: 'Online', details: 'Astro SSR instance active.' },
  { id: 'api-server', name: 'API server', desc: 'Main transactional API gateway for commerce logic.', status: 'Not checked', details: 'Checking node...' },
  { id: 'database', name: 'Database', desc: 'Core PostgreSQL persistence housing users, orders, and settings.', status: 'Not checked', details: 'Awaiting API connection...' },
  { id: 'product-catalog', name: 'Product catalog', desc: 'Active reading of dynamic storefront inventory.', status: 'Not checked', details: 'Verifying products array...' },
  { id: 'cart-lookup', name: 'Cart lookup', desc: 'Temporary session storage lookup engine.', status: 'Configured', details: 'Active session matching enabled.' },
  { id: 'recommendation-rules', name: 'Recommendation rules', desc: 'Evaluator determining boost and pinning priorities.', status: 'Not checked', details: 'Reaching recommendation storage...' },
  { id: 'admin-auth', name: 'Admin authentication', desc: 'Signer verifying Hs256 console session payloads.', status: 'Configured', details: 'Current session validated.' },
  { id: 'build-mode', name: 'Build mode', desc: 'Current execution bundle optimization context.', status: 'Configured', details: import.meta.env.PROD ? 'Production Optimized' : 'Development Environment' }
];

// 1. Real API Server Connection Probe
let responseTime = 0;
try {
  const start = Date.now();
  const res = await fetch(`${apiBase}/governance/admin/stats`, {
    headers: { 'Authorization': `Bearer ${token}` }
  });
  responseTime = Date.now() - start;
  const data = await res.json().catch(() => null);

  const api = checks.find(c => c.id === 'api-server')!;
  const db = checks.find(c => c.id === 'database')!;

  if (res.ok && data?.success) {
    api.status = 'Online';
    api.details = `Connected successfully. Latency: ${responseTime}ms.`;
    
    db.status = 'Online';
    db.details = 'PostgreSQL connection verified via stats aggregation query.';
  } else {
    api.status = 'Offline';
    api.details = `The API returned HTTP status ${res.status}.`;
    db.status = 'Needs setup';
    db.details = 'Could not verify database status since API server returned error.';
  }
} catch (err) {
  const api = checks.find(c => c.id === 'api-server')!;
  const db = checks.find(c => c.id === 'database')!;
  api.status = 'Offline';
  api.details = `Network connection failed. Is backend running? ${err.message || ''}`;
  db.status = 'Offline';
  db.details = 'Database unreachable via API server.';
}

// 2. Real Catalog Reading Probe
try {
  const res = await fetch(`${apiBase}/governance/admin/products`, {
    headers: { 'Authorization': `Bearer ${token}` }
  });
  const cat = checks.find(c => c.id === 'product-catalog')!;
  if (res.ok) {
    const data = await res.json().catch(() => null);
    const count = data?.data?.items?.length || 0;
    cat.status = 'Online';
    cat.details = `Successfully retrieved catalog. Loaded ${count} items.`;
  } else {
    cat.status = 'Offline';
    cat.details = `Failed fetching catalog items. Status ${res.status}.`;
  }
} catch {
  const cat = checks.find(c => c.id === 'product-catalog')!;
  cat.status = 'Offline';
  cat.details = 'Failed to establish network pipeline to Catalog service.';
}

// 3. Real Recommendation Rules Repository Probe
try {
  const res = await fetch(`${apiBase}/admin/recommendations/rules`, {
    headers: { 'Authorization': `Bearer ${token}` }
  });
  const recs = checks.find(c => c.id === 'recommendation-rules')!;
  if (res.ok) {
    const data = await res.json().catch(() => null);
    const count = data?.data?.rules?.length || 0;
    recs.status = 'Online';
    recs.details = `Repository connected. Registered ${count} active rules.`;
  } else {
    recs.status = 'Offline';
    recs.details = `Failed communicating with rules endpoint. Status ${res.status}.`;
  }
} catch {
  const recs = checks.find(c => c.id === 'recommendation-rules')!;
  recs.status = 'Offline';
  recs.details = 'Rule engine repository could not be queried.';
}

// Determine status overview
const criticalChecks = checks.filter(c => ['api-server', 'database', 'product-catalog'].includes(c.id));
const hasOfflineCritical = criticalChecks.some(c => c.status === 'Offline');
const overallHealth = hasOfflineCritical ? 'Offline' : 'System Online';

const lastChecked = new Date().toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
---

<AdminLayout 
  title="System status" 
  description="Truthfully audit runtime health across core ecommerce subsystems."
>
  <div class="container mx-auto px-6 lg:px-8 max-w-7xl">
    
    <div class="mb-8 pb-6 border-b border-gray-200 flex flex-col sm:flex-row justify-between sm:items-center gap-4">
      <div>
        <h2 class="text-2xl font-black text-brand-dark tracking-tight">System status</h2>
        <p class="text-sm text-gray-500 mt-1">
          Truthfully audit runtime health across core ecommerce subsystems.
        </p>
      </div>
      <div class="flex items-center gap-3">
        <span class="text-[10px] font-bold text-gray-400 bg-gray-50 border border-gray-200 px-3 py-1.5 rounded-lg flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-gray-400 animate-pulse"></span>
          Last Probe: {lastChecked}
        </span>
        <button onclick="window.location.reload();" class="bg-white border border-gray-200 hover:border-brand-dark text-brand-dark hover:bg-gray-50 text-xs font-bold px-4 py-2 rounded-xl transition-all shadow-xs cursor-pointer font-black uppercase tracking-wider">
          Refresh
        </button>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
      
      <div class="bg-white border border-gray-200 rounded-2xl p-6 shadow-sm">
        <p class="text-[9px] font-black text-gray-400 uppercase tracking-widest">Diagnostic Summary</p>
        <div class="flex items-center justify-between mt-2">
          <h4 class={`text-xl font-black uppercase tracking-tight ${overallHealth === 'System Online' ? 'text-brand-green' : 'text-red-600'}`}>
            {overallHealth}
          </h4>
          <div class={`w-3 h-3 rounded-full ${overallHealth === 'System Online' ? 'bg-brand-green' : 'bg-red-600'}`}></div>
        </div>
        <p class="text-[10px] font-mono text-gray-400 mt-2 truncate">{apiBase}</p>
      </div>

      <div class="bg-white border border-gray-200 rounded-2xl p-6 shadow-sm">
        <p class="text-[9px] font-black text-gray-400 uppercase tracking-widest">API Roundtrip Latency</p>
        <h4 class="text-xl font-black text-brand-dark mt-2">
          {responseTime > 0 ? `${responseTime} ms` : 'Unavailable'}
        </h4>
        <p class="text-[10px] text-gray-400 mt-2">Current backend server processing response speed.</p>
      </div>

      <div class="bg-white border border-gray-200 rounded-2xl p-6 shadow-sm">
        <p class="text-[9px] font-black text-gray-400 uppercase tracking-widest">Deployment Mode</p>
        <h4 class="text-xl font-black text-brand-dark mt-2 uppercase tracking-tight">
          {import.meta.env.PROD ? 'Production' : 'Development'}
        </h4>
        <p class="text-[10px] text-gray-400 mt-2">Active Astro SSR compilation execution environment.</p>
      </div>

    </div>

    {hasOfflineCritical && (
      <div class="bg-red-50 border border-red-200 text-red-800 px-6 py-4 rounded-2xl mb-8 flex flex-col gap-1 shadow-xs max-w-4xl">
         <div class="flex items-center gap-2 font-black text-xs uppercase">
           <span class="w-2 h-2 bg-red-600 rounded-full inline-block"></span>
           Offline Services Detected
         </div>
         <p class="text-xs text-red-700 leading-relaxed font-medium mt-1">
           One or more critical subsystems failed the direct HTTP connectivity audit. Please verify backend service process mappings immediately.
         </p>
      </div>
    )}

    {/* Complete 8-Check Operations List */}
    <div class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden max-w-4xl mb-12">
      <div class="p-5 bg-gray-50 border-b border-gray-100">
        <h3 class="text-[10px] font-black uppercase tracking-widest text-brand-dark flex items-center gap-2">
           Service checks
           <InfoTooltip text="Live verification sequences proving backend module accessibility." align="left" />
        </h3>
      </div>
      
      <div class="divide-y divide-gray-100">
        {checks.map(c => {
          const isLive = c.status === 'Online';
          const isConfig = c.status === 'Configured';
          const isError = c.status === 'Offline';
          
          let badgeClass = 'bg-gray-100 border-gray-200 text-gray-500';
          if (isLive) badgeClass = 'bg-green-50 border-green-100 text-green-700';
          if (isConfig) badgeClass = 'bg-blue-50 border-blue-100 text-blue-600';
          if (isError) badgeClass = 'bg-red-50 border-red-100 text-red-600';

          return (
            <div class="p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4 hover:bg-gray-50/20 transition-colors">
               <div>
                 <div class="flex items-center gap-2.5">
                    <span class="font-black text-brand-dark text-sm">{c.name}</span>
                 </div>
                 <p class="text-xs text-gray-500 font-medium mt-0.5 leading-relaxed">{c.desc}</p>
                 <div class="flex items-center gap-2 mt-2 text-[10px] font-medium text-gray-400 italic">
                    <span class="w-1 h-1 bg-gray-300 rounded-full"></span>
                    <span>{c.details}</span>
                 </div>
               </div>
               <span class={`text-[9px] font-black border px-3 py-1 rounded-lg uppercase tracking-wider whitespace-nowrap text-center ${badgeClass}`}>
                 {c.status}
               </span>
            </div>
          );
        })}
      </div>
    </div>

  </div>
</AdminLayout>
