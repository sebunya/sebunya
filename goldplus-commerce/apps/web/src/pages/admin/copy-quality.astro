---
import AdminLayout from '../../layouts/AdminLayout.astro'; import { apiBase } from '../../lib/api'; import { readSessionToken } from '../../lib/session';
const token = readSessionToken(Astro.request); if (!token) return Astro.redirect('/admin/login?returnTo=/admin/copy-quality', 303); const approvalStatus = Astro.url.searchParams.get('approvalStatus') ?? ''; const active = Astro.url.searchParams.get('active') ?? ''; const params = new URLSearchParams(); if (approvalStatus) params.set('approvalStatus', approvalStatus); if (active) params.set('active', active); let report: any = null; let denied = false; let failed = false; try { const response = await fetch(`${apiBase}/admin/copy-quality?${params}`, { headers: { Authorization: `Bearer ${token}` } }); denied = response.status === 403; const body = await response.json().catch(() => null); report = body?.success ? body.data : null; failed = !report && !denied; } catch { failed = true; }
---
<AdminLayout title="Copy Quality" description="Deterministic explainable checks over canonical catalogue copy."><div class="container mx-auto px-6 max-w-7xl"><h2 class="text-2xl font-black">Copy Quality control room</h2><p class="text-sm text-gray-500 mb-6">Read-only checks; no automatic rewrite, product approval change or model-provider call.</p><div class="flex gap-2 text-xs mb-4">Truthful states: PASS · REVIEW · BLOCKED · NOT_CONFIGURED</div><form class="flex gap-3 mb-5"><select name="approvalStatus" class="border rounded p-2"><option value="">All approval states</option>{['draft','approved','rejected'].map((state) => <option value={state} selected={approvalStatus === state}>{state}</option>)}</select><select name="active" class="border rounded p-2"><option value="">All activity states</option><option value="true" selected={active === 'true'}>Active</option><option value="false" selected={active === 'false'}>Inactive</option></select><button class="bg-brand-gold font-black rounded px-4">Filter</button></form>{denied && <div class="bg-red-50 text-red-800 p-4 rounded-xl">Permission denied: copy_quality.read required.</div>}{failed && <div class="bg-red-50 text-red-800 p-4 rounded-xl">Unavailable — canonical catalogue copy could not be inspected.</div>}{report && <><div class="grid grid-cols-2 md:grid-cols-5 gap-3 mb-5">{Object.entries(report.summary).map(([key,value]) => <div class="bg-white border rounded-xl p-4"><div class="text-xs uppercase">{key}</div><strong class="text-xl">{value}</strong></div>)}</div><p class="text-xs mb-4">Policy {report.policyVersion} · model checks {report.modelChecks.status} · provider calls {report.modelChecks.providerCalls}</p>{report.rows.length === 0 && <div class="bg-white border rounded-2xl p-8 text-center text-gray-500">Empty — no products match these filters.</div>}<div class="space-y-3">{report.rows.map((row) => <section class="bg-white border rounded-2xl p-5"><div class="flex justify-between"><div><strong>{row.product.name}</strong><p class="text-xs text-gray-500">{row.product.sku} · {row.product.approvalStatus} · {row.product.active ? 'active' : 'inactive'}</p></div><span class="font-black text-xs">{row.status}</span></div>{row.issues.length === 0 ? <p class="text-sm text-emerald-700 mt-3">PASS — no deterministic issue.</p> : <ul class="mt-3 space-y-2">{row.issues.map((issue) => <li class="text-xs border-t pt-2"><strong>{issue.severity} · {issue.code}</strong> · {issue.field}<pre class="overflow-auto">{JSON.stringify(issue.evidence)}</pre></li>)}</ul>}</section>)}</div><details class="mt-5"><summary class="text-xs underline">PII-free deterministic export (requires copy_quality.export)</summary><pre class="text-xs overflow-auto mt-2">Use the protected /admin/copy-quality/export API with the same filters.</pre></details></>}</div></AdminLayout>
