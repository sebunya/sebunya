---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { apiBase } from '../../../lib/api';
import { readSessionToken } from '../../../lib/session';
const token = readSessionToken(Astro.request); const id = Astro.params.id!;
if (!token) return Astro.redirect(`/admin/login?returnTo=/admin/experiments/${id}`, 303);
const headers = { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' }; let notice = '';
if (Astro.request.method === 'POST') { const form = await Astro.request.formData(); const operation = String(form.get('operation'));
  const url = operation === 'expose' ? `${apiBase}/admin/experiments/${id}/exposures` : `${apiBase}/admin/experiments/${id}/transition`;
  const payload = operation === 'expose' ? { subjectKey: form.get('subjectKey'), exposureKey: form.get('exposureKey') } : { expectedVersion: Number(form.get('expectedVersion')), to: operation, reason: form.get('reason') };
  const response = await fetch(url, { method: 'POST', headers, body: JSON.stringify(payload) }); const body = await response.json().catch(() => null); notice = body?.success ? `${operation} recorded.` : body?.error?.message ?? 'Operation failed.';
}
const response = await fetch(`${apiBase}/admin/experiments/${id}`, { headers }); const body = await response.json().catch(() => null); const detail = body?.success ? body.data : null;
---
<AdminLayout title="Experiment detail" description="Immutable variants, deterministic assignment and exposure evidence."><div class="container mx-auto px-6 max-w-5xl">{notice && <div class="border rounded-xl p-3 mb-4">{notice}</div>}{!detail ? <div class="bg-red-50 text-red-800 p-4 rounded-xl">Experiment unavailable or permission denied.</div> : <>
  <a href="/admin/experiments" class="text-sm">← Experiments</a><div class="bg-white border rounded-2xl p-6 mt-4"><div class="flex justify-between"><h2 class="text-2xl font-black">{detail.experiment.name}</h2><strong>{detail.experiment.status}</strong></div><p class="mt-3">{detail.experiment.hypothesis}</p><p class="text-sm text-gray-500">Primary metric: {detail.experiment.primaryMetric}. Significance: {detail.significance.status} — {detail.significance.reason}</p><div class="flex gap-2 mt-4">{detail.experiment.variants.map((v) => <span class="bg-slate-100 rounded-lg px-2 py-1 text-xs">{v.name} {v.weightBasisPoints / 100}%</span>)}</div></div>
  <div class="grid md:grid-cols-2 gap-5 mt-5"><form method="POST" class="bg-white border rounded-2xl p-5"><h3 class="font-black mb-3">Governed transition</h3><input type="hidden" name="expectedVersion" value={detail.experiment.version}/><select name="operation" class="w-full border rounded-xl p-2 mb-2">{['READY','RUNNING','PAUSED','COMPLETED','INCONCLUSIVE','INVALID'].map((s) => <option>{s}</option>)}</select><input name="reason" required minlength="3" placeholder="Reason" class="w-full border rounded-xl p-2 mb-2"/><button class="bg-brand-gold font-black rounded-xl px-4 py-2">Apply</button></form>
  <form method="POST" class="bg-white border rounded-2xl p-5"><h3 class="font-black mb-3">Assign + record exposure</h3><input type="hidden" name="operation" value="expose"/><input name="subjectKey" required placeholder="Controlled subject key" class="w-full border rounded-xl p-2 mb-2"/><input name="exposureKey" required placeholder="Unique exposure evidence key" class="w-full border rounded-xl p-2 mb-2"/><button class="bg-brand-gold font-black rounded-xl px-4 py-2">Record atomically</button><p class="text-xs text-gray-500 mt-2">Requires experiments.assign. The subject is SHA-256 hashed before persistence.</p></form></div>
  <div class="bg-white border rounded-2xl p-5 mt-5"><strong>Evidence</strong><p>{detail.evidence.assignments} assignments · {detail.evidence.exposures} exposures</p></div>
  </>}</div></AdminLayout>
