---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { readSessionToken } from "../../../lib/session";
import { getRecommendationAnalytics } from "../../../lib/admin-analytics";
import {
  listRecommendationRules,
  getCommercialReport,
  getModelReadiness,
  getServingHealth,
  getLineageReport,
  getSearchIntelligence,
  type CommercialMetric,
  type CommercialReportPayload,
  type ModelReadinessPayload,
  type ServingHealthPayload,
  type LineageReportPayload,
  type SearchIntelligencePayload,
} from "../../../lib/admin-recommendations";
import InfoTooltip from "../../../components/admin/InfoTooltip.astro";
import StatusBadge from "../../../components/StatusBadge.astro";

const token = readSessionToken(Astro.request);
if (!token) {
  return Astro.redirect("/admin/login?returnTo=/admin/recommendations/analytics", 303);
}

// Extract query params for filtering
const url = new URL(Astro.request.url);
const startDate = url.searchParams.get("startDate") || "";
const endDate = url.searchParams.get("endDate") || "";
const placement = url.searchParams.get("placement") || "";
const ruleId = url.searchParams.get("ruleId") || "";
const productId = url.searchParams.get("productId") || "";

// Fetch analytics data
const [servingRes, lineageRes, searchIntelRes, readinessRes, commercialRes] = await Promise.all([
  getServingHealth(token, 7),
  getLineageReport(token, 30),
  getSearchIntelligence(token, 10),
  getModelReadiness(token),
  getCommercialReport(token, 30),
]);
const commercial: CommercialReportPayload | null = commercialRes.ok ? commercialRes.data : null;

const ugxOrState = (m: CommercialMetric | undefined): string => {
  if (!m) return "—";
  if (m.state === "OK" || m.state === "PARTIAL") return `UGX ${Math.round(m.value ?? 0).toLocaleString("en-UG")}`;
  if (m.state === "NOT_ENOUGH_DATA") return "Not enough data yet";
  return "Unavailable";
};
const pctOrState = (m: CommercialMetric | undefined): string => {
  if (!m) return "—";
  if (m.state === "OK") return `${m.value}%`;
  if (m.state === "NOT_ENOUGH_DATA") return "Not enough data yet";
  return "Unavailable";
};
const readiness: ModelReadinessPayload | null = readinessRes.ok ? readinessRes.data : null;
const serving: ServingHealthPayload | null = servingRes.ok ? servingRes.data : null;
const lineage: LineageReportPayload | null = lineageRes.ok ? lineageRes.data : null;
const searchIntel: SearchIntelligencePayload | null = searchIntelRes.ok ? searchIntelRes.data : null;

const res = await getRecommendationAnalytics(token, {
  startDate,
  endDate,
  placement: placement as any,
  ruleId,
  productId,
});

const isApiLive = res.ok;
const data = res.ok ? res.data : null;

// Helper to format numbers
const fmtNum = (n: number) => new Intl.NumberFormat('en-US').format(n);

// Helper to format percentages
const fmtPct = (n: number | null) => {
  if (n === null) return "Not available";
  return new Intl.NumberFormat('en-US', { style: 'percent', minimumFractionDigits: 1, maximumFractionDigits: 1 }).format(n);
};

// Helper for relative time if needed, otherwise just ISO/Date string
const fmtDate = (d: string | null) => {
  if (!d) return "Never";
  return new Date(d).toLocaleString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
};

// Fetch rules for the filter dropdown
const rulesRes = await listRecommendationRules(token, { pageSize: 100 });
const allRules = rulesRes.ok ? rulesRes.data.rules : [];

const placements = [
  { id: 'product_related', name: 'Related Products' },
  { id: 'cart_addon', name: 'Cart Addons' },
  { id: 'home_trending', name: 'Trending Now' },
  { id: 'complete_setup', name: 'Complete Setup' },
  { id: 'category_popular', name: 'Category Popular' },
  { id: 'recently_viewed', name: 'Recently Viewed' },
];
---

<AdminLayout 
  title="Recommendation analytics" 
  description="Track recommendation performance, attribution quality and customer intelligence signals."
>
  <div class="container mx-auto px-6 lg:px-8 max-w-7xl">
    
    <div class="mb-8 border-b border-gray-200 pb-6">
      <h2 class="text-2xl font-black text-brand-dark tracking-tight">Recommendation analytics</h2>
      <p class="text-sm text-gray-500 mt-1 max-w-2xl">
        Review performance metrics, health signals and attribution distribution across all recommendation surfaces.
      </p>
    </div>

    {/* Filter Bar */}
    <div class="bg-white border border-gray-200 rounded-2xl p-6 shadow-sm mb-10">
      <form id="analytics-filter-form" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4 items-end">
        <div>
          <label class="block text-[10px] font-black uppercase tracking-widest text-gray-400 mb-2">Start Date</label>
          <input type="date" name="startDate" value={startDate} class="w-full bg-gray-50 border border-gray-200 rounded-lg px-3 py-2 text-xs font-bold outline-none focus:border-brand-primary" />
        </div>
        <div>
          <label class="block text-[10px] font-black uppercase tracking-widest text-gray-400 mb-2">End Date</label>
          <input type="date" name="endDate" value={endDate} class="w-full bg-gray-50 border border-gray-200 rounded-lg px-3 py-2 text-xs font-bold outline-none focus:border-brand-primary" />
        </div>
        <div>
          <label class="block text-[10px] font-black uppercase tracking-widest text-gray-400 mb-2">Placement</label>
          <select name="placement" class="w-full bg-gray-50 border border-gray-200 rounded-lg px-3 py-2 text-xs font-bold outline-none focus:border-brand-primary appearance-none">
            <option value="">All Placements</option>
            {placements.map(p => (
              <option value={p.id} selected={placement === p.id}>{p.name}</option>
            ))}
          </select>
        </div>
        <div>
          <label class="block text-[10px] font-black uppercase tracking-widest text-gray-400 mb-2">Rule</label>
          <select name="ruleId" class="w-full bg-gray-50 border border-gray-200 rounded-lg px-3 py-2 text-xs font-bold outline-none focus:border-brand-primary appearance-none">
            <option value="">All Rules</option>
            {allRules.map((r: any) => (
              <option value={r.id} selected={ruleId === r.id}>{r.name}</option>
            ))}
          </select>
        </div>
        <div class="flex gap-2">
          <button type="submit" class="flex-1 bg-brand-dark text-white hover:bg-black px-4 py-2 rounded-lg font-bold text-xs transition-colors">Apply Filters</button>
          <a href="/admin/recommendations/analytics" class="px-4 py-2 border border-gray-200 text-gray-500 hover:text-brand-dark rounded-lg font-bold text-xs transition-colors">Reset</a>
        </div>
      </form>
    </div>

    {!isApiLive ? (
      <div class="bg-red-50 border border-red-200 rounded-2xl p-12 text-center text-red-700">
        <h3 class="text-lg font-black text-red-700">
          {((res as any).code === "END_BEFORE_START" || (res as any).code === "INVALID_DATE_RANGE" || (res as any).message?.toLowerCase().includes("date")) ? "Invalid Filter Settings" : "Analytics Service Offline"}
        </h3>
        <p class="text-sm text-red-600 mt-2 max-w-md mx-auto">
          {((res as any).code === "END_BEFORE_START" || (res as any).code === "INVALID_DATE_RANGE" || (res as any).message?.toLowerCase().includes("date"))
            ? ((res as any).code === "END_BEFORE_START" 
                ? "There was an issue with your filters: end date cannot be earlier than start date."
                : `There was an issue with your filters: ${(res as any).message?.toLowerCase() || "invalid date format."}`)
            : "We are unable to reach the commerce intelligence system. This usually means the API is temporarily down or there is a connectivity issue."}
        </p>
        <div class="mt-6">
          {((res as any).code === "END_BEFORE_START" || (res as any).code === "INVALID_DATE_RANGE" || (res as any).message?.toLowerCase().includes("date")) ? (
            <a href="/admin/recommendations/analytics" class="inline-block bg-red-700 text-white px-6 py-2 rounded-xl font-bold text-xs hover:bg-red-800 transition-colors">Reset Date Filter</a>
          ) : (
            <button onclick="window.location.reload()" class="bg-red-700 text-white px-6 py-2 rounded-xl font-bold text-xs hover:bg-red-800 transition-colors">Retry Connection</button>
          )}
        </div>
      </div>
    ) : data?.eventHealth.trackingStatus === 'no_data' ? (
      <div class="bg-gray-50 border border-gray-200 border-dashed rounded-2xl p-20 text-center">
        <div class="w-16 h-16 bg-gray-200 rounded-full mx-auto flex items-center justify-center mb-6">
           <div class="w-2 h-2 rounded-full bg-gray-400"></div>
        </div>
        <h3 class="text-xl font-black text-brand-dark">No recommendation events found</h3>
        <p class="text-sm text-gray-500 mt-2 max-w-sm mx-auto">No recommendation events found for this date range. If you just launched a campaign, it may take a few minutes for signals to appear.</p>
        <div class="mt-8 flex justify-center gap-4">
           <a href="/admin/recommendations/preview" class="text-xs font-bold text-brand-dark border border-gray-300 px-4 py-2 rounded-lg hover:bg-white transition-colors">Test Storefront Tracking</a>
        </div>
      </div>
    ) : (
      <>
        {/* Summary Grid */}
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
          <div class="bg-white border border-gray-200 rounded-2xl p-6 shadow-sm">
            <p class="text-[10px] font-black text-gray-400 uppercase tracking-widest mb-1">Impressions</p>
            <h4 class="text-2xl font-black text-brand-dark">{fmtNum(data!.summary.impressions)}</h4>
          </div>
          <div class="bg-white border border-gray-200 rounded-2xl p-6 shadow-sm">
            <p class="text-[10px] font-black text-gray-400 uppercase tracking-widest mb-1">Clicks</p>
            <h4 class="text-2xl font-black text-brand-dark">{fmtNum(data!.summary.clicks)}</h4>
          </div>
          <div class="bg-white border border-gray-200 rounded-2xl p-6 shadow-sm">
            <p class="text-[10px] font-black text-gray-400 uppercase tracking-widest mb-1">CTR</p>
            <h4 class={`text-2xl font-black ${data!.summary.ctr && data!.summary.ctr > 0.05 ? 'text-brand-green' : 'text-brand-dark'}`}>
              {fmtPct(data!.summary.ctr)}
            </h4>
          </div>
          <div class="bg-white border border-gray-200 rounded-2xl p-6 shadow-sm">
            <p class="text-[10px] font-black text-gray-400 uppercase tracking-widest mb-1">Items added to cart</p>
            <h4 class="text-2xl font-black text-brand-dark">{fmtNum(data!.summary.addToCart)}</h4>
          </div>
          <div class="bg-white border border-gray-200 rounded-2xl p-6 shadow-sm">
            <p class="text-[10px] font-black text-gray-400 uppercase tracking-widest mb-1">Add-to-cart Rate</p>
            <h4 class="text-2xl font-black text-brand-dark">{fmtPct(data!.summary.addToCartRate)}</h4>
          </div>
          <div class="bg-white border border-gray-200 rounded-2xl p-6 shadow-sm">
            <p class="text-[10px] font-black text-gray-400 uppercase tracking-widest mb-1">Recommendation Share</p>
            <h4 class="text-2xl font-black text-brand-dark">
              {data!.summary.totalEvents > 0 ? fmtPct(data!.summary.attributedEvents / data!.summary.totalEvents) : '—'}
            </h4>
          </div>
          <div class="bg-white border border-gray-200 rounded-2xl p-6 shadow-sm">
            <p class="text-[10px] font-black text-gray-400 uppercase tracking-widest mb-1">Organic / No Rule</p>
            <h4 class="text-2xl font-black text-gray-500">{fmtNum(data!.summary.organicEvents)}</h4>
          </div>
          <div class="bg-white border border-gray-200 rounded-2xl p-6 shadow-sm">
            <p class="text-[10px] font-black text-gray-400 uppercase tracking-widest mb-1">Rule Influenced</p>
            <h4 class="text-2xl font-black text-blue-600">{fmtNum(data!.summary.ruleAssistedEvents)}</h4>
          </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-10">
          {/* Health Panel */}
          <div class="lg:col-span-1 space-y-6">
            <div class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden">
              <div class="px-6 py-4 border-b border-gray-100 bg-gray-50">
                <h3 class="text-xs font-black uppercase tracking-widest text-brand-dark">Event Health</h3>
              </div>
              <div class="p-6 space-y-4">
                <div class="flex items-center justify-between">
                  <span class="text-xs text-gray-500 font-bold">System Health</span>
                  <div class="flex items-center gap-2">
                    {data!.eventHealth.trackingStatus === 'healthy' && <span class="text-[10px] font-black bg-brand-green/10 text-brand-green px-2 py-0.5 rounded uppercase">Healthy</span>}
                    {data!.eventHealth.trackingStatus === 'quiet' && <span class="text-[10px] font-black bg-amber-50 text-amber-600 px-2 py-0.5 rounded uppercase">Quiet / No Recent Signals</span>}
                  </div>
                </div>
                {data!.eventHealth.trackingStatus === 'quiet' && (
                  <p class="text-[10px] text-amber-600 leading-relaxed font-medium">Tracking is quiet. No recent recommendation events were received in the selected period.</p>
                )}
                <div class="flex items-center justify-between">
                  <span class="text-xs text-gray-500 font-bold">Latest Signal</span>
                  <span class="text-xs font-mono font-bold text-brand-dark">{fmtDate(data!.eventHealth.latestEventAt)}</span>
                </div>
                <div class="pt-4 border-t border-gray-100 grid grid-cols-2 gap-4 text-center">
                  <div>
                    <p class="text-[9px] font-black text-gray-400 uppercase tracking-wider">Missing Attr.</p>
                    <p class="text-sm font-black text-brand-dark mt-0.5">{fmtNum(data!.eventHealth.missingAttributionId)}</p>
                  </div>
                  <div>
                    <p class="text-[9px] font-black text-gray-400 uppercase tracking-wider">Missing Product</p>
                    <p class="text-sm font-black text-brand-dark mt-0.5">{fmtNum(data!.eventHealth.missingProductId)}</p>
                  </div>
                </div>
                {data!.eventHealth.dataQualityWarnings.length > 0 && (
                  <div class="mt-4 p-3 bg-red-50 rounded-xl border border-red-100">
                    <h5 class="text-[9px] font-black text-red-800 uppercase tracking-widest mb-2">Quality Warnings</h5>
                    <ul class="space-y-1.5">
                      {data!.eventHealth.dataQualityWarnings.map(w => (
                        <li class="text-[10px] text-red-600 font-bold flex items-start gap-2">
                          <span class="mt-1 w-1 h-1 rounded-full bg-red-400 flex-shrink-0"></span>
                          {w}
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </div>
            </div>

            <div class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden">
              <div class="px-6 py-4 border-b border-gray-100 bg-gray-50">
                <h3 class="text-xs font-black uppercase tracking-widest text-brand-dark">Identity Health</h3>
              </div>
              <div class="p-6 space-y-4">
                <p class="text-[10px] text-gray-500 leading-relaxed">
                  Identity links stitch anonymous browsing to server profiles and signed-in customers
                  (written since 2026-08-06 — earlier periods are honestly zero). The old "matched
                  visitors" percentage related two unrelated populations and was retired.
                </p>
                <div class="grid grid-cols-2 gap-y-3 pt-2">
                  <div>
                    <p class="text-[9px] font-black text-gray-400 uppercase tracking-wider">Lead Links</p>
                    <p class="text-sm font-black text-brand-dark">{fmtNum(data!.identityHealth.anonymousToLeadLinks)}</p>
                  </div>
                  <div>
                    <p class="text-[9px] font-black text-gray-400 uppercase tracking-wider">Cust. Links</p>
                    <p class="text-sm font-black text-brand-dark">{fmtNum(data!.identityHealth.anonymousToCustomerLinks)}</p>
                  </div>
                  <div>
                    <p class="text-[9px] font-black text-gray-400 uppercase tracking-wider">Total Links</p>
                    <p class="text-sm font-black text-brand-dark">{fmtNum(data!.identityHealth.identityLinks)}</p>
                  </div>
                </div>
              </div>
            </div>
          </div>

          {/* Placement Table */}
          <div class="lg:col-span-2">
            <div class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden h-full">
              <div class="px-6 py-4 border-b border-gray-100 bg-gray-50">
                <h3 class="text-xs font-black uppercase tracking-widest text-brand-dark">Placement Performance</h3>
              </div>
              <div class="overflow-x-auto">
                <table class="w-full text-left">
                  <thead class="bg-gray-50/50 border-b border-gray-100">
                    <tr>
                      <th class="px-6 py-3 text-[9px] font-black text-gray-400 uppercase tracking-widest">Placement</th>
                      <th class="px-6 py-3 text-[9px] font-black text-gray-400 uppercase tracking-widest text-right">Impressions</th>
                      <th class="px-6 py-3 text-[9px] font-black text-gray-400 uppercase tracking-widest text-right">Clicks</th>
                      <th class="px-6 py-3 text-[9px] font-black text-gray-400 uppercase tracking-widest text-right">CTR</th>
                      <th class="px-6 py-3 text-[9px] font-black text-gray-400 uppercase tracking-widest text-right">ATC</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-gray-100">
                    {data!.placementPerformance.length === 0 ? (
                      <tr>
                        <td colspan="5" class="px-6 py-8 text-center text-xs font-medium text-gray-400">
                          No placement performance data found for this period.
                        </td>
                      </tr>
                    ) : (
                      data!.placementPerformance.map(p => (
                        <tr class="hover:bg-gray-50/50 transition-colors">
                          <td class="px-6 py-4">
                            <div class="text-xs font-black text-brand-dark">{p.placement}</div>
                          </td>
                          <td class="px-6 py-4 text-right text-xs font-bold text-gray-500">{fmtNum(p.impressions)}</td>
                          <td class="px-6 py-4 text-right text-xs font-bold text-gray-500">{fmtNum(p.clicks)}</td>
                          <td class="px-6 py-4 text-right text-xs font-black text-brand-dark">{fmtPct(p.ctr)}</td>
                          <td class="px-6 py-4 text-right text-xs font-bold text-brand-green">{fmtNum(p.addToCart)}</td>
                        </tr>
                      ))
                    )}
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>

        {/* Rule Performance Table */}
        <div class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden mb-10">
          <div class="px-6 py-4 border-b border-gray-100 bg-gray-50">
            <h3 class="text-xs font-black uppercase tracking-widest text-brand-dark">Rule Performance</h3>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-left">
              <thead class="bg-gray-50/50 border-b border-gray-100">
                <tr>
                  <th class="px-6 py-3 text-[9px] font-black text-gray-400 uppercase tracking-widest">Rule / Bucket</th>
                  <th class="px-6 py-3 text-[9px] font-black text-gray-400 uppercase tracking-widest text-right">Impressions</th>
                  <th class="px-6 py-3 text-[9px] font-black text-gray-400 uppercase tracking-widest text-right">Clicks</th>
                  <th class="px-6 py-3 text-[9px] font-black text-gray-400 uppercase tracking-widest text-right">CTR</th>
                  <th class="px-6 py-3 text-[9px] font-black text-gray-400 uppercase tracking-widest text-right">ATC</th>
                  <th class="px-6 py-3 text-[9px] font-black text-gray-400 uppercase tracking-widest">Placements</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-100">
                {data!.rulePerformance.length === 0 ? (
                  <tr>
                    <td colspan="6" class="px-6 py-8 text-center text-xs font-medium text-gray-400">
                      No rule performance data found for this period.
                    </td>
                  </tr>
                ) : (
                  data!.rulePerformance.map(r => (
                    <tr class="hover:bg-gray-50/50 transition-colors">
                      <td class="px-6 py-4">
                        <div class="text-xs font-black text-brand-dark">{r.label}</div>
                        {r.ruleId && <div class="text-[9px] font-mono text-gray-400 mt-0.5">{r.ruleId.slice(0,8)}</div>}
                      </td>
                      <td class="px-6 py-4 text-right text-xs font-bold text-gray-500">{fmtNum(r.impressions)}</td>
                      <td class="px-6 py-4 text-right text-xs font-bold text-gray-500">{fmtNum(r.clicks)}</td>
                      <td class="px-6 py-4 text-right text-xs font-black text-brand-dark">{fmtPct(r.ctr)}</td>
                      <td class="px-6 py-4 text-right text-xs font-bold text-brand-green">{fmtNum(r.addToCart)}</td>
                      <td class="px-6 py-4">
                        <div class="flex flex-wrap gap-1">
                          {r.placementsTouched.map(p => (
                            <span class="text-[8px] font-black bg-gray-100 text-gray-500 px-1.5 py-0.5 rounded uppercase">{p}</span>
                          ))}
                        </div>
                      </td>
                    </tr>
                  ))
                )}
              </tbody>
            </table>
          </div>
          <div class="px-6 py-3 border-t border-gray-100 bg-gray-50/50">
            <p class="text-[10px] text-gray-500 font-medium leading-relaxed">
              * Organic / no rule means the product appeared without a merchandising rule.
            </p>
          </div>
        </div>

        {/* Product Performance Table */}
        <div class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden mb-10">
          <div class="px-6 py-4 border-b border-gray-100 bg-gray-50">
            <h3 class="text-xs font-black uppercase tracking-widest text-brand-dark">Product Performance</h3>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-left">
              <thead class="bg-gray-50/50 border-b border-gray-100">
                <tr>
                  <th class="px-6 py-3 text-[9px] font-black text-gray-400 uppercase tracking-widest">Product</th>
                  <th class="px-6 py-3 text-[9px] font-black text-gray-400 uppercase tracking-widest">SKU</th>
                  <th class="px-6 py-3 text-[9px] font-black text-gray-400 uppercase tracking-widest text-right">Impressions</th>
                  <th class="px-6 py-3 text-[9px] font-black text-gray-400 uppercase tracking-widest text-right">Clicks</th>
                  <th class="px-6 py-3 text-[9px] font-black text-gray-400 uppercase tracking-widest text-right">CTR</th>
                  <th class="px-6 py-3 text-[9px] font-black text-gray-400 uppercase tracking-widest text-right">ATC</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-100">
                {data!.productPerformance.length === 0 ? (
                  <tr>
                    <td colspan="6" class="px-6 py-8 text-center text-xs font-medium text-gray-400">
                      No product performance data found for this period.
                    </td>
                  </tr>
                ) : (
                  data!.productPerformance.map(p => (
                    <tr class="hover:bg-gray-50/50 transition-colors">
                      <td class="px-6 py-4">
                        <div class="text-xs font-black text-brand-dark truncate max-w-xs">{p.productName || (p.productId ? p.productId.slice(0,8) : 'Unknown Product')}</div>
                      </td>
                      <td class="px-6 py-4 text-xs font-mono text-gray-400">{p.sku || '—'}</td>
                      <td class="px-6 py-4 text-right text-xs font-bold text-gray-500">{fmtNum(p.impressions)}</td>
                      <td class="px-6 py-4 text-right text-xs font-bold text-gray-500">{fmtNum(p.clicks)}</td>
                      <td class="px-6 py-4 text-right text-xs font-black text-brand-dark">{fmtPct(p.ctr)}</td>
                      <td class="px-6 py-4 text-right text-xs font-bold text-brand-green">{fmtNum(p.addToCart)}</td>
                    </tr>
                  ))
                )}
              </tbody>
            </table>
          </div>
        </div>

        {/* R3.1: commercial intelligence — every number carries its state; nothing unavailable renders as zero */}
        {commercial && (
          <div class="bg-white border-2 border-brand-dark/15 rounded-2xl shadow-sm overflow-hidden mb-8" id="revenue">
            <div class="px-6 py-4 border-b border-gray-100 bg-gray-50 flex flex-wrap items-baseline justify-between gap-2">
              <h3 class="text-xs font-black uppercase tracking-widest text-brand-dark">Revenue &amp; orders (30 days)</h3>
              <span class="text-[10px] text-gray-400 font-bold">
                model: {commercial.attributionModel.name} · ATC/click {commercial.attributionModel.atcWindowDays}d · view-through {commercial.attributionModel.viewThroughWindowDays}d (assist only)
              </span>
            </div>
            <div class="p-6">
              <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-4">
                {([
                  ["Direct attributed (net)", commercial.revenue.directAttributedNetUgx],
                  ["Assisted (view-through)", commercial.revenue.assistedNetUgx],
                  ["Organic paid (net)", commercial.revenue.organicPaidNetUgx],
                  ["Incremental", commercial.revenue.incrementalRevenue],
                ] as const).map(([label, m]) => (
                  <div>
                    <p class="text-[9px] font-black text-gray-400 uppercase tracking-wider">{label}</p>
                    <p class={`text-base font-black ${m.state === "OK" || m.state === "PARTIAL" ? "text-brand-dark" : "text-gray-400"}`}>{ugxOrState(m)}</p>
                    {m.reason && <p class="text-[10px] text-gray-500 mt-0.5 leading-snug">{m.reason}</p>}
                  </div>
                ))}
              </div>
              <div class="grid grid-cols-2 md:grid-cols-5 gap-4 border-t border-gray-100 pt-4">
                {([
                  ["Paid orders", commercial.totals.paidOrders],
                  ["With profile stamp", commercial.totals.paidOrdersWithProfile],
                  ["Unattributable (historic)", commercial.totals.paidOrdersUnattributable],
                  ["Attributed order items", commercial.totals.attributedOrderItems],
                  ["Reversed (excluded)", commercial.totals.reversedOrdersExcluded],
                ] as const).map(([label, n]) => (
                  <div>
                    <p class="text-[9px] font-black text-gray-400 uppercase tracking-wider">{label}</p>
                    <p class="text-base font-black text-brand-dark">{n}</p>
                  </div>
                ))}
              </div>
              {commercial.attributedLines.length > 0 && (
                <div class="mt-4 overflow-x-auto">
                  <h4 class="text-[10px] font-black uppercase tracking-widest text-gray-400 mb-2">Attributed lines (latest)</h4>
                  <table class="w-full text-sm">
                    <thead class="text-[10px] uppercase font-black tracking-widest text-gray-500">
                      <tr><th class="text-left py-1">Order</th><th class="text-left px-2">Product</th><th class="text-right px-2">Qty</th><th class="text-right px-2">Net</th><th class="text-left px-2">Mechanism</th><th class="text-left px-2">Placement</th></tr>
                    </thead>
                    <tbody>
                      {commercial.attributedLines.map((l) => (
                        <tr class="border-t border-gray-100">
                          <td class="py-1 font-mono text-xs">{l.orderNumber}</td>
                          <td class="px-2">{l.productName}</td>
                          <td class="text-right px-2">{l.quantity}</td>
                          <td class="text-right px-2 font-black">UGX {Math.round(l.netRevenueUgx).toLocaleString("en-UG")}</td>
                          <td class="px-2 text-xs">{l.mechanism === "RECOMMENDATION_ADD_TO_CART" ? "add-to-cart" : "click"}</td>
                          <td class="px-2 text-xs">{l.placement ?? "—"}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}
            </div>
          </div>
        )}

        {commercial && (
          <div class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden mb-8" id="commercial-funnel">
            <div class="px-6 py-4 border-b border-gray-100 bg-gray-50">
              <h3 class="text-xs font-black uppercase tracking-widest text-brand-dark">Commercial funnel (30 days)</h3>
            </div>
            <div class="p-6">
              <div class="grid grid-cols-2 md:grid-cols-7 gap-3 mb-4 text-center">
                {([
                  ["Impressions", commercial.funnel.raw.impressions],
                  ["Clicks", commercial.funnel.raw.clicks],
                  ["Add-to-carts", commercial.funnel.raw.addToCarts],
                  ["Touched profiles", commercial.funnel.raw.profilesWithTouch],
                  ["Paid orders", commercial.funnel.raw.paidOrdersFromTouchedProfiles],
                  ["Fulfilled", commercial.funnel.raw.fulfilledOrdersFromTouchedProfiles],
                  ["Completed", commercial.funnel.raw.completedOrdersFromTouchedProfiles],
                ] as const).map(([label, n]) => (
                  <div>
                    <p class="text-[9px] font-black text-gray-400 uppercase tracking-wider">{label}</p>
                    <p class="text-lg font-black text-brand-dark">{n}</p>
                  </div>
                ))}
              </div>
              <div class="grid grid-cols-2 md:grid-cols-4 gap-4 border-t border-gray-100 pt-4">
                {([
                  ["Impression → paid", commercial.funnel.impressionToPaidOrderRate],
                  ["Click → paid", commercial.funnel.clickToPaidOrderRate],
                  ["ATC → paid", commercial.funnel.atcToPaidOrderRate],
                  ["Paid → completed", commercial.funnel.paidToCompletedRate],
                ] as const).map(([label, m]) => (
                  <div>
                    <p class="text-[9px] font-black text-gray-400 uppercase tracking-wider">{label}</p>
                    <p class={`text-base font-black ${m.state === "OK" ? "text-brand-dark" : "text-gray-400"}`}>{pctOrState(m)}</p>
                    {m.state === "NOT_ENOUGH_DATA" && <p class="text-[10px] text-gray-500">{m.denominator}/{m.minSample} minimum</p>}
                  </div>
                ))}
              </div>
              <p class="text-[10px] text-gray-500 mt-3">Paid, fulfilled and completed use the canonical order and payment states — never payment initiation.</p>
            </div>
          </div>
        )}

        {commercial && (
          <div class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden mb-8" id="profitability">
            <div class="px-6 py-4 border-b border-gray-100 bg-gray-50">
              <h3 class="text-xs font-black uppercase tracking-widest text-brand-dark">Profitability &amp; ROAS</h3>
            </div>
            <div class="p-6 grid md:grid-cols-2 gap-6">
              {([
                ["Attributed gross margin", commercial.profit.attributedGrossMarginUgx, ugxOrState(commercial.profit.attributedGrossMarginUgx)],
                ["Contribution profit", commercial.profit.contributionProfit, ugxOrState(commercial.profit.contributionProfit)],
                ["Reported ROAS", commercial.roas.reportedRoas, commercial.roas.reportedRoas.state === "OK" ? `${commercial.roas.reportedRoas.value}×` : "Unavailable"],
                ["Contribution ROAS", commercial.roas.contributionRoas, "Unavailable"],
              ] as const).map(([label, m, display]) => (
                <div>
                  <p class="text-[9px] font-black text-gray-400 uppercase tracking-wider">{label}{m.state === "PARTIAL" && <span class="ml-1 text-amber-700">partial</span>}</p>
                  <p class={`text-base font-black ${m.state === "OK" || m.state === "PARTIAL" ? "text-brand-dark" : "text-gray-400"}`}>{display}</p>
                  {m.reason && <p class="text-[10px] text-gray-500 mt-0.5 leading-snug">{m.reason}</p>}
                  {m.missingComponents && m.missingComponents.length > 0 && (
                    <ul class="mt-1 text-[10px] text-amber-800 list-disc pl-4">
                      {m.missingComponents.map((c) => <li>{c}</li>)}
                    </ul>
                  )}
                </div>
              ))}
            </div>
          </div>
        )}

        {commercial && (
          <div class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden mb-8" id="customers">
            <div class="px-6 py-4 border-b border-gray-100 bg-gray-50">
              <h3 class="text-xs font-black uppercase tracking-widest text-brand-dark">Customers &amp; realised value</h3>
            </div>
            <div class="p-6">
              {commercial.customers.cohorts.reason && (
                <p class="text-xs text-gray-500 mb-3">{commercial.customers.cohorts.reason}</p>
              )}
              {(commercial.customers.cohorts.value ?? []).length > 0 ? (
                <div class="overflow-x-auto">
                  <table class="w-full text-sm">
                    <thead class="text-[10px] uppercase font-black tracking-widest text-gray-500">
                      <tr><th class="text-left py-2">Cohort</th><th class="text-right px-3">Customers</th><th class="text-right px-3">Net 30d</th><th class="text-right px-3">Net 60d</th><th class="text-right px-3">Net 90d</th><th class="text-right px-3">Repeat buyers</th></tr>
                    </thead>
                    <tbody>
                      {(commercial.customers.cohorts.value ?? []).map((cRow) => (
                        <tr class="border-t border-gray-100">
                          <td class="py-2 text-xs font-bold text-gray-700">{cRow.cohort.replace(/_/g, " ")}</td>
                          <td class="text-right px-3 font-black">{cRow.customers}</td>
                          <td class="text-right px-3">UGX {Math.round(cRow.netRevenue30dUgx).toLocaleString("en-UG")}</td>
                          <td class="text-right px-3">UGX {Math.round(cRow.netRevenue60dUgx).toLocaleString("en-UG")}</td>
                          <td class="text-right px-3">UGX {Math.round(cRow.netRevenue90dUgx).toLocaleString("en-UG")}</td>
                          <td class="text-right px-3 font-black">{cRow.repeatPurchasers}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              ) : (
                <p class="text-sm text-gray-500">No paying customers exist yet — realised value begins with the first paid order.</p>
              )}
              <p class="text-[10px] text-gray-500 mt-3">Predicted CLV: {commercial.customers.predictedClv.reason}</p>
            </div>
          </div>
        )}

        {/* R6: serving truth — the engine's own records, not browser beacons */}
        <div class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden mb-8">
          <div class="px-6 py-4 border-b border-gray-100 bg-gray-50 flex items-baseline justify-between">
            <h3 class="text-xs font-black uppercase tracking-widest text-brand-dark">Serving truth (7 days)</h3>
            <span class="text-[10px] text-gray-400 font-bold">source: engine response events</span>
          </div>
          <div class="p-6 overflow-x-auto">
            {serving && serving.placements.length > 0 ? (
              <table class="w-full text-sm">
                <thead class="text-[10px] uppercase font-black tracking-widest text-gray-500">
                  <tr><th class="text-left py-2">Placement</th><th class="text-right px-3">Served</th><th class="text-right px-3">Empty</th><th class="text-right px-3">Via fallback</th><th class="text-right px-3">Last served</th></tr>
                </thead>
                <tbody>
                  {serving.placements.map((p) => (
                    <tr class="border-t border-gray-100">
                      <td class="py-2 font-bold text-gray-700">{p.placement}</td>
                      <td class="text-right px-3 font-black text-brand-dark">{p.responses}</td>
                      <td class={`text-right px-3 font-black ${p.empty > 0 ? "text-red-600" : "text-brand-dark"}`}>{p.empty}</td>
                      <td class="text-right px-3 font-black text-brand-dark">{p.fallbackServed}</td>
                      <td class="text-right px-3 text-xs text-gray-500">{p.lastResponseAt ? new Date(p.lastResponseAt).toLocaleString('en-GB', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) : "—"}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            ) : (
              <p class="text-sm text-gray-500">No serving records yet — the engine writes them from the 2026-08-06 release onward.</p>
            )}
          </div>
        </div>

        {/* R6: data quality / lineage — a DATA problem shown apart from an engine problem */}
        <div class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden mb-8">
          <div class="px-6 py-4 border-b border-gray-100 bg-gray-50">
            <h3 class="text-xs font-black uppercase tracking-widest text-brand-dark">Event data quality (30 days)</h3>
          </div>
          <div class="p-6">
            {lineage ? (
              <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                {[
                  ["All events", lineage.total, false],
                  ["Contract v2", lineage.contractV2, false],
                  ["Pre-contract (historic)", lineage.historicPreContract, false],
                  ["Profile-stamped", lineage.profileStamped, false],
                  ["Orphan clicks", lineage.orphanClicks, lineage.orphanClicks > 0],
                  ["ATC without exposure", lineage.attributedAtcWithoutExposure, lineage.attributedAtcWithoutExposure > 0],
                  ["Rail events, no placement", lineage.railEventsMissingPlacement, lineage.railEventsMissingPlacement > 0],
                  ["No identity at all", lineage.identityUnavailable, false],
                ].map(([label, n, warn]) => (
                  <div>
                    <p class="text-[9px] font-black text-gray-400 uppercase tracking-wider">{label}</p>
                    <p class={`text-lg font-black ${warn ? "text-red-600" : "text-brand-dark"}`}>{n}</p>
                  </div>
                ))}
              </div>
            ) : (
              <p class="text-sm text-gray-500">Lineage report unavailable.</p>
            )}
            <p class="text-[10px] text-gray-500 mt-4 leading-relaxed">
              Historic pre-contract rows are a fact of history, never reclassified. An orphan click has no
              impression behind its attribution — a producer defect, counted here instead of silently
              inflating CTR.
            </p>
          </div>
        </div>

        {/* R6: the search intents feeding recommendations */}
        <div class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden mb-8">
          <div class="px-6 py-4 border-b border-gray-100 bg-gray-50">
            <h3 class="text-xs font-black uppercase tracking-widest text-brand-dark">Search intelligence</h3>
          </div>
          <div class="p-6 grid md:grid-cols-3 gap-6">
            <div>
              <h4 class="text-[10px] font-black uppercase tracking-widest text-gray-400 mb-2">Top queries</h4>
              {searchIntel && searchIntel.topQueries.length > 0 ? (
                <ul class="space-y-1">{searchIntel.topQueries.map((q) => (
                  <li class="text-xs text-gray-700 flex justify-between border-b border-gray-100 py-1"><span>{q.query}</span><span class="font-black">{q.searchCount}</span></li>
                ))}</ul>
              ) : <p class="text-xs text-gray-400">Not enough data yet.</p>}
            </div>
            <div>
              <h4 class="text-[10px] font-black uppercase tracking-widest text-gray-400 mb-2">Zero-result searches</h4>
              {searchIntel && searchIntel.zeroResultQueries.length > 0 ? (
                <ul class="space-y-1">{searchIntel.zeroResultQueries.map((q) => (
                  <li class="text-xs text-gray-700 flex justify-between border-b border-gray-100 py-1"><span>{q.query}</span><span class="font-black text-red-600">{q.zeroResultCount}</span></li>
                ))}</ul>
              ) : <p class="text-xs text-gray-400">None recorded — no catalogue gap is wearing a customer's words.</p>}
            </div>
            <div>
              <h4 class="text-[10px] font-black uppercase tracking-widest text-gray-400 mb-2">Clicked, never bought</h4>
              {searchIntel && searchIntel.clickedNeverConverted.length > 0 ? (
                <ul class="space-y-1">{searchIntel.clickedNeverConverted.map((q) => (
                  <li class="text-xs text-gray-700 flex justify-between border-b border-gray-100 py-1"><span>{q.query}</span><span class="font-black">{q.clickCount}</span></li>
                ))}</ul>
              ) : <p class="text-xs text-gray-400">Not enough data yet.</p>}
            </div>
          </div>
        </div>

        {/* R8: the model-readiness decision, evidence beside it */}
        {readiness && (
          <div class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden mb-8">
            <div class="px-6 py-4 border-b border-gray-100 bg-gray-50 flex items-baseline justify-between">
              <h3 class="text-xs font-black uppercase tracking-widest text-brand-dark">Ranking stage</h3>
              <span class="text-[10px] font-black uppercase px-2 py-0.5 rounded bg-gray-100 text-gray-700 border border-gray-200">{readiness.stage}</span>
            </div>
            <div class="p-6">
              <p class="text-xs text-gray-600 mb-4">{readiness.statement}</p>
              <div class="overflow-x-auto">
                <table class="w-full text-sm">
                  <thead class="text-[10px] uppercase font-black tracking-widest text-gray-500">
                    <tr><th class="text-left py-2">Evidence gate</th><th class="text-right px-3">Required</th><th class="text-right px-3">Actual</th><th class="text-right px-3"></th></tr>
                  </thead>
                  <tbody>
                    {readiness.gates.map((g) => (
                      <tr class="border-t border-gray-100">
                        <td class="py-2 text-xs font-bold text-gray-700">{g.gate.replace(/_/g, ' ')}</td>
                        <td class="text-right px-3 font-black text-brand-dark">{g.required.toLocaleString('en-UG')}</td>
                        <td class="text-right px-3 font-black text-brand-dark">{g.actual.toLocaleString('en-UG')}</td>
                        <td class="text-right px-3 text-[10px] font-black uppercase">{g.met ? <span class="text-green-700">met</span> : <span class="text-gray-400">not yet</span>}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
              {readiness.recommendationExperiments.length > 0 ? (
                <div class="mt-4">
                  <h4 class="text-[10px] font-black uppercase tracking-widest text-gray-400 mb-2">Recommendation experiments</h4>
                  {readiness.recommendationExperiments.map((e) => (
                    <p class={`text-xs ${e.srm?.srmSuspected ? "text-red-700 font-bold" : "text-gray-600"}`}>
                      {e.key} · {e.status}{e.srm ? ` · ${e.srm.total} assignment(s) · ${e.srm.note}` : ""}
                    </p>
                  ))}
                </div>
              ) : (
                <p class="text-[11px] text-gray-400 mt-4">No recommendation experiments exist. One is created and RUN only by explicit admin action — never automatically.</p>
              )}
            </div>
          </div>
        )}

        {/* Unavailable Metrics Section */}
        <div class="bg-gray-100 border border-gray-200 rounded-2xl p-6 mb-10">
          <h3 class="text-xs font-black uppercase tracking-widest text-gray-400 mb-4">Unavailable Metrics</h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {data!.unavailableMetrics.map(m => (
              <div class="bg-white/50 border border-gray-200 rounded-xl p-4">
                <h4 class="text-xs font-black text-gray-500 uppercase">{m.metric.replace(/([A-Z])/g, ' $1').trim()}</h4>
                <p class="text-[10px] text-gray-400 mt-1 leading-relaxed">{m.reason}</p>
              </div>
            ))}
          </div>
        </div>
      </>
    )}
  </div>
</AdminLayout>

<script>
  // Simple form handling for filters
  const form = document.getElementById('analytics-filter-form') as HTMLFormElement;
  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const formData = new FormData(form);
      const params = new URLSearchParams();
      
      formData.forEach((value, key) => {
        if (value) params.set(key, value.toString());
      });

      window.location.search = params.toString();
    });
  }
</script>
