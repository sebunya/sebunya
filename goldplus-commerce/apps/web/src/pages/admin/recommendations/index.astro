---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { readSessionToken } from "../../../lib/session";
import { listRecommendationRules } from "../../../lib/admin-recommendations";
import InfoTooltip from "../../../components/admin/InfoTooltip.astro";

const token = readSessionToken(Astro.request);
if (!token) {
  return Astro.redirect("/admin/login?returnTo=/admin/recommendations", 303);
}

const res = await listRecommendationRules(token, {});
const isApiLive = res.ok;
const rules = res.ok ? res.data.rules : [];

const stats = {
  total: rules.length,
  active: rules.filter((r: any) => r.status === 'ACTIVE').length,
  draft: rules.filter((r: any) => r.status === 'DRAFT').length,
  paused: rules.filter((r: any) => r.status === 'PAUSED').length,
};

const placements = [
  { id: 'product_related', name: 'Related Products (PDP)', description: 'Horizontal scroll of compatible accessories based on current viewer target.' },
  { id: 'cart_addon', name: 'Cart Addons (Basket)', description: 'Last-minute high-margin impulsey selections matching cart weights.' },
  { id: 'home_trending', name: 'Trending Now (Homepage)', description: 'High engagement event-driven dynamic list of recent bestsellers.' },
  { id: 'complete_setup', name: 'Complete the Setup (Post-Purchase)', description: 'Dynamic upsells that finish the current ecosystem requirement.' },
  { id: 'category_popular', name: 'Category Popular (PLP)', description: 'Best performers isolated to a single category namespace filter.' },
];
---

<AdminLayout 
  title="Recommendations" 
  description="Manage the rules that influence product recommendations across the store."
>
  <div class="container mx-auto px-6 lg:px-8 max-w-7xl">
    
    <div class="mb-8 border-b border-gray-200 pb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h2 class="text-2xl font-black text-brand-dark tracking-tight">Recommendations</h2>
        <p class="text-sm text-gray-500 mt-1 max-w-2xl">
          Manage the rules that influence product recommendations across the store.
        </p>
      </div>
      <div class="flex items-center gap-2">
        {isApiLive ? (
          <div class="bg-brand-dark text-white px-3 py-1.5 rounded-lg flex items-center gap-2 text-[10px] font-black tracking-wider uppercase">
            <div class="w-2 h-2 rounded-full bg-brand-green animate-pulse"></div>
            <span>API Connected</span>
          </div>
        ) : (
          <div class="bg-red-50 text-red-700 border border-red-200 px-3 py-1.5 rounded-lg flex items-center gap-2 text-[10px] font-black tracking-wider uppercase">
            <span>Offline</span>
          </div>
        )}
      </div>
    </div>

    {/* Stats Grid */}
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-8">
      <div class="bg-white border border-gray-200 rounded-xl p-4 shadow-xs">
        <div class="flex items-center justify-between">
          <p class="text-[9px] font-black text-gray-400 uppercase tracking-wider">Total rules</p>
          <InfoTooltip text="Total number of recommendation rules registered." align="right" />
        </div>
        <h4 class="text-xl font-black text-brand-dark mt-1">{isApiLive ? stats.total : '—'}</h4>
      </div>
      <div class="bg-white border border-gray-200 rounded-xl p-4 shadow-xs">
        <div class="flex items-center justify-between">
          <p class="text-[9px] font-black text-gray-400 uppercase tracking-wider">Active rules</p>
          <InfoTooltip text="Rules that are currently applied and live on the store." align="right" />
        </div>
        <h4 class="text-xl font-black text-brand-green mt-1">{isApiLive ? stats.active : '—'}</h4>
      </div>
      <div class="bg-white border border-gray-200 rounded-xl p-4 shadow-xs">
        <div class="flex items-center justify-between">
          <p class="text-[9px] font-black text-gray-400 uppercase tracking-wider">Draft rules</p>
          <InfoTooltip text="Rules that have been created but are not yet live." align="right" />
        </div>
        <h4 class="text-xl font-black text-amber-600 mt-1">{isApiLive ? stats.draft : '—'}</h4>
      </div>
      <div class="bg-white border border-gray-200 rounded-xl p-4 shadow-xs">
        <div class="flex items-center justify-between">
          <p class="text-[9px] font-black text-gray-400 uppercase tracking-wider">Paused</p>
          <InfoTooltip text="Rules that have been paused and are not active." align="right" />
        </div>
        <h4 class="text-xl font-black text-gray-500 mt-1">{isApiLive ? stats.paused : '—'}</h4>
      </div>
    </div>

    {/* Central Launchpads Grid */}
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
      <div class="bg-white border border-gray-200 rounded-2xl p-6 shadow-sm flex flex-col justify-between h-44">
        <div>
          <h3 class="font-black text-lg text-brand-dark">View rules</h3>
          <p class="text-xs text-gray-500 mt-1 leading-relaxed">Review all registered boosts, suppressed products, and pin position overrides.</p>
        </div>
        <div class="mt-6">
          <a href="/admin/recommendations/rules" class="inline-block w-full bg-brand-dark text-white hover:bg-black text-center py-2.5 rounded-xl font-bold text-xs transition-colors">
            View rules &rarr;
          </a>
        </div>
      </div>

      <div class="bg-white border border-gray-200 rounded-2xl p-6 shadow-sm flex flex-col justify-between h-44">
        <div>
          <h3 class="font-black text-lg text-brand-dark">Create rule</h3>
          <p class="text-xs text-gray-500 mt-1 leading-relaxed">Establish new merchandising rules for product sections or cart suggestions.</p>
        </div>
        <div class="mt-6">
          <a href="/admin/recommendations/rules/new" class="inline-block w-full bg-brand-green text-white hover:bg-emerald-600 text-center py-2.5 rounded-xl font-bold text-xs transition-colors">
            Create rule &rarr;
          </a>
        </div>
      </div>

      <div class="bg-white border border-gray-200 rounded-2xl p-6 shadow-sm flex flex-col justify-between h-44">
        <div>
          <h3 class="font-black text-lg text-brand-dark">Preview recommendations</h3>
          <p class="text-xs text-gray-500 mt-1 leading-relaxed">Test product recommendations using actual configurations before customers see them.</p>
        </div>
        <div class="mt-6">
          <a href="/admin/recommendations/preview" class="inline-block w-full bg-blue-50 text-blue-700 border border-blue-100 hover:bg-blue-100 text-center py-2.5 rounded-xl font-bold text-xs transition-colors">
            Preview recommendations &rarr;
          </a>
        </div>
      </div>
    </div>

    {/* Placement Grid */}
    <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden mb-10">
      <div class="px-6 py-4 border-b border-gray-100 bg-gray-50 flex items-center justify-between">
        <div class="flex items-center gap-2">
          <div>
            <h3 class="text-xs font-black uppercase tracking-widest text-brand-dark inline-flex items-center gap-2">
              Recommendation placements
              <InfoTooltip text="The page section where recommendations appear, such as homepage trending or product suggestions." align="left" />
            </h3>
            <p class="text-[10px] text-gray-500 mt-0.5">Frontend page sections configured to display recommendation data.</p>
          </div>
        </div>
        <span class="text-[10px] bg-brand-green/10 text-brand-green font-black px-2 py-0.5 rounded uppercase tracking-wide">5 Verified</span>
      </div>
      <div class="divide-y divide-gray-100">
        {placements.map(p => (
          <div class="p-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4 hover:bg-gray-50/50 transition-colors">
            <div>
              <h4 class="font-black text-sm text-brand-dark flex items-center gap-2">
                {p.name}
                <span class="font-mono text-[9px] bg-gray-100 text-gray-500 px-1 rounded border border-gray-200">{p.id}</span>
              </h4>
              <p class="text-xs text-gray-500 mt-1">{p.description}</p>
            </div>
            <div class="flex items-center gap-2 flex-shrink-0">
              <a href={`/admin/recommendations/rules/new?placement=${p.id}`} class="text-[10px] font-bold text-white bg-brand-dark hover:bg-black px-2.5 py-1.5 rounded-lg transition-colors shadow-xs">
                Create rule
              </a>
              <a href={`/admin/recommendations/rules?placement=${p.id}`} class="text-[10px] font-bold text-gray-600 hover:text-brand-dark border border-gray-200 hover:border-gray-400 px-2.5 py-1.5 rounded-lg transition-all bg-white">
                View rules
              </a>
              <a href={`/admin/recommendations/preview?placement=${p.id}`} class="text-[10px] font-bold text-gray-600 hover:text-brand-dark border border-gray-200 hover:border-gray-400 px-2.5 py-1.5 rounded-lg transition-all bg-white">
                Preview
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
</AdminLayout>
