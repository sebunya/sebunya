---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { readSessionToken } from "../../../lib/session";
import {
  listRecommendationRules,
  getServingHealth,
  getLineageReport,
  type ServingHealthPayload,
  type LineageReportPayload,
} from "../../../lib/admin-recommendations";

/**
 * The recommendations operating overview (R6, 2026-08-06).
 *
 * The old page hardcoded five marketing-fiction placement descriptions
 * ("high-margin impulsey selections", "recent bestsellers") that the engine
 * never implemented — invented facts on an operator surface. This one shows
 * what the engine actually DID: per-placement serving truth from its own
 * response events, active rules, data quality, and one honest next action.
 */

const token = readSessionToken(Astro.request);
if (!token) return Astro.redirect("/admin/login?returnTo=/admin/recommendations", 303);

const [rulesRes, servingRes, lineageRes] = await Promise.all([
  listRecommendationRules(token, {}),
  getServingHealth(token, 7),
  getLineageReport(token, 30),
]);

const isApiLive = rulesRes.ok;
const rules = rulesRes.ok ? rulesRes.data.rules : [];
const serving: ServingHealthPayload | null = servingRes.ok ? servingRes.data : null;
const lineage: LineageReportPayload | null = lineageRes.ok ? lineageRes.data : null;

/**
 * "We could not ask" and "the answer is zero" are different facts, and this
 * page used to render both as 0 — a failed serving fetch showed every
 * placement as having served nothing, which reads as an outage that isn't one
 * (or hides one that is). A metric nobody measured shows an em dash.
 */
const servingUnavailable = !servingRes.ok;
const servingFailure = servingRes.ok ? null : servingRes;
const count = (value: number | undefined) => (servingUnavailable ? "—" : String(value ?? 0));

/**
 * A refusal is not an outage. 401/403 means the API answered perfectly and
 * declined; saying "unreachable" sends an operator to check the servers when
 * the real answer is that their account lacks a permission.
 */
const deniedCodes = new Set(["UNAUTHENTICATED", "PERMISSION_DENIED", "FORBIDDEN"]);
const isPermissionRefusal = !rulesRes.ok && deniedCodes.has(String(rulesRes.code ?? ""));

const stats = {
  total: rules.length,
  active: rules.filter((r) => r.status === "ACTIVE").length,
  draft: rules.filter((r) => r.status === "DRAFT").length,
  paused: rules.filter((r) => r.status === "PAUSED").length,
};

// Honest placement descriptions: what the ladder ACTUALLY does (R3).
const placements = [
  { id: "home_trending", name: "Homepage — Popular now", description: "Paid-order velocity, then search affinity and engagement; falls back to newest and a stable catalogue order when evidence is thin." },
  { id: "product_related", name: "Product page — Related products", description: "Curated compatibility first, then same-category products and bestsellers around the anchor." },
  { id: "complete_setup", name: "Product page — Complete the setup", description: "Compatibility-required accessories. Honestly empty when nothing verified fits the anchor." },
  { id: "cart_addon", name: "Cart — Useful add-ons", description: "Compatible and complementary items excluding the cart's own contents." },
  { id: "category_popular", name: "Category — Popular in category", description: "Category bestsellers and engagement, falling back to a stable category listing." },
];

const servingFor = (id: string) => serving?.placements.find((p) => p.placement === id);

// One deterministic, honest next action.
let nextAction = { text: "Everything is serving on safe defaults. Nothing needs you.", href: "", cta: "" };
if (isPermissionRefusal) {
  nextAction = {
    text: "Your account cannot read recommendation rules (recommendations.read). The API answered normally and declined — this is a permission to grant, not an outage to investigate.",
    href: "",
    cta: "",
  };
} else if (!isApiLive) {
  nextAction = { text: `The recommendation API is unreachable — nothing on this page is current. (${rulesRes.ok ? "" : rulesRes.message})`, href: "", cta: "" };
} else if (servingUnavailable) {
  nextAction = {
    text: `Serving truth could not be read, so the per-placement counters below are unknown, not zero. (${servingFailure?.message ?? "unknown error"})`,
    href: "",
    cta: "",
  };
} else if (serving && serving.totalResponses === 0) {
  nextAction = {
    text: `No placement has served in the last ${serving.windowDays} days. Open the storefront once and this page will show the serving trace; if it stays empty, the web tier is not reaching the engine.`,
    href: "/",
    cta: "Open the storefront",
  };
} else if (serving && serving.placements.some((p) => p.empty > 0 && p.placement !== "complete_setup")) {
  // complete_setup is EXPECTED to be empty for anchors with no verified
  // compatibility — its honest emptiness must not permanently occupy the
  // next-action slot.
  const worst = [...serving.placements]
    .filter((p) => p.placement !== "complete_setup")
    .sort((a, b) => b.empty - a.empty)[0];
  nextAction = {
    text: `"${placements.find((x) => x.id === worst.placement)?.name ?? worst.placement}" returned empty ${worst.empty} time(s) this week. Preview it to see the typed reason.`,
    href: "/admin/recommendations/preview",
    cta: "Preview the placement",
  };
} else if (lineage && lineage.orphanClicks > 0) {
  nextAction = {
    text: `${lineage.orphanClicks} click(s) in the last 30 days have no impression behind them — a producer defect worth a look.`,
    href: "/admin/recommendations/analytics",
    cta: "Open data quality",
  };
} else if (stats.draft > 0) {
  nextAction = {
    text: `${stats.draft} draft rule(s) are written but not live. Review and activate — or archive — them.`,
    href: "/admin/recommendations/rules?status=DRAFT",
    cta: "Review drafts",
  };
}

const fmtWhen = (iso: string | null) =>
  iso ? new Date(iso).toLocaleString("en-GB", { timeZone: 'Africa/Kampala',  day: "numeric", month: "short", hour: "2-digit", minute: "2-digit" }) : "never";
---

<AdminLayout
  title="Recommendations"
  description="What every placement actually served, and the one thing worth doing next."
>
  <div class="container mx-auto px-6 lg:px-8 max-w-7xl pb-16">
    <div class="mb-8 border-b border-gray-200 pb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h2 class="text-2xl font-black text-brand-dark tracking-tight">Recommendations</h2>
        <p class="text-sm text-gray-500 mt-1 max-w-2xl">
          Every placement serves on safe defaults with no rules at all. This page shows what actually
          happened — from the engine's own records, not the browser's.
        </p>
      </div>
      <div class="flex items-center gap-2">
        {isApiLive ? (
          <div class="bg-brand-dark text-white px-3 py-1.5 rounded-lg flex items-center gap-2 text-[10px] font-black tracking-wider uppercase">
            <div class="w-2 h-2 rounded-full bg-brand-green animate-pulse"></div>
            <span>API Connected</span>
          </div>
        ) : (
          <div class="bg-red-50 text-red-700 border border-red-200 px-3 py-1.5 rounded-lg flex items-center gap-2 text-[10px] font-black tracking-wider uppercase">
            <span>Offline</span>
          </div>
        )}
      </div>
    </div>

    <section class="mb-8 bg-white border-2 border-brand-dark/15 rounded-2xl shadow-sm p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h3 class="text-[10px] font-black uppercase tracking-widest text-gray-400 mb-1">Recommended next action</h3>
        <p class="text-sm font-bold text-brand-dark">{nextAction.text}</p>
      </div>
      {nextAction.href && (
        <a href={nextAction.href} class="shrink-0 bg-brand-dark text-white text-xs font-black uppercase tracking-widest px-4 py-2.5 rounded-lg hover:bg-black text-center">{nextAction.cta}</a>
      )}
    </section>

    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-8">
      {[
        ["Rules", stats.total],
        ["Active", stats.active],
        ["Draft", stats.draft],
        ["Paused", stats.paused],
      ].map(([label, n]) => (
        <div class="bg-white border border-gray-200 rounded-2xl shadow-sm p-4">
          <span class="block text-[10px] font-black uppercase tracking-widest text-gray-400">{label}</span>
          <span class="block text-2xl font-black text-brand-dark mt-1">{n}</span>
        </div>
      ))}
    </div>

    <section class="mb-8">
      <div class="flex items-baseline justify-between mb-3">
        <h3 class="text-sm font-black uppercase tracking-widest text-gray-500">Placements — served in the last 7 days</h3>
        <div class="flex gap-4 text-xs font-black uppercase tracking-widest">
          <a href="/admin/recommendations/preview" class="text-gray-500 hover:text-brand-dark">Preview</a>
          <a href="/admin/recommendations/analytics" class="text-gray-500 hover:text-brand-dark">Analytics</a>
          <a href="/admin/recommendations/rules" class="text-gray-500 hover:text-brand-dark">Rules</a>
        </div>
      </div>
      <div class="grid md:grid-cols-2 xl:grid-cols-3 gap-4">
        {placements.map((p) => {
          const s = servingFor(p.id);
          const activeRulesHere = rules.filter((r) => r.placement === p.id && r.status === "ACTIVE").length;
          return (
            <div class="bg-white border border-gray-200 rounded-2xl shadow-sm p-5">
              <div class="flex items-start justify-between gap-2">
                <h4 class="text-sm font-black text-brand-dark">{p.name}</h4>
                {servingUnavailable
                  ? <span class="text-[9px] font-black uppercase px-2 py-0.5 rounded bg-amber-50 text-amber-700 border border-amber-200">not measured</span>
                  : s && s.responses > 0
                  ? <span class="text-[9px] font-black uppercase px-2 py-0.5 rounded bg-green-50 text-green-700 border border-green-200">serving</span>
                  : <span class="text-[9px] font-black uppercase px-2 py-0.5 rounded bg-gray-50 text-gray-500 border border-gray-200">no serves recorded</span>}
              </div>
              <p class="text-[11px] text-gray-500 mt-1 leading-relaxed">{p.description}</p>
              <dl class="mt-3 grid grid-cols-3 gap-2 text-center">
                <div><dt class="text-[9px] font-black uppercase text-gray-400">Served</dt><dd class="text-sm font-black text-brand-dark">{count(s?.responses)}</dd></div>
                <div><dt class="text-[9px] font-black uppercase text-gray-400">Empty</dt><dd class={`text-sm font-black ${!servingUnavailable && s && s.empty > 0 ? "text-red-600" : "text-brand-dark"}`}>{count(s?.empty)}</dd></div>
                <div><dt class="text-[9px] font-black uppercase text-gray-400">Fallback</dt><dd class="text-sm font-black text-brand-dark">{count(s?.fallbackServed)}</dd></div>
              </dl>
              <p class="text-[10px] text-gray-400 mt-3">
                {servingUnavailable
                  ? "Serving truth could not be read — these are unknown, not zero."
                  : <Fragment>Last served: {fmtWhen(s?.lastResponseAt ?? null)} · {activeRulesHere} active rule(s)</Fragment>}
              </p>
            </div>
          );
        })}
      </div>
      <p class="text-[11px] text-gray-400 mt-3">
        "Served" counts the engine's own response records. Zero here with a working storefront means the
        pages were rendered from cache before this release — the counters begin with the next deploy.
      </p>
    </section>

    {lineage && (lineage.orphanClicks > 0 || lineage.railEventsMissingPlacement > 0) && (
      <section class="bg-amber-50 border border-amber-200 rounded-2xl p-5">
        <h3 class="text-[10px] font-black uppercase tracking-widest text-amber-700 mb-1">Data quality (30 days)</h3>
        <p class="text-xs text-amber-800 font-bold">
          {lineage.orphanClicks > 0 && `${lineage.orphanClicks} click(s) without an impression behind them. `}
          {lineage.railEventsMissingPlacement > 0 && `${lineage.railEventsMissingPlacement} rail event(s) missing a placement. `}
          A data problem, not an engine problem — details in Analytics.
        </p>
      </section>
    )}
  </div>
</AdminLayout>
