---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { readSessionToken } from "../../../lib/session";
import { apiBase } from "../../../lib/api";
import { previewRecommendationRules, type PreviewResultPayload } from "../../../lib/admin-recommendations";
import type { ApiResponse, ProductPublicDto, RecommendationPlacement } from "@goldplus/shared";

/**
 * Placement preview for non-technical operators (R5, 2026-08-06; AC26/AC27).
 *
 * The old page demanded raw UUIDs behind a regex gate and fetched from browser
 * JavaScript against the INTERNAL container origin serialized into a hidden
 * input — unusable without a database console, broken in production. This one
 * is selector-driven and fully server-rendered: pick a placement, pick
 * products by name, see what a real visitor would see and WHY each product is
 * there.
 */

const token = readSessionToken(Astro.request);
if (!token) return Astro.redirect("/admin/login?returnTo=/admin/recommendations/preview", 303);

const PLACEMENTS: Array<{ id: RecommendationPlacement; label: string; needs: "product" | "category" | "cart" | "none" }> = [
  { id: "home_trending", label: "Homepage — Popular now", needs: "none" },
  { id: "product_related", label: "Product page — Related products", needs: "product" },
  { id: "complete_setup", label: "Product page — Complete the setup", needs: "product" },
  { id: "cart_addon", label: "Cart — Useful add-ons", needs: "cart" },
  { id: "category_popular", label: "Category — Popular in category", needs: "category" },
];

let products: ProductPublicDto[] = [];
try {
  const res = await fetch(`${apiBase}/products?limit=100`, { signal: AbortSignal.timeout(5000) });
  const json = (await res.json()) as ApiResponse<ProductPublicDto[]>;
  if (json.success && json.data) products = json.data;
} catch {
  // Selectors state the catalogue is unreachable; the page still renders.
}
const categoryNames = [...new Set(products.map((p) => p.categoryName).filter(Boolean))].sort();
const CATEGORY_SLUG: Record<string, string> = {
  "Power Devices": "power",
  "Sound Devices": "sound",
  "Storage Devices": "storage",
  "Car Accessories": "car-accessories",
  "PC Accessories": "pc-accessories",
};

let notice: string | null = null;
let result: PreviewResultPayload | null = null;
const form: Record<string, string> = {};
let cartSelection: string[] = [];

if (Astro.request.method === "POST") {
  const f = await Astro.request.formData();
  for (const [k, v] of f.entries()) form[k] = String(v);
  cartSelection = f.getAll("cartProducts").map(String).filter(Boolean);
  const placement = String(f.get("placement") || "home_trending") as RecommendationPlacement;
  const needs = PLACEMENTS.find((p) => p.id === placement)?.needs ?? "none";

  const res = await previewRecommendationRules(token, {
    placement,
    productId: needs === "product" ? String(f.get("anchorProduct") || "") || undefined : undefined,
    categorySlug: needs === "category" ? CATEGORY_SLUG[String(f.get("category") || "")] : undefined,
    cartProductIds: needs === "cart" ? cartSelection : undefined,
  });
  if (res.ok) result = res.data;
  else notice = res.message || "Preview failed.";
}

const val = (k: string, dflt = "") => form[k] ?? dflt;
type PreviewItem = { productId: string; name: string; score?: number; reasonCodes?: string[]; displayReason?: string; candidateSource?: string };
const why = (c: PreviewItem) =>
  [c.displayReason, c.candidateSource?.toLowerCase().replace(/_/g, " ")].filter(Boolean).join(" · ");
---

<AdminLayout title="Preview" description="What a visitor would see on any placement — and why each product is there.">
  <div class="container mx-auto px-6 lg:px-8 max-w-4xl pb-16">
    <div class="mb-8 pb-6 border-b border-gray-200">
      <a href="/admin/recommendations" class="text-xs font-black uppercase tracking-widest text-gray-400 hover:text-gray-700">← Recommendations</a>
      <h2 class="text-2xl font-black text-brand-dark tracking-tight mt-2">Preview a placement</h2>
      <p class="text-sm text-gray-500 mt-1 max-w-2xl">
        Real catalogue, live rules, nothing saved. Synthetic context is clearly labelled — this is a
        simulation of a visitor, not a visitor.
      </p>
    </div>

    {notice && <div class="mb-6 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-bold text-red-700" role="status">{notice}</div>}

    <form method="POST" class="bg-white border border-gray-200 rounded-2xl shadow-sm p-6 space-y-4">
      <div class="grid sm:grid-cols-2 gap-4">
        <label class="block">
          <span class="text-[10px] uppercase font-black text-gray-400 tracking-widest">Placement</span>
          <select name="placement" class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 text-sm">
            {PLACEMENTS.map((p) => <option value={p.id} selected={val("placement") === p.id}>{p.label}</option>)}
          </select>
        </label>
        <label class="block">
          <span class="text-[10px] uppercase font-black text-gray-400 tracking-widest">Anchor product (product-page placements)</span>
          <select name="anchorProduct" class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 text-sm">
            {products.length === 0 && <option value="">Catalogue unreachable</option>}
            {products.map((p) => <option value={p.id} selected={val("anchorProduct") === p.id}>{p.name}</option>)}
          </select>
        </label>
        <label class="block">
          <span class="text-[10px] uppercase font-black text-gray-400 tracking-widest">Category (category placement)</span>
          <select name="category" class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 text-sm">
            {categoryNames.map((c) => <option value={c} selected={val("category") === c}>{c}</option>)}
          </select>
        </label>
        <label class="block">
          <span class="text-[10px] uppercase font-black text-gray-400 tracking-widest">Cart contents (cart placement — pick any)</span>
          <select name="cartProducts" multiple size="4" class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 text-sm">
            {products.map((p) => <option value={p.id} selected={cartSelection.includes(p.id)}>{p.name}</option>)}
          </select>
        </label>
      </div>
      <button type="submit" class="bg-brand-dark text-white text-xs font-black uppercase tracking-widest px-4 py-2.5 rounded-lg hover:bg-black">Run preview</button>
    </form>

    {result && (
      <section class="mt-8 bg-white border border-gray-200 rounded-2xl shadow-sm p-6">
        <div class="flex flex-wrap items-baseline justify-between gap-2 mb-4">
          <h3 class="text-sm font-black uppercase tracking-widest text-gray-500">
            {PLACEMENTS.find((p) => p.id === result!.placement)?.label ?? result.placement} — synthetic visitor
          </h3>
          {result.appliedRuleIds.length > 0
            ? <span class="text-[10px] font-black uppercase text-amber-700">{result.appliedRuleIds.length} rule(s) applied</span>
            : <span class="text-[10px] font-black uppercase text-green-700">safe defaults only — no rules active here</span>}
        </div>

        <div class="grid md:grid-cols-2 gap-6">
          <div>
            <h4 class="text-[10px] uppercase font-black tracking-widest text-gray-400 mb-2">Default ranking</h4>
            <ol class="space-y-1">
              {(result.before as PreviewItem[]).map((c, i) => (
                <li class="border-b border-gray-100 py-1.5">
                  <span class="text-sm text-gray-800">{i + 1}. {c.name}</span>
                  <span class="block text-[11px] text-gray-500">{why(c)}</span>
                </li>
              ))}
              {result.before.length === 0 && <li class="text-sm text-gray-400">Empty.</li>}
            </ol>
          </div>
          <div>
            <h4 class="text-[10px] uppercase font-black tracking-widest text-gray-400 mb-2">With active rules</h4>
            <ol class="space-y-1">
              {(result.after as PreviewItem[]).map((c, i) => {
                const move = result!.guardrails?.rankMoves.find((m) => m.productId === c.productId);
                return (
                  <li class="border-b border-gray-100 py-1.5">
                    <div class="flex justify-between">
                      <span class="text-sm text-gray-800">{i + 1}. {c.name}</span>
                      {move && <span class="text-[10px] font-black uppercase text-gray-400">{move.from > move.to ? `↑ ${move.from + 1}→${move.to + 1}` : `↓ ${move.from + 1}→${move.to + 1}`}</span>}
                    </div>
                    <span class="block text-[11px] text-gray-500">{why(c)}</span>
                  </li>
                );
              })}
              {result.after.length === 0 && <li class="text-sm text-red-600 font-bold">Empty after rules.</li>}
            </ol>
          </div>
        </div>

        {result.guardrails && (result.guardrails.itemsRemoved.length > 0 || result.guardrails.itemsAdded.length > 0) && (
          <p class="text-[11px] text-gray-500 mt-4">
            {result.guardrails.itemsAdded.length > 0 && `Added: ${result.guardrails.itemsAdded.map((a) => a.name).join(", ")}. `}
            {result.guardrails.itemsRemoved.length > 0 && `Removed: ${result.guardrails.itemsRemoved.map((r) => r.name).join(", ")}.`}
          </p>
        )}
        {result.warnings.length > 0 && (
          <div class="mt-4 rounded-xl border border-amber-300 bg-amber-50 px-4 py-3 text-xs font-bold text-amber-800">{result.warnings.join(" · ")}</div>
        )}
      </section>
    )}
  </div>
</AdminLayout>
