---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import AdminPageHeader from "../../../components/AdminPageHeader.astro";
import FormField from "../../../components/FormField.astro";
import RecommendationRulePreviewPanel from "../../../components/recommendations/RecommendationRulePreviewPanel.astro";
import { readSessionToken } from "../../../lib/session";
import { apiBase } from "../../../lib/api";

const token = readSessionToken(Astro.request);
if (!token) return Astro.redirect("/admin/login", 303);
---

<BaseLayout title="Standalone Sandbox - Preview">
  <div class="container mx-auto px-4 lg:px-8 py-10">
    <AdminPageHeader
      title="Recommendation Sandbox"
      description="Visualize existing rule combination outputs live across specific context scenarios."
      backHref="/admin/recommendations/rules"
      backLabel="Back to rules"
    />

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mt-8">
      
      <!-- INPUT CONTROLS -->
      <div class="lg:col-span-1 space-y-6">
        <form id="sandbox-form" class="bg-white border border-gray-200 shadow-sm rounded-2xl overflow-hidden">
           <div class="p-6 bg-gray-50 border-b border-gray-100">
              <h3 class="text-xs uppercase font-black text-gray-500 tracking-widest">Placement Context</h3>
           </div>
           <div class="p-6 space-y-4">
             <div>
               <label class="block text-xs font-bold text-brand-dark mb-2">Target Position</label>
               <select id="s_placement" class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-lg font-bold text-sm">
                 <option value="home_trending">Home Trending</option>
                 <option value="product_related">Product Related</option>
                 <option value="cart_addon">Cart Addon</option>
                 <option value="category_popular">Category Popular</option>
                 <option value="complete_setup">Complete Setup</option>
               </select>
             </div>
             
             <div class="pt-4 border-t border-gray-100 space-y-3">
                <h4 class="text-[10px] uppercase font-bold text-gray-400">Simulated Environment</h4>
                <FormField id="s_prod" name="productId" label="Anchor Product UUID" placeholder="e.g. for product_related" />
                <FormField id="s_cat" name="categorySlug" label="Category Slug" placeholder="power-banks" />
                <FormField id="s_cart" name="cartItems" label="Active Cart CSV" placeholder="prod_1, prod_2" helperText="Separate multiple with comma." />
             </div>

             <button type="submit" class="w-full bg-brand-dark text-white font-black py-4 rounded-xl shadow-md hover:opacity-90 transition-opacity mt-4 flex items-center justify-center gap-2">
               <span>⚡</span> Compute Matrix
             </button>
           </div>
        </form>

        <div class="bg-blue-50 border border-blue-100 p-6 rounded-2xl">
           <h4 class="text-xs font-bold text-blue-800 mb-2">How it works</h4>
           <p class="text-xs text-blue-700 leading-relaxed">
             Unlike the Rule Editor, this sandbox fetches the CURRENT live active rules snapshot exactly as real shoppers would experience them right now, but displays visual diagnostics explaining which rules caused displacement.
           </p>
        </div>
      </div>

      <!-- OUTPUT PANEL -->
      <div class="lg:col-span-2">
         <div id="sandbox-empty-state" class="bg-gray-50 border border-gray-200 border-dashed rounded-2xl p-12 text-center h-full flex flex-col items-center justify-center min-h-[400px]">
             <span class="text-6xl grayscale opacity-40 mb-4">🔮</span>
             <h3 class="text-lg font-bold text-gray-600">Matrix Engine Ready</h3>
             <p class="text-sm text-gray-400 mt-1 max-w-xs">Set your placement and press 'Compute Matrix' to parse real-time distribution outcomes.</p>
         </div>
         <RecommendationRulePreviewPanel />
      </div>
    </div>
    <input type="hidden" id="session-token" value={token} />
    <input type="hidden" id="api-base-url" value={apiBase} />
  </div>
</BaseLayout>

<script>
  const form = document.getElementById('sandbox-form');
  const token = (document.getElementById('session-token') as HTMLInputElement)?.value;
  const emptyState = document.getElementById('sandbox-empty-state');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const submitBtn = form.querySelector('button[type="submit"]')!;
    const originalText = submitBtn.innerHTML;
    submitBtn.innerHTML = '<span>⏳</span> Simulating Layer...';
    submitBtn.classList.add('opacity-50', 'pointer-events-none');

    const placement = (document.getElementById('s_placement') as HTMLSelectElement).value;
    const productId = (document.getElementById('s_prod') as HTMLInputElement).value || undefined;
    const catSlug = (document.getElementById('s_cat') as HTMLInputElement).value || undefined;
    const rawCart = (document.getElementById('s_cart') as HTMLInputElement).value;
    const cartProductIds = rawCart ? rawCart.split(',').map(s => s.trim()).filter(Boolean) : undefined;

    const payload = {
      placement,
      productId,
      categorySlug: catSlug,
      cartProductIds,
      draftOnly: false // Important: standalone uses real active database snapshot!
    };

    try {
      const apiBase = (document.getElementById('api-base-url') as HTMLInputElement)?.value || 'http://localhost:3000';
      const r = await fetch(`${apiBase}/admin/recommendations/preview`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
        body: JSON.stringify(payload)
      });
      
      const json = await r.json();
      if (json.success && json.data) {
         emptyState?.classList.add('hidden');
         if (typeof (window as any).renderRecommendationPreview === 'function') {
           (window as any).renderRecommendationPreview(json.data);
         }
      } else {
         alert("Sandbox Error: " + (json.error?.message || "API Issue"));
      }
    } catch(err) {
       alert("Network disruption blocking matrix computation.");
    } finally {
       submitBtn.innerHTML = originalText;
       submitBtn.classList.remove('opacity-50', 'pointer-events-none');
    }
  });
</script>
