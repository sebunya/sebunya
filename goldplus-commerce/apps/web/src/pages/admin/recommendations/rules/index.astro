---
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import EmptyState from "../../../../components/EmptyState.astro";
import Notice from "../../../../components/Notice.astro";
import RuleStatusBadge from "../../../../components/recommendations/RuleStatusBadge.astro";

import { listRecommendationRules } from "../../../../lib/admin-recommendations";
import { readSessionToken } from "../../../../lib/session";

const token = readSessionToken(Astro.request);
if (!token) {
  return Astro.redirect("/admin/login?returnTo=/admin/recommendations/rules", 303);
}

const url = new URL(Astro.request.url);
const query = {
  placement: url.searchParams.get('placement') || undefined,
  status: url.searchParams.get('status') || undefined,
  type: url.searchParams.get('type') || undefined,
  search: url.searchParams.get('search') || undefined,
};

const res = await listRecommendationRules(token, query);
const error = !res.ok ? res.message : null;
const data = res.ok ? res.data : { rules: [], total: 0 };
---

<AdminLayout 
  title="Recommendation Rules" 
  description="Operate deterministic catalog boosts, pins and suppressions."
>
  <div class="container mx-auto px-6 lg:px-8 max-w-7xl">
    
    <div class="flex flex-col sm:flex-row sm:items-center justify-between mb-8 gap-4 pb-6 border-b border-gray-200">
      <div>
        <h2 class="text-2xl font-black text-brand-dark tracking-tight">Rules Engine</h2>
        <p class="text-sm text-gray-500 mt-1">Manage overrides and overrides of base scoring pipelines.</p>
      </div>
      <div>
        <a href="/admin/recommendations/rules/new" class="bg-brand-dark text-white px-5 py-2 rounded-xl font-bold hover:bg-black transition-colors shadow-sm flex items-center gap-2 text-sm">
          <span>➕</span> Create Rule
        </a>
      </div>
    </div>

    {/* Filter Bar */}
    <div class="bg-white border border-gray-200 rounded-2xl p-5 mb-8 shadow-sm flex flex-col md:flex-row items-center gap-4">
      <form method="GET" class="flex-grow grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 w-full">
        <div>
          <input type="text" name="search" value={query.search || ''} placeholder="Search rule name..." class="w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded-xl text-xs font-bold text-brand-dark outline-none focus:border-brand-green" />
        </div>
        <div>
          <select name="placement" class="w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded-xl text-xs font-bold text-brand-dark">
            <option value="">Any Placement Zone</option>
            <option value="product_related" selected={query.placement === 'product_related'}>Product Related (PDP)</option>
            <option value="cart_addon" selected={query.placement === 'cart_addon'}>Cart Addons</option>
            <option value="home_trending" selected={query.placement === 'home_trending'}>Home Trending</option>
            <option value="complete_setup" selected={query.placement === 'complete_setup'}>Complete Setup</option>
            <option value="category_popular" selected={query.placement === 'category_popular'}>Category Popular</option>
          </select>
        </div>
        <div>
          <select name="type" class="w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded-xl text-xs font-bold text-brand-dark">
            <option value="">Any Rule Type</option>
            <option value="BOOST" selected={query.type === 'BOOST'}>Boost</option>
            <option value="PIN" selected={query.type === 'PIN'}>Pin</option>
            <option value="SUPPRESS" selected={query.type === 'SUPPRESS'}>Suppress</option>
            <option value="CAMPAIGN" selected={query.type === 'CAMPAIGN'}>Campaign</option>
          </select>
        </div>
        <div class="flex gap-2">
          <select name="status" class="flex-grow px-3 py-2 bg-gray-50 border border-gray-200 rounded-xl text-xs font-bold text-brand-dark">
            <option value="">Any Status</option>
            <option value="ACTIVE" selected={query.status === 'ACTIVE'}>Active</option>
            <option value="DRAFT" selected={query.status === 'DRAFT'}>Draft</option>
            <option value="PAUSED" selected={query.status === 'PAUSED'}>Paused</option>
          </select>
          <button type="submit" class="bg-brand-dark text-white px-4 rounded-xl font-bold text-xs hover:bg-black transition-colors">Filter</button>
        </div>
      </form>
      {(query.placement || query.search || query.type || query.status) && (
        <a href="/admin/recommendations/rules" class="text-xs font-black text-gray-400 hover:text-red-600 transition-colors">Clear</a>
      )}
    </div>

    {error && <Notice kind="not-configured" title="API Error" message={error} />}

    {!error && data.rules.length === 0 ? (
      <EmptyState 
        title="No Rules Found" 
        message="No merchandising rules match current filters. Create a new rule to override default engine sorting." 
      />
    ) : !error ? (
      <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-gray-50 text-[10px] uppercase font-black text-gray-400 tracking-widest border-b border-gray-100">
                <th class="p-6">Rule Description</th>
                <th class="p-6">Placement Target</th>
                <th class="p-6">Type & Priority</th>
                <th class="p-6 text-center">Active Status</th>
                <th class="p-6 text-right">Modification</th>
              </tr>
            </thead>
            <tbody class="text-xs divide-y divide-gray-50">
              {data.rules.map((rule) => (
                <tr class="hover:bg-gray-50 transition-colors">
                  <td class="p-6">
                    <div class="font-bold text-brand-dark text-sm">{rule.name}</div>
                    <div class="text-[10px] text-gray-400 mt-1 flex items-center gap-2">
                      <span class="uppercase font-mono text-[9px] bg-gray-100 border border-gray-200 px-1.5 rounded">{rule.targetType}</span>
                      {rule.targetValue && <span class="truncate max-w-[150px]">{rule.targetValue}</span>}
                    </div>
                  </td>
                  <td class="p-6 font-mono text-gray-500 font-medium">
                    {rule.placement}
                  </td>
                  <td class="p-6">
                    <div class="flex items-center gap-2">
                      <span class={`inline-block px-2 py-0.5 rounded font-black text-[9px] border uppercase tracking-wide ${
                        rule.type === 'SUPPRESS' ? 'bg-red-50 text-red-700 border-red-100' : 
                        rule.type === 'PIN' ? 'bg-yellow-50 text-yellow-700 border-yellow-200' : 
                        'bg-blue-50 text-blue-700 border-blue-100'
                      }`}>
                        {rule.type}
                      </span>
                      <span class="text-[10px] text-gray-400 font-bold">PRI: {rule.priority}</span>
                    </div>
                  </td>
                  <td class="p-6 text-center">
                    <RuleStatusBadge status={rule.status} />
                  </td>
                  <td class="p-6 text-right">
                    <a href={`/admin/recommendations/rules/${rule.id}`} class="inline-block text-xs font-bold text-gray-500 hover:text-brand-dark border border-gray-200 hover:border-gray-400 px-3 py-1.5 rounded-lg transition-all bg-white">
                      Manage &rarr;
                    </a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    ) : null}

  </div>
</AdminLayout>

