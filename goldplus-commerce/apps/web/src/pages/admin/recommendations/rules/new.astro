---
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import { readSessionToken } from "../../../../lib/session";
import { apiBase } from "../../../../lib/api";
import {
  createRecommendationRule,
  previewRecommendationRules,
  type PreviewResultPayload,
} from "../../../../lib/admin-recommendations";
import type { ApiResponse, ProductPublicDto, RecommendationPlacement } from "@goldplus/shared";

/**
 * The rule wizard, rebuilt for operators (R5, 2026-08-06; AC25).
 *
 * The old form demanded raw SKUs/UUIDs in a free-text box and posted its
 * preview from browser JavaScript against a hidden input that carried the
 * INTERNAL container origin — broken in production by construction. This page
 * is goal-first, selector-driven and entirely server-rendered: every product
 * and category is chosen by NAME, and preview/save are SSR form intents.
 */

const token = readSessionToken(Astro.request);
if (!token) return Astro.redirect("/admin/login?returnTo=/admin/recommendations/rules/new", 303);

const PLACEMENTS: Array<{ id: RecommendationPlacement; label: string }> = [
  { id: "home_trending", label: "Homepage — Popular now" },
  { id: "product_related", label: "Product page — Related products" },
  { id: "complete_setup", label: "Product page — Complete the setup" },
  { id: "cart_addon", label: "Cart — Useful add-ons" },
  { id: "category_popular", label: "Category — Popular in category" },
];

const GOALS = [
  { id: "BOOST", label: "Promote", help: "Move the target up the ranking with a bounded boost. Relevance and stock rules still apply." },
  { id: "PIN", label: "Pin to a position", help: "Hold one product at a fixed slot — only while it stays eligible (in stock, priced, approved)." },
  { id: "SUPPRESS", label: "Suppress", help: "Remove the target from this placement. Created as a draft; a DIFFERENT admin must activate it." },
] as const;

// Product and category options by NAME. Eight products today — a dropdown is
// the honest selector; search-as-you-type earns its place when the catalogue does.
let products: ProductPublicDto[] = [];
try {
  const res = await fetch(`${apiBase}/products?limit=100`, { signal: AbortSignal.timeout(5000) });
  const json = (await res.json()) as ApiResponse<ProductPublicDto[]>;
  if (json.success && json.data) products = json.data;
} catch {
  // The form still renders; the product selector says the catalogue is unreachable.
}
const categoryNames = [...new Set(products.map((p) => p.categoryName).filter(Boolean))].sort();
const CATEGORY_SLUG: Record<string, string> = {
  "Power Devices": "power",
  "Sound Devices": "sound",
  "Storage Devices": "storage",
  "Car Accessories": "car-accessories",
  "PC Accessories": "pc-accessories",
};

let notice: { kind: "success" | "error"; text: string } | null = null;
let preview: PreviewResultPayload | null = null;
const form: Record<string, string> = {};

function buildRule(f: FormData) {
  const type = String(f.get("goal") || "BOOST");
  const targetKind = String(f.get("targetKind") || "PRODUCT");
  const targetValue =
    targetKind === "PRODUCT"
      ? String(f.get("targetProduct") || "")
      : targetKind === "CATEGORY"
        ? CATEGORY_SLUG[String(f.get("targetCategory") || "")] ?? ""
        : "";
  return {
    name: String(f.get("name") || "").trim(),
    description: String(f.get("description") || "").trim() || undefined,
    type,
    status: "DRAFT",
    priority: Number(f.get("priority")) || 100,
    placement: String(f.get("placement") || "home_trending"),
    targetType: targetKind,
    targetValue: targetValue || undefined,
    conditions: {},
    action: {
      type,
      ...(type === "BOOST" ? { boostScore: Number(f.get("boostScore")) || 25 } : {}),
      ...(type === "PIN" ? { pinPosition: Number(f.get("pinPosition")) || 1 } : {}),
    },
    startsAt: String(f.get("startsAt") || "") || undefined,
    endsAt: String(f.get("endsAt") || "") || undefined,
  };
}

if (Astro.request.method === "POST") {
  const f = await Astro.request.formData();
  for (const [k, v] of f.entries()) form[k] = String(v);
  const intent = String(f.get("_intent") || "");
  const rule = buildRule(f);

  if (intent === "preview") {
    const res = await previewRecommendationRules(token, {
      placement: rule.placement as RecommendationPlacement,
      productId: ["product_related", "complete_setup"].includes(rule.placement)
        ? String(f.get("contextProduct") || "") || undefined
        : undefined,
      categorySlug: rule.placement === "category_popular" ? CATEGORY_SLUG[String(f.get("targetCategory") || "")] : undefined,
      draftRule: rule as never,
    });
    if (res.ok) {
      preview = res.data;
    } else {
      notice = { kind: "error", text: Array.isArray(res.details) ? res.details.join(" ") : res.message || "Preview failed." };
    }
  } else if (intent === "save_draft" || intent === "save_activate") {
    const status = intent === "save_activate" && rule.type !== "SUPPRESS" ? "ACTIVE" : "DRAFT";
    const res = await createRecommendationRule(token, { ...rule, status } as never);
    if (res.ok) {
      const suffix = rule.type === "SUPPRESS" && intent === "save_activate" ? "&suppressDraft=true" : "";
      return Astro.redirect(`/admin/recommendations/rules/${res.data.id}?created=${status}${suffix}`, 303);
    }
    notice = {
      kind: "error",
      text: Array.isArray(res.details) ? res.details.join(" ") : res.message || "The rule could not be saved.",
    };
  }
}

const val = (k: string, dflt = "") => form[k] ?? dflt;
const item = (c: { productId: string; name: string; score?: number }) => c;
---

<AdminLayout title="New rule" description="Influence a placement's default ranking — by name, with a preview.">
  <div class="container mx-auto px-6 lg:px-8 max-w-4xl pb-16">
    <div class="mb-8 pb-6 border-b border-gray-200">
      <a href="/admin/recommendations/rules" class="text-xs font-black uppercase tracking-widest text-gray-400 hover:text-gray-700">← Rules</a>
      <h2 class="text-2xl font-black text-brand-dark tracking-tight mt-2">Create a rule</h2>
      <p class="text-sm text-gray-500 mt-1 max-w-2xl">
        Recommendations already run on safe defaults. A rule is a business override on top of them — it can
        never surface an out-of-stock, unpriced or unapproved product.
      </p>
    </div>

    {notice && (
      <div class={`mb-6 rounded-xl border px-4 py-3 text-sm font-bold ${notice.kind === "success" ? "border-green-200 bg-green-50 text-green-700" : "border-red-200 bg-red-50 text-red-700"}`} role="status">{notice.text}</div>
    )}

    <form method="POST" class="space-y-6">
      <section class="bg-white border border-gray-200 rounded-2xl shadow-sm p-6">
        <h3 class="text-sm font-black uppercase tracking-widest text-gray-500 mb-4">1 · Goal</h3>
        <div class="grid sm:grid-cols-3 gap-3">
          {GOALS.map((g) => (
            <label class="border border-gray-200 rounded-xl p-4 cursor-pointer hover:border-gray-400 has-[:checked]:border-brand-dark has-[:checked]:ring-2 has-[:checked]:ring-brand-dark/20">
              <input type="radio" name="goal" value={g.id} checked={val("goal", "BOOST") === g.id} class="sr-only" />
              <span class="block text-sm font-black text-brand-dark">{g.label}</span>
              <span class="block text-[11px] text-gray-500 mt-1">{g.help}</span>
            </label>
          ))}
        </div>
      </section>

      <section class="bg-white border border-gray-200 rounded-2xl shadow-sm p-6 space-y-4">
        <h3 class="text-sm font-black uppercase tracking-widest text-gray-500">2 · Where and what</h3>
        <div class="grid sm:grid-cols-2 gap-4">
          <label class="block">
            <span class="text-[10px] uppercase font-black text-gray-400 tracking-widest">Placement</span>
            <select name="placement" class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 text-sm">
              {PLACEMENTS.map((p) => <option value={p.id} selected={val("placement") === p.id}>{p.label}</option>)}
            </select>
          </label>
          <label class="block">
            <span class="text-[10px] uppercase font-black text-gray-400 tracking-widest">Target</span>
            <select name="targetKind" class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 text-sm">
              <option value="PRODUCT" selected={val("targetKind", "PRODUCT") === "PRODUCT"}>A specific product</option>
              <option value="CATEGORY" selected={val("targetKind") === "CATEGORY"}>A whole category</option>
              <option value="GLOBAL" selected={val("targetKind") === "GLOBAL"}>Everything in the placement</option>
            </select>
          </label>
          <label class="block">
            <span class="text-[10px] uppercase font-black text-gray-400 tracking-widest">Product (by name)</span>
            <select name="targetProduct" class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 text-sm">
              {products.length === 0 && <option value="">Catalogue unreachable — try again</option>}
              {products.map((p) => <option value={p.id} selected={val("targetProduct") === p.id}>{p.name}</option>)}
            </select>
          </label>
          <label class="block">
            <span class="text-[10px] uppercase font-black text-gray-400 tracking-widest">Category</span>
            <select name="targetCategory" class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 text-sm">
              {categoryNames.map((c) => <option value={c} selected={val("targetCategory") === c}>{c}</option>)}
            </select>
          </label>
        </div>
        <p class="text-[11px] text-gray-500">
          The product selector applies when the target is a product (and for pins, which always target one
          product). The category selector applies when the target is a category.
        </p>
      </section>

      <section class="bg-white border border-gray-200 rounded-2xl shadow-sm p-6 space-y-4">
        <h3 class="text-sm font-black uppercase tracking-widest text-gray-500">3 · Strength, order and schedule</h3>
        <div class="grid sm:grid-cols-4 gap-4">
          <label class="block">
            <span class="text-[10px] uppercase font-black text-gray-400 tracking-widest">Boost (−100…100)</span>
            <input name="boostScore" type="number" min="-100" max="100" value={val("boostScore", "25")} class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" />
          </label>
          <label class="block">
            <span class="text-[10px] uppercase font-black text-gray-400 tracking-widest">Pin position (1–20)</span>
            <input name="pinPosition" type="number" min="1" max="20" value={val("pinPosition", "1")} class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" />
          </label>
          <label class="block">
            <span class="text-[10px] uppercase font-black text-gray-400 tracking-widest">Priority (1 runs first)</span>
            <input name="priority" type="number" min="1" max="1000" value={val("priority", "100")} class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" />
          </label>
          <div></div>
          <label class="block">
            <span class="text-[10px] uppercase font-black text-gray-400 tracking-widest">Starts (optional)</span>
            <input name="startsAt" type="datetime-local" value={val("startsAt")} class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" />
          </label>
          <label class="block">
            <span class="text-[10px] uppercase font-black text-gray-400 tracking-widest">Ends (optional)</span>
            <input name="endsAt" type="datetime-local" value={val("endsAt")} class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" />
          </label>
        </div>
      </section>

      <section class="bg-white border border-gray-200 rounded-2xl shadow-sm p-6 space-y-4">
        <h3 class="text-sm font-black uppercase tracking-widest text-gray-500">4 · Name it, preview it, save it</h3>
        <div class="grid sm:grid-cols-2 gap-4">
          <label class="block">
            <span class="text-[10px] uppercase font-black text-gray-400 tracking-widest">Rule name</span>
            <input name="name" value={val("name")} placeholder="e.g. Promote power banks on the homepage" required class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" />
          </label>
          <label class="block">
            <span class="text-[10px] uppercase font-black text-gray-400 tracking-widest">Context product for preview (PDP placements)</span>
            <select name="contextProduct" class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 text-sm">
              {products.map((p) => <option value={p.id} selected={val("contextProduct") === p.id}>{p.name}</option>)}
            </select>
          </label>
        </div>
        <label class="block">
          <span class="text-[10px] uppercase font-black text-gray-400 tracking-widest">Notes (optional)</span>
          <textarea name="description" rows="2" class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 text-sm">{val("description")}</textarea>
        </label>
        <div class="flex flex-wrap gap-3 pt-2">
          <button type="submit" name="_intent" value="preview" class="border border-gray-300 text-gray-700 text-xs font-black uppercase tracking-widest px-4 py-2.5 rounded-lg hover:bg-gray-50">Preview the effect</button>
          <button type="submit" name="_intent" value="save_draft" class="border border-gray-300 text-gray-700 text-xs font-black uppercase tracking-widest px-4 py-2.5 rounded-lg hover:bg-gray-50">Save as draft</button>
          <button type="submit" name="_intent" value="save_activate" class="bg-brand-dark text-white text-xs font-black uppercase tracking-widest px-4 py-2.5 rounded-lg hover:bg-black">Save &amp; activate</button>
        </div>
        <p class="text-[11px] text-gray-500">
          Suppression rules are always saved as drafts — a different admin activates them (two-person integrity).
        </p>
      </section>
    </form>

    {preview && (
      <section class="mt-8 bg-white border-2 border-brand-dark/20 rounded-2xl shadow-sm p-6">
        <h3 class="text-sm font-black uppercase tracking-widest text-gray-500 mb-1">Preview — what this rule would do</h3>
        <p class="text-xs text-gray-500 mb-4">Real catalogue, nothing saved, nothing served to customers.</p>

        {preview.guardrails?.emptyAfterRules && (
          <div class="mb-4 rounded-xl border-2 border-red-400 bg-red-50 px-4 py-3 text-sm font-black text-red-800">
            This rule would EMPTY the placement. It cannot be worth that.
          </div>
        )}
        {preview.guardrails && preview.guardrails.lowStockPinned.length > 0 && (
          <div class="mb-4 rounded-xl border border-amber-300 bg-amber-50 px-4 py-3 text-xs font-bold text-amber-800">
            Low stock behind a pin: {preview.guardrails.lowStockPinned.map((i) => `${i.name} (${i.stockQuantity} left)`).join(", ")} — the pin vanishes the moment stock runs out.
          </div>
        )}
        {preview.warnings.length > 0 && (
          <div class="mb-4 rounded-xl border border-amber-300 bg-amber-50 px-4 py-3 text-xs font-bold text-amber-800">{preview.warnings.join(" · ")}</div>
        )}

        <div class="grid md:grid-cols-2 gap-6">
          <div>
            <h4 class="text-[10px] uppercase font-black tracking-widest text-gray-400 mb-2">Before rules</h4>
            <ol class="space-y-1">
              {preview.before.map((c, i) => (
                <li class="text-sm text-gray-700 flex justify-between border-b border-gray-100 py-1">
                  <span>{i + 1}. {item(c).name}</span>
                </li>
              ))}
              {preview.before.length === 0 && <li class="text-sm text-gray-400">Empty.</li>}
            </ol>
          </div>
          <div>
            <h4 class="text-[10px] uppercase font-black tracking-widest text-gray-400 mb-2">After this rule</h4>
            <ol class="space-y-1">
              {preview.after.map((c, i) => {
                const move = preview!.guardrails?.rankMoves.find((m) => m.productId === item(c).productId);
                const added = preview!.guardrails?.itemsAdded.some((a) => a.productId === item(c).productId);
                return (
                  <li class="text-sm text-gray-700 flex justify-between border-b border-gray-100 py-1">
                    <span>{i + 1}. {item(c).name}</span>
                    <span class="text-[10px] font-black uppercase text-gray-400">
                      {added ? "added" : move ? (move.from > move.to ? `↑ from ${move.from + 1}` : `↓ from ${move.from + 1}`) : ""}
                    </span>
                  </li>
                );
              })}
              {preview.after.length === 0 && <li class="text-sm text-red-600 font-bold">Empty — see the warning above.</li>}
            </ol>
            {preview.guardrails && preview.guardrails.itemsRemoved.length > 0 && (
              <p class="text-[11px] text-gray-500 mt-2">Removed: {preview.guardrails.itemsRemoved.map((r) => r.name).join(", ")}</p>
            )}
          </div>
        </div>
      </section>
    )}
  </div>
</AdminLayout>
