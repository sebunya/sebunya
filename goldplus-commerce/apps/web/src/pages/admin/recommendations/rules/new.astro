---
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import FormField from "../../../../components/FormField.astro";
import FormFeedback from "../../../../components/FormFeedback.astro";
import RecommendationRulePreviewPanel from "../../../../components/recommendations/RecommendationRulePreviewPanel.astro";
import InfoTooltip from "../../../../components/admin/InfoTooltip.astro";

import { createRecommendationRule } from "../../../../lib/admin-recommendations";
import { readSessionToken } from "../../../../lib/session";
import { apiBase } from "../../../../lib/api";

const token = readSessionToken(Astro.request);
if (!token) return Astro.redirect("/admin/login?returnTo=/admin/recommendations/rules/new", 303);

let feedback: { status: 'success' | 'error', message: string, details?: string[] } | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  
  const type = String(form.get('type'));
  const name = String(form.get('name'));
  const placement = String(form.get('placement'));
  const targetType = String(form.get('targetType'));
  const targetValue = String(form.get('targetValue') || '');
  const priority = parseInt(String(form.get('priority') || '100'), 10);
  const startsAt = String(form.get('startsAt') || '');
  const endsAt = String(form.get('endsAt') || '');
  
  // Compute target action
  const action: any = { type };
  if (type === 'BOOST') action.boostScore = parseFloat(String(form.get('boostScore') || '0'));
  if (type === 'SUPPRESS') action.suppress = true;
  if (type === 'PIN') action.pinPosition = parseInt(String(form.get('pinPosition') || '1'), 10);
  if (type === 'CAMPAIGN') {
     action.boostScore = parseFloat(String(form.get('campBoostScore') || '0'));
     action.campaignLabel = String(form.get('campaignLabel') || '');
  }

  const payload = {
    name,
    type: type as any,
    placement: placement as any,
    status: String(form.get('_submit_action') === 'save_activate' ? 'ACTIVE' : 'DRAFT') as any,
    targetType: targetType as any,
    targetValue: targetValue || undefined,
    priority,
    action,
    conditions: {}, // V1 simplistic
    startsAt: startsAt ? new Date(startsAt).toISOString() : undefined,
    endsAt: endsAt ? new Date(endsAt).toISOString() : undefined,
  };

  const res = await createRecommendationRule(token, payload);
  if (res.ok) {
    return Astro.redirect(`/admin/recommendations/rules/${res.data.id}?created=true`, 303);
  } else {
    feedback = { 
      status: 'error', 
      message: res.message,
      details: Array.isArray(res.details) ? res.details : undefined 
    };
  }
}
---

<AdminLayout 
  title="Create rule" 
  description="Establish a new recommendation rule."
>
  <div class="container mx-auto px-6 lg:px-8 max-w-7xl">
    
    <div class="flex flex-col sm:flex-row sm:items-center justify-between mb-8 gap-4 pb-6 border-b border-gray-200">
      <div>
        <h2 class="text-2xl font-black text-brand-dark tracking-tight">Create rule</h2>
        <p class="text-sm text-gray-500 mt-1">Establish a new recommendation rule.</p>
      </div>
      <a href="/admin/recommendations/rules" class="text-xs font-bold text-gray-400 hover:text-brand-dark border border-gray-200 px-3 py-1.5 rounded-lg bg-white transition-colors">
        &larr; View rules
      </a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      {/* Main Form Left */}
      <div class="lg:col-span-7 space-y-6">
        {feedback && <FormFeedback status={feedback.status} message={feedback.message} />}
        {feedback?.details && (
          <div class="bg-red-50 p-4 rounded-xl text-red-800 text-xs border border-red-100 -mt-4">
            <p class="font-bold mb-1">Validation Failures:</p>
            <ul class="list-disc list-inside">
              {feedback.details.map(d => <li>{d}</li>)}
            </ul>
          </div>
        )}

        <form id="rule-main-form" method="POST" class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden">
          <div class="p-6 space-y-6">
            {/* Basic Meta */}
            <div class="space-y-4">
              <h3 class="text-[10px] uppercase font-black text-gray-400 tracking-widest border-b border-gray-100 pb-2">Rule details</h3>
              <FormField id="r_name" name="name" label="Rule Name" required placeholder="e.g. Summer iPhone Boost" helperText="Internal name to help you recognize this rule later.">
                <div slot="label" class="flex items-center gap-1.5">
                  <span>Rule Name</span>
                  <InfoTooltip text="An internal label to help identify what this rule does." align="left" />
                </div>
              </FormField>
              
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                  <label class="block text-xs font-black uppercase tracking-wide text-gray-400 mb-2">Placement</label>
                  <select name="placement" required class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl text-xs font-bold text-brand-dark outline-none focus:border-brand-green">
                    <option value="home_trending">Home Trending</option>
                    <option value="product_related">Product Related</option>
                    <option value="cart_addon">Cart Addon</option>
                    <option value="category_popular">Category Popular</option>
                    <option value="complete_setup">Complete Setup</option>
                  </select>
                </div>
                <div>
                  <label class="block text-xs font-black uppercase tracking-wide text-gray-400 mb-2 flex items-center gap-2">
                    Rule Type
                    <InfoTooltip text="Action this rule takes: Boost score, Pin position, or Suppress from results." align="left" />
                  </label>
                  <select id="type-selector" name="type" required class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl text-xs font-black text-blue-700 outline-none focus:border-brand-green">
                    <option value="BOOST">Boost scored list</option>
                    <option value="PIN">Pin to absolute position</option>
                    <option value="SUPPRESS">Suppress / Remove</option>
                    <option value="CAMPAIGN">Scheduled campaign</option>
                  </select>
                </div>
              </div>
            </div>

            {/* Logic & Action Configuration */}
            <div class="space-y-4">
              <h3 class="text-[10px] uppercase font-black text-gray-400 tracking-widest border-b border-gray-100 pb-2">Placement and target</h3>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                  <label class="block text-xs font-black uppercase tracking-wide text-gray-400 mb-2 flex items-center gap-2">
                    Target scope
                    <InfoTooltip text="The level of product coverage this rule should apply to." align="left" />
                  </label>
                  <select name="targetType" required class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl text-xs font-bold text-brand-dark outline-none focus:border-brand-green">
                    <option value="GLOBAL">Entire inventory (Global)</option>
                    <option value="PRODUCT">Specific product</option>
                    <option value="CATEGORY">Specific category</option>
                    <option value="BRAND">Specific brand</option>
                  </select>
                </div>
                <FormField id="r_target_val" name="targetValue" label="Target identifier" placeholder="Product SKU / ID" helperText="Specify the ID or SKU if applying to a specific item.">
                  <div slot="label" class="flex items-center gap-1.5">
                    <span>Target identifier</span>
                    <InfoTooltip text="Enter the exact ID, SKU, or slug depending on target scope selection." align="left" />
                  </div>
                </FormField>
              </div>

              {/* Conditional Action Fields */}
              <div id="action-area" class="bg-blue-50/50 border border-blue-100 p-5 rounded-2xl space-y-4">
                
                {/* Action: BOOST */}
                <div class="action-variant" data-type="BOOST">
                  <FormField id="b_score" name="boostScore" type="number" label="Score adjustment" defaultValue="50" helperText="Amount added directly to the product score." />
                </div>

                {/* Action: PIN */}
                <div class="hidden action-variant" data-type="PIN">
                   <FormField id="p_pos" name="pinPosition" type="number" label="Fix into position" defaultValue="1" helperText="Forces this item into the specified slot (e.g. 1 for the first slot)." />
                   <p class="text-[10px] font-bold text-amber-700 mt-3 bg-amber-50 p-2 rounded-lg border border-amber-100">Note: Pin requires a Specific product target.</p>
                </div>

                {/* Action: SUPPRESS */}
                <div class="hidden action-variant" data-type="SUPPRESS">
                   <div class="text-xs font-bold text-red-700 space-y-2">
                     <div>This rule will remove the product from the recommendations completely.</div>
                     <div class="text-[10px] text-red-500 font-bold bg-red-50/50 p-2 rounded-lg border border-red-100">Note: Ensure a proper Target scope and Identifier are set. Leave blank or choose GLOBAL carefully as it may suppress everything.</div>
                   </div>
                </div>

                {/* Action: CAMPAIGN */}
                <div class="hidden action-variant" data-type="CAMPAIGN">
                   <div class="grid grid-cols-2 gap-4">
                     <FormField id="c_score" name="campBoostScore" type="number" label="Campaign boost" defaultValue="100" />
                     <FormField id="c_lbl" name="campaignLabel" label="Campaign tag" placeholder="Black Friday Campaign" />
                   </div>
                </div>
              </div>
            </div>

            {/* Schedule */}
            <div class="space-y-4">
               <h3 class="text-[10px] uppercase font-black text-gray-400 tracking-widest border-b border-gray-100 pb-2">Schedule and priority</h3>
               <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                  <FormField id="r_pri" name="priority" type="number" label="Priority" defaultValue="100" helperText="Lower numbers run first (e.g. 10 runs before 100).">
                    <div slot="label" class="flex items-center gap-1.5">
                      <span>Priority</span>
                      <InfoTooltip text="Priority level. Lower numbers run first (e.g. 10 runs before 100)." align="left" />
                    </div>
                  </FormField>
                  <FormField id="r_start" name="startsAt" type="date" label="Start date" placeholder="YYYY-MM-DD" helperText="Leave blank to start immediately." />
                  <FormField id="r_end" name="endsAt" type="date" label="End date" placeholder="YYYY-MM-DD" helperText="Leave blank if the rule should keep running." />
               </div>
            </div>
          </div>

          <div class="p-6 bg-gray-50 border-t border-gray-200 flex flex-col sm:flex-row justify-end items-center gap-3">
            <button type="button" id="btn-trigger-preview" class="w-full sm:w-auto bg-white border border-gray-200 text-brand-dark px-5 py-2.5 rounded-xl font-bold hover:bg-gray-100 shadow-sm text-xs transition-colors">
              Preview
            </button>
            <button type="submit" name="_submit_action" value="save_draft" class="w-full sm:w-auto bg-gray-200 text-gray-700 px-5 py-2.5 rounded-xl font-bold hover:bg-gray-300 text-xs transition-colors">
              Save draft
            </button>
            <button type="submit" name="_submit_action" value="save_activate" class="w-full sm:w-auto bg-brand-green text-white px-5 py-2.5 rounded-xl font-black hover:bg-emerald-600 text-xs shadow-sm transition-colors">
              Save and activate
            </button>
          </div>
          <input type="hidden" id="session-token" value={token} />
          <input type="hidden" id="api-base-url" value={apiBase} />
        </form>
      </div>

      {/* Preview Right */}
      <div class="lg:col-span-5">
         <div class="sticky top-8 space-y-4">
            <div id="rule-summary-panel" class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden sticky top-8">
               <div class="px-5 py-4 bg-gray-50 border-b border-gray-100 flex items-center justify-between">
                  <h3 class="text-xs font-black uppercase tracking-widest text-brand-dark">Rule summary</h3>
                  <span class="text-[9px] font-bold bg-blue-50 text-blue-600 border border-blue-100 px-2 py-0.5 rounded uppercase">Draft</span>
               </div>
               <div class="p-5 space-y-4">
                  <div class="flex justify-between text-xs border-b border-gray-50 pb-2.5">
                     <span class="font-bold text-gray-400 uppercase tracking-wider text-[10px]">Placement</span>
                     <span id="sum-placement" class="font-black text-brand-dark font-mono text-[11px]">-</span>
                  </div>
                  <div class="flex justify-between text-xs border-b border-gray-50 pb-2.5">
                     <span class="font-bold text-gray-400 uppercase tracking-wider text-[10px]">Type</span>
                     <span id="sum-type" class="font-black text-blue-600 font-mono text-[11px]">-</span>
                  </div>
                  <div class="flex justify-between text-xs border-b border-gray-50 pb-2.5">
                     <span class="font-bold text-gray-400 uppercase tracking-wider text-[10px]">Target</span>
                     <span id="sum-target" class="font-black text-brand-dark font-mono text-[11px]">-</span>
                  </div>
                  <div class="flex justify-between text-xs border-b border-gray-50 pb-2.5">
                     <span class="font-bold text-gray-400 uppercase tracking-wider text-[10px]">Priority</span>
                     <span id="sum-priority" class="font-black text-brand-dark text-[11px]">-</span>
                  </div>
                  <div class="flex justify-between text-xs">
                     <span class="font-bold text-gray-400 uppercase tracking-wider text-[10px]">Dates</span>
                     <span id="sum-dates" class="font-bold text-gray-500 text-[11px]">-</span>
                  </div>
                  
                  <div id="sum-notices" class="space-y-2 mt-4 pt-4 border-t border-gray-100">
                     <!-- Validation notes generated live by JS -->
                  </div>

                  <div class="bg-blue-50/50 border border-blue-100 rounded-xl p-4 mt-4 flex items-start gap-3">
                     <p class="text-[10px] text-blue-700 font-medium leading-relaxed">
                        This rule is currently a draft and is not yet visible to customers.
                     </p>
                  </div>
               </div>
            </div>
            <RecommendationRulePreviewPanel />
         </div>
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  const form = document.getElementById('rule-main-form') as HTMLFormElement;
  const typeSel = document.getElementById('type-selector') as HTMLSelectElement;
  const variants = document.querySelectorAll('.action-variant');
  const sumPanel = document.getElementById('rule-summary-panel');

  // Live Summary Populators
  const sumPlacement = document.getElementById('sum-placement')!;
  const sumType = document.getElementById('sum-type')!;
  const sumTarget = document.getElementById('sum-target')!;
  const sumPriority = document.getElementById('sum-priority')!;
  const sumDates = document.getElementById('sum-dates')!;
  const sumNotices = document.getElementById('sum-notices')!;

  function updateSummary() {
    if (!form) return;
    const fd = new FormData(form);

    const placement = fd.get('placement') as string;
    const type = fd.get('type') as string;
    const targetType = fd.get('targetType') as string;
    const targetValue = fd.get('targetValue') as string;
    const priority = parseInt(fd.get('priority') as string || '100', 10);
    const startsAt = fd.get('startsAt') as string;
    const endsAt = fd.get('endsAt') as string;

    // Update basic labels
    sumPlacement.textContent = placement.toUpperCase().replace('_', ' ');
    sumType.textContent = type;
    
    let scopeText = targetType;
    if (targetValue) {
      scopeText += ` (${targetValue})`;
    }
    sumTarget.textContent = scopeText;
    sumPriority.textContent = priority.toString();

    let boundsText = "Perpetual run";
    if (startsAt && endsAt) boundsText = `${startsAt} to ${endsAt}`;
    else if (startsAt) boundsText = `Starts ${startsAt}`;
    else if (endsAt) boundsText = `Until ${endsAt}`;
    sumDates.textContent = boundsText;

    // Generate Warnings / Notices
    let noticesHtml = '';
    
    if (targetType === 'GLOBAL') {
      noticesHtml += `<div class="flex items-start gap-2 bg-amber-50 border border-amber-100 text-amber-800 p-2 rounded-lg text-[9px] font-bold">
        <span>Applies to all products.</span>
      </div>`;
    }

    if (!endsAt) {
      noticesHtml += `<div class="flex items-start gap-2 bg-blue-50 border border-blue-100 text-blue-700 p-2 rounded-lg text-[9px] font-bold">
        <span>No end date set.</span>
      </div>`;
    }

    if (priority < 50) {
      noticesHtml += `<div class="flex items-start gap-2 bg-purple-50 border border-purple-100 text-purple-700 p-2 rounded-lg text-[9px] font-bold">
        <span><strong>High priority:</strong> This rule takes priority over standard configurations.</span>
      </div>`;
    }

    if (type === 'PIN' && targetType !== 'PRODUCT') {
      noticesHtml += `<div class="flex items-start gap-2 bg-red-50 border border-red-200 text-red-700 p-2 rounded-lg text-[9px] font-bold">
        <span><strong>Incorrect target:</strong> Pinning rules require a Specific product target.</span>
      </div>`;
    }

    if (startsAt && endsAt && new Date(startsAt) > new Date(endsAt)) {
      noticesHtml += `<div class="flex items-start gap-2 bg-red-50 border border-red-200 text-red-700 p-2 rounded-lg text-[9px] font-bold">
        <span><strong>Invalid window:</strong> End date cannot be before the start date.</span>
      </div>`;
    }

    sumNotices.innerHTML = noticesHtml || `<div class="text-[9px] text-gray-400 italic text-center py-1">Ready to preview or save.</div>`;
  }

  // Wire up interactive UI switcher & update trigger
  typeSel?.addEventListener('change', () => {
    const val = typeSel.value;
    variants.forEach(v => {
      if ((v as HTMLElement).dataset.type === val) {
        v.classList.remove('hidden');
      } else {
        v.classList.add('hidden');
      }
    });
    updateSummary();
  });

  // Validations before submitting or previewing
  function validateInputs(): string[] {
    const errors: string[] = [];
    const nameInput = document.getElementById('r_name') as HTMLInputElement;
    const typeInput = document.getElementById('type-selector') as HTMLSelectElement;
    const targetTypeSelect = document.getElementsByName('targetType')[0] as HTMLSelectElement;
    const targetValInput = document.getElementById('r_target_val') as HTMLInputElement;
    const startInput = document.getElementById('r_start') as HTMLInputElement;
    const endInput = document.getElementById('r_end') as HTMLInputElement;

    if (!nameInput.value.trim()) {
      errors.push("Rule name is required.");
    }
    if (typeInput.value === 'PIN' && targetTypeSelect.value !== 'PRODUCT') {
      errors.push("Pin rule type requires Target Scope to be 'Specific product'.");
    }
    if (targetTypeSelect.value !== 'GLOBAL' && !targetValInput.value.trim()) {
      errors.push(`Target identifier is required when Target scope is ${targetTypeSelect.value}.`);
    }
    if (startInput.value && endInput.value) {
      if (new Date(startInput.value) > new Date(endInput.value)) {
        errors.push("End date cannot be before the start date.");
      }
    }
    return errors;
  }

  // Block invalid form submit
  form?.addEventListener('submit', (e) => {
    const errors = validateInputs();
    if (errors.length > 0) {
      e.preventDefault();
      alert("Please correct the following problems:\n- " + errors.join("\n- "));
    }
  });

  // Bind inputs for real-time reactive sync
  form?.querySelectorAll('input, select').forEach(el => {
    el.addEventListener('input', updateSummary);
    el.addEventListener('change', updateSummary);
  });

  // Run initial load synchronization
  updateSummary();

  // Async Preview Connector
  const btnPreview = document.getElementById('btn-trigger-preview');
  const token = (document.getElementById('session-token') as HTMLInputElement)?.value;

  btnPreview?.addEventListener('click', async () => {
    const clientErrors = validateInputs();
    if (clientErrors.length > 0) {
      alert("Cannot preview due to validation errors:\n- " + clientErrors.join("\n- "));
      return;
    }

    btnPreview.textContent = "Loading...";
    btnPreview.classList.add('opacity-50', 'pointer-events-none');

    const fd = new FormData(form);
    const type = fd.get('type') as string;
    const action: any = { type };
    
    if (type === 'BOOST') action.boostScore = parseFloat(fd.get('boostScore') as string || '0');
    if (type === 'SUPPRESS') action.suppress = true;
    if (type === 'PIN') action.pinPosition = parseInt(fd.get('pinPosition') as string || '1', 10);
    if (type === 'CAMPAIGN') {
       action.boostScore = parseFloat(fd.get('campBoostScore') as string || '0');
       action.campaignLabel = fd.get('campaignLabel') as string;
    }

    const payload = {
      placement: fd.get('placement') as string,
      draftRule: {
        name: fd.get('name') as string,
        type: type,
        placement: fd.get('placement') as string,
        targetType: fd.get('targetType') as string,
        targetValue: fd.get('targetValue') as string || undefined,
        action: action,
        status: 'ACTIVE',
        priority: parseInt(fd.get('priority') as string || '100', 10),
        conditions: {}
      }
    };

    try {
      const apiBase = (document.getElementById('api-base-url') as HTMLInputElement)?.value || 'http://localhost:3000';
      
      const r = await fetch(`${apiBase}/admin/recommendations/preview`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
        body: JSON.stringify(payload)
      });
      
      const json = await r.json();
      
      if (json.success && json.data) {
        sumPanel?.classList.add('hidden');
        if (typeof (window as any).renderRecommendationPreview === 'function') {
          (window as any).renderRecommendationPreview(json.data);
        }
      } else {
        alert("Preview failed: " + (json.error?.message || "Invalid structure"));
      }
    } catch (err) {
       alert("Connectivity error blocking preview simulation.");
    } finally {
      btnPreview.textContent = "Preview";
      btnPreview.classList.remove('opacity-50', 'pointer-events-none');
    }
  });
</script>
