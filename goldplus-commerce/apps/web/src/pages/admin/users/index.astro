---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import EmptyState from '../../../components/EmptyState.astro';
import Notice from '../../../components/Notice.astro';
import { apiBase } from '../../../lib/api';
import { readSessionToken, clearSessionCookie } from '../../../lib/session';
import type { ApiEnvelope } from '@goldplus/shared';

interface UserRow {
  id: string;
  email: string;
  phone: string | null;
  isActive: boolean;
  roleNames: string[];
  createdAt: string;
}

const token = readSessionToken(Astro.request);
if (!token) {
  return Astro.redirect('/admin/login?returnTo=/admin/users', 303);
}

  // §6: governed user creation + maker/checker decisions. Initial passwords are
  // typed by the creating administrator and communicated out-of-band — they are
  // posted to the API and never echoed back or logged.
  let umNotice: { kind: "success" | "error"; text: string } | null = null;
  if (Astro.request.method === "POST") {
    try {
      const form = await Astro.request.formData();
      const action = String(form.get("action") || "");
      if (action === "create-user") {
        const res2 = await fetch(`${apiBase}/admin/users`, {
          method: "POST",
          headers: { "Content-Type": "application/json", Authorization: `Bearer ${token}` },
          body: JSON.stringify({
            email: form.get("email"), phone: form.get("phone") || null,
            initialPassword: form.get("initialPassword"), roleName: form.get("roleName"),
          }),
        });
        const json2 = await res2.json().catch(() => null);
        umNotice = res2.ok && json2?.success
          ? { kind: "success", text: `User ${json2.data.email} created — role ${json2.data.roleOutcome === "ASSIGNED" ? "assigned" : "awaiting a second administrator's approval"}. Communicate the initial password out-of-band and have them change it on first login.` }
          : { kind: "error", text: json2?.error?.message || "User creation refused." };
      } else if (action === "set-active") {
        const id = String(form.get("id") || "");
        const active = String(form.get("active") || "") === "true";
        const res2 = await fetch(`${apiBase}/admin/users/${encodeURIComponent(id)}/active`, {
          method: "POST",
          headers: { "Content-Type": "application/json", Authorization: `Bearer ${token}` },
          body: JSON.stringify({ active, reason: form.get("reason") || null }),
        });
        const json2 = await res2.json().catch(() => null);
        umNotice = res2.ok && json2?.success
          ? { kind: "success", text: active ? "Account reactivated. They can sign in again." : "Account deactivated. Their sessions have been ended and they can no longer sign in." }
          : { kind: "error", text: json2?.error?.message || "Change refused." };
      } else if (action === "decide-grant") {
        const id = String(form.get("id") || "");
        const res2 = await fetch(`${apiBase}/admin/users/grant-requests/${encodeURIComponent(id)}/decide`, {
          method: "POST",
          headers: { "Content-Type": "application/json", Authorization: `Bearer ${token}` },
          body: JSON.stringify({ decision: form.get("decision"), reason: form.get("reason") || null }),
        });
        const json2 = await res2.json().catch(() => null);
        umNotice = res2.ok && json2?.success
          ? { kind: "success", text: `Grant request ${json2.data.decided}.` }
          : { kind: "error", text: json2?.error?.message || "Decision refused." };
      } else if (action === "assign-role") {
        const id = String(form.get("id") || "");
        const roleName = String(form.get("roleName") || "");
        const res2 = await fetch(`${apiBase}/admin/users/${encodeURIComponent(id)}/roles`, {
          method: "POST",
          headers: { "Content-Type": "application/json", Authorization: `Bearer ${token}` },
          body: JSON.stringify({ roleName, reason: form.get("reason") || null }),
        });
        const json2 = await res2.json().catch(() => null);
        umNotice = res2.ok && json2?.success
          ? { kind: "success", text: json2.data.outcome === "ASSIGNED" ? `${roleName} assigned. It applies on their next request.` : `${roleName} requested — a different administrator must approve it below.` }
          : { kind: "error", text: json2?.error?.message || "Role assignment refused." };
      } else if (action === "revoke-role") {
        const id = String(form.get("id") || "");
        const roleName = String(form.get("roleName") || "");
        const res2 = await fetch(`${apiBase}/admin/users/${encodeURIComponent(id)}/roles/revoke`, {
          method: "POST",
          headers: { "Content-Type": "application/json", Authorization: `Bearer ${token}` },
          body: JSON.stringify({ roleName }),
        });
        const json2 = await res2.json().catch(() => null);
        umNotice = res2.ok && json2?.success
          ? { kind: "success", text: json2.data.revoked ? `${roleName} revoked. It stops applying on their next request.` : `${roleName} was not held by that account.` }
          : { kind: "error", text: json2?.error?.message || "Revoke refused." };
      }
    } catch {
      umNotice = { kind: "error", text: "User service is unreachable right now." };
    }
  }

  // Permission count per role, from the roles API. In production nine of the
  // twelve roles hold no permissions at all, so a user created with one of
  // them can sign in and open nothing. The select says so instead of letting
  // the grant fail silently. If roles cannot be listed, labels stay plain.
  const permissionCountByRole = new Map<string, number>();
  // Every role that exists, from the roles API — the governance vocabulary plus
  // roles created on the Roles screen. Full-access roles need a second
  // administrator's approval. If roles cannot be listed, the vocabulary below
  // is offered with plain labels.
  const FALLBACK_ROLE_NAMES = ['LEGAL_REVIEWER', 'ANALYST', 'SUPPORT_OPERATOR', 'PLATFORM_ADMINISTRATOR'];
  let roleOptions: { name: string; isSystem: boolean }[] = [];
  try {
    const rr = await fetch(`${apiBase}/admin/roles`, { headers: { Authorization: `Bearer ${token}` }, signal: AbortSignal.timeout(4000) });
    const rj = rr.ok ? await rr.json().catch(() => null) : null;
    if (rj?.success && Array.isArray(rj.data)) {
      for (const r of rj.data as { name: string; permissionCodes: string[]; isSystem?: boolean }[]) {
        permissionCountByRole.set(r.name, r.permissionCodes.length);
        roleOptions.push({ name: r.name, isSystem: Boolean(r.isSystem) });
      }
      roleOptions.sort((a, b) => Number(a.isSystem) - Number(b.isSystem) || a.name.localeCompare(b.name));
    }
  } catch {
    // labels stay plain
  }
  if (roleOptions.length === 0) roleOptions = FALLBACK_ROLE_NAMES.map((name) => ({ name, isSystem: name === 'PLATFORM_ADMINISTRATOR' }));
  const roleLabel = (name: string, suffix = ''): string => {
    const n = permissionCountByRole.get(name);
    if (n === undefined) return `${name}${suffix}`;
    if (n === 0) return `${name} — no permissions yet: can sign in, opens nothing${suffix}`;
    return `${name} — ${n} permissions${suffix}`;
  };
  const optionLabel = (r: { name: string; isSystem: boolean }): string => roleLabel(r.name, r.isSystem ? ' (needs approval)' : '');
  let grantRequests: any[] = [];
  try {
    const gr = await fetch(`${apiBase}/admin/users/grant-requests`, { headers: { Authorization: `Bearer ${token}` }, signal: AbortSignal.timeout(4000) });
    const grJson = await gr.json().catch(() => null);
    if (grJson?.success) grantRequests = grJson.data.requests;
  } catch { /* list stays empty; the section shows a truthful empty state */ }

let rows: UserRow[] = [];
let fetchError: string | null = null;

try {
  const res = await fetch(`${apiBase}/admin/users`, { headers: { Authorization: `Bearer ${token}` } });
  if (res.status === 401 || res.status === 403) {
    Astro.response.headers.set('Set-Cookie', clearSessionCookie());
    return Astro.redirect('/admin/login?returnTo=/admin/users', 303);
  }
  if (!res.ok) {
    fetchError = `Users service responded with HTTP ${res.status}.`;
  } else {
    const json = (await res.json()) as ApiEnvelope<UserRow[]>;
    if (json.success && Array.isArray(json.data)) rows = json.data;
    else fetchError = json.error?.message ?? 'Unexpected response.';
  }
} catch {
  fetchError = 'Cannot reach the users service right now.';
}
---

<AdminLayout 
  title="Operator Accounts" 
  description="Oversee platform identities and assignments."
>
  <div class="container mx-auto px-6 lg:px-8 max-w-7xl">
    
    <div class="flex flex-col sm:flex-row sm:items-center justify-between mb-8 gap-4 pb-6 border-b border-gray-200">
      <div>
        <h2 class="text-2xl font-black text-brand-dark tracking-tight">System Users</h2>
        <p class="text-sm text-gray-500 mt-1">Platform identity listings holding administrative or operational scopes.</p>
      </div>
    </div>

    {fetchError && (
      <div class="mb-6">
        {/* This renders when the user list could not be loaded. "Directory
            Synchronization Halted" implied a suspended feature; there is no
            directory sync here, and the real condition is a failed read. */}
        <Notice kind="warning" title="Could not load the user list" message={fetchError} />
      </div>
    )}

    {rows.length === 0 && !fetchError ? (
      <EmptyState
        title="No User Records Located"
        message="Execute console seeding to instantiate the primary supervisor record."
      />
    ) : rows.length > 0 ? (
      <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-gray-50 text-[10px] uppercase font-black text-gray-500 tracking-widest border-b border-gray-100">
                <th class="p-6">Email Handle</th>
                <th class="p-6">Contact Trace</th>
                <th class="p-6">Assigned Scopes</th>
                <th class="p-6 text-center">Account State</th>
                <th class="p-6 text-right">Registered</th>
              </tr>
            </thead>
            <tbody class="text-xs divide-y divide-gray-50">
              {rows.map((u) => (
                <tr class="hover:bg-gray-50 transition-colors">
                  <td class="p-6">
                    <div class="font-bold text-brand-dark text-sm break-all">{u.email}</div>
                  </td>
                  <td class="p-6 font-mono text-gray-500 text-[10px]">
                    {u.phone ?? '—'}
                  </td>
                  <td class="p-6">
                    {u.roleNames.length === 0 ? (
                      <span class="text-[10px] text-gray-500 italic font-medium">No roles</span>
                    ) : (
                      <div class="flex flex-wrap gap-1.5">
                        {u.roleNames.map((name) => (
                          <form method="POST" class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[9px] font-black uppercase tracking-wider border bg-gray-100 text-gray-600 border-gray-200">
                            <input type="hidden" name="action" value="revoke-role" />
                            <input type="hidden" name="id" value={u.id} />
                            <input type="hidden" name="roleName" value={name} />
                            <span>{name}</span>
                            <button type="submit" class="text-gray-600 hover:text-red-700" aria-label={`Revoke ${name}`} title={`Revoke ${name}`} data-confirm={`Revoke ${name} from this account? It stops applying on their next request.`}>&times;</button>
                          </form>
                        ))}
                      </div>
                    )}
                    <form method="POST" class="mt-2 flex items-center gap-1">
                      <input type="hidden" name="action" value="assign-role" />
                      <input type="hidden" name="id" value={u.id} />
                      <select name="roleName" aria-label={`Assign a role to ${u.email}`} class="rounded border border-gray-200 bg-gray-50 px-2 py-1 text-[10px] font-bold max-w-[16rem]">
                        {roleOptions.filter((r) => !u.roleNames.includes(r.name)).map((r) => (
                          <option value={r.name}>{optionLabel(r)}</option>
                        ))}
                      </select>
                      <button type="submit" class="text-[10px] font-black uppercase tracking-widest text-gray-500 hover:text-gray-900">Assign</button>
                    </form>
                  </td>
                  <td class="p-6 text-center">
                    <span class={`inline-block px-2.5 py-0.5 rounded font-black text-[9px] uppercase tracking-wide border ${
                      u.isActive ? 'bg-green-50 text-green-700 border-green-100' : 'bg-red-50 text-red-700 border-red-100'
                    }`}>
                      {u.isActive ? 'Active' : 'Disabled'}
                    </span>
                    <form method="POST" class="mt-2 flex flex-col items-center gap-1">
                      <input type="hidden" name="action" value="set-active" />
                      <input type="hidden" name="id" value={u.id} />
                      <input type="hidden" name="active" value={u.isActive ? 'false' : 'true'} />
                      {u.isActive && <input name="reason" required minlength="5" maxlength="300" placeholder="Reason (required, audited)" class="w-40 rounded border px-2 py-1 text-[10px]" />}
                      <button type="submit" class="text-[10px] font-black uppercase tracking-widest text-gray-500 hover:text-gray-900" data-confirm={u.isActive ? 'Deactivate this account? Their sessions end immediately.' : undefined}>{u.isActive ? 'Deactivate' : 'Reactivate'}</button>
                    </form>
                    <a href={`/admin/audit?entity=user&entityId=${encodeURIComponent(u.id)}`} class="mt-1 inline-block text-[10px] font-bold text-gray-500 hover:text-gray-800 underline underline-offset-2">History</a>
                  </td>
                  <td class="p-6 text-right font-mono text-gray-500 text-[10px]">
                    {new Date(u.createdAt).toLocaleDateString('en-GB', { timeZone: 'Africa/Kampala' })}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    ) : null}
  </div>

    <section class="mt-8 rounded-2xl border border-slate-200 bg-white p-5">
      <h2 class="text-sm font-black uppercase tracking-widest text-slate-500">Create administrator or reviewer</h2>
      <p class="mt-1 text-xs text-slate-500">PLATFORM_ADMINISTRATOR is never granted in one step — it becomes a request a different administrator must approve below. Initial password: min 12 chars; share it out-of-band; the user should change it at first login.</p>
      {umNotice && <div class={`mt-3 rounded-xl px-4 py-3 text-sm font-semibold ${umNotice.kind === "success" ? "bg-emerald-50 text-emerald-800" : "bg-rose-50 text-rose-800"}`}>{umNotice.text}</div>}
      <form method="POST" class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-5">
        <input type="hidden" name="action" value="create-user" />
        <input name="email" type="email" required placeholder="email@shopgoldplus.com" class="sm:col-span-2 rounded-xl border border-gray-200 bg-gray-50 px-3 py-2.5 text-xs font-medium outline-none focus:border-brand-primaryInk" />
        <input name="initialPassword" type="password" required minlength="12" placeholder="Initial password (min 12)" autocomplete="new-password" class="rounded-xl border border-gray-200 bg-gray-50 px-3 py-2.5 text-xs font-medium outline-none focus:border-brand-primaryInk" />
        <select name="roleName" aria-label="Governance role for the new user" class="rounded-xl border border-gray-200 bg-gray-50 px-3 py-2.5 text-xs font-bold outline-none">
          {roleOptions.map((r) => (
            <option value={r.name}>{optionLabel(r)}</option>
          ))}
        </select>
        <button type="submit" class="rounded-xl bg-brand-dark px-4 py-2.5 text-xs font-black uppercase tracking-wide text-white hover:bg-black">Create user</button>
      </form>
    </section>

    <section class="mt-6 rounded-2xl border border-slate-200 bg-white p-5">
      <h2 class="text-sm font-black uppercase tracking-widest text-slate-500">Full-admin grant requests (maker/checker)</h2>
      {grantRequests.length === 0 ? (
        <p class="mt-3 text-sm font-medium text-slate-500">No grant requests — truthfully empty.</p>
      ) : (
        <div class="mt-3 space-y-2">
          {grantRequests.map((r: any) => (
            <div class="flex flex-wrap items-center gap-3 rounded-xl border border-slate-200 p-3 text-xs">
              <span class="font-mono">{r.userId.slice(0,8)}…</span>
              <span class="font-black">{r.roleName}</span>
              <span class={`rounded-full border px-2 py-0.5 font-black uppercase ${r.status === "PENDING" ? "border-amber-300 bg-amber-50 text-amber-800" : r.status === "APPROVED" ? "border-emerald-300 bg-emerald-50 text-emerald-800" : "border-gray-200 bg-gray-100 text-gray-600"}`}>{r.status}</span>
              {r.status === "PENDING" && (
                <form method="POST" class="ml-auto flex items-center gap-2">
                  <input type="hidden" name="action" value="decide-grant" />
                  <input type="hidden" name="id" value={r.id} />
                  <select name="decision" aria-label="Decision on this role grant request" class="rounded-lg border border-gray-200 bg-gray-50 px-2 py-1.5 text-[11px] font-bold outline-none"><option value="APPROVED">APPROVE</option><option value="REJECTED">REJECT</option></select>
                  <button type="submit" class="rounded-lg border border-gray-300 bg-white px-3 py-1.5 text-[10px] font-black uppercase tracking-widest text-gray-700 hover:bg-gray-50">Decide</button>
                </form>
              )}
            </div>
          ))}
        </div>
      )}
      <p class="mt-3 text-[11px] text-slate-500">The requester can never approve their own request — a different administrator must decide.</p>
    </section>

</AdminLayout>

