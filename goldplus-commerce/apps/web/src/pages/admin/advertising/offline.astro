---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import AdCapabilityForm from "../../../components/admin/AdCapabilityForm.astro";
import { readSessionToken } from "../../../lib/session";
import { advertisingApi, saveCapabilityFromForm, PLATFORM_NAME, whenKampala, fmtInt } from "../../../lib/adminAdvertising";

/**
 * Offline conversions (0154): pay-on-delivery orders confirmed on delivery,
 * and phone or WhatsApp sales recorded here, sent to each LIVE platform's
 * offline conversions API. A COD order whose online purchase already reached
 * a platform is not sent again (shown as "Duplicate of online purchase").
 */
const token = readSessionToken(Astro.request);
if (!token) return Astro.redirect("/admin/login?returnTo=/admin/advertising/offline", 303);

let notice: string | null = null;
let formError: string | null = null;
if (Astro.request.method === "POST") {
  const f = await Astro.request.formData();
  const intent = String(f.get("intent") ?? "");
  if (intent.startsWith("capability-")) {
    const r = await saveCapabilityFromForm(token, f);
    if (r.ok) notice = "Saved."; else formError = r.message;
  } else if (intent === "record-sale") {
    const day = String(f.get("date") ?? "");
    const time = String(f.get("time") ?? "12:00");
    // The admin enters Kampala time (UTC+3, no daylight saving).
    const occurredAt = day ? new Date(`${day}T${time || "12:00"}:00+03:00`).toISOString() : "";
    const r = await advertisingApi(token, "POST", "/offline/sales", {
      channel: String(f.get("channel") ?? ""), occurredAt, valueUgx: Number(String(f.get("valueUgx") ?? "").replace(/[,\s]/g, "")),
      orderNumber: String(f.get("orderNumber") ?? "").trim() || null, email: String(f.get("email") ?? "").trim() || null,
      phone: String(f.get("phone") ?? "").trim() || null, note: String(f.get("note") ?? "").trim() || null,
    });
    if (r.ok) notice = "Sale recorded. It is sent to each platform whose offline conversions are live, within 5 minutes."; else formError = r.message;
  }
}

const res = await advertisingApi(token, "GET", "/offline");
const data: any = res.ok ? res.data : null;
const STATE_LABEL: Record<string, string> = {
  PENDING: "Waiting to send", SENT: "Sent", DUPLICATE_ONLINE: "Duplicate of online purchase (not sent)", SUPPRESSED: "Customer refused advertising (not sent)",
  FAILED: "Refused by the platform", SKIPPED: "Not sent", EXPIRED: "Too old for the platform",
};
const today = new Date(Date.now() + 3 * 3600_000).toISOString().slice(0, 10);
---
<AdminLayout title="Offline sales for ads" description="COD deliveries and phone/WhatsApp sales sent to Google Ads, Meta and TikTok as offline conversions.">
  <div class="container mx-auto px-6 lg:px-8 max-w-5xl">
    <p class="text-sm mb-2"><a class="underline" href="/admin/advertising">Advertising</a> / Offline sales</p>
    <h2 class="text-2xl font-black text-brand-dark tracking-tight mb-2">Offline sales</h2>
    <p class="text-sm text-gray-600 mb-6 max-w-3xl">Ad platforms can only learn from sales they hear about. Pay-on-delivery orders are reported when the rider confirms delivery; phone and WhatsApp sales are reported when you record them below. The customer's phone or email is hashed at once and never stored in plain text here. A customer who refused advertising is never sent.</p>
    {notice && <div role="status" class="mb-6 rounded-xl border border-emerald-300 bg-emerald-50 p-4 text-sm text-emerald-900">{notice}</div>}
    {formError && <div role="alert" class="mb-6 rounded-xl border border-red-300 bg-red-50 p-4 text-sm text-red-900">{formError}</div>}

    <section class="mb-10 rounded-2xl border border-gray-200 bg-white p-5" aria-labelledby="rec-sale">
      <h3 id="rec-sale" class="text-lg font-black text-brand-dark mb-3">Record a phone or WhatsApp sale</h3>
      <form method="POST" class="grid gap-3 sm:grid-cols-2">
        <input type="hidden" name="intent" value="record-sale" />
        <fieldset class="text-xs font-bold text-gray-700 sm:col-span-2"><legend>How the customer bought</legend>
          <div class="mt-1 flex gap-6 font-normal">
            <label class="inline-flex min-h-11 items-center gap-2"><input type="radio" name="channel" value="PHONE" required class="h-5 w-5" />Phone call</label>
            <label class="inline-flex min-h-11 items-center gap-2"><input type="radio" name="channel" value="WHATSAPP" class="h-5 w-5" />WhatsApp</label>
          </div>
        </fieldset>
        <label class="text-xs font-bold text-gray-700">Date<input type="date" name="date" required max={today} value={today} class="mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm font-normal" /></label>
        <label class="text-xs font-bold text-gray-700">Time (Kampala)<input type="time" name="time" value="12:00" class="mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm font-normal" /></label>
        <label class="text-xs font-bold text-gray-700">Sale value (UGX)<input name="valueUgx" inputmode="numeric" required autocomplete="off" class="mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm font-normal" /></label>
        <label class="text-xs font-bold text-gray-700">Order number (if it has one)<input name="orderNumber" autocomplete="off" class="mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm font-normal" /></label>
        <label class="text-xs font-bold text-gray-700">Customer phone<input name="phone" type="tel" autocomplete="off" class="mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm font-normal" /></label>
        <label class="text-xs font-bold text-gray-700">Customer email<input name="email" type="email" autocomplete="off" class="mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm font-normal" /></label>
        <label class="text-xs font-bold text-gray-700 sm:col-span-2">Note (optional, kept here only)<input name="note" maxlength="300" autocomplete="off" class="mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm font-normal" /></label>
        <p class="text-xs text-gray-500 sm:col-span-2">A phone, an email or an order number is needed: without one, no platform can match the sale.</p>
        <div class="sm:col-span-2"><button class="inline-flex min-h-11 items-center rounded-full bg-brand-dark px-5 text-sm font-bold text-white">Record sale</button></div>
      </form>
    </section>

    {!res.ok ? <p role="alert" class="rounded-xl border border-red-300 bg-red-50 p-4 text-sm text-red-900">{res.message}</p> : (
      <>
        <h3 class="text-lg font-black text-brand-dark mb-3">Platforms</h3>
        <div class="grid gap-5 mb-10">{(data.capabilities ?? []).map((cap: any) => <AdCapabilityForm cap={cap} />)}</div>

        <h3 class="text-lg font-black text-brand-dark mb-3">Conversions</h3>
        {Object.keys(data.counts ?? {}).length > 0 && <p class="text-sm mb-3">{Object.entries(data.counts).map(([k, v]) => `${STATE_LABEL[k] ?? k}: ${v}`).join(" · ")}</p>}
        {(data.conversions ?? []).length === 0 ? <p class="text-sm text-gray-600 mb-10">No data: nothing has been queued yet. Rows appear once a platform's offline conversions are live and a COD order is delivered or a sale is recorded.</p> : (
          <div class="overflow-x-auto rounded-xl border border-gray-200 bg-white mb-10">
            <table class="min-w-full text-sm">
              <caption class="sr-only">Offline conversions, newest first</caption>
              <thead class="bg-gray-50 text-left text-xs uppercase text-gray-600"><tr><th class="px-3 py-2">When</th><th class="px-3 py-2">Platform</th><th class="px-3 py-2">Source</th><th class="px-3 py-2">State</th><th class="px-3 py-2">Detail</th></tr></thead>
              <tbody>{data.conversions.map((c: any) => (
                <tr class="border-t border-gray-100"><td class="px-3 py-2 whitespace-nowrap">{whenKampala(c.occurredAt)}</td><td class="px-3 py-2">{PLATFORM_NAME[c.platform] ?? c.platform}</td><td class="px-3 py-2">{c.source === "COD_DELIVERED" ? "COD delivered" : "Recorded sale"}</td><td class="px-3 py-2 font-bold">{STATE_LABEL[c.state] ?? c.state}</td><td class="px-3 py-2 text-gray-600">{c.reason ?? (c.sentAt ? `sent ${whenKampala(c.sentAt)}` : "")}</td></tr>
              ))}</tbody>
            </table>
          </div>
        )}

        <h3 class="text-lg font-black text-brand-dark mb-3">Recorded sales</h3>
        {(data.sales ?? []).length === 0 ? <p class="text-sm text-gray-600 mb-12">No data: no sale has been recorded.</p> : (
          <ul class="text-sm space-y-1 mb-12">{data.sales.map((s: any) => <li>{whenKampala(s.occurredAt)} · {s.channel === "WHATSAPP" ? "WhatsApp" : "Phone"} · UGX {fmtInt(s.valueUgx)}{s.orderNumber ? ` · ${s.orderNumber}` : ""} · {s.hasPhone ? "phone" : ""}{s.hasPhone && s.hasEmail ? " + " : ""}{s.hasEmail ? "email" : ""}{s.note ? ` · ${s.note}` : ""}</li>)}</ul>
        )}
      </>
    )}
  </div>
</AdminLayout>
