---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { readSessionToken } from "../../../lib/session";

const token = readSessionToken(Astro.request);
if (!token) {
  return Astro.redirect("/admin/login?returnTo=/admin/reports", 303);
}
---

<AdminLayout 
  title="Business Intelligence" 
  description="Simulated analytical performance streams."
>
  <div class="container mx-auto px-6 lg:px-8 max-w-7xl">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between mb-8 gap-4 pb-6 border-b border-gray-200">
      <div>
        <h2 class="text-2xl font-black text-brand-dark tracking-tight">Reports & Dashboards</h2>
        <p class="text-sm text-gray-500 mt-1">Comprehensive physical and financial metrics analysis.</p>
      </div>
    </div>

    <div class="bg-yellow-50 border border-yellow-200 rounded-2xl p-12 text-center max-w-2xl">
      <h3 class="text-base font-black text-yellow-800 uppercase tracking-wider">API Connection Required</h3>
      <p class="text-xs text-yellow-700 leading-relaxed mt-2 max-w-md mx-auto">
        This analytical reporting suite requires live timeseries DB connections that are planned for Phase 2 deployment. Relational operational counts are currently visible on the Control Centre overview.
      </p>
    </div>
  </div>
</AdminLayout>

