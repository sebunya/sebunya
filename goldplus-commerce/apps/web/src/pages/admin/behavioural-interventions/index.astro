---
import AdminLayout from '../../../layouts/AdminLayout.astro'; import { apiBase } from '../../../lib/api'; import { readSessionToken } from '../../../lib/session';
const token = readSessionToken(Astro.request); if (!token) return Astro.redirect('/admin/login?returnTo=/admin/behavioural-interventions', 303); const headers = { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' }; let notice = '';
if (Astro.request.method === 'POST') { const form = await Astro.request.formData(); try { const response = await fetch(`${apiBase}/admin/behavioural-interventions`, { method: 'POST', headers, body: JSON.stringify({ key: form.get('key'), name: form.get('name'), targetBehaviour: form.get('targetBehaviour'), experimentId: form.get('experimentId'), experimentVariantKey: form.get('experimentVariantKey'), channel: 'ON_SITE', placement: form.get('placement'), audience: { lifecycleStages: String(form.get('lifecycleStages') ?? '').split(',').map((value) => value.trim()).filter(Boolean) }, content: { title: form.get('title'), body: form.get('body'), ctaLabel: form.get('ctaLabel'), ctaPath: form.get('ctaPath'), disclosure: form.get('disclosure'), dismissible: true }, suppression: { maxImpressions: Number(form.get('maxImpressions')), windowHours: Number(form.get('windowHours')), suppressAfterDismissal: true } }) }); const body = await response.json().catch(() => null); notice = body?.success ? 'Immutable ethical intervention draft created.' : body?.error?.message ?? 'Creation failed.'; } catch { notice = 'Intervention creation failed.'; } }
let rows: any[] = []; let denied = false; let failed = false; try { const response = await fetch(`${apiBase}/admin/behavioural-interventions`, { headers }); denied = response.status === 403; const body = await response.json().catch(() => null); rows = body?.success ? body.data : []; failed = !body?.success && !denied; } catch { failed = true; }
---
<AdminLayout title="Behavioral Interventions" description="Ethical on-site interventions tied to real experiments and measured outcomes."><div class="container mx-auto px-6 max-w-7xl"><h2 class="text-2xl font-black">Behavioral Interventions control room</h2><p class="text-sm text-gray-500 mb-6">ON_SITE only. Every intervention is truthful, dismissible, consent-gated, frequency-capped and linked to a real experiment treatment variant. No provider or outbox delivery.</p>{notice && <div class="border rounded-xl p-3 mb-4">{notice}</div>}{denied && <div class="bg-red-50 text-red-800 p-4 rounded-xl">Permission denied: interventions.read required.</div>}{failed && <div class="bg-red-50 text-red-800 p-4 rounded-xl">Unavailable — persisted intervention state could not be loaded.</div>}{!denied && <div class="grid xl:grid-cols-[1fr_2fr] gap-6"><form method="POST" class="bg-white border rounded-2xl p-5 space-y-3"><h3 class="font-black">Create immutable draft</h3><input name="key" required pattern="[a-z][a-z0-9_-]{2,79}" placeholder="guided_product_discovery" class="w-full border rounded p-2"/><input name="name" required placeholder="Intervention name" class="w-full border rounded p-2"/><select name="targetBehaviour" class="w-full border rounded p-2"><option>PRODUCT_DISCOVERY</option><option>PRODUCT_EDUCATION</option><option>FEEDBACK_COMPLETION</option><option>CHECKOUT_COMPLETION</option></select><input name="experimentId" required placeholder="READY or RUNNING experiment UUID" class="w-full border rounded p-2"/><input name="experimentVariantKey" required placeholder="Treatment variant key" class="w-full border rounded p-2"/><input name="placement" required value="ACCOUNT_GUIDANCE" class="w-full border rounded p-2"/><input name="lifecycleStages" placeholder="ACTIVE,LAPSED" class="w-full border rounded p-2"/><input name="title" required placeholder="Truthful title" class="w-full border rounded p-2"/><textarea name="body" required placeholder="Factual, non-coercive guidance" class="w-full border rounded p-2"></textarea><input name="ctaLabel" required placeholder="Learn more" class="w-full border rounded p-2"/><input name="ctaPath" required value="/products" class="w-full border rounded p-2"/><input name="disclosure" required placeholder="Why this guidance is shown" class="w-full border rounded p-2"/><div class="grid grid-cols-2 gap-2"><input name="maxImpressions" type="number" min="1" max="20" value="2" class="border rounded p-2"/><input name="windowHours" type="number" min="1" max="720" value="168" class="border rounded p-2"/></div><button class="bg-brand-gold font-black rounded px-4 py-2">Create draft</button><p class="text-xs text-gray-500">Requires interventions.create. Urgency, fake scarcity, coercion and transactional CTA paths fail closed.</p></form><section><h3 class="font-black mb-3">Persisted interventions</h3>{rows.length === 0 && !failed && <div class="bg-white border rounded-2xl p-8 text-center text-gray-500">Empty — no interventions exist.</div>}<div class="space-y-3">{rows.map((item) => <a href={`/admin/behavioural-interventions/${item.id}`} class="block bg-white border rounded-2xl p-5"><div class="flex justify-between"><div><strong>{item.name}</strong><div class="text-xs text-gray-500">{item.key} · {item.exposures} exposures · {item.outcomes} outcomes · v{item.version}</div></div><span class="bg-slate-100 rounded px-2 py-1 text-xs font-bold">{item.status}</span></div></a>)}</div></section></div>}<div class="flex flex-wrap gap-2 mt-8">{['DRAFT','PENDING_APPROVAL','APPROVED','ACTIVE','PAUSED','COMPLETED','REJECTED','Permission denied','Unavailable','Empty','Stale conflict','SUPPRESSED','EXPERIMENT_NOT_RUNNING'].map((state) => <span class="bg-slate-100 rounded px-2 py-1 text-xs">{state}</span>)}</div></div></AdminLayout>
