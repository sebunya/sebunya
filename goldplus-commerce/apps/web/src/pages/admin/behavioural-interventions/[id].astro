---
import AdminLayout from '../../../layouts/AdminLayout.astro'; import { apiBase } from '../../../lib/api'; import { readSessionToken } from '../../../lib/session';
const token = readSessionToken(Astro.request); const id = Astro.params.id!; if (!token) return Astro.redirect(`/admin/login?returnTo=/admin/behavioural-interventions/${id}`, 303); const headers = { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' }; let notice = '';
if (Astro.request.method === 'POST') { const form = await Astro.request.formData(); const operation = String(form.get('operation')); const response = await fetch(`${apiBase}/admin/behavioural-interventions/${id}/${operation}`, { method: 'POST', headers, body: JSON.stringify({ expectedVersion: Number(form.get('expectedVersion')), reason: form.get('reason'), ...(operation === 'approve' ? { decision: form.get('decision') } : {}) }) }); const body = await response.json().catch(() => null); notice = response.status === 409 ? `Stale conflict: ${body?.error?.message ?? ''}` : body?.success ? `${operation} recorded.` : body?.error?.message ?? 'Operation failed.'; }
let detail: any = null; let denied = false; let failed = false; try { const response = await fetch(`${apiBase}/admin/behavioural-interventions/${id}`, { headers }); denied = response.status === 403; const body = await response.json().catch(() => null); detail = body?.success ? body.data : null; failed = !detail && !denied; } catch { failed = true; }
---
<AdminLayout title="Intervention detail" description="Immutable ethics, audience, experiment, suppression and outcome evidence."><div class="container mx-auto px-6 max-w-7xl">{notice && <div class="border rounded-xl p-3 mb-4">{notice}</div>}{denied && <div class="bg-red-50 text-red-800 p-4 rounded-xl">Permission denied: interventions.read required.</div>}{failed && <div class="bg-red-50 text-red-800 p-4 rounded-xl">Unavailable — persisted intervention evidence could not be loaded.</div>}{detail && <><a href="/admin/behavioural-interventions" class="text-sm">← Behavioral Interventions</a><section class="bg-white border rounded-2xl p-6 mt-4"><div class="flex justify-between"><div><h2 class="text-2xl font-black">{detail.version.name}</h2><p class="text-xs text-gray-500">{detail.definition.key} · {detail.version.targetBehaviour} · v{detail.definition.version}</p></div><strong>{detail.definition.status}</strong></div><p class="mt-3"><strong>Hypothesis:</strong> {detail.version.hypothesis}</p><p><strong>Primary metric:</strong> {detail.version.primaryMetric}</p><p class="text-xs mt-3">Experiment {detail.version.experimentId}/{detail.version.experimentVariantKey} · ON_SITE/{detail.version.placement} · audience {detail.version.audience.lifecycleStages.join(', ') || 'all eligible'} · cap {detail.version.suppression.maxImpressions}/{detail.version.suppression.windowHours}h · dismissible and consent-gated.</p></section>
{detail.definition.status === 'DRAFT' && <form method="POST" class="mt-4"><input type="hidden" name="operation" value="submit"/><input type="hidden" name="expectedVersion" value={detail.definition.version}/><input name="reason" required minlength="3" placeholder="Submission reason" class="border rounded p-2"/><button class="border rounded p-2 ml-2 font-black">Submit for approval</button></form>}{detail.definition.status === 'PENDING_APPROVAL' && <form method="POST" class="mt-4"><input type="hidden" name="operation" value="approve"/><input type="hidden" name="expectedVersion" value={detail.definition.version}/><select name="decision" class="border rounded p-2"><option>APPROVED</option><option>REJECTED</option></select><input name="reason" required minlength="3" placeholder="Independent decision reason" class="border rounded p-2 ml-2"/><button class="bg-brand-gold rounded p-2 ml-2 font-black">Record decision</button></form>}{['APPROVED','PAUSED'].includes(detail.definition.status) && <form method="POST" class="mt-4"><input type="hidden" name="operation" value="activate"/><input type="hidden" name="expectedVersion" value={detail.definition.version}/><input name="reason" required minlength="3" placeholder="Activation reason" class="border rounded p-2"/><button class="border rounded p-2 ml-2 font-black">Activate with running experiment</button></form>}{detail.definition.status === 'ACTIVE' && <form method="POST" class="mt-4"><input type="hidden" name="operation" value="pause"/><input type="hidden" name="expectedVersion" value={detail.definition.version}/><input name="reason" required minlength="3" placeholder="Pause reason" class="border rounded p-2"/><button class="border rounded p-2 ml-2 font-black">Pause</button></form>}{['ACTIVE','PAUSED'].includes(detail.definition.status) && <form method="POST" class="mt-4"><input type="hidden" name="operation" value="complete"/><input type="hidden" name="expectedVersion" value={detail.definition.version}/><input name="reason" required minlength="3" placeholder="Completion reason" class="border rounded p-2"/><button class="border rounded p-2 ml-2 font-black">Complete</button></form>}
<div class="grid md:grid-cols-2 gap-5 mt-5"><section class="bg-white border rounded-2xl p-5"><h3 class="font-black">Truthful content</h3><h4 class="font-bold mt-3">{detail.version.content.title}</h4><p>{detail.version.content.body}</p><p class="mt-2">CTA: {detail.version.content.ctaLabel} → {detail.version.content.ctaPath}</p><p class="text-xs mt-2">Disclosure: {detail.version.content.disclosure}</p></section><section class="bg-white border rounded-2xl p-5"><h3 class="font-black">Persisted measurement</h3><dl><dt>Exposures</dt><dd>{detail.measurement.exposures}</dd><dt>Engaged</dt><dd>{detail.measurement.engaged}</dd><dt>Dismissed</dt><dd>{detail.measurement.dismissed}</dd><dt>Target achieved</dt><dd>{detail.measurement.targetAchieved}</dd></dl><p class="text-xs mt-2">No fake conversion rate or statistical claim is calculated.</p></section></div><section class="bg-white border rounded-2xl p-5 mt-5"><h3 class="font-black">Immutable governance events</h3>{detail.events.map((event) => <div class="border-t py-2 text-xs"><strong>{event.action}</strong> · {event.reason}</div>)}</section></>}</div></AdminLayout>
