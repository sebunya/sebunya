---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import StatusBadge from '../../../components/StatusBadge.astro';
import EmptyState from '../../../components/EmptyState.astro';
import Notice from '../../../components/Notice.astro';
import { tryFetchAdminList } from '../../../lib/api';
import { readSessionToken } from '../../../lib/session';
import { type SampleSupportTicket } from '../../../lib/sample-data';

const token = readSessionToken(Astro.request);
if (!token) {
  return Astro.redirect("/admin/login?returnTo=/admin/support", 303);
}

// Slice 11: inbox actions — status transitions and assignment via the audited PATCH.
import { apiBase } from '../../../lib/api';
let actionNotice: { kind: 'success' | 'error'; text: string } | null = null;
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const id = String(form.get('id') || '');
  const patch: Record<string, unknown> = {};
  const status = String(form.get('status') || '');
  const assignedTo = String(form.get('assignedTo') || '').trim();
  if (status) patch.status = status;
  if (form.has('assignedTo')) patch.assignedTo = assignedTo || null;
  try {
    const res = await fetch(`${apiBase}/governance/admin/support/${encodeURIComponent(id)}`, {
      method: 'PATCH',
      headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' },
      body: JSON.stringify(patch),
    });
    const json = await res.json().catch(() => null);
    actionNotice = json?.success
      ? { kind: 'success', text: `Ticket updated: ${json.data.status}${json.data.assignedTo ? ` · assigned to ${json.data.assignedTo}` : ''}.` }
      : { kind: 'error', text: json?.error?.message || 'Could not update the ticket.' };
  } catch {
    actionNotice = { kind: 'error', text: 'Support service is unreachable right now.' };
  }
}

type InboxTicket = SampleSupportTicket & {
  assignedTo?: string | null;
  sla?: { dueAt: string; overdue: boolean; hoursRemaining: number };
};

const result = await tryFetchAdminList<InboxTicket>(
  '/governance/admin/support',
  [],
  'Live support tickets are unavailable right now (service unreachable or permission denied). No sample data is shown.',
  token,
);

const statusBadge: Record<SampleSupportTicket['status'], 'pending' | 'warning' | 'success' | 'neutral'> = {
  open: 'pending',
  'in-progress': 'warning',
  resolved: 'success',
  closed: 'neutral',
};

const priorityBadge: Record<SampleSupportTicket['priority'], 'neutral' | 'info' | 'warning' | 'danger'> = {
  low: 'neutral',
  medium: 'info',
  high: 'warning',
  urgent: 'danger',
};

const typeLabel: Record<SampleSupportTicket['type'], string> = {
  issue: 'Issue',
  fake_report: 'Fake report',
  inquiry: 'Inquiry',
};
---

<AdminLayout 
  title="Support Tickets" 
  description="Assist users with technical difficulties and support cases."
>
  <div class="container mx-auto px-6 lg:px-8 max-w-7xl">
    
    <div class="flex flex-col sm:flex-row sm:items-center justify-between mb-8 gap-4 pb-6 border-b border-gray-200">
      <div>
        <h2 class="text-2xl font-black text-brand-dark tracking-tight">Customer Support</h2>
        <p class="text-sm text-gray-500 mt-1">Inspect customer reported technical issues and verified fake-product incident queues.</p>
      </div>
      <div class="flex items-center gap-2">
        <span class="bg-gray-100 text-gray-600 border border-gray-200 text-xs font-bold px-3 py-1.5 rounded-lg font-mono">
          CASES: {result.items.length}
        </span>
      </div>
    </div>

    {actionNotice && (
      <div class={`mb-6 rounded-xl border px-4 py-3 text-sm font-bold ${actionNotice.kind === 'success' ? 'border-green-200 bg-green-50 text-green-700' : 'border-red-200 bg-red-50 text-red-700'}`} role="status">
        {actionNotice.text}
      </div>
    )}

    {result.isSample && (
      <div class="bg-blue-50 border border-blue-200 text-blue-800 px-6 py-4 rounded-2xl mb-8 flex items-center gap-4">
        
        <div class="text-xs leading-relaxed"><strong>System note:</strong> {result.reason}</div>
      </div>
    )}

    {result.items.length === 0 ? (
      <EmptyState
        title="No support tickets yet"
        message="Reports submitted at /support/issue and /support/fake will appear here."
      />
    ) : (
      <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-gray-50 text-[10px] uppercase font-black text-gray-400 tracking-widest border-b border-gray-100">
                <th class="p-6">Topic / Subject</th>
                <th class="p-6">Type</th>
                <th class="p-6 text-center">Priority</th>
                <th class="p-6 text-center">State</th>
                <th class="p-6">Logged</th>
                <th class="p-6 text-center">SLA</th>
                <th class="p-6">Assigned</th>
                <th class="p-6 text-right">Actions</th>
              </tr>
            </thead>
            <tbody class="text-xs divide-y divide-gray-50">
              {result.items.map((t) => (
                <tr class="hover:bg-gray-50 transition-colors">
                  <td class="p-6 font-bold text-brand-dark text-sm">
                    {t.subject}
                  </td>
                  <td class="p-6 text-gray-600 font-medium uppercase tracking-wider text-[10px]">
                    {typeLabel[t.type]}
                  </td>
                  <td class="p-6 text-center">
                    <span class={`inline-block px-2 py-0.5 rounded text-[9px] font-black uppercase tracking-wide border ${
                      priorityBadge[t.priority] === 'danger' ? 'bg-red-50 text-red-700 border-red-100' :
                      priorityBadge[t.priority] === 'warning' ? 'bg-orange-50 text-orange-700 border-orange-100' :
                      priorityBadge[t.priority] === 'info' ? 'bg-blue-50 text-blue-700 border-blue-100' :
                      'bg-gray-50 text-gray-700 border-gray-100'
                    }`}>
                      {t.priority}
                    </span>
                  </td>
                  <td class="p-6 text-center">
                    <span class={`inline-block px-2 py-0.5 rounded text-[9px] font-black uppercase tracking-wide border ${
                      statusBadge[t.status] === 'success' ? 'bg-green-50 text-green-700 border-green-100' :
                      statusBadge[t.status] === 'warning' ? 'bg-yellow-50 text-yellow-700 border-yellow-100' :
                      statusBadge[t.status] === 'pending' ? 'bg-orange-50 text-orange-700 border-orange-100' :
                      'bg-gray-50 text-gray-700 border-gray-100'
                    }`}>
                      {t.status}
                    </span>
                  </td>
                  <td class="p-6 text-gray-500 font-medium">
                    {new Date(t.createdAt).toLocaleDateString('en-GB', { timeZone: 'Africa/Kampala',  day: '2-digit', month: 'short', year: 'numeric' })}
                  </td>
                  <td class="p-6 text-center">
                    {t.sla ? (
                      <span class={`inline-block px-2 py-0.5 rounded text-[9px] font-black uppercase tracking-wide border ${t.sla.overdue ? 'bg-red-50 text-red-700 border-red-200' : 'bg-green-50 text-green-700 border-green-100'}`}>
                        {t.sla.overdue ? 'Overdue' : `${Math.max(t.sla.hoursRemaining, 0)}h left`}
                      </span>
                    ) : '—'}
                  </td>
                  <td class="p-6 text-gray-600">{t.assignedTo ?? 'Unassigned'}</td>
                  <td class="p-6 text-right">
                    <form method="POST" class="inline-flex items-center gap-2">
                      <input type="hidden" name="id" value={t.id} />
                      <label class="sr-only" for={`status-${t.id}`}>Change status</label>
                      <select id={`status-${t.id}`} name="status" class="rounded-lg border border-gray-300 px-2 py-1.5 text-[10px] font-bold">
                        <option value="">Keep status</option>
                        {['open', 'in-progress', 'resolved', 'closed'].filter((st) => st !== t.status).map((st) => (
                          <option value={st}>{st}</option>
                        ))}
                      </select>
                      <label class="sr-only" for={`assign-${t.id}`}>Assign to</label>
                      <input id={`assign-${t.id}`} name="assignedTo" value={t.assignedTo ?? ''} placeholder="Assignee" maxlength="120" class="w-24 rounded-lg border border-gray-300 px-2 py-1.5 text-[10px]" />
                      <button type="submit" class="text-[10px] font-black uppercase tracking-widest text-brand-dark hover:text-brand-primary">Save</button>
                    </form>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    )}
  </div>
</AdminLayout>
