---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { readSessionToken } from "../../../lib/session";
import { apiBase } from "../../../lib/api";
import { formatUgx } from "../../../lib/money";

/**
 * Marketing mix modelling and incrementality (0203, 2026-10-23). What the page shows is what the data allows:
 * the readiness gate says in words why a model cannot be fitted yet (today: no paid spend has ever run), the
 * holdouts show the revenue the shop's own messages caused, and the GA4 check shows whether GA4 and the shop
 * agree. The model itself runs off the server (ops/mmm) on the exported dataset.
 */
const token = readSessionToken(Astro.request);
if (!token) return Astro.redirect("/admin/login?returnTo=/admin/measurement/mmm", 303);

async function call(method: string, path: string, body?: unknown) {
  try {
    const res = await fetch(`${apiBase}/admin/measurement/mmm${path}`, { method, headers: { Accept: "application/json", Authorization: `Bearer ${token}`, ...(body ? { "Content-Type": "application/json" } : {}) }, body: body ? JSON.stringify(body) : undefined, signal: AbortSignal.timeout(60_000) });
    const json = await res.json().catch(() => null);
    if (res.status === 401 || res.status === 403) return { ok: false as const, message: "Your account does not have the permission this needs." };
    return res.ok && json?.success ? { ok: true as const, data: json.data } : { ok: false as const, message: json?.error?.message ?? `The API declined the request (HTTP ${res.status}).` };
  } catch { return { ok: false as const, message: "Could not reach the API. Nothing is shown rather than old or invented figures." }; }
}

let notice: string | null = null;
let formError: string | null = null;
if (Astro.request.method === "POST") {
  const f = await Astro.request.formData();
  const action = String(f.get("action") ?? "");
  let r;
  if (action === "set") r = await call("PUT", `/settings/${encodeURIComponent(String(f.get("key") ?? ""))}`, { value: String(f.get("value") ?? "") });
  else if (action === "unset") r = await call("DELETE", `/settings/${encodeURIComponent(String(f.get("key") ?? ""))}`);
  else if (action === "control") r = await call("POST", "/controls", { day: String(f.get("day") ?? ""), key: String(f.get("key") ?? ""), value: Number(f.get("value")), note: String(f.get("note") ?? "") || null });
  else if (action === "run") r = await call("POST", "/run");
  else r = { ok: false as const, message: "Unknown action." };
  if (r.ok) notice = action === "run" ? `Nightly run: ${r.data.status}${r.data.stats ? ` (${Object.keys(r.data.stats).filter((k) => k !== "trigger").join(", ")})` : ""}.` : "Saved.";
  else formError = r.message;
}

const [status, settings, holdouts, recon, controls] = await Promise.all([call("GET", "/status"), call("GET", "/settings"), call("GET", "/holdouts"), call("GET", "/reconciliation"), call("GET", "/controls?days=30")]);
const readiness = status.ok ? status.data.readiness : null;
const pct = (v: number | null | undefined) => (v === null || v === undefined ? "–" : `${(v * 100).toFixed(1)}%`);
const labelOf: Record<string, string> = { review_reminder: "Review reminder", loyalty_mission: "Mission message", loyalty_expiry: "Points expiry warning", abandoned_basket: "Abandoned basket", campaign: "Campaign" };
const statusText: Record<string, string> = { ok: "Agree", alarm: "GA4 missing purchases", warn: "GA4 has extra purchases", no_identity: "Nothing sent (no browser identity)", unknown: "GA4 not readable" };
---
<AdminLayout title="Marketing mix and incrementality" description="Is a marketing mix model worth fitting yet, what the shop's own messages cause, and whether GA4 agrees with the shop.">
  <div class="container mx-auto px-4 lg:px-8 max-w-7xl">
    <h2 class="text-2xl font-black text-brand-dark tracking-tight mb-2">Marketing mix and incrementality</h2>
    <p class="text-sm text-gray-600 mb-6 max-w-3xl">Three honest answers. The model gate says whether a marketing mix model (Google Meridian or PyMC-Marketing, run off the server on the exported dataset) would learn anything from the data so far. The holdouts measure what the shop's own messages cause, by not sending to a small random share. The GA4 check compares what we sent GA4 with what GA4 kept.</p>

    {notice && <div role="status" class="mb-6 rounded-xl border border-emerald-300 bg-emerald-50 p-4 text-sm text-emerald-900">{notice}</div>}
    {formError && <div role="alert" class="mb-6 rounded-xl border border-red-300 bg-red-50 p-4 text-sm text-red-900">{formError}</div>}

    <section class="mb-8 rounded-2xl border border-gray-200 bg-white p-5">
      <h3 class="text-lg font-black text-brand-dark mb-1">Model readiness</h3>
      {!status.ok ? <p role="alert" class="text-sm text-red-900">{status.message}</p> : (
        <>
          <p class="text-sm text-gray-700 mb-3">
            {readiness.ok ? <span class="font-bold text-emerald-800">Ready to fit.</span> : <span class="font-bold text-amber-800">Not worth fitting yet.</span>}
            {" "}{readiness.stats.weeks} complete week{readiness.stats.weeks === 1 ? "" : "s"} of data{readiness.firstDay ? ` (${readiness.firstDay} to ${readiness.lastDay})` : ""}; mean {readiness.stats.meanWeeklyOrders.toFixed(1)} orders a week; media channels with spend: {readiness.stats.mediaChannels.length ? readiness.stats.mediaChannels.join(", ") : "none"}.
          </p>
          {readiness.reasons.length > 0 && <ul class="mb-3 list-disc pl-5 text-sm text-gray-800">{readiness.reasons.map((r: string) => <li>{r}</li>)}</ul>}
          <div class="flex flex-wrap items-center gap-3">
            <a href="/api/admin/measurement/mmm-export.zip" class="inline-flex min-h-11 items-center rounded-full border border-gray-300 px-5 text-sm font-bold text-brand-dark">Download dataset (daily.csv + controls.csv)</a>
            <form method="POST"><input type="hidden" name="action" value="run" /><button class="inline-flex min-h-11 items-center rounded-full bg-brand-dark px-5 text-sm font-bold text-white">Rebuild now</button></form>
            <span class="text-xs text-gray-600">Last nightly run: {status.data.nightly ? `${status.data.nightly.startedAt.slice(0, 16).replace("T", " ")} UTC, ${status.data.nightly.state}` : "never"}. Run it on the dataset with <code>python -m goldplus_mmm readiness</code> in <code>ops/mmm</code>.</span>
          </div>
        </>
      )}
    </section>

    <section class="mb-8 rounded-2xl border border-gray-200 bg-white p-5">
      <h3 class="text-lg font-black text-brand-dark mb-1">Holdouts: what our messages cause</h3>
      <p class="text-sm text-gray-600 mb-3">Each programme keeps a random share of its would-be recipients unmessaged for a calendar month. Buyers and revenue in the 14 and 28 days after are compared between the two arms. A lift is only called with at least 30 people in each arm and a p-value under 0.05.</p>
      {!holdouts.ok ? <p role="alert" class="text-sm text-red-900">{holdouts.message}</p> : holdouts.data.waves.length === 0 ? (
        <p class="text-sm text-gray-700">No wave has an outcome yet. Assignments so far: {holdouts.data.counts.length === 0 ? "none" : holdouts.data.counts.map((c: any) => `${labelOf[c.programme] ?? c.programme} ${c.waveKey}: ${c.treat} treated, ${c.hold} held`).join("; ")}.</p>
      ) : (
        <div class="overflow-x-auto"><table class="min-w-full text-sm">
          <thead><tr class="text-left text-xs font-bold uppercase tracking-wide text-gray-600"><th class="py-2 pr-4">Programme</th><th class="py-2 pr-4">Wave</th><th class="py-2 pr-4">Window</th><th class="py-2 pr-4">Treated</th><th class="py-2 pr-4">Held</th><th class="py-2 pr-4">Lift</th><th class="py-2 pr-4">Revenue caused</th><th class="py-2 pr-4">Verdict</th></tr></thead>
          <tbody>{holdouts.data.waves.map((w: any) => (
            <tr class="border-t border-gray-100">
              <td class="py-2 pr-4">{labelOf[w.programme] ?? w.programme}</td><td class="py-2 pr-4">{w.waveKey}{w.maturing ? " (still maturing)" : ""}</td><td class="py-2 pr-4">{w.windowDays} days</td>
              <td class="py-2 pr-4">{w.lift.treat.buyers} of {w.lift.treat.subjects} bought ({pct(w.lift.treat.conversion)})</td>
              <td class="py-2 pr-4">{w.lift.hold.buyers} of {w.lift.hold.subjects} bought ({pct(w.lift.hold.conversion)})</td>
              <td class="py-2 pr-4">{w.lift.status === "measured" ? `${(w.lift.conversionLift * 100).toFixed(1)} points${w.lift.relativeLift !== null ? ` (${(w.lift.relativeLift * 100).toFixed(0)}% relative)` : ""}` : "–"}</td>
              <td class="py-2 pr-4">{w.lift.status === "measured" ? formatUgx(w.lift.incrementalRevenueUGX) : "–"}</td>
              <td class="py-2 pr-4">{w.lift.status === "insufficient" ? w.lift.reason : w.lift.significant ? `Real (p = ${w.lift.pValue.toFixed(3)})` : `Not distinguishable from chance (p = ${w.lift.pValue.toFixed(3)})`}</td>
            </tr>))}</tbody>
        </table></div>
      )}
    </section>

    <section class="mb-8 rounded-2xl border border-gray-200 bg-white p-5">
      <h3 class="text-lg font-black text-brand-dark mb-1">GA4 against the shop</h3>
      {!recon.ok ? <p role="alert" class="text-sm text-red-900">{recon.message}</p> : (
        <>
          <p class="text-sm text-gray-700 mb-3">Last 30 days: {recon.data.coverage30d.confirmed} confirmed sales, {recon.data.coverage30d.sent} sent to GA4, {recon.data.coverage30d.noIdentity} never sent because the order had no browser identity{recon.data.coverage30d.noIdentity > 0 ? ' (switch "Send assisted orders to GA4" below to change that)' : ""}.</p>
          {recon.data.days.length === 0 ? <p class="text-sm text-gray-700">No check has run yet.</p> : (
            <div class="overflow-x-auto"><table class="min-w-full text-sm">
              <thead><tr class="text-left text-xs font-bold uppercase tracking-wide text-gray-600"><th class="py-2 pr-4">Day</th><th class="py-2 pr-4">Sent to GA4</th><th class="py-2 pr-4">GA4 reports</th><th class="py-2 pr-4">Difference</th><th class="py-2 pr-4">Status</th></tr></thead>
              <tbody>{recon.data.days.map((d: any) => (
                <tr class="border-t border-gray-100"><td class="py-2 pr-4">{d.day}</td><td class="py-2 pr-4">{d.sent}</td><td class="py-2 pr-4">{d.ga4Purchases ?? "–"}</td><td class="py-2 pr-4">{d.deltaPct === null ? "–" : `${d.deltaPct}%`}</td><td class={`py-2 pr-4 ${d.status === "alarm" ? "font-bold text-red-800" : ""}`}>{statusText[d.status] ?? d.status}{d.message ? ` — ${d.message}` : ""}</td></tr>))}</tbody>
            </table></div>
          )}
        </>
      )}
    </section>

    <section class="mb-8 rounded-2xl border border-gray-200 bg-white p-5">
      <h3 class="text-lg font-black text-brand-dark mb-1">Settings</h3>
      <p class="text-sm text-gray-600 mb-3">Holdout shares, the cost per message, the dollar rate, the GA4 tolerance and the assisted-orders switch. A blank value uses the documented default where one exists; otherwise blank means off.</p>
      {!settings.ok ? <p role="alert" class="text-sm text-red-900">{settings.message}</p> : (
        <div class="grid gap-3 md:grid-cols-2">{settings.data.entries.map((e: any) => (
          <form method="POST" class="rounded-xl border border-gray-200 p-3">
            <input type="hidden" name="key" value={e.key} />
            <label class="block text-xs font-bold text-gray-700">{e.label} <span class="font-normal text-gray-500">({e.unit}{e.defaultValue !== undefined ? `, default ${e.defaultValue}` : ", unset = off"})</span>
              <input name="value" value={e.value ?? ""} placeholder={e.defaultValue !== undefined ? String(e.defaultValue) : "off"} class="mt-1 block w-full min-h-11 rounded-lg border border-gray-300 px-3 text-sm font-normal" />
            </label>
            <p class="mt-1 text-xs text-gray-600">{e.help}</p>
            <div class="mt-2 flex gap-2">
              <button name="action" value="set" class="inline-flex min-h-11 items-center rounded-full bg-brand-dark px-4 text-sm font-bold text-white">Save</button>
              {e.set && <button name="action" value="unset" class="inline-flex min-h-11 items-center rounded-full border border-gray-300 px-4 text-sm font-bold text-brand-dark">Clear</button>}
            </div>
          </form>))}</div>
      )}
    </section>

    <section class="mb-8 rounded-2xl border border-gray-200 bg-white p-5">
      <h3 class="text-lg font-black text-brand-dark mb-1">Things that move sales and are not marketing</h3>
      <p class="text-sm text-gray-600 mb-3">Holidays and school terms come from the calendar; stock-outs and the mean price are measured every night. Type in what only a person knows: a mobile-money outage (momo_outage 1), a delivery-fee change (delivery_fee_index, e.g. 1.2 for 20% up), a promotion's depth (promo_depth, e.g. 0.1).</p>
      <form method="POST" class="mb-4 flex flex-wrap items-end gap-3">
        <input type="hidden" name="action" value="control" />
        <label class="text-xs font-bold text-gray-700">Day<input name="day" type="date" required class="mt-1 block min-h-11 rounded-lg border border-gray-300 px-3 text-sm font-normal" /></label>
        <label class="text-xs font-bold text-gray-700">Control<select name="key" class="mt-1 block min-h-11 rounded-lg border border-gray-300 px-3 text-sm font-normal">{(controls.ok ? controls.data.manualKeys : []).map((k: string) => <option value={k}>{k}</option>)}</select></label>
        <label class="text-xs font-bold text-gray-700">Value<input name="value" type="number" step="any" required class="mt-1 block min-h-11 w-28 rounded-lg border border-gray-300 px-3 text-sm font-normal" /></label>
        <label class="text-xs font-bold text-gray-700">Note<input name="note" maxlength="200" class="mt-1 block min-h-11 rounded-lg border border-gray-300 px-3 text-sm font-normal" /></label>
        <button class="inline-flex min-h-11 items-center rounded-full bg-brand-dark px-5 text-sm font-bold text-white">Record</button>
      </form>
      {controls.ok && controls.data.rows.length > 0 && (
        <div class="overflow-x-auto max-h-80"><table class="min-w-full text-sm">
          <thead><tr class="text-left text-xs font-bold uppercase tracking-wide text-gray-600"><th class="py-2 pr-4">Day</th><th class="py-2 pr-4">Control</th><th class="py-2 pr-4">Value</th><th class="py-2 pr-4">Source</th><th class="py-2 pr-4">Note</th></tr></thead>
          <tbody>{controls.data.rows.filter((r: any) => r.source !== "calendar" || r.value > 0).slice(0, 120).map((r: any) => <tr class="border-t border-gray-100"><td class="py-2 pr-4">{r.day}</td><td class="py-2 pr-4">{r.key}</td><td class="py-2 pr-4">{r.value}</td><td class="py-2 pr-4">{r.source}</td><td class="py-2 pr-4">{r.note ?? ""}</td></tr>)}</tbody>
        </table></div>
      )}
    </section>
  </div>
</AdminLayout>
