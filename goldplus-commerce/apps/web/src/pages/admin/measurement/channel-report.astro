---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { readSessionToken } from "../../../lib/session";
import { apiBase } from "../../../lib/api";
import { formatUgx } from "../../../lib/money";
import { CHANNEL_REPORT_MODELS, sparklinePoints, weekLabel, formatOrders } from "../../../lib/channelReport";

/**
 * Weekly channel report (attribution module, 0156): which channels brought
 * sales, what they cost and what they returned, under a chosen model. Sales
 * are read live; spend comes from the advertising module's media-cost table.
 * Nothing is filled in: no spend is "No spend data", no sale is "No data".
 */
const token = readSessionToken(Astro.request);
if (!token) {
  return Astro.redirect("/admin/login?returnTo=/admin/measurement/channel-report", 303);
}

const model = CHANNEL_REPORT_MODELS.some((m) => m.value === Astro.url.searchParams.get("model")) ? String(Astro.url.searchParams.get("model")) : "last_click";
const weeksParam = Number(Astro.url.searchParams.get("weeks"));
const weeks = [4, 8, 12, 26, 52].includes(weeksParam) ? weeksParam : 12;

async function call(method: string, path: string, body?: unknown) {
  try {
    const res = await fetch(`${apiBase}/admin/attribution${path}`, { method, headers: { Accept: "application/json", Authorization: `Bearer ${token}`, ...(body ? { "Content-Type": "application/json" } : {}) }, body: body ? JSON.stringify(body) : undefined, signal: AbortSignal.timeout(20_000) });
    const json = await res.json().catch(() => null);
    if (res.status === 401 || res.status === 403) return { ok: false as const, message: "Your account does not have the permission this needs." };
    return res.ok && json?.success ? { ok: true as const, data: json.data } : { ok: false as const, message: json?.error?.message ?? `The API declined the request (HTTP ${res.status}).` };
  } catch { return { ok: false as const, message: "Could not reach the API. No figures are shown rather than old or invented ones." }; }
}

let notice: string | null = null;
let formError: string | null = null;
if (Astro.request.method === "POST") {
  const f = await Astro.request.formData();
  const r = await call("POST", "/recompute", { reason: String(f.get("reason") ?? ""), days: 120 });
  if (r.ok) notice = `Recomputed ${r.data.orders} order${r.data.orders === 1 ? "" : "s"} from the last 120 days${r.data.failed ? `; ${r.data.failed} could not be computed` : ""}.`;
  else formError = r.message;
}

const result = await call("GET", `/channel-report?model=${encodeURIComponent(model)}&weeks=${weeks}`);
const report = result.ok ? result.data : null;
const noSpendText = report?.spendStatus === "NOT_AVAILABLE" ? "No spend data" : "No spend recorded";
const money = (v: string | null | undefined, empty: string) => (v === null || v === undefined ? empty : formatUgx(v));
const roasText = (v: number | null | undefined) => (v === null || v === undefined ? "No data" : `${v.toFixed(2)}×`);
const csvHref = `/api/admin/attribution/channel-report.csv?model=${encodeURIComponent(model)}&weeks=${weeks}`;
const current = CHANNEL_REPORT_MODELS.find((m) => m.value === model)!;
---
<AdminLayout title="Channel report" description="Weekly sales, spend and return by channel, with a model switcher and CSV export.">
  <div class="container mx-auto px-4 lg:px-8 max-w-7xl">
    <h2 class="text-2xl font-black text-brand-dark tracking-tight mb-2">Channel report</h2>
    <p class="text-sm text-gray-600 mb-6 max-w-3xl">Sales by the channel that brought them, week by week, next to what each channel cost. Visits are recorded server-side; each sale is matched to the same visitor's visits in the 30 days before it, plus any creator or promo code used and, when there is no recorded visit, what the customer told us. Observational, not proof that a channel caused a sale.</p>

    {notice && <div role="status" class="mb-6 rounded-xl border border-emerald-300 bg-emerald-50 p-4 text-sm text-emerald-900">{notice}</div>}
    {formError && <div role="alert" class="mb-6 rounded-xl border border-red-300 bg-red-50 p-4 text-sm text-red-900">{formError}</div>}

    <form method="GET" class="mb-6 flex flex-wrap items-end gap-3 rounded-2xl border border-gray-200 bg-white p-4">
      <label class="text-xs font-bold text-gray-700">Model
        <select name="model" class="mt-1 block min-h-11 rounded-lg border border-gray-300 px-3 text-sm font-normal">
          {CHANNEL_REPORT_MODELS.map((m) => <option value={m.value} selected={m.value === model}>{m.label}</option>)}
        </select>
      </label>
      <label class="text-xs font-bold text-gray-700">Weeks
        <select name="weeks" class="mt-1 block min-h-11 rounded-lg border border-gray-300 px-3 text-sm font-normal">
          {[4, 8, 12, 26, 52].map((w) => <option value={w} selected={w === weeks}>{w} weeks</option>)}
        </select>
      </label>
      <button class="inline-flex min-h-11 items-center rounded-full bg-brand-dark px-5 text-sm font-bold text-white">Show</button>
      <a href={csvHref} class="inline-flex min-h-11 items-center rounded-full border border-gray-300 px-5 text-sm font-bold text-brand-dark">Download CSV</a>
      <p class="basis-full text-xs text-gray-600">{current.help}</p>
    </form>

    {!result.ok ? <p role="alert" class="rounded-xl border border-red-300 bg-red-50 p-4 text-sm text-red-900">{result.message}</p> : (
      <>
        {report.spendStatus === "NOT_AVAILABLE" && (
          <div role="status" class="mb-6 rounded-xl border border-blue-300 bg-blue-50 p-4 text-sm text-blue-900">
            <strong>No spend data</strong> for these weeks, so return on ad spend and cost per order cannot be worked out. Spend appears here once it is imported on the <a class="underline" href="/admin/advertising">Advertising platforms</a> page (platform import or CSV).
            {report.spendExcludedCurrencies.length > 0 && <span> Spend held in {report.spendExcludedCurrencies.join(", ")} is not converted into UGX.</span>}
          </div>
        )}
        {report.spendStatus === "AVAILABLE" && report.spendExcludedCurrencies.length > 0 && (
          <p role="status" class="mb-6 rounded-xl border border-amber-300 bg-amber-50 p-4 text-sm text-amber-900">Spend in {report.spendExcludedCurrencies.join(", ")} is left out: a total across currencies is not a number.</p>
        )}

        {report.empty ? (
          <p class="rounded-2xl border border-dashed border-gray-300 bg-gray-50 p-8 text-sm text-gray-600">No data: no sale and no spend was recorded in the {weeks} weeks from {weekLabel(report.weeks[0])}.</p>
        ) : (
          <>
            <section aria-labelledby="totals-h" class="mb-6 grid gap-3 sm:grid-cols-4">
              <h3 id="totals-h" class="sr-only">Totals</h3>
              <div class="rounded-2xl border border-gray-200 bg-white p-4"><p class="text-xs font-bold uppercase tracking-wider text-gray-500">Sales</p><p class="text-xl font-black">{report.totals.orders}</p></div>
              <div class="rounded-2xl border border-gray-200 bg-white p-4"><p class="text-xs font-bold uppercase tracking-wider text-gray-500">Revenue (goods)</p><p class="text-xl font-black">{formatUgx(report.totals.revenueUGX)}</p></div>
              <div class="rounded-2xl border border-gray-200 bg-white p-4"><p class="text-xs font-bold uppercase tracking-wider text-gray-500">Spend</p><p class="text-xl font-black">{money(report.totals.spendUGX, "No spend data")}</p></div>
              <div class="rounded-2xl border border-gray-200 bg-white p-4"><p class="text-xs font-bold uppercase tracking-wider text-gray-500">Return on ad spend</p><p class="text-xl font-black">{roasText(report.totals.roas)}</p></div>
            </section>

            <section aria-labelledby="channels-h" class="mb-8 overflow-x-auto rounded-2xl border border-gray-200 bg-white">
              <h3 id="channels-h" class="px-4 pt-4 font-black text-brand-dark">By channel · {current.label}</h3>
              <table class="mt-2 w-full min-w-[760px] text-sm">
                <thead><tr class="border-b border-gray-100 text-left text-xs uppercase tracking-wider text-gray-500">
                  <th scope="col" class="px-4 py-2">Channel</th><th scope="col" class="px-4 py-2 text-right">Orders</th><th scope="col" class="px-4 py-2 text-right">Revenue</th>
                  <th scope="col" class="px-4 py-2 text-right">Spend</th><th scope="col" class="px-4 py-2 text-right">ROAS</th><th scope="col" class="px-4 py-2 text-right">Cost per order</th><th scope="col" class="px-4 py-2">Weekly revenue</th>
                </tr></thead>
                <tbody>
                  {report.channels.map((c: any) => {
                    const pts = sparklinePoints(c.trend.map((t: any) => Number(t.revenueUGX)), 120, 28);
                    return (
                      <tr class="border-t border-gray-100">
                        <th scope="row" class="px-4 py-2 text-left font-bold">{c.label}{c.declaredOrders > 0 && <span class="block text-xs font-normal text-gray-600">{formatOrders(c.declaredOrders)} from the customer's own answer</span>}</th>
                        <td class="px-4 py-2 text-right">{formatOrders(c.orders)}</td>
                        <td class="px-4 py-2 text-right">{formatUgx(c.revenueUGX)}</td>
                        <td class="px-4 py-2 text-right">{money(c.spendUGX, noSpendText)}</td>
                        <td class="px-4 py-2 text-right">{roasText(c.roas)}</td>
                        <td class="px-4 py-2 text-right">{money(c.costPerOrderUGX, "No data")}</td>
                        <td class="px-4 py-2">
                          {pts ? <svg viewBox="0 0 120 28" width="120" height="28" role="img" aria-label={`Weekly revenue for ${c.label}, ${report.weeks.length} weeks`} class="text-brand-dark"><polyline points={pts} fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" /></svg> : <span class="text-xs text-gray-500">No revenue</span>}
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
              <p class="px-4 pb-4 pt-2 text-xs text-gray-600">Orders are credited orders: a model that shares one sale across three channels gives each a part. Revenue is the goods, without the delivery fee. "No recorded source" is sales with no recorded visit, no code and no answer; they are not spread over the other channels.</p>
            </section>

            <section aria-labelledby="weeks-h" class="mb-8 overflow-x-auto rounded-2xl border border-gray-200 bg-white">
              <h3 id="weeks-h" class="px-4 pt-4 font-black text-brand-dark">Week by week</h3>
              <table class="mt-2 w-full min-w-[480px] text-sm">
                <thead><tr class="border-b border-gray-100 text-left text-xs uppercase tracking-wider text-gray-500"><th scope="col" class="px-4 py-2">Week of</th><th scope="col" class="px-4 py-2 text-right">Sales</th><th scope="col" class="px-4 py-2 text-right">Revenue</th><th scope="col" class="px-4 py-2 text-right">Spend</th></tr></thead>
                <tbody>
                  {report.weekly.map((w: any) => (
                    <tr class="border-t border-gray-100"><th scope="row" class="px-4 py-2 text-left font-normal">{weekLabel(w.weekStart)}</th><td class="px-4 py-2 text-right">{formatOrders(w.orders)}</td><td class="px-4 py-2 text-right">{formatUgx(w.revenueUGX)}</td><td class="px-4 py-2 text-right">{money(w.spendUGX, "No spend data")}</td></tr>
                  ))}
                </tbody>
              </table>
            </section>

            <section aria-labelledby="creators-h" class="mb-8 rounded-2xl border border-gray-200 bg-white p-4">
              <h3 id="creators-h" class="font-black text-brand-dark">Creators and promo codes</h3>
              {report.creatorsAndCodes.length === 0 ? <p class="mt-2 text-sm text-gray-600">No sale in these weeks used a creator or promo code.</p> : (
                <table class="mt-2 w-full text-sm"><tbody>
                  {report.creatorsAndCodes.map((d: any) => <tr class="border-t border-gray-100"><th scope="row" class="py-1 text-left font-normal">{d.channel === "creator" ? "Creator" : "Code"}: <strong>{d.detail}</strong></th><td class="py-1 text-right">{formatOrders(d.orders)} orders</td><td class="py-1 text-right">{formatUgx(d.revenueUGX)}</td></tr>)}
                </tbody></table>
              )}
            </section>
          </>
        )}

        <section aria-labelledby="recompute-h" class="mb-12 rounded-2xl border border-gray-200 bg-white p-5">
          <h3 id="recompute-h" class="font-black text-brand-dark">Recompute</h3>
          <p class="mt-1 text-sm text-gray-600">Each order is credited when it is placed and again every night. Recompute after importing spend history or correcting an order's source.</p>
          <form method="POST" class="mt-3 flex flex-wrap items-end gap-3">
            <label class="text-xs font-bold text-gray-700">Reason (required)<input name="reason" required minlength="5" maxlength="300" class="mt-1 block w-80 max-w-full min-h-11 rounded-lg border border-gray-300 px-3 text-sm font-normal" /></label>
            <button class="inline-flex min-h-11 items-center rounded-full bg-brand-dark px-5 text-sm font-bold text-white">Recompute the last 120 days</button>
          </form>
        </section>
      </>
    )}
  </div>
</AdminLayout>
