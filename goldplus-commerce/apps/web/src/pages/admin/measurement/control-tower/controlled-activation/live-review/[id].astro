---
import { formatDisplayDateTime } from '../../../../../../utils/date-format';
import AdminLayout from '../../../../../../layouts/AdminLayout.astro';
import { readSessionToken } from '../../../../../../lib/session';
import { liveReviewAct, liveReviewGet } from '../../../../../../lib/liveReviewApi';

const token = readSessionToken(Astro.request);
if (!token) {
  return Astro.redirect('/admin/login?returnTo=/admin/measurement/control-tower/controlled-activation/live-review', 303);
}

const { id } = Astro.params;
const self = `/admin/measurement/control-tower/controlled-activation/live-review/${encodeURIComponent(id ?? '')}`;

// Actions are form POSTs handled here, with the admin's own session. They used to be
// browser fetches straight to the API as a hard-coded 'admin-123', which could never act.
let actionError: string | null = null;
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const kind = String(form.get('action') ?? '');
  const note = String(form.get('note') ?? '').trim().slice(0, 1000);
  const outcome =
    kind === 'checks' ? await liveReviewAct(token, id ?? '', { kind: 'checks' })
      : kind === 'runbook' ? await liveReviewAct(token, id ?? '', { kind: 'runbook' })
        : kind === 'APPROVED' || kind === 'REJECTED' ? await liveReviewAct(token, id ?? '', { kind: 'approval', status: kind, note: note || `${kind} via admin` })
          : { ok: false as const, error: 'Unknown action.' };
  if (outcome.ok) return Astro.redirect(`${self}?done=${encodeURIComponent(kind)}`, 303);
  actionError = outcome.error;
}
const done = Astro.url.searchParams.get('done');

type StakeholderLiveApproval = { approvalStatus: string; approvedAt: string; approvalNote: string };
const result = await liveReviewGet<any>(token, `/${encodeURIComponent(id ?? '')}`);
if (!result.ok && result.error.startsWith('That candidate')) {
  return Astro.redirect('/admin/measurement/control-tower/controlled-activation/live-review');
}
const error = result.ok ? null : result.error;
const details = result.ok ? result.data : null;
const { candidate, runbook, approvals, incidentPlan } = details ?? {};
---

<AdminLayout title={`Live Review Candidate | Controlled Activation | Control Tower`}>
  <div class="px-4 sm:px-6 lg:px-8 py-8 w-full max-w-9xl mx-auto">
    <div class="mb-6">
      <a href="/admin/measurement/control-tower/controlled-activation/live-review" class="text-sm font-medium text-blue-500 hover:text-blue-600">&larr; Back to Candidates</a>
    </div>

    {actionError && <div class="bg-red-50 text-red-700 p-4 rounded-sm border border-red-200 mb-4" role="alert">{actionError}</div>}
    {done && !actionError && <div class="bg-emerald-50 text-emerald-800 p-4 rounded-sm border border-emerald-200 mb-4" role="status">Saved.</div>}
    {error ? (
      <div class="bg-red-50 text-red-600 p-4 rounded-sm border border-red-200">
        {error}
      </div>
    ) : (
      <div class="space-y-6">
        {/* Header section */}
        <div class="bg-white p-6 shadow-sm rounded-sm border border-slate-200 flex justify-between items-start">
          <div>
            <h2 class="text-xl font-bold text-slate-800">Candidate {candidate.id.split('-')[0]}</h2>
            <div class="mt-2 text-sm text-slate-500 space-y-1">
              <p><span class="font-medium text-slate-700">Status:</span> {candidate.status}</p>
              <p><span class="font-medium text-slate-700">Environment:</span> {candidate.environment}</p>
              <p><span class="font-medium text-slate-700">Created At:</span> {formatDisplayDateTime(candidate.createdAt)}</p>
            </div>
          </div>
          <div class="flex flex-col items-end gap-2">
            {candidate.status === 'DRAFT' && (
              <form method="POST"><input type="hidden" name="action" value="checks" />
                <button type="submit" class="btn bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded-sm">Run Readiness Checks</button></form>
            )}
            {candidate.status === 'READY_FOR_REVIEW' && !runbook && (
              <form method="POST"><input type="hidden" name="action" value="runbook" />
                <button type="submit" class="btn bg-indigo-500 hover:bg-indigo-600 text-white px-4 py-2 rounded-sm">Build Runbook</button></form>
            )}
            {candidate.status === 'READY_FOR_REVIEW' && runbook && (
              <form method="POST" class="flex flex-col items-end gap-2">
                <label class="text-xs text-slate-600">Note (optional)
                  <textarea name="note" maxlength="1000" rows="2" class="mt-1 block w-72 border border-slate-300 rounded-sm p-2 text-sm"></textarea></label>
                <div class="flex gap-2">
                  <button type="submit" name="action" value="APPROVED" class="btn bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2 rounded-sm" data-confirm="Record your approval of this candidate?">Approve</button>
                  <button type="submit" name="action" value="REJECTED" class="btn bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded-sm" data-confirm="Record a rejection of this candidate?">Reject</button>
                </div>
              </form>
            )}
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {/* Runbook Section */}
          <div class="bg-white p-6 shadow-sm rounded-sm border border-slate-200">
            <h3 class="text-lg font-bold text-slate-800 mb-4">Runbook</h3>
            {runbook ? (
              <div class="space-y-4 text-sm">
                <div>
                  <p class="font-medium text-slate-700">Scope:</p>
                  <p class="text-slate-600 bg-slate-50 p-2 rounded">{runbook.canaryScopeSummary}</p>
                </div>
                <div>
                  <p class="font-medium text-slate-700">Success Criteria:</p>
                  <p class="text-slate-600 bg-emerald-50 p-2 rounded">{runbook.successCriteria}</p>
                </div>
                <div>
                  <p class="font-medium text-slate-700">Failure Criteria:</p>
                  <p class="text-slate-600 bg-red-50 p-2 rounded">{runbook.failureCriteria}</p>
                </div>
                <div>
                  <p class="font-medium text-slate-700">Monitoring Cadence:</p>
                  <p class="text-slate-600">{runbook.monitoringCadence}</p>
                </div>
              </div>
            ) : (
              <p class="text-sm text-slate-500 italic">No runbook generated yet.</p>
            )}
          </div>

          {/* Incident Plan Section */}
          <div class="bg-white p-6 shadow-sm rounded-sm border border-slate-200">
            <h3 class="text-lg font-bold text-slate-800 mb-4">Incident Plan</h3>
            {incidentPlan ? (
              <div class="space-y-4 text-sm">
                <div class="grid grid-cols-2 gap-4">
                  <div>
                    <p class="font-medium text-slate-700">Incident Owner:</p>
                    <p class="text-slate-600">{incidentPlan.incidentOwner}</p>
                  </div>
                  <div>
                    <p class="font-medium text-slate-700">Rollback Owner:</p>
                    <p class="text-slate-600">{incidentPlan.rollbackOwner}</p>
                  </div>
                </div>
                <div>
                  <p class="font-medium text-slate-700">Escalation Path:</p>
                  <p class="text-slate-600 bg-slate-50 p-2 rounded">{incidentPlan.escalationPath}</p>
                </div>
                <div>
                  <p class="font-medium text-slate-700">Rollback Criteria:</p>
                  <p class="text-slate-600 bg-orange-50 p-2 rounded">{incidentPlan.rollbackCriteria}</p>
                </div>
              </div>
            ) : (
              <p class="text-sm text-slate-500 italic">No incident plan available.</p>
            )}
          </div>
        </div>
        
        {/* Approvals Section */}
        <div class="bg-white p-6 shadow-sm rounded-sm border border-slate-200">
            <h3 class="text-lg font-bold text-slate-800 mb-4">Stakeholder Approvals</h3>
            {approvals && approvals.length > 0 ? (
              <div class="space-y-3">
                {approvals.map((approval: StakeholderLiveApproval) => (
                  <div class="text-sm p-3 border border-slate-100 bg-slate-50 rounded-sm">
                      <div class="flex justify-between items-center mb-1">
                        <span class={`font-medium ${approval.approvalStatus === 'APPROVED' ? 'text-emerald-600' : 'text-red-600'}`}>
                          {approval.approvalStatus}
                        </span>
                        <span class="text-slate-500 text-xs">{formatDisplayDateTime(approval.approvedAt)}</span>
                      </div>
                      <p class="text-slate-600">{approval.approvalNote}</p>
                  </div>
                ))}
              </div>
            ) : (
              <p class="text-sm text-slate-500 italic">No stakeholder approvals yet.</p>
            )}
        </div>
      </div>
    )}
  </div>
</AdminLayout>

