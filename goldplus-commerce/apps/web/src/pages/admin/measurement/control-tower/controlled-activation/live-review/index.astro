---
import AdminLayout from '../../../../../../layouts/AdminLayout.astro';
import LiveReviewCandidateList from '../../../../../../components/admin/controlled-activation-live-review/LiveReviewCandidateList.astro';
import { readSessionToken } from '../../../../../../lib/session';
import { liveReviewGet } from '../../../../../../lib/liveReviewApi';

const token = readSessionToken(Astro.request);
if (!token) {
  return Astro.redirect('/admin/login?returnTo=/admin/measurement/control-tower/controlled-activation/live-review', 303);
}

// Read with the admin's own session (lib/liveReviewApi explains the old 'admin-123' header).
const result = await liveReviewGet<unknown[]>(token);
const candidates = result.ok && Array.isArray(result.data) ? result.data : [];
const error = result.ok ? null : result.error;
---

<AdminLayout title="Live Review Candidates | Controlled Activation | Control Tower">
  <div class="px-4 sm:px-6 lg:px-8 py-8 w-full max-w-9xl mx-auto">
    <div class="sm:flex sm:justify-between sm:items-center mb-8">
      <div class="mb-4 sm:mb-0">
        <h1 class="text-2xl md:text-3xl text-slate-800 font-bold">Live Review Candidates</h1>
        <p class="text-slate-500 text-sm mt-1">Review candidates pending approval for future controlled activation.</p>
      </div>
    </div>

    {error ? (
      <div class="bg-red-50 text-red-600 p-4 rounded-sm border border-red-200">
        {error}
      </div>
    ) : (
      <LiveReviewCandidateList candidates={candidates} />
    )}
  </div>
</AdminLayout>
