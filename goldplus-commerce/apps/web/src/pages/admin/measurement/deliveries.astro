---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { readSessionToken } from "../../../lib/session";
import { apiBase } from "../../../lib/api";

/**
 * Measurement deliveries (0140/0141): the durable queue of commerce events to
 * GA4 and ad platforms, live from PostgreSQL. Every number is operational
 * truth; replay is previewed, bounded and needs a reason; the kill switch
 * holds (never deletes) pending work.
 */
const token = readSessionToken(Astro.request);
if (!token) return Astro.redirect("/admin/login?returnTo=/admin/measurement/deliveries", 303);

async function call(method: string, path: string, body?: unknown) {
  try {
    const res = await fetch(`${apiBase}/admin/measurement-delivery${path}`, { method, headers: { Accept: "application/json", Authorization: `Bearer ${token}`, ...(body ? { "Content-Type": "application/json" } : {}) }, body: body ? JSON.stringify(body) : undefined });
    const json = await res.json().catch(() => null);
    if (res.status === 401 || res.status === 403) return { ok: false as const, message: "Your account does not have the measurement permission this needs." };
    return res.ok && json?.success ? { ok: true as const, data: json.data } : { ok: false as const, message: json?.error?.message ?? `The API declined the request (HTTP ${res.status}).` };
  } catch { return { ok: false as const, message: "Could not reach the API." }; }
}

const q = Astro.url.searchParams;
const selectedState = q.get("state") ?? "";
let notice: string | null = null;
let formError: string | null = null;
let preview: { eligible: string[]; ineligible: Array<{ deliveryId: string; reason: string }>; digest: string } | null = null;
let previewIds: string[] = [];

if (Astro.request.method === "POST") {
  const f = await Astro.request.formData();
  const intent = String(f.get("intent") ?? "");
  const ids = f.getAll("ids").map(String);
  const reason = String(f.get("reason") ?? "");
  if (intent === "kill-on" || intent === "kill-off") {
    const r = await call("POST", "/kill-switch", { on: intent === "kill-on", reason });
    if (r.ok) notice = intent === "kill-on" ? "Kill switch ON: no delivery will be sent; pending work is held." : "Kill switch OFF: held deliveries resume on the next cycle."; else formError = r.message;
  } else if (intent === "preview") {
    const r = await call("POST", "/replay/preview", { ids });
    if (r.ok) { preview = r.data; previewIds = ids; } else formError = r.message;
  } else if (intent === "replay") {
    const r = await call("POST", "/replay", { ids, digest: String(f.get("digest") ?? ""), reason });
    if (r.ok) notice = `${r.data.scheduled} delivery(ies) rescheduled.`; else formError = r.message;
  } else if (intent === "quarantine" || intent === "cancel") {
    const r = await call("POST", "/quarantine", { ids, reason, cancel: intent === "cancel" });
    if (r.ok) notice = `${r.data.changed} delivery(ies) ${intent === "cancel" ? "cancelled" : "quarantined"}.`; else formError = r.message;
  }
}

const summary = await call("GET", "/summary");
const list = await call("GET", `/deliveries?limit=100${selectedState ? `&states=${encodeURIComponent(selectedState)}` : ""}`);
const detailId = q.get("id");
const detail = detailId ? await call("GET", `/deliveries/${encodeURIComponent(detailId)}`) : null;

const STATE: Record<string, [string, string]> = {
  PENDING: ["Pending", "bg-gray-100 text-gray-800"], LEASED: ["Sending", "bg-blue-100 text-blue-900"], RETRY_WAIT: ["Waiting to retry", "bg-amber-100 text-amber-900"],
  ACCEPTED: ["Accepted", "bg-emerald-100 text-emerald-900"], PROCESSED: ["Processed", "bg-emerald-100 text-emerald-900"],
  UNKNOWN_OUTCOME: ["Unknown outcome", "bg-orange-100 text-orange-900"], SUPPRESSED: ["Suppressed", "bg-gray-100 text-gray-600"],
  QUARANTINED: ["Quarantined", "bg-purple-100 text-purple-900"], DEAD_LETTER: ["Failed", "bg-red-100 text-red-900"], CANCELLED: ["Cancelled", "bg-gray-100 text-gray-600"],
};
const when = (iso: unknown) => (typeof iso === "string" && iso ? new Date(iso).toLocaleString("en-GB", { day: "numeric", month: "short", hour: "2-digit", minute: "2-digit", timeZone: "Africa/Kampala" }) : "—");
const s = summary.ok ? summary.data : null;
---
<AdminLayout title="Measurement deliveries" description="Commerce events delivered to GA4 and ad platforms: queue, outcomes, replay and kill switch.">
  <div class="container mx-auto px-6 lg:px-8 max-w-7xl">
    <h2 class="text-2xl font-black text-brand-dark tracking-tight mb-2">Measurement deliveries</h2>
    <p class="text-sm text-gray-600 mb-6 max-w-3xl">Each confirmed sale, cancellation and refund is recorded in the same database transaction as the order, then delivered to GA4 and every live ad platform. A delivery whose result is unknown is never counted as sent; it is retried only where the platform ignores duplicates.</p>
    {notice && <div role="status" class="mb-6 rounded-xl border border-emerald-300 bg-emerald-50 p-4 text-sm text-emerald-900">{notice}</div>}
    {formError && <div role="alert" class="mb-6 rounded-xl border border-red-300 bg-red-50 p-4 text-sm text-red-900">{formError}</div>}

    {!s ? <p role="alert" class="rounded-xl border border-red-300 bg-red-50 p-4 text-sm text-red-900">{!summary.ok && summary.message}</p> : (
      <>
        <section aria-label="Summary" class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4 mb-6">
          <div class="rounded-2xl border border-gray-200 bg-white p-4"><p class="text-xs font-bold uppercase text-gray-500">Business events</p><p class="text-2xl font-black">{s.events.total}</p><p class="text-xs text-gray-500">{s.events.last24h} in the last 24 h</p></div>
          <div class="rounded-2xl border border-gray-200 bg-white p-4"><p class="text-xs font-bold uppercase text-gray-500">Due now</p><p class="text-2xl font-black">{(s.byState.PENDING ?? 0) + (s.byState.RETRY_WAIT ?? 0)}</p><p class="text-xs text-gray-500">{s.oldestDueMinutes == null ? "nothing overdue" : `oldest due ${s.oldestDueMinutes} min ago`}</p></div>
          <div class="rounded-2xl border border-gray-200 bg-white p-4"><p class="text-xs font-bold uppercase text-gray-500">Needs attention</p><p class="text-2xl font-black">{(s.byState.UNKNOWN_OUTCOME ?? 0) + (s.byState.DEAD_LETTER ?? 0) + (s.byState.QUARANTINED ?? 0)}</p><p class="text-xs text-gray-500">unknown {s.byState.UNKNOWN_OUTCOME ?? 0} · failed {s.byState.DEAD_LETTER ?? 0} · quarantined {s.byState.QUARANTINED ?? 0}</p></div>
          <div class="rounded-2xl border border-gray-200 bg-white p-4"><p class="text-xs font-bold uppercase text-gray-500">Integrity</p><p class="text-sm mt-1">Unrouted events: <strong>{s.unroutedEvents}</strong></p><p class="text-sm">Write failures: <strong class={s.writeFailures ? "text-red-700" : ""}>{s.writeFailures}</strong></p><p class="text-sm">Content conflicts: <strong class={s.eventConflicts ? "text-red-700" : ""}>{s.eventConflicts}</strong></p><p class="text-sm">Sales with no record: <strong class={s.ordersWithoutEvents ? "text-red-700" : ""}>{s.ordersWithoutEvents}</strong></p></div>
        </section>

        {s.ordersWithoutEvents > 0 && (
          <div role="alert" class="mb-6 rounded-xl border border-red-300 bg-red-50 p-4 text-sm text-red-900">
            <strong>{s.ordersWithoutEvents} order(s) placed since measurement began have no record at all.</strong> Sales are going uncounted: the event writer is not running or is failing silently. This is not a delivery problem — nothing was written to record in the first place.
          </div>
        )}
        <section aria-label="Browser intake" class="mb-6 rounded-2xl border border-gray-200 bg-white p-4">
          <p class="text-xs font-bold uppercase text-gray-500">Browser intake (last 24 h)</p>
          <p class="text-sm mt-1">{s.collector.batches24h} batch(es) · {s.collector.acceptedEvents24h} event(s) accepted · <strong class={s.collector.rejectedEvents24h ? "text-amber-800" : ""}>{s.collector.rejectedEvents24h} rejected</strong> · {s.collector.touches24h} visit source(s) recorded</p>
          <p class="text-xs text-gray-500 mt-1">Rejections are normal only in small numbers. A sustained rise means the storefront is sending something the server will not accept — worth looking at, not ignoring.</p>
        </section>

        <section aria-labelledby="kill-h" class={`mb-8 rounded-2xl border p-5 ${s.killSwitch.on ? "border-red-300 bg-red-50" : "border-gray-200 bg-white"}`}>
          <h3 id="kill-h" class="font-black text-brand-dark">Kill switch: {s.killSwitch.on ? "ON — nothing is being sent" : "off"}</h3>
          {s.killSwitch.reason && <p class="text-xs text-gray-600 mt-1">Last change {when(s.killSwitch.updatedAt)}: {s.killSwitch.reason}</p>}
          <form method="POST" class="mt-3 flex flex-wrap items-end gap-3">
            <label class="text-xs font-bold text-gray-700">Reason (required)<input name="reason" required minlength="5" class="mt-1 block w-80 max-w-full rounded-lg border border-gray-300 px-3 py-2 text-sm font-normal" /></label>
            {s.killSwitch.on
              ? <button name="intent" value="kill-off" class="inline-flex min-h-11 items-center rounded-full bg-brand-dark px-5 text-sm font-bold text-white">Resume sending</button>
              : <button name="intent" value="kill-on" class="inline-flex min-h-11 items-center rounded-full border border-red-400 px-5 text-sm font-bold text-red-800">Stop all sending</button>}
          </form>
        </section>
      </>
    )}

    {detail && (detail.ok ? (() => { const d = detail.data; return (
      <section aria-labelledby="det-h" class="mb-8 rounded-2xl border-2 border-brand-dark bg-white p-5">
        <h3 id="det-h" class="font-black text-brand-dark">{d.sink} · {d.eventName} · {d.orderNumber ?? "—"}</h3>
        <p class="text-sm mt-1"><span class={`rounded-full px-2 py-0.5 text-xs font-bold ${STATE[d.state]?.[1]}`}>{STATE[d.state]?.[0] ?? d.state}</span> {d.reason && <span class="text-gray-600">— {d.reason}</span>}</p>
        <dl class="mt-3 grid gap-1 text-sm sm:grid-cols-2">
          <div><dt class="inline font-bold">Occurred: </dt><dd class="inline">{when(d.occurredAt)}</dd></div>
          <div><dt class="inline font-bold">Next attempt: </dt><dd class="inline">{when(d.nextAttemptAt)}</dd></div>
          <div><dt class="inline font-bold">Attempts: </dt><dd class="inline">{d.attempts} (replays {d.replayCount})</dd></div>
          <div><dt class="inline font-bold">Value: </dt><dd class="inline">{d.event.amountUGX ?? d.event.netMerchandiseUGX ?? "—"} UGX</dd></div>
        </dl>
        <h4 class="mt-4 text-sm font-bold">Attempts</h4>
        {d.attemptsList.length === 0 ? <p class="text-sm text-gray-600">No network attempt has been made.</p> : (
          <ol class="mt-1 space-y-1 text-sm">{d.attemptsList.map((a: any) => <li>#{a.attemptNo} · {when(a.startedAt)} → {a.finishedAt ? when(a.finishedAt) : "no finish recorded"} · <strong>{a.outcome}</strong>{a.httpStatus ? ` · HTTP ${a.httpStatus}` : ""}{a.providerCode ? ` · ${a.providerCode}` : ""}</li>)}</ol>
        )}
      </section>); })() : <p role="alert" class="mb-6 rounded-xl border border-red-300 bg-red-50 p-4 text-sm text-red-900">{detail.message}</p>)}

    {preview && (
      <section aria-labelledby="prev-h" class="mb-8 rounded-2xl border border-amber-300 bg-amber-50 p-5">
        <h3 id="prev-h" class="font-black">Replay preview</h3>
        <p class="text-sm mt-1">{preview.eligible.length} would be rescheduled (same delivery and provider event id — no new sale is created). {preview.ineligible.length} would not: {preview.ineligible.map((i) => i.reason).join(", ") || "none"}.</p>
        {preview.eligible.length > 0 && (
          <form method="POST" class="mt-3 flex flex-wrap items-end gap-3">
            {previewIds.map((id) => <input type="hidden" name="ids" value={id} />)}
            <input type="hidden" name="digest" value={preview.digest} />
            <label class="text-xs font-bold text-gray-700">Reason (required)<input name="reason" required minlength="5" class="mt-1 block w-80 max-w-full rounded-lg border border-gray-300 px-3 py-2 text-sm font-normal" /></label>
            <button name="intent" value="replay" class="inline-flex min-h-11 items-center rounded-full bg-brand-dark px-5 text-sm font-bold text-white">Replay {preview.eligible.length}</button>
          </form>
        )}
      </section>
    )}

    <nav aria-label="Filter by state" class="mb-3 flex flex-wrap gap-2 text-sm">
      {["", "PENDING,RETRY_WAIT", "UNKNOWN_OUTCOME", "DEAD_LETTER", "QUARANTINED", "ACCEPTED", "SUPPRESSED"].map((st) => (
        <a href={`/admin/measurement/deliveries${st ? `?state=${st}` : ""}`} class={`rounded-full border px-3 py-1 ${selectedState === st ? "border-brand-dark bg-brand-dark text-white" : "border-gray-300"}`}>{st ? st.split(",").map((x) => STATE[x]?.[0] ?? x).join(" + ") : "All"}</a>
      ))}
    </nav>
    {!list.ok ? <p role="alert" class="rounded-xl border border-red-300 bg-red-50 p-4 text-sm text-red-900">{list.message}</p> : list.data.length === 0 ? (
      <p class="rounded-2xl border border-dashed border-gray-300 bg-gray-50 p-8 text-sm text-gray-600 mb-12">No deliveries in this view. A delivery appears when an order is confirmed, cancelled or refunded.</p>
    ) : (
      <form method="POST" class="mb-12">
        <div class="overflow-x-auto rounded-2xl border border-gray-200 bg-white">
          <table class="w-full text-sm">
            <thead><tr class="text-left text-xs font-bold uppercase tracking-wider text-gray-500 border-b border-gray-200"><th class="p-3"><span class="sr-only">Select</span></th><th class="p-3">Order / event</th><th class="p-3">Destination</th><th class="p-3">State</th><th class="p-3">Attempts</th><th class="p-3">Updated</th></tr></thead>
            <tbody>{list.data.map((d: any) => (
              <tr class="border-b border-gray-100">
                <td class="p-3"><input type="checkbox" name="ids" value={d.deliveryId} aria-label={`Select ${d.orderNumber ?? d.deliveryId}`} /></td>
                <td class="p-3"><a class="font-bold underline" href={`/admin/measurement/deliveries?id=${d.deliveryId}${selectedState ? `&state=${selectedState}` : ""}`}>{d.orderNumber ?? "—"}</a><span class="block text-xs text-gray-500">{d.eventName}</span></td>
                <td class="p-3 text-xs">{d.sink}</td>
                <td class="p-3"><span class={`rounded-full px-2 py-0.5 text-xs font-bold ${STATE[d.state]?.[1]}`}>{STATE[d.state]?.[0] ?? d.state}</span>{d.reason && <span class="block text-xs text-gray-500 max-w-xs break-words">{d.reason}</span>}</td>
                <td class="p-3">{d.attempts}</td>
                <td class="p-3 whitespace-nowrap text-gray-600">{when(d.updatedAt)}</td>
              </tr>
            ))}</tbody>
          </table>
        </div>
        <div class="mt-3 flex flex-wrap items-end gap-3">
          <button name="intent" value="preview" class="inline-flex min-h-11 items-center rounded-full border border-gray-300 px-5 text-sm font-bold">Preview replay of selected</button>
          <label class="text-xs font-bold text-gray-700">Reason (for quarantine/cancel)<input name="reason" class="mt-1 block w-72 max-w-full rounded-lg border border-gray-300 px-3 py-2 text-sm font-normal" /></label>
          <button name="intent" value="quarantine" class="inline-flex min-h-11 items-center rounded-full border border-purple-300 px-5 text-sm font-bold text-purple-900">Quarantine</button>
          <button name="intent" value="cancel" class="inline-flex min-h-11 items-center rounded-full border border-gray-300 px-5 text-sm font-bold">Cancel</button>
        </div>
      </form>
    )}
  </div>
</AdminLayout>
