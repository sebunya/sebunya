---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { readSessionToken } from "../../lib/session";
import { apiBase } from "../../lib/api";

/**
 * Identity conflicts (0155): an identifier (a phone, an email, a visitor id)
 * that two customer profiles both claim. Nothing is merged automatically on a
 * typed contact; a person decides here. Identifiers are masked by the API.
 */
const token = readSessionToken(Astro.request);
if (!token) return Astro.redirect("/admin/login?returnTo=/admin/identity-conflicts", 303);

async function call(method: string, path: string, body?: unknown) {
  try {
    const res = await fetch(`${apiBase}/admin/first-party${path}`, { method, headers: { Accept: "application/json", Authorization: `Bearer ${token}`, ...(body !== undefined ? { "Content-Type": "application/json" } : {}) }, body: body !== undefined ? JSON.stringify(body) : undefined });
    const json = await res.json().catch(() => null);
    if (res.status === 403) return { ok: false as const, message: "Your account is not permitted to review identity conflicts." };
    return res.ok && json?.success ? { ok: true as const, data: json.data } : { ok: false as const, message: json?.error?.message ?? `The API declined the request (HTTP ${res.status}).` };
  } catch { return { ok: false as const, message: "Could not reach the API." }; }
}

let notice: string | null = null;
let formError: string | null = null;
if (Astro.request.method === "POST") {
  const f = await Astro.request.formData();
  const r = await call("POST", `/identity-conflicts/${encodeURIComponent(String(f.get("id") ?? ""))}/resolve`, { resolution: String(f.get("resolution") ?? ""), reason: String(f.get("reason") ?? "") });
  if (r.ok) notice = "Resolved."; else formError = r.message;
}
const list = await call("GET", "/identity-conflicts");
const conflicts: any[] = list.ok ? list.data.conflicts : [];
const LABEL: Record<string, string> = {
  CONTACT_PHONE: "Phone typed at checkout or sign-up", CONTACT_EMAIL: "Email typed at checkout or sign-up", VERIFIED_PHONE: "Verified phone",
  VERIFIED_EMAIL: "Verified email", STABLE_ANONYMOUS_ID: "Browser / visitor id", ORDER_CUSTOMER_RELATIONSHIP: "Order", AUTHENTICATED_CUSTOMER_ID: "Account",
};
const when = (iso: unknown) => (typeof iso === "string" && iso ? new Date(iso).toLocaleString("en-GB", { day: "numeric", month: "short", hour: "2-digit", minute: "2-digit", timeZone: "Africa/Kampala" }) : "—");
---
<AdminLayout title="Identity conflicts" description="Identifiers two customer profiles both claim, for a person to resolve.">
  <div class="container mx-auto px-6 lg:px-8 max-w-5xl">
    <h2 class="text-2xl font-black text-brand-dark tracking-tight mb-2">Identity conflicts</h2>
    <p class="text-sm text-gray-600 mb-6 max-w-3xl">When a phone, email or browser already belongs to one customer and turns up for another, it is held here instead of being merged. A shared family phone and a guest who later made an account look the same to a machine. Choose what is true; every decision is recorded with your reason.</p>
    {notice && <div role="status" class="mb-6 rounded-xl border border-emerald-300 bg-emerald-50 p-4 text-sm text-emerald-900">{notice}</div>}
    {formError && <div role="alert" class="mb-6 rounded-xl border border-red-300 bg-red-50 p-4 text-sm text-red-900">{formError}</div>}
    {!list.ok ? <p role="alert" class="rounded-xl border border-red-300 bg-red-50 p-4 text-sm text-red-900">{list.message}</p>
      : conflicts.length === 0 ? <p class="rounded-2xl border border-gray-200 bg-white p-6 text-sm text-gray-600">No open conflicts.</p> : (
      <div class="grid gap-4 mb-12">
        {conflicts.map((c) => (
          <article class="rounded-2xl border border-gray-200 bg-white p-5">
            <p class="font-black text-brand-dark">{LABEL[c.signalType] ?? c.signalType} <span class="font-mono text-xs text-gray-500">{c.identifierMasked}</span></p>
            <p class="text-xs text-gray-600 mt-1">Held by <a class="underline font-mono" href={`/admin/customer-dna/${c.existingCanonicalId}`}>{c.existingCanonicalId.slice(0, 8)}…</a>, also claimed by <a class="underline font-mono" href={`/admin/customer-dna/${c.proposedCanonicalId}`}>{c.proposedCanonicalId.slice(0, 8)}…</a> · seen {c.occurrences} time{c.occurrences === 1 ? "" : "s"} · last {when(c.lastSeenAt)}{c.moment && ` · at ${c.moment.toLowerCase().replace(/_/g, " ")}`}</p>
            <form method="POST" class="mt-3 grid gap-2 sm:grid-cols-[1fr_1fr_auto] items-end">
              <input type="hidden" name="id" value={c.id} />
              <label class="text-xs font-bold text-gray-700">Decision
                <select name="resolution" required class="mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm font-normal">
                  <option value="KEEP_EXISTING">Keep it with the first customer</option>
                  <option value="REASSIGN_TO_PROPOSED">Move it to the second customer</option>
                  <option value="DETACH">It belongs to neither (shared)</option>
                  <option value="MERGE_GUEST_INTO_PROPOSED">Same person: merge the first (guest) profile into the second</option>
                </select>
              </label>
              <label class="text-xs font-bold text-gray-700">Reason<input name="reason" required minlength="5" maxlength="1000" class="mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm font-normal" /></label>
              <button class="inline-flex min-h-11 items-center rounded-full bg-brand-dark px-5 text-sm font-bold text-white">Resolve</button>
            </form>
          </article>
        ))}
      </div>
    )}
  </div>
</AdminLayout>
