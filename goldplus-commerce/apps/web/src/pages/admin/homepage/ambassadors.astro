---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { readSessionToken } from '../../../lib/session';
import { apiBase } from '../../../lib/api';
import { fetchApprovedCatalogue } from '../../../lib/catalogue';
import {
  DEFAULT_HOMEPAGE_CONTENT,
  HOME_AMBASSADORS_MAX,
  HOME_AMBASSADOR_ROLES,
  HOME_AMBASSADOR_ROLE_LABEL,
  type HomeAmbassadors,
} from '@goldplus/shared';

/**
 * Ambassadors & models — the portraits above the homepage footer. Real people
 * holding GoldPlus products: each needs a signed photo release before it can be
 * published. Photos are uploaded through the media library here (pixel cap,
 * renditions, dedupe) or reused from it by address; the API resolves each to its
 * renditions and records the usage so a live portrait can't be deleted.
 *
 * Saving is all-or-nothing: if anything is wrong nothing is saved, every problem
 * is shown next to its field, and what was typed (and any photo already
 * uploaded) stays on the page.
 */
const token = readSessionToken(Astro.request);
if (!token) return Astro.redirect('/admin/login?returnTo=/admin/homepage/ambassadors', 303);

const authed = (path: string, init?: RequestInit) =>
  fetch(`${apiBase}${path}`, { ...init, headers: { ...init?.headers, Authorization: `Bearer ${token}`, Accept: 'application/json' } });

type Row = {
  id: string; name: string; role: string; tagline: string; imageUrl: string; imageAlt: string;
  productSlug: string; releaseOnFile: boolean; published: boolean; position: number; preview: string | null;
  releaseConfirmedAt: string | null;
};
type FieldErrors = Record<string, string>; // key `${row}.${field}` or `section.${field}`

let notice: { kind: 'ok' | 'error'; message: string } | null = null;
let errors: FieldErrors = {};
let rows: Row[] | null = null;
let sectionDraft: Omit<HomeAmbassadors, 'people'> | null = null;
let revision: string | null = null;

const bool = (v: FormDataEntryValue | null) => v === 'on' || v === 'true';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const count = Math.min(Number(form.get('rowCount') ?? 0) || 0, HOME_AMBASSADORS_MAX + 1);
  revision = String(form.get('revision') ?? '').trim() || null;
  sectionDraft = {
    heading: String(form.get('heading') ?? ''),
    intro: String(form.get('intro') ?? ''),
    ctaLabel: String(form.get('ctaLabel') ?? ''),
    ctaHref: String(form.get('ctaHref') ?? ''),
  };
  const submitted: Row[] = [];
  // Upload problems are keyed by the row's id, not its position: rows are re-sorted
  // by their typed position below, and a message must stay next to its own photo.
  const uploadErrors = new Map<string, string>();
  for (let i = 0; i < count; i++) {
    const f = (k: string) => String(form.get(`p.${i}.${k}`) ?? '').trim();
    const photo = form.get(`p.${i}.photo`);
    const hasPhoto = photo instanceof File && photo.size > 0;
    const row: Row = {
      id: f('id') || crypto.randomUUID(),
      name: f('name'), role: f('role') || 'AMBASSADOR', tagline: f('tagline'), imageUrl: f('imageUrl'), imageAlt: f('imageAlt'),
      productSlug: f('productSlug'), releaseOnFile: bool(form.get(`p.${i}.releaseOnFile`)), published: bool(form.get(`p.${i}.published`)),
      position: Number(f('position')) || i + 1, preview: f('preview') || null, releaseConfirmedAt: f('releaseConfirmedAt') || null,
    };
    if (bool(form.get(`p.${i}.remove`))) continue;
    // The blank "add a person" row, left blank.
    if (!f('id') && !row.name && !row.imageUrl && !hasPhoto && !row.tagline) continue;
    if (hasPhoto) {
      const body = new FormData();
      body.append('files', photo as File, (photo as File).name);
      if (row.imageAlt) body.append('altText', row.imageAlt);
      try {
        const res = await authed('/admin/media/upload', { method: 'POST', body });
        const json: any = await res.json().catch(() => null);
        const up = json?.data?.uploaded?.[0];
        const rej = json?.data?.rejected?.[0];
        if (up?.url) { row.imageUrl = up.url; row.preview = up.url; }
        else if (res.status === 403) uploadErrors.set(row.id, 'Your account cannot upload to the media library. Ask an owner for media permission, or use an address of a photo already in the library.');
        else uploadErrors.set(row.id, rej ? `The photo was not accepted: ${rej.message ?? rej.reason}.` : (json?.error?.message ?? 'The photo could not be uploaded.'));
      } catch {
        uploadErrors.set(row.id, 'The photo could not be uploaded right now.');
      }
    }
    submitted.push(row);
  }
  // Keep the typed order even when errors send the page back.
  submitted.sort((a, b) => a.position - b.position);
  rows = submitted.map((r, i) => ({ ...r, position: i + 1 }));
  rows.forEach((r, i) => { const m = uploadErrors.get(r.id); if (m) errors[`${i}.imageUrl`] = m; });

  if (Object.keys(errors).length === 0) {
    const payload = {
      ...(revision ? { expectedRevision: revision } : {}),
      ambassadors: {
        ...sectionDraft,
        people: rows.map((r) => ({ id: r.id, name: r.name, role: r.role, tagline: r.tagline, imageUrl: r.imageUrl, imageAlt: r.imageAlt, productSlug: r.productSlug, releaseOnFile: r.releaseOnFile, published: r.published })),
      },
    };
    try {
      const res = await authed('/admin/homepage/ambassadors', { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
      if (res.status === 401 || res.status === 403) return Astro.redirect('/admin/login?returnTo=/admin/homepage/ambassadors', 303);
      const json: any = await res.json().catch(() => null);
      if (res.ok && json?.success) return Astro.redirect(`/admin/homepage/ambassadors?saved=${encodeURIComponent(String(json.data?.version ?? ''))}`, 303);
      if (res.status === 409) {
        // Someone else saved since this page was opened. Keep these edits; saving again
        // (now against their version) replaces theirs deliberately.
        revision = String(json?.error?.currentRevision ?? revision ?? '') || null;
        notice = { kind: 'error', message: 'Someone else saved this section after you opened the page. Your edits are still below — save again to replace their version with yours, or reload the page to see theirs first.' };
      } else {
        for (const e of json?.error?.fields ?? []) errors[e.index === -1 ? `section.${e.field}` : `${e.index}.${e.field}`] = e.message;
        notice = { kind: 'error', message: json?.error?.fields?.length ? 'Nothing was saved. Fix the entries marked below.' : (json?.error?.message ?? `Nothing was saved (HTTP ${res.status}).`) };
      }
    } catch {
      notice = { kind: 'error', message: 'The service is unreachable right now. Nothing was saved.' };
    }
  } else {
    notice = { kind: 'error', message: 'Nothing was saved. Fix the entries marked below.' };
  }
}

let loadError = '';
if (!rows) {
  try {
    const res = await authed('/admin/homepage/ambassadors');
    if (res.status === 401 || res.status === 403) return Astro.redirect('/admin/login?returnTo=/admin/homepage/ambassadors', 303);
    const json: any = await res.json().catch(() => null);
    const a: HomeAmbassadors = json?.success ? json.data.ambassadors : DEFAULT_HOMEPAGE_CONTENT.ambassadors;
    if (!json?.success) loadError = json?.error?.message ?? 'Could not load the section.';
    sectionDraft = { heading: a.heading, intro: a.intro, ctaLabel: a.ctaLabel, ctaHref: a.ctaHref };
    revision = json?.success ? String(json.data.revision ?? '') || null : null;
    rows = a.people.map((p, i) => ({
      id: p.id, name: p.name, role: p.role, tagline: p.tagline, imageUrl: p.image?.src ?? '', imageAlt: p.imageAlt,
      productSlug: p.productSlug, releaseOnFile: p.releaseOnFile, published: p.published, position: i + 1, preview: p.image?.src ?? null,
      releaseConfirmedAt: p.releaseConfirmedAt ?? null,
    }));
  } catch {
    loadError = 'The service is unreachable right now.';
    sectionDraft = { ...DEFAULT_HOMEPAGE_CONTENT.ambassadors };
    rows = [];
  }
}
const saved = Astro.url.searchParams.get('saved');
if (saved && !notice) notice = { kind: 'ok', message: `Saved (version ${saved}). Live on the homepage within a minute.` };

let products: Array<{ slug: string; name: string }> = [];
try {
  products = (await fetchApprovedCatalogue(apiBase)).map((p) => ({ slug: p.slug, name: p.name })).sort((a, b) => a.name.localeCompare(b.name));
} catch { /* the product list is a convenience; a person can still be saved without one */ }

const list = rows ?? [];
const canAdd = list.length < HOME_AMBASSADORS_MAX;
const all: Row[] = canAdd
  ? [...list, { id: '', name: '', role: 'AMBASSADOR', tagline: '', imageUrl: '', imageAlt: '', productSlug: '', releaseOnFile: false, published: false, position: list.length + 1, preview: null, releaseConfirmedAt: null }]
  : list;
const live = list.filter((r) => r.published && r.releaseOnFile && r.imageUrl && r.imageAlt).length;
const err = (i: number, f: string) => errors[`${i}.${f}`];
const input = 'mt-1 w-full rounded border border-slate-300 px-3 py-2 text-sm';
---
<AdminLayout title="Ambassadors & models">
  <div class="mx-auto max-w-4xl px-4 py-8">
    <p class="text-xs font-bold text-slate-600"><a href="/admin/homepage" class="underline">Homepage content</a> / Ambassadors &amp; models</p>
    <h1 class="mt-1 text-2xl font-black text-slate-900">Ambassadors &amp; models</h1>
    <p class="mt-2 text-sm text-slate-600">
      Portraits of real people with GoldPlus products, shown above the footer on the homepage — five across on a computer, with arrows for the rest.
      Only people you publish <strong>and</strong> hold a signed photo release for are shown; with no one published the section stays hidden.
      Up to {HOME_AMBASSADORS_MAX} people. Best photo: portrait (about 3:5), the person holding the product, at least 1000 px wide.
    </p>
    <p class="mt-2 text-sm font-bold text-slate-800">{live} of {list.length} shown on the homepage now.</p>

    {notice && (
      <div role={notice.kind === 'ok' ? 'status' : 'alert'} class:list={['mt-6 rounded-xl border p-4 text-sm', notice.kind === 'ok' ? 'border-emerald-300 bg-emerald-50 text-emerald-900' : 'border-red-300 bg-red-50 text-red-900']}>
        <p class="font-bold">{notice.message}</p>
      </div>
    )}
    {loadError && <div role="alert" class="mt-6 rounded-xl border border-red-300 bg-red-50 p-4 text-sm text-red-900">{loadError}</div>}

    <form method="POST" enctype="multipart/form-data" class="mt-8 space-y-8">
      <input type="hidden" name="rowCount" value={all.length} />
      {revision && <input type="hidden" name="revision" value={revision} />}
      <section class="rounded-xl border border-slate-200 bg-white p-5">
        <h2 class="text-sm font-black uppercase tracking-wider text-slate-600">Section</h2>
        <div class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-2">
          <label class="text-xs block">Heading
            <input name="heading" maxlength="60" value={sectionDraft?.heading} class={input} />
          </label>
          <label class="text-xs block">Line under the heading (optional)
            <input name="intro" maxlength="160" value={sectionDraft?.intro} class={input} />
          </label>
          <label class="text-xs block">Button label
            <input name="ctaLabel" maxlength="30" value={sectionDraft?.ctaLabel} class={input} />
          </label>
          <label class="text-xs block">Button link (a page on this site)
            <input name="ctaHref" maxlength="300" value={sectionDraft?.ctaHref} class={input} />
            {errors['section.ctaHref'] && <span class="mt-1 block text-xs font-bold text-red-700">{errors['section.ctaHref']}</span>}
          </label>
        </div>
        {errors['section.people'] && <p class="mt-2 text-xs font-bold text-red-700">{errors['section.people']}</p>}
      </section>

      {all.map((r, i) => {
        const isNew = !r.id;
        return (
          <section class:list={['rounded-xl border bg-white p-5', Object.keys(errors).some((k) => k.startsWith(`${i}.`)) ? 'border-red-300' : 'border-slate-200']} aria-labelledby={`amb-${i}-title`}>
            <input type="hidden" name={`p.${i}.id`} value={r.id} />
            <input type="hidden" name={`p.${i}.preview`} value={r.preview ?? ''} />
            <input type="hidden" name={`p.${i}.releaseConfirmedAt`} value={r.releaseConfirmedAt ?? ''} />
            <div class="flex items-start justify-between gap-4">
              <h2 id={`amb-${i}-title`} class="text-sm font-black text-slate-900">{isNew ? 'Add a person' : (r.name || `Person ${i + 1}`)}</h2>
              {!isNew && (
                <span class:list={['rounded-full px-2 py-0.5 text-xs font-bold', r.published && r.releaseOnFile && r.imageUrl ? 'bg-emerald-50 text-emerald-800' : 'bg-slate-100 text-slate-700']}>
                  {r.published && r.releaseOnFile && r.imageUrl ? 'On the homepage' : 'Not shown'}
                </span>
              )}
            </div>
            <div class="mt-4 grid grid-cols-1 gap-5 sm:grid-cols-[140px_1fr]">
              <div>
                <div class="aspect-[3/5] w-full overflow-hidden rounded-lg bg-slate-100">
                  {r.preview ? <img src={r.preview} alt="" class="h-full w-full object-cover" loading="lazy" /> : <span class="flex h-full items-center justify-center p-2 text-center text-xs text-slate-600">No photo yet</span>}
                </div>
              </div>
              <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                <label class="text-xs block">Name
                  <input name={`p.${i}.name`} maxlength="60" value={r.name} class={input} />
                  {err(i, 'name') && <span class="mt-1 block text-xs font-bold text-red-700">{err(i, 'name')}</span>}
                </label>
                <label class="text-xs block">Role
                  <select name={`p.${i}.role`} class={input}>
                    {HOME_AMBASSADOR_ROLES.map((role) => <option value={role} selected={r.role === role}>{HOME_AMBASSADOR_ROLE_LABEL[role]}</option>)}
                  </select>
                </label>
                <label class="text-xs block sm:col-span-2">One short line (optional — their words, not ours; empty shows the product they hold)
                  <input name={`p.${i}.tagline`} maxlength="90" value={r.tagline} class={input} />
                  {err(i, 'tagline') && <span class="mt-1 block text-xs font-bold text-red-700">{err(i, 'tagline')}</span>}
                </label>
                <label class="text-xs block">Product in the photo (the card links to it)
                  <select name={`p.${i}.productSlug`} class={input}>
                    <option value="">No product link</option>
                    {r.productSlug && !products.some((p) => p.slug === r.productSlug) && <option value={r.productSlug} selected>{r.productSlug} (not on sale now)</option>}
                    {products.map((p) => <option value={p.slug} selected={r.productSlug === p.slug}>{p.name}</option>)}
                  </select>
                  {err(i, 'productSlug') && <span class="mt-1 block text-xs font-bold text-red-700">{err(i, 'productSlug')}</span>}
                </label>
                <label class="text-xs block">Upload a photo
                  <input type="file" name={`p.${i}.photo`} accept="image/jpeg,image/png,image/webp,image/avif" class="mt-1 block w-full text-sm" />
                </label>
                <label class="text-xs block sm:col-span-2">…or a media-library photo address
                  <input name={`p.${i}.imageUrl`} maxlength="500" value={r.imageUrl} placeholder="/uploads/assets/…" class={input} />
                  {err(i, 'imageUrl') && <span class="mt-1 block text-xs font-bold text-red-700">{err(i, 'imageUrl')}</span>}
                </label>
                <label class="text-xs block sm:col-span-2">Photo description for people who can't see it
                  <input name={`p.${i}.imageAlt`} maxlength="160" value={r.imageAlt} placeholder="Grace holding the GP-C08 charger" class={input} />
                  {err(i, 'imageAlt') && <span class="mt-1 block text-xs font-bold text-red-700">{err(i, 'imageAlt')}</span>}
                </label>
                <label class="flex items-start gap-2 text-sm text-slate-800 sm:col-span-2">
                  <input type="checkbox" name={`p.${i}.releaseOnFile`} checked={r.releaseOnFile} class="mt-0.5 h-4 w-4" />
                  <span>I hold a <strong>signed photo release</strong> from this person allowing GoldPlus to show their photo.
                    {r.releaseOnFile && r.releaseConfirmedAt && <span class="block text-xs text-slate-600">Confirmed {new Date(r.releaseConfirmedAt).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'Africa/Kampala' })} — recorded with your account in the audit log.</span>}
                  </span>
                </label>
                {err(i, 'releaseOnFile') && <p class="-mt-2 text-xs font-bold text-red-700 sm:col-span-2">{err(i, 'releaseOnFile')}</p>}
                <div class="flex flex-wrap items-center gap-5 sm:col-span-2">
                  <label class="flex items-center gap-2 text-sm text-slate-800"><input type="checkbox" name={`p.${i}.published`} checked={r.published} class="h-4 w-4" /> Show on the homepage</label>
                  <label class="flex items-center gap-2 text-sm text-slate-800">Position
                    <input type="number" name={`p.${i}.position`} min="1" max={HOME_AMBASSADORS_MAX + 1} value={r.position} class="w-16 rounded border border-slate-300 px-2 py-1 text-sm" />
                  </label>
                  {!isNew && <label class="flex items-center gap-2 text-sm text-red-800"><input type="checkbox" name={`p.${i}.remove`} class="h-4 w-4" /> Remove this person</label>}
                </div>
                {err(i, 'id') && <p class="text-xs font-bold text-red-700 sm:col-span-2">{err(i, 'id')}</p>}
              </div>
            </div>
          </section>
        );
      })}
      {!canAdd && <p class="text-sm text-slate-600">The section is full ({HOME_AMBASSADORS_MAX} people). Remove someone to add another.</p>}

      <button type="submit" class="rounded-full bg-slate-900 px-6 py-3 text-sm font-bold text-white">Save</button>
    </form>
  </div>
</AdminLayout>
