---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AdminPageHeader from '../../../components/AdminPageHeader.astro';
import AdminTable from '../../../components/AdminTable.astro';
import EmptyState from '../../../components/EmptyState.astro';
import Notice from '../../../components/Notice.astro';
import { apiBase } from '../../../lib/api';
import { readSessionToken, clearSessionCookie } from '../../../lib/session';
import type { ApiResponse } from '@goldplus/shared';

interface AuditRow {
  id: string;
  actorId: string | null;
  action: string;
  entity: string;
  entityId: string;
  createdAt: string;
}

const token = readSessionToken(Astro.request);
if (!token) {
  return Astro.redirect('/admin/login?returnTo=/admin/audit', 303);
}

let rows: AuditRow[] = [];
let fetchError: string | null = null;

try {
  const res = await fetch(`${apiBase}/admin/audit?limit=100`, {
    headers: { Authorization: `Bearer ${token}` },
  });
  if (res.status === 401 || res.status === 403) {
    Astro.response.headers.set('Set-Cookie', clearSessionCookie());
    return Astro.redirect('/admin/login?returnTo=/admin/audit', 303);
  }
  if (!res.ok) {
    fetchError = `Audit service responded with HTTP ${res.status}.`;
  } else {
    const json = (await res.json()) as ApiResponse<AuditRow[]>;
    if (json.success && Array.isArray(json.data)) rows = json.data;
    else fetchError = json.error?.message ?? 'Unexpected response.';
  }
} catch {
  fetchError = 'Cannot reach the audit service right now.';
}

const shortId = (id: string | null) => (id ? id.slice(0, 8) : '—');
---

<BaseLayout title="Audit log — Admin">
  <div class="container mx-auto px-4 lg:px-8 py-10">
    <AdminPageHeader
      title="Audit log"
      description="Every admin action and significant system event. Last 100 entries, newest first."
    />

    {fetchError && (
      <div class="mb-6">
        <Notice kind="not-configured" title="Audit service unavailable" message={fetchError} />
      </div>
    )}

    {rows.length === 0 && !fetchError ? (
      <EmptyState
        title="No audit entries yet"
        message="Admin actions and system events appear here as they happen."
      />
    ) : rows.length > 0 ? (
      <AdminTable caption={`Last ${rows.length} entries`}>
        <Fragment slot="head">
          <th class="px-6 py-4 text-[10px] uppercase font-black text-gray-500 tracking-widest">When</th>
          <th class="px-6 py-4 text-[10px] uppercase font-black text-gray-500 tracking-widest">Actor</th>
          <th class="px-6 py-4 text-[10px] uppercase font-black text-gray-500 tracking-widest">Action</th>
          <th class="px-6 py-4 text-[10px] uppercase font-black text-gray-500 tracking-widest">Entity</th>
          <th class="px-6 py-4 text-[10px] uppercase font-black text-gray-500 tracking-widest">Entity ID</th>
        </Fragment>
        {rows.map((r) => (
          <tr class="border-b border-gray-100 hover:bg-gray-50">
            <td class="px-6 py-3 text-xs text-brand-mutedGrey whitespace-nowrap">{new Date(r.createdAt).toLocaleString('en-GB')}</td>
            <td class="px-6 py-3 text-xs text-brand-mutedGrey font-mono" title={r.actorId ?? 'system'}>{shortId(r.actorId)}</td>
            <td class="px-6 py-3 font-bold text-brand-charcoal text-sm">{r.action}</td>
            <td class="px-6 py-3 text-xs text-brand-mutedGrey uppercase tracking-widest">{r.entity}</td>
            <td class="px-6 py-3 text-xs text-brand-mutedGrey font-mono" title={r.entityId}>{shortId(r.entityId)}</td>
          </tr>
        ))}
      </AdminTable>
    ) : null}
  </div>
</BaseLayout>
