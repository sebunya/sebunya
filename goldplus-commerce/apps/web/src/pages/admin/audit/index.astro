---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AdminPageHeader from '../../../components/AdminPageHeader.astro';
import AdminTable from '../../../components/AdminTable.astro';
import StatusBadge from '../../../components/StatusBadge.astro';
import EmptyState from '../../../components/EmptyState.astro';
import Notice from '../../../components/Notice.astro';
import { tryFetchAdminList } from '../../../lib/api';
import { SAMPLE_AUDIT_LOGS, type SampleAuditLog } from '../../../lib/sample-data';

const result = await tryFetchAdminList<SampleAuditLog>(
  '/governance/admin/audit',
  SAMPLE_AUDIT_LOGS,
  'System event audit trail showing fallback diagnostic data.',
);
---

<BaseLayout title="Audit Logs — Admin">
  <div class="container mx-auto px-4 lg:px-8 py-10">
    <AdminPageHeader
      title="Security Audit Logs"
      description="Monitor system-level alterations, developer login attempts and automated database migration triggers."
    />

    {result.isSample && (
      <div class="mb-6">
        <Notice kind="sample" message={result.reason} />
      </div>
    )}

    {result.items.length === 0 ? (
      <EmptyState
        title="Trail is empty"
        message="Critical actions have not initiated system log creation yet."
      />
    ) : (
      <AdminTable caption="Secure Operation Ledger">
        <Fragment slot="head">
          <th class="px-6 py-4 text-[10px] uppercase font-black text-gray-500 tracking-widest">Resource</th>
          <th class="px-6 py-4 text-[10px] uppercase font-black text-gray-500 tracking-widest">Action</th>
          <th class="px-6 py-4 text-[10px] uppercase font-black text-gray-500 tracking-widest">Actor</th>
          <th class="px-6 py-4 text-[10px] uppercase font-black text-gray-500 tracking-widest">Network IP</th>
          <th class="px-6 py-4 text-[10px] uppercase font-black text-gray-500 tracking-widest">Logged</th>
        </Fragment>
        {result.items.map((log) => (
          <tr class="border-b border-gray-100 hover:bg-gray-50 font-mono text-xs">
            <td class="px-6 py-4 font-bold text-brand-dark uppercase">{log.resource}</td>
            <td class="px-6 py-4 text-gray-700">
              <span class="bg-gray-100 px-2 py-1 rounded border border-gray-200">{log.action}</span>
            </td>
            <td class="px-6 py-4 text-gray-600 font-sans font-bold">{log.actor}</td>
            <td class="px-6 py-4 text-gray-500">{log.ipAddress}</td>
            <td class="px-6 py-4 text-gray-500 font-sans">{new Date(log.createdAt).toLocaleString('en-GB')}</td>
          </tr>
        ))}
      </AdminTable>
    )}
  </div>
</BaseLayout>
