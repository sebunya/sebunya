---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { readSessionToken } from "../../../lib/session";
import { apiBase } from "../../../lib/api";

const token = readSessionToken(Astro.request);
if (!token) {
  return Astro.redirect("/admin/login?returnTo=/admin/fulfilment", 303);
}

const headers = { Authorization: `Bearer ${token}`, "Content-Type": "application/json" };

// Lifecycle (Section 9.3). Terminal states never transition further.
const ALL_STATUSES = [
  "NEW", "ACKNOWLEDGED", "PICKING", "PACKED",
  "READY_FOR_DISPATCH", "OUT_FOR_DELIVERY", "DELIVERED", "CANCELLED", "ON_HOLD",
] as const;
type Status = (typeof ALL_STATUSES)[number];

const FORWARD: Record<Status, Status[]> = {
  NEW: ["ACKNOWLEDGED", "PICKING"],
  ACKNOWLEDGED: ["PICKING"],
  PICKING: ["PACKED"],
  PACKED: ["READY_FOR_DISPATCH"],
  READY_FOR_DISPATCH: ["OUT_FOR_DELIVERY"],
  OUT_FOR_DELIVERY: ["DELIVERED"],
  DELIVERED: [],
  CANCELLED: [],
  ON_HOLD: ["ACKNOWLEDGED", "PICKING", "PACKED", "READY_FOR_DISPATCH", "OUT_FOR_DELIVERY"],
};
function nextActions(from: Status): Status[] {
  const opts = new Set<Status>(FORWARD[from] ?? []);
  if (from !== "DELIVERED" && from !== "CANCELLED") {
    if (from !== "ON_HOLD") opts.add("ON_HOLD");
    opts.add("CANCELLED");
  }
  return [...opts];
}

// The signed-in admin's id, read from the session JWT `sub` claim, used for
// "assign to me". Decode only (no verification) — this is a display convenience;
// the API re-authenticates and authorises every mutation.
let currentUserId = "";
try {
  const payload = token.split(".")[1];
  if (payload) {
    const json = JSON.parse(Buffer.from(payload, "base64url").toString("utf8"));
    if (typeof json.sub === "string") currentUserId = json.sub;
  }
} catch { /* non-fatal */ }

let notice: { kind: "success" | "error"; text: string } | null = null;

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const id = String(form.get("id") || "");
  const action = String(form.get("action") || "status");
  try {
    let endpoint = `${apiBase}/admin/fulfilment/${encodeURIComponent(id)}/status`;
    let payload: Record<string, unknown> = {};
    let okText = "Updated.";
    if (action === "assign") {
      endpoint = `${apiBase}/admin/fulfilment/${encodeURIComponent(id)}/assign`;
      const assignee = String(form.get("assignedTo") || "").trim();
      payload = { assignedTo: assignee || null };
      okText = assignee ? "Task assigned." : "Task unassigned.";
    } else if (action === "priority") {
      endpoint = `${apiBase}/admin/fulfilment/${encodeURIComponent(id)}/priority`;
      payload = { priority: String(form.get("priority") || "normal") };
      okText = "Priority updated.";
    } else {
      const notes = String(form.get("notes") || "").trim();
      payload = { toStatus: String(form.get("toStatus") || ""), notes: notes || undefined };
      okText = "Order stage updated.";
    }
    const res = await fetch(endpoint, { method: "PATCH", headers, body: JSON.stringify(payload) });
    const json = await res.json().catch(() => null);
    notice = json?.success
      ? { kind: "success", text: json.data?.to ? `Order moved to ${json.data.to}.` : okText }
      : { kind: "error", text: json?.error?.message || "Could not update the fulfilment task." };
  } catch {
    notice = { kind: "error", text: "Fulfilment service is unreachable right now." };
  }
}

const statusFilter = Astro.url.searchParams.get("status") || "";

interface ItemLine { sku: string; name: string; quantity: number; unitPriceUgx: number; lineTotalUgx: number; }
interface Task {
  id: string; orderNumber: string; status: Status; paymentStatus: string; paymentMethod: string | null;
  customerName: string; customerContactMasked: string; deliveryArea: string; deliverySummary: string;
  totalUgx: number; deliveryFeeUgx: number; itemCount: number; items: ItemLine[]; warnings: string[];
  priority: "low" | "normal" | "high" | "urgent"; slaDueAt: string; assignedTo: string | null;
  overdue: boolean; createdAt: string;
}
let tasks: Task[] = [];
let total = 0;
let badge = 0;
let overdueBadge = 0;
let loadFailed = false;
let apiError = "";
try {
  const listUrl = statusFilter
    ? `${apiBase}/admin/fulfilment?status=${encodeURIComponent(statusFilter)}`
    : `${apiBase}/admin/fulfilment?activeOnly=true`;
  const [listRes, badgeRes] = await Promise.all([
    fetch(listUrl, { headers }),
    fetch(`${apiBase}/admin/fulfilment/badge`, { headers }),
  ]);
  const listJson = await listRes.json().catch(() => null);
  const badgeJson = await badgeRes.json().catch(() => null);
  if (listJson?.success) {
    tasks = listJson.data.tasks;
    total = listJson.data.total;
  } else {
    loadFailed = true;
    apiError = `Queue query responded with HTTP ${listRes.status}.`;
  }
  if (badgeJson?.success) {
    badge = badgeJson.data.newOrders;
    overdueBadge = badgeJson.data.overdue ?? 0;
  }
} catch {
  loadFailed = true;
  apiError = "Fulfilment API is currently unreachable.";
}

const ugx = new Intl.NumberFormat("en-UG", { style: "currency", currency: "UGX", maximumFractionDigits: 0 });

function statusChip(s: string) {
  switch (s) {
    case "NEW": return "bg-amber-50 text-amber-800 border-amber-200";
    case "ACKNOWLEDGED": return "bg-blue-50 text-blue-700 border-blue-200";
    case "PICKING":
    case "PACKED": return "bg-indigo-50 text-indigo-700 border-indigo-200";
    case "READY_FOR_DISPATCH":
    case "OUT_FOR_DELIVERY": return "bg-violet-50 text-violet-700 border-violet-200";
    case "DELIVERED": return "bg-green-50 text-green-700 border-green-200";
    case "CANCELLED": return "bg-red-50 text-red-700 border-red-200";
    case "ON_HOLD": return "bg-gray-100 text-gray-600 border-gray-200";
    default: return "bg-gray-50 text-gray-600 border-gray-200";
  }
}
function payChip(s: string) {
  return s === "paid"
    ? "bg-green-50 text-green-700 border-green-200"
    : s === "failed"
      ? "bg-red-50 text-red-700 border-red-200"
      : "bg-orange-50 text-orange-700 border-orange-200";
}
function prioChip(p: string) {
  switch (p) {
    case "urgent": return "bg-red-50 text-red-700 border-red-200";
    case "high": return "bg-orange-50 text-orange-700 border-orange-200";
    case "low": return "bg-gray-50 text-gray-500 border-gray-200";
    default: return "bg-slate-50 text-slate-600 border-slate-200";
  }
}
const PRIORITIES = ["low", "normal", "high", "urgent"] as const;
---

<AdminLayout
  title="Fulfilment Queue"
  description="Actionable New Orders queue: every placed order, its products, truthful payment status, and lifecycle transitions."
>
  <div class="container mx-auto px-6 lg:px-8 max-w-7xl">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between mb-8 gap-4 pb-6 border-b border-gray-200">
      <div>
        <h2 class="text-2xl font-black text-brand-dark tracking-tight">Fulfilment Queue</h2>
        <p class="text-sm text-gray-500 mt-1">Every successfully placed order becomes one actionable work item here — pick, pack, dispatch, deliver.</p>
      </div>
      <div class="flex items-center gap-2">
        <span class="bg-amber-50 text-amber-800 border border-amber-200 text-xs font-bold px-3 py-1.5 rounded-lg font-mono">
          NEW ORDERS: {badge}
        </span>
        <span class={`text-xs font-bold px-3 py-1.5 rounded-lg font-mono border ${overdueBadge > 0 ? "bg-red-50 text-red-700 border-red-200" : "bg-gray-100 text-gray-600 border-gray-200"}`}>
          OVERDUE: {overdueBadge}
        </span>
        <span class="bg-gray-100 text-gray-600 border border-gray-200 text-xs font-bold px-3 py-1.5 rounded-lg font-mono">
          SHOWING: {total}
        </span>
      </div>
    </div>

    {notice && (
      <div class={`px-6 py-4 rounded-2xl mb-6 text-sm font-semibold ${notice.kind === "success" ? "bg-green-50 border border-green-200 text-green-800" : "bg-red-50 border border-red-200 text-red-800"}`}>
        {notice.text}
      </div>
    )}

    {loadFailed && (
      <div class="bg-red-50 border border-red-200 text-red-800 px-6 py-4 rounded-2xl mb-6 text-sm">
        <strong>Fulfilment queue unavailable.</strong> {apiError}
      </div>
    )}

    <form method="GET" class="flex flex-wrap items-end gap-3 mb-8">
      <div>
        <label for="status" class="block text-[10px] font-black uppercase tracking-wider text-gray-400 mb-1.5">Filter by stage</label>
        <select name="status" id="status" class="bg-gray-50 border border-gray-200 rounded-xl px-4 py-2.5 text-xs font-bold text-brand-dark outline-none focus:border-brand-gold">
          <option value="" selected={statusFilter === ""}>Active (all open)</option>
          {ALL_STATUSES.map((s) => <option value={s} selected={statusFilter === s}>{s.replace(/_/g, " ")}</option>)}
        </select>
      </div>
      <button type="submit" class="bg-brand-dark text-white text-xs font-bold px-5 py-2.5 rounded-xl hover:opacity-90 transition-opacity">Apply</button>
    </form>

    {!loadFailed && tasks.length === 0 && (
      <div class="bg-white border border-gray-200 rounded-2xl p-10 text-center text-gray-500 text-sm">
        No orders in this stage yet. New orders appear here the moment a customer checks out.
      </div>
    )}

    <div class="space-y-4">
      {tasks.map((task) => (
        <div class="bg-white border border-gray-200 rounded-2xl p-6 shadow-sm">
          <div class="flex flex-wrap items-start justify-between gap-3 mb-4">
            <div>
              <div class="flex items-center gap-2 flex-wrap">
                <span class="font-mono font-black text-brand-dark">{task.orderNumber}</span>
                <span class={`text-[10px] font-black uppercase tracking-wider px-2.5 py-1 rounded-lg border ${statusChip(task.status)}`}>{task.status.replace(/_/g, " ")}</span>
                <span class={`text-[10px] font-black uppercase tracking-wider px-2.5 py-1 rounded-lg border ${payChip(task.paymentStatus)}`}>PAYMENT: {task.paymentStatus}</span>
                <span class={`text-[10px] font-black uppercase tracking-wider px-2.5 py-1 rounded-lg border ${prioChip(task.priority)}`}>{task.priority}</span>
                {task.overdue && (
                  <span class="text-[10px] font-black uppercase tracking-wider px-2.5 py-1 rounded-lg border bg-red-600 text-white border-red-700">OVERDUE</span>
                )}
              </div>
              <p class="text-xs text-gray-500 mt-1.5">
                {task.customerName} · {task.customerContactMasked} · {task.deliverySummary || task.deliveryArea}
              </p>
              <p class="text-[11px] text-gray-400 mt-1">
                SLA due {new Date(task.slaDueAt).toLocaleString("en-UG")} · {task.assignedTo ? (task.assignedTo === currentUserId ? "assigned to you" : "assigned") : "unassigned"}
              </p>
            </div>
            <div class="text-right">
              <div class="text-sm font-black text-brand-dark">{ugx.format(task.totalUgx)}</div>
              <div class="text-[11px] text-gray-400">delivery {ugx.format(task.deliveryFeeUgx)} · {task.itemCount} item{task.itemCount === 1 ? "" : "s"}</div>
            </div>
          </div>

          <div class="border border-gray-100 rounded-xl overflow-hidden mb-4">
            <table class="w-full text-xs">
              <thead class="bg-gray-50 text-gray-400">
                <tr>
                  <th class="text-left font-black uppercase tracking-wider px-4 py-2">Product</th>
                  <th class="text-left font-black uppercase tracking-wider px-4 py-2">SKU</th>
                  <th class="text-right font-black uppercase tracking-wider px-4 py-2">Qty</th>
                  <th class="text-right font-black uppercase tracking-wider px-4 py-2">Unit</th>
                  <th class="text-right font-black uppercase tracking-wider px-4 py-2">Line</th>
                </tr>
              </thead>
              <tbody>
                {task.items.map((it) => (
                  <tr class="border-t border-gray-100">
                    <td class="px-4 py-2 font-semibold text-brand-dark">{it.name}</td>
                    <td class="px-4 py-2 font-mono text-gray-500">{it.sku}</td>
                    <td class="px-4 py-2 text-right">{it.quantity}</td>
                    <td class="px-4 py-2 text-right">{ugx.format(it.unitPriceUgx)}</td>
                    <td class="px-4 py-2 text-right font-semibold">{ugx.format(it.lineTotalUgx)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          {task.warnings.length > 0 && (
            <ul class="mb-4 space-y-1">
              {task.warnings.map((w) => (
                <li class="text-[11px] text-orange-700 bg-orange-50 border border-orange-200 rounded-lg px-3 py-1.5">⚠ {w}</li>
              ))}
            </ul>
          )}

          {nextActions(task.status).length > 0 ? (
            <form method="POST" class="flex flex-wrap items-end gap-3">
              <input type="hidden" name="id" value={task.id} />
              <div>
                <label class="block text-[10px] font-black uppercase tracking-wider text-gray-400 mb-1.5">Move to</label>
                <select name="toStatus" class="bg-gray-50 border border-gray-200 rounded-xl px-4 py-2.5 text-xs font-bold text-brand-dark outline-none focus:border-brand-gold">
                  {nextActions(task.status).map((s) => <option value={s}>{s.replace(/_/g, " ")}</option>)}
                </select>
              </div>
              <div class="flex-1 min-w-[180px]">
                <label class="block text-[10px] font-black uppercase tracking-wider text-gray-400 mb-1.5">Note (optional)</label>
                <input type="text" name="notes" maxlength="2000" placeholder="e.g. packed, awaiting boda" class="w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-2.5 text-xs font-bold text-brand-dark placeholder-gray-300 outline-none focus:border-brand-gold" />
              </div>
              <button type="submit" class="bg-brand-gold text-brand-dark text-xs font-black px-5 py-2.5 rounded-xl hover:opacity-90 transition-opacity">Update</button>
            </form>

            <div class="flex flex-wrap items-end gap-3 mt-3 pt-3 border-t border-gray-100">
              <form method="POST" class="flex items-end gap-2">
                <input type="hidden" name="id" value={task.id} />
                <input type="hidden" name="action" value="priority" />
                <div>
                  <label class="block text-[10px] font-black uppercase tracking-wider text-gray-400 mb-1.5">Priority</label>
                  <select name="priority" class="bg-gray-50 border border-gray-200 rounded-xl px-4 py-2.5 text-xs font-bold text-brand-dark outline-none focus:border-brand-gold">
                    {PRIORITIES.map((p) => <option value={p} selected={p === task.priority}>{p}</option>)}
                  </select>
                </div>
                <button type="submit" class="bg-gray-100 text-brand-dark text-xs font-bold px-4 py-2.5 rounded-xl hover:bg-gray-200 transition-colors">Set</button>
              </form>

              <form method="POST" class="flex items-end gap-2">
                <input type="hidden" name="id" value={task.id} />
                <input type="hidden" name="action" value="assign" />
                <input type="hidden" name="assignedTo" value={task.assignedTo === currentUserId ? "" : currentUserId} />
                <button type="submit" class="bg-gray-100 text-brand-dark text-xs font-bold px-4 py-2.5 rounded-xl hover:bg-gray-200 transition-colors">
                  {task.assignedTo === currentUserId ? "Unassign me" : "Assign to me"}
                </button>
              </form>
            </div>
          ) : (
            <p class="text-[11px] font-bold uppercase tracking-wider text-gray-400">Terminal state — no further action.</p>
          )}
        </div>
      ))}
    </div>
  </div>
</AdminLayout>
