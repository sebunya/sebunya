---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { readSessionToken } from "../../../lib/session";
import { apiBase } from "../../../lib/api";

/**
 * The delivery Control Centre (brief PART 6).
 *
 * One surface, not settings scattered across the back office. What lives here
 * is the state of the module — is it quoting, on whose numbers, what is waiting
 * on a human — and the two ops queues that each represent an observation the
 * model will not get unless someone acts.
 *
 * Every field shows its tier. Tier 3 values are absent entirely, because the
 * registry endpoint filters them out before this page ever sees them.
 */

const token = readSessionToken(Astro.request);
if (!token) return Astro.redirect("/admin/login?returnTo=/admin/delivery", 303);
const headers = { Authorization: `Bearer ${token}`, "Content-Type": "application/json" };

let notice: { kind: "success" | "error"; text: string } | null = null;
// Corridor file round trip (0189): the pasted CSV stays in the box across the dry run, and the dry run's result
// (with its confirmation digest) is what the Apply button sends back.
let corridorCsvText = "";
let corridorDryRun: any = null;
// Fee ladder dry run (§4.5): the rungs stay in the box; the result is read-only.
let ladderText = "";
let ladderDryRun: any = null;
// Switches (2026-10-16): string settings published through the same draft → preview → publish path as the numbers.
let switchesPreview: any = null;
let switchesVersionId = "";

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const intent = String(form.get("intent") || "");
  try {
    if (intent === "revert") {
      const res = await fetch(`${apiBase}/admin/delivery/config/revert`, {
        method: "POST",
        headers,
        body: JSON.stringify({
          toVersionId: String(form.get("toVersionId") || ""),
          reason: String(form.get("reason") || "").trim(),
        }),
      });
      const json = await res.json().catch(() => null);
      notice = json?.success
        ? { kind: "success", text: "Reverted. The earlier values are live again, as a new version — the history still shows what was published in between." }
        : { kind: "error", text: json?.error?.message || "Could not revert." };
    } else if (intent === "corridor-dry-run" || intent === "corridor-apply") {
      corridorCsvText = String(form.get("csv") || "");
      const path = intent === "corridor-apply" ? "/admin/delivery/corridors/apply" : "/admin/delivery/corridors/dry-run";
      const res = await fetch(`${apiBase}${path}`, {
        method: "POST",
        headers,
        body: JSON.stringify({ csv: corridorCsvText, confirmation: String(form.get("confirmation") || ""), reason: String(form.get("reason") || "").trim() }),
      });
      const json = await res.json().catch(() => null);
      if (intent === "corridor-apply") {
        notice = json?.success
          ? { kind: "success", text: `Applied: ${json.data.applied} field change(s) across ${json.data.areas} area(s), as one audited change (batch ${json.data.batchId}). To undo it, revert that batch.` }
          : { kind: "error", text: json?.error?.message || "Could not apply the file." };
        corridorDryRun = null;
        if (json?.success) corridorCsvText = "";
      } else {
        corridorDryRun = json?.success ? json.data : null;
        if (!corridorDryRun) notice = { kind: "error", text: json?.error?.message || "Could not dry-run the file." };
      }
    } else if (intent === "switches-preview") {
      const roads: string[] = [];
      for (const [k, v] of form.entries()) {
        if (k.startsWith("road:") && String(v) && String(v) !== "inherit") roads.push(`${k.slice(5)}=${String(v)}`);
      }
      const stringValues: Record<string, string> = {
        own_rider_max_band: String(form.get("own_rider_max_band") || ""),
        own_rider_max_band_by_corridor: roads.length ? roads.join(", ") : "none",
        distance_source: String(form.get("distance_source") || ""),
        fee_shape: String(form.get("fee_shape") || ""),
      };
      const ladder = String(form.get("fee_ladder") || "").trim();
      if (ladder) stringValues.fee_ladder = ladder;
      for (const k of Object.keys(stringValues)) if (!stringValues[k]) delete stringValues[k];
      const draft = await fetch(`${apiBase}/admin/delivery/config/draft`, {
        method: "POST", headers,
        body: JSON.stringify({ values: {}, stringValues, reason: String(form.get("reason") || "").trim() || "Switches changed on the Control Centre" }),
      });
      const dj: any = await draft.json().catch(() => null);
      if (!dj?.success) notice = { kind: "error", text: dj?.error?.message || "Could not draft those switches." };
      else {
        switchesVersionId = dj.data.versionId;
        const pv = await fetch(`${apiBase}/admin/delivery/config/${encodeURIComponent(switchesVersionId)}/preview`, { headers });
        const pj: any = await pv.json().catch(() => null);
        switchesPreview = pj?.success ? pj.data : null;
        if (!switchesPreview) notice = { kind: "error", text: pj?.error?.message || "Drafted, but the preview could not be produced." };
      }
    } else if (intent === "switches-publish") {
      const id = String(form.get("versionId") || "");
      const res = await fetch(`${apiBase}/admin/delivery/config/${encodeURIComponent(id)}/publish`, { method: "POST", headers, body: JSON.stringify({ previewConfirmed: true }) });
      const json: any = await res.json().catch(() => null);
      notice = json?.success ? { kind: "success", text: "Published. The switches are live on the next quote." } : { kind: "error", text: json?.error?.message || "Could not publish." };
    } else if (intent === "ladder-dry-run") {
      ladderText = String(form.get("ladder") || "");
      const res = await fetch(`${apiBase}/admin/delivery/ladder/dry-run`, { method: "POST", headers, body: JSON.stringify({ ladder: ladderText }) });
      const json = await res.json().catch(() => null);
      ladderDryRun = json?.success ? json.data : null;
      if (!ladderDryRun) notice = { kind: "error", text: json?.error?.message || "Could not run the ladder." };
    } else if (intent === "actual-cost") {
      const res = await fetch(`${apiBase}/admin/delivery/orders/${encodeURIComponent(String(form.get("orderId") || ""))}/actual-cost`, {
        method: "POST",
        headers,
        body: JSON.stringify({
          actualRiderCostUgx: Number(String(form.get("actualRiderCostUgx") || "").replace(/[,\s]/g, "")),
          note: String(form.get("note") || "").trim() || null,
        }),
      });
      const json = await res.json().catch(() => null);
      notice = json?.success
        ? { kind: "success", text: "Rider cost recorded. That is one real observation the model now has." }
        : { kind: "error", text: json?.error?.message || "Could not record the cost." };
    }
  } catch {
    notice = { kind: "error", text: "The delivery service is unreachable right now." };
  }
}

const get = async (path: string) => {
  try {
    const res = await fetch(`${apiBase}${path}`, { headers });
    const json = await res.json().catch(() => null);
    return json?.success ? json.data : null;
  } catch {
    return null;
  }
};

const [setup, queues, versions, registry, corridorSummary] = await Promise.all([
  get("/admin/delivery/setup"),
  get("/admin/delivery/awaiting-cost"),
  get("/admin/delivery/config/versions"),
  get("/admin/delivery/config-registry"),
  get("/admin/delivery/corridors/summary"),
]);
const liveValue = (key: string): string => String((registry ?? []).find((e: any) => e.key === key)?.current ?? "");
const roadCeilings: Record<string, string> = {};
for (const part of liveValue("own_rider_max_band_by_corridor").split(/[,;]+/)) {
  const m = /^\s*([a-z0-9_]+)\s*[=:]\s*(B[0-6])\s*$/i.exec(part);
  if (m) roadCeilings[m[1].toLowerCase()] = m[2].toUpperCase();
}
const BANDS = ["B0", "B1", "B2", "B3", "B4", "B5", "B6"];

// Variances waiting on a customer. NOTHING dispatches on these until answered,
// so it sits at the top of the queues rather than in a report.
const pendingVariance = await get("/admin/delivery/variance/pending");

const ugx = (n: number | null) => (n === null || n === undefined ? "—" : `UGX ${Math.round(n).toLocaleString("en-UG", { timeZone: 'Africa/Kampala' })}`);
const tierLabel: Record<number, string> = { 1: "One approver", 2: "Needs a second person" };
---

<AdminLayout title="Delivery" description="Delivery pricing, calibration and the ops queues.">
  <div class="container mx-auto px-6 lg:px-8 max-w-5xl pb-16">
    <div class="mb-8 pb-6 border-b border-gray-200 flex flex-wrap items-start justify-between gap-4">
      <div>
        <h2 class="text-2xl font-black text-brand-dark tracking-tight">Delivery</h2>
        <p class="text-sm text-gray-500 mt-1 max-w-2xl">
          What we charge to deliver, how long we promise, and everything the model is still waiting to learn.
        </p>
      </div>
      <div class="flex flex-wrap gap-2">
        <a href="/admin/delivery/calibration" class="border border-gray-300 text-gray-700 text-xs font-black uppercase tracking-widest px-4 py-2.5 rounded-lg hover:bg-gray-50">
          Calibration &amp; reports
        </a>
        <a href="/admin/delivery/riders" class="border border-gray-300 text-gray-700 text-xs font-black uppercase tracking-widest px-4 py-2.5 rounded-lg hover:bg-gray-50">
          Riders
        </a>
        <a href="/admin/delivery/bus-rates" class="border border-gray-300 text-gray-700 text-xs font-black uppercase tracking-widest px-4 py-2.5 rounded-lg hover:bg-gray-50">
          Bus prices
        </a>
        <a href="/admin/delivery/launch" class="bg-brand-dark text-white text-xs font-black uppercase tracking-widest px-4 py-2.5 rounded-lg hover:bg-black">
          {setup?.quotingEnabled ? "Change the prices" : "Set up delivery pricing"}
        </a>
      </div>
    </div>

    {notice && (
      <div class={`mb-6 rounded-xl border px-4 py-3 text-sm font-bold ${notice.kind === "success" ? "border-green-200 bg-green-50 text-green-700" : "border-red-200 bg-red-50 text-red-700"}`} role="status">
        {notice.text}
      </div>
    )}

    {!setup ? (
      <p class="text-sm text-gray-500 border border-dashed border-gray-300 rounded-lg px-4 py-3">
        The delivery service is not answering. Nothing is broken for customers — orders still complete
        and our team confirms the fee — but this page cannot show its state.
      </p>
    ) : (
      <>
        <section class={`rounded-2xl border px-5 py-4 mb-8 ${setup.quotingEnabled ? "border-green-200 bg-green-50" : "border-amber-200 bg-amber-50"}`}>
          <h3 class="text-sm font-black text-gray-800">
            {setup.quotingEnabled ? "Delivery pricing is live" : "Delivery pricing is not switched on"}
          </h3>
          <p class="text-xs text-gray-700 mt-1">
            {setup.quotingEnabled
              ? `${setup.corridors.areas} areas priced automatically. ${setup.corridors.water} lake areas are pickup only and ${setup.corridors.unserviceable} are not served.`
              : setup.blockedBy === "NO_ACTIVE_ORIGIN"
                ? "No dispatch point is active, so nothing can be quoted from anywhere. This is an internal fault, not a data gap."
                : "Every customer is told our team will confirm the fee before dispatch. Orders complete normally and no fee is guessed."}
          </p>
        </section>

        <section class="bg-white border border-gray-200 rounded-2xl shadow-sm p-6 mb-8">
          <h3 class="text-sm font-black uppercase tracking-widest text-gray-500 mb-3">The numbers that switch it on</h3>
          <div class="space-y-2">
            {setup.launchValues.map((v: any) => (
              <div class="flex flex-wrap items-baseline justify-between gap-2 border border-gray-100 rounded-lg px-3 py-2">
                <div class="min-w-[200px]">
                  <span class="text-sm font-bold text-gray-800">{v.label}</span>
                  <span class="block text-[11px] text-gray-500">{v.help}</span>
                </div>
                <span class={`text-sm font-black ${v.set ? "text-brand-dark" : "text-amber-700"}`}>
                  {v.set ? `${v.value}${v.unit ? ` ${v.unit}` : ""}` : "not set"}
                </span>
              </div>
            ))}
          </div>
        </section>

        {pendingVariance && pendingVariance.count > 0 && (
          <section class="rounded-2xl border border-amber-300 bg-amber-50 p-6 mb-8">
            <h3 class="text-sm font-black uppercase tracking-widest text-amber-900 mb-1">
              {pendingVariance.count} order(s) waiting on a customer's answer
            </h3>
            <p class="text-xs text-amber-900 mb-3">{pendingVariance.note}</p>
            <ul class="text-xs text-amber-900 space-y-1">
              {pendingVariance.pending.map((v: any) => (
                <li class="font-mono">
                  {v.orderId} — {v.oldFeeUgx.toLocaleString("en-UG", { timeZone: 'Africa/Kampala' })} → {v.newFeeUgx.toLocaleString("en-UG", { timeZone: 'Africa/Kampala' })} UGX ({v.reason})
                </li>
              ))}
            </ul>
          </section>
        )}

        <section class="bg-white border border-gray-200 rounded-2xl shadow-sm p-6 mb-8">
          <div class="flex flex-wrap items-baseline justify-between gap-2 mb-1">
            <h3 class="text-sm font-black uppercase tracking-widest text-gray-500">Deliveries waiting for a cost</h3>
            <span class="text-[10px] font-bold text-gray-500">{queues?.counts?.awaitingCost ?? 0} waiting</span>
          </div>
          <p class="text-xs text-gray-500 mb-4">
            Every delivered order needs what the rider was actually paid. Without it the model cannot
            learn whether we are charging enough, and it is the only number nobody else can supply.
          </p>
          {(!queues || queues.awaitingCost.length === 0) ? (
            <p class="text-sm text-gray-500 border border-dashed border-gray-300 rounded-lg px-4 py-3">
              Nothing waiting. No order has been delivered yet, so there is no rider cost to record —
              this queue fills the day the first delivery completes.
            </p>
          ) : (
            <div class="space-y-2">
              {queues.awaitingCost.map((r: any) => (
                <form method="POST" class="flex flex-wrap items-end gap-2 border border-gray-100 rounded-lg px-3 py-2">
                  <input type="hidden" name="intent" value="actual-cost" />
                  <input type="hidden" name="orderId" value={r.orderId} />
                  <div class="flex-1 min-w-[160px]">
                    <span class="block text-xs font-bold text-gray-700">{r.areaSlug ?? "area unknown"}</span>
                    <span class="block text-[10px] text-gray-500 font-mono">{r.orderId}</span>
                  </div>
                  <label class="block">
                    <span class="text-[10px] uppercase font-black text-gray-500 tracking-widest">Paid the rider</span>
                    <input name="actualRiderCostUgx" inputmode="numeric" required
                      class="mt-0.5 w-32 rounded-lg border border-gray-300 px-3 py-2 text-sm" />
                  </label>
                  <button type="submit" class="bg-brand-dark text-white text-[10px] font-black uppercase tracking-widest px-3 py-2.5 rounded-lg hover:bg-black">Record</button>
                </form>
              ))}
            </div>
          )}

          {queues?.skippedMirrors?.length > 0 && (
            <div class="mt-5 rounded-xl border border-amber-200 bg-amber-50 px-4 py-3">
              <h4 class="text-xs font-black text-amber-900 mb-1">{queues.counts.skippedMirrors} deliveries never reached "delivered"</h4>
              <p class="text-[11px] text-amber-900 mb-2">{queues.note}</p>
              <ul class="text-[11px] text-amber-900 space-y-1">
                {queues.skippedMirrors.map((m: any) => (
                  <li class="font-mono">{m.order_number ?? m.fulfilment_task_id} — was {m.order_status_now}, {m.payment_status}</li>
                ))}
              </ul>
            </div>
          )}
        </section>

        <section class="bg-white border border-gray-200 rounded-2xl shadow-sm p-6 mb-8">
          <h3 class="text-sm font-black uppercase tracking-widest text-gray-500 mb-1">Switches</h3>
          <p class="text-xs text-gray-500 mb-3">
            How far the rider goes (shop-wide and per road), which distance prices are worked out from, and the fee shape. Preview first:
            one real area per band with the fee a customer would see. Publishing makes a new version, revertible from the history below.
          </p>
          <form method="POST" class="space-y-4">
            <input type="hidden" name="intent" value="switches-preview" />
            <div class="grid sm:grid-cols-3 gap-3">
              <label class="block text-xs text-gray-700">Rider goes out to (shop-wide)
                <select name="own_rider_max_band" class="mt-1 w-full border border-gray-300 rounded-lg px-3 py-2 text-sm">
                  <option value="">— unset —</option>
                  {BANDS.map((b) => <option value={b} selected={liveValue("own_rider_max_band") === b}>{b}</option>)}
                </select>
              </label>
              <label class="block text-xs text-gray-700">Distance the fee uses
                <select name="distance_source" class="mt-1 w-full border border-gray-300 rounded-lg px-3 py-2 text-sm">
                  {["band_midpoint", "measured"].map((v) => <option value={v} selected={(liveValue("distance_source") || "band_midpoint") === v}>{v === "measured" ? "measured (each area's point)" : "band midpoint"}</option>)}
                </select>
              </label>
              <label class="block text-xs text-gray-700">Fee shape
                <select name="fee_shape" class="mt-1 w-full border border-gray-300 rounded-lg px-3 py-2 text-sm">
                  {["continuous", "ladder"].map((v) => <option value={v} selected={(liveValue("fee_shape") || "continuous") === v}>{v}</option>)}
                </select>
              </label>
              <label class="block text-xs text-gray-700 sm:col-span-3">Ladder rungs, UGX (only read when the shape is ladder)
                <input name="fee_ladder" value={liveValue("fee_ladder")} placeholder="5000, 7500, 10000, 13000" class="mt-1 w-full border border-gray-300 rounded-lg px-3 py-2 text-sm font-mono" />
              </label>
            </div>
            <div>
              <p class="text-xs font-bold text-gray-800 mb-1">Per road: the last band a rider serves on that corridor</p>
              <p class="text-[11px] text-gray-500 mb-2">"Same as shop-wide" leaves the road on the setting above. Areas beyond a road's limit ship by bus.</p>
              {!corridorSummary || corridorSummary.corridors.length === 0 ? (
                <p class="text-xs text-gray-500">The corridor list is unavailable right now.</p>
              ) : (
                <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-2">
                  {corridorSummary.corridors.map((r: any) => (
                    <label class="flex items-center justify-between gap-2 border border-gray-200 rounded-lg px-3 py-2 text-xs">
                      <span><span class="font-bold text-gray-800">{String(r.corridor).replace(/_rd$/, " Road").replace(/_/g, " ")}</span>
                        <span class="block text-[10px] text-gray-500">{r.areas} areas, {r.nearestBand}–{r.farthestBand}</span></span>
                      <select name={`road:${r.corridor}`} class="border border-gray-300 rounded-lg px-2 py-1 text-xs">
                        <option value="inherit" selected={!roadCeilings[r.corridor]}>Same as shop-wide</option>
                        {BANDS.map((b) => <option value={b} selected={roadCeilings[r.corridor] === b}>{b}</option>)}
                      </select>
                    </label>
                  ))}
                </div>
              )}
            </div>
            <div class="flex flex-wrap items-end gap-2">
              <label class="block text-xs text-gray-700 grow">Why (kept with the version)
                <input name="reason" required minlength="5" maxlength="200" placeholder="e.g. riders now go to Mukono town on Jinja Road" class="mt-1 w-full border border-gray-300 rounded-lg px-3 py-2 text-xs" />
              </label>
              <button type="submit" class="bg-brand-dark text-white text-[10px] font-black uppercase tracking-widest px-3 py-2.5 rounded-lg hover:bg-black">Preview</button>
            </div>
          </form>
          {switchesPreview && (
            <div class="mt-4 border border-gray-200 rounded-lg p-4">
              <p class="text-sm font-bold text-gray-800">{switchesPreview.impactSummary}</p>
              <table class="w-full text-xs mt-2">
                <thead class="text-[10px] uppercase font-black tracking-widest text-gray-500"><tr><th class="text-left py-1">Band</th><th class="text-left py-1">Area</th><th class="text-right py-1">Fee</th></tr></thead>
                <tbody>{switchesPreview.bands.map((b: any) => <tr class="border-t border-gray-100"><td class="py-1">{b.band}</td><td class="py-1">{b.areaLabel}</td><td class="py-1 text-right">{b.feeUgx === null ? (b.reason ?? "—") : ugx(b.feeUgx)}</td></tr>)}</tbody>
              </table>
              {switchesPreview.problems?.length > 0 && <ul class="mt-2 text-xs text-red-700">{switchesPreview.problems.map((p: any) => <li>{p.message}</li>)}</ul>}
              <form method="POST" class="mt-3">
                <input type="hidden" name="intent" value="switches-publish" />
                <input type="hidden" name="versionId" value={switchesVersionId} />
                <button type="submit" class="bg-brand-dark text-white text-[10px] font-black uppercase tracking-widest px-3 py-2.5 rounded-lg hover:bg-black">Publish these switches</button>
              </form>
            </div>
          )}
        </section>

        <section class="bg-white border border-gray-200 rounded-2xl shadow-sm p-6 mb-8">
          <h3 class="text-sm font-black uppercase tracking-widest text-gray-500 mb-1">Corridor file</h3>
          <p class="text-xs text-gray-500 mb-3">
            Paste the corridor CSV (the parish import writes a re-band proposal in this shape). Dry run first: every changed and
            failing row, nothing written. Apply lands exactly what the dry run showed, as one audited change, and refuses a file
            that changed in between.
          </p>
          <form method="POST" class="space-y-3">
            <input type="hidden" name="intent" value="corridor-dry-run" />
            <textarea name="csv" rows="6" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-xs font-mono" placeholder="area_slug,postcode,delivery_zone,district,sub_county_or_division,area,corridor,distance_band,access_mode,serviceable,fulfilment_mode">{corridorCsvText}</textarea>
            <button type="submit" class="bg-brand-dark text-white text-[10px] font-black uppercase tracking-widest px-3 py-2.5 rounded-lg hover:bg-black">Dry run</button>
          </form>
          {corridorDryRun && (
            <div class="mt-4 border border-gray-200 rounded-lg p-4">
              <p class="text-sm font-bold text-gray-800">{corridorDryRun.summary}</p>
              {corridorDryRun.failures.length > 0 && (
                <ul class="mt-2 text-xs text-red-700 space-y-1">
                  {corridorDryRun.failures.slice(0, 50).map((f: any) => <li>line {f.line} ({f.areaSlug}): {f.problem}</li>)}
                </ul>
              )}
              {corridorDryRun.changes.length > 0 && (
                <ul class="mt-2 text-xs text-gray-700 space-y-1">
                  {corridorDryRun.changes.slice(0, 100).map((ch: any) => <li>{ch.areaSlug}: {ch.field} {ch.from} → {ch.to}</li>)}
                  {corridorDryRun.changes.length > 100 && <li class="text-gray-500">… and {corridorDryRun.changes.length - 100} more</li>}
                </ul>
              )}
              {corridorDryRun.confirmation && corridorDryRun.failures.length === 0 && (
                <form method="POST" class="mt-3">
                  <input type="hidden" name="intent" value="corridor-apply" />
                  <input type="hidden" name="confirmation" value={corridorDryRun.confirmation} />
                  <textarea name="csv" class="hidden" aria-hidden="true">{corridorCsvText}</textarea>
                  <label class="block text-xs text-gray-700 mb-2">Why (kept with the change)
                    <input name="reason" required minlength="5" maxlength="200" placeholder="e.g. parish points put Busabala in B3, dry run 2026-10-16" class="mt-1 w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" />
                  </label>
                  <button type="submit" class="bg-brand-dark text-white text-[10px] font-black uppercase tracking-widest px-3 py-2.5 rounded-lg hover:bg-black">
                    Apply these {corridorDryRun.changes.length} change(s)
                  </button>
                </form>
              )}
            </div>
          )}
        </section>

        <section class="bg-white border border-gray-200 rounded-2xl shadow-sm p-6 mb-8">
          <h3 class="text-sm font-black uppercase tracking-widest text-gray-500 mb-1">Fee ladder</h3>
          <p class="text-xs text-gray-500 mb-3">
            Your price points, lowest to highest. The dry run places every area on the lowest rung that covers the model's
            cost × margin and shows what changes. Nothing is written here: to go live, publish <code>fee_shape = ladder</code>
            and <code>fee_ladder</code> through the setup, like any other value. The margin alarm on the Calibration page watches each rung.
          </p>
          <form method="POST" class="flex flex-wrap items-end gap-2">
            <input type="hidden" name="intent" value="ladder-dry-run" />
            <label class="block text-xs text-gray-700 grow">Rungs (UGX)
              <input name="ladder" value={ladderText} required placeholder="3000, 5000, 8000, 12000, 20000" class="mt-1 w-full border border-gray-300 rounded-lg px-3 py-2 text-xs font-mono" />
            </label>
            <button type="submit" class="bg-brand-dark text-white text-[10px] font-black uppercase tracking-widest px-3 py-2.5 rounded-lg hover:bg-black">Dry run</button>
          </form>
          {ladderDryRun && (
            <div class="mt-4 border border-gray-200 rounded-lg p-4">
              <p class="text-sm font-bold text-gray-800">{ladderDryRun.summary}</p>
              {ladderDryRun.orderingFlags.length > 0 && (
                <ul class="mt-2 text-xs text-amber-800 space-y-1">
                  {ladderDryRun.orderingFlags.map((f: any) => <li>{f.nearer} ({f.nearerKm} km) would cost UGX {Number(f.nearerFee).toLocaleString('en-UG', { timeZone: 'Africa/Kampala' })}, more than {f.farther} ({f.fartherKm} km) at UGX {Number(f.fartherFee).toLocaleString('en-UG', { timeZone: 'Africa/Kampala' })}.</li>)}
                </ul>
              )}
              <div class="mt-3 max-h-80 overflow-auto">
                <table class="w-full text-xs">
                  <thead class="text-[10px] uppercase font-black tracking-widest text-gray-500"><tr><th class="text-left py-1">Area</th><th class="text-right py-1">km</th><th class="text-right py-1">Today</th><th class="text-right py-1">On the ladder</th></tr></thead>
                  <tbody>
                    {ladderDryRun.rows.map((r: any) => (
                      <tr class={`border-t border-gray-100 ${r.currentFeeUgx !== r.proposedRungUgx ? "font-bold" : ""} ${!r.covered ? "text-red-700" : ""}`}>
                        <td class="py-1">{r.label}</td>
                        <td class="py-1 text-right">{r.oneWayKm ?? "—"}</td>
                        <td class="py-1 text-right">{r.currentFeeUgx === null ? "—" : Number(r.currentFeeUgx).toLocaleString('en-UG', { timeZone: 'Africa/Kampala' })}</td>
                        <td class="py-1 text-right">{r.proposedRungUgx === null ? "—" : Number(r.proposedRungUgx).toLocaleString('en-UG', { timeZone: 'Africa/Kampala' })}{!r.covered ? " (above top rung)" : ""}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          )}
        </section>

        <section class="bg-white border border-gray-200 rounded-2xl shadow-sm p-6 mb-8">
          <h3 class="text-sm font-black uppercase tracking-widest text-gray-500 mb-3">Change history</h3>
          {!versions || versions.versions.length === 0 ? (
            <p class="text-sm text-gray-500 border border-dashed border-gray-300 rounded-lg px-4 py-3">
              Nothing has been published yet. The first version is created when you run the setup.
            </p>
          ) : (
            <div class="space-y-2">
              {versions.versions.map((v: any) => (
                <div class="flex flex-wrap items-center justify-between gap-3 border border-gray-100 rounded-lg px-3 py-2">
                  <div class="min-w-[240px]">
                    <span class={`text-[10px] font-black uppercase tracking-widest px-2 py-0.5 rounded ${v.id === versions.publishedVersionId ? "bg-green-100 text-green-700" : "bg-gray-100 text-gray-600"}`}>
                      {v.id === versions.publishedVersionId ? "Live" : v.status}
                    </span>
                    <span class="block text-xs text-gray-700 mt-1">{v.reason ?? "no reason recorded"}</span>
                    <span class="block text-[10px] text-gray-600">{new Date(v.createdAt).toLocaleString("en-UG", { timeZone: 'Africa/Kampala' })}</span>
                  </div>
                  {v.id !== versions.publishedVersionId && v.status !== "draft" && (
                    <form method="POST" class="flex items-end gap-2">
                      <input type="hidden" name="intent" value="revert" />
                      <input type="hidden" name="toVersionId" value={v.id} />
                      <input name="reason" required minlength="5" placeholder="Why revert?"
                        class="w-44 rounded-lg border border-gray-300 px-2 py-1.5 text-xs" />
                      <button type="submit" class="border border-gray-300 text-gray-700 text-[10px] font-black uppercase tracking-widest px-3 py-2 rounded-lg hover:bg-gray-50">Revert to this</button>
                    </form>
                  )}
                </div>
              ))}
            </div>
          )}
        </section>

        {registry && (
          <section class="bg-white border border-gray-200 rounded-2xl shadow-sm p-6">
            <h3 class="text-sm font-black uppercase tracking-widest text-gray-500 mb-1">Everything that can be changed</h3>
            <p class="text-xs text-gray-500 mb-4">
              Generated from the code registry, so this list cannot drift from what the module actually reads.
              Anything not shown here is fixed in code and changing it is a ticket.
            </p>
            <div class="overflow-x-auto">
              <table class="w-full text-sm border border-gray-200 rounded-lg overflow-hidden">
                <thead class="bg-gray-50 text-[10px] uppercase font-black tracking-widest text-gray-500">
                  <tr><th class="text-left px-3 py-2">Setting</th><th class="text-left px-3 py-2">Who can change it</th><th class="text-right px-3 py-2">Ships as</th></tr>
                </thead>
                <tbody>
                  {registry.map((e: any) => (
                    <tr class="border-t border-gray-100">
                      <td class="px-3 py-2">
                        <span class="font-bold text-gray-800">{e.label}</span>
                        <span class="block text-[11px] text-gray-500">{e.help}</span>
                      </td>
                      <td class="px-3 py-2 text-xs text-gray-600">{tierLabel[e.tier] ?? "—"}</td>
                      <td class="px-3 py-2 text-right text-xs text-gray-600">
                        {e.defaultValue === null ? <span class="text-amber-700 font-bold">unset</span> : String(e.defaultValue).slice(0, 40)}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        )}
      </>
    )}
  </div>
</AdminLayout>
