---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { readSessionToken } from "../../../lib/session";
import { seoGet, rowsOf, emptyReason, str, fmtWhen } from "../../../lib/adminSeo";

/** Integrations — every external provider the Organic Growth OS can use, its
 *  real status, the ENV VAR NAMES (never values) that unlock it, and what
 *  connecting it makes possible. Nothing is presumed connected. */
const token = readSessionToken(Astro.request);
if (!token) return Astro.redirect("/admin/login?returnTo=/admin/seo/integrations", 303);

type Integration = {
  provider?: string; name?: string; status?: string; envVars?: string[];
  lastSuccessAt?: string; lastFailureAt?: string; lastError?: string;
  unlocks?: string; description?: string;
};
const res = await seoGet(token, "/admin/seo/integrations");
const integrations = rowsOf<Integration>(res);
const reason = emptyReason(res, "Integration status not available yet");
---

<AdminLayout title="SEO Integrations" description="External data providers: connection status, required credentials and what each unlocks.">
  <div class="container mx-auto px-6 lg:px-8 max-w-7xl">
    <div class="mb-8 pb-6 border-b border-gray-200">
      <h2 class="text-2xl font-black text-brand-dark tracking-tight">Integrations</h2>
      <p class="text-sm text-gray-500 mt-1">
        External providers the Organic Growth OS can draw on. A provider is either <strong>CONNECTED</strong> and
        verified, or honestly <strong>READY_FOR_CREDENTIALS</strong> — the code path exists and activates the moment
        the named environment variables are set. Only variable <em>names</em> are shown here, never values.
      </p>
    </div>

    {reason && (
      <div role="status" class="rounded-xl border border-dashed border-gray-300 bg-gray-50 p-6 text-sm text-gray-600 mb-12">
        {reason} No provider is presumed connected in the meantime.
      </div>
    )}

    {integrations.length > 0 && (
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-12">
        {integrations.map((i) => (
          <section class="bg-white border border-gray-200 rounded-2xl p-6">
            <div class="flex items-center justify-between gap-3 mb-2">
              <h3 class="font-black text-brand-dark">{str(i.name ?? i.provider)}</h3>
              <span class={`rounded-full border px-3 py-1 text-xs font-bold ${
                i.status === "CONNECTED"
                  ? "border-emerald-300 bg-emerald-50 text-emerald-900"
                  : "border-amber-300 bg-amber-50 text-amber-900"
              }`}>{str(i.status)}</span>
            </div>
            {i.description && <p class="text-xs text-gray-500 mb-3">{str(i.description)}</p>}
            {Array.isArray(i.envVars) && i.envVars.length > 0 && (
              <p class="text-xs text-gray-600 mb-2">
                <strong class="uppercase tracking-widest text-[10px] text-gray-400 block">Required environment variables</strong>
                <code class="font-mono">{i.envVars.join(", ")}</code>
              </p>
            )}
            <div class="text-xs text-gray-500 mb-3 grid grid-cols-2 gap-2">
              <span><strong class="uppercase tracking-widest text-[10px] text-gray-400 block">Last success</strong>{fmtWhen(i.lastSuccessAt)}</span>
              <span><strong class="uppercase tracking-widest text-[10px] text-gray-400 block">Last failure</strong>{fmtWhen(i.lastFailureAt)}</span>
            </div>
            {i.lastError && <p class="text-xs text-red-800 bg-red-50 border border-red-200 rounded-lg p-2 mb-3">{str(i.lastError)}</p>}
            {i.unlocks && (
              <p class="text-xs text-gray-600 border-l-4 border-gray-200 pl-3">
                <strong class="uppercase tracking-widest text-[10px] text-gray-400 block">When connected</strong>
                {str(i.unlocks)}
              </p>
            )}
          </section>
        ))}
      </div>
    )}
  </div>
</AdminLayout>
