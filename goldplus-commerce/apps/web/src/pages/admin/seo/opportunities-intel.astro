---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { readSessionToken } from "../../../lib/session";
import { seoGet, emptyReason, str, num, pct, fmtWhen } from "../../../lib/adminSeo";

/** Organic Intelligence portfolio — the persisted opportunities, ranked, with
 *  the evidence that produced them. Provider absence renders as
 *  WAITING FOR PROVIDER, never as a zero: a page showing "0 impressions" when
 *  Search Console is simply not connected would mislead an operator into
 *  thinking demand had been measured and found absent. */
const token = readSessionToken(Astro.request);
if (!token) return Astro.redirect("/admin/login?returnTo=/admin/seo/opportunities-intel", 303);

const url = new URL(Astro.request.url);
const bucket = url.searchParams.get("bucket") ?? "";
const explain = url.searchParams.get("why") ?? "";

const [listRes, runsRes] = await Promise.all([
  seoGet<any[]>(token, `/admin/seo/workqueue/intel/opportunities${bucket ? `?bucket=${encodeURIComponent(bucket)}` : ""}`),
  seoGet<any[]>(token, "/admin/seo/workqueue/intel/runs"),
]);
const detailRes = explain
  ? await seoGet<any>(token, `/admin/seo/workqueue/intel/opportunities/${encodeURIComponent(explain)}/why`)
  : null;

const items = Array.isArray(listRes.ok ? listRes.data : null) ? (listRes.data as any[]) : [];
const runs = Array.isArray(runsRes.ok ? runsRes.data : null) ? (runsRes.data as any[]) : [];
const detail = detailRes?.ok ? (detailRes.data as any) : null;
const reason = emptyReason(listRes, "No organic intelligence has been materialised yet");

const BUCKETS = ["", "NOW", "NEXT", "WATCH", "BLOCKED"];
const bucketClass = (b: string) =>
  b === "NOW" ? "border-emerald-300 bg-emerald-50 text-emerald-900"
  : b === "NEXT" ? "border-blue-300 bg-blue-50 text-blue-900"
  : b === "BLOCKED" ? "border-red-300 bg-red-50 text-red-900"
  : "border-gray-300 bg-gray-50 text-gray-600";

/** An absent provider is a known unknown, not a measurement of zero. */
const evidenceLabel = (missing: unknown, dim: string) =>
  Array.isArray(missing) && missing.includes(dim) ? "WAITING FOR PROVIDER" : "measured";

const lastRun = runs[0] ?? null;
---

<AdminLayout title="Organic Intelligence" description="The persisted organic opportunity portfolio and the evidence behind each decision.">
  <div class="container mx-auto px-6 lg:px-8 max-w-7xl">
    <div class="mb-8 pb-6 border-b border-gray-200">
      <h2 class="text-2xl font-black text-brand-dark tracking-tight">Organic Intelligence</h2>
      <p class="text-sm text-gray-500 mt-1 max-w-3xl">
        Opportunities GoldPlus currently believes exist, ranked by adjusted value. Every row is a durable object with
        a stable identity — the same opportunity keeps its history and its work item as evidence changes. Where a
        provider is not connected the evidence reads <strong>WAITING FOR PROVIDER</strong>, never zero.
      </p>
    </div>

    {lastRun && (
      <div class="mb-8 rounded-2xl border border-gray-200 bg-white p-5 text-xs text-gray-600">
        <strong class="text-brand-dark">Last materialisation</strong> · {str(lastRun.mode)} · {str(lastRun.status)} ·
        {fmtWhen(lastRun.started_at)} · policy {str(lastRun.policy_version)} ·
        {num(lastRun.entities_evaluated)} evaluated ·
        <span class="text-emerald-800">{num(lastRun.opportunities_created)} new</span> ·
        <span class="text-blue-800">{num(lastRun.opportunities_updated)} updated</span> ·
        <span class="text-gray-500">{num(lastRun.opportunities_unchanged)} unchanged</span>
        {Number(lastRun.opportunities_created ?? 0) === 0 && Number(lastRun.opportunities_updated ?? 0) === 0 && (
          <span class="ml-1 text-gray-500">— nothing changed, so nothing was written. That is a healthy run.</span>
        )}
      </div>
    )}

    <nav class="flex flex-wrap gap-2 mb-6">
      {BUCKETS.map((b) => (
        <a href={b ? `/admin/seo/opportunities-intel?bucket=${b}` : "/admin/seo/opportunities-intel"}
          class={`rounded-full border px-3 py-1 text-xs font-bold ${bucket === b ? "border-brand-dark bg-brand-dark text-white" : "border-gray-300 bg-white text-gray-600 hover:bg-gray-50"}`}
        >{b || "ALL"}</a>
      ))}
    </nav>

    {reason ? (
      <div role="status" class="rounded-xl border border-dashed border-gray-300 bg-gray-50 p-6 text-sm text-gray-600">{reason}</div>
    ) : items.length === 0 ? (
      <p class="rounded-xl border border-dashed border-gray-300 bg-gray-50 p-6 text-sm text-gray-600">
        No opportunity matches this filter. Nothing is invented to fill the space.
      </p>
    ) : (
      <div class="overflow-x-auto rounded-2xl border border-gray-200 bg-white mb-10">
        <table class="w-full text-xs">
          <thead><tr class="text-left text-[10px] uppercase tracking-widest text-gray-400 border-b border-gray-100">
            <th class="p-3">Priority</th><th>Entity</th><th>Recommended action</th><th>Score</th>
            <th>Commercial</th><th>Confidence</th><th>Evidence</th><th class="p-3">Why</th>
          </tr></thead>
          <tbody>
            {items.map((o) => (
              <tr class="border-b border-gray-50">
                <td class="p-3"><span class={`rounded-full border px-2 py-0.5 text-[10px] font-bold ${bucketClass(String(o.priority_bucket))}`}>{str(o.priority_bucket)}</span></td>
                <td>
                  <strong class="text-brand-dark">{str(o.entity_label ?? o.entity_id)}</strong>
                  <div class="text-gray-400 font-mono text-[11px]">{str(o.entity_type)} · {str(o.entity_id)}</div>
                </td>
                <td class="font-mono text-[11px]">{str(o.recommended_action_class)}</td>
                <td>
                  <strong>{o.adjusted_score === null ? "—" : Number(o.adjusted_score).toFixed(1)}</strong>
                  {o.unscored_weight_share !== null && (
                    <div class="text-gray-400 text-[10px]">{pct(Number(o.unscored_weight_share))} unscored</div>
                  )}
                </td>
                <td class="font-mono text-[11px]">{str(o.commercial_readiness)}</td>
                <td>{str(o.confidence)}</td>
                <td class="text-[11px] text-gray-500">
                  {pct(Number(o.evidence_completeness ?? 0))} complete
                  <div class="text-amber-800">search: {evidenceLabel(o.evidence_missing, "SEARCH_DEMAND")}</div>
                </td>
                <td class="p-3">
                  <a class="font-bold text-brand-dark hover:underline" href={`/admin/seo/opportunities-intel?why=${encodeURIComponent(o.opportunity_key)}`}>Explain →</a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}

    {detail && (
      <section class="mb-16 rounded-2xl border border-brand-dark bg-white p-6">
        <h3 class="font-black text-brand-dark text-lg">Why did GoldPlus decide this?</h3>
        <p class="text-xs text-gray-500 mt-1 font-mono">{str(detail.opportunity?.opportunity_key)}</p>

        <dl class="grid grid-cols-2 md:grid-cols-4 gap-4 my-6 text-xs">
          <div><dt class="uppercase tracking-widest text-[10px] text-gray-400">Policy in force</dt><dd class="font-mono">{str(detail.opportunity?.policy_version)}</dd></div>
          <div><dt class="uppercase tracking-widest text-[10px] text-gray-400">First seen</dt><dd>{fmtWhen(detail.opportunity?.first_seen_at)}</dd></div>
          <div><dt class="uppercase tracking-widest text-[10px] text-gray-400">Last material change</dt><dd>{fmtWhen(detail.opportunity?.last_material_change_at)}</dd></div>
          <div><dt class="uppercase tracking-widest text-[10px] text-gray-400">Root cause</dt><dd class="font-mono">{str(detail.opportunity?.root_cause_key)}</dd></div>
        </dl>

        <h4 class="text-xs font-bold uppercase tracking-widest text-gray-500 mb-2">What drove the score</h4>
        <table class="w-full text-xs mb-6">
          <thead><tr class="text-left text-[10px] uppercase tracking-widest text-gray-400 border-b border-gray-100">
            <th class="py-1">Component</th><th>Evidence</th><th>State</th><th>Normalised</th><th>Weight</th><th>Contribution</th><th>Reason</th>
          </tr></thead>
          <tbody>
            {(detail.components ?? []).map((c: any) => (
              <tr class="border-b border-gray-50">
                <td class="py-2 font-mono">{str(c.component)}</td>
                <td>{c.raw_evidence === null ? "—" : JSON.stringify(c.raw_evidence)}</td>
                <td class={c.evidence_state === "UNKNOWN" ? "text-amber-800 font-bold" : ""}>{str(c.evidence_state)}</td>
                <td>{c.normalized === null ? "—" : Number(c.normalized).toFixed(2)}</td>
                <td>{num(c.weight)}</td>
                <td>{Number(c.contribution).toFixed(2)}</td>
                <td class="text-gray-500">{str(c.reason_code)}</td>
              </tr>
            ))}
          </tbody>
        </table>

        {(detail.rootCauseSiblings ?? []).length > 0 && (
          <>
            <h4 class="text-xs font-bold uppercase tracking-widest text-gray-500 mb-2">
              One fix unlocks these too
            </h4>
            <ul class="mb-6 text-xs text-gray-700 space-y-1">
              {detail.rootCauseSiblings.map((s: any) => (
                <li>· {str(s.entity_label ?? s.opportunity_key)} <span class="text-gray-400">({Number(s.adjusted_score ?? 0).toFixed(1)})</span></li>
              ))}
            </ul>
          </>
        )}

        <h4 class="text-xs font-bold uppercase tracking-widest text-gray-500 mb-2">History</h4>
        {(detail.history ?? []).length === 0 ? (
          <p class="text-xs text-gray-500">No material change has been recorded since this was first seen.</p>
        ) : (
          <ul class="text-xs space-y-2">
            {detail.history.map((h: any) => (
              <li class="border-t border-gray-100 pt-2">
                <span class="font-mono font-bold text-brand-dark">{str(h.event_type)}</span>
                <span class="text-gray-400"> · {fmtWhen(h.occurred_at)} · policy {str(h.policy_version)}</span>
                <div class="text-gray-600">{str(h.reason)}</div>
              </li>
            ))}
          </ul>
        )}

        <a href="/admin/seo/opportunities-intel" class="mt-6 inline-block text-xs font-bold text-gray-500 hover:text-brand-dark">← Back to the portfolio</a>
      </section>
    )}
  </div>
</AdminLayout>
