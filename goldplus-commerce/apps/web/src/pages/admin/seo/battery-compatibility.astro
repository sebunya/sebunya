---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { readSessionToken } from "../../../lib/session";
import { seoGet, seoPost, emptyReason, str, num, fmtWhen } from "../../../lib/adminSeo";

/** Battery compatibility registry — the evidenced facts behind the public
 *  battery finder. A combination cannot be VERIFIED without an evidence source
 *  and a note describing what was checked; the public finder never shows
 *  UNVERIFIED or REJECTED rows. Unmatched customer searches are catalogue
 *  gaps, not failures to hide. */
const token = readSessionToken(Astro.request);
if (!token) return Astro.redirect("/admin/login?returnTo=/admin/seo/battery-compatibility", 303);

let notice: string | null = null;
let formError: string | null = null;

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const intent = String(form.get("intent") ?? "");
  if (intent === "add") {
    const res = await seoPost(token, "/admin/seo/catalogue/battery", {
      phoneBrand: String(form.get("phoneBrand") ?? "").trim(),
      phoneModel: String(form.get("phoneModel") ?? "").trim(),
      modelNumber: String(form.get("modelNumber") ?? "").trim() || null,
      variant: String(form.get("variant") ?? "").trim() || null,
      batteryReference: String(form.get("batteryReference") ?? "").trim(),
      batteryProductId: String(form.get("batteryProductId") ?? "").trim() || null,
      status: String(form.get("status") ?? "UNVERIFIED"),
      evidenceSource: String(form.get("evidenceSource") ?? "").trim() || null,
      evidenceNote: String(form.get("evidenceNote") ?? "").trim() || null,
    });
    if (res.ok) notice = "Compatibility record saved.";
    else formError = res.message;
  }
}

const url = new URL(Astro.request.url);
const statusFilter = url.searchParams.get("status") ?? "";
const res = await seoGet<{ items?: any[]; verifiedCount?: number; unmatchedQueries?: any[] }>(
  token,
  `/admin/seo/catalogue/battery${statusFilter ? `?status=${encodeURIComponent(statusFilter)}` : ""}`,
);
const data = res.ok ? res.data : {};
const items = Array.isArray(data.items) ? data.items : [];
const verifiedCount = typeof data.verifiedCount === "number" ? data.verifiedCount : null;
const unmatched = Array.isArray(data.unmatchedQueries) ? data.unmatchedQueries : [];
const reason = emptyReason(res, "No compatibility records exist yet");

const STATUSES = ["", "VERIFIED", "PROVISIONAL", "UNVERIFIED", "REJECTED"];
const EVIDENCE_SOURCES = ["MANUFACTURER_SHEET", "SUPPLIER_SHEET", "PHYSICAL_QA", "CATALOGUE_EVIDENCE"];
const INDEX_THRESHOLD = 5;
const badge = (s: string) =>
  s === "VERIFIED" ? "border-emerald-300 bg-emerald-50 text-emerald-900"
  : s === "PROVISIONAL" ? "border-amber-300 bg-amber-50 text-amber-900"
  : s === "REJECTED" ? "border-red-300 bg-red-50 text-red-900"
  : "border-gray-300 bg-gray-50 text-gray-600";
---

<AdminLayout title="Battery Compatibility" description="The evidenced phone-to-battery compatibility registry behind the public battery finder.">
  <div class="container mx-auto px-6 lg:px-8 max-w-7xl">
    <div class="mb-8 pb-6 border-b border-gray-200">
      <h2 class="text-2xl font-black text-brand-dark tracking-tight">Battery Compatibility</h2>
      <p class="text-sm text-gray-500 mt-1 max-w-3xl">
        Every phone-to-battery fit we can stand behind. A record reaches <strong>VERIFIED</strong> only with an
        evidence source and a note saying what was checked — the system will refuse otherwise. The public finder
        shows VERIFIED and PROVISIONAL fits only; <strong>UNVERIFIED</strong> and <strong>REJECTED</strong> rows
        never reach a customer.
      </p>
    </div>

    {notice && <div role="status" class="mb-6 rounded-xl border border-emerald-300 bg-emerald-50 p-4 text-sm text-emerald-900">{notice}</div>}
    {formError && <div role="alert" class="mb-6 rounded-xl border border-red-300 bg-red-50 p-4 text-sm text-red-900">{formError}</div>}

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-10">
      <div class="rounded-2xl border border-gray-200 bg-white p-5">
        <p class="text-[10px] font-bold uppercase tracking-widest text-gray-400">Records</p>
        <p class="text-2xl font-black text-brand-dark">{num(items.length)}</p>
      </div>
      <div class="rounded-2xl border border-gray-200 bg-white p-5">
        <p class="text-[10px] font-bold uppercase tracking-widest text-gray-400">Verified</p>
        <p class="text-2xl font-black text-emerald-700">{verifiedCount === null ? "—" : num(verifiedCount)}</p>
      </div>
      <div class="rounded-2xl border border-gray-200 bg-white p-5">
        <p class="text-[10px] font-bold uppercase tracking-widest text-gray-400">Public finder</p>
        <p class="text-sm font-bold text-brand-dark mt-1">
          {verifiedCount === null ? "Unknown" : verifiedCount >= INDEX_THRESHOLD ? "Indexable" : `Noindex — ${INDEX_THRESHOLD - verifiedCount} more verified fits needed`}
        </p>
        <p class="text-[11px] text-gray-400 mt-1">The finder stays noindex until it has real answers, so it never ships as a thin page.</p>
      </div>
    </div>

    {/* Add / update */}
    <form method="POST" class="mb-10 rounded-2xl border border-gray-200 bg-white p-6">
      <input type="hidden" name="intent" value="add" />
      <h3 class="font-black text-brand-dark mb-4">Record a compatibility fact</h3>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <label class="text-sm text-gray-700">Phone brand <span class="text-red-600">*</span>
          <input name="phoneBrand" required class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" />
        </label>
        <label class="text-sm text-gray-700">Phone model <span class="text-red-600">*</span>
          <input name="phoneModel" required class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" />
        </label>
        <label class="text-sm text-gray-700">Model number
          <input name="modelNumber" class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" />
        </label>
        <label class="text-sm text-gray-700">Variant
          <input name="variant" class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" />
        </label>
        <label class="text-sm text-gray-700">Battery reference <span class="text-red-600">*</span>
          <input name="batteryReference" required placeholder="e.g. EB-BG991ABY" class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" />
        </label>
        <label class="text-sm text-gray-700">Battery product ID (catalogue)
          <input name="batteryProductId" class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 text-sm font-mono text-xs" />
        </label>
        <label class="text-sm text-gray-700">Status
          <select name="status" class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 text-sm">
            {STATUSES.filter(Boolean).map((s) => <option value={s} selected={s === "UNVERIFIED"}>{s}</option>)}
          </select>
        </label>
        <label class="text-sm text-gray-700">Evidence source
          <select name="evidenceSource" class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 text-sm">
            <option value="">— none —</option>
            {EVIDENCE_SOURCES.map((s) => <option value={s}>{s}</option>)}
          </select>
        </label>
        <label class="text-sm text-gray-700 md:col-span-3">Evidence note — what was actually checked
          <textarea name="evidenceNote" rows="2" class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 text-sm"></textarea>
        </label>
      </div>
      <p class="mt-3 text-xs text-gray-500">
        VERIFIED requires both an evidence source and a note. Submitting VERIFIED without them is rejected with
        <code class="font-mono"> EVIDENCE_REQUIRED</code> rather than silently downgraded.
      </p>
      <button type="submit" class="mt-4 rounded-xl bg-brand-dark px-6 py-3 text-sm font-bold text-white hover:opacity-90">Save record</button>
    </form>

    {/* Registry */}
    <section class="mb-12">
      <div class="flex flex-wrap items-center justify-between gap-3 mb-3">
        <h3 class="font-black text-brand-dark">Registry</h3>
        <nav class="flex flex-wrap gap-1">
          {STATUSES.map((s) => (
            <a href={s ? `/admin/seo/battery-compatibility?status=${s}` : "/admin/seo/battery-compatibility"}
              class={`rounded-full border px-3 py-1 text-[11px] font-bold ${statusFilter === s ? "border-brand-dark bg-brand-dark text-white" : "border-gray-300 bg-white text-gray-600 hover:bg-gray-50"}`}
            >{s || "ALL"}</a>
          ))}
        </nav>
      </div>
      {reason ? (
        <div role="status" class="rounded-xl border border-dashed border-gray-300 bg-gray-50 p-6 text-sm text-gray-600">{reason}</div>
      ) : items.length === 0 ? (
        <p class="rounded-xl border border-dashed border-gray-300 bg-gray-50 p-6 text-sm text-gray-600">
          No compatibility record matches this filter. Nothing is assumed compatible in the meantime.
        </p>
      ) : (
        <div class="overflow-x-auto rounded-2xl border border-gray-200 bg-white">
          <table class="w-full text-xs">
            <thead><tr class="text-left text-[10px] uppercase tracking-widest text-gray-400 border-b border-gray-100">
              <th class="p-3">Phone</th><th>Battery ref</th><th>Product</th><th>Status</th><th>Evidence</th><th class="p-3">Verified</th>
            </tr></thead>
            <tbody>
              {items.map((r: any) => (
                <tr class="border-b border-gray-50">
                  <td class="p-3">
                    <strong class="text-brand-dark">{str(r.phone_brand)} {str(r.phone_model)}</strong>
                    {r.variant && <span class="text-gray-500"> · {r.variant}</span>}
                    {r.model_number && <div class="text-gray-400 font-mono text-[11px]">{r.model_number}</div>}
                  </td>
                  <td class="font-mono">{str(r.battery_reference)}</td>
                  <td>{r.product_name ? <a href={`/products/${r.product_slug}`} class="hover:underline">{r.product_name}</a> : <span class="text-gray-400">Not linked to a catalogue product</span>}</td>
                  <td><span class={`rounded-full border px-2 py-0.5 text-[10px] font-bold ${badge(String(r.status))}`}>{str(r.status)}</span></td>
                  <td>
                    <div class="font-mono text-[11px]">{str(r.evidence_source)}</div>
                    <div class="text-gray-500 max-w-xs truncate">{str(r.evidence_note)}</div>
                  </td>
                  <td class="p-3">{r.verified_at ? fmtWhen(r.verified_at) : "—"}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </section>

    {/* Catalogue gaps from real searches */}
    <section class="mb-16">
      <h3 class="font-black text-brand-dark mb-1">Searches we could not answer (last 30 days)</h3>
      <p class="text-xs text-gray-500 mb-3">
        Real customer searches in the battery finder that returned nothing. Each one is either a compatibility fact
        we have not recorded yet or a battery we do not stock — both are catalogue decisions, not bugs.
      </p>
      {unmatched.length === 0 ? (
        <p class="rounded-xl border border-dashed border-gray-300 bg-gray-50 p-4 text-sm text-gray-600">
          No unmatched searches have been recorded. This is not a claim that coverage is complete — it may simply
          mean the finder has had little use.
        </p>
      ) : (
        <table class="w-full text-xs rounded-2xl border border-gray-200 bg-white overflow-hidden">
          <thead><tr class="text-left text-[10px] uppercase tracking-widest text-gray-400 border-b border-gray-100">
            <th class="p-3">Query</th><th>Searches</th><th class="p-3">Last searched</th>
          </tr></thead>
          <tbody>
            {unmatched.map((u: any) => (
              <tr class="border-b border-gray-50">
                <td class="p-3 font-mono">{str(u.query)}</td>
                <td>{num(u.searches)}</td>
                <td class="p-3">{fmtWhen(u.last_searched)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      )}
    </section>
  </div>
</AdminLayout>
