---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { readSessionToken } from "../../../lib/session";
import { seoGet, seoPost, seoPatch, emptyReason, str, num, pct, fmtWhen } from "../../../lib/adminSeo";

/** SEO work queue — the chain observation → gap → opportunity → work item →
 *  change → validation → outcome. The rule that gives it integrity: an item
 *  cannot be DONE without a measured outcome. Shipping is not succeeding, and
 *  NOT_MEASURED is an honest close that never counts as a win. */
const token = readSessionToken(Astro.request);
if (!token) return Astro.redirect("/admin/login?returnTo=/admin/seo/work-queue", 303);

let notice: string | null = null;
let formError: string | null = null;

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const intent = String(form.get("intent") ?? "");
  if (intent === "create") {
    const res = await seoPost(token, "/admin/seo/workqueue/items", {
      title: String(form.get("title") ?? "").trim(),
      detail: String(form.get("detail") ?? "").trim() || null,
      priority: String(form.get("priority") ?? "MEDIUM"),
      opportunityId: String(form.get("opportunityId") ?? "").trim() || null,
      gapId: String(form.get("gapId") ?? "").trim() || null,
      observationId: String(form.get("observationId") ?? "").trim() || null,
      targetUrl: String(form.get("targetUrl") ?? "").trim() || null,
    });
    if (res.ok) notice = "Work item created in BACKLOG.";
    else formError = res.message;
  } else if (intent === "advance") {
    const res = await seoPatch(token, `/admin/seo/workqueue/items/${String(form.get("id") ?? "")}`, {
      state: String(form.get("state") ?? ""),
      outcome: String(form.get("outcome") ?? "").trim() || null,
      outcomeNote: String(form.get("outcomeNote") ?? "").trim() || null,
    });
    if (res.ok) notice = "Work item updated.";
    else formError = res.message;
  } else if (intent === "promote") {
    const res = await seoPost(token, "/admin/seo/workqueue/items/promote", {
      opportunity: {
        id: String(form.get("opportunityId") ?? ""),
        title: String(form.get("title") ?? ""),
        summary: String(form.get("summary") ?? "") || null,
        gapId: String(form.get("gapId") ?? "") || null,
        targetPath: String(form.get("targetPath") ?? "") || null,
        priority: String(form.get("priority") ?? "MEDIUM"),
      },
    });
    if (res.ok) notice = "Opportunity promoted to a work item (BACKLOG). Promotion is not a decision to do the work.";
    else formError = res.message;
  }
}

const url = new URL(Astro.request.url);
const stateFilter = url.searchParams.get("state") ?? "";
const [res, vocabRes] = await Promise.all([
  seoGet<{ items?: any[]; inbox?: any[]; summary?: any }>(
    token, `/admin/seo/workqueue/items${stateFilter ? `?state=${encodeURIComponent(stateFilter)}` : ""}`,
  ),
  seoGet<{ states?: string[]; priorities?: string[]; outcomes?: string[]; allowedTransitions?: Record<string, string[]> }>(
    token, "/admin/seo/workqueue/vocabulary",
  ),
]);

const data = res.ok ? res.data : {};
const items = Array.isArray(data.items) ? data.items : [];
const inbox = Array.isArray(data.inbox) ? data.inbox : [];
const summary = data.summary ?? null;
const reason = emptyReason(res, "The SEO work queue is not available yet");
const vocab = vocabRes.ok ? vocabRes.data : {};
const STATES = Array.isArray(vocab.states) ? vocab.states : [];
const PRIORITIES = Array.isArray(vocab.priorities) ? vocab.priorities : ["LOW", "MEDIUM", "HIGH", "CRITICAL"];
const OUTCOMES = Array.isArray(vocab.outcomes) ? vocab.outcomes : [];
// Only the transitions the API will actually accept are offered — the select
// is built from the same state machine the server enforces.
const ALLOWED: Record<string, string[]> = vocab.allowedTransitions ?? {};

const stateBadge = (s: string) =>
  s === "DONE" ? "border-emerald-300 bg-emerald-50 text-emerald-900"
  : s === "BLOCKED" ? "border-red-300 bg-red-50 text-red-900"
  : s === "IN_PROGRESS" || s === "VALIDATING" ? "border-blue-300 bg-blue-50 text-blue-900"
  : s === "ABANDONED" ? "border-gray-300 bg-gray-100 text-gray-500"
  : "border-gray-300 bg-gray-50 text-gray-600";
const outcomeBadge = (o: string) =>
  o === "IMPROVED" ? "text-emerald-800"
  : o === "REGRESSED" ? "text-red-800"
  : o === "NO_CHANGE" ? "text-gray-600"
  : "text-amber-800";
---

<AdminLayout title="SEO Work Queue" description="Observation to outcome: the work items that connect evidence to changes and changes to measured results.">
  <div class="container mx-auto px-6 lg:px-8 max-w-7xl">
    <div class="mb-8 pb-6 border-b border-gray-200">
      <h2 class="text-2xl font-black text-brand-dark tracking-tight">SEO Work Queue</h2>
      <p class="text-sm text-gray-500 mt-1 max-w-3xl">
        The chain from a recorded observation to a measured result. An item cannot reach <strong>DONE</strong>
        without an outcome: shipping a change is an activity, not a result. If the effect was never measured, the
        honest close is <strong>NOT_MEASURED</strong> — which closes the item without counting as a win.
      </p>
    </div>

    {notice && <div role="status" class="mb-6 rounded-xl border border-emerald-300 bg-emerald-50 p-4 text-sm text-emerald-900">{notice}</div>}
    {formError && <div role="alert" class="mb-6 rounded-xl border border-red-300 bg-red-50 p-4 text-sm text-red-900">{formError}</div>}

    {summary && (
      <div class="grid grid-cols-2 md:grid-cols-5 gap-4 mb-10">
        <div class="rounded-2xl border border-gray-200 bg-white p-4">
          <p class="text-[10px] font-bold uppercase tracking-widest text-gray-400">Items</p>
          <p class="text-xl font-black text-brand-dark">{num(summary.total)}</p>
        </div>
        <div class="rounded-2xl border border-gray-200 bg-white p-4">
          <p class="text-[10px] font-bold uppercase tracking-widest text-gray-400">Awaiting validation</p>
          <p class="text-xl font-black text-amber-800">{num(summary.awaitingValidation)}</p>
          <p class="text-[10px] text-gray-400 mt-1">Shipped, effect not yet measured.</p>
        </div>
        <div class="rounded-2xl border border-gray-200 bg-white p-4">
          <p class="text-[10px] font-bold uppercase tracking-widest text-gray-400">Completed</p>
          <p class="text-xl font-black text-brand-dark">{num(summary.completed)}</p>
        </div>
        <div class="rounded-2xl border border-gray-200 bg-white p-4">
          <p class="text-[10px] font-bold uppercase tracking-widest text-gray-400">Improved</p>
          <p class="text-xl font-black text-emerald-800">{num(summary.improved)}</p>
        </div>
        <div class="rounded-2xl border border-gray-200 bg-white p-4">
          <p class="text-[10px] font-bold uppercase tracking-widest text-gray-400">Improvement rate</p>
          <p class="text-xl font-black text-brand-dark">
            {summary.improvementRate === null ? "Unknown" : pct(summary.improvementRate)}
          </p>
          <p class="text-[10px] text-gray-400 mt-1">
            {summary.improvementRate === null ? "Nothing completed yet — not 0%." : "Of completed items."}
          </p>
        </div>
      </div>
    )}

    {summary && summary.unevidenced > 0 && (
      <div role="status" class="mb-8 rounded-xl border border-amber-300 bg-amber-50 p-4 text-sm text-amber-900">
        <strong>{num(summary.unevidenced)}</strong> item{summary.unevidenced === 1 ? " has" : "s have"} no link back
        to an observation, gap or opportunity. Those are ideas, not evidence-driven work — link them or accept that
        they are speculative.
      </div>
    )}

    {/* Inbox: opportunities not yet promoted */}
    <section class="mb-12">
      <h3 class="font-black text-brand-dark mb-1">Inbox — open opportunities with no work item</h3>
      <p class="text-xs text-gray-500 mb-3">Promoting an opportunity creates a BACKLOG item; it is not a decision to do the work.</p>
      {inbox.length === 0 ? (
        <p class="rounded-xl border border-dashed border-gray-300 bg-gray-50 p-4 text-sm text-gray-600">
          Every open opportunity already has a work item.
        </p>
      ) : (
        <div class="space-y-2">
          {inbox.map((o: any) => (
            <form method="POST" class="flex flex-wrap items-center justify-between gap-3 rounded-xl border border-gray-200 bg-white p-4">
              <input type="hidden" name="intent" value="promote" />
              <input type="hidden" name="opportunityId" value={o.id} />
              <input type="hidden" name="title" value={o.title ?? o.summary ?? "Untitled opportunity"} />
              <input type="hidden" name="summary" value={o.summary ?? ""} />
              <input type="hidden" name="gapId" value={o.gap_id ?? ""} />
              <input type="hidden" name="targetPath" value={o.target_path ?? ""} />
              <input type="hidden" name="priority" value={o.priority ?? "MEDIUM"} />
              <span class="text-sm text-brand-dark font-bold">{str(o.title ?? o.summary)}</span>
              <button type="submit" class="rounded-xl border border-gray-300 bg-white px-4 py-2 text-xs font-bold text-brand-dark hover:bg-gray-50">
                Promote to work item
              </button>
            </form>
          ))}
        </div>
      )}
    </section>

    {/* Create */}
    <form method="POST" class="mb-12 rounded-2xl border border-gray-200 bg-white p-6">
      <input type="hidden" name="intent" value="create" />
      <h3 class="font-black text-brand-dark mb-4">Add a work item</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <label class="text-sm text-gray-700 md:col-span-2">Title <span class="text-red-600">*</span>
          <input name="title" required class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" />
        </label>
        <label class="text-sm text-gray-700 md:col-span-2">Detail
          <textarea name="detail" rows="2" class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 text-sm"></textarea>
        </label>
        <label class="text-sm text-gray-700">Priority
          <select name="priority" class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 text-sm">
            {PRIORITIES.map((p: string) => <option value={p} selected={p === "MEDIUM"}>{p}</option>)}
          </select>
        </label>
        <label class="text-sm text-gray-700">Target URL
          <input name="targetUrl" class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" />
        </label>
        <label class="text-sm text-gray-700">Opportunity ID
          <input name="opportunityId" class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 text-sm font-mono text-xs" />
        </label>
        <label class="text-sm text-gray-700">Gap ID
          <input name="gapId" class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 text-sm font-mono text-xs" />
        </label>
      </div>
      <p class="mt-3 text-xs text-gray-500">
        Link at least one of opportunity / gap / observation so the change stays traceable to the evidence that
        justified it. Unlinked items are counted and flagged above rather than silently accepted as equivalent.
      </p>
      <button type="submit" class="mt-4 rounded-xl bg-brand-dark px-6 py-3 text-sm font-bold text-white hover:opacity-90">Create item</button>
    </form>

    {/* Queue */}
    <section class="mb-16">
      <div class="flex flex-wrap items-center justify-between gap-3 mb-3">
        <h3 class="font-black text-brand-dark">Queue</h3>
        <nav class="flex flex-wrap gap-1">
          <a href="/admin/seo/work-queue"
            class={`rounded-full border px-3 py-1 text-[11px] font-bold ${stateFilter === "" ? "border-brand-dark bg-brand-dark text-white" : "border-gray-300 bg-white text-gray-600 hover:bg-gray-50"}`}
          >ALL</a>
          {STATES.map((s: string) => (
            <a href={`/admin/seo/work-queue?state=${s}`}
              class={`rounded-full border px-3 py-1 text-[11px] font-bold ${stateFilter === s ? "border-brand-dark bg-brand-dark text-white" : "border-gray-300 bg-white text-gray-600 hover:bg-gray-50"}`}
            >{s}</a>
          ))}
        </nav>
      </div>
      {reason ? (
        <div role="status" class="rounded-xl border border-dashed border-gray-300 bg-gray-50 p-6 text-sm text-gray-600">{reason}</div>
      ) : items.length === 0 ? (
        <p class="rounded-xl border border-dashed border-gray-300 bg-gray-50 p-6 text-sm text-gray-600">No work item matches this filter.</p>
      ) : (
        <div class="overflow-x-auto rounded-2xl border border-gray-200 bg-white">
          <table class="w-full text-xs">
            <thead><tr class="text-left text-[10px] uppercase tracking-widest text-gray-400 border-b border-gray-100">
              <th class="p-3">Title</th><th>State</th><th>Priority</th><th>Evidence</th><th>Outcome</th><th>Measured</th><th class="p-3">Advance</th>
            </tr></thead>
            <tbody>
              {items.map((i: any) => (
                <tr class="border-b border-gray-50">
                  <td class="p-3">
                    <strong class="text-brand-dark">{str(i.title)}</strong>
                    {i.target_url && <div class="text-gray-400 font-mono text-[11px]">{i.target_url}</div>}
                  </td>
                  <td><span class={`rounded-full border px-2 py-0.5 text-[10px] font-bold ${stateBadge(String(i.state))}`}>{str(i.state)}</span></td>
                  <td class="font-mono text-[11px]">{str(i.priority)}</td>
                  <td class="text-[11px] text-gray-500">
                    {i.opportunity_id || i.gap_id || i.observation_id ? "linked" : <span class="text-amber-800 font-bold">unlinked</span>}
                  </td>
                  <td class={`font-bold ${outcomeBadge(String(i.outcome ?? ""))}`}>
                    {i.outcome ? str(i.outcome) : <span class="text-gray-400 font-normal">not measured yet</span>}
                  </td>
                  <td>{i.outcome_measured_at ? fmtWhen(i.outcome_measured_at) : "—"}</td>
                  <td class="p-3">
                    {(ALLOWED[String(i.state)] ?? []).length === 0 ? (
                      <span class="text-[11px] text-gray-400">terminal</span>
                    ) : (
                      <form method="POST" class="flex flex-wrap items-center gap-1">
                        <input type="hidden" name="intent" value="advance" />
                        <input type="hidden" name="id" value={i.id} />
                        <select name="state" class="rounded-lg border border-gray-300 px-2 py-1 text-[11px]">
                          {(ALLOWED[String(i.state)] ?? []).map((next: string) => <option value={next}>{next}</option>)}
                        </select>
                        <select name="outcome" class="rounded-lg border border-gray-300 px-2 py-1 text-[11px]">
                          <option value="">no outcome</option>
                          {OUTCOMES.map((o: string) => <option value={o} selected={i.outcome === o}>{o}</option>)}
                        </select>
                        <input name="outcomeNote" placeholder="what was measured" class="rounded-lg border border-gray-300 px-2 py-1 text-[11px] w-40" />
                        <button type="submit" class="rounded-lg border border-gray-300 bg-white px-2 py-1 text-[11px] font-bold text-brand-dark hover:bg-gray-50">Apply</button>
                      </form>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </section>
  </div>
</AdminLayout>
