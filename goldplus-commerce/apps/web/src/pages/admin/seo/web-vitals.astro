---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { readSessionToken } from "../../../lib/session";
import { seoGet, seoPost, emptyReason, str, num, fmtWhen } from "../../../lib/adminSeo";

/** Core Web Vitals — MEASURED, never scored by us.
 *
 *  Lab (PageSpeed) and field (CrUX) sit in two separate tables on this page and
 *  are never averaged. There is no composite "health" figure anywhere here:
 *  one would have to be invented. A URL with no reading is shown as
 *  NOT MEASURED, which is a state of its own — not a zero and not a pass. */
const token = readSessionToken(Astro.request);
if (!token) return Astro.redirect("/admin/login?returnTo=/admin/seo/web-vitals", 303);

let notice: string | null = null;
let formError: string | null = null;

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  if (String(form.get("intent") ?? "") === "sync") {
    const urls = String(form.get("urls") ?? "").split(/[\n,]/).map((u) => u.trim()).filter(Boolean);
    const res = await seoPost<{ stored?: number; noData?: number; failed?: number; requested?: number }>(
      token,
      "/admin/seo/vitals/sync",
      {
        urls,
        formFactors: [String(form.get("formFactor") ?? "MOBILE")],
        sources: form.getAll("sources").map(String),
      },
    );
    if (res.ok) {
      const d = res.data ?? {};
      notice = `Sync complete: ${num(d.stored)} measurement(s) stored, ${num(d.noData)} with no data available, ${num(d.failed)} failed, of ${num(d.requested)} requested.`;
    } else formError = res.message;
  }
}

const params = new URL(Astro.request.url).searchParams;
const formFactor = params.get("formFactor") ?? "MOBILE";
const urlsParam = params.get("urls") ?? "";

type Metric = { value?: number | null; rating?: string };
type View = {
  url?: string; source?: string; formFactor?: string; measured?: boolean;
  collectedAt?: string | null; collectionDate?: string | null;
  metrics?: Record<string, Metric>; performanceScore?: number | null;
  sampleSize?: number | null; notMeasuredReason?: string | null;
};

const res = await seoGet<{
  formFactor?: string; lab?: View[]; field?: View[];
  coverage?: { url: string; lab: boolean; field: boolean }[];
  measuredUrlCount?: number; notMeasuredUrls?: string[];
}>(token, `/admin/seo/vitals?formFactor=${encodeURIComponent(formFactor)}${urlsParam ? `&urls=${encodeURIComponent(urlsParam)}` : ""}`);
const data = res.ok ? res.data : null;
const lab: View[] = Array.isArray(data?.lab) ? data!.lab! : [];
const field: View[] = Array.isArray(data?.field) ? data!.field! : [];
const reason = emptyReason(res, "No Core Web Vitals measurements have been recorded yet");
const notMeasuredUrls: string[] = Array.isArray(data?.notMeasuredUrls) ? data!.notMeasuredUrls! : [];

const METRICS = ["LCP", "INP", "CLS", "TTFB", "FCP"];
const ratingClass = (r?: string) =>
  r === "GOOD" ? "bg-emerald-100 text-emerald-900"
  : r === "NEEDS_IMPROVEMENT" ? "bg-amber-100 text-amber-900"
  : r === "POOR" ? "bg-red-100 text-red-900"
  : "bg-gray-100 text-gray-500";
const metricText = (m?: Metric, key?: string) => {
  if (!m || m.value === null || m.value === undefined) return "not measured";
  return key === "CLS" ? m.value.toFixed(3) : `${Math.round(m.value)} ms`;
};
---

<AdminLayout title="Core Web Vitals" description="Measured lab and field vitals, kept strictly separate.">
  <div class="container mx-auto px-6 lg:px-8 max-w-7xl">
    <div class="mb-8 pb-6 border-b border-gray-200">
      <h2 class="text-2xl font-black text-brand-dark tracking-tight">Core Web Vitals</h2>
      <p class="text-sm text-gray-500 mt-1">
        Two independent sources. <strong>Lab</strong> is one synthetic PageSpeed run — reproducible and diagnostic.
        <strong>Field</strong> is what real Chrome users experienced over 28 days. They answer different questions and are
        never averaged together, so there is no single "site health" number on this page.
      </p>
    </div>

    {notice && <div role="status" class="mb-6 rounded-xl border border-emerald-300 bg-emerald-50 p-4 text-sm text-emerald-900">{notice}</div>}
    {formError && <div role="alert" class="mb-6 rounded-xl border border-red-300 bg-red-50 p-4 text-sm text-red-900">{formError}</div>}

    <section class="bg-white border border-gray-200 rounded-2xl p-6 mb-8">
      <form method="GET" class="flex flex-wrap items-end gap-3">
        <label class="text-xs font-bold text-gray-600">Form factor
          <select name="formFactor" class="ml-2 rounded-lg border border-gray-300 px-2 py-1.5 text-xs">
            {["MOBILE", "DESKTOP"].map((f) => <option value={f} selected={f === formFactor}>{f}</option>)}
          </select>
        </label>
        <label class="text-xs font-bold text-gray-600 flex-1 min-w-[16rem]">Also show these URLs (comma separated)
          <input name="urls" value={urlsParam} class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-1.5 text-xs" placeholder="https://shopgoldplus.com/" />
        </label>
        <button type="submit" class="rounded-full border border-gray-300 px-4 py-1.5 text-xs font-bold text-gray-700 hover:bg-gray-50">Apply</button>
      </form>
    </section>

    {reason && <p class="mb-8 text-sm text-gray-500 rounded-xl border border-dashed border-gray-300 bg-gray-50 p-6">{reason}</p>}

    {!reason && lab.length === 0 && field.length === 0 && (
      <p class="mb-8 text-sm text-gray-500 rounded-xl border border-dashed border-gray-300 bg-gray-50 p-6">
        Nothing has been measured yet. No URL is shown as good or bad, because no reading exists. Run a sync below.
      </p>
    )}

    {/* Lab */}
    {lab.length > 0 && (
      <section class="bg-white border border-gray-200 rounded-2xl p-6 mb-8">
        <h3 class="text-sm font-black uppercase tracking-widest text-gray-500 mb-1">Lab — PageSpeed Insights</h3>
        <p class="text-xs text-gray-500 mb-4">One synthetic Lighthouse run per URL. INP is a field-only metric and is never produced by a lab run.</p>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs">
            <thead>
              <tr class="text-[10px] font-black uppercase tracking-widest text-gray-400 border-b border-gray-200">
                <th class="py-2 pr-4">URL</th>
                {METRICS.map((m) => <th class="py-2 pr-4">{m}</th>)}
                <th class="py-2 pr-4">Score</th>
                <th class="py-2 pr-4">Collected</th>
              </tr>
            </thead>
            <tbody>
              {lab.map((v) => (
                <tr class="border-b border-gray-100">
                  <td class="py-2 pr-4 font-mono text-[11px]">{str(v.url)}</td>
                  {METRICS.map((m) => (
                    <td class="py-2 pr-4">
                      <span class={`rounded px-1.5 py-0.5 ${ratingClass(v.metrics?.[m]?.rating)}`}>{metricText(v.metrics?.[m], m)}</span>
                    </td>
                  ))}
                  <td class="py-2 pr-4">{v.performanceScore === null || v.performanceScore === undefined ? "not measured" : num(v.performanceScore)}</td>
                  <td class="py-2 pr-4 text-gray-500">
                    {v.measured ? `${fmtWhen(v.collectedAt)} (${str(v.collectionDate)})` : "NOT MEASURED"}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        {lab.some((v) => !v.measured) && (
          <ul class="mt-4 space-y-1 text-xs text-gray-600">
            {lab.filter((v) => !v.measured).map((v) => <li><strong class="font-mono">{str(v.url)}</strong> — {str(v.notMeasuredReason)}</li>)}
          </ul>
        )}
      </section>
    )}

    {/* Field */}
    {field.length > 0 && (
      <section class="bg-white border border-gray-200 rounded-2xl p-6 mb-8">
        <h3 class="text-sm font-black uppercase tracking-widest text-gray-500 mb-1">Field — Chrome UX Report</h3>
        <p class="text-xs text-gray-500 mb-4">
          Real-user 75th percentile over a 28-day window. CrUX reports a distribution, not a score, so no performance
          score is shown here — inventing one would be a fabrication.
        </p>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs">
            <thead>
              <tr class="text-[10px] font-black uppercase tracking-widest text-gray-400 border-b border-gray-200">
                <th class="py-2 pr-4">URL</th>
                {METRICS.map((m) => <th class="py-2 pr-4">{m} (p75)</th>)}
                <th class="py-2 pr-4">Collected</th>
              </tr>
            </thead>
            <tbody>
              {field.map((v) => (
                <tr class="border-b border-gray-100">
                  <td class="py-2 pr-4 font-mono text-[11px]">{str(v.url)}</td>
                  {METRICS.map((m) => (
                    <td class="py-2 pr-4">
                      <span class={`rounded px-1.5 py-0.5 ${ratingClass(v.metrics?.[m]?.rating)}`}>{metricText(v.metrics?.[m], m)}</span>
                    </td>
                  ))}
                  <td class="py-2 pr-4 text-gray-500">
                    {v.measured ? `${fmtWhen(v.collectedAt)} (${str(v.collectionDate)})` : "NOT MEASURED"}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        {field.some((v) => !v.measured) && (
          <ul class="mt-4 space-y-1 text-xs text-gray-600">
            {field.filter((v) => !v.measured).map((v) => <li><strong class="font-mono">{str(v.url)}</strong> — {str(v.notMeasuredReason)}</li>)}
          </ul>
        )}
      </section>
    )}

    {notMeasuredUrls.length > 0 && (
      <section class="bg-white border border-amber-300 rounded-2xl p-6 mb-8">
        <h3 class="text-sm font-black uppercase tracking-widest text-amber-800 mb-2">Never measured ({notMeasuredUrls.length})</h3>
        <p class="text-xs text-amber-900 mb-3">These URLs have no lab run and no field data. They are not good and not bad — they are unknown.</p>
        <ul class="space-y-1 text-xs font-mono text-gray-700">{notMeasuredUrls.map((u) => <li>{u}</li>)}</ul>
      </section>
    )}

    {/* Sync */}
    <section class="bg-white border border-gray-200 rounded-2xl p-6 mb-12">
      <h3 class="text-sm font-black uppercase tracking-widest text-gray-500 mb-4">Measure URLs</h3>
      <form method="POST" class="space-y-4">
        <input type="hidden" name="intent" value="sync" />
        <label class="block">
          <span class="text-xs font-bold text-gray-600">URLs (one per line)</span>
          <textarea name="urls" required rows="5" class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 text-xs font-mono" placeholder="https://shopgoldplus.com/"></textarea>
        </label>
        <div class="flex flex-wrap items-center gap-4">
          <label class="text-xs font-bold text-gray-600">Form factor
            <select name="formFactor" class="ml-2 rounded-lg border border-gray-300 px-2 py-1.5 text-xs">
              <option value="MOBILE">MOBILE</option>
              <option value="DESKTOP">DESKTOP</option>
            </select>
          </label>
          <label class="flex items-center gap-1 text-xs text-gray-700"><input type="checkbox" name="sources" value="PAGESPEED_LAB" checked /> Lab (PageSpeed)</label>
          <label class="flex items-center gap-1 text-xs text-gray-700"><input type="checkbox" name="sources" value="CRUX_FIELD" checked /> Field (CrUX)</label>
        </div>
        <p class="text-xs text-gray-500">
          A URL with too little real-user traffic has no CrUX record. That comes back as "no data" and stores nothing —
          the URL stays NOT MEASURED for field rather than acquiring a fabricated reading.
        </p>
        <button type="submit" class="rounded-full bg-brand-dark px-6 py-2 text-xs font-bold text-white hover:bg-black">Run measurement</button>
      </form>
    </section>
  </div>
</AdminLayout>
