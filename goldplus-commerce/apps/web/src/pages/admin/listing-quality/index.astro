---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { apiBase } from '../../../lib/api';
import { readSessionToken } from '../../../lib/session';

/**
 * Listing quality — every live product ranked by what still holds its Google
 * Shopping listing back. The diagnostics come from the same use case that
 * builds the merchant feed, so what this page says is exactly what the feed
 * does. Each row links to the listing editor where the gap is fixed.
 */
const token = readSessionToken(Astro.request);
if (!token) return Astro.redirect('/admin/login?returnTo=/admin/listing-quality', 303);

interface Row { id?: string; sku: string; slug: string; name?: string; categoryName?: string | null; hasImage?: boolean; included: boolean; issues: string[] }
interface Report { totalProducts: number; includedInFeed: number; excludedFromFeed: number; issueCounts: Record<string, number>; products: Row[] }

const LABEL: Record<string, string> = {
  missing_image: 'No photo',
  single_image: 'One photo only',
  title_is_code_only: 'Title is just the code',
  no_long_description: 'No long description',
  no_verified_specs: 'No specifications',
  description_under_50_chars: 'Description too short',
  missing_description: 'No description',
  no_google_category: 'No Google category',
  missing_mpn: 'No model number',
  missing_price: 'No price',
  not_feed_eligible: 'Excluded from feed',
  not_approved: 'Not approved',
  inactive: 'Inactive',
  title_over_150_chars: 'Title over 150 characters',
};
/** The order the owner should fix things in: what blocks the feed first, then what ranks. */
const ORDER = ['missing_image', 'missing_price', 'not_approved', 'inactive', 'not_feed_eligible', 'title_is_code_only', 'no_long_description', 'no_verified_specs', 'single_image', 'no_google_category', 'description_under_50_chars', 'missing_description', 'missing_mpn', 'title_over_150_chars'];

const url = new URL(Astro.request.url);
const issueFilter = url.searchParams.get('issue') ?? '';
const q = (url.searchParams.get('q') ?? '').trim().toLowerCase();

let report: Report | null = null; let loadError = '';
try {
  const res = await fetch(`${apiBase}/admin/products/listing-quality`, { headers: { Authorization: `Bearer ${token}` }, signal: AbortSignal.timeout(15000) });
  const json = await res.json().catch(() => null);
  if (json?.success) report = json.data as Report; else loadError = json?.error?.message ?? `The report could not be loaded (HTTP ${res.status}).`;
} catch (e) { loadError = 'The report could not be loaded: the catalogue service did not answer.'; }

const rows = (report?.products ?? []).filter((r) => (!issueFilter || r.issues.includes(issueFilter)) && (!q || `${r.name ?? ''} ${r.sku} ${r.categoryName ?? ''}`.toLowerCase().includes(q)));
const counts = report?.issueCounts ?? {};
const complete = (report?.products ?? []).filter((r) => r.issues.length === 0).length;
const href = (issue: string) => { const p = new URLSearchParams(); if (issue) p.set('issue', issue); if (q) p.set('q', q); return `/admin/listing-quality${p.size ? `?${p}` : ''}`; };
---
<AdminLayout title="Listing quality" description="Every product ranked by what still holds its Google Shopping listing back." activePath="/admin/listing-quality">
  <div class="container mx-auto px-6 lg:px-8 max-w-7xl space-y-8">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 pb-6 border-b border-gray-200">
      <div>
        <h2 class="text-2xl font-black text-brand-dark tracking-tight">Listing quality</h2>
        <p class="text-sm text-gray-500 mt-1 max-w-2xl">What Google Shopping ranks on, product by product. Fix a row in its listing editor; the feed and the product page update together.</p>
      </div>
      <a href="/admin/photos" class="bg-brand-dark hover:bg-black text-white font-black text-xs px-4 py-2.5 rounded-xl uppercase tracking-wider shadow-sm text-center">Upload photos by code</a>
    </div>

    {loadError && <div class="rounded-xl border border-red-200 bg-red-50 text-red-700 px-4 py-3 text-sm font-bold" role="alert">{loadError}</div>}

    {report && (
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="bg-white border border-gray-200 rounded-2xl p-5"><div class="text-3xl font-black text-brand-dark tabular-nums">{report.totalProducts}</div><div class="text-xs text-gray-500 font-bold uppercase tracking-wider mt-1">Live products</div></div>
        <div class="bg-white border border-gray-200 rounded-2xl p-5"><div class="text-3xl font-black text-brand-dark tabular-nums">{report.includedInFeed}</div><div class="text-xs text-gray-500 font-bold uppercase tracking-wider mt-1">In the Google feed</div></div>
        <div class="bg-white border border-gray-200 rounded-2xl p-5"><div class="text-3xl font-black text-brand-dark tabular-nums">{counts.missing_image ?? 0}</div><div class="text-xs text-gray-500 font-bold uppercase tracking-wider mt-1">Waiting for a photo</div></div>
        <div class="bg-white border border-gray-200 rounded-2xl p-5"><div class="text-3xl font-black text-brand-green tabular-nums">{complete}</div><div class="text-xs text-gray-500 font-bold uppercase tracking-wider mt-1">Complete listings</div></div>
      </div>
    )}

    <section class="bg-white border border-gray-200 rounded-2xl shadow-sm p-5 space-y-4">
      <form method="GET" class="flex flex-wrap items-center gap-3">
        <label class="sr-only" for="q">Search products</label>
        <input id="q" name="q" value={q} placeholder="Search by name, SKU or category" class="flex-1 min-w-[16rem] border border-gray-300 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-brand-green focus:border-brand-green" />
        {issueFilter && <input type="hidden" name="issue" value={issueFilter} />}
        <button type="submit" class="bg-white border border-gray-300 hover:bg-gray-50 text-brand-dark font-black text-xs px-4 py-2.5 rounded-xl uppercase tracking-wider">Search</button>
      </form>
      <div class="flex flex-wrap gap-2">
        <a href={href('')} class={`text-xs font-bold px-3 py-1.5 rounded-full border ${issueFilter === '' ? 'bg-brand-dark text-white border-brand-dark' : 'bg-white text-gray-700 border-gray-300 hover:bg-gray-50'}`}>All ({report?.totalProducts ?? 0})</a>
        {ORDER.filter((k) => (counts[k] ?? 0) > 0).map((k) => (
          <a href={href(k)} class={`text-xs font-bold px-3 py-1.5 rounded-full border ${issueFilter === k ? 'bg-brand-dark text-white border-brand-dark' : 'bg-white text-gray-700 border-gray-300 hover:bg-gray-50'}`}>{LABEL[k] ?? k} ({counts[k]})</a>
        ))}
      </div>
    </section>

    <section class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="bg-gray-50 text-[10px] uppercase tracking-widest text-gray-400 font-black">
            <tr><th class="text-left px-5 py-3">Product</th><th class="text-left px-5 py-3">Category</th><th class="text-left px-5 py-3">Feed</th><th class="text-left px-5 py-3">Still missing</th><th class="px-5 py-3"></th></tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            {rows.length === 0 && <tr><td colspan="5" class="px-5 py-8 text-center text-gray-500">Nothing matches — every listing here is complete.</td></tr>}
            {rows.map((r) => (
              <tr class="hover:bg-gray-50/60">
                <td class="px-5 py-3"><div class="font-bold text-brand-dark">{r.name ?? r.slug}</div><div class="text-xs text-gray-500 font-mono">{r.sku}</div></td>
                <td class="px-5 py-3 text-gray-600">{r.categoryName ?? '—'}</td>
                <td class="px-5 py-3">{r.included ? <span class="text-xs font-black text-green-700 bg-green-50 border border-green-200 px-2 py-0.5 rounded-full">In feed</span> : <span class="text-xs font-black text-amber-700 bg-amber-50 border border-amber-200 px-2 py-0.5 rounded-full">Not yet</span>}</td>
                <td class="px-5 py-3">
                  {r.issues.length === 0 ? <span class="text-xs font-bold text-green-700">Complete</span> : (
                    <div class="flex flex-wrap gap-1.5">{ORDER.filter((k) => r.issues.includes(k)).map((k) => <span class="text-[11px] font-bold text-gray-700 bg-gray-100 border border-gray-200 px-2 py-0.5 rounded-full">{LABEL[k] ?? k}</span>)}</div>
                  )}
                </td>
                <td class="px-5 py-3 text-right whitespace-nowrap">{r.id && <a href={`/admin/products/${r.id}/listing`} class="text-xs font-black text-brand-dark underline underline-offset-2">Edit listing</a>}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  </div>
</AdminLayout>
