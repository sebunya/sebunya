---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import Notice from '../../../components/Notice.astro';
import { apiBase } from '../../../lib/api';
import { readSessionToken, clearSessionCookie } from '../../../lib/session';
import type { ApiEnvelope } from '@goldplus/shared';

const token = readSessionToken(Astro.request);
if (!token) {
  return Astro.redirect(`/admin/login?returnTo=${encodeURIComponent(Astro.url.pathname)}`, 303);
}

interface NotificationAttemptDto {
  id: string;
  channel: string;
  recipient: string;
  template: string;
  status: 'SENT' | 'FAILED' | 'NOT_CONFIGURED' | 'DISABLED';
  providerCode: string | null;
  providerMessage: string | null;
  relatedEntity: string | null;
  relatedEntityId: string | null;
  attemptedAt: string;
}

let attempts: NotificationAttemptDto[] = [];
let fetchError: string | null = null;

try {
  const res = await fetch(`${apiBase}/admin/notifications?limit=100`, {
    headers: {
      'Authorization': `Bearer ${token}`,
      'Accept': 'application/json'
    }
  });

  if (res.status === 401 || res.status === 403) {
    Astro.response.headers.set('Set-Cookie', clearSessionCookie());
    return Astro.redirect(`/admin/login?returnTo=${encodeURIComponent(Astro.url.pathname)}`, 303);
  }

  if (!res.ok) {
    fetchError = `API returned HTTP ${res.status}`;
  } else {
    const json = await res.json() as ApiEnvelope<NotificationAttemptDto[]>;
    if (json.success && Array.isArray(json.data)) {
      attempts = json.data;
    } else {
      fetchError = json.error?.message ?? 'Invalid data received from server.';
    }
  }
} catch (err: any) {
  fetchError = `Network failure loading notifications.`;
}

const sentCount = attempts.filter(a => a.status === 'SENT').length;
const notConfigCount = attempts.filter(a => a.status === 'NOT_CONFIGURED' || a.status === 'DISABLED').length;
const failedCount = attempts.filter(a => a.status === 'FAILED').length;

function maskRecipient(recipient: string, channel: string): string {
  if (!recipient) return 'N/A';
  const r = recipient.trim();
  if (channel === 'email' || r.includes('@')) {
    const parts = r.split('@');
    if (parts.length < 2) return r.slice(0, 3) + '...';
    const local = parts[0];
    const domain = parts[1];
    const maskedLocal = local.length > 2 ? local.slice(0, 2) + '…' : local + '…';
    return `${maskedLocal}@${domain}`;
  }
  if (r.length <= 6) return '***' + r.slice(-2);
  return r.slice(0, 3) + '…' + r.slice(-3);
}

const statusToBadgeKind = {
  SENT: 'bg-green-50 text-green-700 border-green-100',
  FAILED: 'bg-red-50 text-red-700 border-red-100',
  NOT_CONFIGURED: 'bg-yellow-50 text-yellow-700 border-yellow-100',
  DISABLED: 'bg-gray-50 text-gray-700 border-gray-100',
} as const;
---

<AdminLayout 
  title="Notifications Ledger" 
  description="Track delivery vectors across client notification pipelines."
>
  <div class="container mx-auto px-6 lg:px-8 max-w-7xl">
    
    <div class="flex flex-col sm:flex-row sm:items-center justify-between mb-8 gap-4 pb-6 border-b border-gray-200">
      <div>
        <h2 class="text-2xl font-black text-brand-dark tracking-tight">Message Deliverability</h2>
        <p class="text-sm text-gray-500 mt-1">Truthful ledger of triggered SMS and transactional email deliveries.</p>
      </div>
    </div>

    {fetchError && (
      <div class="mb-8">
        <Notice kind="not-configured" title="Unable to load notification history" message={fetchError} />
      </div>
    )}

    {!fetchError && (
      <>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mb-8">
          <div class="bg-white rounded-2xl p-6 border border-gray-200 shadow-sm">
            <p class="text-[9px] font-black uppercase tracking-widest text-gray-400 mb-1">Successfully Dispatched</p>
            <h3 class="text-2xl font-black text-green-600">{sentCount}</h3>
            <p class="text-[10px] text-gray-400 mt-1 font-medium">Handed over to gateway.</p>
          </div>
          <div class="bg-white rounded-2xl p-6 border border-gray-200 shadow-sm">
            <p class="text-[9px] font-black uppercase tracking-widest text-gray-400 mb-1">Halted / Muted</p>
            <h3 class="text-2xl font-black text-amber-600">{notConfigCount}</h3>
            <p class="text-[10px] text-gray-400 mt-1 font-medium">Credentials pending setup.</p>
          </div>
          <div class="bg-white rounded-2xl p-6 border border-gray-200 shadow-sm">
            <p class="text-[9px] font-black uppercase tracking-widest text-gray-400 mb-1">Provider Failures</p>
            <h3 class="text-2xl font-black text-red-600">{failedCount}</h3>
            <p class="text-[10px] text-gray-400 mt-1 font-medium">Returned upstream errors.</p>
          </div>
        </div>

        <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
              <thead>
                <tr class="bg-gray-50 text-[10px] uppercase font-black text-gray-400 tracking-widest border-b border-gray-100">
                  <th class="p-6">Transmission</th>
                  <th class="p-6">Channel</th>
                  <th class="p-6">Template Ref</th>
                  <th class="p-6">Recipient Hash</th>
                  <th class="p-6 text-center">State</th>
                  <th class="p-6">Provider Response</th>
                </tr>
              </thead>
              <tbody class="text-xs divide-y divide-gray-50">
                {attempts.length === 0 ? (
                  <tr>
                    <td colspan="6" class="p-12 text-center text-gray-400 font-medium italic">
                      No historical logs logged in queue.
                    </td>
                  </tr>
                ) : (
                  attempts.map((a) => (
                    <tr class="hover:bg-gray-50 transition-colors">
                      <td class="p-6 font-mono text-[10px] text-gray-500 whitespace-nowrap font-medium">
                        {new Date(a.attemptedAt).toLocaleString('en-GB', { dateStyle: 'short', timeStyle: 'short' })}
                      </td>
                      <td class="p-6 uppercase font-bold tracking-wider text-[9px] text-brand-dark">
                        {a.channel}
                      </td>
                      <td class="p-6 font-mono text-gray-500 text-[10px] font-medium">
                        {a.template}
                      </td>
                      <td class="p-6 font-bold text-brand-dark">
                        {maskRecipient(a.recipient, a.channel)}
                      </td>
                      <td class="p-6 text-center">
                        <span class={`inline-block px-2 py-0.5 rounded text-[9px] font-black border uppercase tracking-wide ${statusToBadgeKind[a.status] || 'bg-gray-50 text-gray-700'}`}>
                          {a.status.replace('_', ' ')}
                        </span>
                      </td>
                      <td class="p-6 text-[10px]">
                        <div class="truncate max-w-[180px] text-gray-500 font-medium" title={`${a.providerCode || ''}: ${a.providerMessage || ''}`}>
                          <span class="font-bold text-brand-dark mr-1">{a.providerCode || 'N/A'}</span>
                          <span>{a.providerMessage || '-'}</span>
                        </div>
                      </td>
                    </tr>
                  ))
                )}
              </tbody>
            </table>
          </div>
        </div>
        <div class="mt-4 text-[10px] font-mono text-gray-400 text-right">
          EXPOSING TOP {attempts.length} RELATIONAL TRIES
        </div>
      </>
    )}
  </div>
</AdminLayout>

