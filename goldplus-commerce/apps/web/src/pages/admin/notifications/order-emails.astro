---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { readSessionToken } from "../../../lib/session";
import { apiBase } from "../../../lib/api";

const token = readSessionToken(Astro.request);
if (!token) {
  return Astro.redirect("/admin/login?returnTo=/admin/notifications/order-emails", 303);
}

const headers = { Authorization: `Bearer ${token}`, "Content-Type": "application/json" };

let notice: { kind: "success" | "error"; text: string } | null = null;
if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const id = String(form.get("id") || "");
  const reason = String(form.get("reason") || "").trim();
  try {
    const res = await fetch(`${apiBase}/admin/notifications/admin-order-emails/${encodeURIComponent(id)}/replay`, {
      method: "POST",
      headers,
      body: JSON.stringify({ reason }),
    });
    const json = await res.json().catch(() => null);
    notice = json?.success
      ? { kind: "success", text: "Email intent requeued for delivery." }
      : { kind: "error", text: json?.error?.message || "Could not replay this intent." };
  } catch {
    notice = { kind: "error", text: "Notification service is unreachable right now." };
  }
}

interface Intent {
  id: string; orderId: string | null; event: string | null; preparationState: string | null;
  deliveryState: string; attemptCount: number; nextAttemptAt: string; lastError: string | null;
  dryRunOnly: boolean; createdAt: string;
}
let recipientReadiness: { state: string; recipients: string[] } = { state: "MISSING_CONFIG", recipients: [] };
let intents: Intent[] = [];
let loadFailed = false;
let apiError = "";
try {
  const res = await fetch(`${apiBase}/admin/notifications/admin-order-emails`, { headers });
  const json = await res.json().catch(() => null);
  if (json?.success) {
    recipientReadiness = json.data.recipientReadiness;
    intents = json.data.intents;
  } else {
    loadFailed = true;
    apiError = `Query responded with HTTP ${res.status}.`;
  }
} catch {
  loadFailed = true;
  apiError = "Notification API is currently unreachable.";
}

function stateChip(s: string) {
  switch (s) {
    case "SENT": return "bg-green-50 text-green-700 border-green-200";
    case "DEAD_LETTER": return "bg-red-50 text-red-700 border-red-200";
    case "RETRYING": return "bg-amber-50 text-amber-800 border-amber-200";
    case "MISSING_CONFIG": return "bg-orange-50 text-orange-700 border-orange-200";
    case "DELIVERY_DISABLED": return "bg-gray-100 text-gray-600 border-gray-200";
    default: return "bg-slate-50 text-slate-600 border-slate-200";
  }
}
const replayable = (s: string) => s === "DEAD_LETTER" || s === "RETRYING" || s === "MISSING_CONFIG" || s === "DELIVERY_DISABLED";
---

<AdminLayout
  title="Admin Order Emails"
  description="Transactional administrator order-email intents: delivery status, retry/dead-letter, and manual replay."
>
  <div class="container mx-auto px-6 lg:px-8 max-w-7xl">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between mb-8 gap-4 pb-6 border-b border-gray-200">
      <div>
        <h2 class="text-2xl font-black text-brand-dark tracking-tight">Admin Order Emails</h2>
        <p class="text-sm text-gray-500 mt-1">One transactional email per order event. Delivery stays disabled until activated; intents are preserved and replayable.</p>
      </div>
      <span class={`text-xs font-bold px-3 py-1.5 rounded-lg font-mono border ${recipientReadiness.state === "READY" ? "bg-green-50 text-green-700 border-green-200" : "bg-orange-50 text-orange-700 border-orange-200"}`}>
        RECIPIENTS: {recipientReadiness.state}
      </span>
    </div>

    {notice && (
      <div class={`px-6 py-4 rounded-2xl mb-6 text-sm font-semibold ${notice.kind === "success" ? "bg-green-50 border border-green-200 text-green-800" : "bg-red-50 border border-red-200 text-red-800"}`}>
        {notice.text}
      </div>
    )}

    <div class="bg-white border border-gray-200 rounded-2xl p-5 mb-6 text-xs text-gray-600">
      <strong>Configured recipients:</strong>{" "}
      {recipientReadiness.recipients.length > 0 ? recipientReadiness.recipients.join(", ") : "none — set ADMIN_ORDER_NOTIFICATION_EMAILS (MISSING_CONFIG)."}
    </div>

    {loadFailed && (
      <div class="bg-red-50 border border-red-200 text-red-800 px-6 py-4 rounded-2xl mb-6 text-sm">
        <strong>Order-email intents unavailable.</strong> {apiError}
      </div>
    )}

    {!loadFailed && intents.length === 0 && (
      <div class="bg-white border border-gray-200 rounded-2xl p-10 text-center text-gray-500 text-sm">
        No order-email intents yet. They appear here the moment an order is placed, paid or cancelled.
      </div>
    )}

    <div class="space-y-3">
      {intents.map((it) => (
        <div class="bg-white border border-gray-200 rounded-2xl p-5 shadow-sm flex flex-wrap items-center justify-between gap-3">
          <div>
            <div class="flex items-center gap-2 flex-wrap">
              <span class="font-mono text-xs text-gray-500">order {it.orderId?.slice(0, 8)}…</span>
              <span class="text-[10px] font-black uppercase tracking-wider px-2.5 py-1 rounded-lg border bg-slate-50 text-slate-600 border-slate-200">{it.event}</span>
              <span class={`text-[10px] font-black uppercase tracking-wider px-2.5 py-1 rounded-lg border ${stateChip(it.deliveryState)}`}>{it.deliveryState.replace(/_/g, " ")}</span>
              {it.preparationState && <span class="text-[10px] font-bold text-gray-400">{it.preparationState.replace(/_/g, " ")}</span>}
            </div>
            <p class="text-[11px] text-gray-400 mt-1">
              attempts {it.attemptCount} · created {new Date(it.createdAt).toLocaleString("en-UG", { timeZone: 'Africa/Kampala' })}{it.lastError ? ` · ${it.lastError}` : ""}
            </p>
          </div>
          {replayable(it.deliveryState) && (
            <form method="POST" class="flex items-end gap-2">
              <input type="hidden" name="id" value={it.id} />
              <input type="text" name="reason" maxlength="500" placeholder="Replay reason (optional)" class="bg-gray-50 border border-gray-200 rounded-xl px-3 py-2 text-xs font-bold text-brand-dark placeholder-gray-300 outline-none focus:border-brand-gold" />
              <button type="submit" class="bg-brand-gold text-brand-dark text-xs font-black px-4 py-2 rounded-xl hover:opacity-90 transition-opacity">Replay</button>
            </form>
          )}
        </div>
      ))}
    </div>
  </div>
</AdminLayout>
