---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import AiSearchNav from "../../../components/admin/AiSearchNav.astro";
import { readSessionToken } from "../../../lib/session";
import { aivGet, aivPost, providerLabel, usd, when, RUN_STATE, DEFAULT_PROJECT } from "../../../lib/adminAiVisibility";

/**
 * Runs and research. Monitoring runs feed the KPIs; research runs ask ad-hoc
 * questions once and change nothing — a research question is tracked only
 * when someone presses "Track this question".
 */
const token = readSessionToken(Astro.request);
if (!token) return Astro.redirect("/admin/login?returnTo=/admin/ai-search/runs", 303);
const project = Astro.url.searchParams.get("project") ?? DEFAULT_PROJECT;
const P = `/projects/${encodeURIComponent(project)}`;
const q = project !== DEFAULT_PROJECT ? `&project=${encodeURIComponent(project)}` : "";

let notice: string | null = null;
let formError: string | null = null;
if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const intent = String(form.get("intent") ?? "");
  const runId = encodeURIComponent(String(form.get("runId") ?? ""));
  const r =
    intent === "approve" ? await aivPost(token, `${P}/runs/${runId}/approve`) :
    intent === "reject" ? await aivPost(token, `${P}/runs/${runId}/reject`) :
    intent === "cancel" ? await aivPost(token, `${P}/runs/${runId}/cancel`) :
    intent === "research" ? await aivPost(token, `${P}/research`, { questions: String(form.get("questions") ?? "") }) :
    intent === "track" ? await aivPost(token, `${P}/queries`, { text: String(form.get("text") ?? ""), source: "RESEARCH", provenance: `research run ${String(form.get("runId") ?? "")}` }) :
    null;
  if (r) {
    if (r.ok) notice = { approve: "Approved — the run is queued.", reject: "Rejected. Nothing was spent.", cancel: "Cancelled. Answers already recorded are kept.", research: "Research run started.", track: "Now tracked. It will be asked in every monitoring run." }[intent] ?? "Done.";
    else formError = r.message;
  }
}

const runs = await aivGet<{ rows: any[]; total: number }>(token, `${P}/runs?limit=30`);
const live = runs.ok && runs.data.rows.some((r) => ["QUEUED", "RUNNING"].includes(r.status));
const tracked = await aivGet<{ rows: Array<{ text: string }> }>(token, `${P}/queries?limit=1000`);
const trackedSet = new Set((tracked.ok ? tracked.data.rows : []).map((x) => x.text.toLowerCase()));
---
<AdminLayout title="Runs · AI Search" description="Monitoring runs, approvals and one-off research.">
  {live && <meta http-equiv="refresh" content="10" slot="head" />}
  <div class="container mx-auto px-6 lg:px-8 max-w-7xl">
    <h2 class="text-2xl font-black text-brand-dark tracking-tight mb-4">Runs &amp; research</h2>
    <AiSearchNav current="runs" project={project} />
    {notice && <div role="status" class="mb-6 rounded-xl border border-emerald-300 bg-emerald-50 p-4 text-sm text-emerald-900">{notice}</div>}
    {formError && <div role="alert" class="mb-6 rounded-xl border border-red-300 bg-red-50 p-4 text-sm text-red-900">{formError}</div>}

    <section class="mb-8 rounded-2xl border border-gray-200 bg-white p-6">
      <h3 class="text-sm font-black uppercase tracking-widest text-gray-500 mb-1">Research (one-off)</h3>
      <p class="text-xs text-gray-500 mb-3 max-w-2xl">Ask questions once to explore a topic, a competitor or a new market. Research answers are stored as evidence but never change the visibility figures, tracked questions, competitors or schedules. Up to 20 questions; the same spend limits apply.</p>
      <form method="POST" class="space-y-3">
        <input type="hidden" name="intent" value="research" />
        <label class="block text-xs font-bold text-gray-700" for="questions">Questions, one per line</label>
        <textarea id="questions" name="questions" rows="3" required class="block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" placeholder="Which brands of wireless earbuds are sold in Uganda?"></textarea>
        <button class="inline-flex min-h-11 items-center rounded-full border-2 border-brand-dark px-5 text-sm font-bold text-brand-dark">Run research</button>
      </form>
    </section>

    {!runs.ok ? <p role="alert" class="rounded-xl border border-red-300 bg-red-50 p-4 text-sm text-red-900">{runs.message}</p> : runs.data.rows.length === 0 ? (
      <p class="rounded-2xl border border-dashed border-gray-300 bg-gray-50 p-8 text-sm text-gray-600">No runs yet. Start the first baseline from the Overview once a provider is connected.</p>
    ) : (
      <section class="mb-12">
        <h3 class="text-sm font-black uppercase tracking-widest text-gray-500 mb-3">Runs</h3>
        <ul class="divide-y divide-gray-200 rounded-2xl border border-gray-200 bg-white">{runs.data.rows.map((r) => (
          <li class="p-5">
            <div class="flex flex-wrap items-start justify-between gap-3">
              <div class="text-sm">
                <p><span class="font-black">{RUN_STATE[r.status] ?? r.status}</span> · {r.kind === "RESEARCH" ? "Research" : r.kind === "VERIFICATION" ? "Verification" : "Monitoring"} · {when(r.createdAt)}{r.actorKind !== "USER" ? ` · requested by ${r.actorKind.toLowerCase()}` : ""}</p>
                <p class="text-gray-600 mt-0.5">{r.providers.map(providerLabel).join(", ")} · {r.succeeded} answered · {r.failed} failed · {r.skipped} skipped of {r.totalTasks} · est. {usd(r.estimatedUsd)} · spent {usd(r.actualUsd)}</p>
                {r.phase && ["RUNNING", "QUEUED"].includes(r.status) && <p class="text-gray-600">{r.phase}</p>}
                {r.error && <p class="text-red-700 mt-1">{r.error}</p>}
                {r.kind === "RESEARCH" && r.adhocQueries.length > 0 && (
                  <ul class="mt-2 space-y-1">{r.adhocQueries.map((text: string) => (
                    <li class="flex flex-wrap items-center gap-2"><span>“{text}”</span>
                      {trackedSet.has(text.toLowerCase()) ? <span class="text-xs text-gray-500">tracked</span> : (
                        <form method="POST" class="inline"><input type="hidden" name="intent" value="track" /><input type="hidden" name="runId" value={r.id} /><input type="hidden" name="text" value={text} /><button class="text-xs font-bold underline">Track this question</button></form>
                      )}</li>
                  ))}</ul>
                )}
              </div>
              <div class="flex flex-wrap gap-2">
                {r.succeeded + r.failed > 0 && <a class="inline-flex min-h-9 items-center rounded-full border border-gray-300 px-3 text-xs font-bold" href={`/admin/ai-search/answers?runId=${r.id}${q}`}>Answers</a>}
                {r.status === "AWAITING_APPROVAL" && (<>
                  <form method="POST"><input type="hidden" name="intent" value="approve" /><input type="hidden" name="runId" value={r.id} /><button class="inline-flex min-h-9 items-center rounded-full bg-brand-dark px-3 text-xs font-bold text-white">Approve {usd(r.estimatedUsd)}</button></form>
                  <form method="POST"><input type="hidden" name="intent" value="reject" /><input type="hidden" name="runId" value={r.id} /><button class="inline-flex min-h-9 items-center rounded-full border border-gray-300 px-3 text-xs font-bold">Reject</button></form>
                </>)}
                {["AWAITING_APPROVAL", "QUEUED", "RUNNING"].includes(r.status) && <form method="POST"><input type="hidden" name="intent" value="cancel" /><input type="hidden" name="runId" value={r.id} /><button class="inline-flex min-h-9 items-center px-2 text-xs font-bold underline">Cancel</button></form>}
              </div>
            </div>
          </li>
        ))}</ul>
      </section>
    )}
  </div>
</AdminLayout>
