---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import AiSearchNav from "../../../components/admin/AiSearchNav.astro";
import { readSessionToken } from "../../../lib/session";
import { aivGet, aivPost, aivPatch, DEFAULT_PROJECT } from "../../../lib/adminAiVisibility";

/** Tracked questions: the basket every monitoring run asks. */
const token = readSessionToken(Astro.request);
if (!token) return Astro.redirect("/admin/login?returnTo=/admin/ai-search/queries", 303);
const project = Astro.url.searchParams.get("project") ?? DEFAULT_PROJECT;
const P = `/projects/${encodeURIComponent(project)}`;
const q = project !== DEFAULT_PROJECT ? `&project=${encodeURIComponent(project)}` : "";

let notice: string | null = null;
let formError: string | null = null;
if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const intent = String(form.get("intent") ?? "");
  const f = (k: string) => String(form.get(k) ?? "").trim();
  if (intent === "add") {
    const lines = f("text").split("\n").map((l) => l.trim()).filter(Boolean).slice(0, 50);
    let added = 0; const errors: string[] = [];
    for (const text of lines) {
      const r = await aivPost(token, `${P}/queries`, { text, intent: f("intent_") || undefined, category: f("category") || undefined, topic: f("topic") || undefined, priority: f("priority") || undefined, funnelStage: f("funnelStage") || undefined });
      if (r.ok) added += 1; else errors.push(`“${text}”: ${r.message}`);
    }
    if (added) notice = `Added ${added} question${added === 1 ? "" : "s"}.`;
    if (errors.length) formError = errors.slice(0, 5).join(" ");
  } else if (intent === "toggle") {
    const r = await aivPatch(token, `${P}/queries/${encodeURIComponent(f("id"))}`, { active: f("active") === "true" });
    if (r.ok) notice = f("active") === "true" ? "Resumed. It will be asked in the next run." : "Paused. Its history is kept."; else formError = r.message;
  }
}

const list = await aivGet<{ rows: any[]; total: number }>(token, `${P}/queries?limit=500`);
const SOURCE: Record<string, string> = { MANUAL: "Added by hand", SEARCH_CONSOLE: "Search Console", RESEARCH: "From research", AEO_PROMPT_BANK: "AEO prompt bank", IMPORT: "Import" };
---
<AdminLayout title="Questions · AI Search" description="The questions every monitoring run asks the AI engines.">
  <div class="container mx-auto px-6 lg:px-8 max-w-7xl">
    <h2 class="text-2xl font-black text-brand-dark tracking-tight mb-4">Tracked questions</h2>
    <AiSearchNav current="queries" project={project} />
    {notice && <div role="status" class="mb-6 rounded-xl border border-emerald-300 bg-emerald-50 p-4 text-sm text-emerald-900">{notice}</div>}
    {formError && <div role="alert" class="mb-6 rounded-xl border border-red-300 bg-red-50 p-4 text-sm text-red-900">{formError}</div>}

    <section class="mb-8 rounded-2xl border border-gray-200 bg-white p-6">
      <h3 class="text-sm font-black uppercase tracking-widest text-gray-500 mb-1">Add questions</h3>
      <p class="text-xs text-gray-500 mb-4 max-w-2xl">One per line, written the way a customer would ask. Each is sent to every provider exactly as written. Research questions belong on Runs &amp; research until you decide to track them.</p>
      <form method="POST" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3">
        <input type="hidden" name="intent" value="add" />
        <label class="text-xs font-bold text-gray-700 sm:col-span-2 lg:col-span-5" for="text">Questions
          <textarea id="text" name="text" rows="3" required placeholder="Where can I buy a genuine power bank in Kampala?" class="mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm"></textarea></label>
        <label class="text-xs font-bold text-gray-700">Intent<select name="intent_" class="mt-1 block w-full rounded-lg border border-gray-300 px-2 py-2 text-sm">
          {["COMMERCIAL", "TRANSACTIONAL", "INFORMATIONAL", "NAVIGATIONAL", "LOCAL", "COMPARISON", "UNKNOWN"].map((v) => <option value={v}>{v.charAt(0) + v.slice(1).toLowerCase()}</option>)}</select></label>
        <label class="text-xs font-bold text-gray-700">Stage<select name="funnelStage" class="mt-1 block w-full rounded-lg border border-gray-300 px-2 py-2 text-sm"><option value="">—</option>
          {["AWARENESS", "CONSIDERATION", "DECISION", "POST_PURCHASE"].map((v) => <option value={v}>{v.replace("_", " ").toLowerCase()}</option>)}</select></label>
        <label class="text-xs font-bold text-gray-700">Category<input name="category" class="mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" placeholder="power" /></label>
        <label class="text-xs font-bold text-gray-700">Topic<input name="topic" class="mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" placeholder="power banks" /></label>
        <label class="text-xs font-bold text-gray-700">Priority<select name="priority" class="mt-1 block w-full rounded-lg border border-gray-300 px-2 py-2 text-sm">{["P0", "P1", "P2", "P3"].map((v) => <option value={v} selected={v === "P2"}>{v}</option>)}</select></label>
        <div class="sm:col-span-2 lg:col-span-5"><button class="inline-flex min-h-11 items-center rounded-full bg-brand-dark px-6 text-sm font-bold text-white">Add</button></div>
      </form>
    </section>

    {!list.ok ? <p role="alert" class="rounded-xl border border-red-300 bg-red-50 p-4 text-sm text-red-900">{list.message}</p> : (
      <section class="mb-12">
        <h3 class="text-sm font-black uppercase tracking-widest text-gray-500 mb-3">{list.data.total} questions · {list.data.rows.filter((r) => r.active).length} active</h3>
        {list.data.rows.length === 0 ? <p class="rounded-2xl border border-dashed border-gray-300 bg-gray-50 p-8 text-sm text-gray-600">No questions yet. Add the questions customers actually ask.</p> : (
          <div class="overflow-x-auto rounded-2xl border border-gray-200 bg-white">
            <table class="w-full text-sm">
              <thead><tr class="text-left text-xs font-bold uppercase tracking-wider text-gray-500 border-b border-gray-200"><th class="p-3">Question</th><th class="p-3">Intent</th><th class="p-3">Branded</th><th class="p-3">Priority</th><th class="p-3">Source</th><th class="p-3"></th></tr></thead>
              <tbody>{list.data.rows.map((r) => (
                <tr class:list={["border-b border-gray-100 align-top", !r.active && "text-gray-400"]}>
                  <td class="p-3 max-w-lg"><span class="font-bold">{r.text}</span>{r.category && <span class="block text-xs text-gray-500">{r.category}</span>}</td>
                  <td class="p-3 text-xs">{r.intent.toLowerCase()}</td>
                  <td class="p-3 text-xs">{r.branded ? "yes" : "no"}</td>
                  <td class="p-3 text-xs">{r.priority}</td>
                  <td class="p-3 text-xs">{SOURCE[r.source] ?? r.source}</td>
                  <td class="p-3 whitespace-nowrap">
                    <a class="text-xs font-bold underline mr-3" href={`/admin/ai-search/answers?compare=${r.id}${q}`}>Answers</a>
                    <form method="POST" class="inline"><input type="hidden" name="intent" value="toggle" /><input type="hidden" name="id" value={r.id} /><input type="hidden" name="active" value={r.active ? "false" : "true"} />
                      <button class="text-xs font-bold underline">{r.active ? "Pause" : "Resume"}</button></form>
                  </td>
                </tr>
              ))}</tbody>
            </table>
          </div>
        )}
      </section>
    )}
  </div>
</AdminLayout>
