---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { readSessionToken } from "../../../lib/session";

const token = readSessionToken(Astro.request);
if (!token) {
  return Astro.redirect("/admin/login?returnTo=/admin/verification", 303);
}

const metrics = [
  { label: 'Scanned Holograms', value: 'Verified', highlight: 'Active' },
  { label: 'Reported Frauds', value: '0', highlight: 'Safe' },
];
---

<AdminLayout 
  title="Authenticity Center" 
  description="Oversee product serial verification pipelines and fake report queues."
>
  <div class="container mx-auto px-6 lg:px-8 max-w-7xl">
    
    <div class="mb-8 pb-6 border-b border-gray-200 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h2 class="text-2xl font-black text-brand-dark tracking-tight">Hologram & Traceability</h2>
        <p class="text-sm text-gray-500 mt-1 max-w-2xl">
          Monitor verification sequences matched via secure customer QR scanners. Counteract regional counterfeits honestly.
        </p>
      </div>
      <a href="/verification" target="_blank" class="text-xs font-bold text-gray-500 hover:text-brand-dark border border-gray-200 px-4 py-2 rounded-xl shadow-sm bg-white transition-colors">
        Open Scanner Preview &rarr;
      </a>
    </div>

    {/* Statistics */}
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-8">
      {metrics.map(m => (
        <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm flex justify-between items-center">
          <div>
            <p class="text-[9px] font-black text-gray-400 uppercase tracking-widest">{m.label}</p>
            <p class="text-3xl font-black text-brand-dark mt-1">{m.value}</p>
          </div>
          <span class="bg-brand-green/10 text-brand-green border border-brand-green/20 text-[8px] font-black px-2 py-1 rounded uppercase tracking-widest">
            {m.highlight}
          </span>
        </div>
      ))}
    </div>

    {/* Detailed Explanation Card */}
    <div class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden mb-8">
      <div class="p-6 border-b border-gray-100 bg-gray-50">
        <h3 class="text-xs font-black uppercase tracking-widest text-brand-dark">Verification Database</h3>
      </div>
      
      <div class="p-16 text-center flex flex-col items-center max-w-md mx-auto" id="reports">
        <div class="text-4xl mb-4">🔍</div>
        <h4 class="font-black text-brand-dark text-base">Counterfeit Reporting Dashboard</h4>
        <p class="text-xs text-gray-500 mt-2 leading-relaxed">
          Real-time tracing of serial scans and user-submitted fraud photos requires an aggregated logs query API, which is currently being designed.
        </p>
        <span class="mt-4 text-[8px] border border-yellow-200 bg-yellow-50 text-yellow-700 font-black px-2 py-0.5 rounded uppercase tracking-widest">
          Awaiting Aggregation Service
        </span>
      </div>
    </div>

  </div>
</AdminLayout>
