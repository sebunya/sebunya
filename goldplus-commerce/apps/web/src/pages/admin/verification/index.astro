---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { readSessionToken } from "../../../lib/session";
import { apiBase } from "../../../lib/api";
import {
  FAKE_REPORT_STATUS_LABELS,
  FAKE_REPORT_SETTABLE_STATUSES,
  readFakeReportPage,
  readVerificationSummary,
} from "../../../lib/admin-authenticity";

const token = readSessionToken(Astro.request);
if (!token) {
  return Astro.redirect("/admin/login?returnTo=/admin/verification", 303);
}

const authed = (path: string, init?: RequestInit) =>
  fetch(`${apiBase}${path}`, {
    ...init,
    headers: { ...init?.headers, Authorization: `Bearer ${token}`, Accept: "application/json" },
    signal: AbortSignal.timeout(15_000),
  });

let notice: { kind: "ok" | "error"; message: string } | null = null;

// Status change goes through the existing audited PATCH (settings.manage;
// confirming a signed-in reporter's report is the loyalty earn event).
if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const id = String(form.get("reportId") ?? "").trim();
  const status = String(form.get("status") ?? "").trim();
  if (!id || !(FAKE_REPORT_SETTABLE_STATUSES as readonly string[]).includes(status)) {
    notice = { kind: "error", message: "Choose a report and a valid status." };
  } else {
    try {
      const res = await authed(`/governance/admin/fake-reports/${encodeURIComponent(id)}/status`, {
        method: "PATCH",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ status }),
      });
      const body = await res.json().catch(() => null);
      if (res.ok && body?.success) {
        const pts = body.data?.loyalty?.points;
        notice = { kind: "ok", message: `Report marked ${FAKE_REPORT_STATUS_LABELS[status] ?? status}.${pts ? ` Reporter earned ${pts} points.` : ""}` };
      } else {
        notice = { kind: "error", message: body?.error?.message ?? `Status change failed (HTTP ${res.status}).` };
      }
    } catch {
      notice = { kind: "error", message: "The API did not answer; the status was not changed." };
    }
  }
}

const url = new URL(Astro.request.url);
const page = Math.max(Number(url.searchParams.get("page") ?? 1) || 1, 1);
const statusFilter = url.searchParams.get("status") ?? "";
const days = Number(url.searchParams.get("days") ?? 30) || 30;

const [reports, summary] = await Promise.all([
  readFakeReportPage(authed, { page, status: statusFilter || null }),
  readVerificationSummary(authed, days),
]);

const pct = (n: number, d: number) => (d > 0 ? `${Math.round((n / d) * 100)}%` : "—");
const pageHref = (p: number) => {
  const q = new URLSearchParams();
  q.set("page", String(p));
  if (statusFilter) q.set("status", statusFilter);
  if (days !== 30) q.set("days", String(days));
  return `/admin/verification?${q.toString()}`;
};
const lastPage = reports.ok ? Math.max(Math.ceil(reports.data.total / reports.data.pageSize), 1) : 1;
---

<AdminLayout
  title="Authenticity Center"
  description="Oversee product serial verification pipelines and fake report queues."
>
  <div class="container mx-auto px-6 lg:px-8 max-w-7xl">

    <div class="mb-8 pb-6 border-b border-gray-200 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h2 class="text-2xl font-black text-brand-dark tracking-tight">Hologram & Traceability</h2>
        <p class="text-sm text-gray-500 mt-1 max-w-2xl">
          Verification scans from the customer scanner and counterfeit reports from the public form. Reporter names, contacts and scanner addresses are not shown here.
        </p>
      </div>
      <a href="/verification" target="_blank" class="text-xs font-bold text-gray-500 hover:text-brand-dark border border-gray-200 px-4 py-2 rounded-xl shadow-sm bg-white transition-colors">
        Open Scanner Preview &rarr;
      </a>
    </div>

    {notice && (
      <div role="status" class:list={["mb-6 rounded-xl border p-4 text-sm font-bold", notice.kind === "ok" ? "border-emerald-200 bg-emerald-50 text-emerald-800" : "border-red-200 bg-red-50 text-red-800"]}>
        {notice.message}
      </div>
    )}

    {/* Scan summary */}
    <section class="mb-8" aria-labelledby="scan-title" data-testid="verification-summary">
      <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
        <h3 id="scan-title" class="text-xs font-black uppercase tracking-widest text-brand-dark">Verification scans</h3>
        <form method="GET" class="flex items-center gap-2 text-xs">
          {statusFilter && <input type="hidden" name="status" value={statusFilter} />}
          <label for="days" class="font-bold text-gray-500">Window</label>
          <select id="days" name="days" class="border border-gray-200 rounded-lg px-2 py-1">
            {[7, 30, 90, 365].map((d) => <option value={d} selected={d === days}>{d} days</option>)}
          </select>
          <button class="border border-gray-200 rounded-lg px-3 py-1 font-bold">Apply</button>
        </form>
      </div>
      {summary.ok ? (
        summary.data.total === 0 ? (
          <div class="bg-white p-6 rounded-2xl border border-gray-200 text-sm text-gray-500">No verification scans in the last {summary.data.windowDays} days.</div>
        ) : (
          <div>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
              <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm">
                <p class="text-[9px] font-black text-gray-500 uppercase tracking-widest">Total scans ({summary.data.windowDays}d)</p>
                <p class="text-3xl font-black text-brand-dark mt-1">{summary.data.total}</p>
              </div>
              <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm">
                <p class="text-[9px] font-black text-gray-500 uppercase tracking-widest">Genuine code</p>
                <p class="text-3xl font-black text-emerald-700 mt-1">{summary.data.genuine}</p>
                <p class="text-xs text-gray-500">{pct(summary.data.genuine, summary.data.total)} of scans</p>
              </div>
              <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm">
                <p class="text-[9px] font-black text-gray-500 uppercase tracking-widest">Not genuine or unknown code</p>
                <p class="text-3xl font-black text-red-700 mt-1">{summary.data.notGenuineOrUnknown}</p>
                <p class="text-xs text-gray-500">Includes mistyped codes; not proof of a counterfeit.</p>
              </div>
            </div>
            {summary.data.topProducts.length > 0 && (
              <div class="mt-6 bg-white rounded-2xl border border-gray-200 p-6">
                <p class="text-[9px] font-black text-gray-500 uppercase tracking-widest mb-3">Most scanned products</p>
                <ol class="text-sm space-y-1">
                  {summary.data.topProducts.map((p) => (
                    <li class="flex justify-between gap-4"><span>{p.productName ?? "Unknown product"}</span><span class="font-black">{p.scans}</span></li>
                  ))}
                </ol>
              </div>
            )}
          </div>
        )
      ) : (
        <div class="rounded-2xl border border-red-200 bg-red-50 p-6 text-sm text-red-800" data-testid="verification-summary-error">
          Scan summary unavailable: {summary.message}
        </div>
      )}
    </section>

    {/* Counterfeit reports */}
    <section class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden mb-8" id="reports" data-testid="fake-report-list">
      <div class="p-6 border-b border-gray-100 bg-gray-50 flex flex-wrap items-center justify-between gap-3">
        <h3 class="text-xs font-black uppercase tracking-widest text-brand-dark">Counterfeit reports</h3>
        <form method="GET" class="flex items-center gap-2 text-xs">
          {days !== 30 && <input type="hidden" name="days" value={days} />}
          <label for="status" class="font-bold text-gray-500">Status</label>
          <select id="status" name="status" class="border border-gray-200 rounded-lg px-2 py-1">
            <option value="" selected={!statusFilter}>All</option>
            {Object.entries(FAKE_REPORT_STATUS_LABELS).map(([k, label]) => <option value={k} selected={k === statusFilter}>{label}{reports.ok && reports.data.statusCounts[k] !== undefined ? ` (${reports.data.statusCounts[k]})` : ""}</option>)}
          </select>
          <button class="border border-gray-200 rounded-lg px-3 py-1 font-bold">Filter</button>
        </form>
      </div>

      {!reports.ok ? (
        <div class="p-8 text-sm text-red-800 bg-red-50" data-testid="fake-report-error">Counterfeit reports unavailable: {reports.message}</div>
      ) : reports.data.items.length === 0 ? (
        <div class="p-12 text-center text-sm text-gray-500">No counterfeit reports{statusFilter ? ` with status ${FAKE_REPORT_STATUS_LABELS[statusFilter] ?? statusFilter}` : ""}.</div>
      ) : (
        <div>
          {reports.data.topLocations.length > 0 && (
            <p class="px-6 pt-4 text-xs text-gray-500">
              Most reported locations: {reports.data.topLocations.map((l) => `${l.location} (${l.reports})`).join(", ")}
            </p>
          )}
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead class="text-left text-[10px] uppercase tracking-widest text-gray-500">
                <tr>
                  <th class="px-6 py-3">Received</th>
                  <th class="px-6 py-3">Product</th>
                  <th class="px-6 py-3">Where found</th>
                  <th class="px-6 py-3">Evidence</th>
                  <th class="px-6 py-3">Status</th>
                </tr>
              </thead>
              <tbody>
                {reports.data.items.map((r) => (
                  <tr class="border-t border-gray-100 align-top">
                    <td class="px-6 py-3 whitespace-nowrap">{new Date(r.createdAt).toLocaleString("en-GB", { timeZone: "Africa/Kampala" })}</td>
                    <td class="px-6 py-3 max-w-xs">{r.productDescription}</td>
                    <td class="px-6 py-3">{r.locationFound}</td>
                    <td class="px-6 py-3 text-xs text-gray-600">
                      {r.hologramCodeProvided ? "Hologram code given" : "No code"} · {r.evidenceCount} file{r.evidenceCount === 1 ? "" : "s"}{r.reporterSignedIn ? " · signed-in reporter" : ""}
                    </td>
                    <td class="px-6 py-3">
                      <form method="POST" class="flex items-center gap-2">
                        <input type="hidden" name="reportId" value={r.id} />
                        <label class="sr-only" for={`s-${r.id}`}>Status</label>
                        <select id={`s-${r.id}`} name="status" class="border border-gray-200 rounded-lg px-2 py-1 text-xs">
                          {r.status === "new" && <option value="" selected>New</option>}
                          {FAKE_REPORT_SETTABLE_STATUSES.map((s) => <option value={s} selected={s === r.status}>{FAKE_REPORT_STATUS_LABELS[s]}</option>)}
                        </select>
                        <button class="border border-gray-200 rounded-lg px-2 py-1 text-xs font-bold">Save</button>
                      </form>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <nav class="flex justify-between items-center p-4 text-xs border-t border-gray-100" aria-label="Report pages">
            <span>Page {reports.data.page} of {lastPage} · {reports.data.total} reports</span>
            <span class="flex gap-3">
              {reports.data.page > 1 && <a class="font-bold underline" href={pageHref(reports.data.page - 1)}>Newer</a>}
              {reports.data.page < lastPage && <a class="font-bold underline" href={pageHref(reports.data.page + 1)}>Older</a>}
            </span>
          </nav>
        </div>
      )}
    </section>

  </div>
</AdminLayout>
