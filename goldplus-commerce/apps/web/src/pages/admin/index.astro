---
import AdminLayout from "../../layouts/AdminLayout.astro";
import AdminEmptyState from "../../components/admin/AdminEmptyState.astro";
import AdminReadinessChecklist from "../../components/admin/AdminReadinessChecklist.astro";
import ControlCentreModuleCard from "../../components/admin/ControlCentreModuleCard.astro";
import ControlCentreFailure from "../../components/admin/ControlCentreFailure.astro";
import { ADMIN_READINESS_ITEMS } from "../../lib/admin-trust-centre";
import { apiBase } from "../../lib/api";
import { fetchModuleReadiness } from "../../lib/control-centre";
import { readSessionToken } from "../../lib/session";

const token = readSessionToken(Astro.request);
if (!token) {
  return Astro.redirect("/admin/login?returnTo=/admin", 303);
}

let serviceState: "connected" | "unavailable" | "access-denied" = "unavailable";
try {
  const response = await fetch(`${apiBase}/governance/admin/stats`, {
    headers: { Accept: "application/json", Authorization: `Bearer ${token}` },
    signal: AbortSignal.timeout(3000),
  });
  if (response.ok) serviceState = "connected";
  else if (response.status === 401 || response.status === 403) serviceState = "access-denied";
} catch {
  serviceState = "unavailable";
}

// Runtime module status comes ONLY from the readiness service. The old static
// ADMIN_TRUST_MODULES array is no longer a source of runtime truth; when this call
// fails the page renders a truthful failure state rather than static green cards.
const readiness = await fetchModuleReadiness(token, { category: "TRUST_CENTRE" });
const summary = readiness.ok ? readiness.summary : null;
---

<AdminLayout
  title="Admin Trust Centre"
  description="Operational status, safe next steps and protected module guidance."
>
  <div class="container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8" data-admin-trust-centre>
    <header class="flex flex-col gap-5 border-b border-slate-200 pb-7 md:flex-row md:items-end md:justify-between">
      <div class="max-w-3xl">
        <p class="text-[10px] font-black uppercase tracking-[0.2em] text-brand-primary">Operator workspace</p>
        <h1 class="mt-2 text-3xl font-black tracking-tight text-brand-dark">GoldPlus Admin Trust Centre</h1>
        <p class="mt-3 text-sm leading-relaxed text-slate-600">
          Understand what each module does, its verified release posture, the safest available action and what must happen next.
        </p>
      </div>
      <div class={`inline-flex w-fit items-center gap-2 rounded-full border px-4 py-2 text-xs font-black ${
        serviceState === "connected"
          ? "border-emerald-200 bg-emerald-50 text-emerald-800"
          : serviceState === "access-denied"
            ? "border-red-200 bg-red-50 text-red-800"
            : "border-amber-200 bg-amber-50 text-amber-800"
      }`} role="status">
        <span class={`h-2 w-2 rounded-full ${serviceState === "connected" ? "bg-emerald-500" : serviceState === "access-denied" ? "bg-red-500" : "bg-amber-500"}`}></span>
        {serviceState === "connected" ? "Admin service connected" : serviceState === "access-denied" ? "Access check required" : "Admin service unavailable"}
      </div>
    </header>

    <section class="mt-7 rounded-2xl border border-blue-200 bg-blue-50 p-5 text-sm leading-relaxed text-blue-950" aria-labelledby="admin-access-guidance">
      <h2 id="admin-access-guidance" class="font-black">Access and role guidance</h2>
      <p class="mt-1">
        Existing route and API permissions remain authoritative. If a module says you do not have access, ask an owner or admin for the correct role. This trust centre does not grant permissions or expose protected data.
      </p>
    </section>

    {serviceState === "access-denied" && (
      <div class="mt-6">
        <AdminEmptyState
          kind="access-denied"
          title="You do not have access to admin service data"
          what="The protected admin service rejected this session for the requested summary."
          why="Your current role may not include the required permission, or the session may need renewal."
          nextStep="Ask an owner or admin for the correct role. Do not share credentials or tokens."
          actionHref="/admin/login?returnTo=/admin"
          actionLabel="Return to secure sign-in"
        />
      </div>
    )}

    {serviceState === "unavailable" && (
      <div class="mt-6">
        <AdminEmptyState
          kind="error"
          title="Admin service status could not be loaded"
          what="The trust centre could not confirm the protected admin API connection."
          why="The service may be temporarily unavailable; no module is marked live from this failed request."
          nextStep="Retry safely. If the issue continues, review system health without pasting credentials into chat or logs."
          actionHref="/admin"
          actionLabel="Retry status check"
        />
      </div>
    )}

    <section class="mt-10" aria-labelledby="admin-modules-title">
      <div class="max-w-3xl">
        <h2 id="admin-modules-title" class="text-2xl font-black tracking-tight text-brand-dark">Operational modules</h2>
        <p class="mt-2 text-sm leading-relaxed text-slate-600">
          Service, access and activation are measured separately. A protected module is not a broken one.
        </p>
        {summary && (
          <dl class="mt-4 flex flex-wrap gap-x-6 gap-y-1 text-xs font-bold text-slate-600" data-cc-summary>
            <div class="flex gap-1"><dt>Modules</dt><dd class="text-brand-dark" data-cc-total>{summary.totalModules}</dd></div>
            <div class="flex gap-1"><dt>Live</dt><dd class="text-emerald-700" data-cc-live>{summary.liveModules}</dd></div>
            <div class="flex gap-1"><dt>Degraded</dt><dd class="text-amber-700" data-cc-degraded>{summary.degradedModules}</dd></div>
            <div class="flex gap-1"><dt>Blocked</dt><dd class="text-amber-700" data-cc-blocked>{summary.blockedModules}</dd></div>
            <div class="flex gap-1"><dt>Unavailable</dt><dd class="text-red-700" data-cc-unavailable>{summary.unavailableModules}</dd></div>
            <div class="flex gap-1"><dt>Checked</dt><dd class="text-brand-dark">{summary.generatedAt.replace("T", " ").slice(0, 19)}Z</dd></div>
          </dl>
        )}
        <div class="mt-4 flex flex-wrap gap-2">
          <a href="/admin?refresh=1" class="inline-flex items-center rounded-xl border border-slate-300 px-3.5 py-2 text-xs font-black text-slate-700 hover:bg-slate-50" data-cc-refresh>Refresh readiness</a>
          <a href="/admin/commerce-os" class="inline-flex items-center rounded-xl border border-slate-300 px-3.5 py-2 text-xs font-black text-slate-700 hover:bg-slate-50" data-cc-commerce-os-link>Open Commerce OS</a>
          <a href="/admin/release-readiness" class="inline-flex items-center rounded-xl border border-slate-300 px-3.5 py-2 text-xs font-black text-slate-700 hover:bg-slate-50">View release readiness</a>
          <a href="/admin/audit" class="inline-flex items-center rounded-xl border border-slate-300 px-3.5 py-2 text-xs font-black text-slate-700 hover:bg-slate-50">View audit trail</a>
        </div>
      </div>
      {summary ? (
        <div class="mt-6 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
          {summary.modules.map((module) => <ControlCentreModuleCard module={module} />)}
        </div>
      ) : (
        <div class="mt-6">
          <ControlCentreFailure
            reason={readiness.ok ? "MALFORMED_RESPONSE" : readiness.reason}
            message={readiness.ok ? "" : readiness.message}
            traceId={readiness.traceId}
            status={readiness.ok ? undefined : readiness.status}
            retryHref="/admin?refresh=1"
          />
        </div>
      )}
    </section>

    <div class="mt-10">
      <AdminReadinessChecklist items={ADMIN_READINESS_ITEMS} />
    </div>

    <section class="mt-10 rounded-2xl border border-slate-200 bg-slate-900 p-6 text-white" aria-labelledby="safe-operator-states">
      <h2 id="safe-operator-states" class="text-lg font-black">Safe operator states</h2>
      <div class="mt-4 grid gap-4 text-sm leading-relaxed md:grid-cols-3">
        <div><p class="font-black text-brand-primary">No data yet</p><p class="mt-1 text-slate-300">The module is available, but no verified records are present. Follow its next-step guidance.</p></div>
        <div><p class="font-black text-brand-primary">Protected</p><p class="mt-1 text-slate-300">The module requires existing permissions or approved configuration. This page does not bypass either.</p></div>
        <div><p class="font-black text-brand-primary">Dormant</p><p class="mt-1 text-slate-300">The capability is operational and auditable, but the business programme is not switched on. An operator approval activates it; nothing is issued or sent until then.</p></div>
      </div>
    </section>
  </div>
</AdminLayout>
