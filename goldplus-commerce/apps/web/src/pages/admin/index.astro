---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { apiBase } from "../../lib/api";
import { readSessionToken } from "../../lib/session";
import { ADMIN_NAVIGATION } from "../../lib/admin-navigation";

const token = readSessionToken(Astro.request);
if (!token) {
  return Astro.redirect("/admin/login?returnTo=/admin", 303);
}

// Real-time environment and service status checks
let apiStatus: 'up' | 'down' = 'down';
let apiBaseConfigured = !!apiBase;
let isWebRunning = true; 

try {
  const res = await fetch(`${apiBase}/governance/admin/stats`, {
    headers: { 
      'Accept': 'application/json',
      'Authorization': `Bearer ${token}`
    }
  });
  
  if (res.ok) {
    apiStatus = 'up';
  }
} catch {
  apiStatus = 'down';
}

const quickActions = [
  { label: 'Products', href: '/admin/products' },
  { label: 'Carts', href: '/admin/carts' },
  { label: 'Recommendation rules', href: '/admin/recommendations/rules' },
  { label: 'Create rule', href: '/admin/recommendations/rules/new' },
  { label: 'Preview recommendations', href: '/admin/recommendations/preview' },
  { label: 'Merchandising', href: '/admin/merchandising' },
  { label: 'Settings', href: '/admin/settings' },
  { label: 'System status', href: '/admin/system' },
];

const secondaryActions = [
  { label: 'Orders — read-only', href: '/admin/orders' },
  { label: 'Access and permissions', href: '/admin/governance' },
];

// Define true constraints & limitations
const warnings = [
  { id: 'carts-list', message: 'Cart list view is not available yet. Use cart lookup for now.', severity: 'info' },
  { id: 'product-edit', message: 'Product editing is not available yet.', severity: 'warning' },
  { id: 'audit-logs', message: 'Some audit actions are controlled by the API.', severity: 'info' }
];
---

<AdminLayout 
  title="Control Centre" 
  description="Manage storefront settings, product rules, and system status."
>
  <div class="container mx-auto px-6 lg:px-8 max-w-7xl">
    
    {/* Top Heading Bar */}
    <div class="mb-8 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      <div>
        <h2 class="text-2xl md:text-3xl font-black text-brand-dark tracking-tight">
          GoldPlus Commerce Control Centre
        </h2>
        <p class="text-sm text-gray-500 mt-1">
          Manage products, carts, recommendations, merchandising and system settings.
        </p>
      </div>

      {/* API Reachability Badge */}
      <div class="flex items-center gap-3 bg-white border border-gray-200 px-4 py-2 rounded-xl shadow-sm">
        <span class="text-xs font-black text-gray-400 uppercase tracking-widest text-[10px]">API connection</span>
        <div class="flex items-center gap-1.5">
          <div class={`w-2.5 h-2.5 rounded-full ${apiStatus === 'up' ? 'bg-brand-green animate-pulse' : 'bg-red-500'}`}></div>
          <span class="text-xs font-bold text-brand-dark uppercase">
            {apiStatus === 'up' ? 'Connected' : 'Offline'}
          </span>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
      <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm flex flex-col justify-between h-32 relative overflow-hidden transition-all">
        <div class="absolute top-0 left-0 w-1 h-full bg-brand-dark"></div>
        <p class="text-[10px] font-black text-gray-400 uppercase tracking-widest">API connection</p>
        <p class="text-lg font-black text-brand-dark mt-2 uppercase truncate">{apiBaseConfigured ? 'CONFIGURED' : 'MISSING'}</p>
        <p class="text-[10px] text-gray-400 font-mono mt-1 overflow-hidden text-ellipsis">{apiBase || 'No API Base Key'}</p>
      </div>
      
      <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm flex flex-col justify-between h-32 relative overflow-hidden transition-all">
        <div class="absolute top-0 left-0 w-1 h-full bg-blue-500"></div>
        <p class="text-[10px] font-black text-gray-400 uppercase tracking-widest">Web Application</p>
        <p class="text-lg font-black text-brand-green mt-2 uppercase">Active</p>
        <p class="text-[10px] text-gray-400 font-medium mt-1">Astro web app online</p>
      </div>

      <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm flex flex-col justify-between h-32 relative overflow-hidden transition-all">
        <div class="absolute top-0 left-0 w-1 h-full bg-brand-gold"></div>
        <p class="text-[10px] font-black text-gray-400 uppercase tracking-widest">Cart Persistence</p>
        <p class="text-lg font-black text-brand-dark mt-2 uppercase">OPERATIONAL</p>
        <p class="text-[10px] text-gray-400 font-medium mt-1">Page data loaded</p>
      </div>

      <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm flex flex-col justify-between h-32 relative overflow-hidden transition-all">
        <div class="absolute top-0 left-0 w-1 h-full bg-brand-green"></div>
        <p class="text-[10px] font-black text-gray-400 uppercase tracking-widest">Feature status</p>
        <p class="text-lg font-black text-brand-green mt-2 uppercase">Active</p>
        <p class="text-[10px] text-gray-400 font-medium mt-1">Recommendation rules active</p>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-8">
      
      {/* Quick Actions Strip */}
      <div class="lg:col-span-2 bg-white rounded-2xl border border-gray-200 shadow-sm p-6">
        <h3 class="text-xs font-black uppercase tracking-widest text-gray-400 mb-4">Quick actions</h3>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
          {quickActions.map((act) => (
            <a 
              href={act.href} 
              class="flex flex-col items-center text-center gap-2 bg-gray-50 hover:bg-gray-100 border border-gray-100 rounded-xl p-3.5 transition-all group"
            >
              <span class="text-[11px] font-black text-gray-700 group-hover:text-brand-dark truncate w-full py-2">{act.label}</span>
            </a>
          ))}
        </div>
        <div class="mt-6 pt-5 border-t border-dashed border-gray-200">
          <h4 class="text-[10px] font-black uppercase tracking-widest text-gray-400 mb-3">Administrative panels</h4>
          <div class="flex flex-wrap gap-3">
            {secondaryActions.map(act => (
              <a href={act.href} class="flex items-center gap-2 bg-white border border-gray-200 hover:border-gray-400 rounded-xl px-4 py-2 text-xs font-bold text-gray-600 transition-colors shadow-xs">
                <span>{act.label}</span>
              </a>
            ))}
          </div>
        </div>
      </div>

      {/* Useful Operational Warnings / Status Log */}
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 shadow-sm flex flex-col h-full">
        <h3 class="text-xs font-black uppercase tracking-widest text-gray-400 mb-4">Current limitations</h3>
        <div class="space-y-3 flex-1 overflow-y-auto">
          {warnings.map(w => (
            <div class="flex gap-3 items-start text-xs leading-relaxed">
              <span class={w.severity === 'warning' ? 'text-yellow-500' : 'text-blue-500'}>•</span>
              <p class="text-gray-600 font-medium">{w.message}</p>
            </div>
          ))}
        </div>
      </div>

    </div>

    {/* Spotlight: Business Rules */}
    <div class="bg-brand-dark rounded-2xl text-white p-8 shadow-sm flex flex-col md:flex-row items-center justify-between gap-6 mb-8">
      <div class="max-w-2xl">
        <div class="flex items-center gap-3 mb-2">
          <span class="text-[9px] font-black text-brand-primary uppercase tracking-widest bg-brand-primary/10 border border-brand-primary/20 px-2 py-0.5 rounded">Recommendations</span>
          <span class="bg-brand-green/20 text-brand-green border border-brand-green/30 text-[8px] font-black px-1.5 py-0.5 rounded uppercase tracking-wider">Fixed</span>
        </div>
        <h4 class="font-black text-xl tracking-tight text-white">Recommendation rules</h4>
        <p class="text-xs text-gray-400 mt-2 leading-relaxed">
          Control product overrides, merchandising boosts, item pinning, and real-time suppression.
        </p>
      </div>
      <div class="flex gap-3 flex-shrink-0 w-full md:w-auto">
        <a href="/admin/recommendations/rules" class="bg-gray-800 hover:bg-gray-700 text-center text-xs font-black px-6 py-3 rounded-lg transition-colors text-white">
          View Rules
        </a>
        <a href="/admin/recommendations/preview" class="bg-brand-primary hover:bg-opacity-90 text-center text-xs font-black px-6 py-3 rounded-lg text-brand-charcoal transition-opacity">
          Preview recommendations
        </a>
      </div>
    </div>

    {/* Module Management Directory */}
    <div class="mb-8">
      <h3 class="text-xs font-black uppercase tracking-widest text-gray-400 mb-4">Active Module Map</h3>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {ADMIN_NAVIGATION.map(group => (
          group.items.filter(item => item.label !== 'Control Centre').map(item => {
            const isWorking = item.status === 'working';
            const isReadOnly = item.status === 'read_only';
            const isDiagnostic = item.status === 'diagnostic';
            
            return (
              <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm flex flex-col justify-between group hover:border-gray-300 transition-all">
                <div>
                  <div class="flex items-center justify-between mb-2">
                    <span class="text-[9px] font-black text-gray-400 uppercase tracking-widest">{group.title}</span>
                    <span class={`text-[8px] font-black px-1.5 py-0.5 rounded uppercase tracking-wider border ${
                      isWorking
                        ? 'border-green-200 bg-green-50 text-green-700'
                        : isReadOnly
                          ? 'border-blue-200 bg-blue-50 text-blue-700'
                          : 'border-yellow-200 bg-yellow-50 text-yellow-700'
                    }`}>
                      {isWorking ? 'Working' : isReadOnly ? 'Read Only' : 'Diagnostic'}
                    </span>
                  </div>
                  <h4 class="font-black text-base text-brand-dark">{item.label}</h4>
                  <p class="text-xs text-gray-500 mt-1.5 leading-relaxed line-clamp-2">
                    {item.description}
                  </p>
                  {item.reason && (
                    <p class="text-[10px] text-gray-400 mt-2 italic leading-relaxed">
                      {item.reason}
                    </p>
                  )}
                </div>

                <div class="mt-4 flex justify-end">
                  <a href={item.href} class="text-xs font-bold text-brand-dark border border-gray-200 group-hover:border-brand-dark px-3 py-1.5 rounded-lg transition-colors bg-white">
                    Access &rarr;
                  </a>
                </div>
              </div>
            );
          })
        ))}
      </div>
    </div>

  </div>
</AdminLayout>

