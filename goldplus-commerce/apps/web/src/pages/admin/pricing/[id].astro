---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { apiBase } from '../../../lib/api';
import { readSessionToken } from '../../../lib/session';
import { STOREFRONT_PRICE_FLOOR_UGX } from '@goldplus/shared';
const token = readSessionToken(Astro.request); const id = Astro.params.id!;
if (!token) return Astro.redirect(`/admin/login?returnTo=/admin/pricing/${id}`, 303);
const headers = { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' };
let notice = ''; let conflict = false;
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData(); const operation = String(form.get('operation'));
  let path = operation === 'associate' ? 'experiment-associations' : operation;
  let payload: any = operation === 'associate'
    ? { versionId: form.get('versionId'), experimentId: form.get('experimentId'), variantKey: form.get('variantKey') }
    : { versionId: form.get('versionId'), expectedRevision: Number(form.get('expectedRevision')), reason: form.get('reason') };
  if (operation === 'version') {
    path = 'versions'; payload = { expectedRevision: Number(form.get('expectedRevision')), version: { conditions: [], benefits: [{ type: form.get('benefitType'), value: Number(form.get('benefitValue')) }], exclusions: [], schedule: { startsAt: form.get('startsAt'), endsAt: form.get('endsAt') }, usagePolicy: { globalLimit: null, perCustomerLimit: null, perCouponLimit: null, reservationTtlSeconds: 900 }, priority: Number(form.get('priority') || 0), stackable: false, couponCode: null, priceFloorUgx: Number(form.get('priceFloorUgx') || STOREFRONT_PRICE_FLOOR_UGX) } };
  }
  try { const response = await fetch(`${apiBase}/admin/pricing/definitions/${id}/${path}`, { method: 'POST', headers, body: JSON.stringify(payload) }); const body = await response.json().catch(() => null); conflict = response.status === 409; notice = body?.success ? `${operation} completed and audited.` : body?.error?.message ?? 'Operation failed.'; } catch { notice = 'Pricing service did not respond. The operation was not applied; retry or check the pricing dependency on the Control Centre.'; }
}
let detail: any = null; let denied = false; let failed = false;
try { const response = await fetch(`${apiBase}/admin/pricing/definitions/${id}`, { headers }); denied = response.status === 403; const body = await response.json().catch(() => null); detail = body?.success ? body.data : null; failed = !detail && !denied; } catch { failed = true; }
const current = detail?.versions?.[0];
---
<AdminLayout title="Promotion detail" description="Immutable versions, approval, activation, capacity and audit evidence."><div class="container mx-auto px-6 max-w-6xl">
  <a href="/admin/pricing" class="text-sm">← Pricing operations</a>{notice && <div class={`border rounded-xl p-4 my-4 ${conflict ? 'bg-amber-50 text-amber-900' : 'bg-slate-50'}`}>{conflict ? 'Stale conflict: ' : ''}{notice}</div>}{denied && <div class="bg-red-50 text-red-800 p-4 rounded-xl mt-4">Permission denied: pricing.read required.</div>}{failed && <div class="bg-red-50 text-red-800 p-4 rounded-xl mt-4">Promotion unavailable; no sample state shown.</div>}
  {detail && <><section class="bg-white border rounded-2xl p-6 mt-4"><div class="flex justify-between gap-4"><div><h2 class="text-2xl font-black">{detail.definition.name}</h2><p class="text-sm text-gray-500">{detail.definition.key} · revision {detail.definition.revision}</p></div><strong>{detail.definition.status}</strong></div><p class="mt-3">{detail.definition.description}</p></section>
  {current && <section class="grid lg:grid-cols-2 gap-5 mt-5"><form method="POST" class="bg-white border rounded-2xl p-5 space-y-3"><h3 class="font-black">Governed transition</h3><input type="hidden" name="versionId" value={current.id}/><input type="hidden" name="expectedRevision" value={detail.definition.revision}/><select name="operation" class="w-full border rounded-xl p-2">{['submit','approve','reject','activate','pause','resume','archive'].map((op) => <option value={op}>{op.toUpperCase()}</option>)}</select><textarea name="reason" minlength="3" maxlength="1000" required placeholder="Operator reason" class="w-full border rounded-xl p-2"></textarea><button class="bg-brand-gold font-black rounded-xl px-4 py-2">Apply</button><p class="text-xs text-gray-500">Distinct pricing.manage / approve / activate / pause permissions are enforced by operation.</p></form>
  <form method="POST" class="bg-white border rounded-2xl p-5 space-y-3"><h3 class="font-black">Associate governed Experiment evidence</h3><input type="hidden" name="operation" value="associate"/><input type="hidden" name="versionId" value={current.id}/><input name="experimentId" required placeholder="Experiment UUID" class="w-full border rounded-xl p-2"/><input name="variantKey" required placeholder="Variant key" class="w-full border rounded-xl p-2"/><button class="border border-brand-gold font-black rounded-xl px-4 py-2">Associate to DRAFT</button><p class="text-xs text-gray-500">Only a DRAFT version and an existing governed Experiment variant are accepted.</p></form></section>}
  <section class="bg-white border rounded-2xl p-5 mt-5"><h3 class="font-black mb-3">Create next immutable version</h3><form method="POST" class="grid md:grid-cols-3 gap-3"><input type="hidden" name="operation" value="version"/><input type="hidden" name="expectedRevision" value={detail.definition.revision}/><input name="startsAt" type="datetime-local" required class="border rounded-xl p-2"/><input name="endsAt" type="datetime-local" required class="border rounded-xl p-2"/><select name="benefitType" class="border rounded-xl p-2"><option>PERCENTAGE_OFF</option><option>FIXED_AMOUNT_OFF</option><option>FIXED_PRICE</option><option>FREE_SHIPPING</option></select><input name="benefitValue" type="number" min="0" required placeholder="Benefit" class="border rounded-xl p-2"/><input name="priority" type="number" min="0" max="10000" value="0" class="border rounded-xl p-2"/><label class="text-xs flex flex-col gap-1"><span>Price floor (UGX)</span><input name="priceFloorUgx" type="number" min={STOREFRONT_PRICE_FLOOR_UGX} value={STOREFRONT_PRICE_FLOOR_UGX} required title="The lowest price a discount may reach. Cannot go below the storefront floor." class="border rounded-xl p-2"/></label><button class="border rounded-xl font-black p-2">Create version</button></form></section>
  <section class="grid lg:grid-cols-2 gap-5 mt-5"><div class="bg-white border rounded-2xl p-5"><h3 class="font-black mb-3">Versions & policy</h3><div class="space-y-3">{detail.versions.map((version: any) => <div class="border rounded-xl p-3 text-xs"><strong>v{version.versionNumber} · {version.status}</strong><div>{version.benefits.map((benefit: any) => `${benefit.type} ${benefit.value}`).join(', ')}</div><div>{new Date(version.schedule.startsAt).toLocaleString('en-UG', { timeZone: 'Africa/Kampala' })} → {new Date(version.schedule.endsAt).toLocaleString('en-UG', { timeZone: 'Africa/Kampala' })}</div></div>)}</div></div>
  <div class="bg-white border rounded-2xl p-5"><h3 class="font-black mb-3">Usage & evidence</h3>{detail.capacity.map((row: any) => <div class="text-xs border rounded-xl p-3 mb-2">v{row.versionNumber}: {row.reserved} reserved · {row.redeemed} redeemed · {row.remaining === null ? 'UNLIMITED' : `${row.remaining} remaining`}</div>)}<p class="text-xs">{detail.associations.length} Experiment associations · {detail.approvals.length} approval decisions · {detail.audit.length} shared audit events</p></div></section>
  <section class="bg-white border rounded-2xl p-5 mt-5"><h3 class="font-black mb-3">Audit timeline</h3>{detail.audit.length === 0 ? <div class="text-gray-500 text-sm">Empty — no audit events.</div> : <div class="space-y-2">{detail.audit.map((entry: any) => <div class="text-xs border-b pb-2"><strong>{entry.action}</strong> · {new Date(entry.createdAt).toLocaleString('en-UG', { timeZone: 'Africa/Kampala' })} · actor {entry.actorId ?? 'SYSTEM'}</div>)}</div>}</section></>}
</div></AdminLayout>
