---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { readSessionToken } from "../../../lib/session";
import { tryFetchAdminList } from "../../../lib/api";

const token = readSessionToken(Astro.request);
if (!token) {
  return Astro.redirect("/admin/login?returnTo=/admin/pricing", 303);
}

const result = await tryFetchAdminList<any>('/governance/admin/products', []);
const products = result.items;
const formatter = new Intl.NumberFormat('en-UG', { style: 'currency', currency: 'UGX', maximumFractionDigits: 0 });
---

<AdminLayout 
  title="Pricing Oversight" 
  description="Track item retail values, base price points and currency mappings."
>
  <div class="container mx-auto px-6 lg:px-8 max-w-7xl">
    
    <div class="mb-8 pb-6 border-b border-gray-200 flex flex-col md:flex-row justify-between md:items-center gap-4">
      <div>
        <h2 class="text-2xl font-black text-brand-dark tracking-tight">Pricing & Valuation</h2>
        <p class="text-sm text-gray-500 mt-1 max-w-2xl">
          View active retail selling points stored in PostgreSQL. Value modifications require operational approval.
        </p>
      </div>
      <div class="flex items-center gap-2">
        <span class="text-[8px] border border-yellow-200 bg-yellow-50 text-yellow-700 font-black px-2.5 py-1 rounded uppercase tracking-widest">Read-Only View</span>
      </div>
    </div>

    <div class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden mb-6">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="bg-gray-50 border-b border-gray-100 text-[10px] uppercase font-black text-gray-400 tracking-widest">
            <th class="p-5">Product Spec</th>
            <th class="p-5 text-right">Standard Retail (UGX)</th>
            <th class="p-5 text-center">Currency</th>
          </tr>
        </thead>
        <tbody class="text-xs">
          {products.map(p => (
            <tr class="border-b border-gray-50 hover:bg-gray-50/50 transition-colors">
              <td class="p-5">
                <div class="font-bold text-brand-dark">{p.name}</div>
                <div class="text-[10px] text-gray-400 mt-0.5 font-mono">SKU: {p.sku}</div>
              </td>
              <td class="p-5 text-right font-black text-brand-dark text-sm">
                {p.priceUgx ? formatter.format(p.priceUgx) : 'Price on Request'}
              </td>
              <td class="p-5 text-center font-mono text-gray-500 font-bold">UGX</td>
            </tr>
          ))}
          {products.length === 0 && (
            <tr>
              <td colspan="3" class="p-12 text-center text-gray-400 italic">No items registered in core catalog database.</td>
            </tr>
          )}
        </tbody>
      </table>
    </div>

    <div class="mt-6 bg-gray-100 border border-gray-200 rounded-xl p-4 text-center">
      <p class="text-xs font-bold text-gray-500 flex items-center justify-center gap-2">
        <span>🛠️</span> Bulk update mechanisms, promotional markdown managers and currency multipliers not yet implemented.
      </p>
    </div>

  </div>
</AdminLayout>
