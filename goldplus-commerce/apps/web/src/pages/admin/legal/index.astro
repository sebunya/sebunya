---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { apiBase } from "../../../lib/api";
import { readSessionToken } from "../../../lib/session";

const token = readSessionToken(Astro.request);
if (!token) return Astro.redirect("/admin/login?returnTo=/admin/legal", 303);

const headers = { Authorization: `Bearer ${token}` };
const jsonHeaders = { ...headers, "Content-Type": "application/json" };

type VersionStatus = "DRAFT" | "IN_REVIEW" | "APPROVED" | "SCHEDULED" | "PUBLISHED" | "ARCHIVED";

const fmt = (iso: string | null | undefined) =>
  iso ? String(iso).slice(0, 16).replace("T", " ") : "—";

// ---------------------------------------------------------------------------
// Mutations: POST → API call → 303 redirect back to /admin/legal (PRG).
// The outcome notice travels in the query string so a refresh never
// re-submits the form; the selected version param is preserved.
// ---------------------------------------------------------------------------
if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const action = String(form.get("action") || "");
  const id = String(form.get("id") || "").trim();
  const key = String(form.get("key") || "").trim();
  const text = (name: string) => String(form.get(name) || "").trim();

  const finish = (kind: "success" | "error", message: string, extra: Record<string, string> = {}) => {
    const qs = new URLSearchParams(Astro.url.searchParams);
    qs.delete("notice");
    qs.delete("noticeKind");
    qs.set("noticeKind", kind);
    qs.set("notice", message.slice(0, 400));
    for (const [k, v] of Object.entries(extra)) qs.set(k, v);
    return Astro.redirect(`/admin/legal?${qs.toString()}`, 303);
  };

  try {
    if (action === "create-draft") {
      if (!key) return finish("error", "Missing policy key.");
      const title = text("title");
      const bodyMarkdown = String(form.get("bodyMarkdown") || "");
      if (!title || !bodyMarkdown.trim()) {
        return finish("error", "A title and a body are required to create a draft.");
      }
      const payload: Record<string, string> = { title, bodyMarkdown };
      const changeNote = text("changeNote");
      if (changeNote) payload.changeNote = changeNote;
      const res = await fetch(`${apiBase}/admin/legal/${encodeURIComponent(key)}/drafts`, {
        method: "POST",
        headers: jsonHeaders,
        body: JSON.stringify(payload),
      });
      const json = await res.json().catch(() => null);
      if (!json?.success) return finish("error", json?.error?.message || "Could not create the draft.");
      const newId = json.data?.id ? String(json.data.id) : "";
      return finish(
        "success",
        "Draft created. It stays private until it is reviewed, approved and published.",
        newId ? { version: newId } : {},
      );
    }

    if (action === "rollback") {
      if (!key || !id) return finish("error", "Missing policy key or version id.");
      const res = await fetch(`${apiBase}/admin/legal/${encodeURIComponent(key)}/rollback`, {
        method: "POST",
        headers: jsonHeaders,
        body: JSON.stringify({ versionId: id }),
      });
      const json = await res.json().catch(() => null);
      return json?.success
        ? finish("success", "Rollback complete — that version is the current public version again (audited).")
        : finish("error", json?.error?.message || "Could not roll back to that version.");
    }

    if (!id) return finish("error", "Missing version id.");

    if (action === "save") {
      const res = await fetch(`${apiBase}/admin/legal/versions/${encodeURIComponent(id)}/update`, {
        method: "POST",
        headers: jsonHeaders,
        body: JSON.stringify({
          title: text("title"),
          bodyMarkdown: String(form.get("bodyMarkdown") || ""),
          changeNote: text("changeNote"),
          seoTitle: text("seoTitle"),
          seoDescription: text("seoDescription"),
        }),
      });
      const json = await res.json().catch(() => null);
      return json?.success
        ? finish("success", "Changes saved.")
        : finish("error", json?.error?.message || "Could not save changes.");
    }

    if (action === "submit-review" || action === "approve" || action === "archive") {
      const res = await fetch(`${apiBase}/admin/legal/versions/${encodeURIComponent(id)}/${action}`, {
        method: "POST",
        headers,
      });
      const json = await res.json().catch(() => null);
      if (!json?.success) {
        return finish("error", json?.error?.message || `Could not ${action.replace("-", " ")} this version.`);
      }
      const okText =
        action === "submit-review"
          ? "Submitted for review."
          : action === "approve"
            ? "Version approved. It can now be published or scheduled."
            : "Version archived.";
      return finish("success", okText);
    }

    if (action === "publish") {
      const effectiveAtRaw = text("effectiveAt");
      let body = "{}";
      if (effectiveAtRaw) {
        const parsed = new Date(effectiveAtRaw);
        if (Number.isNaN(parsed.getTime())) {
          return finish("error", "The go-live date/time could not be parsed.");
        }
        body = JSON.stringify({ effectiveAt: parsed.toISOString() });
      }
      const res = await fetch(`${apiBase}/admin/legal/versions/${encodeURIComponent(id)}/publish`, {
        method: "POST",
        headers: jsonHeaders,
        body,
      });
      const json = await res.json().catch(() => null);
      if (!json?.success) return finish("error", json?.error?.message || "Could not publish this version.");
      const resultStatus = String(json.data?.status ?? "");
      if (resultStatus === "SCHEDULED") {
        return finish("success", `Scheduled — goes live at ${fmt(json.data?.effectiveAt)} and becomes the public version then.`);
      }
      if (resultStatus === "PUBLISHED") {
        return finish("success", "Published — this is now the current public version.");
      }
      return finish("success", "Publish request accepted.");
    }

    return finish("error", "Unknown action.");
  } catch {
    return finish("error", "Legal service is unreachable right now.");
  }
}

// ---------------------------------------------------------------------------
// Read side (GET, SSR).
// ---------------------------------------------------------------------------
type VersionRow = {
  id: string;
  version: number | string;
  title: string;
  status: VersionStatus;
  changeNote: string | null;
  effectiveAt: string | null;
  createdAt: string;
  createdBy: string | null;
  approvedBy: string | null;
};
type CurrentVersion = {
  id: string;
  version: number | string;
  title: string;
  status: VersionStatus;
  effectiveAt: string | null;
  publishedAt: string | null;
};
type Policy = {
  key: string;
  title: string;
  currentVersion: CurrentVersion | null;
  versions: VersionRow[];
};
type VersionDetail = {
  id: string;
  policyKey: string;
  version: number | string;
  title: string;
  bodyMarkdown: string;
  changeNote: string | null;
  status: VersionStatus;
  effectiveAt: string | null;
  seoTitle: string | null;
  seoDescription: string | null;
  createdBy: string | null;
  approvedBy: string | null;
  publishedAt: string | null;
};

const url = Astro.url;

// Notice carried over from the PRG redirect (rendered escaped by Astro).
const noticeText = url.searchParams.get("notice") || "";
const notice = noticeText
  ? { kind: url.searchParams.get("noticeKind") === "error" ? ("error" as const) : ("success" as const), text: noticeText }
  : null;

let policies: Policy[] = [];
let loadFailed = false;
try {
  const res = await fetch(`${apiBase}/admin/legal`, { headers, signal: AbortSignal.timeout(5000) });
  const json = await res.json().catch(() => null);
  if (json?.success && json.data) {
    policies = json.data.policies ?? [];
  } else {
    loadFailed = true;
  }
} catch {
  loadFailed = true;
}

// Selected version (?version=<id>) → editor panel.
const selectedId = (url.searchParams.get("version") || "").trim();
let detail: VersionDetail | null = null;
let detailError = "";
if (selectedId) {
  try {
    const res = await fetch(`${apiBase}/admin/legal/versions/${encodeURIComponent(selectedId)}`, {
      headers,
      signal: AbortSignal.timeout(5000),
    });
    const json = await res.json().catch(() => null);
    if (json?.success && json.data) {
      detail = json.data as VersionDetail;
    } else {
      detailError = json?.error?.message || "This version could not be loaded.";
    }
  } catch {
    detailError = "Legal service is unreachable right now.";
  }
}

const currentIds = new Set(policies.map((p) => p.currentVersion?.id).filter(Boolean) as string[]);
const detailIsCurrent = detail ? currentIds.has(detail.id) : false;
const detailEditable = detail ? detail.status === "DRAFT" || detail.status === "IN_REVIEW" : false;

const STATUS_LABEL: Record<VersionStatus, string> = {
  DRAFT: "Draft",
  IN_REVIEW: "In review",
  APPROVED: "Approved",
  SCHEDULED: "Scheduled",
  PUBLISHED: "Published",
  ARCHIVED: "Archived",
};
const STATUS_BADGE: Record<VersionStatus, string> = {
  DRAFT: "border-gray-300 bg-gray-50 text-gray-600",
  IN_REVIEW: "border-amber-200 bg-amber-50 text-amber-800",
  APPROVED: "border-blue-200 bg-blue-50 text-blue-700",
  SCHEDULED: "border-purple-200 bg-purple-50 text-purple-700",
  PUBLISHED: "border-green-200 bg-green-50 text-green-700",
  ARCHIVED: "border-gray-200 bg-gray-100 text-gray-400",
};
const badgeClass = (status: VersionStatus) =>
  `text-[9px] font-black px-2.5 py-1 rounded uppercase tracking-widest border ${STATUS_BADGE[status] ?? STATUS_BADGE.DRAFT}`;

const versionHref = (id: string) => {
  const qs = new URLSearchParams(url.searchParams);
  qs.delete("notice");
  qs.delete("noticeKind");
  qs.set("version", id);
  return `/admin/legal?${qs.toString()}#editor`;
};
const closeHref = (() => {
  const qs = new URLSearchParams(url.searchParams);
  qs.delete("notice");
  qs.delete("noticeKind");
  qs.delete("version");
  const s = qs.toString();
  return s ? `/admin/legal?${s}` : "/admin/legal";
})();

// Plain-paragraph preview: blank lines separate <p> blocks, single newlines
// become <br>. Rendered as escaped text — markdown syntax is shown as typed.
const previewBlocks = (md: string): string[][] =>
  md
    .replace(/\r\n/g, "\n")
    .split(/\n{2,}/)
    .map((block) => block.trim())
    .filter(Boolean)
    .map((block) => block.split("\n"));

const buttonClass = "bg-gray-900 text-white text-[10px] font-black uppercase tracking-widest px-3 py-2 rounded-lg hover:opacity-90";
const primaryButtonClass = "bg-brand-primary text-white text-[10px] font-black uppercase tracking-widest px-3 py-2 rounded-lg hover:opacity-90";
const linkButtonClass = "text-[10px] font-black uppercase tracking-widest text-gray-500 hover:text-gray-800";
---

<AdminLayout
  title="Legal Policy CMS"
  description="Governed drafting, review, approval and publication of the public legal policies."
>
  <div class="container mx-auto px-6 lg:px-8 max-w-7xl space-y-8">
    <div class="pb-6 border-b border-gray-200">
      <h2 class="text-2xl font-black text-brand-dark tracking-tight">Legal Policy CMS</h2>
      <p class="text-sm text-gray-500 mt-1 max-w-3xl">
        Governed drafting for the public legal pages. Every change moves draft → review → approval
        before it can publish, and nothing goes public without approval. Until a policy has a
        published version, its public page keeps showing the built-in published wording.
      </p>
    </div>

    {notice && (
      <div
        class={`rounded-xl border px-4 py-3 text-sm font-bold ${notice.kind === "success" ? "border-green-200 bg-green-50 text-green-700" : "border-red-200 bg-red-50 text-red-700"}`}
        role="status"
      >
        {notice.text}
      </div>
    )}

    <!-- Editor panel for the selected version -->
    {selectedId && detailError && (
      <section id="editor" class="bg-white border border-red-200 rounded-2xl shadow-sm p-6">
        <div class="flex items-center justify-between gap-4">
          <p class="text-sm text-red-600 italic">{detailError}</p>
          <a href={closeHref} class={linkButtonClass}>Close</a>
        </div>
      </section>
    )}

    {detail && (
      <section id="editor" class="bg-white border border-gray-200 rounded-2xl shadow-sm p-6">
        <div class="flex flex-wrap items-center justify-between gap-3 pb-4 border-b border-gray-100">
          <div class="flex flex-wrap items-center gap-2">
            <h3 class="text-lg font-black text-brand-dark">
              {detail.policyKey} — v{detail.version}
            </h3>
            <span class={badgeClass(detail.status)}>{STATUS_LABEL[detail.status] ?? detail.status}</span>
            {detailIsCurrent && (
              <span class="text-[9px] font-black px-2.5 py-1 rounded uppercase tracking-widest border border-green-300 bg-green-100 text-green-800">
                Current public version
              </span>
            )}
          </div>
          <a href={closeHref} class={linkButtonClass}>Close editor</a>
        </div>

        <div class="mt-5 grid gap-8 lg:grid-cols-2">
          <!-- Edit column -->
          <div>
            {detailEditable ? (
              <form method="POST" class="space-y-3">
                <input type="hidden" name="action" value="save" />
                <input type="hidden" name="id" value={detail.id} />
                <label class="block">
                  <span class="text-[10px] uppercase font-black text-gray-400 tracking-widest">Title</span>
                  <input name="title" required maxlength="200" value={detail.title} class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" />
                </label>
                <label class="block">
                  <span class="text-[10px] uppercase font-black text-gray-400 tracking-widest">Body (markdown)</span>
                  <textarea name="bodyMarkdown" required rows="18" class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 text-xs font-mono leading-relaxed">{detail.bodyMarkdown}</textarea>
                </label>
                <label class="block">
                  <span class="text-[10px] uppercase font-black text-gray-400 tracking-widest">Change note</span>
                  <input name="changeNote" maxlength="300" value={detail.changeNote ?? ""} class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" placeholder="What changed and why" />
                </label>
                <div class="grid gap-3 sm:grid-cols-2">
                  <label class="block">
                    <span class="text-[10px] uppercase font-black text-gray-400 tracking-widest">SEO title</span>
                    <input name="seoTitle" maxlength="200" value={detail.seoTitle ?? ""} class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" />
                  </label>
                  <label class="block">
                    <span class="text-[10px] uppercase font-black text-gray-400 tracking-widest">SEO description</span>
                    <input name="seoDescription" maxlength="300" value={detail.seoDescription ?? ""} class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" />
                  </label>
                </div>
                <button type="submit" class={buttonClass}>Save changes</button>
              </form>
            ) : (
              <div class="space-y-3">
                <p class="rounded-xl border border-gray-200 bg-gray-50 px-4 py-3 text-xs text-gray-500">
                  This version is {STATUS_LABEL[detail.status] ?? detail.status} and locked — content can
                  only be edited while a version is Draft or In review.
                </p>
                <label class="block">
                  <span class="text-[10px] uppercase font-black text-gray-400 tracking-widest">Title</span>
                  <input value={detail.title} disabled class="mt-1 w-full rounded-lg border border-gray-200 bg-gray-50 px-3 py-2 text-sm text-gray-500" />
                </label>
                <label class="block">
                  <span class="text-[10px] uppercase font-black text-gray-400 tracking-widest">Body (markdown)</span>
                  <textarea rows="18" disabled class="mt-1 w-full rounded-lg border border-gray-200 bg-gray-50 px-3 py-2 text-xs font-mono leading-relaxed text-gray-500">{detail.bodyMarkdown}</textarea>
                </label>
                <div class="grid gap-3 sm:grid-cols-2 text-xs text-gray-500">
                  <p><span class="text-[10px] uppercase font-black text-gray-400 tracking-widest">Change note</span><br />{detail.changeNote || "—"}</p>
                  <p><span class="text-[10px] uppercase font-black text-gray-400 tracking-widest">SEO title / description</span><br />{detail.seoTitle || "—"} · {detail.seoDescription || "—"}</p>
                </div>
              </div>
            )}

            <!-- Workflow actions for this version -->
            <div class="mt-5 pt-4 border-t border-gray-100 flex flex-wrap items-end gap-3">
              {detail.status === "DRAFT" && (
                <form method="POST">
                  <input type="hidden" name="action" value="submit-review" />
                  <input type="hidden" name="id" value={detail.id} />
                  <button type="submit" class={primaryButtonClass}>Submit for review</button>
                </form>
              )}
              {detail.status === "IN_REVIEW" && (
                <form method="POST">
                  <input type="hidden" name="action" value="approve" />
                  <input type="hidden" name="id" value={detail.id} />
                  <button type="submit" class={primaryButtonClass}>Approve</button>
                </form>
              )}
              {detail.status === "APPROVED" && (
                <>
                  <form method="POST">
                    <input type="hidden" name="action" value="publish" />
                    <input type="hidden" name="id" value={detail.id} />
                    <button type="submit" class={primaryButtonClass}>Publish now</button>
                  </form>
                  <form method="POST" class="flex items-end gap-2">
                    <input type="hidden" name="action" value="publish" />
                    <input type="hidden" name="id" value={detail.id} />
                    <label class="block">
                      <span class="text-[10px] uppercase font-black text-gray-400 tracking-widest">Go-live date &amp; time</span>
                      <input type="datetime-local" name="effectiveAt" required aria-label="Effective date and time for scheduled publication" class="mt-1 rounded-lg border border-gray-300 px-2.5 py-1.5 text-xs" />
                    </label>
                    <button type="submit" class={buttonClass}>Schedule</button>
                  </form>
                </>
              )}
              {detail.status === "SCHEDULED" && (
                <p class="text-xs text-purple-700 font-bold">
                  Scheduled to go live at {fmt(detail.effectiveAt)}. Archiving it cancels the schedule.
                </p>
              )}
              {!detailIsCurrent && detail.status !== "PUBLISHED" && detail.status !== "ARCHIVED" && (
                <form method="POST">
                  <input type="hidden" name="action" value="archive" />
                  <input type="hidden" name="id" value={detail.id} />
                  <button type="submit" class="text-[10px] font-black uppercase tracking-widest text-red-600 hover:text-red-800 px-1 py-2">Archive</button>
                </form>
              )}
              {detail.status === "PUBLISHED" && !detailIsCurrent && (
                <form method="POST">
                  <input type="hidden" name="action" value="rollback" />
                  <input type="hidden" name="key" value={detail.policyKey} />
                  <input type="hidden" name="id" value={detail.id} />
                  <button type="submit" class={buttonClass}>Make current again</button>
                </form>
              )}
            </div>
            {detail.status === "IN_REVIEW" && (
              <p class="mt-2 text-[10px] text-gray-400">
                Maker–checker: the approver must be a different admin than the author; the service
                refuses self-approval.
              </p>
            )}

            <p class="mt-3 text-[10px] text-gray-400">
              Created by {detail.createdBy || "—"} · Approved by {detail.approvedBy || "—"} · Published {fmt(detail.publishedAt)} · Effective {fmt(detail.effectiveAt)}
            </p>
          </div>

          <!-- Preview column (read-only, escaped) -->
          <div class="lg:border-l lg:border-gray-100 lg:pl-8">
            <h4 class="text-[10px] uppercase font-black text-gray-400 tracking-widest">Preview</h4>
            <p class="text-[10px] text-gray-400 mt-1">
              Simple paragraph preview — text is escaped and markdown syntax is shown as typed, not
              rendered as HTML.
            </p>
            <div class="mt-4 rounded-xl border border-gray-200 bg-gray-50/50 p-5 space-y-3 max-h-[36rem] overflow-y-auto">
              <p class="text-base font-black text-brand-dark">{detail.title}</p>
              {previewBlocks(detail.bodyMarkdown).length === 0 ? (
                <p class="text-xs text-gray-400 italic">Nothing to preview yet.</p>
              ) : (
                previewBlocks(detail.bodyMarkdown).map((lines) => (
                  <p class="text-sm text-gray-700 leading-relaxed">
                    {lines.map((line, index) => (
                      <Fragment>
                        {index > 0 && <br />}
                        {line}
                      </Fragment>
                    ))}
                  </p>
                ))
              )}
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- Policy list -->
    {loadFailed && (
      <div class="bg-white border border-red-200 rounded-2xl p-12 text-center text-red-500 italic">
        Legal policies could not be loaded (service unavailable or permission denied). The public
        pages keep serving their built-in published wording regardless.
      </div>
    )}

    {!loadFailed && policies.length === 0 && (
      <div class="bg-white border border-dashed border-gray-300 rounded-2xl p-12 text-center">
        <p class="text-sm font-bold text-gray-600">The legal service returned no policies.</p>
        <p class="text-xs text-gray-400 mt-2">The public pages continue to show their built-in published wording.</p>
      </div>
    )}

    {!loadFailed &&
      policies.map((policy) => (
        <section class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden">
          <div class="p-6 border-b border-gray-100 flex flex-wrap items-start justify-between gap-4">
            <div>
              <h3 class="text-lg font-black text-brand-dark">{policy.title}</h3>
              <p class="font-mono text-[10px] text-gray-400 mt-0.5">{policy.key}</p>
            </div>
            <div class="text-right">
              {policy.currentVersion ? (
                <>
                  <span class={badgeClass("PUBLISHED")}>Published · v{policy.currentVersion.version}</span>
                  <p class="text-[10px] text-gray-400 mt-1.5">
                    Public since {fmt(policy.currentVersion.publishedAt)} · effective {fmt(policy.currentVersion.effectiveAt)}
                  </p>
                </>
              ) : (
                <p class="text-xs font-bold text-amber-800 bg-amber-50 border border-amber-200 rounded-lg px-3 py-2 max-w-xs text-left">
                  No published version — the public page shows its built-in published wording.
                </p>
              )}
            </div>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
              <thead>
                <tr class="bg-gray-50 border-b border-gray-100 text-[10px] uppercase font-black text-gray-400 tracking-widest">
                  <th class="p-4">Version</th>
                  <th class="p-4">Status</th>
                  <th class="p-4">Change note</th>
                  <th class="p-4">Effective</th>
                  <th class="p-4">Created / approved by</th>
                  <th class="p-4 text-right">Actions</th>
                </tr>
              </thead>
              <tbody class="text-xs">
                {policy.versions.length === 0 && (
                  <tr>
                    <td colspan="6" class="p-6 text-center text-gray-400 italic">
                      No versions yet — create the first draft below.
                    </td>
                  </tr>
                )}
                {policy.versions.map((v) => {
                  const isCurrent = policy.currentVersion?.id === v.id;
                  return (
                    <tr class="border-b border-gray-50 hover:bg-gray-50/50 transition-colors align-top">
                      <td class="p-4">
                        <span class="font-mono font-bold text-brand-dark">v{v.version}</span>
                        <p class="text-[10px] text-gray-400 mt-0.5 max-w-[14rem] truncate" title={v.title}>{v.title}</p>
                        <p class="text-[10px] text-gray-300 mt-0.5">created {fmt(v.createdAt)}</p>
                      </td>
                      <td class="p-4">
                        <span class={badgeClass(v.status)}>{STATUS_LABEL[v.status] ?? v.status}</span>
                        {isCurrent && (
                          <p class="mt-1.5">
                            <span class="text-[9px] font-black px-2.5 py-1 rounded uppercase tracking-widest border border-green-300 bg-green-100 text-green-800">
                              Current public version
                            </span>
                          </p>
                        )}
                      </td>
                      <td class="p-4 text-gray-500 max-w-[16rem]">{v.changeNote || "—"}</td>
                      <td class="p-4 text-gray-500 whitespace-nowrap">{fmt(v.effectiveAt)}</td>
                      <td class="p-4 text-gray-500">
                        {v.createdBy || "—"}
                        <span class="text-gray-300"> / </span>
                        {v.approvedBy || "—"}
                      </td>
                      <td class="p-4">
                        <div class="flex flex-col items-end gap-1.5">
                          <a href={versionHref(v.id)} class="text-[10px] font-black uppercase tracking-widest text-brand-dark hover:text-brand-primary">
                            {v.status === "DRAFT" || v.status === "IN_REVIEW" ? "Edit" : "View"}
                          </a>
                          {v.status === "DRAFT" && (
                            <form method="POST">
                              <input type="hidden" name="action" value="submit-review" />
                              <input type="hidden" name="id" value={v.id} />
                              <button type="submit" class={linkButtonClass}>Submit for review</button>
                            </form>
                          )}
                          {v.status === "IN_REVIEW" && (
                            <form method="POST">
                              <input type="hidden" name="action" value="approve" />
                              <input type="hidden" name="id" value={v.id} />
                              <button type="submit" class={linkButtonClass}>Approve</button>
                            </form>
                          )}
                          {v.status === "APPROVED" && (
                            <>
                              <form method="POST">
                                <input type="hidden" name="action" value="publish" />
                                <input type="hidden" name="id" value={v.id} />
                                <button type="submit" class={linkButtonClass}>Publish now</button>
                              </form>
                              <form method="POST" class="flex items-center justify-end gap-1.5">
                                <input type="hidden" name="action" value="publish" />
                                <input type="hidden" name="id" value={v.id} />
                                <input type="datetime-local" name="effectiveAt" required aria-label="Effective date and time for scheduled publication" class="rounded-lg border border-gray-300 px-2 py-1 text-[10px]" />
                                <button type="submit" class={linkButtonClass}>Schedule</button>
                              </form>
                            </>
                          )}
                          {v.status === "PUBLISHED" && !isCurrent && (
                            <form method="POST">
                              <input type="hidden" name="action" value="rollback" />
                              <input type="hidden" name="key" value={policy.key} />
                              <input type="hidden" name="id" value={v.id} />
                              <button type="submit" class={linkButtonClass}>Make current again</button>
                            </form>
                          )}
                          {!isCurrent && v.status !== "PUBLISHED" && v.status !== "ARCHIVED" && (
                            <form method="POST">
                              <input type="hidden" name="action" value="archive" />
                              <input type="hidden" name="id" value={v.id} />
                              <button type="submit" class="text-[10px] font-black uppercase tracking-widest text-red-600 hover:text-red-800">Archive</button>
                            </form>
                          )}
                        </div>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>

          <details class="border-t border-gray-100 bg-gray-50/50">
            <summary class="cursor-pointer px-6 py-4 text-[10px] font-black uppercase tracking-widest text-gray-500 hover:text-gray-800">
              New draft for {policy.title}
            </summary>
            <form method="POST" class="px-6 pb-6 space-y-3">
              <input type="hidden" name="action" value="create-draft" />
              <input type="hidden" name="key" value={policy.key} />
              <label class="block">
                <span class="text-[10px] uppercase font-black text-gray-400 tracking-widest">Title</span>
                <input name="title" required maxlength="200" value={policy.title} class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" />
              </label>
              <label class="block">
                <span class="text-[10px] uppercase font-black text-gray-400 tracking-widest">Body (markdown)</span>
                <textarea
                  name="bodyMarkdown"
                  required
                  rows="10"
                  class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 text-xs font-mono leading-relaxed"
                  placeholder="Full policy text in markdown…"
                ></textarea>
              </label>
              <label class="block">
                <span class="text-[10px] uppercase font-black text-gray-400 tracking-widest">Change note</span>
                <input name="changeNote" maxlength="300" class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" placeholder="What this draft changes and why" />
              </label>
              <div class="flex items-center gap-3">
                <button type="submit" class={buttonClass}>Create draft</button>
                <p class="text-[10px] text-gray-400">
                  Drafts are private. This policy's public page is untouched until a version is
                  approved and published.
                </p>
              </div>
            </form>
          </details>
        </section>
      ))}
  </div>
</AdminLayout>
