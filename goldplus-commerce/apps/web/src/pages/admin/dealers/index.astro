---
import BaseLayout from "../../../layouts/BaseLayout.astro";

// Mock pending dealers
const pendingDealers = [
  { id: 'd1', biz: 'Kampala Electronics Ltd', location: 'Kampala', status: 'pending' },
  { id: 'd2', biz: 'Jinja Tech Hub', location: 'Jinja', status: 'pending' }
];
---

<BaseLayout title="Dealer Review - GoldPlus Admin">
  <div class="container mx-auto px-4 lg:px-8 py-12">
    <div class="flex items-center justify-between mb-8">
      <div>
        <h1 class="text-3xl font-black text-brand-dark">Dealer Applications</h1>
        <p class="text-gray-500">Review business credentials for authorized GoldPlus dealership in Uganda.</p>
      </div>
      <a href="/admin" class="text-sm font-bold text-gray-500 hover:text-brand-dark">&larr; Back to Dashboard</a>
    </div>

    <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="bg-gray-50 text-[10px] uppercase font-black text-gray-400 tracking-widest border-b border-gray-100">
            <th class="p-6">Business Name</th>
            <th class="p-6">Location</th>
            <th class="p-6">Status</th>
            <th class="p-6">Actions</th>
          </tr>
        </thead>
        <tbody class="text-sm">
          {pendingDealers.map(d => (
            <tr class="border-b border-gray-100 hover:bg-gray-50 transition-colors">
              <td class="p-6 font-bold text-brand-dark">{d.biz}</td>
              <td class="p-6 text-gray-600">{d.location}</td>
              <td class="p-6">
                <span class="bg-orange-50 text-orange-600 px-2 py-1 rounded font-bold text-[10px] uppercase italic">Review Required</span>
              </td>
              <td class="p-6 flex gap-2">
                <button class="bg-brand-green text-white px-4 py-2 rounded font-bold text-xs hover:bg-green-700 transition-colors">Approve</button>
                <button class="bg-gray-100 text-gray-500 px-4 py-2 rounded font-bold text-xs hover:bg-gray-200 transition-colors">Details</button>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
      {pendingDealers.length === 0 && (
        <div class="p-20 text-center text-gray-400 italic">No pending dealer applications.</div>
      )}
    </div>
  </div>
</BaseLayout>
