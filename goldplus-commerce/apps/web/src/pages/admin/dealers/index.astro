---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { readSessionToken } from "../../../lib/session";
import { tryFetchAdminList } from "../../../lib/api";

const token = readSessionToken(Astro.request);
if (!token) {
  return Astro.redirect("/admin/login?returnTo=/admin/dealers", 303);
}

// Mock pending dealers
const fallbackDealers = [
  { id: 'd1', businessName: 'Kampala Electronics Ltd', location: 'Kampala', status: 'pending', email: 'info@kelectronics.ug', contactPerson: 'Main Rep' },
  { id: 'd2', businessName: 'Jinja Tech Hub', location: 'Jinja', status: 'pending', email: 'hello@jhub.ug', contactPerson: 'Site Mgr' }
];

// Attempt authentic fetching
const result = await tryFetchAdminList('/governance/admin/dealers', fallbackDealers);
const dealers = result.items;
---

<AdminLayout 
  title="Dealer Applications" 
  description="Assess retail applications for wholesale credentials."
>
  <div class="container mx-auto px-6 lg:px-8 max-w-7xl">
    
    <div class="flex flex-col sm:flex-row sm:items-center justify-between mb-8 gap-4 pb-6 border-b border-gray-200">
      <div>
        <h2 class="text-2xl font-black text-brand-dark tracking-tight">B2B Dealer Applications</h2>
        <p class="text-sm text-gray-500 mt-1">Review business credentials for authorized GoldPlus dealership credentials in Uganda.</p>
      </div>
      <div class="flex items-center gap-2">
        <span class="bg-gray-100 text-gray-600 border border-gray-200 text-xs font-bold px-3 py-1.5 rounded-lg font-mono">
          APPLICANTS: {dealers.length}
        </span>
      </div>
    </div>

    {result.isSample && (
      <div class="bg-blue-50 border border-blue-200 text-blue-800 px-6 py-4 rounded-2xl mb-8 flex items-center gap-4">
        <span class="text-2xl">💡</span>
        <div class="text-xs leading-relaxed"><strong>Offline Sandbox Note:</strong> {result.reason}</div>
      </div>
    )}

    <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-gray-50 text-[10px] uppercase font-black text-gray-400 tracking-widest border-b border-gray-100">
              <th class="p-6">Business Entity</th>
              <th class="p-6">Regional Hub</th>
              <th class="p-6 text-center">Evaluation</th>
            </tr>
          </thead>
          <tbody class="text-xs divide-y divide-gray-50">
            {dealers.map(d => (
              <tr class="hover:bg-gray-50 transition-colors">
                <td class="p-6">
                  <div class="font-bold text-brand-dark text-sm">{d.businessName || d.biz}</div>
                  <div class="text-[10px] font-mono text-gray-400 mt-1">{d.email || 'No contact details'}</div>
                </td>
                <td class="p-6 text-gray-600 font-medium">
                  {d.location || 'Undisclosed District'}
                </td>
                <td class="p-6 text-center">
                  <span class="inline-block px-2.5 py-1 rounded-lg font-black text-[9px] uppercase tracking-wide border border-yellow-200 bg-yellow-50 text-yellow-700">
                    {d.status}
                  </span>
                </td>
              </tr>
            ))}
            {dealers.length === 0 && (
              <tr>
                <td colspan="3" class="p-20 text-center text-gray-400 italic text-xs leading-relaxed">
                  Zero dealer applicants tracked in query store.
                </td>
              </tr>
            )}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</AdminLayout>

