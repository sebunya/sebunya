---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { readSessionToken } from "../../../lib/session";
import { apiBase, publicApiBase } from "../../../lib/api";

/** Product feed operations.
 *
 *  This page previously read "Syndication Layer Halted — scheduled for phase
 *  development" while a working Merchant Center feed was already being served
 *  publicly and a full quality report already existed behind
 *  /admin/seo/merchant/feed-quality. Nothing was halted; the console simply
 *  never showed it.
 *
 *  Feed readiness and destination configuration are reported separately: the
 *  feed being generated is a fact about GoldPlus, and whether a marketplace has
 *  been pointed at it is a different fact entirely. */
const token = readSessionToken(Astro.request);
if (!token) return Astro.redirect("/admin/login?returnTo=/admin/feeds", 303);

const FEED_URL = `${publicApiBase}/seo/merchant-feed.xml`;

async function get<T>(path: string) {
  try {
    const res = await fetch(`${apiBase}${path}`, {
      headers: { Accept: "application/json", Authorization: `Bearer ${token}` },
    });
    const json: any = await res.json().catch(() => null);
    if (res.status === 401 || res.status === 403) return { ok: false, data: null as T | null, error: "Your account does not carry the SEO permission." };
    if (!res.ok || !json?.success) return { ok: false, data: null as T | null, error: json?.error?.message ?? `The feed API declined the request (HTTP ${res.status}).` };
    return { ok: true, data: json.data as T, error: null as string | null };
  } catch {
    return { ok: false, data: null as T | null, error: "The feed API could not be reached." };
  }
}

const report = await get<any>("/admin/seo/merchant/feed-quality");
const r = report.data;
const total = Number(r?.totalProducts ?? 0);
const included = Number(r?.includedInFeed ?? 0);
const excluded = Number(r?.excludedFromFeed ?? 0);
const issueCounts: Record<string, number> = r?.issueCounts ?? {};
const rows: any[] = Array.isArray(r?.products) ? r.products : [];

/** Issues that keep a product OUT of the feed, versus quality warnings that do not. */
const BLOCKING = new Set(["not_feed_eligible", "inactive", "not_approved", "missing_image", "missing_price"]);
const ISSUE_LABEL: Record<string, string> = {
  not_feed_eligible: "Not marked feed-eligible",
  inactive: "Product is inactive",
  not_approved: "Not approved",
  missing_image: "No image",
  missing_price: "No price",
  missing_description: "No description",
  description_under_50_chars: "Description under 50 characters",
  missing_mpn: "No model number (MPN)",
  title_over_150_chars: "Title over 150 characters",
};

const blockingIssues = Object.entries(issueCounts).filter(([k]) => BLOCKING.has(k)).sort((a, b) => b[1] - a[1]);
const warningIssues = Object.entries(issueCounts).filter(([k]) => !BLOCKING.has(k)).sort((a, b) => b[1] - a[1]);

const excludedRows = rows.filter((p) => !p.included).slice(0, 50);
const warnedRows = rows.filter((p) => p.included && (p.issues ?? []).length > 0).slice(0, 50);
---

<AdminLayout title="Product Feeds" description="Merchant feed contents, eligibility and validation from the live catalogue.">
  <div class="container mx-auto px-6 lg:px-8 max-w-7xl">
    <div class="mb-8 pb-6 border-b border-gray-200">
      <h2 class="text-2xl font-black text-brand-dark tracking-tight">Product Feeds</h2>
      <p class="text-sm text-gray-500 mt-1 max-w-3xl">
        The Merchant Center feed is generated from the live catalogue and served continuously. A product only enters
        the feed when it is eligible, active, approved, priced and has an image — every exclusion below names its
        reason, so one incomplete product never silently removes the rest.
      </p>
    </div>

    {report.error ? (
      <div role="alert" class="rounded-2xl border border-red-300 bg-red-50 p-6 text-sm text-red-900">
        <strong class="block font-black uppercase tracking-widest text-xs mb-1">Feed report unavailable</strong>
        {report.error}
      </div>
    ) : (
      <>
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-8">
          <div class="rounded-2xl border border-emerald-300 bg-emerald-50 p-5">
            <p class="text-[10px] font-black uppercase tracking-widest text-emerald-700">Feed status</p>
            <p class="mt-1 text-xl font-black text-emerald-900">Generating</p>
            <p class="mt-1 text-[11px] text-emerald-800">Rebuilt on demand, cached for 15 minutes.</p>
          </div>
          <div class="rounded-2xl border border-gray-200 bg-white p-5">
            <p class="text-[10px] font-black uppercase tracking-widest text-gray-400">Catalogue products</p>
            <p class="mt-1 text-xl font-black text-brand-dark">{total.toLocaleString("en-UG")}</p>
          </div>
          <div class="rounded-2xl border border-gray-200 bg-white p-5">
            <p class="text-[10px] font-black uppercase tracking-widest text-gray-400">Included in feed</p>
            <p class="mt-1 text-xl font-black text-emerald-800">{included.toLocaleString("en-UG")}</p>
            <p class="mt-1 text-[11px] text-gray-500">{total > 0 ? `${((included / total) * 100).toFixed(0)}% of catalogue` : "No products yet."}</p>
          </div>
          <div class="rounded-2xl border border-gray-200 bg-white p-5">
            <p class="text-[10px] font-black uppercase tracking-widest text-gray-400">Excluded</p>
            <p class="mt-1 text-xl font-black text-amber-800">{excluded.toLocaleString("en-UG")}</p>
            <p class="mt-1 text-[11px] text-gray-500">Each exclusion has a stated reason.</p>
          </div>
        </div>

        <section class="mb-8 rounded-2xl border border-gray-200 bg-white p-6">
          <h3 class="text-xs font-black uppercase tracking-widest text-gray-500">Feed artifact</h3>
          <p class="mt-2 break-all font-mono text-xs text-brand-dark bg-gray-50 rounded-xl border border-gray-200 p-3">{FEED_URL}</p>
          <div class="mt-3 flex flex-wrap items-center gap-3">
            <a href={FEED_URL} target="_blank" rel="noopener"
              class="rounded-xl border border-gray-300 bg-white px-4 py-2 text-xs font-black uppercase tracking-widest text-brand-dark hover:bg-gray-50">Open feed</a>
            <button type="button" id="copy-feed"
              class="rounded-xl border border-gray-300 bg-white px-4 py-2 text-xs font-black uppercase tracking-widest text-gray-600 hover:bg-gray-50">Copy URL</button>
            <span id="copy-done" class="hidden text-xs font-bold text-emerald-800">Copied</span>
          </div>
          <div class="mt-4 rounded-xl border border-blue-200 bg-blue-50 p-4 text-xs text-blue-900">
            <strong class="font-black uppercase tracking-widest text-[10px]">Destination · setup required</strong>
            <p class="mt-1">
              The feed is ready and public. Pointing a marketplace at it is a separate step: add this URL as a
              scheduled fetch in Google Merchant Center. GoldPlus does not push to a destination and needs no
              marketplace credential to keep the feed current.
            </p>
          </div>
        </section>

        <section class="mb-8 grid grid-cols-1 lg:grid-cols-2 gap-6">
          <div class="rounded-2xl border border-gray-200 bg-white p-6">
            <h3 class="text-xs font-black uppercase tracking-widest text-gray-500 mb-3">Exclusion reasons</h3>
            {blockingIssues.length === 0 ? (
              <p class="text-xs text-gray-500">No product is excluded for a blocking reason.</p>
            ) : (
              <ul class="space-y-2">
                {blockingIssues.map(([k, v]) => (
                  <li class="flex items-center justify-between text-xs">
                    <span class="text-gray-700">{ISSUE_LABEL[k] ?? k}</span>
                    <span class="font-black text-amber-800">{v}</span>
                  </li>
                ))}
              </ul>
            )}
          </div>
          <div class="rounded-2xl border border-gray-200 bg-white p-6">
            <h3 class="text-xs font-black uppercase tracking-widest text-gray-500 mb-3">Quality warnings</h3>
            <p class="text-[11px] text-gray-500 mb-3">These products are in the feed. The warnings affect how well they perform, not whether they appear.</p>
            {warningIssues.length === 0 ? (
              <p class="text-xs text-gray-500">No quality warnings.</p>
            ) : (
              <ul class="space-y-2">
                {warningIssues.map(([k, v]) => (
                  <li class="flex items-center justify-between text-xs">
                    <span class="text-gray-700">{ISSUE_LABEL[k] ?? k}</span>
                    <span class="font-black text-gray-600">{v}</span>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </section>

        {excludedRows.length > 0 && (
          <section class="mb-8">
            <h3 class="text-sm font-black uppercase tracking-widest text-gray-500 mb-3">Excluded products</h3>
            <div class="overflow-x-auto rounded-2xl border border-gray-200 bg-white">
              <table class="w-full text-xs">
                <thead><tr class="text-left text-[10px] uppercase tracking-widest text-gray-400 border-b border-gray-100">
                  <th class="p-3">SKU</th><th>Slug</th><th class="p-3">Why it is excluded</th>
                </tr></thead>
                <tbody>
                  {excludedRows.map((p) => (
                    <tr class="border-b border-gray-50">
                      <td class="p-3 font-mono">{p.sku}</td>
                      <td class="font-mono text-gray-500">{p.slug}</td>
                      <td class="p-3">
                        {(p.issues ?? []).filter((i: string) => BLOCKING.has(i)).map((i: string) => (
                          <span class="mr-1 inline-block rounded-full border border-amber-300 bg-amber-50 px-2 py-0.5 text-[10px] font-bold text-amber-900">{ISSUE_LABEL[i] ?? i}</span>
                        ))}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            {excluded > excludedRows.length && (
              <p class="mt-2 text-[11px] text-gray-500">Showing the first {excludedRows.length} of {excluded} excluded products.</p>
            )}
          </section>
        )}

        {warnedRows.length > 0 && (
          <section class="mb-16">
            <h3 class="text-sm font-black uppercase tracking-widest text-gray-500 mb-3">Included, with warnings</h3>
            <div class="overflow-x-auto rounded-2xl border border-gray-200 bg-white">
              <table class="w-full text-xs">
                <thead><tr class="text-left text-[10px] uppercase tracking-widest text-gray-400 border-b border-gray-100">
                  <th class="p-3">SKU</th><th>Slug</th><th class="p-3">Warnings</th>
                </tr></thead>
                <tbody>
                  {warnedRows.map((p) => (
                    <tr class="border-b border-gray-50">
                      <td class="p-3 font-mono">{p.sku}</td>
                      <td class="font-mono text-gray-500">{p.slug}</td>
                      <td class="p-3">
                        {(p.issues ?? []).filter((i: string) => !BLOCKING.has(i)).map((i: string) => (
                          <span class="mr-1 inline-block rounded-full border border-gray-300 bg-gray-50 px-2 py-0.5 text-[10px] font-bold text-gray-600">{ISSUE_LABEL[i] ?? i}</span>
                        ))}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        )}
      </>
    )}
  </div>

  <script is:inline define:vars={{ FEED_URL }}>
    document.getElementById('copy-feed')?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(FEED_URL);
        const d = document.getElementById('copy-done');
        if (d) { d.classList.remove('hidden'); setTimeout(() => d.classList.add('hidden'), 2000); }
      } catch { /* clipboard unavailable; the URL stays selectable above */ }
    });
  </script>
</AdminLayout>
