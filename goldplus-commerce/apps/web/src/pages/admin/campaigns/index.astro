---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { readSessionToken } from "../../../lib/session";
import { apiBase } from "../../../lib/api";

const token = readSessionToken(Astro.request);
if (!token) {
  return Astro.redirect("/admin/login?returnTo=/admin/campaigns", 303);
}
const headers = { Authorization: `Bearer ${token}`, "Content-Type": "application/json" };

// Wave 2F: campaign scaffold — definitions, UTM links, count-only audience preview.
// This replaced the truthful "not configured" placeholder the moment a real campaign
// API existed. There is NO send path from this workspace; the banner says so plainly.
let notice: { kind: "success" | "error"; text: string } | null = null;
if (Astro.request.method === "POST") {
  try {
    const form = await Astro.request.formData();
    const action = String(form.get("action") || "");
    if (action === "create") {
      const res = await fetch(`${apiBase}/admin/campaigns`, {
        method: "POST", headers,
        body: JSON.stringify({
          name: form.get("name"), objective: form.get("objective"),
          channel: form.get("channel"), targetUrl: form.get("targetUrl") || null,
        }),
      });
      const json = await res.json().catch(() => null);
      notice = res.ok && json?.success
        ? { kind: "success", text: `Campaign “${json.data.name}” created as DRAFT.` }
        : { kind: "error", text: json?.error?.message || "Create refused." };
    } else if (action === "status") {
      const id = String(form.get("id") || "");
      const res = await fetch(`${apiBase}/admin/campaigns/${encodeURIComponent(id)}/status`, {
        method: "POST", headers, body: JSON.stringify({ status: form.get("status") }),
      });
      const json = await res.json().catch(() => null);
      notice = res.ok && json?.success
        ? { kind: "success", text: `Campaign is now ${json.data.status}.` }
        : { kind: "error", text: json?.error?.message || "Status change refused." };
    } else if (action === "dryrun") {
      const id = String(form.get("id") || "");
      const res = await fetch(`${apiBase}/admin/campaigns/${encodeURIComponent(id)}/dry-run`, { method: "POST", headers });
      const json = await res.json().catch(() => null);
      notice = res.ok && json?.success
        ? { kind: "success", text: `Dry run complete: ${json.data.counts.candidates} candidates → ${json.data.counts.eligible} would be eligible (no identity ${json.data.counts.noIdentity}, no consent ${json.data.counts.noConsent}, suppressed ${json.data.counts.suppressed}, frequency-capped ${json.data.counts.frequency})${json.data.quietHoursAtRun ? " — quiet hours right now, a live send would wait" : ""}. Nothing was sent.` }
        : { kind: "error", text: json?.error?.message || "Dry run refused." };
    } else if (action === "utm") {
      const id = String(form.get("id") || "");
      const res = await fetch(`${apiBase}/admin/campaigns/${encodeURIComponent(id)}/utm-links`, {
        method: "POST", headers,
        body: JSON.stringify({
          source: form.get("source"), medium: form.get("medium"),
          campaignName: form.get("campaignName"), content: form.get("content") || null,
        }),
      });
      const json = await res.json().catch(() => null);
      notice = res.ok && json?.success
        ? { kind: "success", text: `UTM link added (${json.data.shortUrl}).` }
        : { kind: "error", text: json?.error?.message || "UTM link refused." };
    }
  } catch {
    notice = { kind: "error", text: "Campaign service is unreachable right now." };
  }
}

let campaigns: any[] = [];
let audience: any = null;
let loadError = "";
try {
  const [listRes, audRes] = await Promise.all([
    fetch(`${apiBase}/admin/campaigns`, { headers, signal: AbortSignal.timeout(5000) }),
    fetch(`${apiBase}/admin/campaigns/audience-preview`, { headers, signal: AbortSignal.timeout(5000) }),
  ]);
  const listJson = await listRes.json().catch(() => null);
  const audJson = await audRes.json().catch(() => null);
  if (listJson?.success) campaigns = listJson.data.campaigns;
  else loadError = listJson?.error?.message || "Could not load campaigns.";
  if (audJson?.success) audience = audJson.data;
} catch {
  loadError = "Campaign service is unreachable right now.";
}
const fmtUgx = (n: number) => `UGX ${Number(n || 0).toLocaleString('en-US', { timeZone: 'Africa/Kampala' })}`;
const STATUS_STYLE: Record<string, string> = {
  DRAFT: "bg-slate-100 text-slate-700 border-slate-200",
  APPROVED: "bg-emerald-50 text-emerald-800 border-emerald-300",
  PAUSED: "bg-amber-50 text-amber-800 border-amber-300",
  ARCHIVED: "bg-gray-100 text-gray-500 border-gray-200",
};
---

<AdminLayout title="Campaigns" description="Campaign definitions, UTM links and audience preview — the send engine ships in a later wave and no message can be sent from here.">
  <div class="space-y-8">
    <div class="rounded-xl border border-amber-300 bg-amber-50 px-4 py-3 text-xs font-bold text-amber-900">
      No-send workspace: definitions, UTM links, audience preview and DRY-RUN eligibility analysis
      (identity → consent → suppression → frequency → quiet hours, decision ledger recorded). Live
      sending does not exist here — nothing on this page can message a customer.
    </div>

    {notice && (
      <div class={`rounded-xl px-4 py-3 text-sm font-semibold ${notice.kind === "success" ? "bg-emerald-50 text-emerald-800" : "bg-rose-50 text-rose-800"}`}>{notice.text}</div>
    )}
    {loadError && (
      <div class="rounded-xl bg-rose-50 px-4 py-3 text-sm font-semibold text-rose-800">{loadError}</div>
    )}

    {audience && (
      <section class="rounded-2xl border border-slate-200 bg-white p-5">
        <h2 class="text-sm font-black uppercase tracking-widest text-slate-500">Audience preview — abandoned carts</h2>
        <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4">
          <div class="rounded-xl border border-slate-200 bg-slate-50 p-3"><p class="text-[10px] font-black uppercase tracking-widest text-slate-400">Open abandonments</p><p class="mt-1 text-lg font-black text-slate-800">{audience.openAbandonments}</p></div>
          <div class="rounded-xl border border-slate-200 bg-slate-50 p-3"><p class="text-[10px] font-black uppercase tracking-widest text-slate-400">Known identity</p><p class="mt-1 text-lg font-black text-slate-800">{audience.withKnownIdentity}</p></div>
          <div class="rounded-xl border border-slate-200 bg-slate-50 p-3"><p class="text-[10px] font-black uppercase tracking-widest text-slate-400">Guest only</p><p class="mt-1 text-lg font-black text-slate-800">{audience.guestOnly}</p></div>
          <div class="rounded-xl border border-slate-200 bg-slate-50 p-3"><p class="text-[10px] font-black uppercase tracking-widest text-slate-400">Basket value</p><p class="mt-1 text-lg font-black text-slate-800">{fmtUgx(audience.totalValueUgx)}</p></div>
        </div>
        <p class="mt-3 text-[11px] text-slate-500">{audience.consentNote}</p>
      </section>
    )}

    <section class="rounded-2xl border border-slate-200 bg-white p-5">
      <h2 class="text-sm font-black uppercase tracking-widest text-slate-500">New campaign</h2>
      <form method="POST" class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-5">
        <input type="hidden" name="action" value="create" />
        <input name="name" required maxlength="255" placeholder="Name" class="sm:col-span-2 rounded-xl border border-gray-200 bg-gray-50 px-3 py-2.5 text-xs font-medium outline-none focus:border-brand-gold" />
        <input name="objective" required maxlength="50" placeholder="Objective (e.g. recover-carts)" class="rounded-xl border border-gray-200 bg-gray-50 px-3 py-2.5 text-xs font-medium outline-none focus:border-brand-gold" />
        <select name="channel" aria-label="Campaign channel" class="rounded-xl border border-gray-200 bg-gray-50 px-3 py-2.5 text-xs font-bold outline-none focus:border-brand-gold">
          <option value="email">email</option><option value="sms">sms</option>
          <option value="whatsapp">whatsapp</option><option value="internal">internal</option>
        </select>
        <button type="submit" class="rounded-xl bg-brand-dark px-4 py-2.5 text-xs font-black uppercase tracking-wide text-white hover:bg-black">Create draft</button>
        <input name="targetUrl" placeholder="Target URL (https://shopgoldplus.com/…)" class="sm:col-span-5 rounded-xl border border-gray-200 bg-gray-50 px-3 py-2.5 text-xs font-medium outline-none focus:border-brand-gold" />
      </form>
    </section>

    <section class="rounded-2xl border border-slate-200 bg-white p-5">
      <h2 class="text-sm font-black uppercase tracking-widest text-slate-500">Campaigns</h2>
      {campaigns.length === 0 ? (
        <p class="mt-4 text-sm font-medium text-slate-500">No campaigns defined yet. Create the first draft above — nothing goes live from this workspace.</p>
      ) : (
        <div class="mt-4 space-y-4">
          {campaigns.map((cmp) => (
            <div class="rounded-xl border border-slate-200 p-4">
              <div class="flex flex-wrap items-center gap-2">
                <span class="text-sm font-black text-slate-800">{cmp.name}</span>
                <span class={`rounded-full border px-2 py-0.5 text-[10px] font-black uppercase ${STATUS_STYLE[cmp.status] ?? STATUS_STYLE.DRAFT}`}>{cmp.status}</span>
                <span class="text-[11px] font-bold text-slate-500">{cmp.channel} · {cmp.objective} · {cmp.utmLinkCount} UTM link(s)</span>
              </div>
              {cmp.targetUrl && <p class="mt-1 text-[11px] font-medium text-slate-500">{cmp.targetUrl}</p>}
              <div class="mt-3 flex flex-wrap items-end gap-3">
                <form method="POST" class="flex items-center gap-2">
                  <input type="hidden" name="action" value="status" />
                  <input type="hidden" name="id" value={cmp.id} />
                  <select name="status" aria-label="New campaign status" class="rounded-lg border border-gray-200 bg-gray-50 px-2 py-1.5 text-[11px] font-bold outline-none">
                    <option value="APPROVED">APPROVED</option><option value="PAUSED">PAUSED</option><option value="ARCHIVED">ARCHIVED</option>
                  </select>
                  <button type="submit" class="rounded-lg border border-gray-300 bg-white px-3 py-1.5 text-[10px] font-black uppercase tracking-widest text-gray-700 hover:bg-gray-50">Set status</button>
                </form>
                <form method="POST" class="flex items-center gap-2">
                  <input type="hidden" name="action" value="dryrun" />
                  <input type="hidden" name="id" value={cmp.id} />
                  <button type="submit" class="rounded-lg bg-brand-dark px-3 py-1.5 text-[10px] font-black uppercase tracking-widest text-white hover:bg-black">Dry-run eligibility</button>
                </form>
                <form method="POST" class="flex flex-wrap items-center gap-2">
                  <input type="hidden" name="action" value="utm" />
                  <input type="hidden" name="id" value={cmp.id} />
                  <input name="source" required placeholder="utm_source" class="w-28 rounded-lg border border-gray-200 bg-gray-50 px-2 py-1.5 text-[11px] font-medium outline-none" />
                  <input name="medium" required placeholder="utm_medium" class="w-28 rounded-lg border border-gray-200 bg-gray-50 px-2 py-1.5 text-[11px] font-medium outline-none" />
                  <input name="campaignName" required placeholder="utm_campaign" class="w-32 rounded-lg border border-gray-200 bg-gray-50 px-2 py-1.5 text-[11px] font-medium outline-none" />
                  <button type="submit" class="rounded-lg border border-gray-300 bg-white px-3 py-1.5 text-[10px] font-black uppercase tracking-widest text-gray-700 hover:bg-gray-50">Add UTM link</button>
                </form>
              </div>
            </div>
          ))}
        </div>
      )}
    </section>
  </div>
</AdminLayout>
