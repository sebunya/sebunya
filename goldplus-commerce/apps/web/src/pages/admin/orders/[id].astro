---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { readSessionToken } from "../../../lib/session";
import { apiBase, whatsappSupportNumber, getOrderNotificationTimeline } from "../../../lib/api";
import NotificationChannelPanel from "../../../components/admin/NotificationChannelPanel.astro";
import NotificationTimeline from "../../../components/admin/NotificationTimeline.astro";

const token = readSessionToken(Astro.request);
if (!token) {
  return Astro.redirect("/admin/login?returnTo=/admin/orders", 303);
}

const { id } = Astro.params;

let actionError = '';
let actionSuccess = '';

// Handle Server-Side Post Actions for State Transitions
if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const action = formData.get('action')?.toString() || 'fulfillment';

    if (action === 'lifecycle') {
      // Wave 2E-2: lifecycle transitions ride the canonical OrderTransitionService —
      // a refused move surfaces the state machine's own message (409/403), never a
      // generic failure. Reason is mandatory and lands in the order_events ledger.
      const toStatus = formData.get('toStatus')?.toString().trim() || '';
      const reason = formData.get('reason')?.toString().trim() || '';
      const res = await fetch(`${apiBase}/admin/orders/${id}/transition`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
        body: JSON.stringify({ toStatus, reason }),
      });
      const json = await res.json().catch(() => null);
      if (res.ok && json?.success) {
        actionSuccess = `Order moved ${json.data.fromStatus} → ${json.data.toStatus}${json.data.idempotentReplay ? ' (idempotent replay)' : ''}.`;
      } else {
        actionError = json?.error?.message || 'Transition refused by backend validation.';
      }
    } else if (action === 'note') {
      const note = formData.get('note')?.toString().trim() || '';
      const res = await fetch(`${apiBase}/admin/orders/${id}/note`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
        body: JSON.stringify({ note }),
      });
      const json = await res.json().catch(() => null);
      if (res.ok && json?.success) actionSuccess = 'Note recorded in the audit trail.';
      else actionError = json?.error?.message || 'Note refused.';
    } else {
    const nextStatus = formData.get('status')?.toString().trim() || '';

    const patchRes = await fetch(`${apiBase}/governance/admin/orders/${id}/fulfillment`, {
      method: 'PATCH',
      headers: {
        'Content-Type': 'application/json',
        'Authorization': `Bearer ${token}`
      },
      body: JSON.stringify({ status: nextStatus })
    });

    const patchJson = await patchRes.json().catch(() => null);
    if (patchRes.ok && patchJson && patchJson.success) {
      actionSuccess = `Fulfillment status transitioned to '${nextStatus}' successfully.`;
    } else {
      actionError = patchJson?.error?.message || 'Transition blocked by backend validation controls.';
    }
    }
  } catch {
    actionError = 'Unreachable: Network error when submitting the order action.';
  }
}

// Fetch current order state and payment attempts
let order: any = null;
let paymentAttempts: any[] = [];
let isSample = false;
let apiError = '';

const fallbackOrder = {
  id: id || "fallback-1",
  orderNumber: "GP-FALLBACK-1",
  customerName: "Sample John",
  customerPhone: "0788000000",
  customerEmail: "john@example.com",
  buyerType: "retail",
  totalUgx: 150000,
  deliveryArea: "Kampala Central",
  deliveryAddress: "Plot 12, Kampala Road",
  paymentStatus: "unpaid",
  orderStatus: "received",
  createdAt: new Date().toISOString(),
  items: [
    { sku: "GP-CHARGER-SAMPLE", productName: "GoldPlus Fast Charger", quantity: 1, unitPrice: 150000 }
  ]
};

try {
  const res = await fetch(`${apiBase}/governance/admin/orders/${id}`, {
    headers: { 
      'Accept': 'application/json',
      'Authorization': `Bearer ${token}` 
    }
  });

  if (res.ok) {
    const json = await res.json().catch(() => null);
    if (json && json.success && json.data) {
      order = json.data.order;
      paymentAttempts = json.data.paymentAttempts || [];
    } else {
      order = fallbackOrder;
      isSample = true;
      apiError = 'Unexpected schema returned from active API route.';
    }
  } else {
    order = fallbackOrder;
    isSample = true;
    apiError = `API query responded with HTTP ${res.status}.`;
  }
} catch {
  order = fallbackOrder;
  isSample = true;
  apiError = 'Commerce API is currently unreachable.';
}

// Fetch dynamic notification preview
let previewData = {
  template: Astro.url.searchParams.get('template') || '',
  emailHtml: '',
  whatsappText: ''
};

try {
  const selectedTemplate = previewData.template;
  const previewRes = await fetch(`${apiBase}/governance/admin/orders/${id}/communication-preview${selectedTemplate ? `?template=${selectedTemplate}` : ''}`, {
    headers: {
      'Accept': 'application/json',
      'Authorization': `Bearer ${token}`
    }
  });

  if (previewRes.ok) {
    const json = await previewRes.json().catch(() => null);
    if (json && json.success) {
      previewData = json.data;
    }
  }
} catch {
  // Graceful fallback
}

// Fetch actual outbox events and attempts for this order
let timelineItems: any[] = [];
try {
  if (id) {
    const timelineRes = await getOrderNotificationTimeline(id, token);
    timelineItems = timelineRes.items;
  }
} catch {
  // Graceful fallback to empty
}

// Fallback generator for zero-outage display
function escapeHtml(str: string | null | undefined): string {
  if (!str) return '';
  return String(str)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

import { formatUgx } from '../../../lib/money';
// UGX code format via the single money source (en-UG's currency symbol is "USh").
const formatter = { format: (n: unknown) => formatUgx(n) };

if (!previewData.emailHtml) {
  const formattedTotal = formatter.format(order.totalUgx);
  const itemsHtml = (order.items || []).map((item: any) => `
    <tr>
      <td style="padding: 12px 8px; font-family: sans-serif; font-size: 13px; font-weight: bold; color: #0A0A0A; border-bottom: 1px solid #E5E7EB; text-align: left;">
        ${escapeHtml(item.productName)}
        <div style="font-size: 10px; font-weight: normal; color: #6B7280; margin-top: 2px;">SKU: ${escapeHtml(item.sku || 'N/A')}</div>
      </td>
      <td style="padding: 12px 8px; font-family: sans-serif; font-size: 13px; font-weight: bold; color: #374151; border-bottom: 1px solid #E5E7EB; text-align: center;">${item.quantity}</td>
      <td style="padding: 12px 8px; font-family: sans-serif; font-size: 13px; color: #4B5563; border-bottom: 1px solid #E5E7EB; text-align: right;">${escapeHtml(formatter.format(item.unitPrice))}</td>
      <td style="padding: 12px 8px; font-family: sans-serif; font-size: 13px; font-weight: 800; color: #0A0A0A; border-bottom: 1px solid #E5E7EB; text-align: right;">${escapeHtml(formatter.format(item.unitPrice * item.quantity))}</td>
    </tr>
  `).join('');

  let fallbackTitle = 'Order received. Payment is still pending.';
  let fallbackMsg = `Thank you for your order. We have successfully received order number <strong>${escapeHtml(order.orderNumber)}</strong>. Please proceed with payment via your Mobile Money checkout screen or follow PesaPal payment links to complete your purchase.`;
  let isSuccessColor = false;
  let ctaLabel = 'Complete Payment';

  if (previewData.template === 'ORDER_PAYMENT_PENDING') {
    fallbackTitle = 'Payment pending verification.';
    fallbackMsg = `We have recorded a pending payment attempt for order <strong>${escapeHtml(order.orderNumber)}</strong>. Our systems are currently verifying transaction status. No further action is required.`;
    ctaLabel = 'Track Order';
  } else if (previewData.template === 'ORDER_PAYMENT_SUCCESS') {
    fallbackTitle = 'Payment verified. We’ll prepare your order.';
    fallbackMsg = `Excellent news! Payment of <strong>${escapeHtml(formattedTotal)}</strong> has been successfully verified. Your order <strong>${escapeHtml(order.orderNumber)}</strong> is now officially confirmed and transitioning to hardware dispatch logistics.`;
    isSuccessColor = true;
    ctaLabel = 'Track Order';
  } else if (previewData.template === 'ORDER_PAYMENT_FAILED') {
    fallbackTitle = 'Payment was not completed.';
    fallbackMsg = `We could not verify payment for order <strong>${escapeHtml(order.orderNumber)}</strong>. Please check your Mobile Money network or click checkout again to retry.`;
    ctaLabel = 'Retry Payment';
  } else if (previewData.template === 'ORDER_PAYMENT_CANCELLED') {
    fallbackTitle = 'Checkout cancelled. Your order has not been paid.';
    fallbackMsg = `The payment checkout flow for order <strong>${escapeHtml(order.orderNumber)}</strong> was cancelled. You can retry checkout anytime from your order tracking screen.`;
    ctaLabel = 'Return to Checkout';
  } else if (previewData.template === 'ORDER_FULFILLMENT_PROCESSING') {
    fallbackTitle = 'Your order is being prepared.';
    fallbackMsg = `Your order <strong>${escapeHtml(order.orderNumber)}</strong> is currently being packaged and optimized for transport in Kampala. You will be notified as soon as it is shipped.`;
    ctaLabel = 'Track Order';
  } else if (previewData.template === 'ORDER_FULFILLMENT_COMPLETED') {
    fallbackTitle = 'Your order is complete.';
    fallbackMsg = `Congratulations! Order <strong>${escapeHtml(order.orderNumber)}</strong> has been delivered successfully. Thank you for choosing GoldPlus.`;
    isSuccessColor = true;
    ctaLabel = 'View Order';
  }

  const dateStr = order.createdAt ? new Date(order.createdAt).toLocaleDateString('en-GB', { timeZone: 'Africa/Kampala' }) : new Date().toLocaleDateString('en-GB', { timeZone: 'Africa/Kampala' });
  const bannerBg = isSuccessColor ? '#F3FBF2' : '#FCFAF2';
  const borderBg = isSuccessColor ? '#E1F3DF' : '#F7F3E1';
  const fontColor = isSuccessColor ? '#2B6A25' : '#8A6D1C';
  const payColor = order.paymentStatus === 'paid' ? '#22C55E' : '#EAB308';
  const trackUrl = `https://shopgoldplus.com/track-order?ref=${encodeURIComponent(order.orderNumber)}`;
  const waUrl = `https://wa.me/${whatsappSupportNumber}?text=${encodeURIComponent(`Hello GoldPlus, I need help with order ${order.orderNumber}`)}`;

  previewData.emailHtml = `<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>GoldPlus Order Notification</title>
</head>
<body style="margin: 0; padding: 0; background-color: #F5F7F2; -webkit-font-smoothing: antialiased; font-family: sans-serif;">
  <table width="100%" border="0" cellspacing="0" cellpadding="0" style="background-color: #F5F7F2; padding: 20px 8px;">
    <tr>
      <td align="center">
        <table width="600" border="0" cellspacing="0" cellpadding="0" style="background-color: #FFFFFF; border: 1px solid #E5E7EB; border-radius: 12px; overflow: hidden; width: 100%; max-width: 600px;">
          <!-- Header Banner -->
          <tr>
            <td style="background-color: #0A0A0A; padding: 24px 16px; text-align: center; border-bottom: 3px solid #96cc06;">
              <h1 style="margin: 0; font-size: 22px; font-weight: 900; color: #FFFFFF; letter-spacing: -0.03em; text-transform: uppercase;">GoldPlus</h1>
              <p style="margin: 4px 0 0 0; font-size: 9px; font-weight: 800; color: #9CA3AF; letter-spacing: 0.1em; text-transform: uppercase;">Official GoldPlus Online Store</p>
            </td>
          </tr>
          
          <!-- Status Headline Banner -->
          <tr>
            <td style="padding: 24px 24px 16px 24px;">
              <div style="background-color: ${bannerBg}; border: 1px solid ${borderBg}; border-radius: 8px; padding: 14px 18px; margin-bottom: 18px;">
                <h2 style="margin: 0 0 4px 0; font-size: 14px; font-weight: 800; color: ${fontColor};">${escapeHtml(fallbackTitle)}</h2>
              </div>
              <p style="margin: 0; font-size: 13px; line-height: 1.6; color: #374151;">Dear ${escapeHtml(order.customerName)},</p>
              <p style="margin: 10px 0 0 0; font-size: 13px; line-height: 1.6; color: #374151;">${fallbackMsg}</p>
            </td>
          </tr>

          <!-- Parameters Box -->
          <tr>
            <td style="padding: 0 24px 20px 24px;">
              <div style="background-color: #F9FAFB; border: 1px solid #E5E7EB; border-radius: 8px; padding: 14px;">
                <table width="100%" border="0" cellspacing="0" cellpadding="0" style="font-size: 11px; line-height: 1.5; border-collapse: collapse;">
                  <tr>
                    <td style="padding: 4px 0; color: #6B7280; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; width: 45%;">Order Reference</td>
                    <td style="padding: 4px 0; text-align: right; font-weight: bold; color: #0A0A0A; font-family: monospace;">${escapeHtml(order.orderNumber)}</td>
                  </tr>
                  <tr>
                    <td style="padding: 4px 0; color: #6B7280; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em;">Date Placed</td>
                    <td style="padding: 4px 0; text-align: right; color: #374151;">${escapeHtml(dateStr)}</td>
                  </tr>
                  <tr>
                    <td style="padding: 4px 0; color: #6B7280; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em;">Fulfillment Status</td>
                    <td style="padding: 4px 0; text-align: right; font-weight: bold; color: #0A0A0A; text-transform: uppercase;">${escapeHtml(order.orderStatus.replace(/_/g, ' '))}</td>
                  </tr>
                  <tr>
                    <td style="padding: 4px 0; color: #6B7280; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em;">Payment Status</td>
                    <td style="padding: 4px 0; text-align: right; font-weight: bold; color: ${payColor}; text-transform: uppercase;">${escapeHtml(order.paymentStatus)}</td>
                  </tr>
                </table>
              </div>
            </td>
          </tr>

          <!-- Items Table -->
          <tr>
            <td style="padding: 0 24px 16px 24px;">
              <table width="100%" border="0" cellspacing="0" cellpadding="0" style="border-collapse: collapse; border-top: 1px solid #E5E7EB; font-size: 12px;">
                <thead>
                  <tr style="background-color: #F9FAFB;">
                    <th style="padding: 8px; font-weight: bold; color: #6B7280; text-transform: uppercase; letter-spacing: 0.05em; border-bottom: 2px solid #E5E7EB; text-align: left;">Product</th>
                    <th style="padding: 8px; font-weight: bold; color: #6B7280; text-transform: uppercase; letter-spacing: 0.05em; border-bottom: 2px solid #E5E7EB; text-align: center; width: 10%;">Qty</th>
                    <th style="padding: 8px; font-weight: bold; color: #6B7280; text-transform: uppercase; letter-spacing: 0.05em; border-bottom: 2px solid #E5E7EB; text-align: right; width: 25%;">Price</th>
                    <th style="padding: 8px; font-weight: bold; color: #6B7280; text-transform: uppercase; letter-spacing: 0.05em; border-bottom: 2px solid #E5E7EB; text-align: right; width: 25%;">Total</th>
                  </tr>
                </thead>
                <tbody>${itemsHtml}</tbody>
              </table>
            </td>
          </tr>

          <!-- Totals block -->
          <tr>
            <td style="padding: 0 24px 24px 24px;">
              <table align="right" width="240" border="0" cellspacing="0" cellpadding="0" style="font-size: 12px; line-height: 1.5;">
                <tr>
                  <td style="padding: 3px 0; color: #6B7280; text-align: left;">Subtotal</td>
                  <td style="padding: 3px 0; font-weight: bold; color: #0A0A0A; text-align: right;">${escapeHtml(formattedTotal)}</td>
                </tr>
                <tr>
                  <td style="padding: 3px 0; color: #6B7280; text-align: left;">Delivery Zone Fee</td>
                  <td style="padding: 3px 0; font-style: italic; color: #9CA3AF; text-align: right;">Calculated post-zone</td>
                </tr>
                <tr style="border-top: 1px solid #E5E7EB;">
                  <td style="padding: 8px 0 0 0; font-weight: bold; color: #0A0A0A; text-align: left;">Grand Total</td>
                  <td style="padding: 8px 0 0 0; font-size: 14px; font-weight: 900; color: #0A0A0A; text-align: right;">${escapeHtml(formattedTotal)}</td>
                </tr>
              </table>
              <div style="clear: both;"></div>
            </td>
          </tr>

          <!-- CTA Block -->
          <tr>
            <td style="padding: 0 24px 24px 24px; text-align: center;">
              <table width="100%" border="0" cellspacing="0" cellpadding="0">
                <tr>
                  <td align="center">
                    <table border="0" cellspacing="0" cellpadding="0">
                      <tr>
                        <td align="center" style="background-color: #96cc06; border-radius: 6px;">
                          <a href="${trackUrl}" target="_blank" style="display: inline-block; padding: 12px 28px; font-size: 12px; font-weight: 900; color: #0A0A0A; text-decoration: none; text-transform: uppercase; letter-spacing: 0.05em; border: 1px solid #96cc06; border-radius: 6px;">
                            ${escapeHtml(ctaLabel)}
                          </a>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
                <tr>
                  <td style="padding-top: 12px; font-size: 9px; color: #9CA3AF; line-height: 1.4;">
                    If the button does not work, copy and paste this URL into your browser:<br>
                    <a href="${trackUrl}" target="_blank" style="color: #96cc06; text-decoration: none; font-weight: bold; word-break: break-all;">${escapeHtml(trackUrl)}</a>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Support Handoff Block -->
          <tr>
            <td style="padding: 20px 24px; background-color: #FCFAF2; border-top: 1px solid #F7F3E1; text-align: center;">
              <h3 style="margin: 0 0 4px 0; font-size: 12px; font-weight: 800; color: #8A6D1C; text-transform: uppercase; letter-spacing: 0.05em;">Need help with your order?</h3>
              <p style="margin: 0; font-size: 11px; line-height: 1.4; color: #5C4B18;">
                Connect directly with our central desk for payment or logistical guidance.<br>
                <a href="${waUrl}" target="_blank" style="display: inline-block; margin-top: 6px; color: #0A0A0A; text-decoration: none; font-weight: 900; background-color: #96cc06; padding: 5px 12px; border-radius: 4px; font-size: 9px; text-transform: uppercase; letter-spacing: 0.03em;">
                  WhatsApp Support &rarr;
                </a>
              </p>
            </td>
          </tr>

          <!-- Footer Block -->
          <tr>
            <td style="background-color: #0A0A0A; padding: 24px 16px; text-align: center; border-top: 1px solid #1A1A1A;">
              <p style="margin: 0 0 10px 0; font-size: 10px; line-height: 1.5; color: #9CA3AF;">
                This email is an automated billing transaction notification regarding your active customer account on the GoldPlus E-commerce network. Unsubscribe links are not legally applicable as this message does not consist of promotional content.
              </p>
              <p style="margin: 0; font-size: 9px; font-weight: bold; color: #6B7280; text-transform: uppercase; letter-spacing: 0.05em;">
                &copy; ${new Date().getFullYear()} GoldPlus Online Store. Kampala, Uganda.
              </p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>`;
}

if (!previewData.whatsappText) {
  let fallbackWaText = `Hello ${order.customerName}, regarding your GoldPlus order *${order.orderNumber}*:\n\nWe have received your order! Placed status is currently *Awaiting Payment*.\n\nTotal Amount: *${formatter.format(order.totalUgx || 0)}*\n\nTo complete your checkout securely, please review your Mobile Money window or use our tracking URL: https://shopgoldplus.com/track-order?ref=${order.orderNumber}`;
  
  if (previewData.template === 'ORDER_PAYMENT_PENDING') {
    fallbackWaText = `Hello ${order.customerName}, regarding your GoldPlus order *${order.orderNumber}*:\n\nYour Mobile Money checkout has been initiated and is *Pending verification*.\n\nOnce verified, our team will prepare your GoldPlus order.\n\nTrack status live: https://shopgoldplus.com/track-order?ref=${order.orderNumber}`;
  } else if (previewData.template === 'ORDER_PAYMENT_SUCCESS') {
    fallbackWaText = `Hello ${order.customerName}, regarding your GoldPlus order *${order.orderNumber}*:\n\nExcellent news! Your payment has been *Successfully Verified*.\n\nFulfillment is in progress, and logistics coordinates are actively being routed.\n\nTrack delivery live: https://shopgoldplus.com/track-order?ref=${order.orderNumber}`;
  } else if (previewData.template === 'ORDER_FULFILLMENT_PROCESSING') {
    fallbackWaText = `Hello ${order.customerName}, regarding your GoldPlus order *${order.orderNumber}*:\n\nYour order fulfillment status has been updated to *In Processing*.\n\nTrack status live: https://shopgoldplus.com/track-order?ref=${order.orderNumber}`;
  } else if (previewData.template === 'ORDER_FULFILLMENT_COMPLETED') {
    fallbackWaText = `Hello ${order.customerName}, regarding your GoldPlus order *${order.orderNumber}*:\n\nYour order has been *Delivered and Settled* successfully.\n\nThank you for choosing GoldPlus Online Store!`;
  }
  
  previewData.whatsappText = fallbackWaText;
}


function getStatusColor(status: string) {
  switch (status) {
    case 'received': return 'bg-blue-50 text-blue-700 border-blue-100';
    case 'pending_payment': return 'bg-orange-50 text-orange-700 border-orange-100';
    case 'pending_owner_review': return 'bg-yellow-50 text-yellow-700 border-yellow-100';
    case 'processing': return 'bg-indigo-50 text-indigo-700 border-indigo-100';
    case 'completed': return 'bg-green-50 text-green-700 border-green-100';
    case 'failed':
    case 'cancelled': return 'bg-red-50 text-red-700 border-red-100';
    default: return 'bg-gray-50 text-gray-700 border-gray-100';
  }
}

// Compute allowed transition options
const currentStatus = order.orderStatus;
const transitionOptions: string[] = [];

if (currentStatus === 'received') {
  transitionOptions.push('processing', 'cancelled');
} else if (currentStatus === 'pending_payment') {
  transitionOptions.push('cancelled');
  if (order.paymentStatus === 'paid') {
    transitionOptions.push('processing');
  }
} else if (currentStatus === 'pending_owner_review') {
  transitionOptions.push('processing', 'cancelled');
} else if (currentStatus === 'processing') {
  transitionOptions.push('dispatched', 'completed', 'cancelled');
} else if (currentStatus === 'dispatched') {
  transitionOptions.push('delivered', 'delivery_failed');
} else if (currentStatus === 'delivery_failed') {
  transitionOptions.push('dispatched', 'completed', 'cancelled');
}
---

<AdminLayout 
  title={`Order Control — ${order.orderNumber}`} 
  description="Admin operations workspace for customer order fulfillment stages and transactional history lookup."
>
  <div class="container mx-auto px-6 lg:px-8 max-w-7xl">
    
    <div class="mb-8 pb-6 border-b border-gray-200 flex flex-col sm:flex-row justify-between sm:items-center gap-4">
      <div>
        <a href="/admin/orders" class="text-xs font-bold text-gray-400 hover:text-brand-dark transition-colors mb-2 inline-block">
          &larr; Back to Order Registry
        </a>
        <h2 class="text-2xl font-black text-brand-dark tracking-tight flex items-center gap-3">
          Order {order.orderNumber}
          <span class={`inline-block px-2.5 py-0.5 rounded-lg font-black text-[9px] uppercase tracking-wide border ${getStatusColor(order.orderStatus)}`}>
            {order.orderStatus.replace(/_/g, ' ')}
          </span>
        </h2>
      </div>
      <div class="flex items-center gap-2">
        <span class="text-xs text-gray-400 font-medium font-mono">ID: {order.id}</span>
      </div>
    </div>

    {isSample && (
      <div class="bg-blue-50 border border-blue-200 text-blue-800 px-6 py-4 rounded-2xl mb-8 flex flex-col gap-1">
        <div class="text-xs font-black uppercase tracking-wider">Interactive Fallback Mode</div>
        <div class="text-xs leading-relaxed"><strong>System note:</strong> {apiError} Displaying fallback data.</div>
      </div>
    )}

    {actionSuccess && (
      <div class="bg-green-50 border border-green-200 text-green-800 px-6 py-4 rounded-2xl mb-8 flex items-center gap-3">
        <div class="text-xs font-bold leading-relaxed">{actionSuccess}</div>
      </div>
    )}

    {actionError && (
      <div class="bg-red-50 border border-red-200 text-red-800 px-6 py-4 rounded-2xl mb-8 flex items-center gap-3">
        <div class="text-xs font-bold leading-relaxed">{actionError}</div>
      </div>
    )}

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      
      {/* LEFT COLUMN: ORDER INFO */}
      <div class="lg:col-span-2 space-y-8">
        
        {/* Buyer Details */}
        <div class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden">
          <div class="px-6 py-4 border-b border-gray-100 bg-gray-50">
            <h3 class="text-[10px] font-black uppercase tracking-widest text-brand-dark">Customer Information</h3>
          </div>
          <div class="p-6 grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
              <span class="text-[9px] font-black text-gray-400 uppercase tracking-wider block mb-1">Buyer Name</span>
              <p class="text-sm font-bold text-brand-dark">{order.customerName}</p>
            </div>
            <div>
              <span class="text-[9px] font-black text-gray-400 uppercase tracking-wider block mb-1">Buyer Coordinates</span>
              <p class="text-sm font-bold text-brand-dark">{order.customerPhone}</p>
              {order.customerEmail && <p class="text-xs font-medium text-gray-400 mt-0.5">{order.customerEmail}</p>}
            </div>
            <div class="sm:col-span-2 border-t border-gray-100 pt-4">
              <span class="text-[9px] font-black text-gray-400 uppercase tracking-wider block mb-1">Delivery Destination</span>
              <p class="text-xs font-black text-brand-dark">{order.deliveryArea}</p>
              <p class="text-xs font-medium text-gray-500 mt-1">{order.deliveryAddress}</p>
            </div>
          </div>
        </div>

        {/* Rider delivery card (location-module brief I.1): printable slip,
            WhatsApp copy block, wa.me deep link. COD amount = what the rider
            actually collects (total already net of any loyalty discount). */}
        <div class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden" id="rider-card">
          <div class="px-6 py-4 border-b border-gray-100 bg-gray-50 flex items-center justify-between">
            <h3 class="text-[10px] font-black uppercase tracking-widest text-brand-dark">Rider Delivery Card</h3>
            <div class="flex gap-2 print:hidden">
              <button type="button" id="rider-print" class="text-[10px] font-black uppercase tracking-wide border border-gray-300 rounded px-3 py-1.5 hover:bg-gray-50">Print slip</button>
              <button type="button" id="rider-copy" class="text-[10px] font-black uppercase tracking-wide border border-gray-300 rounded px-3 py-1.5 hover:bg-gray-50">Copy for WhatsApp</button>
              {String(order.customerPhone || '').trim() && (
                <a
                  id="rider-wa"
                  class="text-[10px] font-black uppercase tracking-wide bg-[#25D366] text-white rounded px-3 py-1.5"
                  target="_blank"
                  rel="noopener"
                  href={`https://wa.me/${String(order.customerPhone).replace(/[^0-9]/g, '').replace(/^0/, '256')}?text=${encodeURIComponent(`Hello ${order.customerName}, this is GoldPlus. Your order ${order.orderNumber} is on its way. The rider will call you shortly.`)}`}
                >WhatsApp customer</a>
              )}
            </div>
          </div>
          <div class="p-6">
            <pre id="rider-card-text" class="whitespace-pre-wrap text-sm font-mono bg-gray-50 border border-gray-200 rounded-xl p-4">{[
              `ORDER ${order.orderNumber}`,
              `Recipient: ${order.customerName}`,
              `Phone: ${order.customerPhone}`,
              `Area: ${order.deliveryArea}`,
              `Landmark/directions: ${order.deliveryAddress}`,
              (order.deliveryLocation && typeof order.deliveryLocation === 'object' && (order.deliveryLocation as any).gpsLat)
                ? `Map pin: https://maps.google.com/?q=${(order.deliveryLocation as any).gpsLat},${(order.deliveryLocation as any).gpsLng}`
                : null,
              `Items: ${(order.items || []).reduce((n: number, i: any) => n + (Number(i.quantity) || 0), 0)}`,
              order.paymentStatus === 'paid'
                ? 'Payment: PAID — collect nothing'
                : `COLLECT ON DELIVERY: UGX ${Number(order.totalUgx ?? order.totalAmount ?? 0).toLocaleString('en-UG', { timeZone: 'Africa/Kampala' })}`,
            ].filter(Boolean).join('\n')}</pre>
            <p class="text-[10px] text-gray-400 mt-2 print:hidden">The copy button places this block on the clipboard, formatted for WhatsApp.</p>
          </div>
        </div>

        {/* Order Line Items */}
        <div class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden">
          <div class="px-6 py-4 border-b border-gray-100 bg-gray-50 flex justify-between items-center">
            <h3 class="text-[10px] font-black uppercase tracking-widest text-brand-dark">Purchased Products</h3>
            <span class="bg-gray-100 text-gray-600 text-[9px] font-black px-2 py-0.5 rounded uppercase tracking-wide">
              Buyer Type: {order.buyerType}
            </span>
          </div>
          <div class="p-6">
            <div class="border border-gray-100 rounded-xl overflow-hidden mb-6">
              <table class="w-full text-left border-collapse text-xs">
                <thead>
                  <tr class="bg-gray-50 font-black uppercase text-[9px] text-gray-400 border-b border-gray-100">
                    <th class="px-4 py-3">Product Name</th>
                    <th class="px-4 py-3 text-center">SKU</th>
                    <th class="px-4 py-3 text-center">Qty</th>
                    <th class="px-4 py-3 text-right">Unit Price</th>
                    <th class="px-4 py-3 text-right">Total Price</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-gray-50">
                  {(order.items || []).map((item: any) => (
                    <tr>
                      <td class="px-4 py-3 font-bold text-brand-dark">{item.productName}</td>
                      <td class="px-4 py-3 text-center font-mono font-bold text-gray-500">{item.sku || 'N/A'}</td>
                      <td class="px-4 py-3 text-center font-black font-mono text-gray-700">{item.quantity}</td>
                      <td class="px-4 py-3 text-right font-medium text-gray-500">{formatter.format(item.unitPrice)}</td>
                      <td class="px-4 py-3 text-right font-black text-brand-dark">{formatter.format(item.quantity * item.unitPrice)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            {/* Totals Summary */}
            <div class="flex justify-end">
              <div class="w-64 space-y-2 text-xs">
                <div class="flex justify-between text-gray-500">
                  <span>Subtotal</span>
                  <span class="font-bold text-brand-dark">{formatter.format(order.totalUgx)}</span>
                </div>
                <div class="flex justify-between text-gray-500">
                  <span>Shipping & Handling</span>
                  <span class="italic">Calculated at checkout</span>
                </div>
                <div class="border-t border-gray-200 pt-2 flex justify-between font-black text-sm text-brand-dark">
                  <span>Total Amount</span>
                  <span>{formatter.format(order.totalUgx)}</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        {/* Relational PesaPal Payment Attempts */}
        <div class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden">
          <div class="px-6 py-4 border-b border-gray-100 bg-gray-50">
            <h3 class="text-[10px] font-black uppercase tracking-widest text-brand-dark">Relational Payment Attempts (Read-Only)</h3>
          </div>
          <div class="p-6">
            {paymentAttempts.length > 0 ? (
              <div class="space-y-6">
                {paymentAttempts.map((attempt, index) => (
                  <div class="bg-gray-50 border border-gray-200 rounded-xl p-5 relative overflow-hidden">
                    <div class="flex justify-between items-start mb-4">
                      <div>
                        <span class="text-[8px] font-bold text-gray-400 uppercase tracking-widest block mb-0.5">ATTEMPT #{paymentAttempts.length - index}</span>
                        <h4 class="text-xs font-black text-brand-dark">Merchant Reference: {attempt.merchantReference}</h4>
                      </div>
                      <span class={`px-2 py-0.5 border font-black text-[9px] uppercase rounded-lg ${
                        attempt.status === 'completed' ? 'bg-green-50 text-green-700 border-green-100' :
                        attempt.status === 'failed' ? 'bg-red-50 text-red-700 border-red-100' :
                        attempt.status === 'pending' ? 'bg-yellow-50 text-yellow-700 border-yellow-100' :
                        'bg-orange-50 text-orange-700 border-orange-100'
                      }`}>
                        {attempt.status}
                      </span>
                    </div>

                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 text-xs">
                      <div>
                        <span class="text-[8px] font-bold text-gray-400 uppercase block mb-0.5">Tracking ID</span>
                        <span class="font-mono font-bold text-brand-dark break-all">{attempt.orderTrackingId || 'None'}</span>
                      </div>
                      <div>
                        <span class="text-[8px] font-bold text-gray-400 uppercase block mb-0.5">Provider</span>
                        <span class="font-black uppercase text-[10px] tracking-wide text-brand-dark">{attempt.provider}</span>
                      </div>
                      <div>
                        <span class="text-[8px] font-bold text-gray-400 uppercase block mb-0.5">Authorized Sum</span>
                        <span class="font-black text-brand-dark">{formatter.format(attempt.amount)}</span>
                      </div>
                      <div>
                        <span class="text-[8px] font-bold text-gray-400 uppercase block mb-0.5">Created At</span>
                        <span class="font-medium text-gray-500">{new Date(attempt.createdAt).toLocaleString('en-GB', { timeZone: 'Africa/Kampala',  day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' })}</span>
                      </div>
                    </div>

                    <div class="border-t border-gray-200/50 pt-3 mt-4 grid grid-cols-1 sm:grid-cols-2 gap-4 text-[10px] font-medium text-gray-400">
                      <div>
                        <span class="font-bold">IPN Callback Registered:</span> {attempt.ipnReceivedAt ? new Date(attempt.ipnReceivedAt).toLocaleString('en-GB', { timeZone: 'Africa/Kampala' }) : 'No IPN received'}
                      </div>
                      <div>
                        <span class="font-bold">Callback URL Hit:</span> {attempt.callbackReceivedAt ? new Date(attempt.callbackReceivedAt).toLocaleString('en-GB', { timeZone: 'Africa/Kampala' }) : 'No callback hit'}
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            ) : (
              <div class="p-8 text-center text-gray-400 italic bg-gray-50 border border-gray-100 rounded-xl">
                No active PesaPal transactional records associated with this order.
              </div>
            )}
          </div>
        </div>

        <!-- Customer Communication Preview Workspace (Tabbed) -->
        <div class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden mt-8">
          <div class="px-6 py-4 border-b border-gray-100 bg-gray-50 flex justify-between items-center flex-wrap gap-2">
            <div>
              <h3 class="text-[10px] font-black uppercase tracking-widest text-brand-dark">Customer Communication Hub</h3>
              <p class="text-[9px] text-gray-400 mt-0.5">Real-time preview of transactional receipts and WhatsApp message builders.</p>
            </div>
            
            <!-- Template Toggle Select -->
            <div>
              <form method="GET" class="flex items-center gap-2">
                <label for="template" class="text-[8px] font-black uppercase tracking-wider text-gray-400">Template:</label>
                <select 
                  name="template" 
                  id="template-select" 
                  onchange="this.form.submit()"
                  class="bg-white border border-gray-200 rounded-lg px-2.5 py-1 text-[10px] font-black text-brand-dark outline-none focus:border-brand-gold"
                >
                  <option value="ORDER_RECEIVED_UNPAID" selected={previewData.template === 'ORDER_RECEIVED_UNPAID' || previewData.template === ''}>Received & Unpaid</option>
                  <option value="ORDER_PAYMENT_PENDING" selected={previewData.template === 'ORDER_PAYMENT_PENDING'}>Payment Pending</option>
                  <option value="ORDER_PAYMENT_SUCCESS" selected={previewData.template === 'ORDER_PAYMENT_SUCCESS'}>Payment Success</option>
                  <option value="ORDER_PAYMENT_FAILED" selected={previewData.template === 'ORDER_PAYMENT_FAILED'}>Payment Failed</option>
                  <option value="ORDER_PAYMENT_CANCELLED" selected={previewData.template === 'ORDER_PAYMENT_CANCELLED'}>Payment Cancelled</option>
                  <option value="ORDER_FULFILLMENT_PROCESSING" selected={previewData.template === 'ORDER_FULFILLMENT_PROCESSING'}>Logistics In Progress</option>
                  <option value="ORDER_FULFILLMENT_COMPLETED" selected={previewData.template === 'ORDER_FULFILLMENT_COMPLETED'}>Logistics Completed</option>
                </select>
              </form>
            </div>
          </div>
          
          <div class="p-6">
            
            <!-- Tabs Controls -->
            <div class="flex border-b border-gray-200 mb-6">
              <button 
                id="btn-tab-email" 
                class="px-4 py-2 text-xs font-black border-b-2 border-brand-gold text-brand-dark focus:outline-none transition-all duration-200"
                onclick="switchTab('email')"
              >
                HTML Email Receipt
              </button>
              <button 
                id="btn-tab-whatsapp" 
                class="px-4 py-2 text-xs font-black border-b-2 border-transparent text-gray-400 hover:text-brand-dark focus:outline-none transition-all duration-200"
                onclick="switchTab('whatsapp')"
              >
                WhatsApp Handoff
              </button>
            </div>

             <!-- TAB 1: HTML Email Preview -->
             <div id="tab-panel-email" class="block space-y-4">
               <div class="bg-gray-50 border border-gray-200 rounded-xl overflow-hidden relative shadow-inner" style="height: 380px;">
                 <iframe 
                   id="email-iframe" 
                   class="w-full h-full border-0 bg-white" 
                   srcdoc={previewData.emailHtml}
                   sandbox="allow-same-origin"
                 ></iframe>
               </div>
               
               <!-- Design & Safety Status Badges -->
               <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 bg-gray-50 border border-gray-200 rounded-xl p-4">
                 <div class="flex items-center gap-2">
                   <span class="w-2 h-2 rounded-full bg-blue-500"></span>
                   <span class="text-[9px] font-black uppercase tracking-wider text-gray-500">Preview only, not sent</span>
                 </div>
                 <div class="flex items-center gap-2">
                   <span class="w-2 h-2 rounded-full bg-orange-500"></span>
                   <span class="text-[9px] font-black uppercase tracking-wider text-gray-500">Tracking disabled</span>
                 </div>
                 <div class="flex items-center gap-2">
                   <span class="w-2 h-2 rounded-full bg-amber-500"></span>
                   <span class="text-[9px] font-black uppercase tracking-wider text-gray-500">Customer email not sent</span>
                 </div>
                 <div class="flex items-center gap-2">
                   <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                   <span class="text-[9px] font-black uppercase tracking-wider text-gray-500">No-live-send status</span>
                 </div>
               </div>

               <div class="flex justify-between items-center text-[10px] font-medium text-gray-400">
                 <span>Transactional HTML Receipt (Auto-Generated per Order Status)</span>
                 <span class="text-green-500 font-bold">✓ Responsive & Mobile Optimized</span>
               </div>
             </div>

             <!-- TAB 2: WhatsApp Handoff Preview -->
             <div id="tab-panel-whatsapp" class="hidden space-y-4">
               <div class="grid grid-cols-2 gap-4 text-xs">
                 <div class="bg-gray-50 border border-gray-200 rounded-xl p-3">
                   <div class="text-[10px] font-bold uppercase tracking-wider text-gray-400">Support Number Configured</div>
                   <div class="font-mono mt-1 font-bold text-gray-700">{whatsappSupportNumber === '256705004545' ? 'Yes (256705004545)' : whatsappSupportNumber}</div>
                 </div>
                 <div class="bg-gray-50 border border-gray-200 rounded-xl p-3">
                   <div class="text-[10px] font-bold uppercase tracking-wider text-gray-400">System Dispatch Mode</div>
                   <div class="font-mono mt-1 font-bold text-amber-600">Preview Only, Not Sent</div>
                 </div>
               </div>

               <div class="bg-gray-50 border border-gray-200 rounded-xl p-4">
                 <textarea 
                   id="whatsapp-text" 
                   readonly 
                   rows="6" 
                   class="w-full bg-transparent border-0 text-xs font-medium text-gray-700 outline-none resize-none leading-relaxed font-mono"
                 >{previewData.whatsappText}</textarea>
               </div>
               
               <div class="flex flex-col sm:flex-row gap-3">
                 <button 
                   id="btn-copy-wa" 
                   class="flex-1 bg-gray-100 hover:bg-gray-200 text-brand-dark text-xs font-black py-3 rounded-xl transition-all flex items-center justify-center gap-2 border border-gray-200"
                   onclick="copyWhatsAppText()"
                 >
                   <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 002 2h2a2 2 0 002-2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"></path></svg>
                   Copy Template Text
                 </button>
                 <a 
                   href={`https://wa.me/${whatsappSupportNumber}?text=${encodeURIComponent(previewData.whatsappText || '')}`}
                   target="_blank"
                   rel="noopener noreferrer"
                   class="flex-1 bg-green-600 hover:bg-green-700 text-white text-xs font-black py-3 rounded-xl transition-all flex items-center justify-center gap-2 shadow-sm text-center"
                 >
                   <svg class="w-4 h-4 text-green-300" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946C.06 5.348 5.397.01 12.008.01c3.202.001 6.212 1.246 8.477 3.513 2.262 2.268 3.507 5.28 3.505 8.484-.004 6.657-5.34 11.997-11.953 11.997-2.005-.001-3.973-.502-5.754-1.458L0 24zM6.59 5.86c-.22-.492-.452-.503-.66-.512-.17-.008-.364-.007-.56-.007-.195 0-.514.073-.783.366-.268.293-1.026 1.002-1.026 2.441 0 1.439 1.047 2.829 1.193 3.023.147.195 2.059 3.145 4.988 4.41.698.302 1.242.482 1.668.618.7.223 1.34.191 1.844.116.563-.083 1.732-.708 1.977-1.393.243-.684.243-1.27.17-1.393-.073-.122-.268-.195-.561-.341-.293-.146-1.732-.853-2.001-.951-.269-.098-.464-.147-.66.146-.195.293-.757.951-.928 1.147-.171.195-.342.22-.635.073-.293-.146-1.238-.457-2.36-1.457-.872-.777-1.46-1.738-1.631-2.03-.171-.293-.018-.452.129-.597.132-.131.293-.342.44-.512.146-.17.195-.293.293-.488.097-.195.048-.366-.024-.512-.072-.147-.66-1.59-.904-2.18z"></path></svg>
                   Initiate Secure WhatsApp Chat
                 </a>
               </div>

               <div class="bg-blue-50 border border-blue-100 rounded-xl p-3 text-[10px] text-blue-950 leading-relaxed">
                 <strong>Safe URL Preview:</strong> <span class="font-mono break-all text-blue-700">https://wa.me/{whatsappSupportNumber}?text={encodeURIComponent(previewData.whatsappText || '')}</span>
               </div>
               
               <div class="bg-amber-50 border border-amber-100 rounded-xl p-3 text-[10px] text-amber-900 leading-relaxed">
                 <strong>WhatsApp Handoff Rule:</strong> Pre-filled text consists strictly of order reference status updates. Sensitive buyer PII (such as emails, delivery landmarks, or full home addresses) is strictly excluded to prevent transport-layer exposure. No live API dispatch or automated send action is enabled.
               </div>
             </div>

            <!-- Client Script for UI Controls -->
            <script is:inline>
              function switchTab(activeTab) {
                const btnEmail = document.getElementById('btn-tab-email');
                const btnWa = document.getElementById('btn-tab-whatsapp');
                const panelEmail = document.getElementById('tab-panel-email');
                const panelWa = document.getElementById('tab-panel-whatsapp');
                
                if (activeTab === 'email') {
                  btnEmail.classList.add('border-brand-gold', 'text-brand-dark');
                  btnEmail.classList.remove('border-transparent', 'text-gray-400');
                  
                  btnWa.classList.add('border-transparent', 'text-gray-400');
                  btnWa.classList.remove('border-brand-gold', 'text-brand-dark');
                  
                  panelEmail.classList.remove('hidden');
                  panelEmail.classList.add('block');
                  
                  panelWa.classList.add('hidden');
                  panelWa.classList.remove('block');
                } else {
                  btnWa.classList.add('border-brand-gold', 'text-brand-dark');
                  btnWa.classList.remove('border-transparent', 'text-gray-400');
                  
                  btnEmail.classList.add('border-transparent', 'text-gray-400');
                  btnEmail.classList.remove('border-brand-gold', 'text-brand-dark');
                  
                  panelWa.classList.remove('hidden');
                  panelWa.classList.add('block');
                  
                  panelEmail.classList.add('hidden');
                  panelEmail.classList.remove('block');
                }
              }

              function copyWhatsAppText() {
                const textarea = document.getElementById('whatsapp-text');
                textarea.select();
                document.execCommand('copy');
                
                const btn = document.getElementById('btn-copy-wa');
                const originalHtml = btn.innerHTML;
                btn.innerHTML = `
                  <svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                  Copied Successfully!
                `;
                setTimeout(() => {
                  btn.innerHTML = originalHtml;
                }, 2000);
              }
            </script>

          </div>
        </div>

        <!-- Notification Channel Status Panels -->
        <div class="mt-8">
          <NotificationChannelPanel items={timelineItems} />
        </div>

        <!-- Chronological Audit Timeline Log -->
        <NotificationTimeline items={timelineItems} />

      </div>

      {/* RIGHT COLUMN: FULFILLMENT CONTROLS */}
      <div class="lg:col-span-1 space-y-6">
        
        {/* Operations Hub Card */}
        <div class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden">
          <div class="px-6 py-4 border-b border-gray-100 bg-gray-50">
            <h3 class="text-[10px] font-black uppercase tracking-widest text-brand-dark">Fulfillment Control Hub</h3>
          </div>
          <div class="p-6 space-y-6">
            
            {/* Status Grid */}
            <div class="grid grid-cols-2 gap-4">
              <div class="bg-gray-50 border border-gray-100 rounded-xl p-4">
                <span class="text-[8px] font-bold text-gray-400 uppercase tracking-wider block mb-1">Payment Status</span>
                <span class={`inline-block px-2 py-0.5 font-black text-[9px] uppercase tracking-wide border rounded ${
                  order.paymentStatus === 'paid' ? 'bg-green-50 text-green-700 border-green-100' :
                  order.paymentStatus === 'failed' ? 'bg-red-50 text-red-700 border-red-100' :
                  order.paymentStatus === 'pending' ? 'bg-yellow-50 text-yellow-700 border-yellow-100' :
                  'bg-orange-50 text-orange-700 border-orange-100'
                }`}>
                  {order.paymentStatus}
                </span>
              </div>
              <div class="bg-gray-50 border border-gray-100 rounded-xl p-4">
                <span class="text-[8px] font-bold text-gray-400 uppercase tracking-wider block mb-1">Fulfillment State</span>
                <span class={`inline-block px-2 py-0.5 font-black text-[9px] uppercase tracking-wide border rounded ${getStatusColor(order.orderStatus)}`}>
                  {order.orderStatus.replace(/_/g, ' ')}
                </span>
              </div>
            </div>

            {/* Transition Controls Form */}
            {transitionOptions.length > 0 ? (
              <form method="POST" class="space-y-4">
                <div>
                  <label for="status" class="block text-[10px] font-black uppercase tracking-wide text-gray-400 mb-2">
                    Select Logistical Transition
                  </label>
                  <select 
                    name="status" 
                    id="status" 
                    required
                    class="w-full bg-gray-50 border border-gray-200 rounded-xl px-3 py-3 text-xs font-bold text-brand-dark outline-none focus:border-brand-gold transition-colors appearance-none"
                  >
                    <option value="" disabled selected>Choose target status...</option>
                    {transitionOptions.map(opt => (
                      <option value={opt} class="capitalize">{opt.replace(/_/g, ' ')}</option>
                    ))}
                  </select>
                </div>
                <button 
                  type="submit" 
                  class="w-full bg-brand-dark hover:bg-black text-white text-xs font-black py-3.5 rounded-xl transition-colors tracking-wide shadow-sm"
                >
                  Commit Logistical Update
                </button>
              </form>
            ) : (
              <div class="bg-gray-50 border border-gray-100 p-4 rounded-xl text-center text-xs font-medium text-gray-500">
                Fulfillment workflow completed, failed, or cancelled. Operational status cannot be updated in this phase.
              </div>
            )}

            {/* Wave 2E-2: order LIFECYCLE transition (state-machine governed) */}
            <div class="border-t border-gray-100 pt-4">
              <p class="text-[10px] font-black uppercase tracking-wide text-gray-400 mb-2">Order lifecycle</p>
              <form method="POST" class="space-y-3">
                <input type="hidden" name="action" value="lifecycle" />
                <select name="toStatus" aria-label="Move order to status" required class="w-full bg-gray-50 border border-gray-200 rounded-xl px-3 py-2.5 text-xs font-bold text-brand-dark outline-none focus:border-brand-gold appearance-none">
                  <option value="" disabled selected>Move order to…</option>
                  <option value="processing">processing</option>
                  <option value="completed">completed</option>
                  <option value="cancelled">cancelled</option>
                </select>
                <input name="reason" required maxlength="500" placeholder="Reason (required — recorded in the order ledger)" class="w-full bg-gray-50 border border-gray-200 rounded-xl px-3 py-2.5 text-xs font-medium outline-none focus:border-brand-gold" />
                <button type="submit" class="w-full bg-brand-dark hover:bg-black text-white text-xs font-black py-3 rounded-xl transition-colors tracking-wide">Apply lifecycle transition</button>
              </form>
              <p class="mt-2 text-[9px] leading-relaxed text-gray-400 font-medium">Illegal moves and unpaid-order processing are refused by the state machine with the exact reason shown above.</p>
            </div>

            <div class="border-t border-gray-100 pt-4">
              <p class="text-[10px] font-black uppercase tracking-wide text-gray-400 mb-2">Operator note</p>
              <form method="POST" class="space-y-3">
                <input type="hidden" name="action" value="note" />
                <textarea name="note" required maxlength="1000" rows="2" placeholder="Note for the audit trail…" class="w-full bg-gray-50 border border-gray-200 rounded-xl px-3 py-2.5 text-xs font-medium outline-none focus:border-brand-gold"></textarea>
                <button type="submit" class="w-full bg-white border border-gray-200 hover:border-brand-gold text-brand-dark text-xs font-black py-3 rounded-xl transition-colors tracking-wide">Record note</button>
              </form>
            </div>

            <div class="border-t border-gray-100 pt-4 text-[9px] leading-relaxed text-gray-400 font-medium">
              <strong>Control Rule:</strong> Logistical operations are completely decoupled from payment settlement workflows. Manual override of payment status is strictly blocked to maintain system data truthfulness.
            </div>

          </div>
        </div>

      </div>

    </div>

  </div>
<script>
  document.getElementById('rider-copy')?.addEventListener('click', async () => {
    const text = document.getElementById('rider-card-text')?.textContent ?? '';
    try {
      await navigator.clipboard.writeText(text);
      const btn = document.getElementById('rider-copy');
      if (btn) btn.textContent = 'Copied ✓';
    } catch { /* clipboard blocked — the text stays selectable */ }
  });
  document.getElementById('rider-print')?.addEventListener('click', () => window.print());
</script>
</AdminLayout>
