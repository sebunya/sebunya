---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { tryFetchAdminList } from "../../../lib/api";
import { readSessionToken } from "../../../lib/session";

const token = readSessionToken(Astro.request);
if (!token) {
  return Astro.redirect("/admin/login?returnTo=/admin/orders", 303);
}

const fallbackOrders = [
  {
    id: "1",
    orderNumber: "GP-FALLBACK-1",
    customerName: "Sample John",
    customerPhone: "0788000000",
    buyerType: "retail",
    totalUgx: 150000,
    paymentStatus: "unpaid",
    orderStatus: "received",
    createdAt: new Date().toISOString()
  }
];

const result = await tryFetchAdminList('/governance/admin/orders', fallbackOrders);
const orders = result.items;
const formatter = new Intl.NumberFormat('en-UG', { style: 'currency', currency: 'UGX', maximumFractionDigits: 0 });

function getStatusColor(status: string) {
  switch (status) {
    case 'received': return 'bg-blue-50 text-blue-700 border-blue-100';
    case 'pending_owner_review': return 'bg-yellow-50 text-yellow-700 border-yellow-100';
    case 'completed': return 'bg-green-50 text-green-700 border-green-100';
    case 'failed':
    case 'cancelled': return 'bg-red-50 text-red-700 border-red-100';
    default: return 'bg-gray-50 text-gray-700 border-gray-100';
  }
}
---

<AdminLayout 
  title="Orders Registry (Read-Only)" 
  description="Read-only relational query of active buyer records retrieved from database repositories."
>
  <div class="container mx-auto px-6 lg:px-8 max-w-7xl">
    
    <div class="flex flex-col sm:flex-row sm:items-center justify-between mb-8 gap-4 pb-6 border-b border-gray-200">
      <div>
        <h2 class="text-2xl font-black text-brand-dark tracking-tight">Buyer Order Logs</h2>
        <p class="text-sm text-gray-500 mt-1">Review the relational history of customer checkout attempts. Mutation and logistical dispatch flows are scheduled for future system phases.</p>
      </div>
      <div class="flex items-center gap-2">
        <span class="bg-gray-100 text-gray-600 border border-gray-200 text-xs font-bold px-3 py-1.5 rounded-lg font-mono">
          RECORDS: {orders.length}
        </span>
      </div>
    </div>

    {result.isSample && (
      <div class="bg-blue-50 border border-blue-200 text-blue-800 px-6 py-4 rounded-2xl mb-8 flex items-center gap-4">
        
        <div class="text-xs leading-relaxed"><strong>System note:</strong> {result.reason}</div>
      </div>
    )}

    <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-gray-50 text-[10px] uppercase font-black text-gray-400 tracking-widest border-b border-gray-100">
              <th class="p-6">Order Key</th>
              <th class="p-6">Submission</th>
              <th class="p-6">Customer / Type</th>
              <th class="p-6 text-right">Value (UGX)</th>
              <th class="p-6 text-center">Payment</th>
              <th class="p-6 text-center">Status</th>
            </tr>
          </thead>
          <tbody class="text-xs divide-y divide-gray-50">
            {orders.map(order => (
              <tr class="hover:bg-gray-50 transition-colors">
                <td class="p-6 font-mono font-bold text-brand-dark text-sm">
                  {order.orderNumber || order.id.substring(0,8).toUpperCase()}
                </td>
                <td class="p-6 text-gray-500 font-medium">
                  {new Date(order.createdAt).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' })}
                </td>
                <td class="p-6">
                  <div class="font-bold text-brand-dark text-sm">{order.customerName}</div>
                  <div class="text-[10px] text-gray-400 mt-0.5 flex items-center gap-2">
                    <span>{order.customerPhone}</span>
                    <span class="uppercase font-black tracking-wide border border-gray-200 bg-gray-50 text-gray-500 px-1.5 py-0.5 rounded text-[8px]">
                      {order.buyerType}
                    </span>
                  </div>
                </td>
                <td class="p-6 font-black text-right text-brand-dark text-sm">
                  {formatter.format(order.totalUgx)}
                </td>
                <td class="p-6 text-center">
                  <span class={`inline-block px-2.5 py-1 rounded-lg font-black text-[9px] uppercase tracking-wide border ${
                    order.paymentStatus === 'paid' ? 'bg-green-50 text-green-700 border-green-100' :
                    order.paymentStatus === 'failed' ? 'bg-red-50 text-red-700 border-red-100' :
                    'bg-orange-50 text-orange-700 border-orange-100'
                  }`}>
                    {order.paymentStatus}
                  </span>
                </td>
                <td class="p-6 text-center">
                  <span class={`inline-block px-2.5 py-1 rounded-lg font-black text-[9px] uppercase tracking-wide border ${getStatusColor(order.orderStatus)}`}>
                    {order.orderStatus.replace(/_/g, ' ')}
                  </span>
                </td>
              </tr>
            ))}
            {orders.length === 0 && (
              <tr>
                <td colspan="6" class="p-20 text-center text-gray-400 italic text-xs leading-relaxed">
                  Zero active relational records matched incoming log system streams.
                </td>
              </tr>
            )}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</AdminLayout>

