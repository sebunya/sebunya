---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { readSessionToken } from "../../../lib/session";
import { tryFetchAdminList, apiBase } from "../../../lib/api";

const token = readSessionToken(Astro.request);
if (!token) {
  return Astro.redirect("/admin/login?returnTo=/admin/inventory", 303);
}

// Wave 2E-2: governed stock adjustment — the first write on this surface. Reason
// mandatory; the backend refuses negatives and anything below reserved holds, and
// its exact refusal is shown.
let adjustNotice: { kind: "success" | "error"; text: string } | null = null;
if (Astro.request.method === 'POST') {
  try {
    const form = await Astro.request.formData();
    const res = await fetch(`${apiBase}/admin/inventory/adjust`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
      body: JSON.stringify({
        productId: form.get('productId')?.toString().trim(),
        mode: form.get('mode')?.toString() === 'delta' ? 'delta' : 'set',
        value: Number(form.get('value')),
        reason: form.get('reason')?.toString().trim(),
      }),
    });
    const json = await res.json().catch(() => null);
    adjustNotice = res.ok && json?.success
      ? { kind: 'success', text: `Stock adjusted: ${json.data.before} → ${json.data.after} (reserved ${json.data.reserved}). Audited.` }
      : { kind: 'error', text: json?.error?.message || 'Adjustment refused.' };
  } catch {
    adjustNotice = { kind: 'error', text: 'Inventory service is unreachable right now.' };
  }
}

// Fetch authentic system data to render real inventory status
const result = await tryFetchAdminList<any>('/governance/admin/products', [], 'Live catalogue data is unavailable right now (service unreachable or permission denied). No sample data is shown.', token);
const products = result.items;

// Section 12 inventory ledger: enrich with available-to-promise, reserved and
// reorder data, plus the low-stock alert list, from the new inventory endpoints.
interface Availability { productId: string; sku: string; name: string; stockOnHand: number; reserved: number; available: number; reorderPoint: number; lowStock: boolean; }
const ledger = new Map<string, Availability>();
let lowStock: Availability[] = [];
const headers = { Authorization: `Bearer ${token}` };
try {
  const ids = products.map((p: any) => p.id).filter(Boolean).slice(0, 200);
  if (ids.length > 0) {
    const res = await fetch(`${apiBase}/admin/inventory/availability?productIds=${encodeURIComponent(ids.join(","))}`, { headers });
    const json = await res.json().catch(() => null);
    if (json?.success) for (const row of json.data as Availability[]) ledger.set(row.productId, row);
  }
  const lowRes = await fetch(`${apiBase}/admin/inventory/low-stock?limit=200`, { headers });
  const lowJson = await lowRes.json().catch(() => null);
  if (lowJson?.success) lowStock = lowJson.data;
} catch { /* ledger enrichment is best-effort; base view still renders */ }
---

<AdminLayout 
  title="Inventory Oversight" 
  description="Auditing active catalog stock levels and availability markers."
>
  <div class="container mx-auto px-6 lg:px-8 max-w-7xl">
    {adjustNotice && (
      <div class={`mb-6 rounded-xl px-4 py-3 text-sm font-semibold ${adjustNotice.kind === "success" ? "bg-emerald-50 text-emerald-800" : "bg-rose-50 text-rose-800"}`}>{adjustNotice.text}</div>
    )}
    <section class="mb-8 rounded-2xl border border-slate-200 bg-white p-5">
      <h2 class="text-sm font-black uppercase tracking-widest text-slate-500">Stock adjustment</h2>
      <p class="mt-1 text-xs text-slate-500">Row-locked; refused below zero or below reserved holds; before/after audited with your reason.</p>
      <form method="POST" class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-5">
        <input name="productId" required placeholder="Product ID (uuid)" class="sm:col-span-2 rounded-xl border border-gray-200 bg-gray-50 px-3 py-2.5 text-xs font-medium outline-none focus:border-brand-gold" />
        <select name="mode" aria-label="Adjustment mode: set to, or adjust by" class="rounded-xl border border-gray-200 bg-gray-50 px-3 py-2.5 text-xs font-bold outline-none focus:border-brand-gold">
          <option value="set">Set to</option>
          <option value="delta">Adjust by</option>
        </select>
        <input name="value" required type="number" step="1" placeholder="Quantity" class="rounded-xl border border-gray-200 bg-gray-50 px-3 py-2.5 text-xs font-medium outline-none focus:border-brand-gold" />
        <button type="submit" class="rounded-xl bg-brand-dark px-4 py-2.5 text-xs font-black uppercase tracking-wide text-white hover:bg-black">Apply</button>
        <input name="reason" required maxlength="300" placeholder="Reason (required — audited)" class="sm:col-span-5 rounded-xl border border-gray-200 bg-gray-50 px-3 py-2.5 text-xs font-medium outline-none focus:border-brand-gold" />
      </form>
    </section>
    
    <div class="mb-8 pb-6 border-b border-gray-200 flex flex-col md:flex-row justify-between md:items-center gap-4">
      <div>
        <h2 class="text-2xl font-black text-brand-dark tracking-tight">Stock & Availability</h2>
        <p class="text-sm text-gray-500 mt-1 max-w-2xl">
          Audit live item counts extracted directly from the product repository. This view is read-only; stock adjustments are made in the product editor.
        </p>
      </div>

      <div class="flex items-center gap-2">
        <span class="text-[8px] border border-yellow-200 bg-yellow-50 text-yellow-700 font-black px-2.5 py-1 rounded uppercase tracking-widest">Read-Only View</span>
      </div>
    </div>

    {result.isSample && (
      <div class="bg-amber-50 border border-amber-200 text-amber-800 px-6 py-4 rounded-2xl mb-8 text-xs leading-relaxed" role="status">
        <strong>System note:</strong> {result.reason}
      </div>
    )}

    {/* Statistics */}
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mb-8">
      <div class="bg-white p-5 rounded-xl border border-gray-200 shadow-sm">
        <p class="text-[9px] font-black text-gray-400 uppercase tracking-widest">Total Skus tracked</p>
        <p class="text-2xl font-black text-brand-dark mt-1">{products.length}</p>
      </div>
      <div class="bg-white p-5 rounded-xl border border-gray-200 shadow-sm">
        <p class="text-[9px] font-black text-gray-400 uppercase tracking-widest">In-Stock</p>
        <p class="text-2xl font-black text-brand-green mt-1">{products.filter(p => p.stockStatus === 'in_stock').length}</p>
      </div>
      <div class="bg-white p-5 rounded-xl border border-gray-200 shadow-sm">
        <p class="text-[9px] font-black text-gray-400 uppercase tracking-widest">Out-of-Stock</p>
        <p class="text-2xl font-black text-red-600 mt-1">{products.filter(p => p.stockStatus !== 'in_stock').length}</p>
      </div>
    </div>

    {/* Content */}
    <div class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="bg-gray-50 border-b border-gray-100 text-[10px] uppercase font-black text-gray-400 tracking-widest">
            <th class="p-5">Product Identifier</th>
            <th class="p-5">SKU</th>
            <th class="p-5 text-right">On hand</th>
            <th class="p-5 text-right">Reserved</th>
            <th class="p-5 text-right">Available</th>
            <th class="p-5 text-right">Reorder pt</th>
            <th class="p-5 text-center">Stock Indicator</th>
          </tr>
        </thead>
        <tbody class="text-xs">
          {products.map(p => {
            const led = ledger.get(p.id);
            return (
            <tr class={`border-b border-gray-50 hover:bg-gray-50/50 transition-colors ${led?.lowStock ? 'bg-red-50/40' : ''}`}>
              <td class="p-5">
                <div class="font-bold text-brand-dark">{p.name}</div>
                <div class="text-[10px] text-gray-400 mt-0.5">{p.categoryName || 'General'}</div>
              </td>
              <td class="p-5 font-mono text-gray-500">{p.sku}</td>
              <td class="p-5 text-right">{led ? led.stockOnHand : '—'}</td>
              <td class="p-5 text-right">{led ? led.reserved : '—'}</td>
              <td class={`p-5 text-right font-black ${led && led.available <= 0 ? 'text-red-600' : 'text-brand-dark'}`}>{led ? led.available : '—'}</td>
              <td class="p-5 text-right text-gray-500">{led ? led.reorderPoint : '—'}</td>
              <td class="p-5 text-center">
                <span class={`inline-block px-2.5 py-1 rounded-lg font-black text-[9px] uppercase tracking-wide ${p.stockStatus === 'in_stock' ? 'bg-green-50 text-green-700 border border-green-100' : 'bg-red-50 text-red-700 border border-red-100'}`}>
                  {p.stockStatus.replace(/_/g, ' ')}
                </span>
              </td>
            </tr>
          )})}
          {products.length === 0 && (
            <tr>
              <td colspan="7" class="p-12 text-center text-gray-400 italic">No SKUs registered in database.</td>
            </tr>
          )}
        </tbody>
      </table>
    </div>

    <div class={`mt-6 rounded-xl p-4 text-center border ${lowStock.length > 0 ? 'bg-red-50 border-red-200' : 'bg-green-50 border-green-200'}`}>
      <p class={`text-xs font-bold flex items-center justify-center gap-2 ${lowStock.length > 0 ? 'text-red-700' : 'text-green-700'}`}>
        {lowStock.length > 0
          ? `${lowStock.length} product(s) at or below reorder point — restock recommended.`
          : 'No products below their reorder point. Available-to-promise is derived from the live inventory ledger (on hand − reserved).'}
      </p>
    </div>

  </div>
</AdminLayout>
