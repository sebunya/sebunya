---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { apiBase } from '../../../lib/api';
import { readSessionToken } from '../../../lib/session';
import { formatUgx } from '../../../lib/money';

/**
 * 0222: pay in parts (lay-by). Every plan with its status and money; cancel an open plan when the customer asks
 * (the refund owed, paid less the fee, is recorded and a Care Desk task opened for a person to send it); and the
 * owner's numbers as settings. A new setting applies to plans started afterwards.
 */
const token = readSessionToken(Astro.request);
if (!token) return Astro.redirect('/admin/login?returnTo=/admin/pay-in-parts', 303);
const headers = { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' };
const STATUSES = ['awaiting_deposit', 'active', 'paid', 'lapsed', 'cancelled'] as const;
const LABEL: Record<string, string> = { awaiting_deposit: 'Waiting for deposit', active: 'Active', paid: 'Paid', lapsed: 'Lapsed', cancelled: 'Cancelled' };

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('action') ?? '');
  let res: Response | null = null;
  if (action === 'cancel') {
    const id = String(form.get('planId') ?? '');
    res = await fetch(`${apiBase}/admin/pay-in-parts/${encodeURIComponent(id)}/cancel`, { method: 'POST', headers, body: JSON.stringify({ reason: String(form.get('reason') ?? '') }) });
  } else if (action === 'setting') {
    res = await fetch(`${apiBase}/admin/pay-in-parts/settings`, { method: 'PUT', headers, body: JSON.stringify({ key: String(form.get('key') ?? ''), value: String(form.get('value') ?? '') }) });
  }
  const json: any = res ? await res.json().catch(() => null) : null;
  const text = json?.success ? (json.data?.message ?? 'Saved.') : (res?.status === 403 ? 'Not permitted for your account.' : (json?.error?.message ?? 'That did not work. Nothing was changed.'));
  return Astro.redirect(`/admin/pay-in-parts?${json?.success ? 'ok' : 'err'}=${encodeURIComponent(String(text).slice(0, 300))}`, 303);
}

const filter = Astro.url.searchParams.get('status') ?? '';
let data: any = null;
let loadError = '';
try {
  const r = await fetch(`${apiBase}/admin/pay-in-parts${STATUSES.includes(filter as never) ? `?status=${filter}` : ''}`, { headers });
  if (r.status === 401) return Astro.redirect('/admin/login?returnTo=/admin/pay-in-parts', 303);
  if (r.status === 403) return Astro.redirect('/admin/not-permitted', 303);
  const j: any = await r.json().catch(() => null);
  if (j?.success) data = j.data; else loadError = j?.error?.message ?? 'Could not load plans.';
} catch { loadError = 'Could not reach the API.'; }
const ok = Astro.url.searchParams.get('ok');
const err = Astro.url.searchParams.get('err');
const plans: any[] = data?.plans ?? [];
const day = (iso: string | null) => (iso ? new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'Africa/Kampala' }) : '');
---

<AdminLayout title="Pay in parts" description="Orders being paid in parts: balances, due dates, cancellations and refunds owed.">
  <div class="space-y-6 p-4 md:p-6">
    <h1 class="text-2xl font-black">Pay in parts</h1>
    {ok && <p class="rounded-lg border border-emerald-300 bg-emerald-50 p-3 text-sm" role="status">{ok}</p>}
    {err && <p class="rounded-lg border border-amber-300 bg-amber-50 p-3 text-sm" role="alert">{err}</p>}
    {loadError && <p class="rounded-lg border border-amber-300 bg-amber-50 p-3 text-sm" role="alert">{loadError}</p>}

    <nav class="flex flex-wrap gap-2 text-sm" aria-label="Filter by status">
      <a href="/admin/pay-in-parts" class:list={['rounded-full border px-3 py-1', !filter && 'bg-slate-900 text-white']}>All</a>
      {STATUSES.map((s) => <a href={`/admin/pay-in-parts?status=${s}`} class:list={['rounded-full border px-3 py-1', filter === s && 'bg-slate-900 text-white']}>{LABEL[s]}</a>)}
    </nav>

    <div class="overflow-x-auto rounded-xl border border-slate-200 bg-white">
      <table class="min-w-full text-sm">
        <thead class="bg-slate-50 text-left"><tr>
          <th class="p-2">Order</th><th class="p-2">Customer</th><th class="p-2">Status</th><th class="p-2 text-right">Total</th>
          <th class="p-2 text-right">Paid</th><th class="p-2 text-right">Left</th><th class="p-2">Due</th><th class="p-2">Refund owed</th><th class="p-2">Cancel</th>
        </tr></thead>
        <tbody>
          {plans.length === 0 && <tr><td colspan="9" class="p-3 text-slate-500">No plans{filter ? ' with this status' : ''} yet.</td></tr>}
          {plans.map((p) => (
            <tr class="border-t border-slate-100 align-top">
              <td class="p-2 font-bold"><a class="underline" href={`/admin/orders?q=${encodeURIComponent(p.orderNumber)}`}>{p.orderNumber}</a></td>
              <td class="p-2">{p.customerName}<br /><span class="text-slate-500">{p.customerPhone}</span></td>
              <td class="p-2">{LABEL[p.status] ?? p.status}</td>
              <td class="p-2 text-right tabular-nums">{formatUgx(p.totalUgx)}</td>
              <td class="p-2 text-right tabular-nums">{formatUgx(p.paidUgx)}</td>
              <td class="p-2 text-right tabular-nums">{formatUgx(Math.max(0, p.totalUgx - p.paidUgx))}</td>
              <td class="p-2">{day(p.dueAt)}</td>
              <td class="p-2">{p.refundUgx != null && p.paidUgx > 0 ? `${formatUgx(p.refundUgx)} (fee ${formatUgx(p.feeUgx ?? 0)})` : ''}</td>
              <td class="p-2">
                {(p.status === 'active' || p.status === 'awaiting_deposit') && (
                  <form method="post" class="flex flex-col gap-1">
                    <input type="hidden" name="action" value="cancel" /><input type="hidden" name="planId" value={p.id} />
                    <input name="reason" required minlength="5" placeholder="Why (customer asked...)" class="rounded border px-2 py-1" aria-label={`Reason to cancel ${p.orderNumber}`} />
                    <button class="rounded bg-slate-900 px-2 py-1 text-white" type="submit">Cancel and record refund of {formatUgx(p.paidUgx - Math.round(p.paidUgx * p.feePercent / 100))}</button>
                  </form>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <section class="rounded-xl border border-slate-200 bg-white p-4">
      <h2 class="font-black">Settings</h2>
      <p class="text-sm text-slate-600">The owner's rules (2026-11-07). A change applies to plans started afterwards; running plans keep their own deposit, term and fee.</p>
      <div class="mt-3 grid gap-3 md:grid-cols-2">
        {(data?.settings?.entries ?? []).map((e: any) => (
          <form method="post" class="rounded-lg border p-3 text-sm">
            <input type="hidden" name="action" value="setting" /><input type="hidden" name="key" value={e.key} />
            <label class="block font-bold" for={`s-${e.key}`}>{e.label}</label>
            <p class="text-xs text-slate-500">{e.help}</p>
            <div class="mt-1 flex gap-2"><input id={`s-${e.key}`} name="value" value={e.value} class="w-full rounded border px-2 py-1" /><button class="rounded border px-3" type="submit">Save</button></div>
          </form>
        ))}
      </div>
    </section>
  </div>
</AdminLayout>
