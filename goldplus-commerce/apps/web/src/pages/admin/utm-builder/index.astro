---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { readSessionToken } from "../../../lib/session";

const token = readSessionToken(Astro.request);
if (!token) {
  return Astro.redirect("/admin/login?returnTo=/admin/utm-builder", 303);
}
---

<AdminLayout 
  title="Tagging Utilities" 
  description="Ensure standard analytics parameters across internal links."
>
  <div class="container mx-auto px-6 lg:px-8 max-w-7xl">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between mb-8 gap-4 pb-6 border-b border-gray-200">
      <div>
        <h2 class="text-2xl font-black text-brand-dark tracking-tight">UTM Builder</h2>
        <p class="text-sm text-gray-500 mt-1">Link tagging tool to strictly enforce consistent source and medium attributes.</p>
      </div>
    </div>

    <div class="bg-yellow-50 border border-yellow-200 rounded-2xl p-12 text-center max-w-2xl">
      <div class="text-4xl mb-4">🏷️</div>
      <h3 class="text-base font-black text-yellow-800 uppercase tracking-wider">Parameter Builder Unconnected</h3>
      <p class="text-xs text-yellow-700 leading-relaxed mt-2 max-w-md mx-auto">
        The dynamic parameter constructor requires analytical tracking setup. In the interim, campaigns can be registered directly within the main Marketing dashboard with static labels.
      </p>
    </div>
  </div>
</AdminLayout>

