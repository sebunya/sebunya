---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import EmptyState from '../../../components/EmptyState.astro';
import Notice from '../../../components/Notice.astro';
import { apiBase } from '../../../lib/api';
import { readSessionToken, clearSessionCookie } from '../../../lib/session';
import type { ApiEnvelope } from '@goldplus/shared';

/**
 * Role management (2026-09-12). Create a role, set exactly which permissions it
 * carries, delete a role nobody holds. The two full-access roles are shown but
 * locked: they always carry every permission. Every save is audited under the
 * role (ROLE_CREATED / ROLE_PERMISSIONS_UPDATED / ROLE_DELETED) and the API
 * refuses a save that would leave no active administrator able to manage
 * access. Assigning a role to a person happens on the Users screen.
 */
interface RoleRow {
  id: string;
  name: string;
  permissionCodes: string[];
  userCount: number;
  description: string | null;
  isSystem: boolean;
}
interface CatalogueEntry { code: string; area: string }

const token = readSessionToken(Astro.request);
if (!token) {
  return Astro.redirect('/admin/login?returnTo=/admin/roles', 303);
}
const authHeaders = { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` };

let notice: { kind: 'success' | 'error'; text: string } | null = null;
if (Astro.request.method === 'POST') {
  try {
    const form = await Astro.request.formData();
    const action = String(form.get('action') || '');
    const codes = form.getAll('permission').map((v) => String(v));
    if (action === 'create-role') {
      const res = await fetch(`${apiBase}/admin/roles`, {
        method: 'POST', headers: authHeaders,
        body: JSON.stringify({ name: String(form.get('name') || '').trim().toUpperCase(), permissionCodes: codes }),
      });
      const json = await res.json().catch(() => null);
      notice = res.ok && json?.success
        ? { kind: 'success', text: `Role ${json.data.name} created with ${json.data.permissionCodes.length} permission${json.data.permissionCodes.length === 1 ? '' : 's'}.` }
        : { kind: 'error', text: json?.error?.message || 'Role creation refused.' };
    } else if (action === 'save-permissions') {
      const id = String(form.get('id') || '');
      const res = await fetch(`${apiBase}/admin/roles/${encodeURIComponent(id)}/permissions`, {
        method: 'PUT', headers: authHeaders, body: JSON.stringify({ permissionCodes: codes }),
      });
      const json = await res.json().catch(() => null);
      notice = res.ok && json?.success
        ? { kind: 'success', text: `${json.data.name} saved: ${json.data.added.length} added, ${json.data.removed.length} removed, ${json.data.permissionCodes.length} in total. Holders see the change on their next request.` }
        : { kind: 'error', text: json?.error?.message || 'Save refused.' };
    } else if (action === 'delete-role') {
      const id = String(form.get('id') || '');
      const res = await fetch(`${apiBase}/admin/roles/${encodeURIComponent(id)}`, { method: 'DELETE', headers: authHeaders });
      const json = await res.json().catch(() => null);
      notice = res.ok && json?.success
        ? { kind: 'success', text: `Role ${json.data.name} deleted.` }
        : { kind: 'error', text: json?.error?.message || 'Delete refused.' };
    }
  } catch {
    notice = { kind: 'error', text: 'Roles service is unreachable right now.' };
  }
}

let rows: RoleRow[] = [];
let catalogue: CatalogueEntry[] = [];
let fetchError: string | null = null;
try {
  const [res, cat] = await Promise.all([
    fetch(`${apiBase}/admin/roles`, { headers: { Authorization: `Bearer ${token}` } }),
    fetch(`${apiBase}/admin/roles/permissions`, { headers: { Authorization: `Bearer ${token}` } }),
  ]);
  if (res.status === 401 || res.status === 403) {
    Astro.response.headers.set('Set-Cookie', clearSessionCookie());
    return Astro.redirect('/admin/login?returnTo=/admin/roles', 303);
  }
  if (!res.ok) {
    fetchError = `Roles service responded with HTTP ${res.status}.`;
  } else {
    const json = (await res.json()) as ApiEnvelope<RoleRow[]>;
    if (json.success && Array.isArray(json.data)) rows = json.data;
    else fetchError = json.error?.message ?? 'Unexpected response.';
  }
  if (cat.ok) {
    const cj = (await cat.json().catch(() => null)) as ApiEnvelope<CatalogueEntry[]> | null;
    if (cj?.success && Array.isArray(cj.data)) catalogue = cj.data;
  }
} catch {
  fetchError = 'Cannot reach the roles service right now.';
}

// Catalogue grouped by module, in module order, for the checkbox grids.
const areas: { area: string; codes: string[] }[] = [];
for (const entry of catalogue) {
  const last = areas[areas.length - 1];
  if (last && last.area === entry.area) last.codes.push(entry.code);
  else areas.push({ area: entry.area, codes: [entry.code] });
}
const systemRoles = rows.filter((r) => r.isSystem);
const editableRoles = rows.filter((r) => !r.isSystem).sort((a, b) => a.name.localeCompare(b.name));
const totalCodes = catalogue.length;
---

<AdminLayout
  title="Roles"
  description="Create roles, set exactly which permissions each carries, delete roles nobody holds."
>
  <div class="container mx-auto px-6 lg:px-8 max-w-7xl">

    <div class="flex flex-col sm:flex-row sm:items-center justify-between mb-8 gap-4 pb-6 border-b border-gray-200">
      <div>
        <h2 class="text-2xl font-black text-brand-dark tracking-tight">Roles and permissions</h2>
        <p class="text-sm text-gray-500 mt-1 max-w-2xl">
          A role is a named set of permissions. Assign roles to people on <a href="/admin/users" class="underline font-bold text-brand-dark">Users</a>. Every change here is audited, and a save that would leave nobody able to manage access is refused.
        </p>
      </div>
      <a href="/admin/audit?entity=role" class="text-xs font-bold text-gray-500 hover:text-brand-dark border border-gray-200 px-4 py-2 rounded-xl bg-white">Role history &rarr;</a>
    </div>

    {notice && (
      <div class={`mb-6 rounded-xl border px-4 py-3 text-sm ${notice.kind === 'success' ? 'border-green-200 bg-green-50 text-green-800' : 'border-red-200 bg-red-50 text-red-800'}`} role="status">
        {notice.text}
      </div>
    )}

    {fetchError && (
      <div class="mb-6">
        <Notice kind="not-configured" title="Roles unavailable" message={fetchError} />
      </div>
    )}

    {rows.length === 0 && !fetchError ? (
      <EmptyState title="No roles yet" message="The API creates the governance roles at boot. If this stays empty, the boot sync did not run." />
    ) : (
      <div class="space-y-8">

        {systemRoles.length > 0 && (
          <section class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden">
            <div class="px-5 py-3 bg-gray-50 border-b border-gray-100">
              <h3 class="text-xs font-black uppercase tracking-widest text-brand-dark">Full-access roles (locked)</h3>
            </div>
            <div class="divide-y divide-gray-100">
              {systemRoles.map((r) => (
                <div class="p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                  <div>
                    <div class="font-black text-sm text-brand-dark font-mono">{r.name}</div>
                    <p class="text-xs text-gray-500 mt-1">{r.description}</p>
                  </div>
                  <div class="text-[10px] font-black uppercase tracking-widest text-gray-500 whitespace-nowrap">
                    {r.userCount} account{r.userCount === 1 ? '' : 's'} · {r.permissionCodes.length} permissions · granted only with a second administrator's approval
                  </div>
                </div>
              ))}
            </div>
          </section>
        )}

        <section class="space-y-4">
          <h3 class="text-xs font-black uppercase tracking-widest text-brand-dark">Editable roles</h3>
          {editableRoles.map((r) => (
            <details class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden" id={`role-${r.id}`}>
              <summary class="cursor-pointer p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-3 list-none">
                <div>
                  <div class="font-black text-sm text-brand-dark font-mono">{r.name}</div>
                  <p class="text-xs text-gray-500 mt-1">{r.description ?? 'Created in the Back Office.'}</p>
                </div>
                <div class="flex items-center gap-3 text-[10px] font-black uppercase tracking-widest whitespace-nowrap">
                  <span class="text-gray-500">{r.userCount} account{r.userCount === 1 ? '' : 's'}</span>
                  <span class={r.permissionCodes.length === 0 ? 'text-red-700' : 'text-gray-500'}>{r.permissionCodes.length} of {totalCodes} permissions{r.permissionCodes.length === 0 ? ' — holders can sign in and open nothing' : ''}</span>
                  <span class="text-brand-dark underline">Edit</span>
                </div>
              </summary>
              <form method="POST" class="border-t border-gray-100 p-5">
                <input type="hidden" name="action" value="save-permissions" />
                <input type="hidden" name="id" value={r.id} />
                <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
                  {areas.map((a) => (
                    <fieldset class="border border-gray-100 rounded-xl p-3">
                      <legend class="text-[10px] font-black uppercase tracking-widest text-gray-500 px-1">{a.area}</legend>
                      <div class="flex flex-col gap-1.5 mt-1">
                        {a.codes.map((code) => (
                          <label class="flex items-center gap-2 text-xs font-mono text-gray-700">
                            <input type="checkbox" name="permission" value={code} checked={r.permissionCodes.includes(code)} class="rounded border-gray-300" />
                            {code}
                          </label>
                        ))}
                      </div>
                    </fieldset>
                  ))}
                </div>
                <div class="mt-4 flex flex-wrap items-center gap-3">
                  <button type="submit" class="rounded-xl bg-brand-dark px-4 py-2.5 text-xs font-black uppercase tracking-wide text-white hover:bg-black">Save {r.name}</button>
                  <a href={`/admin/audit?entity=role&entityId=${encodeURIComponent(r.id)}`} class="text-[10px] font-bold text-gray-400 hover:text-gray-800 underline underline-offset-2">History</a>
                  <span class="text-[10px] text-gray-400">Unticked permissions are removed on save. Holders see the change on their next request.</span>
                </div>
              </form>
              {r.userCount === 0 && (
                <form method="POST" class="border-t border-gray-100 px-5 py-3 flex items-center justify-between gap-3 bg-gray-50/50">
                  <input type="hidden" name="action" value="delete-role" />
                  <input type="hidden" name="id" value={r.id} />
                  <span class="text-[10px] text-gray-500">Nobody holds this role, so it can be deleted.</span>
                  <button type="submit" class="text-[10px] font-black uppercase tracking-widest text-red-700 hover:text-red-900" data-confirm={`Delete the role ${r.name}? This is audited and cannot be undone.`}>Delete role</button>
                </form>
              )}
            </details>
          ))}
        </section>

        <section class="bg-white border border-gray-200 rounded-2xl shadow-sm p-5">
          <h3 class="text-xs font-black uppercase tracking-widest text-brand-dark">Create a role</h3>
          <p class="text-xs text-gray-500 mt-1">Capitals, digits and underscores, starting with a letter, for example SUPPORT_LEAD. Tick the permissions it should carry; you can change them later.</p>
          <form method="POST" class="mt-4">
            <input type="hidden" name="action" value="create-role" />
            <input name="name" required pattern="[A-Za-z][A-Za-z0-9_]{2,49}" placeholder="ROLE_NAME" aria-label="Role name" class="w-full sm:w-72 rounded-xl border border-gray-200 bg-gray-50 px-3 py-2.5 text-xs font-mono font-bold outline-none uppercase" />
            <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4 mt-4">
              {areas.map((a) => (
                <fieldset class="border border-gray-100 rounded-xl p-3">
                  <legend class="text-[10px] font-black uppercase tracking-widest text-gray-500 px-1">{a.area}</legend>
                  <div class="flex flex-col gap-1.5 mt-1">
                    {a.codes.map((code) => (
                      <label class="flex items-center gap-2 text-xs font-mono text-gray-700">
                        <input type="checkbox" name="permission" value={code} class="rounded border-gray-300" />
                        {code}
                      </label>
                    ))}
                  </div>
                </fieldset>
              ))}
            </div>
            <button type="submit" class="mt-4 rounded-xl bg-brand-dark px-4 py-2.5 text-xs font-black uppercase tracking-wide text-white hover:bg-black">Create role</button>
          </form>
        </section>
      </div>
    )}
  </div>
</AdminLayout>
