---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import EmptyState from '../../../components/EmptyState.astro';
import Notice from '../../../components/Notice.astro';
import { apiBase } from '../../../lib/api';
import { readSessionToken, clearSessionCookie } from '../../../lib/session';
import type { ApiEnvelope } from '@goldplus/shared';

interface RoleRow {
  id: string;
  name: string;
  permissionCodes: string[];
  userCount: number;
}

const token = readSessionToken(Astro.request);
if (!token) {
  return Astro.redirect('/admin/login?returnTo=/admin/roles', 303);
}

let rows: RoleRow[] = [];
let fetchError: string | null = null;

try {
  const res = await fetch(`${apiBase}/admin/roles`, { headers: { Authorization: `Bearer ${token}` } });
  if (res.status === 401 || res.status === 403) {
    Astro.response.headers.set('Set-Cookie', clearSessionCookie());
    return Astro.redirect('/admin/login?returnTo=/admin/roles', 303);
  }
  if (!res.ok) {
    fetchError = `Roles service responded with HTTP ${res.status}.`;
  } else {
    const json = (await res.json()) as ApiEnvelope<RoleRow[]>;
    if (json.success && Array.isArray(json.data)) rows = json.data;
    else fetchError = json.error?.message ?? 'Unexpected response.';
  }
} catch {
  fetchError = 'Cannot reach the roles service right now.';
}
---

<AdminLayout 
  title="Security Roles" 
  description="Inspect configured operational scopes and permissions."
>
  <div class="container mx-auto px-6 lg:px-8 max-w-7xl">
    
    <div class="flex flex-col sm:flex-row sm:items-center justify-between mb-8 gap-4 pb-6 border-b border-gray-200">
      <div>
        <h2 class="text-2xl font-black text-brand-dark tracking-tight">RBAC Scopes</h2>
        <p class="text-sm text-gray-500 mt-1">Operational bundles of direct DB permission definitions assigned to system operators.</p>
      </div>
    </div>

    {fetchError && (
      <div class="mb-6">
        <Notice kind="not-configured" title="RBAC Sync Disrupted" message={fetchError} />
      </div>
    )}

    {rows.length === 0 && !fetchError ? (
      <EmptyState
        title="No Roles Documented"
        message="Direct SQL migrations required to instantiate standard scope groups."
      />
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {rows.map((r) => (
          <div class="bg-white border border-gray-200 rounded-2xl p-6 shadow-sm flex flex-col">
            <div class="flex items-start justify-between gap-4 mb-4">
              <h2 class="text-base font-black text-brand-dark tracking-tight uppercase tracking-wide">{r.name}</h2>
              <span class="text-[9px] font-black text-gray-400 uppercase tracking-widest bg-gray-100 border border-gray-200 px-2 py-0.5 rounded-lg whitespace-nowrap">{r.userCount} Account{r.userCount === 1 ? '' : 's'}</span>
            </div>
            <div class="flex-grow">
              {r.permissionCodes.length === 0 ? (
                <p class="text-xs text-gray-400 italic font-medium">Zero explicit hooks attached.</p>
              ) : (
                <div class="flex flex-wrap gap-1.5">
                  {r.permissionCodes.map((code) => (
                    <code class="inline-flex items-center px-2 py-0.5 rounded text-[9px] font-mono font-medium bg-gray-50 text-gray-600 border border-gray-200 uppercase tracking-tight">{code}</code>
                  ))}
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
    )}
  </div>
</AdminLayout>

