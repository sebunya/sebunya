---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { readSessionToken } from "../../../lib/session";
import { apiBase } from "../../../lib/api";

const token = readSessionToken(Astro.request);
if (!token) {
  return Astro.redirect("/admin/login?returnTo=/admin/loyalty/fraud", 303);
}
const headers = { Authorization: `Bearer ${token}`, "Content-Type": "application/json" };

// Fraud signals (read-only): GET /admin/loyalty/fraud-signals returns the
// latest 100 rows of loyalty_fraud_signals, raised by the earning engines
// (e.g. verification scan caps, referral rings).
type Signal = Record<string, unknown> & { id?: string; signal_type?: string; account_id?: string | null; user_id?: string | null; details?: unknown; created_at?: string };

let signals: Signal[] | null = null;
let loadError = "";
try {
  const res = await fetch(`${apiBase}/admin/loyalty/fraud-signals`, { headers, signal: AbortSignal.timeout(5000) });
  const json = await res.json().catch(() => null);
  if (json?.success && Array.isArray(json.data)) signals = json.data;
  else loadError = json?.error?.message || `Could not load fraud signals (HTTP ${res.status}).`;
} catch {
  loadError = "Loyalty service is unreachable right now.";
}

const fmtDate = (v: unknown) => (typeof v === "string" && v ? new Date(v).toLocaleString("en-GB", { timeZone: "Africa/Kampala" }) : "—");
const fmtDetails = (v: unknown) => {
  if (v === null || v === undefined) return "—";
  return typeof v === "string" ? v : JSON.stringify(v);
};
---

<AdminLayout title="Loyalty fraud signals" description="Recent fraud signals raised by the loyalty engine.">
  <div class="container mx-auto max-w-6xl space-y-6 px-4 py-6 sm:px-6 lg:px-8" data-admin-loyalty-fraud>
    <header>
      <a href="/admin/loyalty" class="text-xs font-black text-brand-primaryInk hover:underline">← Loyalty programme</a>
      <h1 class="mt-3 text-3xl font-black tracking-tight text-brand-dark">Fraud signals</h1>
      <p class="mt-2 text-sm text-slate-600">The latest 100 signals, newest first. Signals are evidence for review; they do not block or reverse points on their own. Use <a href="/admin/loyalty/adjustments" class="font-bold underline">points adjustments</a> for an audited correction.</p>
    </header>

    {signals === null ? (
      <p class="rounded-2xl border border-red-200 bg-red-50 p-4 text-sm font-bold text-red-800" role="alert">{loadError}</p>
    ) : signals.length === 0 ? (
      <p class="rounded-2xl border border-slate-200 bg-white p-4 text-sm text-slate-500" data-empty>No fraud signals have been raised.</p>
    ) : (
      <div class="overflow-x-auto rounded-2xl border border-slate-200 bg-white">
        <table class="min-w-full text-left text-xs">
          <thead class="bg-slate-50 text-[10px] font-black uppercase tracking-widest text-slate-500">
            <tr><th class="px-3 py-2">Raised</th><th class="px-3 py-2">Signal</th><th class="px-3 py-2">User</th><th class="px-3 py-2">Account</th><th class="px-3 py-2">Details</th></tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {signals.map((s) => (
              <tr>
                <td class="whitespace-nowrap px-3 py-2">{fmtDate(s.created_at)}</td>
                <td class="px-3 py-2 font-bold">{String(s.signal_type ?? "—")}</td>
                <td class="px-3 py-2 font-mono">{s.user_id ? <a class="underline" href={`/admin/loyalty/adjustments?userId=${encodeURIComponent(String(s.user_id))}`}>{String(s.user_id).slice(0, 8)}</a> : "—"}</td>
                <td class="px-3 py-2 font-mono">{s.account_id ? String(s.account_id).slice(0, 8) : "—"}</td>
                <td class="max-w-md break-words px-3 py-2 font-mono text-[11px] text-slate-600">{fmtDetails(s.details)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </div>
</AdminLayout>
