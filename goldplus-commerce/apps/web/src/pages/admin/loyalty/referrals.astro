---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { readSessionToken } from "../../../lib/session";
import { apiBase } from "../../../lib/api";

const token = readSessionToken(Astro.request);
if (!token) {
  return Astro.redirect("/admin/login?returnTo=/admin/loyalty/referrals", 303);
}
const headers = { Authorization: `Bearer ${token}`, "Content-Type": "application/json" };

// Referral oversight (rework 2026-10-22): GET /admin/loyalty/referrals returns the funnel (invite link opens →
// friends who joined → first order → paid) and the list with HELD referrals first; a held one is released (pays
// both sides on the order it was held on) or refused here. Before, held referrals could never be paid by anyone.
type Referral = {
  id: string; code: string; status: string; source: string; heldReason: string | null; rejectionReason: string | null;
  referrerEmail: string | null; refereeEmail: string | null; qualifyingOrderNumber: string | null; friendOrders: number;
  createdAt: string; updatedAt: string;
};
type Funnel = { openedBy: number; opens: number; joined: number; ordered: number; awarded: number; held: number; bySource: Record<string, number>; byShare: Record<string, number> };

let notice: { kind: "success" | "error"; text: string } | null = null;
if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const id = String(form.get("id") ?? "");
  const decision = String(form.get("decision") ?? "");
  try {
    const res = await fetch(`${apiBase}/admin/loyalty/referrals/${encodeURIComponent(id)}/decision`, {
      method: "POST", headers, body: JSON.stringify({ decision, reason: String(form.get("reason") ?? "").trim() || undefined }), signal: AbortSignal.timeout(8000),
    });
    const json = await res.json().catch(() => null);
    notice = json?.success
      ? { kind: "success", text: json.data.status === "awarded" ? "Released: both customers have their points." : "Refused. The reason is on the referral." }
      : { kind: "error", text: json?.error?.message || "The decision was not saved." };
  } catch {
    notice = { kind: "error", text: "Loyalty service is unreachable right now." };
  }
}

const STATUSES = ["held", "pending", "awarded", "rejected"] as const;
const status = (STATUSES as readonly string[]).includes(Astro.url.searchParams.get("status") ?? "") ? Astro.url.searchParams.get("status")! : "";
const days = [7, 30, 90, 365].includes(Number(Astro.url.searchParams.get("days"))) ? Number(Astro.url.searchParams.get("days")) : 30;

let referrals: Referral[] | null = null;
let funnel: Funnel | null = null;
let loadError = "";
try {
  const q = new URLSearchParams({ days: String(days), ...(status ? { status } : {}) });
  const res = await fetch(`${apiBase}/admin/loyalty/referrals?${q}`, { headers, signal: AbortSignal.timeout(5000) });
  const json = await res.json().catch(() => null);
  if (json?.success && Array.isArray(json.data?.rows)) { referrals = json.data.rows; funnel = json.data.funnel ?? null; }
  else loadError = json?.error?.message || `Could not load referrals (HTTP ${res.status}).`;
} catch {
  loadError = "Loyalty service is unreachable right now.";
}

const fmtDate = (v: string | null) => (v ? new Date(v).toLocaleString("en-GB", { timeZone: "Africa/Kampala" }) : "—");
const n = (v: number) => new Intl.NumberFormat("en-UG").format(v);
const pct = (a: number, b: number) => (b > 0 ? `${Math.round((a / b) * 100)}%` : "—");
const HOLD: Record<string, string> = {
  MONTHLY_LIMIT: "More than 10 friends paid for this customer in 30 days",
  ORDER_TO_REFERRER_PHONE: "The friend's order went to the referrer's own phone",
};
const SOURCE: Record<string, string> = { link: "Invite link", typed: "Typed at sign-up", social: "Google/Facebook", account: "Added later" };
const STATUS_WORDS: Record<string, string> = { held: "Needs a decision", pending: "Waiting for first delivery", awarded: "Paid", rejected: "Not counted" };
---

<AdminLayout title="Loyalty referrals" description="Invite link funnel, referrals and held referrals to decide.">
  <div class="container mx-auto max-w-6xl space-y-6 px-4 py-6 sm:px-6 lg:px-8" data-admin-loyalty-referrals>
    <header>
      <a href="/admin/loyalty" class="text-xs font-black text-brand-primaryInk hover:underline">← Loyalty programme</a>
      <h1 class="mt-3 text-3xl font-black tracking-tight text-brand-dark">Referrals</h1>
      <p class="mt-2 text-sm text-slate-600">How invites turn into customers, and the referrals waiting for a person. Both customers are paid when the friend's first paid order is delivered.</p>
    </header>

    {notice && <p role={notice.kind === "error" ? "alert" : "status"} class={`rounded-2xl border p-4 text-sm font-bold ${notice.kind === "error" ? "border-red-200 bg-red-50 text-red-800" : "border-green-200 bg-green-50 text-green-900"}`}>{notice.text}</p>}

    <form method="GET" class="flex flex-wrap items-end gap-2 text-xs">
      <label class="font-bold text-slate-600">Period
        <select name="days" class="ml-1 rounded-lg border border-slate-200 px-2 py-1.5">{[7, 30, 90, 365].map((d) => <option value={d} selected={d === days}>Last {d} days</option>)}</select>
      </label>
      <label class="font-bold text-slate-600">Status
        <select name="status" class="ml-1 rounded-lg border border-slate-200 px-2 py-1.5"><option value="">All</option>{STATUSES.map((s) => <option value={s} selected={s === status}>{STATUS_WORDS[s]}</option>)}</select>
      </label>
      <button class="rounded-lg bg-brand-dark px-3 py-1.5 font-bold text-white">Show</button>
    </form>

    {funnel && (
      <section class="grid grid-cols-2 gap-3 sm:grid-cols-5" data-referral-funnel aria-label="Invite funnel">
        {[
          ["Opened an invite link", n(funnel.openedBy), `${n(funnel.opens)} opens`],
          ["Joined", n(funnel.joined), `${pct(funnel.joined, funnel.openedBy)} of people who opened`],
          ["Placed a first order", n(funnel.ordered), pct(funnel.ordered, funnel.joined) + " of joined"],
          ["Paid (delivered)", n(funnel.awarded), pct(funnel.awarded, funnel.joined) + " of joined"],
          ["Need a decision", n(funnel.held), funnel.held > 0 ? "see below" : "none"],
        ].map(([label, value, sub]) => (
          <div class="rounded-2xl border border-slate-200 bg-white p-4">
            <p class="text-[10px] font-black uppercase tracking-widest text-slate-500">{label}</p>
            <p class="mt-1 text-2xl font-black text-brand-dark">{value}</p>
            <p class="text-xs text-slate-500">{sub}</p>
          </div>
        ))}
      </section>
    )}
    {funnel && (
      <p class="text-xs text-slate-600" data-referral-sources>
        How friends arrived: {Object.keys(funnel.bySource).length ? Object.entries(funnel.bySource).map(([k, v]) => `${SOURCE[k] ?? k} ${n(v)}`).join(" · ") : "none yet"}.
        {" "}Links opened from: {Object.keys(funnel.byShare).length ? Object.entries(funnel.byShare).map(([k, v]) => `${k} ${n(v)}`).join(" · ") : "none yet"}.
        {" "}Opens before this release were not counted.
      </p>
    )}

    {referrals === null ? (
      <p class="rounded-2xl border border-red-200 bg-red-50 p-4 text-sm font-bold text-red-800" role="alert">{loadError}</p>
    ) : referrals.length === 0 ? (
      <p class="rounded-2xl border border-slate-200 bg-white p-4 text-sm text-slate-500" data-empty>No referrals have been recorded.</p>
    ) : (
      <div class="overflow-x-auto rounded-2xl border border-slate-200 bg-white">
        <table class="min-w-full text-left text-xs">
          <thead class="bg-slate-50 text-[10px] font-black uppercase tracking-widest text-slate-500">
            <tr><th class="px-3 py-2">Joined</th><th class="px-3 py-2">Referrer</th><th class="px-3 py-2">Friend</th><th class="px-3 py-2">How</th><th class="px-3 py-2">Friend's orders</th><th class="px-3 py-2">Status</th><th class="px-3 py-2">Detail</th></tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {referrals.map((r) => (
              <tr class={r.status === "held" ? "bg-amber-50/60" : ""}>
                <td class="whitespace-nowrap px-3 py-2">{fmtDate(r.createdAt)}</td>
                <td class="px-3 py-2">{r.referrerEmail ?? "—"}<div class="font-mono text-[10px] text-slate-500">{r.code}</div></td>
                <td class="px-3 py-2">{r.refereeEmail ?? "—"}</td>
                <td class="px-3 py-2">{SOURCE[r.source] ?? r.source}</td>
                <td class="px-3 py-2">{n(r.friendOrders)}{r.qualifyingOrderNumber ? <div class="text-[10px] text-slate-500">on {r.qualifyingOrderNumber}</div> : null}</td>
                <td class="px-3 py-2 font-bold">{STATUS_WORDS[r.status] ?? r.status}</td>
                <td class="px-3 py-2 text-slate-600">
                  {r.status === "held" ? (
                    <div class="space-y-2">
                      <p>{HOLD[r.heldReason ?? ""] ?? "Held for a check"}</p>
                      <form method="POST" class="inline"><input type="hidden" name="id" value={r.id} /><input type="hidden" name="decision" value="release" /><button class="rounded-lg bg-brand-dark px-3 py-1.5 font-bold text-white">Release and pay</button></form>
                      <form method="POST" class="flex gap-1"><input type="hidden" name="id" value={r.id} /><input type="hidden" name="decision" value="refuse" /><input name="reason" required minlength="3" maxlength="100" placeholder="Why refused" class="w-36 rounded-lg border border-slate-200 px-2 py-1" /><button class="rounded-lg border border-slate-300 px-3 py-1.5 font-bold">Refuse</button></form>
                    </div>
                  ) : (r.rejectionReason ?? "—")}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </div>
</AdminLayout>
