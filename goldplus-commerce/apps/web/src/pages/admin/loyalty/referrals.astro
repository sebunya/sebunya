---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { readSessionToken } from "../../../lib/session";
import { apiBase } from "../../../lib/api";

const token = readSessionToken(Astro.request);
if (!token) {
  return Astro.redirect("/admin/login?returnTo=/admin/loyalty/referrals", 303);
}
const headers = { Authorization: `Bearer ${token}`, "Content-Type": "application/json" };

// Referral oversight (read-only): GET /admin/loyalty/referrals returns the
// latest 200 referrals with referrer/referee emails, status and any rejection
// reason — the ring/self-referral fraud surface.
type Referral = {
  id: string; code: string; status: string; rejection_reason: string | null;
  created_at: string; updated_at: string | null;
  referrer_email: string | null; referee_email: string | null;
};

let referrals: Referral[] | null = null;
let loadError = "";
try {
  const res = await fetch(`${apiBase}/admin/loyalty/referrals`, { headers, signal: AbortSignal.timeout(5000) });
  const json = await res.json().catch(() => null);
  if (json?.success && Array.isArray(json.data)) referrals = json.data;
  else loadError = json?.error?.message || `Could not load referrals (HTTP ${res.status}).`;
} catch {
  loadError = "Loyalty service is unreachable right now.";
}

const statusCounts = new Map<string, number>();
for (const r of referrals ?? []) statusCounts.set(r.status, (statusCounts.get(r.status) ?? 0) + 1);
const fmtDate = (v: string | null) => (v ? new Date(v).toLocaleString("en-GB", { timeZone: "Africa/Kampala" }) : "—");
---

<AdminLayout title="Loyalty referrals" description="Referral codes, statuses and rejection reasons.">
  <div class="container mx-auto max-w-6xl space-y-6 px-4 py-6 sm:px-6 lg:px-8" data-admin-loyalty-referrals>
    <header>
      <a href="/admin/loyalty" class="text-xs font-black text-brand-primaryInk hover:underline">← Loyalty programme</a>
      <h1 class="mt-3 text-3xl font-black tracking-tight text-brand-dark">Referrals</h1>
      <p class="mt-2 text-sm text-slate-600">The latest 200 referrals, newest first. Read-only: rejections are made by the referral engine and recorded here with their reason.</p>
    </header>

    {referrals === null ? (
      <p class="rounded-2xl border border-red-200 bg-red-50 p-4 text-sm font-bold text-red-800" role="alert">{loadError}</p>
    ) : referrals.length === 0 ? (
      <p class="rounded-2xl border border-slate-200 bg-white p-4 text-sm text-slate-500" data-empty>No referrals have been recorded.</p>
    ) : (
      <>
        <div class="flex flex-wrap gap-2">
          {[...statusCounts.entries()].map(([status, count]) => (
            <span class="rounded-full border border-slate-200 bg-white px-3 py-1 text-xs font-bold text-slate-700">{status}: {count}</span>
          ))}
        </div>
        <div class="overflow-x-auto rounded-2xl border border-slate-200 bg-white">
          <table class="min-w-full text-left text-xs">
            <thead class="bg-slate-50 text-[10px] font-black uppercase tracking-widest text-slate-500">
              <tr><th class="px-3 py-2">Created</th><th class="px-3 py-2">Code</th><th class="px-3 py-2">Referrer</th><th class="px-3 py-2">Referee</th><th class="px-3 py-2">Status</th><th class="px-3 py-2">Rejection reason</th></tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              {referrals.map((r) => (
                <tr>
                  <td class="whitespace-nowrap px-3 py-2">{fmtDate(r.created_at)}</td>
                  <td class="px-3 py-2 font-mono">{r.code}</td>
                  <td class="px-3 py-2">{r.referrer_email ?? "—"}</td>
                  <td class="px-3 py-2">{r.referee_email ?? "—"}</td>
                  <td class="px-3 py-2 font-bold">{r.status}</td>
                  <td class="px-3 py-2 text-slate-600">{r.rejection_reason ?? "—"}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </>
    )}
  </div>
</AdminLayout>
