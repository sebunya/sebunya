---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { readSessionToken } from "../../../lib/session";
import { apiBase } from "../../../lib/api";

const token = readSessionToken(Astro.request);
if (!token) {
  return Astro.redirect("/admin/login?returnTo=/admin/loyalty/tiers", 303);
}
const headers = { Authorization: `Bearer ${token}`, "Content-Type": "application/json" };

// Tiers on the loyalty core. GET /admin/loyalty/tiers lists them; PUT
// /admin/loyalty/tiers/:code saves name, threshold and active (the API refuses
// activation while the threshold is unset). Tier evaluation assigns tiers to
// real accounts, so it is offered only while the programme is active.
type Tier = { code: string; name: string; thresholdLifetimePoints: number | null; benefits: unknown; rank: number; active: boolean; updatedAt: string };
type ProgrammeState = { enabled: boolean; envFlag: boolean; active: boolean };

let programme: ProgrammeState | null = null;
try {
  const res = await fetch(`${apiBase}/admin/loyalty/config`, { headers, signal: AbortSignal.timeout(5000) });
  const json = await res.json().catch(() => null);
  if (json?.success) programme = json.data;
} catch { /* unavailable state below */ }

let notice: { kind: "success" | "error"; text: string } | null = null;
if (Astro.request.method === "POST") {
  try {
    const form = await Astro.request.formData();
    const action = String(form.get("action") || "");
    if (action === "save") {
      const code = String(form.get("code") || "");
      let benefits: unknown = null;
      try { benefits = JSON.parse(String(form.get("benefits") || "null")); } catch { benefits = null; }
      const threshold = String(form.get("thresholdLifetimePoints") || "").replace(/[,\s]/g, "");
      const res = await fetch(`${apiBase}/admin/loyalty/tiers/${encodeURIComponent(code)}`, {
        method: "PUT", headers,
        body: JSON.stringify({
          name: String(form.get("name") || "").trim() || undefined,
          thresholdLifetimePoints: threshold === "" ? null : Number(threshold),
          benefits,
          active: form.get("active") === "on",
        }),
      });
      const json = await res.json().catch(() => null);
      notice = res.ok && json?.success
        ? { kind: "success", text: `Tier ${code} saved.` }
        : { kind: "error", text: json?.error?.message || `Could not save tier (HTTP ${res.status}).` };
    } else if (action === "evaluate") {
      if (!programme?.active) {
        notice = { kind: "error", text: "Tier evaluation is only offered while the programme is active." };
      } else {
        const res = await fetch(`${apiBase}/admin/loyalty/tiers/evaluate`, { method: "POST", headers });
        const json = await res.json().catch(() => null);
        notice = res.ok && json?.success
          ? { kind: "success", text: `Evaluated ${json.data.evaluated} account(s); ${json.data.changed} tier change(s).` }
          : { kind: "error", text: json?.error?.message || `Evaluation failed (HTTP ${res.status}).` };
      }
    }
  } catch {
    notice = { kind: "error", text: "Loyalty service is unreachable right now." };
  }
}

let tiers: Tier[] | null = null;
let loadError = "";
try {
  const res = await fetch(`${apiBase}/admin/loyalty/tiers`, { headers, signal: AbortSignal.timeout(5000) });
  const json = await res.json().catch(() => null);
  if (json?.success) tiers = json.data;
  else loadError = json?.error?.message || `Could not load tiers (HTTP ${res.status}).`;
} catch {
  loadError = "Loyalty service is unreachable right now.";
}
---

<AdminLayout title="Loyalty tiers" description="Tier names, lifetime-point thresholds and activation.">
  <div class="container mx-auto max-w-5xl space-y-6 px-4 py-6 sm:px-6 lg:px-8" data-admin-loyalty-tiers>
    <header>
      <a href="/admin/loyalty" class="text-xs font-black text-brand-primaryInk hover:underline">← Loyalty programme</a>
      <h1 class="mt-3 text-3xl font-black tracking-tight text-brand-dark">Loyalty tiers</h1>
      <p class="mt-2 text-sm text-slate-600">Tiers are reached by lifetime earned points. A tier cannot be activated until its threshold is set. Every save is audited.</p>
    </header>

    {programme === null ? (
      <div class="rounded-2xl border border-slate-300 bg-slate-100 p-4 text-sm font-bold text-slate-800" role="alert" data-programme-state="unknown">Programme state unavailable — the loyalty configuration could not be read.</div>
    ) : programme.active ? (
      <div class="rounded-2xl border border-emerald-200 bg-emerald-50 p-4 text-sm font-bold text-emerald-900" data-programme-state="active">Programme active — tier changes affect customers.</div>
    ) : (
      <div class="rounded-2xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-950" data-programme-state="dormant">
        <strong>Programme dormant.</strong> Environment flag <code class="font-mono text-xs">LOYALTY_PROGRAMME_ENABLED</code> is <strong>{programme.envFlag ? "on" : "off"}</strong>, config switch is <strong>{programme.enabled ? "on" : "off"}</strong>. Tier settings are preparation only; no customer is tiered or notified.
      </div>
    )}

    {notice && (
      <div class={`rounded-xl border px-4 py-3 text-sm font-bold ${notice.kind === "success" ? "border-green-200 bg-green-50 text-green-700" : "border-red-200 bg-red-50 text-red-700"}`} role="status">{notice.text}</div>
    )}

    {tiers === null ? (
      <p class="rounded-2xl border border-red-200 bg-red-50 p-4 text-sm font-bold text-red-800" role="alert">{loadError}</p>
    ) : tiers.length === 0 ? (
      <p class="text-sm text-slate-500">No tiers are defined.</p>
    ) : (
      <div class="space-y-4">
        {tiers.map((tier) => (
          <form method="POST" class="rounded-2xl border border-slate-200 bg-white p-5">
            <input type="hidden" name="action" value="save" />
            <input type="hidden" name="code" value={tier.code} />
            <input type="hidden" name="benefits" value={JSON.stringify(tier.benefits ?? null)} />
            <div class="flex flex-wrap items-center gap-2">
              <span class="font-mono text-xs font-black text-slate-500">#{tier.rank} · {tier.code}</span>
              <span class={`rounded-full border px-2 py-0.5 text-[10px] font-black uppercase ${tier.active ? "border-emerald-200 bg-emerald-50 text-emerald-800" : "border-slate-200 bg-slate-100 text-slate-700"}`}>{tier.active ? "Active" : "Inactive"}</span>
            </div>
            <div class="mt-4 grid items-end gap-4 sm:grid-cols-4">
              <label class="block sm:col-span-2">
                <span class="text-[10px] font-black uppercase tracking-widest text-slate-500">Name</span>
                <input name="name" value={tier.name} maxlength="60" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" />
              </label>
              <label class="block">
                <span class="text-[10px] font-black uppercase tracking-widest text-slate-500">Lifetime points threshold</span>
                <input name="thresholdLifetimePoints" inputmode="numeric" value={tier.thresholdLifetimePoints === null ? "" : String(tier.thresholdLifetimePoints)} placeholder="not set" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" />
              </label>
              <label class="inline-flex items-center gap-2 text-xs font-bold text-slate-700">
                <input type="checkbox" name="active" checked={tier.active} class="h-4 w-4 rounded border-slate-300" /> Active
              </label>
            </div>
            {tier.benefits !== null && tier.benefits !== undefined && (
              <p class="mt-3 text-xs text-slate-500">Benefits (kept as saved): <code class="font-mono">{JSON.stringify(tier.benefits)}</code></p>
            )}
            <button type="submit" class="mt-4 rounded-lg bg-brand-dark px-4 py-2 text-xs font-black uppercase tracking-widest text-white hover:opacity-90">Save tier</button>
          </form>
        ))}
      </div>
    )}

    <section class="rounded-2xl border border-slate-200 bg-white p-5">
      <h2 class="text-sm font-black uppercase tracking-widest text-slate-500">Evaluate tiers</h2>
      <p class="mt-2 text-sm text-slate-600">Recomputes every account's tier from its lifetime earned points and notifies customers whose tier changes.</p>
      {programme?.active ? (
        <form method="POST" class="mt-3">
          <input type="hidden" name="action" value="evaluate" />
          <button type="submit" class="rounded-lg border border-slate-300 bg-white px-4 py-2 text-xs font-black uppercase tracking-widest text-slate-800 hover:bg-slate-50">Run tier evaluation</button>
        </form>
      ) : (
        <p class="mt-3 text-xs font-bold text-slate-500">Not available while the programme is dormant or its state is unknown.</p>
      )}
    </section>
  </div>
</AdminLayout>
