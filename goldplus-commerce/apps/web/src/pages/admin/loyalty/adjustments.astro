---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { readSessionToken } from "../../../lib/session";
import { apiBase } from "../../../lib/api";

const token = readSessionToken(Astro.request);
if (!token) {
  return Astro.redirect("/admin/login?returnTo=/admin/loyalty/adjustments", 303);
}
const headers = { Authorization: `Bearer ${token}`, "Content-Type": "application/json" };

// Manual point adjustment. GET /admin/loyalty/members/:userId shows the
// member's current balance before anything is submitted; POST
// /admin/loyalty/adjust posts a signed, audited ledger entry. Both sit on
// SETTINGS_MANAGE. The idempotency key is generated at render, so a double
// submit or a retry of the same form cannot post twice. Adjustments create
// real liability, so the form is offered only while the programme is active.
type Balance = { available: number; pendingExpiry: number; lifetimeEarned: number; lifetimeRedeemed: number };
type Entry = { id: string; type: string; points: number; reason: string; createdAt: string };
type Member = { userId: string; programmeActive: boolean; balance: Balance; entries: Entry[] };
type ProgrammeState = { enabled: boolean; envFlag: boolean; active: boolean };

const UUID = /^[0-9a-f-]{36}$/i;
let userId = String(Astro.url.searchParams.get("userId") || "").trim();

let programme: ProgrammeState | null = null;
try {
  const res = await fetch(`${apiBase}/admin/loyalty/config`, { headers, signal: AbortSignal.timeout(5000) });
  const json = await res.json().catch(() => null);
  if (json?.success) programme = json.data;
} catch { /* unknown state below */ }

let notice: { kind: "success" | "error"; text: string } | null = null;
let idempotencyKey = crypto.randomUUID();
let keepPoints = "";
let keepReason = "";
if (Astro.request.method === "POST") {
  try {
    const form = await Astro.request.formData();
    userId = String(form.get("userId") || "").trim();
    const submittedKey = String(form.get("idempotencyKey") || "");
    const points = Number(String(form.get("points") || "").replace(/[,\s]/g, ""));
    const reason = String(form.get("reason") || "").trim();
    if (!programme?.active) {
      notice = { kind: "error", text: "Manual adjustments are disabled while the loyalty programme is not active." };
    } else if (!UUID.test(userId)) {
      notice = { kind: "error", text: "Look up a member by user id first." };
    } else if (reason.length < 10) {
      notice = { kind: "error", text: "A reason of at least 10 characters is required." };
      idempotencyKey = submittedKey || idempotencyKey; keepPoints = String(form.get("points") || ""); keepReason = reason;
    } else {
      const res = await fetch(`${apiBase}/admin/loyalty/adjust`, {
        method: "POST", headers,
        body: JSON.stringify({ userId, points, reason, idempotencyKey: submittedKey }),
      });
      const json = await res.json().catch(() => null);
      if (res.ok && json?.success) {
        notice = { kind: "success", text: `Adjustment of ${points > 0 ? "+" : ""}${points} points posted (entry ${String(json.data.entryId).slice(0, 8)}).` };
      } else {
        // Keep the same key so a retry of this same adjustment stays idempotent.
        notice = { kind: "error", text: json?.error?.message || `Adjustment refused (HTTP ${res.status}).` };
        idempotencyKey = submittedKey || idempotencyKey; keepPoints = String(form.get("points") || ""); keepReason = reason;
      }
    }
  } catch {
    notice = { kind: "error", text: "Loyalty service is unreachable right now." };
  }
}

let member: Member | null = null;
let memberError = "";
if (userId) {
  if (!UUID.test(userId)) {
    memberError = "User id must be a uuid.";
  } else {
    try {
      const res = await fetch(`${apiBase}/admin/loyalty/members/${encodeURIComponent(userId)}`, { headers, signal: AbortSignal.timeout(5000) });
      const json = await res.json().catch(() => null);
      if (json?.success) member = json.data;
      else memberError = json?.error?.message || `Could not load the member (HTTP ${res.status}).`;
    } catch {
      memberError = "Loyalty service is unreachable right now.";
    }
  }
}
const n = (v: number) => v.toLocaleString("en-US", { timeZone: "Africa/Kampala" });
const fmtDate = (v: string) => new Date(v).toLocaleString("en-GB", { timeZone: "Africa/Kampala" });
---

<AdminLayout title="Points adjustments" description="Look up a member balance and post an audited manual adjustment.">
  <div class="container mx-auto max-w-4xl space-y-6 px-4 py-6 sm:px-6 lg:px-8" data-admin-loyalty-adjustments>
    <header>
      <a href="/admin/loyalty" class="text-xs font-black text-brand-primaryInk hover:underline">← Loyalty programme</a>
      <h1 class="mt-3 text-3xl font-black tracking-tight text-brand-dark">Points adjustments</h1>
      <p class="mt-2 text-sm text-slate-600">A manual adjustment is a signed, append-only ledger entry with a mandatory reason. Every adjustment is audited with your user id.</p>
    </header>

    {programme === null ? (
      <div class="rounded-2xl border border-slate-300 bg-slate-100 p-4 text-sm font-bold text-slate-800" role="alert" data-programme-state="unknown">Programme state unavailable, so adjustments are disabled.</div>
    ) : !programme.active && (
      <div class="rounded-2xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-950" data-programme-state="dormant">
        <strong>Adjustments disabled: programme dormant.</strong> Environment flag <code class="font-mono text-xs">LOYALTY_PROGRAMME_ENABLED</code> is <strong>{programme.envFlag ? "on" : "off"}</strong>, config switch is <strong>{programme.enabled ? "on" : "off"}</strong>. No points liability is created until the programme is active. Balances can still be looked up.
      </div>
    )}

    {notice && (
      <div class={`rounded-xl border px-4 py-3 text-sm font-bold ${notice.kind === "success" ? "border-green-200 bg-green-50 text-green-700" : "border-red-200 bg-red-50 text-red-700"}`} role="status">{notice.text}</div>
    )}

    <form method="GET" class="flex flex-wrap items-end gap-3 rounded-2xl border border-slate-200 bg-white p-5">
      <label class="block flex-1">
        <span class="text-[10px] font-black uppercase tracking-widest text-slate-500">Member user id</span>
        <input name="userId" value={userId} required pattern="[0-9a-fA-F-]{36}" placeholder="uuid" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 font-mono text-sm" />
      </label>
      <button type="submit" class="rounded-lg border border-slate-300 bg-white px-4 py-2 text-xs font-black uppercase tracking-widest text-slate-800 hover:bg-slate-50">Look up balance</button>
    </form>

    {memberError && <p class="rounded-2xl border border-red-200 bg-red-50 p-4 text-sm font-bold text-red-800" role="alert">{memberError}</p>}

    {member && (
      <section class="rounded-2xl border border-slate-200 bg-white p-5" data-member-balance>
        <h2 class="text-sm font-black uppercase tracking-widest text-slate-500">Current balance</h2>
        <dl class="mt-3 grid grid-cols-2 gap-3 text-sm sm:grid-cols-4">
          <div><dt class="text-[10px] font-black uppercase text-slate-500">Available</dt><dd class="text-xl font-black">{n(member.balance.available)}</dd></div>
          <div><dt class="text-[10px] font-black uppercase text-slate-500">Pending expiry</dt><dd class="font-bold">{n(member.balance.pendingExpiry)}</dd></div>
          <div><dt class="text-[10px] font-black uppercase text-slate-500">Lifetime earned</dt><dd class="font-bold">{n(member.balance.lifetimeEarned)}</dd></div>
          <div><dt class="text-[10px] font-black uppercase text-slate-500">Lifetime redeemed</dt><dd class="font-bold">{n(member.balance.lifetimeRedeemed)}</dd></div>
        </dl>
        {member.entries.length === 0 ? (
          <p class="mt-4 text-xs text-slate-500">This member has no ledger entries.</p>
        ) : (
          <table class="mt-4 w-full text-left text-xs">
            <thead class="text-[10px] font-black uppercase tracking-widest text-slate-500"><tr><th class="py-1">When</th><th>Type</th><th>Points</th><th>Reason</th></tr></thead>
            <tbody>
              {member.entries.map((e) => (
                <tr class="border-t border-slate-100"><td class="whitespace-nowrap py-1">{fmtDate(e.createdAt)}</td><td>{e.type}</td><td class="font-mono">{e.points > 0 ? "+" : ""}{e.points}</td><td class="text-slate-600">{e.reason}</td></tr>
              ))}
            </tbody>
          </table>
        )}

        <h2 class="mt-6 text-sm font-black uppercase tracking-widest text-slate-500">Post an adjustment</h2>
        {programme?.active ? (
          <form method="POST" class="mt-3 space-y-3" data-adjust-form>
            <input type="hidden" name="userId" value={member.userId} />
            <input type="hidden" name="idempotencyKey" value={idempotencyKey} />
            <label class="block">
              <span class="text-[10px] font-black uppercase tracking-widest text-slate-500">Points (signed; negative deducts)</span>
              <input name="points" required inputmode="numeric" pattern="-?[0-9,]+" value={keepPoints} class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm sm:w-48" />
            </label>
            <label class="block">
              <span class="text-[10px] font-black uppercase tracking-widest text-slate-500">Reason (required, min 10 characters)</span>
              <textarea name="reason" required minlength="10" maxlength="280" rows="2" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm">{keepReason}</textarea>
            </label>
            <button type="submit" class="rounded-lg bg-brand-dark px-4 py-2 text-xs font-black uppercase tracking-widest text-white hover:opacity-90">Post adjustment</button>
          </form>
        ) : (
          <p class="mt-3 text-xs font-bold text-slate-500" data-adjust-disabled>Disabled while the programme is not active (see the notice above).</p>
        )}
      </section>
    )}
  </div>
</AdminLayout>
