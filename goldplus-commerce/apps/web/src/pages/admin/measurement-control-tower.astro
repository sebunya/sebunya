---
import AdminLayout from '../../layouts/AdminLayout.astro';
import ControlTowerShell from '../../components/admin/measurement-control-tower/ControlTowerShell.astro';
import HealthCard from '../../components/admin/measurement-control-tower/HealthCard.astro';
import StatusBadge from '../../components/admin/measurement-control-tower/StatusBadge.astro';
import ConsentSafetyPanel from '../../components/admin/measurement-control-tower/ConsentSafetyPanel.astro';
import ProductFinderPanel from '../../components/admin/measurement-control-tower/ProductFinderPanel.astro';
import PreferenceCentrePanel from '../../components/admin/measurement-control-tower/PreferenceCentrePanel.astro';
import PesapalReconciliationPanel from '../../components/admin/measurement-control-tower/PesapalReconciliationPanel.astro';
import PaidSocialReadinessPanel from '../../components/admin/measurement-control-tower/PaidSocialReadinessPanel.astro';
import GtmAutomationPanel from '../../components/admin/measurement-control-tower/GtmAutomationPanel.astro';
import DataQualityWarningsTable from '../../components/admin/measurement-control-tower/DataQualityWarningsTable.astro';
import RecentEventsTable from '../../components/admin/measurement-control-tower/RecentEventsTable.astro';
import AdminEmptyState from '../../components/admin/AdminEmptyState.astro';
import { readSessionToken } from '../../lib/session';
import { apiBase } from '../../lib/api';

const token = readSessionToken(Astro.request);
if (!token) {
  return Astro.redirect('/admin/login?returnTo=/admin/measurement-control-tower', 303);
}

import { deriveAdminStatus } from '@goldplus/shared';

// Existing API permissions remain authoritative; this page only improves safe UI states.
//
// This frontmatter previously read a PUBLIC_API_* variable no deployment sets — so
// SSR always fetched localhost:3000, always threw, and the page reported
// SERVICE_UNAVAILABLE forever while returning 200. It also forwarded the browser's
// Cookie header, but the API authenticates with `Authorization: Bearer` only, so even
// a correct origin would have shown ACCESS_DENIED. Canonical origin + bearer + a
// status-shaped classification make the three states truthful.
let summaryData = null;
let errorMsg = '';

try {
  const res = await fetch(`${apiBase}/admin/measurement-control-tower/summary`, {
    headers: { Authorization: `Bearer ${token}`, Accept: 'application/json' },
    signal: AbortSignal.timeout(10_000),
  });

  if (res.status === 401 || res.status === 403) {
    errorMsg = 'ACCESS_DENIED';
  } else if (!res.ok) {
    // The API answered — this is a server/contract fault, not unavailability.
    errorMsg = 'LOAD_FAILED';
  } else {
    const json = await res.json();
    if (json.success) {
      summaryData = json.data;
    } else {
      errorMsg = 'LOAD_FAILED';
    }
  }
} catch {
  // Only an unreachable/timed-out API lands here now.
  errorMsg = 'SERVICE_UNAVAILABLE';
}

/* Two separate questions, answered separately.
   COLLECTOR HEALTH: did the summary endpoint answer at all?
   EVENT ACTIVITY:   did anything actually flow in this window?
   A healthy collector with no activity is a legitimate, common state. */
const h = summaryData?.health ?? null;
const totalEvents = Number(h?.totalSafeEvents ?? 0) + Number(h?.eventsQueued ?? 0)
  + Number(h?.eventsFailed ?? 0) + Number(h?.eventsBlockedByConsent ?? 0);
const hasActivity = totalEvents > 0;
const collectorStatus = deriveAdminStatus({
  available: Boolean(summaryData),
  // The endpoint answering IS the successful operation being reported on.
  lastSuccessAt: summaryData ? new Date().toISOString() : null,
  lastError: errorMsg === 'LOAD_FAILED' ? 'The summary endpoint returned an error.' : null,
  observed: totalEvents,
});
const collectorHealthy = collectorStatus.status === 'HEALTHY';
/* A count of zero is a measured zero, not health. NEUTRAL renders it as a
   number without claiming anything about the pipeline. */
const countStatus = (v: unknown) => (Number(v ?? 0) > 0 ? 'HEALTHY' : 'NO_DATA_AVAILABLE');
---

<AdminLayout title="Measurement Control Tower">
  <div class="px-4 sm:px-6 lg:px-8 py-8 w-full max-w-9xl mx-auto">
    <div class="mb-8">
      <h1 class="text-2xl md:text-3xl font-bold text-slate-800">Measurement Control Tower</h1>
      <p class="mt-2 text-slate-600">Monitor consent-safe measurement, product-finder activity, payment reconciliation, paid-social readiness and GTM automation status.</p>
      
      <div class="mt-4 flex gap-2 text-xs">
        <StatusBadge status="DRY_RUN" label="Some destinations are in dry-run or not configured. This is expected until credentials and launch approvals are completed." />
        <StatusBadge status="REDACTED" label="Privacy note: This dashboard shows aggregate and redacted data only. Raw customer contact details and provider secrets are never displayed." />
      </div>
    </div>

    {errorMsg === 'ACCESS_DENIED' ? (
      <AdminEmptyState
        kind="access-denied"
        title="You do not have access to the Measurement Control Tower"
        what="This protected module displays consent-safe measurement readiness and redacted operational evidence."
        why="Your current role does not include the required Measurement Control Tower permission."
        nextStep="Ask an owner or admin for the correct role. Do not share tokens or provider credentials."
        actionHref="/admin"
        actionLabel="Return to Admin Trust Centre"
      />
    ) : errorMsg ? (
      <AdminEmptyState
        kind="error"
        title="Measurement readiness could not be loaded"
        what="The protected summary request did not return usable readiness data."
        why="The service may be unavailable or the response may not meet the expected contract. No provider was activated."
        nextStep="Retry safely, then review system health if the problem continues. Never paste credentials into chat or logs."
        actionHref="/admin/measurement-control-tower"
        actionLabel="Retry readiness check"
      />
    ) : !summaryData ? (
      <AdminEmptyState
        kind="no-data"
        title="No measurement readiness data yet"
        what="This module summarizes consent-safe events, reconciliation and controlled-activation readiness."
        why="No verified summary data was returned for this session."
        nextStep="Confirm approved configuration through existing protected workflows. Do not activate a provider from this state."
      />
    ) : (
      <ControlTowerShell>
        {/* Pipeline health and event activity are DIFFERENT questions.
            These cards previously hardcoded status="HEALTHY" on the event
            counters, so a pipeline that had processed nothing at all rendered
            entirely green — zero failures out of zero attempts read as health,
            which is exactly the reading that stops an operator investigating. */}
        <div class={`mb-4 rounded-2xl border p-5 ${collectorHealthy ? 'border-emerald-300 bg-emerald-50' : 'border-amber-300 bg-amber-50'}`}>
          <div class="flex flex-wrap items-center justify-between gap-3">
            <div>
              <p class={`text-[10px] font-black uppercase tracking-widest ${collectorHealthy ? 'text-emerald-700' : 'text-amber-700'}`}>Collector health</p>
              <p class={`mt-1 text-lg font-black ${collectorHealthy ? 'text-emerald-900' : 'text-amber-900'}`}>{collectorStatus.label}</p>
              <p class={`mt-1 text-xs ${collectorHealthy ? 'text-emerald-800' : 'text-amber-800'}`}>{collectorStatus.reason}</p>
            </div>
            <div class="text-right">
              <p class="text-[10px] font-black uppercase tracking-widest text-slate-500">Recent event activity</p>
              <p class="mt-1 text-lg font-black text-slate-800">{hasActivity ? `${totalEvents.toLocaleString('en-UG', { timeZone: 'Africa/Kampala' })} events` : 'NO DATA'}</p>
              <p class="mt-1 text-xs text-slate-600">
                {hasActivity ? 'Observed in the reported window.' : 'Nothing observed in this window. That is an absence of activity, not a fault.'}
              </p>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
          <HealthCard title="Safe Events" value={summaryData.health.totalSafeEvents} status={countStatus(summaryData.health.totalSafeEvents)} />
          <HealthCard title="Events Queued" value={summaryData.health.eventsQueued} status={countStatus(summaryData.health.eventsQueued)} />
          <HealthCard title="Events Failed" value={summaryData.health.eventsFailed} status={summaryData.health.eventsFailed > 0 ? 'WARNING' : countStatus(summaryData.health.eventsFailed)} />
          <HealthCard title="Blocked by Consent" value={summaryData.health.eventsBlockedByConsent} status="CONSENT_BLOCKED" />
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
          <ConsentSafetyPanel data={summaryData.consent} />
          <ProductFinderPanel data={summaryData.productFinder} />
          <PreferenceCentrePanel data={summaryData.preferenceCentre} />
          {summaryData.paymentReconciliation && (
            <PesapalReconciliationPanel data={summaryData.paymentReconciliation} />
          )}
          <PaidSocialReadinessPanel data={summaryData.paidSocialReadiness} />
          {summaryData.gtmAutomation && (
            <GtmAutomationPanel data={summaryData.gtmAutomation} />
          )}
        </div>

        {summaryData.warnings && (
          <div class="mb-8">
            <h2 class="text-xl font-bold mb-4">Data Quality & Privacy Warnings</h2>
            <DataQualityWarningsTable warnings={summaryData.warnings} />
          </div>
        )}

        <div>
          <h2 class="text-xl font-bold mb-4">Recent Events Queue</h2>
          <RecentEventsTable />
        </div>
      </ControlTowerShell>
    )}
  </div>
</AdminLayout>
