---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { readSessionToken } from "../../../lib/session";

const token = readSessionToken(Astro.request);
if (!token) {
  return Astro.redirect("/admin/login?returnTo=/admin/carts", 303);
}
---

<AdminLayout 
  title="Carts & Sessions" 
  description="Inspect active customer baskets, tracking IDs and storage persistence."
>
  <div class="container mx-auto px-6 lg:px-8 max-w-7xl">
    
    <div class="mb-8 border-b border-gray-200 pb-6">
      <h2 class="text-2xl font-black text-brand-dark tracking-tight">Active Cart Persistence</h2>
      <p class="text-sm text-gray-500 mt-1 max-w-3xl">
        Monitor server-hydrated shopping baskets across active sessions. Baskets are stored relationally and bound to customer device cookies to ensure zero item loss during return transitions.
      </p>
    </div>

    {/* Mechanical Statistics Info Cards */}
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
      <div class="bg-white border border-gray-200 rounded-2xl p-6 shadow-sm relative overflow-hidden">
        <div class="absolute top-0 right-0 w-20 h-20 bg-brand-green/5 rounded-bl-full"></div>
        <p class="text-[10px] font-black text-brand-green uppercase tracking-widest">Persistence Target</p>
        <h4 class="text-2xl font-black text-brand-dark mt-2">POSTGRESQL</h4>
        <p class="text-xs text-gray-500 mt-1.5 leading-relaxed">Relationally stored inside `commerce.carts` and `commerce.cart_items` tables rather than volatile LocalStorage.</p>
      </div>

      <div class="bg-white border border-gray-200 rounded-2xl p-6 shadow-sm relative overflow-hidden">
        <div class="absolute top-0 right-0 w-20 h-20 bg-blue-50 rounded-bl-full"></div>
        <p class="text-[10px] font-black text-blue-500 uppercase tracking-widest">Binding Lifespan</p>
        <h4 class="text-2xl font-black text-brand-dark mt-2">30 DAYS</h4>
        <p class="text-xs text-gray-500 mt-1.5 leading-relaxed">Tracked via secure `goldplus_cart_id` session identifier stored locally on client web requests.</p>
      </div>

      <div class="bg-white border border-gray-200 rounded-2xl p-6 shadow-sm relative overflow-hidden">
        <div class="absolute top-0 right-0 w-20 h-20 bg-brand-gold/5 rounded-bl-full"></div>
        <p class="text-[10px] font-black text-brand-gold uppercase tracking-widest">Status Check</p>
        <h4 class="text-2xl font-black text-brand-green mt-2 uppercase flex items-center gap-2">
          Operational
          <span class="inline-block w-2.5 h-2.5 bg-brand-green rounded-full animate-pulse"></span>
        </h4>
        <p class="text-xs text-gray-500 mt-1.5 leading-relaxed">Hydration endpoints verified in [GetCartByIdUseCase](file:///Users/robertsebunya/Documents/GitHub_Projects/GoldPlusFinal/goldplus-commerce/apps/api/src/application/use-cases/commerce/GetCartByIdUseCase.ts).</p>
      </div>
    </div>

    {/* Honest Empty List / Action Area */}
    <div class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden mb-8">
      <div class="px-6 py-6 border-b border-gray-100 bg-gray-50 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h3 class="text-xs font-black uppercase tracking-widest text-brand-dark">Active Live Baskets</h3>
          <p class="text-[10px] text-gray-500 mt-0.5">Requires global listing index API to render active shopping streams.</p>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-[8px] border border-yellow-200 bg-yellow-50 text-yellow-700 font-black px-2 py-0.5 rounded uppercase tracking-widest">Needs Index API</span>
        </div>
      </div>
      
      <div class="p-16 text-center flex flex-col items-center max-w-lg mx-auto">
        <div class="w-16 h-16 bg-gray-100 text-gray-400 flex items-center justify-center rounded-full text-2xl mb-4">
          🛒
        </div>
        <h4 class="font-black text-brand-dark text-base">Cart Listing Not Yet Exposed</h4>
        <p class="text-xs text-gray-500 mt-2 leading-relaxed">
          Individual cart retrieval endpoints (`GET /commerce/carts/:id`) are actively hydrating checkout steps, but a backend admin listing query has not been scheduled.
        </p>
        <div class="mt-6 flex gap-3">
          <a href="/" target="_blank" class="bg-brand-dark hover:bg-black text-white text-xs font-bold px-4 py-2 rounded-lg transition-colors">
            Verify Frontend &rarr;
          </a>
        </div>
      </div>
    </div>

  </div>
</AdminLayout>
