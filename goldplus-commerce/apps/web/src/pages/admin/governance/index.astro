---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { readSessionToken } from "../../../lib/session";

const token = readSessionToken(Astro.request);
if (!token) {
  return Astro.redirect("/admin/login?returnTo=/admin/governance", 303);
}

function parseJwtEmail(jwtToken) {
  try {
    const parts = String(jwtToken).split('.');
    if (parts.length !== 3) return 'Active Administrator';
    const base64Url = parts[1];
    const jsonPayload = Buffer.from(base64Url, 'base64url').toString('utf-8');
    const payloadObj = JSON.parse(jsonPayload);
    return payloadObj.email || payloadObj.sub || 'Active Administrator';
  } catch (e) {
    return 'Active Administrator';
  }
}

const adminEmail = parseJwtEmail(token);

const roles = [
  { 
    name: 'Super administrator', 
    desc: 'Full unrestricted access across all catalogs, rules, system configurations, and core operations.',
    level: 'Level 5'
  },
  { 
    name: 'Operations manager', 
    desc: 'Manages orders, fulfillment workflows, stock levels, and reviews checkout system statuses.',
    level: 'Level 4'
  },
  { 
    name: 'Merchandising manager', 
    desc: 'Oversees catalog layout maps, product listings, and creates/previews recommendation rules.',
    level: 'Level 3'
  },
  { 
    name: 'Support agent', 
    desc: 'Authorized to inspect customer carts, view active orders, and access diagnostic tools.',
    level: 'Level 2'
  },
  { 
    name: 'Read-only reviewer', 
    desc: 'Auditing access allowing visibility into settings and rules without authorization to modify data.',
    level: 'Level 1'
  }
];

const matrixHeaders = ['Feature', 'View', 'Create', 'Edit', 'Delete / Archive', 'Export / Diagnostic'];
const matrixRows = [
  { name: 'Products', canView: true, canCreate: true, canEdit: true, canDelete: false, canExport: true },
  { name: 'Orders', canView: true, canCreate: false, canEdit: true, canDelete: false, canExport: true },
  { name: 'Carts', canView: true, canCreate: false, canEdit: false, canDelete: false, canExport: true },
  { name: 'Recommendations', canView: true, canCreate: true, canEdit: true, canDelete: true, canExport: true },
  { name: 'Merchandising', canView: true, canCreate: false, canEdit: true, canDelete: false, canExport: false },
  { name: 'Settings', canView: true, canCreate: false, canEdit: true, canDelete: false, canExport: false },
  { name: 'Users and roles', canView: true, canCreate: false, canEdit: false, canDelete: false, canExport: false }
];
---

<AdminLayout 
  title="Access and roles" 
  description="Review admin roles, permissions and access controls."
>
  <div class="container mx-auto px-6 lg:px-8 max-w-7xl">
    
    <div class="mb-8 pb-6 border-b border-gray-200">
      <h2 class="text-2xl font-black text-brand-dark tracking-tight">Access and roles</h2>
      <p class="text-sm text-gray-500 mt-1 max-w-2xl">
        Review admin roles, permissions and access controls.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      
      <div class="lg:col-span-2 space-y-8">
        
        <!-- Current Administrator Banner -->
        <section class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden">
          <div class="p-5 bg-gray-50 border-b border-gray-100">
            <h3 class="text-[10px] font-black uppercase tracking-widest text-brand-dark">Current administrator</h3>
          </div>
          <div class="p-6">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-full bg-brand-gold/10 border border-brand-gold/20 flex items-center justify-center flex-shrink-0">
                <span class="text-brand-gold font-black text-sm uppercase">{adminEmail.charAt(0)}</span>
              </div>
              <div class="flex-1 min-w-0">
                <h4 class="font-bold text-brand-dark text-sm break-all">{adminEmail}</h4>
                <div class="flex flex-wrap gap-2 mt-2">
                  <span class="px-2 py-0.5 bg-gray-100 text-gray-600 border border-gray-200 rounded text-[9px] font-black uppercase tracking-wider">Role: Super administrator</span>
                  <span class="px-2 py-0.5 bg-green-50 text-green-700 border border-green-100 rounded text-[9px] font-black uppercase tracking-wider flex items-center gap-1">
                    <span class="w-1.5 h-1.5 bg-green-500 rounded-full inline-block"></span>
                    Session Active
                  </span>
                </div>
              </div>
              <div class="text-right hidden sm:block">
                <span class="text-[9px] font-black text-gray-400 uppercase tracking-widest block">Last login</span>
                <span class="text-xs text-gray-500 font-medium mt-1 block">Not tracked yet</span>
              </div>
            </div>
          </div>
        </section>

        <!-- Permissions Grid Matrix -->
        <section class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden">
          <div class="p-5 bg-gray-50 border-b border-gray-100">
            <h3 class="text-[10px] font-black uppercase tracking-widest text-brand-dark">Permissions matrix</h3>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-xs">
              <thead>
                <tr class="border-b border-gray-100 text-[9px] uppercase font-black text-gray-400">
                  {matrixHeaders.map((h, idx) => {
                    const isFirst = idx === 0;
                    return (
                      <th class={isFirst ? "p-4 pl-6" : "p-4 text-center"}>{h}</th>
                    );
                  })}
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-50 font-medium">
                {matrixRows.map(row => (
                  <tr class="hover:bg-gray-50/50 transition-colors">
                    <td class="p-4 pl-6 font-bold text-brand-dark">{row.name}</td>
                    <td class="p-4 text-center">
                      <span class={row.canView ? "inline-block w-2 h-2 rounded-full bg-green-500" : "inline-block w-2 h-2 rounded-full bg-gray-200"}></span>
                    </td>
                    <td class="p-4 text-center">
                      <span class={row.canCreate ? "inline-block w-2 h-2 rounded-full bg-green-500" : "inline-block w-2 h-2 rounded-full bg-gray-200"}></span>
                    </td>
                    <td class="p-4 text-center">
                      <span class={row.canEdit ? "inline-block w-2 h-2 rounded-full bg-green-500" : "inline-block w-2 h-2 rounded-full bg-gray-200"}></span>
                    </td>
                    <td class="p-4 text-center">
                      <span class={row.canDelete ? "inline-block w-2 h-2 rounded-full bg-green-500" : "inline-block w-2 h-2 rounded-full bg-gray-200"}></span>
                    </td>
                    <td class="p-4 text-center">
                      <span class={row.canExport ? "inline-block w-2 h-2 rounded-full bg-green-500" : "inline-block w-2 h-2 rounded-full bg-gray-200"}></span>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <div class="px-6 py-3 bg-gray-50/50 border-t border-gray-100 text-[10px] text-gray-400 flex items-center gap-3">
             <span class="flex items-center gap-1.5"><span class="w-2 h-2 bg-green-500 rounded-full"></span> Supported</span>
             <span class="flex items-center gap-1.5"><span class="w-2 h-2 bg-gray-200 rounded-full"></span> Restricted</span>
          </div>
        </section>

        <!-- Admin Roles Overview -->
        <section class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden">
          <div class="p-5 bg-gray-50 border-b border-gray-100">
            <h3 class="text-[10px] font-black uppercase tracking-widest text-brand-dark">Admin roles</h3>
          </div>
          <div class="divide-y divide-gray-100">
            {roles.map(role => (
              <div class="p-6 flex flex-col sm:flex-row justify-between sm:items-center gap-4 hover:bg-gray-50/30 transition-colors">
                <div class="space-y-1">
                  <div class="flex items-center gap-3">
                    <h4 class="font-black text-sm text-brand-dark">{role.name}</h4>
                    <span class="px-1.5 py-0.5 bg-gray-100 border border-gray-200 text-gray-500 rounded text-[8px] font-bold tracking-wide font-mono">{role.level}</span>
                  </div>
                  <p class="text-xs text-gray-500 leading-relaxed max-w-lg">{role.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </section>

      </div>

      <!-- Sidebar Context & Safe Auditing Notice -->
      <div class="space-y-6">
        
        <div class="bg-white border border-gray-200 rounded-2xl shadow-sm p-6 space-y-5">
          <h3 class="text-[10px] font-black uppercase tracking-widest text-gray-400 border-b border-gray-100 pb-3">User management status</h3>
          
          <div class="bg-gray-50 border border-gray-200 rounded-xl p-4 text-xs text-gray-500 leading-relaxed space-y-3">
            <p class="font-medium text-brand-dark">Admin accounts are created outside this console by design.</p>
            <p>Administrator access is granted through the controlled bootstrap process run by operations engineering. Keeping account creation off a web surface is a deliberate security decision, not a missing feature — a console that can mint administrators is a console worth attacking.</p>
          </div>

          <button 
            disabled 
            class="w-full bg-gray-50 border border-gray-200 text-gray-400 text-xs font-black py-3 rounded-xl cursor-not-allowed select-none"
          >
            Invite admin user &mdash; disabled by security policy
          </button>
        </div>

        <div class="bg-brand-dark text-white rounded-2xl shadow-md p-6 relative overflow-hidden">
           <div class="relative z-10">
             <h3 class="text-[10px] font-black uppercase tracking-widest text-brand-gold mb-3">Audit note</h3>
             <p class="text-xs text-gray-300 leading-relaxed font-medium">
               Admin access changes should be written to audit logs before user management is enabled. All modifications must undergo formal verification cycles.
             </p>
           </div>
        </div>

      </div>

    </div>

  </div>
</AdminLayout>
