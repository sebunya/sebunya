---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { readSessionToken } from "../../../lib/session";
import { apiBase } from "../../../lib/api";

const token = readSessionToken(Astro.request);
if (!token) {
  return Astro.redirect("/admin/login?returnTo=/admin/governance", 303);
}

function parseJwtEmail(jwtToken) {
  try {
    const parts = String(jwtToken).split('.');
    if (parts.length !== 3) return 'Active Administrator';
    const base64Url = parts[1];
    const jsonPayload = Buffer.from(base64Url, 'base64url').toString('utf-8');
    const payloadObj = JSON.parse(jsonPayload);
    return payloadObj.email || payloadObj.sub || 'Active Administrator';
  } catch (e) {
    return 'Active Administrator';
  }
}

const adminEmail = parseJwtEmail(token);

// Roles come from the same API the Roles screen uses. This page used to
// carry five invented roles with invented "Level 5..1" ranks and a
// hand-written permissions matrix; production has twelve roles with other
// names. Static claims about access are the one thing this page must not
// make — removed 2026-09-12.
type RoleRow = { id: string; name: string; permissionCodes: string[]; userCount: number };
let roles: RoleRow[] = [];
let rolesDenied = false;
let rolesFailed = false;
try {
  const res = await fetch(`${apiBase}/admin/roles`, { headers: { Authorization: `Bearer ${token}` } });
  if (res.status === 401 || res.status === 403) rolesDenied = true;
  else if (!res.ok) rolesFailed = true;
  else {
    const body = await res.json().catch(() => null);
    if (body?.success && Array.isArray(body.data)) roles = body.data as RoleRow[];
    else rolesFailed = true;
  }
} catch {
  rolesFailed = true;
}
const totalPermissionCodes = new Set(roles.flatMap((r) => r.permissionCodes)).size;
// The signed-in administrator's own grant, from the session endpoint. The
// badge used to read "Role: Super administrator" for everyone.
let myPermissionCount: number | null = null;
try {
  const me = await fetch(`${apiBase}/auth/admin-session`, { headers: { Authorization: `Bearer ${token}` } });
  const body = me.ok ? await me.json().catch(() => null) : null;
  if (body?.success && Array.isArray(body.data?.permissions)) myPermissionCount = body.data.permissions.length;
} catch {
  myPermissionCount = null;
}
const myPermissionLabel = myPermissionCount === null ? 'Permissions: not loaded' : `Permissions: ${myPermissionCount}`;
---

<AdminLayout 
  title="Access and roles" 
  description="Review admin roles, permissions and access controls."
>
  <div class="container mx-auto px-6 lg:px-8 max-w-7xl">
    
    <div class="mb-8 pb-6 border-b border-gray-200">
      <h2 class="text-2xl font-black text-brand-dark tracking-tight">Access and roles</h2>
      <p class="text-sm text-gray-500 mt-1 max-w-2xl">
        Review admin roles, permissions and access controls.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      
      <div class="lg:col-span-2 space-y-8">
        
        <!-- Current Administrator Banner -->
        <section class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden">
          <div class="p-5 bg-gray-50 border-b border-gray-100">
            <h3 class="text-[10px] font-black uppercase tracking-widest text-brand-dark">Current administrator</h3>
          </div>
          <div class="p-6">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-full bg-brand-gold/10 border border-brand-gold/20 flex items-center justify-center flex-shrink-0">
                <span class="text-brand-gold font-black text-sm uppercase">{adminEmail.charAt(0)}</span>
              </div>
              <div class="flex-1 min-w-0">
                <h4 class="font-bold text-brand-dark text-sm break-all">{adminEmail}</h4>
                <div class="flex flex-wrap gap-2 mt-2">
                  <span class="px-2 py-0.5 bg-gray-100 text-gray-600 border border-gray-200 rounded text-[9px] font-black uppercase tracking-wider">{myPermissionLabel}</span>
                  <span class="px-2 py-0.5 bg-green-50 text-green-700 border border-green-100 rounded text-[9px] font-black uppercase tracking-wider flex items-center gap-1">
                    <span class="w-1.5 h-1.5 bg-green-500 rounded-full inline-block"></span>
                    Session Active
                  </span>
                </div>
              </div>
              <div class="text-right hidden sm:block">
                <span class="text-[9px] font-black text-gray-400 uppercase tracking-widest block">Last login</span>
                <span class="text-xs text-gray-500 font-medium mt-1 block">Not tracked yet</span>
              </div>
            </div>
          </div>
        </section>

        <!-- Roles and permissions, read from the roles API -->
        <section class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden">
          <div class="p-5 bg-gray-50 border-b border-gray-100 flex flex-wrap items-center justify-between gap-3">
            <h3 class="text-[10px] font-black uppercase tracking-widest text-brand-dark">Roles and permissions</h3>
            <a href="/admin/roles" class="text-[10px] font-black uppercase tracking-wide text-brand-dark underline">Open Roles &rarr;</a>
          </div>
          {rolesDenied && (
            <div class="p-6 text-xs text-gray-500">Permission denied: listing roles requires the roles.manage permission. The roles still apply; this account cannot list them.</div>
          )}
          {rolesFailed && (
            <div class="p-6 text-xs text-gray-500">Roles could not be loaded right now (service unreachable). Nothing is shown rather than a stale copy.</div>
          )}
          {!rolesDenied && !rolesFailed && roles.length === 0 && (
            <div class="p-6 text-xs text-gray-500">No roles are defined.</div>
          )}
          {roles.length > 0 && (
            <div class="overflow-x-auto">
              <table class="w-full text-left border-collapse text-xs">
                <thead>
                  <tr class="border-b border-gray-100 text-[9px] uppercase font-black text-gray-400">
                    <th class="p-4 pl-6">Role</th>
                    <th class="p-4 text-center">Active users</th>
                    <th class="p-4 text-center">Permissions</th>
                    <th class="p-4">Permission codes</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-gray-50 font-medium">
                  {roles.map((role) => (
                    <tr class="hover:bg-gray-50/50 transition-colors align-top">
                      <td class="p-4 pl-6 font-bold text-brand-dark font-mono">{role.name}</td>
                      <td class="p-4 text-center tabular-nums">{role.userCount}</td>
                      <td class="p-4 text-center tabular-nums">{role.permissionCodes.length}</td>
                      <td class="p-4">
                        <details>
                          <summary class="cursor-pointer text-gray-500">Show</summary>
                          <div class="mt-2 flex flex-wrap gap-1">
                            {role.permissionCodes.map((code) => (
                              <span class="px-1.5 py-0.5 bg-gray-100 border border-gray-200 text-gray-600 rounded text-[9px] font-mono">{code}</span>
                            ))}
                          </div>
                        </details>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
              <div class="px-6 py-3 bg-gray-50/50 border-t border-gray-100 text-[10px] text-gray-400">
                {roles.length} roles · {totalPermissionCodes} distinct permission codes in use · a role with 0 active users is defined but unassigned.
              </div>
            </div>
          )}
        </section>

      </div>

      <!-- Sidebar Context & Safe Auditing Notice -->
      <div class="space-y-6">
        
        <div class="bg-white border border-gray-200 rounded-2xl shadow-sm p-6 space-y-5">
          <h3 class="text-[10px] font-black uppercase tracking-widest text-gray-400 border-b border-gray-100 pb-3">User management status</h3>
          
          <div class="bg-gray-50 border border-gray-200 rounded-xl p-4 text-xs text-gray-500 leading-relaxed space-y-3">
            <p class="font-medium text-brand-dark">Administrators are managed in the Users screen.</p>
            <p>Creating an administrator or reviewer, granting or revoking a role, and deactivating an account all happen in <a href="/admin/users" class="underline font-bold text-brand-dark">Users</a>. Every change needs the manage-authentication permission, is written to the audit log, and a role grant can be routed through a second approver. The last active platform administrator cannot be removed or deactivated.</p>
          </div>

          <a href="/admin/users" class="block w-full text-center bg-brand-dark text-white text-xs font-black py-3 rounded-xl hover:bg-black transition-colors">
            Open Users &rarr;
          </a>
        </div>

        <div class="bg-brand-dark text-white rounded-2xl shadow-md p-6 relative overflow-hidden">
           <div class="relative z-10">
             <h3 class="text-[10px] font-black uppercase tracking-widest text-brand-gold mb-3">Audit note</h3>
             <p class="text-xs text-gray-300 leading-relaxed font-medium">
               Admin access changes should be written to audit logs before user management is enabled. All modifications must undergo formal verification cycles.
             </p>
           </div>
        </div>

      </div>

    </div>

  </div>
</AdminLayout>
