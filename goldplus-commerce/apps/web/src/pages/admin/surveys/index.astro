---
import AdminLayout from '../../../layouts/AdminLayout.astro'; import { apiBase } from '../../../lib/api'; import { readSessionToken } from '../../../lib/session';
const token = readSessionToken(Astro.request); if (!token) return Astro.redirect('/admin/login?returnTo=/admin/surveys', 303); const headers = { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' }; let notice = '';
if (Astro.request.method === 'POST') { const form = await Astro.request.formData(); try { const questions = JSON.parse(String(form.get('questions') ?? '[]')); const lifecycleStages = String(form.get('lifecycleStages') ?? '').split(',').map((s) => s.trim()).filter(Boolean); const response = await fetch(`${apiBase}/admin/surveys`, { method: 'POST', headers, body: JSON.stringify({ key: form.get('key'), title: form.get('title'), description: form.get('description'), purposeKey: 'personalization', questions, audience: { lifecycleStages } }) }); const body = await response.json().catch(() => null); notice = body?.success ? 'Immutable survey draft created.' : body?.error?.message ?? 'Survey creation failed.'; } catch { notice = 'Questions must be valid JSON.'; } }
let surveys: any[] = []; let denied = false; let failed = false; try { const response = await fetch(`${apiBase}/admin/surveys`, { headers }); denied = response.status === 403; const body = await response.json().catch(() => null); surveys = body?.success ? body.data : []; failed = !body?.success && !denied; } catch { failed = true; }
---
<AdminLayout title="Surveys" description="Governed, consent-gated, PII-minimized survey operations."><div class="container mx-auto px-6 max-w-7xl"><h2 class="text-2xl font-black">Survey control room</h2><p class="text-sm text-gray-500 mb-6">No invitations or provider sends. Responses require current personalization consent and Customer DNA audience eligibility.</p>{notice && <div class="border rounded-xl p-3 mb-4">{notice}</div>}{denied && <div class="bg-red-50 text-red-800 p-4 rounded-xl">Permission denied: surveys.read required.</div>}{failed && <div class="bg-red-50 text-red-800 p-4 rounded-xl">Unavailable — persisted survey state could not be loaded.</div>}
{!denied && <div class="grid xl:grid-cols-[1fr_2fr] gap-6"><form method="POST" class="bg-white border rounded-2xl p-5 space-y-3"><h3 class="font-black">Create immutable draft</h3><input name="key" required pattern="[a-z][a-z0-9_-]{2,79}" placeholder="post_purchase_fit" class="w-full border rounded-xl p-2"/><input name="title" required placeholder="Survey title" class="w-full border rounded-xl p-2"/><textarea name="description" maxlength="1000" placeholder="Purpose and operator context" class="w-full border rounded-xl p-2"></textarea><input name="lifecycleStages" placeholder="ACTIVE,LAPSED (blank = all eligible)" class="w-full border rounded-xl p-2"/><textarea name="questions" required rows="9" class="w-full border rounded-xl p-2 font-mono text-xs" placeholder='[{"key":"fit","prompt":"How well did this fit your needs?","type":"SCALE","required":true,"min":0,"max":10}]'></textarea><button class="bg-brand-gold font-black rounded-xl px-4 py-2">Create draft</button><p class="text-xs text-gray-500">Requires surveys.create. Free-text and contact-data questions are not supported.</p></form><section><h3 class="font-black mb-3">Persisted surveys</h3>{surveys.length === 0 && !failed && <div class="bg-white border rounded-2xl p-8 text-center text-gray-500">Empty — no surveys exist.</div>}<div class="space-y-3">{surveys.map((item) => <a href={`/admin/surveys/${item.id}`} class="block bg-white border rounded-2xl p-5"><div class="flex justify-between"><div><strong>{item.title}</strong><div class="text-xs text-gray-500">{item.key} · {item.responseCount} responses · v{item.version}</div></div><span class="rounded-lg bg-slate-100 px-2 py-1 text-xs font-bold">{item.status}</span></div></a>)}</div></section></div>}
<div class="flex flex-wrap gap-2 mt-8">{['DRAFT','PENDING_APPROVAL','APPROVED','ACTIVE','PAUSED','CLOSED','REJECTED','Permission denied','Unavailable','Empty','Stale conflict'].map((state) => <span class="bg-slate-100 rounded px-2 py-1 text-xs">{state}</span>)}</div></div></AdminLayout>
