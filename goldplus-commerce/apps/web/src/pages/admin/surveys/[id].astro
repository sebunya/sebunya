---
import AdminLayout from '../../../layouts/AdminLayout.astro'; import { apiBase } from '../../../lib/api'; import { readSessionToken } from '../../../lib/session';
const token = readSessionToken(Astro.request); const id = Astro.params.id!; if (!token) return Astro.redirect(`/admin/login?returnTo=/admin/surveys/${id}`, 303); const headers = { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' }; let notice = '';
if (Astro.request.method === 'POST') { const form = await Astro.request.formData(); const operation = String(form.get('operation')); const response = await fetch(`${apiBase}/admin/surveys/${id}/${operation}`, { method: 'POST', headers, body: JSON.stringify({ expectedVersion: Number(form.get('expectedVersion')), reason: form.get('reason'), ...(operation === 'approve' ? { decision: form.get('decision') } : {}) }) }); const body = await response.json().catch(() => null); notice = response.status === 409 ? `Stale conflict: ${body?.error?.message ?? ''}` : body?.success ? `${operation} recorded.` : body?.error?.message ?? 'Operation failed.'; }
let detail: any = null; let analysis: any = null; let exportRows: any[] | null = null; let denied = false; let failed = false; try { const [detailResponse, analysisResponse, exportResponse] = await Promise.all([fetch(`${apiBase}/admin/surveys/${id}`, { headers }), fetch(`${apiBase}/admin/surveys/${id}/analysis`, { headers }), fetch(`${apiBase}/admin/surveys/${id}/export`, { headers })]); denied = detailResponse.status === 403; const detailBody = await detailResponse.json().catch(() => null); const analysisBody = await analysisResponse.json().catch(() => null); const exportBody = await exportResponse.json().catch(() => null); detail = detailBody?.success ? detailBody.data : null; analysis = analysisBody?.success ? analysisBody.data : null; exportRows = exportBody?.success ? exportBody.data : null; failed = !detail && !denied; } catch { failed = true; }
---
<AdminLayout title="Survey detail" description="Immutable questions, governance, aggregate analysis and PII-minimized export."><div class="container mx-auto px-6 max-w-7xl">{notice && <div class="border rounded-xl p-3 mb-4">{notice}</div>}{denied && <div class="bg-red-50 text-red-800 p-4 rounded-xl">Permission denied: surveys.read required.</div>}{failed && <div class="bg-red-50 text-red-800 p-4 rounded-xl">Unavailable — persisted survey evidence could not be loaded.</div>}{detail && <><a href="/admin/surveys" class="text-sm">← Surveys</a><section class="bg-white border rounded-2xl p-6 mt-4"><div class="flex justify-between"><div><h2 class="text-2xl font-black">{detail.version.title}</h2><p class="text-sm text-gray-500">{detail.definition.key} · digest {detail.version.contentDigest} · v{detail.definition.version}</p></div><strong>{detail.definition.status}</strong></div><p class="mt-3">{detail.version.description}</p><p class="text-xs mt-3">Purpose: personalization · lifecycle audience: {detail.version.audience.lifecycleStages.join(', ') || 'all eligible'} · no invitation/send path.</p></section>
{detail.definition.status === 'DRAFT' && <form method="POST" class="mt-4"><input type="hidden" name="operation" value="submit"/><input type="hidden" name="expectedVersion" value={detail.definition.version}/><input name="reason" required minlength="3" placeholder="Submission reason" class="border rounded p-2"/><button class="bg-brand-gold rounded p-2 ml-2 font-black">Submit for approval</button></form>} {detail.definition.status === 'PENDING_APPROVAL' && <form method="POST" class="bg-white border rounded-xl p-4 mt-4"><input type="hidden" name="operation" value="approve"/><input type="hidden" name="expectedVersion" value={detail.definition.version}/><select name="decision" class="border rounded p-2"><option>APPROVED</option><option>REJECTED</option></select><input name="reason" required minlength="3" placeholder="Independent decision reason" class="border rounded p-2 ml-2"/><button class="bg-brand-gold rounded p-2 ml-2 font-black">Record decision</button></form>} {['APPROVED','PAUSED'].includes(detail.definition.status) && <form method="POST" class="mt-4"><input type="hidden" name="operation" value="activate"/><input type="hidden" name="expectedVersion" value={detail.definition.version}/><input name="reason" required minlength="3" placeholder="Activation reason" class="border rounded p-2"/><button class="bg-brand-gold rounded p-2 ml-2 font-black">Activate in-app eligibility</button></form>} {detail.definition.status === 'ACTIVE' && <form method="POST" class="mt-4"><input type="hidden" name="operation" value="pause"/><input type="hidden" name="expectedVersion" value={detail.definition.version}/><input name="reason" required minlength="3" placeholder="Pause reason" class="border rounded p-2"/><button class="border rounded p-2 ml-2 font-black">Pause</button></form>} {['ACTIVE','PAUSED'].includes(detail.definition.status) && <form method="POST" class="mt-4"><input type="hidden" name="operation" value="close"/><input type="hidden" name="expectedVersion" value={detail.definition.version}/><input name="reason" required minlength="3" placeholder="Close reason" class="border rounded p-2"/><button class="border rounded p-2 ml-2 font-black">Close</button></form>}
<div class="grid md:grid-cols-2 gap-5 mt-5"><section class="bg-white border rounded-2xl p-5"><h3 class="font-black">Immutable questions</h3>{detail.version.questions.map((q) => <div class="border-t py-2 text-sm"><strong>{q.key}</strong> · {q.type} · {q.prompt}</div>)}</section><section class="bg-white border rounded-2xl p-5"><h3 class="font-black">Aggregate analysis</h3><p>{analysis?.completed ?? 0} completed / {analysis?.total ?? 0} started</p><pre class="text-xs overflow-auto mt-3">{JSON.stringify(analysis?.answers ?? {}, null, 2)}</pre><details class="mt-3"><summary class="text-xs underline">PII-minimized export ({exportRows === null ? 'permission denied or unavailable' : `${exportRows.length} rows`})</summary>{exportRows !== null && <pre class="text-xs overflow-auto mt-2">{JSON.stringify(exportRows, null, 2)}</pre>}</details></section></div><section class="bg-white border rounded-2xl p-5 mt-5"><h3 class="font-black">Immutable governance events</h3>{detail.events.map((event) => <div class="border-t py-2 text-xs"><strong>{event.action}</strong> · {event.reason}</div>)}</section></>}</div></AdminLayout>
