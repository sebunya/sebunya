---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import EmptyState from '../../../components/EmptyState.astro';
import { tryFetchAdminList } from '../../../lib/api';
import { readSessionToken } from '../../../lib/session';
import { formatUgx } from '../../../lib/money';
import {
  BUYER_TYPE_LABEL,
  QUOTE_STATUS_CLASS,
  QUOTE_STATUS_LABEL,
  formatCount,
  kampalaDateTime,
  type AdminQuoteRequest,
} from '../../../lib/adminQuoteRequests';

/**
 * Quote requests (docs/bulk-buying/DESIGN.md): every request newest first, the
 * bulk lists from /bulk and the older single-product /quote-request form alike.
 * Live data only; an unreachable API is said plainly, never filled in.
 */
const token = readSessionToken(Astro.request);
if (!token) {
  return Astro.redirect('/admin/login?returnTo=/admin/quotes', 303);
}

const result = await tryFetchAdminList<AdminQuoteRequest>(
  '/admin/quote-requests',
  [],
  'Live quote data is unavailable right now (service unreachable or permission denied). No sample data is shown.',
  token,
);
const openCount = result.items.filter((q) => q.status === 'new').length;
---

<AdminLayout title="Quote requests" description="Bulk lists and quote requests from buyers and dealers.">
  <div class="container mx-auto max-w-7xl px-4 lg:px-8">
    <div class="mb-6 flex flex-col gap-4 border-b border-gray-200 pb-6 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h2 class="text-2xl font-black tracking-tight text-brand-dark">Quote requests</h2>
        <p class="mt-1 text-sm text-gray-600">Bulk lists from the bulk builder (with a BQ reference) and single-product requests from the quote form. Every buyer was told sales will call them on the phone number shown.</p>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <span class="rounded-lg border border-gray-200 bg-gray-100 px-3 py-1.5 font-mono text-xs font-bold text-gray-700">NEW: {openCount}</span>
        <span class="rounded-lg border border-gray-200 bg-gray-100 px-3 py-1.5 font-mono text-xs font-bold text-gray-700">ALL: {result.items.length}</span>
        <a href="/api/admin/quotes/lines.csv" class="inline-flex min-h-11 items-center rounded-full bg-slate-900 px-4 text-sm font-bold text-white hover:bg-black focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-900 focus-visible:ring-offset-2">Download lines (CSV)</a>
      </div>
    </div>

    {result.isSample && (
      <div class="mb-6 rounded-2xl border border-blue-200 bg-blue-50 px-6 py-4 text-xs leading-relaxed text-blue-800"><strong>System note:</strong> {result.reason}</div>
    )}

    {result.items.length === 0 ? (
      <EmptyState title="No quote requests yet" message="When a buyer sends a list from /bulk, or the form at /quote-request, it appears here." />
    ) : (
      <div class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm">
        <div class="overflow-x-auto">
          <table class="w-full border-collapse text-left">
            <thead>
              <tr class="border-b border-gray-100 bg-gray-50 text-[10px] font-black uppercase tracking-widest text-gray-500">
                <th scope="col" class="p-4">Request</th>
                <th scope="col" class="p-4">Buyer</th>
                <th scope="col" class="p-4">What</th>
                <th scope="col" class="p-4 text-right">Units</th>
                <th scope="col" class="p-4 text-right">Est. at list price</th>
                <th scope="col" class="p-4">Delivery</th>
                <th scope="col" class="p-4 text-center">Status</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 text-xs">
              {result.items.map((q) => {
                const bulk = q.source === 'bulk_builder';
                return (
                  <tr class="align-top hover:bg-gray-50">
                    <td class="p-4">
                      <a href={`/admin/quotes/${q.id}`} class="font-mono text-sm font-black text-brand-dark underline underline-offset-4">{q.reference ?? 'Form request'}</a>
                      <div class="mt-1 text-[11px] text-gray-500">{kampalaDateTime(q.createdAt)}</div>
                    </td>
                    <td class="p-4">
                      <div class="text-sm font-bold text-brand-dark">{q.customerName}</div>
                      {q.businessName && <div class="text-gray-700">{q.businessName}</div>}
                      <div class="font-mono text-[11px] text-gray-600"><a class="underline" href={`tel:${q.phone.replace(/[^0-9+]/g, '')}`}>{q.phone}</a></div>
                      {q.email && <div class="font-mono text-[11px] text-gray-500">{q.email}</div>}
                      {q.buyerType && <div class="mt-1 text-[11px] font-bold text-gray-600">{BUYER_TYPE_LABEL[q.buyerType] ?? q.buyerType}</div>}
                    </td>
                    <td class="p-4 text-gray-700">
                      {bulk ? (
                        <>
                          <div class="font-bold">{q.totals.lineCount} {q.totals.lineCount === 1 ? 'product' : 'products'}</div>
                          <div class="text-[11px] text-gray-500">{q.lines.slice(0, 3).map((l) => l.productName).join(', ')}{q.lines.length > 3 ? ` and ${q.lines.length - 3} more` : ''}</div>
                        </>
                      ) : (
                        <div>{q.productName}</div>
                      )}
                    </td>
                    <td class="p-4 text-right font-mono font-black text-brand-dark">{bulk ? formatCount(q.totals.totalUnits) : q.quantity}</td>
                    <td class="p-4 text-right font-mono text-gray-700">
                      {bulk ? formatUgx(q.totals.estimatedTotalUgx) : '—'}
                      {bulk && q.totals.pricedLineCount < q.totals.lineCount && <div class="text-[10px] text-gray-500">{q.totals.lineCount - q.totals.pricedLineCount} unpriced</div>}
                    </td>
                    <td class="p-4 text-gray-700">
                      {q.deliveryDistrict ?? '—'}
                      {q.neededBy && <div class="text-[11px] text-gray-500">By {q.neededBy}</div>}
                    </td>
                    <td class="p-4 text-center">
                      <span class={`inline-block rounded-lg border px-2.5 py-1 text-[10px] font-black uppercase tracking-wide ${QUOTE_STATUS_CLASS[q.status] ?? QUOTE_STATUS_CLASS.lost}`}>{QUOTE_STATUS_LABEL[q.status] ?? q.status}</span>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </div>
    )}
  </div>
</AdminLayout>
