---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import AdminTable from '../../../components/AdminTable.astro';
import StatusBadge from '../../../components/StatusBadge.astro';
import EmptyState from '../../../components/EmptyState.astro';
import Notice from '../../../components/Notice.astro';
import { tryFetchAdminList } from '../../../lib/api';
import { readSessionToken } from '../../../lib/session';
import { SAMPLE_QUOTES, type SampleQuote } from '../../../lib/sample-data';

const token = readSessionToken(Astro.request);
if (!token) {
  return Astro.redirect("/admin/login?returnTo=/admin/quotes", 303);
}

const result = await tryFetchAdminList<SampleQuote>(
  '/governance/admin/quotes',
  SAMPLE_QUOTES,
  'Sample quote requests shown until /governance/admin/quotes is wired.',
);

const statusToBadge: Record<SampleQuote['status'], { variant: 'pending' | 'info' | 'success' | 'neutral'; label: string }> = {
  new: { variant: 'pending', label: 'New' },
  quoted: { variant: 'info', label: 'Quoted' },
  won: { variant: 'success', label: 'Won' },
  lost: { variant: 'neutral', label: 'Lost' },
};
---

<AdminLayout 
  title="Price Quotes" 
  description="Formulate responses to corporate procurement enquiries."
>
  <div class="container mx-auto px-6 lg:px-8 max-w-7xl">
    
    <div class="flex flex-col sm:flex-row sm:items-center justify-between mb-8 gap-4 pb-6 border-b border-gray-200">
      <div>
        <h2 class="text-2xl font-black text-brand-dark tracking-tight">Quote Inquiries</h2>
        <p class="text-sm text-gray-500 mt-1">Retail bulk, wholesale and corporate custom pricing request queues.</p>
      </div>
      <div class="flex items-center gap-2">
        <span class="bg-gray-100 text-gray-600 border border-gray-200 text-xs font-bold px-3 py-1.5 rounded-lg font-mono">
          REQUESTS: {result.items.length}
        </span>
      </div>
    </div>

    {result.isSample && (
      <div class="bg-blue-50 border border-blue-200 text-blue-800 px-6 py-4 rounded-2xl mb-8 flex items-center gap-4">
        
        <div class="text-xs leading-relaxed"><strong>System note:</strong> {result.reason}</div>
      </div>
    )}

    {result.items.length === 0 ? (
      <EmptyState
        title="No quote requests yet"
        message="Once buyers submit /quote-request, their enquiries appear here."
      />
    ) : (
      <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-gray-50 text-[10px] uppercase font-black text-gray-400 tracking-widest border-b border-gray-100">
                <th class="p-6">Customer / Org</th>
                <th class="p-6">Product Enquired</th>
                <th class="p-6">Qty</th>
                <th class="p-6">Submission</th>
                <th class="p-6 text-center">Status</th>
              </tr>
            </thead>
            <tbody class="text-xs divide-y divide-gray-50">
              {result.items.map((q) => (
                <tr class="hover:bg-gray-50 transition-colors">
                  <td class="p-6">
                    <div class="font-bold text-brand-dark text-sm">{q.customerName}</div>
                    <div class="text-[10px] text-gray-400 mt-0.5 font-mono">{q.email}</div>
                  </td>
                  <td class="p-6 text-gray-600 font-medium">
                    {q.productName}
                  </td>
                  <td class="p-6 text-brand-dark font-black font-mono">
                    {q.quantity}
                  </td>
                  <td class="p-6 text-gray-500 font-medium">
                    {new Date(q.createdAt).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' })}
                  </td>
                  <td class="p-6 text-center">
                    <span class={`inline-block px-2.5 py-1 rounded-lg font-black text-[9px] uppercase tracking-wide border ${
                      statusToBadge[q.status].variant === 'success' ? 'bg-green-50 text-green-700 border-green-100' :
                      statusToBadge[q.status].variant === 'pending' ? 'bg-orange-50 text-orange-700 border-orange-100' :
                      statusToBadge[q.status].variant === 'info' ? 'bg-blue-50 text-blue-700 border-blue-100' :
                      'bg-gray-50 text-gray-700 border-gray-100'
                    }`}>
                      {statusToBadge[q.status].label}
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    )}
  </div>
</AdminLayout>

