---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import EmptyState from '../../../components/EmptyState.astro';
import Notice from '../../../components/Notice.astro';
import { tryFetchAdminList } from '../../../lib/api';
import { readSessionToken } from '../../../lib/session';
import { type SamplePayment } from '../../../lib/sample-data';

const token = readSessionToken(Astro.request);
if (!token) {
  return Astro.redirect("/admin/login?returnTo=/admin/payments", 303);
}

const fallbackPayments: SamplePayment[] = [];

const result = await tryFetchAdminList<SamplePayment>(
  '/governance/admin/payments',
  fallbackPayments,
  'Live payment data is unavailable right now (service unreachable or permission denied). No sample data is shown.',
  token,
);

const statusToBadge: Record<SamplePayment['status'], { variant: 'pending' | 'info' | 'success' | 'neutral'; label: string }> = {
  PENDING: { variant: 'pending', label: 'Pending' },
  SUCCESS: { variant: 'success', label: 'Cleared' },
  FAILED: { variant: 'neutral', label: 'Failed' },
};

const formatter = new Intl.NumberFormat('en-UG', { style: 'currency', currency: 'UGX', maximumFractionDigits: 0 });

// Slice 3C: read-only reconciliation report (order status vs payments vs attempts)
import { apiBase } from '../../../lib/api';
interface ReconReport {
  healthy: boolean;
  checkedOrders: number;
  checkedPayments: number;
  checkedAttempts: number;
  findings: Array<{ type: string; orderId: string; orderNumber: string | null; detail: string }>;
}
let recon: ReconReport | null = null;
let reconUnavailable = false;
try {
  const reconRes = await fetch(`${apiBase}/governance/admin/payments/reconciliation`, {
    headers: { Authorization: `Bearer ${token}` },
  });
  const reconJson = await reconRes.json().catch(() => null);
  if (reconJson?.success) recon = reconJson.data;
  else reconUnavailable = true;
} catch {
  reconUnavailable = true;
}
const findingLabel: Record<string, string> = {
  order_paid_without_success_record: 'Order marked paid without a successful payment record',
  success_record_order_not_paid: 'Successful payment but order not marked paid',
  amount_mismatch: 'Payment amount differs from order total',
  stale_pending_attempt: 'Payment attempt pending for more than 24h',
};
---

<AdminLayout 
  title="Payment Ledger" 
  description="Examine webhook capture registries."
>
  <div class="container mx-auto px-6 lg:px-8 max-w-7xl">
    
    <div class="flex flex-col sm:flex-row sm:items-center justify-between mb-8 gap-4 pb-6 border-b border-gray-200">
      <div>
        <h2 class="text-2xl font-black text-brand-dark tracking-tight">Payment Streams</h2>
        <p class="text-sm text-gray-500 mt-1">Monitor real-time webhook ingress records and idempotent capture statuses.</p>
      </div>
    </div>

    <section class="mb-8" aria-labelledby="recon-heading">
      <h3 id="recon-heading" class="text-sm font-black uppercase tracking-widest text-gray-500 mb-3">Reconciliation</h3>
      {reconUnavailable && (
        <div class="bg-gray-50 border border-gray-200 text-gray-600 px-6 py-4 rounded-2xl text-xs">
          Reconciliation is unavailable right now (service unreachable or permission denied).
        </div>
      )}
      {recon && recon.healthy && (
        <div class="bg-green-50 border border-green-200 text-green-800 px-6 py-4 rounded-2xl text-xs font-bold">
          No discrepancies detected across {recon.checkedOrders} orders, {recon.checkedPayments} payment records and {recon.checkedAttempts} recent attempts.
        </div>
      )}
      {recon && !recon.healthy && (
        <div class="bg-red-50 border border-red-200 rounded-2xl overflow-hidden">
          <div class="px-6 py-3 text-xs font-black text-red-800 uppercase tracking-widest border-b border-red-100">
            {recon.findings.length} discrepanc{recon.findings.length === 1 ? 'y' : 'ies'} need review
          </div>
          <ul class="divide-y divide-red-100 text-xs">
            {recon.findings.slice(0, 50).map((f) => (
              <li class="px-6 py-3">
                <span class="font-black text-red-700">{findingLabel[f.type] ?? f.type}:</span>
                <span class="text-red-900 ml-1">{f.detail}</span>
              </li>
            ))}
          </ul>
        </div>
      )}
    </section>

    {result.isSample && (
      <div class="bg-blue-50 border border-blue-200 text-blue-800 px-6 py-4 rounded-2xl mb-8 flex items-center gap-4">
        
        <div class="text-xs leading-relaxed"><strong>System note:</strong> {result.reason}</div>
      </div>
    )}

    {result.items.length === 0 ? (
      <EmptyState
        title="No payment transactions yet"
        message="Incoming transactional webhooks will form rows within this view."
      />
    ) : (
      <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-gray-50 text-[10px] uppercase font-black text-gray-400 tracking-widest border-b border-gray-100">
                <th class="p-6">Transaction Key</th>
                <th class="p-6">Provider</th>
                <th class="p-6">Internal Order Reference</th>
                <th class="p-6 text-right">Value</th>
                <th class="p-6 text-center">State</th>
                <th class="p-6 text-right">Processed</th>
              </tr>
            </thead>
            <tbody class="text-xs divide-y divide-gray-50">
              {result.items.map((p) => (
                <tr class="hover:bg-gray-50 transition-colors">
                  <td class="p-6 font-mono font-bold text-brand-dark text-[10px]">
                    {p.id.substring(0, 12)}
                  </td>
                  <td class="p-6 uppercase font-black tracking-wide text-[9px] text-gray-600">
                    {p.provider}
                  </td>
                  <td class="p-6 font-mono text-gray-500 text-[10px]">
                    {p.orderId}
                  </td>
                  <td class="p-6 text-right font-black text-brand-dark text-sm font-mono">
                    {formatter.format(p.amount)}
                  </td>
                  <td class="p-6 text-center">
                    <span class={`inline-block px-2.5 py-0.5 rounded font-black text-[9px] uppercase tracking-wide border ${
                      statusToBadge[p.status].variant === 'success' ? 'bg-green-50 text-green-700 border-green-100' :
                      statusToBadge[p.status].variant === 'pending' ? 'bg-yellow-50 text-yellow-700 border-yellow-100' :
                      'bg-gray-50 text-gray-700 border-gray-100'
                    }`}>
                      {statusToBadge[p.status].label}
                    </span>
                  </td>
                  <td class="p-6 text-right font-mono text-gray-400 text-[10px]">
                    {new Date(p.createdAt).toLocaleString('en-GB', { dateStyle: 'short', timeStyle: 'short' })}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    )}
  </div>
</AdminLayout>
