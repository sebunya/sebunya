---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { readSessionToken } from "../../lib/session";
import {
  GAMIFICATION_READINESS_LEADERBOARD,
  LAUNCH_READINESS_CHECKLIST,
  LOYALTY_ADMIN_PREVIEW,
  LOYALTY_FOUNDATION_GUARDRAILS,
  RISK_CONTROLS_CHECKLIST,
  UTILISATION_READINESS_SCORECARD,
} from "../../lib/loyalty-foundation";

const token = readSessionToken(Astro.request);
if (!token) {
  return Astro.redirect("/admin/login?returnTo=/admin/loyalty", 303);
}

const levelClass = (value: string) => value === "High"
  ? "border-emerald-200 bg-emerald-50 text-emerald-800"
  : value === "Medium"
    ? "border-amber-200 bg-amber-50 text-amber-800"
    : "border-slate-200 bg-slate-100 text-slate-700";
---

<AdminLayout title="Loyalty foundation preview" description="Read-only readiness planning for future GoldPlus loyalty mechanics.">
  <div class="container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8" data-admin-loyalty-preview>
    <header class="flex flex-col gap-5 border-b border-slate-200 pb-7 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-3xl">
        <a href="/admin" class="text-xs font-black text-brand-primary hover:underline">← Admin Trust Centre</a>
        <p class="mt-5 text-[10px] font-black uppercase tracking-[0.2em] text-brand-primary">Protected operator preview</p>
        <h1 class="mt-2 text-3xl font-black tracking-tight text-brand-dark">Loyalty and gamification foundation</h1>
        <p class="mt-3 text-sm leading-relaxed text-slate-600">Review mechanics, blockers and commercial safeguards. This page reads static foundation rules only and cannot activate a programme.</p>
      </div>
      <div class="flex flex-wrap gap-2">
        <span class="rounded-full border border-emerald-200 bg-emerald-50 px-3 py-1.5 text-[10px] font-black uppercase tracking-wider text-emerald-800">Foundation ready</span>
        <span class="rounded-full border border-red-200 bg-red-50 px-3 py-1.5 text-[10px] font-black uppercase tracking-wider text-red-800">Programme not active</span>
        <span class="rounded-full border border-blue-200 bg-blue-50 px-3 py-1.5 text-[10px] font-black uppercase tracking-wider text-blue-800">Read-only</span>
      </div>
    </header>

    <section aria-labelledby="activation-state" class="mt-7 rounded-2xl border border-amber-200 bg-amber-50 p-6">
      <h2 id="activation-state" class="text-lg font-black text-amber-950">Activation status: {LOYALTY_ADMIN_PREVIEW.activationStatus}</h2>
      <p class="mt-2 text-sm leading-relaxed text-amber-900"><strong>Why disabled:</strong> {LOYALTY_ADMIN_PREVIEW.activationBlocker}</p>
      <button type="button" disabled aria-describedby="activation-disabled-reason" class="mt-5 cursor-not-allowed rounded-xl border border-amber-300 bg-amber-100 px-5 py-3 text-xs font-black text-amber-800">Activation unavailable</button>
      <p id="activation-disabled-reason" class="mt-2 text-xs text-amber-800">No toggle, mutation or provider action exists in this foundation.</p>
    </section>

    <section aria-labelledby="mechanic-statuses" class="mt-10">
      <h2 id="mechanic-statuses" class="text-2xl font-black text-brand-dark">Operator preview model</h2>
      <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {[
          ["Quests", "Preview only"], ["Badges", "Future model only"],
          ["Memory Lane", "Concept only"], ["Tiers", "Preview only"],
          ["Visual progress", "Preview only"], ["Utilisation-aware offers", "Concept only"],
          ["Mystery reveals", "Concept only"], ["Live financial mechanics", "Zero"],
        ].map(([label, value]) => <article class="rounded-xl border border-slate-200 bg-white p-5"><p class="text-xs font-black uppercase tracking-wider text-slate-500">{label}</p><p class="mt-2 font-black text-slate-950">{value}</p></article>)}
      </div>
    </section>

    <section aria-labelledby="leaderboard-heading" class="mt-12">
      <div class="max-w-3xl"><h2 id="leaderboard-heading" class="text-2xl font-black text-brand-dark">Gamification Readiness Leaderboard</h2><p class="mt-2 text-sm leading-relaxed text-slate-600">Ranks future mechanics by readiness and risk—not customers. It contains no names, phone numbers, emails, balances, spend or customer eligibility.</p></div>
      <div class="mt-6 overflow-x-auto rounded-2xl border border-slate-200 bg-white shadow-sm">
        <table class="min-w-[1160px] w-full text-left text-xs"><caption class="sr-only">Read-only ranking of future loyalty mechanics</caption><thead class="bg-slate-950 text-white"><tr>{["Rank", "Mechanic", "Customer value", "Commercial use", "Technical readiness", "Policy readiness", "Risk", "Activation blocker", "Status"].map((heading) => <th scope="col" class="px-4 py-4 font-black">{heading}</th>)}</tr></thead><tbody class="divide-y divide-slate-100">{GAMIFICATION_READINESS_LEADERBOARD.map((row) => <tr><td class="px-4 py-4 font-black text-slate-400">#{row.rank}</td><th scope="row" class="px-4 py-4 font-black text-slate-950">{row.mechanic}</th>{[row.customerValue, row.commercialUsefulness, row.technicalReadiness, row.policyReadiness, row.riskLevel].map((value) => <td class="px-4 py-4"><span class={`rounded-full border px-2 py-1 font-black ${levelClass(value)}`}>{value}</span></td>)}<td class="max-w-xs px-4 py-4 leading-relaxed text-slate-600">{row.activationBlocker}</td><td class="px-4 py-4 font-black text-amber-800">{row.status}</td></tr>)}</tbody></table>
      </div>
    </section>

    <section aria-labelledby="scorecard-heading" class="mt-12">
      <div class="max-w-3xl"><h2 id="scorecard-heading" class="text-2xl font-black text-brand-dark">Utilisation Offer Readiness Scorecard</h2><p class="mt-2 text-sm leading-relaxed text-slate-600">Ranks commercial signals, not people. No live inventory, order, customer or pricing data is read.</p></div>
      <div class="mt-6 overflow-x-auto rounded-2xl border border-slate-200 bg-white shadow-sm">
        <table class="min-w-[920px] w-full text-left text-xs"><caption class="sr-only">Read-only utilisation offer readiness scorecard</caption><thead class="bg-slate-950 text-white"><tr>{["Rank", "Signal", "Data readiness", "Policy readiness", "Margin control", "Activation blocker", "Status"].map((heading) => <th scope="col" class="px-4 py-4 font-black">{heading}</th>)}</tr></thead><tbody class="divide-y divide-slate-100">{UTILISATION_READINESS_SCORECARD.map((row) => <tr><td class="px-4 py-4 font-black text-slate-400">#{row.rank}</td><th scope="row" class="px-4 py-4 font-black text-slate-950">{row.signal}</th><td class="px-4 py-4">{row.dataReadiness}</td><td class="px-4 py-4">{row.policyReadiness}</td><td class="px-4 py-4">{row.marginControl}</td><td class="max-w-sm px-4 py-4 leading-relaxed text-slate-600">{row.activationBlocker}</td><td class="px-4 py-4 font-black text-amber-800">{row.status}</td></tr>)}</tbody></table>
      </div>
    </section>

    <div class="mt-12 grid gap-8 lg:grid-cols-2">
      <section aria-labelledby="launch-readiness" class="rounded-2xl border border-slate-200 bg-white p-6">
        <h2 id="launch-readiness" class="text-xl font-black text-brand-dark">Launch readiness checklist</h2>
        <p class="mt-2 text-sm text-slate-600">Evidence and accountable approvals are required; checking this page changes nothing.</p>
        <ol class="mt-5 space-y-3">{LAUNCH_READINESS_CHECKLIST.map((item, index) => <li class="flex gap-3 text-sm leading-relaxed text-slate-700"><span class="font-black text-slate-400">{String(index + 1).padStart(2, "0")}</span><span>{item}</span></li>)}</ol>
      </section>
      <section aria-labelledby="risk-controls" class="rounded-2xl border border-amber-200 bg-amber-50 p-6">
        <h2 id="risk-controls" class="text-xl font-black text-amber-950">Risk controls checklist</h2>
        <p class="mt-2 text-sm text-amber-900">Every control remains mandatory before the related capability can be considered.</p>
        <ul class="mt-5 space-y-3">{RISK_CONTROLS_CHECKLIST.map((item) => <li class="flex gap-3 text-sm leading-relaxed text-amber-950"><span aria-hidden="true" class="font-black">□</span><span>{item}</span></li>)}</ul>
      </section>
    </div>

    <section aria-labelledby="foundation-boundary" class="mt-12 rounded-2xl bg-slate-950 p-6 text-white sm:p-8">
      <h2 id="foundation-boundary" class="text-xl font-black">Foundation boundary</h2>
      <div class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">{LOYALTY_FOUNDATION_GUARDRAILS.map((item) => <p class="rounded-xl border border-slate-800 bg-slate-900 p-4 text-xs leading-relaxed text-slate-300">{item}</p>)}</div>
    </section>
  </div>
</AdminLayout>
