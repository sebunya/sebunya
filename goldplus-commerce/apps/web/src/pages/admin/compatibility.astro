---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { readSessionToken } from "../../lib/session";
import { apiBase } from "../../lib/api";

const token = readSessionToken(Astro.request);
if (!token) {
  return Astro.redirect("/admin/login?returnTo=/admin/compatibility", 303);
}

const headers = { Authorization: `Bearer ${token}`, "Content-Type": "application/json" };
const VERDICTS = ["exact", "compatible", "conditional", "incompatible"] as const;

let notice: { kind: "success" | "error"; text: string } | null = null;

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const intent = String(form.get("intent") || "save");
  try {
    if (intent === "delete") {
      const id = String(form.get("id") || "");
      const res = await fetch(`${apiBase}/admin/compatibility/${encodeURIComponent(id)}`, { method: "DELETE", headers });
      const json = await res.json().catch(() => null);
      notice = json?.success
        ? { kind: "success", text: "Mapping removed." }
        : { kind: "error", text: json?.error?.message || "Could not remove the mapping." };
    } else {
      const res = await fetch(`${apiBase}/admin/compatibility`, {
        method: "PUT",
        headers,
        body: JSON.stringify({
          productId: String(form.get("productId") || "").trim(),
          targetProductId: String(form.get("targetProductId") || "").trim(),
          verdict: String(form.get("verdict") || ""),
          note: String(form.get("note") || "").trim() || null,
          enabled: String(form.get("enabled") || "on") === "on",
        }),
      });
      const json = await res.json().catch(() => null);
      notice = json?.success
        ? { kind: "success", text: `Saved ${json.data.verdict} mapping.` }
        : { kind: "error", text: json?.error?.message || "Could not save the mapping." };
    }
  } catch {
    notice = { kind: "error", text: "Compatibility service is unreachable right now." };
  }
}

let mappings: Array<{ id: string; productId: string; targetProductId: string; verdict: string; note: string | null; enabled: boolean }> = [];
let productNames = new Map<string, string>();
let loadFailed = false;
try {
  const res = await fetch(`${apiBase}/admin/compatibility`, { headers });
  const json = await res.json().catch(() => null);
  if (json?.success) mappings = json.data;
  else loadFailed = true;
  const prodRes = await fetch(`${apiBase}/products?limit=200`, { signal: AbortSignal.timeout(3000) });
  const prodJson = await prodRes.json().catch(() => null);
  if (prodJson?.success && Array.isArray(prodJson.data)) {
    productNames = new Map(prodJson.data.map((p: { id: string; name: string }) => [p.id, p.name]));
  }
} catch {
  loadFailed = true;
}
const nameOf = (id: string) => productNames.get(id) ?? `${id.slice(0, 8)}…`;
---

<AdminLayout
  title="Compatibility Mappings"
  description="Declare verified product-to-product compatibility shown on product pages."
>
  <div class="container mx-auto px-6 lg:px-8 max-w-6xl">
    <div class="mb-8 pb-6 border-b border-gray-200">
      <h2 class="text-2xl font-black text-brand-dark tracking-tight">Verified Compatibility</h2>
      <p class="text-sm text-gray-500 mt-1 max-w-2xl">
        Only declared pairs appear on product pages. A product without a declaration shows no
        compatibility claim — unknown is never presented as compatible. Conditional verdicts
        must state their condition.
      </p>
    </div>

    {notice && (
      <div class={`mb-6 rounded-xl border px-4 py-3 text-sm font-bold ${notice.kind === "success" ? "border-green-200 bg-green-50 text-green-700" : "border-red-200 bg-red-50 text-red-700"}`} role="status">
        {notice.text}
      </div>
    )}

    <form method="POST" class="bg-white border border-gray-200 rounded-2xl shadow-sm p-6 mb-8 grid gap-4 md:grid-cols-2">
      <input type="hidden" name="intent" value="save" />
      <label class="block">
        <span class="text-[10px] uppercase font-black text-gray-400 tracking-widest">Product ID (anchor)</span>
        <input name="productId" required class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 text-xs font-mono" placeholder="uuid" />
      </label>
      <label class="block">
        <span class="text-[10px] uppercase font-black text-gray-400 tracking-widest">Target product ID</span>
        <input name="targetProductId" required class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 text-xs font-mono" placeholder="uuid" />
      </label>
      <label class="block">
        <span class="text-[10px] uppercase font-black text-gray-400 tracking-widest">Verdict</span>
        <select name="verdict" class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 text-sm">
          {VERDICTS.map((v) => <option value={v}>{v}</option>)}
        </select>
      </label>
      <label class="block">
        <span class="text-[10px] uppercase font-black text-gray-400 tracking-widest">Note (required for conditional)</span>
        <input name="note" maxlength="300" class="mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" placeholder="e.g. Requires USB-C to Lightning cable" />
      </label>
      <div class="flex items-center gap-3 md:col-span-2">
        <label class="inline-flex items-center gap-2 text-xs font-bold text-gray-600">
          <input type="checkbox" name="enabled" checked class="w-4 h-4 text-brand-primary border-gray-300 rounded" />
          Enabled
        </label>
        <button type="submit" class="bg-brand-primary text-white text-xs font-black uppercase tracking-widest px-4 py-2.5 rounded-lg hover:opacity-90">Save mapping</button>
      </div>
    </form>

    <div class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-gray-50 border-b border-gray-100 text-[10px] uppercase font-black text-gray-400 tracking-widest">
              <th class="p-5">Product</th>
              <th class="p-5">Target</th>
              <th class="p-5 text-center">Verdict</th>
              <th class="p-5">Note</th>
              <th class="p-5 text-center">Enabled</th>
              <th class="p-5 text-right">Action</th>
            </tr>
          </thead>
          <tbody class="text-xs">
            {mappings.map((m) => (
              <tr class="border-b border-gray-50 hover:bg-gray-50/50 transition-colors">
                <td class="p-5 font-bold text-brand-dark">{nameOf(m.productId)}</td>
                <td class="p-5 font-bold text-brand-dark">{nameOf(m.targetProductId)}</td>
                <td class="p-5 text-center">
                  <span class="text-[9px] font-black px-2.5 py-1 rounded uppercase tracking-widest border border-gray-200 bg-gray-50 text-gray-600">{m.verdict}</span>
                </td>
                <td class="p-5 text-gray-500 max-w-[16rem] truncate">{m.note ?? "—"}</td>
                <td class="p-5 text-center">{m.enabled ? "Yes" : "No"}</td>
                <td class="p-5 text-right">
                  <form method="POST" class="inline">
                    <input type="hidden" name="intent" value="delete" />
                    <input type="hidden" name="id" value={m.id} />
                    <button type="submit" class="text-[10px] font-black uppercase tracking-widest text-red-600 hover:text-red-800">Remove</button>
                  </form>
                </td>
              </tr>
            ))}
            {mappings.length === 0 && !loadFailed && (
              <tr><td colspan="6" class="p-12 text-center text-gray-400 italic">No compatibility mappings declared yet.</td></tr>
            )}
            {loadFailed && (
              <tr><td colspan="6" class="p-12 text-center text-red-500 italic">Could not load mappings (service unavailable or permission denied).</td></tr>
            )}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</AdminLayout>
