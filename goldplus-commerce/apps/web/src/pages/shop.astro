---
import BaseLayout from "../layouts/BaseLayout.astro";
import { apiBase } from "../lib/api";
import ProductCard from "../components/ProductCard.astro";
import Notice from "../components/Notice.astro";
import type { ApiResponse, ProductPublicDto } from "@goldplus/shared";

const categories = [
  { slug: 'all', name: 'All Categories' },
  { slug: 'power', name: 'Power Devices' },
  { slug: 'sound', name: 'Sound Devices' },
  { slug: 'storage', name: 'Storage Devices' },
  { slug: 'car', name: 'Car Accessories' }
];

const q = Astro.url.searchParams.get('q') || '';
const category = Astro.url.searchParams.get('category') || 'all';
const inStock = Astro.url.searchParams.get('inStock') === 'true';

const queryParams = new URLSearchParams();
if (q) queryParams.set('q', q);
if (category && category !== 'all') queryParams.set('category', category);
if (inStock) queryParams.set('inStock', 'true');

let products: ProductPublicDto[] = [];
let fetchError: string | null = null;

try {
  const url = `${apiBase}/products?${queryParams.toString()}`;
  const res = await fetch(url, { signal: AbortSignal.timeout(3000) });
  if (res.ok) {
    const json = await res.json() as ApiResponse<ProductPublicDto[]>;
    if (json.success) {
      products = json.data;
    } else {
      fetchError = json.error?.message || "Failed to load catalog.";
    }
  } else {
    fetchError = "Service unavailable. Please try again.";
  }
} catch (err) {
  fetchError = "Network issue. Unable to connect to the server.";
}
---

<BaseLayout title="Shop Authentic Electronics | GoldPlus" description="Browse our catalog of verified electronics engineered for durability and reliability in Uganda.">
  <div class="bg-brand-charcoal text-white py-16 border-b border-brand-borderGrey">
    <div class="container mx-auto px-4 lg:px-8">
      <h1 class="text-4xl md:text-5xl font-black tracking-tight text-brand-primary mb-4">GoldPlus Catalog</h1>
      <p class="text-brand-mutedGrey max-w-2xl text-lg">Browse rigorously tested electronic essentials. Durable, authentic, and guaranteed original.</p>
    </div>
  </div>

  <div class="container mx-auto px-4 lg:px-8 py-10">
    <div class="flex flex-col lg:flex-row gap-8">
      
      {/* Sidebar / Filters */}
      <aside class="w-full lg:w-1/4 lg:max-w-[280px]">
        <form action="/shop" method="get" class="bg-white p-6 rounded-2xl border border-brand-borderGrey sticky top-24 space-y-8">
          
          <div>
            <h2 class="font-bold text-lg mb-3 text-brand-charcoal">Search</h2>
            <div class="relative">
              <input 
                type="search" 
                name="q" 
                value={q}
                placeholder="Name or model..." 
                class="w-full pl-10 pr-4 py-2.5 bg-brand-softGrey border border-brand-borderGrey rounded-lg focus:ring-2 focus:ring-brand-primary/50 focus:border-brand-primary outline-none text-sm"
              />
              <svg class="absolute left-3 top-2.5 h-4 w-4 text-brand-mutedGrey" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
            </div>
          </div>

          <div>
            <h2 class="font-bold text-lg mb-3 text-brand-charcoal">Categories</h2>
            <ul class="space-y-1 text-sm">
              {categories.map((cat) => {
                const isActive = category === cat.slug;
                const linkParams = new URLSearchParams(queryParams);
                if (cat.slug === 'all') {
                  linkParams.delete('category');
                } else {
                  linkParams.set('category', cat.slug);
                }
                return (
                  <li>
                    <a 
                      href={`/shop?${linkParams.toString()}`} 
                      class={`block px-3 py-2 rounded-lg transition-colors font-medium ${isActive ? 'bg-brand-primary/15 text-brand-charcoal font-bold' : 'text-brand-mutedGrey hover:bg-brand-softGrey hover:text-brand-charcoal'}`}
                    >
                      {cat.name}
                    </a>
                  </li>
                );
              })}
            </ul>
            {/* Hidden category state for search input submission to preserve it */}
            {category !== 'all' && <input type="hidden" name="category" value={category} />}
          </div>

          <div class="pt-4 border-t border-brand-borderGrey">
             <label class="flex items-center gap-3 cursor-pointer group">
               <input 
                 type="checkbox" 
                 name="inStock" 
                 value="true" 
                 checked={inStock}
                 onChange="this.form.submit()"
                 class="w-4 h-4 text-brand-primary border-brand-borderGrey rounded focus:ring-brand-primary cursor-pointer"
               />
               <span class="text-sm font-medium text-brand-charcoal group-hover:text-brand-primary transition-colors">Show in-stock only</span>
             </label>
          </div>

          <button type="submit" class="w-full py-2 bg-brand-charcoal text-white font-bold rounded-lg hover:opacity-90 transition-opacity text-sm">
            Apply filters
          </button>

          {(q || category !== 'all' || inStock) && (
            <a href="/shop" class="block text-center text-xs text-brand-mutedGrey hover:text-brand-charcoal underline font-medium">
              Clear all filters
            </a>
          )}
        </form>
      </aside>

      {/* Main Content */}
      <main class="w-full lg:flex-1">
        
        <div class="flex flex-col md:flex-row md:items-center justify-between mb-6 gap-4">
          <div>
            <p class="text-brand-mutedGrey font-medium text-sm">
              {fetchError ? 'Catalog access interrupted' : `Displaying ${products.length} product${products.length === 1 ? '' : 's'}`}
            </p>
            {q && (
              <h2 class="text-brand-charcoal font-bold mt-1">
                Results for <span class="text-brand-primary">"{q}"</span>
              </h2>
            )}
          </div>
        </div>

        {fetchError ? (
          <div class="mb-8">
            <Notice kind="warning" title="Product service currently constrained" message={fetchError} />
          </div>
        ) : products.length > 0 ? (
          <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-6">
            {products.map(p => (
              <ProductCard product={p} />
            ))}
          </div>
        ) : (
          <div class="text-center py-20 bg-brand-softGrey rounded-2xl border border-brand-borderGrey">
            <div class="max-w-md mx-auto">
              <svg class="w-16 h-16 mx-auto text-brand-mutedGrey/40 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path></svg>
              <h3 class="text-xl font-bold text-brand-charcoal mb-2">No matching items found</h3>
              <p class="text-brand-mutedGrey text-sm mb-6">We found no published records matching your criteria. Try adjusting filters or browse all products.</p>
              <a href="/shop" class="inline-block px-6 py-2.5 bg-brand-charcoal text-white rounded-lg font-bold hover:opacity-90 transition-opacity">View entire collection</a>
            </div>
          </div>
        )}
      </main>

    </div>
  </div>
</BaseLayout>


