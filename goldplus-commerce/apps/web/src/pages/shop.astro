---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import Notice from '../components/Notice.astro';
import { apiBase } from '../lib/api';
import { LOCAL_SEED_PRODUCTS, getCleanCatalog } from '../lib/catalog/catalog';
import {
  DISCOVERY_TAXONOMY,
  categoryNameForSlug,
  dedupeProductsById,
  filterDiscoveryProducts,
  getProductSubcategory,
  isApprovedDiscoveryProduct,
  normalizeCategoryParam,
  normalizeSearchParam,
  normalizeSortParam,
  normalizeSubcategoryParam,
  sortDiscoveryProducts,
  subcategoryNameForSlug,
} from '../lib/product-discovery';
import type { ApiResponse, ProductPublicDto } from '@goldplus/shared';

const search = normalizeSearchParam(Astro.url.searchParams.get('search') ?? Astro.url.searchParams.get('q'));
const category = normalizeCategoryParam(Astro.url.searchParams.get('category'));
const subcategory = normalizeSubcategoryParam(Astro.url.searchParams.get('subcategory'), category);
const sort = normalizeSortParam(Astro.url.searchParams.get('sort'));
const selectedCategory = DISCOVERY_TAXONOMY.find((item) => item.slug === category);

function shopUrl(overrides: Partial<{ search: string; category: string; subcategory: string; sort: string }> = {}) {
  const state = { search, category, subcategory, sort, ...overrides };
  const params = new URLSearchParams();
  if (state.search) params.set('search', normalizeSearchParam(state.search));
  if (state.category) params.set('category', state.category);
  if (state.subcategory) params.set('subcategory', state.subcategory);
  if (state.sort && state.sort !== 'default') params.set('sort', state.sort);
  const query = params.toString();
  return query ? `/shop?${query}` : '/shop';
}

let rawProducts: ProductPublicDto[] = [];
let catalogueNotice = '';
try {
  const response = await fetch(`${apiBase}/products`, { signal: AbortSignal.timeout(3000) });
  if (response.ok) {
    const body = await response.json() as ApiResponse<ProductPublicDto[]>;
    if (body.success && Array.isArray(body.data)) rawProducts = body.data;
  }
} catch {
  // The existing listed-product fallback below keeps browsing available without inventing new data.
}

if (rawProducts.length === 0) {
  rawProducts = LOCAL_SEED_PRODUCTS;
  catalogueNotice = 'Live catalogue updates are temporarily unavailable. Browse the currently listed products and confirm availability on the product page.';
}

const availableProducts = dedupeProductsById(getCleanCatalog(rawProducts)).filter(isApprovedDiscoveryProduct);
const filteredProducts = filterDiscoveryProducts(availableProducts, { search, category, subcategory });
const products = sortDiscoveryProducts(filteredProducts, sort);
const browseFallback = products.length === 0 ? availableProducts.slice(0, 6) : [];

// Slice 4: anonymous search telemetry — query + result count only, no identifiers.
if (search) {
  await fetch(`${apiBase}/products/search-events`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ query: search, resultCount: filteredProducts.length, rankedProductIds: products.map((product) => product.id) }),
    signal: AbortSignal.timeout(500),
  }).catch(() => {});
}
const hasFilters = Boolean(search || category || subcategory || sort !== 'default');
const categoryLabel = categoryNameForSlug(category);
const subcategoryLabel = subcategoryNameForSlug(subcategory);

const activeFilters = [
  search ? { label: `Search: “${search}”`, href: shopUrl({ search: '' }) } : null,
  category ? { label: categoryLabel, href: shopUrl({ category: '', subcategory: '' }) } : null,
  subcategory ? { label: subcategoryLabel, href: shopUrl({ subcategory: '' }) } : null,
  sort !== 'default' ? { label: 'Custom sort', href: shopUrl({ sort: 'default' }) } : null,
].filter((item): item is { label: string; href: string } => Boolean(item));
---

<BaseLayout title="Shop products | GoldPlus" description="Search and browse GoldPlus products by category and subcategory.">
  <header class="border-b border-slate-800 bg-slate-950 py-10 text-white sm:py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl font-black tracking-tight sm:text-4xl">Find a GoldPlus product</h1>
      <p class="mt-3 max-w-2xl text-sm leading-relaxed text-slate-300 sm:text-base">Search the current catalogue or browse the approved product categories.</p>
    </div>
  </header>

  <main class="mx-auto w-full min-w-0 max-w-7xl overflow-hidden px-4 py-7 sm:px-6 sm:py-10 lg:px-8">
    {catalogueNotice && <Notice kind="info" title="Catalogue notice" message={catalogueNotice} />}

    <form action="/shop" method="get" role="search" class="mt-6 rounded-2xl border border-slate-200 bg-white p-4 shadow-xs sm:p-5">
      <label for="shop-search" class="mb-2 block text-sm font-bold text-slate-900">Search products</label>
      <div class="flex flex-col gap-3 sm:flex-row">
        <input
          id="shop-search"
          name="search"
          type="search"
          value={search}
          maxlength="100"
          placeholder="Search by product name, category, or model"
          list="shop-suggest"
          autocomplete="off"
          class="min-w-0 flex-1 rounded-xl border border-slate-300 px-4 py-3 text-base outline-none focus:border-brand-primary focus:ring-4 focus:ring-brand-primary/20"
        />
        <datalist id="shop-suggest"></datalist>
        {category && <input type="hidden" name="category" value={category} />}
        {subcategory && <input type="hidden" name="subcategory" value={subcategory} />}
        <button type="submit" class="rounded-full bg-slate-950 px-6 py-3 text-sm font-bold text-white hover:bg-brand-primary hover:text-slate-950 focus-visible:ring-4 focus-visible:ring-brand-primary/30">Search</button>
      </div>
    </form>

    <section aria-labelledby="category-filters-heading" class="mt-7">
      <div class="flex items-center justify-between gap-4">
        <h2 id="category-filters-heading" class="text-base font-black text-slate-900">Browse categories</h2>
        {hasFilters && <a href="/shop" class="text-sm font-bold text-slate-700 underline hover:text-slate-950">Clear all filters</a>}
      </div>
      <div class="-mx-4 mt-3 flex gap-2 overflow-x-auto px-4 pb-2 sm:mx-0 sm:flex-wrap sm:px-0" aria-label="Product categories">
        <a href={shopUrl({ category: '', subcategory: '' })} aria-current={!category ? 'page' : undefined} class={`shrink-0 rounded-full border px-4 py-2 text-sm font-bold ${!category ? 'border-brand-primary bg-brand-primary text-slate-950' : 'border-slate-300 bg-white text-slate-700'}`}>All products</a>
        {DISCOVERY_TAXONOMY.map((item) => (
          <a href={shopUrl({ category: item.slug, subcategory: '' })} aria-current={category === item.slug ? 'page' : undefined} aria-label={`Filter by ${item.name}`} class={`shrink-0 rounded-full border px-4 py-2 text-sm font-bold ${category === item.slug ? 'border-brand-primary bg-brand-primary text-slate-950' : 'border-slate-300 bg-white text-slate-700'}`}>{item.name}</a>
        ))}
      </div>

      {selectedCategory && (
        <div class="mt-4 rounded-xl bg-slate-50 p-4" aria-labelledby="subcategory-filters-heading">
          <h3 id="subcategory-filters-heading" class="text-sm font-bold text-slate-900">{selectedCategory.name} subcategories</h3>
          <div class="mt-3 flex flex-wrap gap-2">
            {selectedCategory.subcategories.map((item) => (
              <a href={shopUrl({ subcategory: item.slug })} aria-current={subcategory === item.slug ? 'page' : undefined} aria-label={`Filter by ${item.name}`} class={`rounded-lg border px-3 py-2 text-sm font-semibold ${subcategory === item.slug ? 'border-slate-950 bg-slate-950 text-white' : 'border-slate-300 bg-white text-slate-700'}`}>{item.name}</a>
            ))}
          </div>
        </div>
      )}
    </section>

    {activeFilters.length > 0 && (
      <section aria-label="Active filters" class="mt-5 flex flex-wrap items-center gap-2">
        <span class="text-xs font-bold uppercase tracking-wide text-slate-500">Active filters</span>
        {activeFilters.map((item) => <a href={item.href} aria-label={`Remove filter ${item.label}`} class="rounded-full border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700">{item.label} <span aria-hidden="true">×</span></a>)}
      </section>
    )}

    <div class="mt-7 flex flex-col gap-3 border-b border-slate-200 pb-5 sm:flex-row sm:items-center sm:justify-between">
      <p aria-live="polite" class="text-sm font-semibold text-slate-700">{products.length} matching product{products.length === 1 ? '' : 's'}</p>
      <label class="flex items-center gap-2 text-sm font-bold text-slate-700">
        Sort products
        <select onchange="window.location.href = this.value" class="rounded-lg border border-slate-300 bg-white px-3 py-2" aria-label="Sort products">
          <option value={shopUrl({ sort: 'default' })} selected={sort === 'default'}>Default order</option>
          <option value={shopUrl({ sort: 'price-low-high' })} selected={sort === 'price-low-high'}>Price: low to high</option>
          <option value={shopUrl({ sort: 'price-high-low' })} selected={sort === 'price-high-low'}>Price: high to low</option>
          <option value={shopUrl({ sort: 'name-a-z' })} selected={sort === 'name-a-z'}>Name: A–Z</option>
        </select>
      </label>
    </div>

    {products.length > 0 ? (
      <section aria-label="Product results" class="mt-7 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        {products.map((product, index) => <ProductCard product={product} subcategory={subcategoryNameForSlug(getProductSubcategory(product))} searchQuery={search} searchRank={index + 1} />)}
      </section>
    ) : (
      <section class="mt-7 rounded-2xl border border-slate-200 bg-white p-6 text-center sm:p-10" aria-labelledby="no-results-heading">
        <h2 id="no-results-heading" class="text-xl font-black text-slate-900">No matching products yet.</h2>
        <p class="mx-auto mt-2 max-w-xl text-sm leading-relaxed text-slate-600">
          {search ? <>No products matched “{search}”. </> : null}
          {subcategoryLabel || categoryLabel ? <>The selected {subcategoryLabel || categoryLabel} filter has no matching products. </> : null}
          Try another search or browse the categories.
        </p>
        <div class="mt-5 flex flex-col justify-center gap-3 sm:flex-row">
          <a href="/shop" class="rounded-full bg-slate-950 px-6 py-3 text-sm font-bold text-white hover:bg-brand-primary hover:text-slate-950">Reset filters</a>
          <a href="#browse-available-products" class="rounded-full border border-slate-300 px-6 py-3 text-sm font-bold text-slate-800">Browse available products</a>
          {search && (
            <a href={`/quote-request?requested=${encodeURIComponent(search)}`} class="rounded-full border border-brand-primary bg-brand-primary/10 px-6 py-3 text-sm font-bold text-slate-900 hover:bg-brand-primary hover:text-slate-950">Request this product</a>
          )}
          {search && (
            <a href="/support" class="rounded-full border border-slate-300 px-6 py-3 text-sm font-bold text-slate-800">Ask support</a>
          )}
        </div>
      </section>
    )}

    {browseFallback.length > 0 && (
      <section id="browse-available-products" class="mt-10" aria-labelledby="browse-available-heading">
        <h2 id="browse-available-heading" class="text-xl font-black text-slate-900">Browse available products</h2>
        <p class="mt-1 text-sm text-slate-600">These are currently listed products, not personalised recommendations.</p>
        <div class="mt-5 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {browseFallback.map((product) => <ProductCard product={product} subcategory={subcategoryNameForSlug(getProductSubcategory(product))} />)}
        </div>
      </section>
    )}
  </main>

  <script is:inline define:vars={{ apiBase }}>
    // Slice 4: progressive autocomplete. The form works without JavaScript;
    // this only fills the datalist with catalogue names on capable browsers.
    (function () {
      var input = document.getElementById('shop-search');
      var list = document.getElementById('shop-suggest');
      if (!input || !list || !window.fetch) return;
      var timer = null;
      input.addEventListener('input', function () {
        if (timer) clearTimeout(timer);
        var q = input.value.trim();
        if (q.length < 2) { list.innerHTML = ''; return; }
        timer = setTimeout(function () {
          fetch(apiBase + '/products/suggest?q=' + encodeURIComponent(q))
            .then(function (r) { return r.json(); })
            .then(function (body) {
              if (!body || !body.success || !Array.isArray(body.data)) return;
              list.innerHTML = '';
              body.data.forEach(function (item) {
                var opt = document.createElement('option');
                opt.value = item.name;
                list.appendChild(opt);
              });
            })
            .catch(function () {});
        }, 250);
      });
    })();
  </script>
</BaseLayout>
