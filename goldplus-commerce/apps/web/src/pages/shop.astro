---
import BaseLayout from "../layouts/BaseLayout.astro";
import { apiBase } from "../lib/api";
import ProductCard from "../components/ProductCard.astro";
import Notice from "../components/Notice.astro";
import { 
  LOCAL_SEED_PRODUCTS, 
  normalizeProductCategory, 
  matchesQuery, 
  sortProducts, 
  CATEGORY_SLUG_TO_NAME, 
  CATEGORY_NAME_TO_SLUG,
  getCleanCatalog
} from "../lib/catalog/catalog";
import type { ApiResponse, ProductPublicDto } from "@goldplus/shared";
import CategoryPopularRail from "../components/recommendations/CategoryPopularRail.astro";


// Approved categories taxonomy
const categories = [
  { slug: 'all', name: 'All Products' },
  { slug: 'power', name: 'Power Devices' },
  { slug: 'sound', name: 'Sound Devices' },
  { slug: 'storage', name: 'Storage Devices' },
  { slug: 'car', name: 'Car Accessories' },
  { slug: 'pc', name: 'PC Accessories' }
];

const q = Astro.url.searchParams.get('q') || '';
const category = Astro.url.searchParams.get('category') || 'all';
const sort = Astro.url.searchParams.get('sort') || 'featured';
const inStock = Astro.url.searchParams.get('inStock') === 'true';
// Helper function to build dynamic filter URLs preserving parameters
function getFilterUrl(overrides: { q?: string; category?: string; sort?: string; inStock?: string }) {
  const params = new URLSearchParams();
  if (q) params.set('q', q);
  if (category && category !== 'all') params.set('category', category);
  if (sort && sort !== 'featured') params.set('sort', sort);
  if (inStock) params.set('inStock', 'true');

  // If we are overriding/switching categories, clear the search term (unless a new search term is also in overrides)
  if ('category' in overrides && !('q' in overrides)) {
    params.delete('q');
  }

  for (const [key, value] of Object.entries(overrides)) {
    if (value === '' || value === 'all' || value === 'featured' || value === 'false') {
      params.delete(key);
    } else {
      params.set(key, value);
    }
  }

  const queryStr = params.toString();
  return queryStr ? `/shop?${queryStr}` : '/shop';
}
// Active filter list generation
const activeFilters = [];
if (category !== 'all') {
  activeFilters.push({
    label: CATEGORY_SLUG_TO_NAME[category] ?? category,
    removeUrl: getFilterUrl({ category: 'all' })
  });
}
if (q) {
  activeFilters.push({
    label: `Search: "${q}"`,
    removeUrl: getFilterUrl({ q: '' })
  });
}
if (inStock) {
  activeFilters.push({
    label: 'In Stock Only',
    removeUrl: getFilterUrl({ inStock: 'false' })
  });
}
if (sort !== 'featured') {
  const sortLabels: Record<string, string> = {
    'price_low_high': 'Price: Low to High',
    'price_high_low': 'Price: High to Low',
    'name_az': 'Name: A-Z'
  };
  activeFilters.push({
    label: sortLabels[sort] ?? sort,
    removeUrl: getFilterUrl({ sort: 'featured' })
  });
}

let rawProducts: ProductPublicDto[] = [];
let isSampleData = false;
let fetchError: string | null = null;

// Fetch all available products with robust error handling and resilient local static seed fallback
try {
  const res = await fetch(`${apiBase}/products`, { signal: AbortSignal.timeout(3000) });
  if (res.ok) {
    const json = await res.json() as ApiResponse<ProductPublicDto[]>;
    if (json.success && Array.isArray(json.data)) {
      rawProducts = json.data;
    } else {
      rawProducts = LOCAL_SEED_PRODUCTS;
      isSampleData = true;
      fetchError = "Unrecognized API response format. Safe offline mode active.";
    }
  } else {
    rawProducts = LOCAL_SEED_PRODUCTS;
    isSampleData = true;
    fetchError = `Service returned status ${res.status}. Safe offline mode active.`;
  }
} catch (err) {
  rawProducts = LOCAL_SEED_PRODUCTS;
  isSampleData = true;
  fetchError = "API is currently offline or unreachable. Safe offline mode active.";
}

// 1. Clean the catalog to remove stale API products and merge/use LOCAL_SEED_PRODUCTS
let normalizedProducts = getCleanCatalog(rawProducts);

// 2. Programmatically filter the catalog using precise logic
const filteredProducts = normalizedProducts.filter(product => {
  // Category filter mapping
  if (category !== 'all') {
    const targetName = CATEGORY_SLUG_TO_NAME[category];
    if (product.categoryName !== targetName) return false;
  }

  // High-relevance query filter to prevent false empty states
  if (q && !matchesQuery(product, q)) {
    return false;
  }

  // Stock status filter
  if (inStock) {
    const isAvailable = product.availability.kind === 'in_stock' || product.availability.kind === 'pre_order';
    if (!isAvailable) return false;
  }

  return true;
});

// 3. Apply stable sorting algorithm
const sortedProducts = sortProducts(filteredProducts, sort);

const seoTitles: Record<string, string> = {
  all: "Shop Verified Electronics | GoldPlus",
  power: "GoldPlus Power Devices | Chargers & Power Banks",
  storage: "GoldPlus Storage | USB Flash Drives & Memory Cards",
  pc: "GoldPlus PC Accessories | USB Mouse & USB Sound Card",
  sound: "GoldPlus Sound | Wireless Earbuds & Everyday Audio",
  car: "GoldPlus Car Accessories | Car Chargers & Mobile Power"
};

const seoDescriptions: Record<string, string> = {
  all: "Browse our catalog of authentic, rigorously tested electronics and accessories in Uganda. Durable and fully guaranteed.",
  storage: "Shop GoldPlus storage accessories including USB flash drives and memory cards for everyday files, photos, music and compatible devices.",
  pc: "Shop GoldPlus PC accessories for everyday computer use, including USB mouse and USB sound card options for work, study, music and audio setups.",
  sound: "Shop GoldPlus wireless earbuds and sound accessories for music, calls, videos, travel and everyday listening.",
  car: "Shop GoldPlus car accessories including car chargers for phones and everyday devices while you travel, commute or work on the move."
};

const heroHeadlines: Record<string, string> = {
  all: "GoldPlus Catalog",
  power: "Fast Charging, Made Simple",
  storage: "Storage that keeps life moving.",
  pc: "PC accessories for everyday work.",
  sound: "Sound for everyday listening.",
  car: "Power for the road."
};

const heroSubheadlines: Record<string, string> = {
  all: "Browse rigorously tested electronic essentials engineered for extreme durability. Authentic, original, and backed by a comprehensive warranty.",
  power: "From compact everyday adapters to high-output PD and PPS chargers, GoldPlus gives you dependable charging for the devices you use every day.",
  storage: "GoldPlus storage devices help you carry files, music, photos and everyday data with simple, reliable options for phones, laptops and digital work.",
  pc: "GoldPlus PC accessories make daily computer use easier, from simple navigation to practical audio connectivity for creators and everyday users.",
  sound: "GoldPlus sound devices are made for music, calls, videos and daily listening, with simple wireless options for work, travel and everyday life.",
  car: "GoldPlus car accessories help keep your devices powered while you move, with simple charging options for everyday journeys."
};

const currentSeoTitle = seoTitles[category] || seoTitles.all;
const currentSeoDescription = seoDescriptions[category] || seoDescriptions.all;
const currentHeroHeadline = heroHeadlines[category] || heroHeadlines.all;
const currentHeroSubheadline = heroSubheadlines[category] || heroSubheadlines.all;
---

<BaseLayout 
  title={currentSeoTitle}
  description={currentSeoDescription}
>
  <!-- Sleek Premium Dark Sub-Header Banner -->
  <div class="bg-gradient-to-r from-slate-900 via-slate-950 to-slate-900 text-white py-12 border-b border-slate-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <h1 class="text-3xl sm:text-4xl font-black tracking-tight text-white mb-3">
          {category === 'all' ? (
            <Fragment>GoldPlus <span class="text-brand-primary">Catalog</span></Fragment>
          ) : (
            currentHeroHeadline
          )}
        </h1>
        <p class="text-slate-400 text-sm sm:text-base leading-relaxed font-medium">
          {currentHeroSubheadline}
        </p>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
    <!-- Offline Resilient Status Alert -->
    {isSampleData && fetchError && (
      <div class="mb-8">
        <Notice kind="info" title="Offline Resilient Catalog Loaded" message="The shop is currently using cached product data. All filter, search, and sorting functions remain fully operational." />
      </div>
    )}

    <div class="flex flex-col lg:flex-row gap-8 lg:gap-12">
      <!-- SIDEBAR FILTERS (Desktop Only, hidden on mobile/tablet) -->
      <aside class="hidden lg:block w-64 flex-shrink-0">
        <div class="sticky top-24 space-y-8">
          <form action="/shop" method="get" class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-xs space-y-6">
            <!-- Search Widget -->
            <div>
              <label for="search-input" class="block font-bold text-xs text-gray-900 mb-2 uppercase tracking-wider">Search Catalog</label>
              <div class="relative">
                <input 
                  type="search" 
                  id="search-input"
                  name="q" 
                  value={q}
                  placeholder="Name or model..." 
                  class="w-full pl-9 pr-4 py-2 bg-slate-50 border border-slate-200 rounded-lg text-xs font-semibold transition-all duration-300"
                />
                <svg class="absolute left-3 top-3 h-3.5 w-3.5 text-slate-400" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                </svg>
              </div>
            </div>

            <!-- Categories Widget -->
            <div>
              <h2 class="font-bold text-xs text-gray-900 mb-2 uppercase tracking-wider">Categories</h2>
              <ul class="space-y-1">
                {categories.map((cat) => {
                  const isActive = category === cat.slug;
                  return (
                    <li>
                      <a 
                        href={getFilterUrl({ category: cat.slug })} 
                        class={`flex items-center justify-between px-3 py-2 rounded-lg transition-all duration-300 text-xs font-bold ${
                          isActive 
                            ? 'bg-slate-100/70 text-gray-900 border-l-4 border-brand-primary pl-2.5' 
                            : 'text-slate-500 hover:bg-slate-50 hover:text-gray-900'
                        }`}
                      >
                        <span>{cat.name}</span>
                      </a>
                    </li>
                  );
                })}
              </ul>
              {category !== 'all' && <input type="hidden" name="category" value={category} />}
            </div>

            <!-- Stock Availability Widget -->
            <div class="pt-4 border-t border-slate-100">
              <label class="flex items-center gap-3 cursor-pointer group select-none">
                <input 
                  type="checkbox" 
                  name="inStock" 
                  value="true" 
                  checked={inStock}
                  onchange="this.form.submit()"
                  class="w-4 h-4 text-brand-primary border-slate-200 rounded focus:ring-brand-primary cursor-pointer transition-colors"
                />
                <span class="text-xs font-bold text-gray-800 group-hover:text-brand-primary transition-colors">In-stock products only</span>
              </label>
            </div>

            <!-- Submit Buttons -->
            <div class="space-y-2 pt-2">
              <button type="submit" class="w-full py-2.5 bg-gray-950 text-white text-xs font-bold uppercase tracking-wider rounded-full hover:bg-brand-primary hover:text-gray-950 transition-all shadow-xs active:scale-[0.98] cursor-pointer outline-none">
                Apply Filters
              </button>
              {(q || category !== 'all' || inStock) && (
                <a href="/shop" class="block text-center py-2 bg-slate-50 text-slate-500 hover:text-gray-900 text-xs font-bold rounded-full transition-colors border border-slate-200/60">
                  Clear Filters
                </a>
              )}
            </div>
          </form>
        </div>
      </aside>

      <!-- MAIN CATALOG LISTINGS AREA -->
      <main class="flex-1 min-w-0">
        <!-- Search & Category & Sort Controls Row -->
        <div class="bg-white p-4 rounded-2xl border border-slate-200/80 shadow-xs mb-6 flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div class="flex items-center gap-3">
            <div class="bg-slate-50 px-3.5 py-1.5 rounded-full border border-slate-100 text-xs font-bold text-slate-755">
              {sortedProducts.length} Product{sortedProducts.length === 1 ? '' : 's'} found
            </div>
            {q && (
              <span class="text-xs text-slate-500 font-medium">
                for <strong class="text-gray-900">"{q}"</strong>
              </span>
            )}
          </div>

          <!-- Sort Dropdown Widget -->
          <div class="flex items-center gap-2">
            <label for="sort-select" class="text-xs font-bold text-slate-500">Sort By:</label>
            <select 
              id="sort-select"
              name="sort"
              onchange="window.location.href = this.value"
              class="pl-3 pr-8 py-1.5 bg-slate-50 border border-slate-200 rounded-lg text-xs font-bold text-gray-850 outline-none cursor-pointer transition-all duration-300 shadow-xs"
            >
              <option value={getFilterUrl({ sort: 'featured' })} selected={sort === 'featured'}>Recommended</option>
              <option value={getFilterUrl({ sort: 'price_low_high' })} selected={sort === 'price_low_high'}>Price: Low to High</option>
              <option value={getFilterUrl({ sort: 'price_high_low' })} selected={sort === 'price_high_low'}>Price: High to Low</option>
              <option value={getFilterUrl({ sort: 'name_az' })} selected={sort === 'name_az'}>Name: A-Z</option>
            </select>
          </div>
        </div>

        <!-- MOBILE CAPSULE CATEGORY BAR (Visible on mobile/tablet under lg) -->
        <div class="lg:hidden mb-6 overflow-x-auto no-scrollbar -mx-4 px-4 flex items-center gap-1.5">
          {categories.map((cat) => {
            const isActive = category === cat.slug;
            // Short labels
            const shortName = cat.slug === 'all' ? 'All' 
              : cat.slug === 'power' ? 'Power' 
              : cat.slug === 'sound' ? 'Sound' 
              : cat.slug === 'storage' ? 'Storage' 
              : cat.slug === 'car' ? 'Car' 
              : 'PC';

            return (
              <a 
                href={getFilterUrl({ category: cat.slug })}
                class={`px-4 py-2 rounded-full text-xs font-bold flex-shrink-0 transition-all duration-300 border ${
                  isActive 
                    ? 'bg-brand-primary border-brand-primary text-gray-950 shadow-xs' 
                    : 'bg-white border-slate-200 text-slate-500 hover:text-gray-900'
                }`}
              >
                {shortName}
              </a>
            );
          })}
        </div>

        {category !== 'all' && !q && (
          <div class="mb-10 pb-10 border-b border-slate-100">
            <CategoryPopularRail categorySlug={category} />
          </div>
        )}

        <!-- ACTIVE FILTER CHIPS TRACK (SSR & CSR Interactive Track) -->
        {activeFilters.length > 0 && (
          <div class="flex flex-wrap items-center gap-2 mb-6">
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mr-1">Active:</span>
            {activeFilters.map((filter) => (
              <a 
                href={filter.removeUrl}
                class="group flex items-center gap-1.5 pl-3 pr-2 py-0.5 bg-slate-50 border border-slate-200 rounded-full text-xs font-semibold text-slate-700 hover:border-red-400 hover:text-red-600 transition-all duration-350"
                title={`Remove filter: ${filter.label}`}
              >
                <span>{filter.label}</span>
                <span class="w-3.5 h-3.5 bg-slate-200 rounded-full flex items-center justify-center text-[10px] font-black group-hover:bg-red-50 transition-colors">
                  &times;
                </span>
              </a>
            ))}
            <a 
              href="/shop" 
              class="text-xs font-black text-brand-primary hover:text-gray-900 transition-colors underline pl-1"
            >
              Clear All
            </a>
          </div>
        )}

        <!-- GRID VS EMPTY STATE RESCUE -->
        {sortedProducts.length > 0 ? (
          <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-6">
            {sortedProducts.map((p) => (
              <div class="h-full">
                <ProductCard product={p} />
              </div>
            ))}
          </div>
        ) : (
          <!-- Customer-Grade Resilient Empty State -->
          <div class="text-center py-16 px-6 bg-white rounded-2xl border border-slate-200/80 shadow-xs max-w-2xl mx-auto">
            <div class="w-14 h-14 bg-slate-50 rounded-full flex items-center justify-center mx-auto mb-4 border border-slate-100 text-slate-400">
              <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
              </svg>
            </div>
            <h3 class="text-lg font-bold text-gray-900 mb-2">No matching products found</h3>
            <p class="text-slate-500 text-sm max-w-md mx-auto mb-6 leading-relaxed">
              We couldn't find any verified GoldPlus products matching your current query. Try adjusting your search filters or browse other popular categories.
            </p>

            <!-- Shortcuts Suggestions -->
            <div class="mb-8">
              <span class="block text-[10px] font-black text-slate-400 uppercase tracking-widest mb-3">Popular Searches</span>
              <div class="flex flex-wrap justify-center gap-2 max-w-sm mx-auto">
                <a href="/shop?q=charger" class="px-3.5 py-1.5 bg-slate-50 border border-slate-200 rounded-lg text-xs font-bold text-slate-700 hover:bg-brand-primary hover:border-brand-primary transition-all">GP Charger</a>
                <a href="/shop?q=earbuds" class="px-3.5 py-1.5 bg-slate-50 border border-slate-200 rounded-lg text-xs font-bold text-slate-700 hover:bg-brand-primary hover:border-brand-primary transition-all">Earbuds</a>
                <a href="/shop?q=flash" class="px-3.5 py-1.5 bg-slate-50 border border-slate-200 rounded-lg text-xs font-bold text-slate-700 hover:bg-brand-primary hover:border-brand-primary transition-all">Flash Drives</a>
                <a href="/shop?q=mount" class="px-3.5 py-1.5 bg-slate-50 border border-slate-200 rounded-lg text-xs font-bold text-slate-700 hover:bg-brand-primary hover:border-brand-primary transition-all">Car Mount</a>
              </div>
            </div>

            <!-- Clear Action -->
            <a 
              href="/shop" 
              class="inline-flex items-center px-6 py-2.5 bg-gray-950 text-white hover:bg-brand-primary hover:text-gray-950 text-xs font-bold uppercase tracking-wider rounded-full transition-all duration-300 shadow-xs active:scale-[0.98]"
            >
              Reset Filters & View All
            </a>
          </div>
        )}
      </main>
    </div>
  </div>

  <script define:vars={{ category, q }}>
    try {
      if (typeof window !== 'undefined' && window.localStorage) {
        if (category && category !== 'all') {
          window.localStorage.setItem('goldplus_last_category', JSON.stringify({
            value: category,
            timestamp: Date.now()
          }));
        }
        if (q && q.trim()) {
          const cleanQuery = q.trim().substring(0, 100);
          window.localStorage.setItem('goldplus_last_search', JSON.stringify({
            value: cleanQuery,
            timestamp: Date.now()
          }));
        }
      }
    } catch (e) {
      // Safe boundary
    }
  </script>

  <script>
    import { track, captureClickIdsServerSide } from '../lib/telemetry';

    document.addEventListener('DOMContentLoaded', () => {
      // Persist any ad click IDs from URL — critical for attribution
      captureClickIdsServerSide();

      // Collect product items rendered on this page for view_item_list
      const cards = Array.from(
        document.querySelectorAll<HTMLElement>('[data-product-id]')
      );
      if (cards.length === 0) return;

      const items = cards.map((el, idx) => ({
        item_id:        el.dataset.productId   ?? '',
        item_name:      el.dataset.productName ?? '',
        price:          Number(el.dataset.productPrice ?? '0') || undefined,
        item_category:  el.dataset.productCategory ?? undefined,
        item_brand:     'GoldPlus',
        index:          idx,
      }));

      // GA4 view_item_list — fires once per page with all visible products
      const listId   = `shop_${document.querySelector('[data-category]')?.getAttribute('data-category') ?? 'all'}`;
      const listName = document.title;

      track('view_item_list', {
        ecommerce: { items },
        recommendation_context: {
          item_list_id:   listId,
          item_list_name: listName,
        },
      });
    });
  </script>
</BaseLayout>
