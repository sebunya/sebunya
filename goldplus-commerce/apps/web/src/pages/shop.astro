---
import BaseLayout from "../layouts/BaseLayout.astro";

const categories = [
  { slug: 'all', name: 'All Categories' },
  { slug: 'power', name: 'Power Devices' },
  { slug: 'sound', name: 'Sound Devices' },
  { slug: 'storage', name: 'Storage Devices' },
  { slug: 'car', name: 'Car Accessories' }
];

const mockProducts = [
  {
    id: "generic-fast-charger",
    name: "Generic Fast Charger",
    category: "Power",
    price: "UGX 50,000",
    inStock: true,
    model: "Missing. Requires admin review.",
    hasImage: false,
  },
  {
    id: "wireless-earbuds",
    name: "Wireless Earbuds",
    category: "Sound",
    price: "UGX 80,000",
    inStock: true,
    model: "Missing. Requires admin review.",
    hasImage: false,
  },
  {
    id: "usb-c-cable",
    name: "Braided USB-C Cable 2M",
    category: "Power",
    price: "UGX 25,000",
    inStock: false,
    model: "GP-CBL-001",
    hasImage: false,
  }
];
---

<BaseLayout title="Shop All Products - GoldPlus">
  <div class="bg-brand-dark text-white py-12 border-b border-gray-800">
    <div class="container mx-auto px-4 lg:px-8">
      <h1 class="text-3xl md:text-5xl font-black tracking-tight text-brand-gold mb-4">The Catalog</h1>
      <p class="text-gray-300 max-w-2xl text-lg">Browse our full range of rigorously tested electronics. Authentic, durable, and designed for reliability.</p>
    </div>
  </div>

  <div class="container mx-auto px-4 lg:px-8 py-8">
    <div class="flex flex-col lg:flex-row gap-8">
      
      {/* Sidebar / Filters */}
      <aside class="w-full lg:w-1/4">
        <div class="bg-white p-6 rounded-2xl border border-gray-200 sticky top-24">
          <h2 class="font-bold text-xl mb-4 text-brand-dark">Search</h2>
          <div class="mb-8">
            <label for="search" class="sr-only">Search products</label>
            <div class="relative">
              <input type="search" id="search" placeholder="Search by name or model..." class="w-full pl-10 pr-4 py-3 bg-gray-50 border border-gray-200 rounded-lg focus:ring-2 focus:ring-brand-green focus:border-brand-green outline-none transition-all">
              <svg class="absolute left-3 top-3.5 h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
            </div>
          </div>

          <h2 class="font-bold text-xl mb-4 text-brand-dark">Categories</h2>
          <ul class="space-y-2 mb-8">
            {categories.map((cat, i) => (
              <li>
                <a href={`/shop?category=${cat.slug}`} class={`block px-3 py-2 rounded-lg transition-colors ${i === 0 ? 'bg-brand-green/10 text-brand-green font-bold' : 'text-gray-600 hover:bg-gray-50'}`}>
                  {cat.name}
                </a>
              </li>
            ))}
          </ul>
          
          <div class="bg-gray-50 p-4 rounded-xl border border-gray-200">
            <h3 class="font-bold text-brand-dark mb-2">Need Assistance?</h3>
            <p class="text-sm text-gray-600 mb-4">Our team is ready to help you find the right product.</p>
            <a href="/support" class="block w-full text-center bg-brand-green text-white py-2 rounded font-bold hover:bg-green-700 transition-colors">WhatsApp Support</a>
          </div>
        </div>
      </aside>

      {/* Main Content */}
      <main class="w-full lg:w-3/4">
        <div class="flex items-center justify-between mb-6 pb-4 border-b border-gray-200">
          <p class="text-gray-600">Showing <span class="font-bold text-brand-dark">{mockProducts.length}</span> products</p>
          <div class="flex items-center gap-2">
            <a href="/compare" class="text-sm font-bold text-brand-dark border border-gray-300 px-3 py-1.5 rounded-lg hover:bg-gray-50 transition-colors">Compare (0)</a>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {mockProducts.map(p => (
            <article class="group flex flex-col h-full border border-gray-200 rounded-2xl p-4 hover:border-brand-gold hover:shadow-lg transition-all bg-white">
              <div class="relative mb-4">
                <a href={`/products/${p.id}`} class="block aspect-square bg-gray-50 rounded-xl overflow-hidden relative outline-none focus-visible:ring-4 focus-visible:ring-brand-gold">
                  <div class="absolute inset-0 flex items-center justify-center text-gray-400 font-medium text-sm">
                    {p.hasImage ? 'Image' : 'Missing. Requires admin review.'}
                  </div>
                </a>
                <div class="absolute top-2 left-2">
                   <span class={`text-xs font-bold px-2 py-1 rounded uppercase tracking-wider ${p.inStock ? 'bg-brand-dark text-white' : 'bg-red-100 text-red-800'}`}>
                     {p.inStock ? 'In Stock' : 'Out of Stock'}
                   </span>
                </div>
                <button class="absolute top-2 right-2 p-2 bg-white/80 backdrop-blur rounded-full text-gray-400 hover:text-brand-dark shadow-sm transition-colors" title="Add to comparison">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path></svg>
                </button>
              </div>
              
              <div class="flex flex-col flex-grow">
                <p class="text-xs font-bold text-brand-green uppercase tracking-widest mb-1">{p.category}</p>
                <h2 class="text-lg font-bold text-brand-dark leading-tight mb-2 group-hover:text-brand-green transition-colors">
                  <a href={`/products/${p.id}`} class="outline-none focus-visible:underline">{p.name}</a>
                </h2>
                
                {p.model.includes('Missing') ? (
                  <p class="text-xs text-red-600 mb-4 bg-red-50 p-2 rounded line-clamp-2 border border-red-100">Model: {p.model}</p>
                ) : (
                  <p class="text-xs text-gray-500 mb-4 font-mono bg-gray-50 p-2 rounded border border-gray-100">Model: {p.model}</p>
                )}

                <div class="mt-auto pt-4 border-t border-gray-100 flex items-center justify-between">
                  <p class="text-lg font-black text-brand-dark">{p.price}</p>
                  <button disabled={!p.inStock} class={`px-4 py-2 rounded-lg font-bold text-sm transition-colors outline-none focus:ring-4 focus:ring-green-200 ${p.inStock ? 'bg-brand-green text-white hover:bg-green-700' : 'bg-gray-100 text-gray-400 cursor-not-allowed'}`} aria-label={`Add ${p.name} to cart`}>
                     {p.inStock ? 'Add to Cart' : 'Unavailable'}
                  </button>
                </div>
              </div>
            </article>
          ))}
        </div>
        
        {/* Empty State / Missing Category Handling */}
        {mockProducts.length === 0 && (
          <div class="text-center py-16 bg-gray-50 rounded-2xl border border-gray-200">
            <svg class="w-16 h-16 mx-auto text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"></path></svg>
            <h3 class="text-xl font-bold text-brand-dark mb-2">No products found</h3>
            <p class="text-gray-500 mb-6">Try adjusting your category or search filters.</p>
            <a href="/shop" class="inline-block px-6 py-2 bg-brand-dark text-white rounded-lg font-bold hover:bg-black transition-colors">Clear Filters</a>
          </div>
        )}
      </main>

    </div>
  </div>
</BaseLayout>

