---
import BaseLayout from "../layouts/BaseLayout.astro";
import { apiBase } from "../lib/api";

const categories = [
  { slug: 'all', name: 'All Categories' },
  { slug: 'power', name: 'Power Devices' },
  { slug: 'sound', name: 'Sound Devices' },
  { slug: 'storage', name: 'Storage Devices' },
  { slug: 'car', name: 'Car Accessories' }
];

// Sample data fallback if API unavailable
const fallbackProducts = [
  {
    id: "gen-1",
    sku: "GP-CHG-001",
    name: "Generic Fast Charger",
    slug: "generic-fast-charger",
    category: "Power",
    priceUgx: 50000,
    stockStatus: "in_stock",
    modelNumber: "GP-001",
    hasImage: false,
    active: true,
    approvalStatus: "approved",
  },
  {
    id: "ear-1",
    sku: "GP-SND-001",
    name: "Wireless Earbuds",
    slug: "wireless-earbuds",
    category: "Sound",
    priceUgx: 80000,
    stockStatus: "in_stock",
    modelNumber: "GP-002",
    hasImage: false,
    active: true,
    approvalStatus: "approved",
  }
];

let products = fallbackProducts;
let isSampleData = true;
let fetchError = null;

try {
  const res = await fetch(`${apiBase}/products`, { signal: AbortSignal.timeout(2000) });
  if (res.ok) {
    const json = await res.json();
    if (json.success && Array.isArray(json.data) && json.data.length > 0) {
      products = json.data;
      isSampleData = false;
    }
  }
} catch (err) {
  fetchError = "Failed to connect to API.";
}

const formatter = new Intl.NumberFormat('en-UG', { style: 'currency', currency: 'UGX', maximumFractionDigits: 0 });
---

<BaseLayout title="Shop All Products - GoldPlus">
  <div class="bg-brand-dark text-white py-12 border-b border-gray-800">
    <div class="container mx-auto px-4 lg:px-8">
      <h1 class="text-3xl md:text-5xl font-black tracking-tight text-brand-gold mb-4">The Catalog</h1>
      <p class="text-gray-300 max-w-2xl text-lg">Browse our full range of rigorously tested electronics. Authentic, durable, and designed for reliability.</p>
    </div>
  </div>

  <div class="container mx-auto px-4 lg:px-8 py-8">
    <div class="flex flex-col lg:flex-row gap-8">
      
      {/* Sidebar / Filters */}
      <aside class="w-full lg:w-1/4">
        <div class="bg-white p-6 rounded-2xl border border-gray-200 sticky top-24">
          <h2 class="font-bold text-xl mb-4 text-brand-dark">Search</h2>
          <div class="mb-8">
            <label for="search" class="sr-only">Search products</label>
            <div class="relative">
              <input type="search" id="search" placeholder="Search by name or model..." class="w-full pl-10 pr-4 py-3 bg-gray-50 border border-gray-200 rounded-lg focus:ring-2 focus:ring-brand-green focus:border-brand-green outline-none transition-all">
              <svg class="absolute left-3 top-3.5 h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
            </div>
          </div>

          <h2 class="font-bold text-xl mb-4 text-brand-dark">Categories</h2>
          <ul class="space-y-2 mb-8">
            {categories.map((cat, i) => (
              <li>
                <a href={`/shop?category=${cat.slug}`} class={`block px-3 py-2 rounded-lg transition-colors ${i === 0 ? 'bg-brand-green/10 text-brand-green font-bold' : 'text-gray-600 hover:bg-gray-50'}`}>
                  {cat.name}
                </a>
              </li>
            ))}
          </ul>
          
          <div class="bg-gray-50 p-4 rounded-xl border border-gray-200">
            <h3 class="font-bold text-brand-dark mb-2">Need Assistance?</h3>
            <p class="text-sm text-gray-600 mb-4">Our team is ready to help you find the right product.</p>
            <a href="/support" class="block w-full text-center bg-brand-green text-white py-2 rounded font-bold hover:bg-green-700 transition-colors">WhatsApp Support</a>
          </div>
        </div>
      </aside>

      {/* Main Content */}
      <main class="w-full lg:w-3/4">
        {isSampleData && (
          <div class="bg-blue-50 border border-blue-100 p-4 rounded-xl mb-6 flex items-center gap-3">
            <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            <p class="text-sm text-blue-700 font-medium">Sample data shown because the API is not yet populated or configured.</p>
          </div>
        )}
        <div class="flex items-center justify-between mb-6 pb-4 border-b border-gray-200">
          <p class="text-gray-600">Showing <span class="font-bold text-brand-dark">{products.length}</span> products</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {products.map(p => {
            const inStock = p.stockStatus !== 'out_of_stock';
            return (
            <article class="group flex flex-col h-full border border-gray-200 rounded-2xl p-4 hover:border-brand-gold hover:shadow-lg transition-all bg-white">
              <div class="relative mb-4">
                <a href={`/products/${p.slug}`} class="block aspect-square bg-gray-50 rounded-xl overflow-hidden relative outline-none focus-visible:ring-4 focus-visible:ring-brand-gold">
                  <div class="absolute inset-0 flex items-center justify-center text-gray-400 font-medium text-sm">
                    {p.imageUrl ? <img src={p.imageUrl} alt={p.name} class="object-cover w-full h-full" /> : 'Missing Image'}
                  </div>
                </a>
                <div class="absolute top-2 left-2">
                   <span class={`text-xs font-bold px-2 py-1 rounded uppercase tracking-wider ${inStock ? 'bg-brand-dark text-white' : 'bg-red-100 text-red-800'}`}>
                     {inStock ? 'In Stock' : 'Out of Stock'}
                   </span>
                </div>
              </div>
              
              <div class="flex flex-col flex-grow">
                <p class="text-xs font-bold text-brand-green uppercase tracking-widest mb-1">{p.category}</p>
                <h2 class="text-lg font-bold text-brand-dark leading-tight mb-2 group-hover:text-brand-green transition-colors">
                  <a href={`/products/${p.slug}`} class="outline-none focus-visible:underline">{p.name}</a>
                </h2>
                
                <p class="text-xs text-gray-500 mb-4 font-mono bg-gray-50 p-2 rounded border border-gray-100">SKU: {p.sku}</p>

                <div class="mt-auto pt-4 border-t border-gray-100 flex items-center justify-between">
                  <p class="text-lg font-black text-brand-dark">{formatter.format(p.priceUgx)}</p>
                  <button 
                    disabled={!inStock} 
                    class="add-to-cart-btn px-4 py-2 rounded-lg font-bold text-sm transition-colors outline-none focus:ring-4 focus:ring-green-200 bg-brand-green text-white hover:bg-green-700 disabled:bg-gray-100 disabled:text-gray-400 disabled:cursor-not-allowed"
                    data-product={JSON.stringify({
                      productId: p.id,
                      sku: p.sku,
                      name: p.name,
                      priceUgx: p.priceUgx,
                      category: p.category
                    })}
                    aria-label={`Add ${p.name} to cart`}>
                     {inStock ? 'Add to Cart' : 'Unavailable'}
                  </button>
                </div>
              </div>
            </article>
          )})}
        </div>
        
        {products.length === 0 && (
          <div class="text-center py-16 bg-gray-50 rounded-2xl border border-gray-200">
            <h3 class="text-xl font-bold text-brand-dark mb-2">No products found</h3>
            <a href="/shop" class="inline-block px-6 py-2 bg-brand-dark text-white rounded-lg font-bold hover:bg-black transition-colors">Reload Shop</a>
          </div>
        )}
      </main>

    </div>
  </div>

  <script is:inline>
    document.querySelectorAll('.add-to-cart-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const product = JSON.parse(btn.getAttribute('data-product'));
        const currentCart = JSON.parse(localStorage.getItem('gp_cart') || '[]');
        
        const existing = currentCart.find(item => item.productId === product.productId);
        if (existing) {
          existing.quantity += 1;
        } else {
          currentCart.push({ ...product, quantity: 1 });
        }
        
        localStorage.setItem('gp_cart', JSON.stringify(currentCart));
        
        // Visual feedback
        const oldText = btn.innerText;
        btn.innerText = 'Added!';
        btn.classList.add('bg-green-800');
        setTimeout(() => {
          btn.innerText = oldText;
          btn.classList.remove('bg-green-800');
        }, 1000);
      });
    });
  </script>
</BaseLayout>

