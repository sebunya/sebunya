---
/**
 * "Rate what you bought." The shopper proves the order the same way order
 * tracking does (reference + the phone or email used at checkout; the API
 * applies the shared lockout), then rates each item on it. Only a delivered
 * or completed order can be rated, so every review is a verified purchase,
 * and every review waits for a moderator before it appears. Nothing here is
 * seeded or invented: an item with no reviews shows none.
 */
import { readClientAddress } from '../lib/forwardClient';
import BaseLayout from '../layouts/BaseLayout.astro';
import { postJson, whatsappSupportNumber } from '../lib/api';
import { readGuestMemory, rememberedContact } from '../lib/guestMemory';

type Item = { productId: string; name: string; reviewed: boolean };
let reference = (Astro.url.searchParams.get('reference') ?? '').trim().slice(0, 80);
let contact = '';
let items: Item[] | null = null;
let delivered = false;
let orderNumber = '';
let errorMsg = '';
let thanksFor = '';
let itemError: { productId: string; message: string } | null = null;

const eligibility = () => postJson('/commerce/reviews/eligibility', { reference, contact }, null, readClientAddress(Astro));

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = String(form.get('intent') ?? 'lookup');
  reference = String(form.get('reference') ?? '').trim().slice(0, 80);
  contact = String(form.get('contact') ?? '').trim().slice(0, 120);
  if (!reference || !contact) {
    errorMsg = 'Enter both your order reference and the phone number or email used at checkout.';
  } else {
    if (intent === 'submit') {
      const productId = String(form.get('productId') ?? '');
      const rating = Number(form.get('rating'));
      const res = await postJson('/commerce/reviews', {
        reference, contact, productId, rating,
        title: String(form.get('title') ?? '').slice(0, 140),
        body: String(form.get('body') ?? '').slice(0, 2000),
      }, null, readClientAddress(Astro));
      if (res.ok) thanksFor = String(form.get('productName') ?? 'that item');
      else itemError = { productId, message: res.message ?? 'We could not take that review. Please try again.' };
    }
    const result = await eligibility();
    if (!result.ok) {
      errorMsg = result.code === 'NETWORK'
        ? 'We cannot reach the order service right now. Please try again shortly.'
        : (result.message ?? 'We could not verify that order. Please check your reference and contact details.');
    } else {
      const d = result.data as { orderNumber?: string; delivered?: boolean; items?: Item[] };
      orderNumber = String(d.orderNumber ?? reference);
      delivered = Boolean(d.delivered);
      items = Array.isArray(d.items) ? d.items : [];
    }
  }
}
// From the "delivered" text on the device that placed the order: the contact is remembered from
// checkout, so the items to rate show at once. Same proof and lockout as a typed lookup; on a
// mismatch the form simply shows, pre-filled.
if (Astro.request.method === 'GET') {
  contact = rememberedContact(readGuestMemory(Astro.cookies));
  if (reference && contact) {
    const auto = await eligibility();
    if (auto.ok) {
      const d = auto.data as { orderNumber?: string; delivered?: boolean; items?: Item[] };
      orderNumber = String(d.orderNumber ?? reference); delivered = Boolean(d.delivered); items = Array.isArray(d.items) ? d.items : [];
    }
  }
}
const remaining = items ? items.filter((i) => !i.reviewed) : [];
const helpUrl = `https://wa.me/${whatsappSupportNumber}?text=${encodeURIComponent('Hello GoldPlus, I would like to give feedback on my order.')}`;
---
<BaseLayout robotsMeta="noindex,follow" title="Rate what you bought | GoldPlus" description="Rate the items on your GoldPlus order. Only delivered orders can be rated, so every review is from a real buyer.">
  <main class="mx-auto max-w-xl px-4 py-10 sm:py-14">
    <p class="text-xs font-black uppercase tracking-[0.18em] text-brand-primaryInk">Your order</p>
    <h1 class="mt-3 text-3xl font-black tracking-tight text-gray-900 sm:text-4xl" style="text-wrap:balance">Rate what you bought</h1>
    <p class="mt-3 text-base text-slate-600">It takes a minute and helps the next shopper choose. Only orders that have reached you can be rated, so every review on GoldPlus is from someone who bought the item.</p>

    {errorMsg && <p role="alert" class="mt-6 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-semibold text-red-800">{errorMsg}</p>}

    {!items && (
      <form method="POST" action="/review" class="mt-6 space-y-4">
        <input type="hidden" name="intent" value="lookup" />
        <label class="block">
          <span class="text-sm font-bold text-gray-900">Order reference</span>
          <input name="reference" required value={reference} autocomplete="off" placeholder="GP-…" class="mt-1 w-full min-h-11 rounded-lg border border-slate-300 px-3 py-2.5 text-base outline-none focus:ring-2 focus:ring-brand-primaryInk" />
        </label>
        <label class="block">
          <span class="text-sm font-bold text-gray-900">Phone number or email used at checkout</span>
          <input name="contact" required value={contact} autocomplete="tel" class="mt-1 w-full min-h-11 rounded-lg border border-slate-300 px-3 py-2.5 text-base outline-none focus:ring-2 focus:ring-brand-primaryInk" />
        </label>
        <button type="submit" class="inline-flex min-h-12 items-center justify-center rounded-full bg-brand-primary px-6 text-xs font-black uppercase tracking-widest text-brand-black">Find my order</button>
      </form>
    )}

    {items && !delivered && (
      <div class="mt-6 rounded-xl border border-slate-200 bg-white px-4 py-4 text-sm text-slate-700">
        <p class="font-bold text-gray-900">Order {orderNumber} has not reached you yet.</p>
        <p class="mt-1">You can rate it once it is delivered. <a class="font-bold underline" href={`/track-order?reference=${encodeURIComponent(reference)}`}>Track this order</a></p>
      </div>
    )}

    {items && delivered && (
      <div class="mt-6 space-y-5">
        {thanksFor && <p role="status" class="rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-semibold text-emerald-800">Thank you for rating {thanksFor}. It will appear once our team has checked it.</p>}
        {remaining.length === 0 && (
          <p class="rounded-xl border border-slate-200 bg-white px-4 py-4 text-sm text-slate-700">You have rated everything on order {orderNumber}. Thank you. Anything else to tell us? <a class="font-bold underline" href={helpUrl} target="_blank" rel="noopener noreferrer">Message us on WhatsApp</a>.</p>
        )}
        {remaining.map((it) => (
          <form method="POST" action="/review" class="rounded-2xl border border-slate-200 bg-white p-4 sm:p-5">
            <input type="hidden" name="intent" value="submit" />
            <input type="hidden" name="reference" value={reference} />
            <input type="hidden" name="contact" value={contact} />
            <input type="hidden" name="productId" value={it.productId} />
            <input type="hidden" name="productName" value={it.name} />
            <p class="font-bold text-gray-900">{it.name}</p>
            <fieldset class="mt-3">
              <legend class="text-sm font-semibold text-slate-700">How many stars?</legend>
              <div class="gp-stars mt-2">
                {[1, 2, 3, 4, 5].map((n) => (
                  <>
                    <input type="radio" id={`r-${it.productId}-${n}`} name="rating" value={String(n)} required />
                    <label for={`r-${it.productId}-${n}`} title={`${n} star${n === 1 ? '' : 's'}`}><span class="sr-only">{n} star{n === 1 ? '' : 's'}</span>★</label>
                  </>
                ))}
              </div>
            </fieldset>
            <label class="mt-4 block">
              <span class="text-sm font-semibold text-slate-700">A short headline <span class="font-normal text-slate-500">(optional)</span></span>
              <input name="title" maxlength="140" class="mt-1 w-full min-h-11 rounded-lg border border-slate-300 px-3 py-2.5 text-base outline-none focus:ring-2 focus:ring-brand-primaryInk" />
            </label>
            <label class="mt-3 block">
              <span class="text-sm font-semibold text-slate-700">What should the next buyer know? <span class="font-normal text-slate-500">(optional)</span></span>
              <textarea name="body" maxlength="2000" rows="3" placeholder="For example: which phone you used it with, how long it lasts" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2.5 text-base outline-none focus:ring-2 focus:ring-brand-primaryInk"></textarea>
            </label>
            {itemError && itemError.productId === it.productId && <p role="alert" class="mt-3 text-sm font-semibold text-red-700">{itemError.message}</p>}
            <p class="mt-3 text-xs text-slate-500">Please leave out phone numbers and emails; a review that includes one is held back.</p>
            <button type="submit" class="mt-4 inline-flex min-h-12 items-center justify-center rounded-full bg-brand-primary px-6 text-xs font-black uppercase tracking-widest text-brand-black">Send my rating</button>
          </form>
        ))}
      </div>
    )}
  </main>
</BaseLayout>

<style>
  /* Five stars in natural order (arrow keys move left to right). The fill up to the chosen or
     hovered star uses :has(); without :has support the chosen star alone is highlighted. */
  .gp-stars { display: inline-flex; gap: .15rem; }
  .gp-stars input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .gp-stars label { font-size: 2rem; line-height: 1; color: #cbd5e1; cursor: pointer; padding: .1rem; min-width: 44px; min-height: 44px; display: grid; place-items: center; }
  .gp-stars input:checked + label { color: #f59e0b; }
  .gp-stars label:has(~ input:checked) { color: #f59e0b; }
  .gp-stars:hover label { color: #cbd5e1; }
  .gp-stars:hover label:hover, .gp-stars label:has(~ label:hover) { color: #f59e0b; }
  .gp-stars input:focus-visible + label { outline: 3px solid #93d500; outline-offset: 2px; border-radius: .4rem; }
</style>
