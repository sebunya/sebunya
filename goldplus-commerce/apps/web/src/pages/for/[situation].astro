---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { apiBase } from '../../lib/api';
import { fetchApprovedCatalogueWithStatus } from '../../lib/catalogue';
import { getCleanCatalog } from '../../lib/catalog/catalog';
import { getTaxonomy } from '../../lib/taxonomy';
import { dedupeProductsById, isListableProduct, searchDiscoveryProducts, getProductSubcategory, subcategoryNameForSlug } from '../../lib/product-discovery';
import { situationBySlug, BUYING_SITUATIONS } from '../../lib/buyingSituations';
import { SITE_ORIGIN } from '../../lib/sitemap';
import { serializeJsonLd, breadcrumbJsonLd } from '../../lib/jsonld';

const situation = situationBySlug(Astro.params.situation);
if (!situation) return Astro.redirect('/404', 404);

const taxonomy = await getTaxonomy();
const catalogue = await fetchApprovedCatalogueWithStatus(apiBase);
const products = dedupeProductsById(getCleanCatalog(catalogue.products, taxonomy)).filter(isListableProduct);
const seen = new Set<string>();
const rows = situation.rows.map((row) => {
  const found = searchDiscoveryProducts(products, { search: row.search, category: '', subcategory: '' }, taxonomy).products
    .filter((p) => !seen.has(p.id)).slice(0, 8);
  found.forEach((p) => seen.add(p.id));
  return { ...row, products: found };
}).filter((row) => row.products.length > 0);
// An empty page is thin content: keep it out of the index until the catalogue answers.
const robotsMeta = rows.length === 0 ? 'noindex,follow' : undefined;
if (!catalogue.complete) Astro.response.headers.set('Cache-Control', 'no-store');
const canonicalUrl = `${SITE_ORIGIN}/for/${situation.slug}`;
const crumbs = [{ name: 'Home', url: `${SITE_ORIGIN}/` }, { name: situation.title, url: canonicalUrl }];
---
<BaseLayout title={situation.metaTitle} description={situation.description} canonicalUrl={canonicalUrl} robotsMeta={robotsMeta}>
  <script type="application/ld+json" set:html={serializeJsonLd(breadcrumbJsonLd(crumbs))} />
  <div class="container mx-auto px-4 lg:px-8 py-10" data-situation-page={situation.slug}>
    <nav aria-label="Breadcrumb" class="text-xs text-slate-500"><a href="/" class="hover:underline">Home</a> / <span>{situation.title}</span></nav>
    <h1 class="mt-3 text-3xl md:text-4xl font-black tracking-tight text-gray-900">{situation.title}</h1>
    <p class="mt-3 max-w-2xl text-slate-700 leading-relaxed">{situation.intro}</p>
    {situation.extra && <a href={situation.extra.href} class="mt-5 inline-flex min-h-11 items-center rounded-full bg-brand-charcoal px-5 text-sm font-bold text-white">{situation.extra.label}</a>}

    {rows.length === 0 && <p class="mt-10 text-slate-600">The catalogue is not answering just now. <a href="/shop" class="underline">Browse the shop</a>.</p>}
    {rows.map((row) => (
      <section class="mt-12" aria-label={row.heading}>
        <div class="flex items-baseline justify-between gap-4">
          <h2 class="text-xl font-black text-gray-900">{row.heading}</h2>
          <a href={`/shop?q=${encodeURIComponent(row.search)}`} class="text-sm font-bold underline">See all</a>
        </div>
        <div class="mt-5 grid grid-cols-2 gap-4 md:grid-cols-4">
          {row.products.map((product) => <ProductCard product={product} subcategory={subcategoryNameForSlug(getProductSubcategory(product, taxonomy), taxonomy)} />)}
        </div>
      </section>
    ))}

    {situation.guides.length > 0 && (
      <section class="mt-14" aria-label="Guides">
        <h2 class="text-xl font-black text-gray-900">Read before you buy</h2>
        <ul class="mt-3 space-y-2 text-sm">{situation.guides.map((g) => <li><a href={g.href} class="underline">{g.label}</a></li>)}</ul>
      </section>
    )}

    <section class="mt-14 border-t border-slate-200 pt-8" aria-label="Other buying situations">
      <h2 class="text-sm font-bold uppercase tracking-wider text-slate-500">Also shopping for</h2>
      <ul class="mt-3 flex flex-wrap gap-2 text-xs font-bold">
        {BUYING_SITUATIONS.filter((s) => s.slug !== situation.slug).map((s) => <li><a href={`/for/${s.slug}`} class="inline-flex min-h-9 items-center rounded-full border border-slate-300 px-3.5 text-gray-900">{s.title}</a></li>)}
        <li><a href="/battery-finder" class="inline-flex min-h-9 items-center rounded-full border border-slate-300 px-3.5 text-gray-900">A battery for my phone</a></li>
        <li><a href="/bulk" class="inline-flex min-h-9 items-center rounded-full border border-slate-300 px-3.5 text-gray-900">Buying for my shop</a></li>
      </ul>
    </section>
  </div>
</BaseLayout>
