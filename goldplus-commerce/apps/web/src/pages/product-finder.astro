---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductFinderShell from '../components/product-finder/ProductFinderShell.astro';
import { publicApiBase } from '../lib/api';
const rawReference = Astro.url.searchParams.get('compatibleWith');
const compatibleWith = rawReference && /^[0-9a-f-]{36}$/i.test(rawReference) ? rawReference : null;
---

<BaseLayout title="Find the Right GoldPlus Product" description="Not sure which charger, power bank, earbuds or storage to buy? Answer four quick questions and GoldPlus suggests products in stock in Kampala, at current prices.">
  <div class="container mx-auto px-4 py-8">
    <div class="max-w-2xl mx-auto">
      <h1 class="text-3xl md:text-4xl font-black tracking-tight text-gray-900 mb-2">Find the right GoldPlus product</h1>
      <p class="text-gray-600 mb-3">Answer a few quick questions and we'll recommend products that fit what you need.</p>
      <p class="text-sm text-gray-700 mb-8">Need a charger, cable or power bank for a specific phone or laptop? Use the <a href="/charger-finder" class="font-bold underline">charger and cable finder</a>; for a phone battery, the <a href="/battery-finder" class="font-bold underline">battery finder</a>.</p>
      
      <ProductFinderShell apiBase={publicApiBase} compatibleWith={compatibleWith} />
    </div>
  </div>
</BaseLayout>
