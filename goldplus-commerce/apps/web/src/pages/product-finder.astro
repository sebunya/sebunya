---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductFinderShell from '../components/product-finder/ProductFinderShell.astro';
import { publicApiBase } from '../lib/api';
const rawReference = Astro.url.searchParams.get('compatibleWith');
const compatibleWith = rawReference && /^[0-9a-f-]{36}$/i.test(rawReference) ? rawReference : null;
---

<BaseLayout title="Find the Right GoldPlus Product">
  <div class="container mx-auto px-4 py-8">
    <div class="max-w-2xl mx-auto">
      <h1 class="text-3xl font-bold text-gray-900 mb-2">Find the Right GoldPlus Product</h1>
      <p class="text-gray-600 mb-8">Answer a few quick questions and we'll recommend products that fit what you need.</p>
      
      <ProductFinderShell apiBase={publicApiBase} compatibleWith={compatibleWith} />
    </div>
  </div>
</BaseLayout>
