---
import BaseLayout from "../../layouts/BaseLayout.astro";

const { id } = Astro.params;

// Mock order data for Phase 1
const order = {
  id: id,
  status: 'pending',
  paymentStatus: 'unpaid',
  total: 180000,
  createdAt: new Date().toLocaleDateString(),
  items: [
    { name: "Generic Fast Charger", qty: 2 },
    { name: "Wireless Earbuds", qty: 1 }
  ]
};
---

<BaseLayout title={`Order Status ${order.id} - GoldPlus`}>
  <div class="bg-gray-50 py-12 border-b border-gray-200">
    <div class="container mx-auto px-4 lg:px-8 text-center">
      <div class="w-20 h-20 bg-brand-green/10 text-brand-green rounded-full flex items-center justify-center mx-auto mb-6">
        <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
      </div>
      <h1 class="text-3xl md:text-5xl font-black tracking-tight text-brand-dark mb-4">Order Received</h1>
      <p class="text-gray-600 max-w-xl mx-auto text-lg">Your order <span class="font-bold text-brand-dark">#{order.id}</span> has been placed. Our team will verify authenticity and contact you shortly.</p>
    </div>
  </div>

  <div class="container mx-auto px-4 lg:px-8 py-12">
    <div class="max-w-3xl mx-auto">
      
      <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden mb-8">
        <div class="p-6 border-b border-gray-100 flex justify-between items-center bg-gray-50">
          <h2 class="font-bold text-brand-dark uppercase tracking-widest text-sm">Order Details</h2>
          <span class="bg-brand-gold text-brand-dark text-[10px] font-black px-2 py-1 rounded uppercase">Manual Review Pending</span>
        </div>
        <div class="p-6">
          <ul class="space-y-4 mb-6">
            {order.items.map(item => (
              <li class="flex justify-between text-sm">
                <span class="text-gray-600"><span class="font-bold text-brand-dark">{item.qty}x</span> {item.name}</span>
              </li>
            ))}
          </ul>
          <div class="border-t border-gray-100 pt-4 flex justify-between items-center">
            <span class="font-bold text-brand-dark">Total Amount</span>
            <span class="text-xl font-black text-brand-dark text-brand-green">UGX {order.total.toLocaleString()}</span>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12">
        <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm">
          <h3 class="font-bold text-brand-dark mb-4">Payment Status</h3>
          <div class="flex items-center gap-3 text-sm text-gray-500">
             <div class="w-3 h-3 rounded-full bg-orange-400"></div>
             <span>Unpaid - Awaiting Manual Confirmation</span>
          </div>
          <p class="text-xs text-gray-400 mt-4 leading-relaxed">Payment providers are currently in "Not Configured" state for Phase 1. Our operations lead will assist you with Mobile Money payment.</p>
        </div>
        <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm">
          <h3 class="font-bold text-brand-dark mb-4">Next Steps</h3>
          <ul class="space-y-3 text-sm text-gray-600">
            <li class="flex gap-2">
              <span class="text-brand-green font-bold">1.</span> 
              Operations team verifies stock availability.
            </li>
            <li class="flex gap-2">
              <span class="text-brand-green font-bold">2.</span> 
              WhatsApp contact initiated for payment/delivery.
            </li>
            <li class="flex gap-2">
              <span class="text-brand-green font-bold">3.</span> 
              Product dispatched for delivery in Uganda.
            </li>
          </ul>
        </div>
      </div>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/shop" class="px-8 py-3 bg-gray-100 text-brand-dark rounded-lg font-bold hover:bg-gray-200 transition-colors">Continue Shopping</a>
        <a href="https://wa.me/256000000000" class="px-8 py-3 bg-brand-green text-white rounded-lg font-bold hover:bg-green-700 transition-colors flex items-center justify-center gap-2">
          Contact on WhatsApp
        </a>
      </div>

    </div>
  </div>
</BaseLayout>
