---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { apiBase } from "../../lib/api";

const { id } = Astro.params;

let order: any = null;
let notFound = false;
let dbError = false;

try {
  const res = await fetch(`${apiBase}/commerce/orders/${id}`, { signal: AbortSignal.timeout(3000) });
  if (res.ok) {
    const json = await res.json();
    if (json.success && json.data) {
      order = json.data;
    } else {
      notFound = true;
    }
  } else if (res.status === 404) {
    notFound = true;
  } else if (res.status === 503) {
    dbError = true;
  } else {
    notFound = true;
  }
} catch (err) {
  // Network or timeout
  dbError = true;
}

const formatter = new Intl.NumberFormat('en-UG', { style: 'currency', currency: 'UGX', maximumFractionDigits: 0 });

const getStatusColor = (status: string) => {
  switch (status) {
    case 'received': return 'bg-blue-100 text-blue-800';
    case 'pending_owner_review': return 'bg-purple-100 text-purple-800';
    case 'processing': return 'bg-orange-100 text-orange-800';
    case 'completed': return 'bg-green-100 text-green-800';
    case 'cancelled': case 'failed': return 'bg-red-100 text-red-800';
    default: return 'bg-gray-100 text-gray-800';
  }
};

const formatStatus = (status: string) => {
  return status.split('_').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
};
---

<BaseLayout title={order ? `Order Status ${order.orderNumber} - GoldPlus` : 'Order Not Found - GoldPlus'}>
  
  {dbError && !order && (
    <div class="container mx-auto px-4 py-20 text-center">
      <h1 class="text-3xl font-black text-brand-dark mb-4">Service Unavailable</h1>
      <p class="text-gray-600 mb-8">The order service is currently offline. Please contact support.</p>
      <a href="/shop" class="px-8 py-3 bg-brand-dark text-white rounded-lg font-bold">Return to Shop</a>
    </div>
  )}

  {notFound && !dbError && (
    <div class="container mx-auto px-4 py-20 text-center">
      <div class="w-20 h-20 bg-gray-100 text-gray-400 rounded-full flex items-center justify-center mx-auto mb-6">
        <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
      </div>
      <h1 class="text-3xl font-black text-brand-dark mb-4">Order Not Found</h1>
      <p class="text-gray-600 mb-8">We could not find an order with the reference <span class="font-bold text-brand-dark">{id}</span>.</p>
      <a href="/shop" class="px-8 py-3 bg-brand-dark text-white rounded-lg font-bold">Return to Shop</a>
    </div>
  )}

  {order && (
    <div>
      <div class="bg-gray-50 py-12 border-b border-gray-200">
        <div class="container mx-auto px-4 lg:px-8 text-center">
          <div class="w-20 h-20 bg-brand-green/10 text-brand-green rounded-full flex items-center justify-center mx-auto mb-6">
            <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
          </div>
          <h1 class="text-3xl md:text-5xl font-black tracking-tight text-brand-dark mb-4">Order Received</h1>
          <p class="text-gray-600 max-w-xl mx-auto text-lg">Your order <span class="font-bold text-brand-dark">#{order.orderNumber}</span> has been placed. Our team will verify authenticity and contact you shortly.</p>
        </div>
      </div>

      <div class="container mx-auto px-4 lg:px-8 py-12">
        <div class="max-w-3xl mx-auto">
          
          <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden mb-8">
            <div class="p-6 border-b border-gray-100 flex justify-between items-center bg-gray-50">
              <h2 class="font-bold text-brand-dark uppercase tracking-widest text-sm">Order Details</h2>
              <span class={`text-[10px] font-black px-2 py-1 rounded uppercase ${getStatusColor(order.orderStatus)}`}>
                {formatStatus(order.orderStatus)}
              </span>
            </div>
            <div class="p-6">
              <ul class="space-y-4 mb-6">
                {order.items.map((item: any) => (
                  <li class="flex justify-between text-sm">
                    <span class="text-gray-600"><span class="font-bold text-brand-dark">{item.quantity}x</span> {item.name}</span>
                    <span class="font-bold text-brand-dark">{formatter.format(item.price * item.quantity)}</span>
                  </li>
                ))}
              </ul>
              <div class="border-t border-gray-100 pt-4 flex justify-between items-center">
                <span class="font-bold text-brand-dark">Total Amount</span>
                <span class="text-xl font-black text-brand-dark text-brand-green">{formatter.format(order.totalUgx)}</span>
              </div>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12">
            <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm">
              <h3 class="font-bold text-brand-dark mb-4">Payment Status</h3>
              <div class="flex items-center gap-3 text-sm text-gray-500">
                 <div class={`w-3 h-3 rounded-full ${order.paymentStatus === 'paid' ? 'bg-green-500' : 'bg-orange-400'}`}></div>
                 <span class="uppercase font-bold">{order.paymentStatus}</span>
              </div>
              {order.paymentStatus === 'unpaid' && (
                <p class="text-xs text-gray-400 mt-4 leading-relaxed">Payment integration is offline. Operations team will confirm offline payment.</p>
              )}
            </div>
            <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm">
              <h3 class="font-bold text-brand-dark mb-4">Next Steps</h3>
              <ul class="space-y-3 text-sm text-gray-600">
                <li class="flex gap-2">
                  <span class="text-brand-green font-bold">1.</span> 
                  Operations team verifies stock availability.
                </li>
                <li class="flex gap-2">
                  <span class="text-brand-green font-bold">2.</span> 
                  WhatsApp contact initiated for payment/delivery.
                </li>
                <li class="flex gap-2">
                  <span class="text-brand-green font-bold">3.</span> 
                  Product dispatched for delivery in Uganda.
                </li>
              </ul>
            </div>
          </div>

          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="/shop" class="px-8 py-3 bg-gray-100 text-brand-dark rounded-lg font-bold hover:bg-gray-200 transition-colors text-center">Continue Shopping</a>
            <a href="https://wa.me/256000000000" class="px-8 py-3 bg-brand-green text-white rounded-lg font-bold hover:bg-green-700 transition-colors flex items-center justify-center gap-2">
              Contact on WhatsApp
            </a>
          </div>

        </div>
      </div>
    </div>
  )}
</BaseLayout>
