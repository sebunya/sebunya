---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatUgx } from "../../lib/money";
import Notice from '../../components/Notice.astro';
import { apiBase } from '../../lib/api';
import { readSessionToken, clearSessionCookie } from '../../lib/session';
import { getBusinessInfo } from '../../lib/businessInfo';
import { orderStatusCopy, STATUS_TONE_CLASS } from '../../lib/orderStatusCopy';
import { resolveCheckoutIntent } from '../../lib/checkoutIntent';
import { resolveAuthenticatedUserId } from '../../lib/customerAuth';
import { startPayment, paymentStartMessageFor } from '../../lib/checkoutClient';
import { checkRequestOrigin, CROSS_SITE_MESSAGE } from '../../lib/requestOrigin';
import type { OrderDetailDto, ApiResponse } from '@goldplus/shared';

const { id } = Astro.params;
const token = readSessionToken(Astro.request);
if (!token) {
  return Astro.redirect(`/login?returnTo=/orders/${encodeURIComponent(id ?? '')}`, 303);
}

let order: OrderDetailDto | null = null;
let fetchError: string | null = null;
let notFound = false;

try {
  const res = await fetch(`${apiBase}/account/orders/${encodeURIComponent(id ?? '')}`, {
    headers: { Authorization: `Bearer ${token}` },
  });
  if (res.status === 401) {
    Astro.response.headers.set('Set-Cookie', clearSessionCookie());
    return Astro.redirect(`/login?returnTo=/orders/${encodeURIComponent(id ?? '')}`, 303);
  }
  if (res.status === 404) {
    notFound = true;
  } else if (!res.ok) {
    // No HTTP number and no API text: neither is something a customer can act on.
    fetchError = 'We could not load this order right now. Please try again in a moment.';
  } else {
    const json = (await res.json()) as ApiResponse<OrderDetailDto>;
    if (json.success && json.data) order = json.data;
    else fetchError = 'We could not load this order right now. Please try again in a moment.';
  }
} catch {
  fetchError = 'We could not reach our order system right now. Please try again in a moment.';
}

const biz = await getBusinessInfo();
const status = order ? orderStatusCopy(order.status) : null;
const isUnpaid = order?.status === 'PENDING_PAYMENT';

/**
 * Pay now (B6). An unpaid order used to be a dead end: the page said "not
 * paid yet" and offered a phone number. The customer who abandoned the bank
 * page, or whose connection dropped on the way there, can now pick the same
 * order up again. The API authorises the caller through the checkout intent,
 * which the storefront mints for the signed-in principal here, exactly as
 * checkout does; a live provider attempt is reused rather than duplicated.
 */
let payMessage: string | null = null;
if (Astro.request.method === 'POST' && order && isUnpaid) {
  const originDecision = checkRequestOrigin(Astro.request, import.meta.env as unknown as Record<string, string | undefined>);
  if (!originDecision.allowed) {
    payMessage = CROSS_SITE_MESSAGE;
  } else {
    const userId = await resolveAuthenticatedUserId(Astro.cookies);
    const intent = userId ? resolveCheckoutIntent(Astro.cookies, userId) : null;
    if (!intent) {
      payMessage = 'We could not start the payment from here. Sign in again and try once more, or message us and we will send you a payment link.';
    } else {
      const payRes = await startPayment({ orderId: order.id, intentToken: intent.token, sessionToken: token });
      if (payRes.ok) {
        return Astro.redirect(payRes.data.redirectUrl, 303);
      }
      payMessage = paymentStartMessageFor(payRes.code);
    }
  }
}

const helpHref = order
  ? `${biz.whatsappUrl}?text=${encodeURIComponent(`Hello GoldPlus, I have a question about order ${order.orderNumber}.`)}`
  : biz.whatsappUrl;
---

<BaseLayout title={order ? `Order ${order.orderNumber}` : 'Order'}>
  <div class="container mx-auto px-4 lg:px-8 py-10 lg:py-14">

    {notFound ? (
        <div class="max-w-3xl mx-auto text-center py-12">
            <h1 class="text-3xl font-black mb-4">We could not find that order on this account</h1>
            <p class="text-brand-mutedGrey mb-8">If you ordered as a guest, before signing in, it will not be listed here, but you can still look it up with the order reference and the phone number or email you used at checkout.</p>
            <div class="flex flex-col sm:flex-row gap-3 justify-center">
              <a href="/track-order" class="inline-flex items-center justify-center rounded-full bg-brand-charcoal px-6 py-3 text-sm font-bold text-white hover:bg-black">Look up a guest order</a>
              <a href="/account/orders" class="inline-flex items-center justify-center rounded-full border border-brand-borderGrey px-6 py-3 text-sm font-bold text-brand-charcoal hover:bg-brand-softGrey">My orders</a>
            </div>
        </div>
    ) : (
        <div>
            <a href="/account" class="text-sm font-bold text-brand-mutedGrey hover:text-brand-charcoal mb-6 inline-block">&larr; Back to account</a>

            {fetchError && (
            <div class="mb-6">
                <Notice kind="warning" title="We could not load this order" message={fetchError}>
                  <p class="mt-2 text-xs"><a href={Astro.url.pathname} class="font-bold underline">Try again</a> · <a href={helpHref} class="font-bold underline">Ask us on WhatsApp</a></p>
                </Notice>
            </div>
            )}

            {order && status && (
            <div class="max-w-3xl">
                <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3 mb-6 pb-6 border-b border-brand-borderGrey">
                <div>
                    <p class="text-xs font-bold uppercase tracking-widest text-brand-mutedGrey mb-1">Order</p>
                    <h1 class="text-2xl md:text-3xl font-black text-brand-charcoal tracking-tight">{order.orderNumber}</h1>
                    <p class="text-sm text-brand-mutedGrey mt-1">Placed {new Date(order.createdAt).toLocaleString('en-GB')}</p>
                </div>
                <div class="sm:text-right">
                  <span class={`inline-flex items-center px-3 py-1 rounded border text-[10px] font-bold uppercase tracking-widest ${STATUS_TONE_CLASS[status.tone]}`}>{status.label}</span>
                  <p class="text-xs text-brand-mutedGrey mt-2 max-w-xs">{status.meaning}</p>
                </div>
                </div>

                <div class="bg-white border border-brand-borderGrey rounded-2xl overflow-hidden mb-6">
                <ul class="divide-y divide-brand-borderGrey" aria-label="Order items">
                    {order.items.map((item) => (
                    <li class="p-5 flex flex-col sm:flex-row items-start sm:items-center gap-3 sm:gap-5">
                        <div class="flex-grow min-w-0">
                        {item.productSlug ? (
                            <a href={`/products/${item.productSlug}`} class="font-bold text-brand-charcoal hover:underline">{item.productName}</a>
                        ) : (
                            <p class="font-bold text-brand-charcoal">{item.productName}</p>
                        )}
                        <p class="text-sm text-brand-mutedGrey mt-1">Qty {item.quantity} × {formatUgx(item.unitPriceUgx)}</p>
                        </div>
                        <p class="font-bold text-brand-charcoal whitespace-nowrap">{formatUgx(item.unitPriceUgx * item.quantity)}</p>
                    </li>
                    ))}
                </ul>
                <div class="p-5 bg-brand-softGrey border-t border-brand-borderGrey flex items-center justify-between">
                    <span class="font-bold text-brand-charcoal">Total</span>
                    <span class="text-xl font-black text-brand-charcoal">{formatUgx(order.totalAmountUgx)}</span>
                </div>
                </div>

                {isUnpaid && (
                <div id="pay">
                <Notice kind="info" title="This order is not paid yet">
                  <p class="text-xs mt-1 leading-relaxed">
                    You have not been charged. Pay for this order and we get it moving as soon as the payment clears. If you started paying online and it has not cleared, please do not pay again. Send us the order number and we will check.
                  </p>
                  {payMessage && <p class="mt-3 text-xs font-bold" role="alert">{payMessage}</p>}
                  <form method="POST" action={Astro.url.pathname} class="mt-4">
                    <button type="submit" class="inline-flex items-center justify-center rounded-full bg-brand-charcoal px-6 py-3 text-sm font-bold text-white hover:bg-black">Pay for this order</button>
                  </form>
                  <p class="mt-3 text-xs"><a href={helpHref} class="font-bold underline">Message us on WhatsApp</a> · <a href={biz.phoneDial} class="font-bold underline">Call {biz.phoneDisplay}</a></p>
                </Notice>
                </div>
                )}

                <div class="mt-6 flex flex-col sm:flex-row gap-3">
                  <a href={`/track-order?reference=${encodeURIComponent(order.orderNumber)}`} class="inline-flex items-center justify-center rounded-full bg-brand-charcoal px-6 py-3 text-sm font-bold text-white hover:bg-black">Track this order</a>
                  <a href={helpHref} class="inline-flex items-center justify-center rounded-full border border-brand-borderGrey px-6 py-3 text-sm font-bold text-brand-charcoal hover:bg-brand-softGrey">Ask about this order</a>
                </div>

                {(order.customer.email || order.customer.phone) && (
                <div class="bg-white border border-brand-borderGrey rounded-2xl p-5 mt-6">
                    <h2 class="text-xs font-bold uppercase tracking-widest text-brand-mutedGrey mb-3">We will contact you on</h2>
                    {order.customer.phone && <p class="text-sm text-brand-charcoal">{order.customer.phone}</p>}
                    {order.customer.email && <p class="text-sm text-brand-mutedGrey mt-1">{order.customer.email}</p>}
                </div>
                )}
            </div>
            )}
        </div>
    )}

  </div>
</BaseLayout>
