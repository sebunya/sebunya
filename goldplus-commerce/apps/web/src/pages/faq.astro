---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getBusinessInfo } from '../lib/businessInfo';
import { getStorefrontCopy } from '../lib/storefrontCopy';
import { serializeJsonLd, breadcrumbJsonLd } from '../lib/jsonld';
import { RETURNS_POLICY } from '../lib/returnsPolicy';
import { SITE_ORIGIN } from '../lib/sitemap';

/**
 * The questions customers actually ask, answered from what the site already
 * commits to — business info for the shop and delivery, the checkout's own
 * payment copy, the battery module for fitment, and the returns page's own
 * words. Nothing here is a new promise: a policy this page cannot source is
 * described exactly as the policy page describes it.
 *
 * The visible answers and the FAQPage data are built from the SAME array, so
 * the structured data can never drift from what a reader sees — which is both
 * Google's requirement and the reason an answer engine can quote it.
 */
const [biz, copy] = await Promise.all([getBusinessInfo(), getStorefrontCopy()]);

const cutoff = `${biz.sameDayCutoffHour % 12 || 12}${biz.sameDayCutoffHour >= 12 ? 'pm' : 'am'}`;
const faqs: Array<{ q: string; a: string; links?: Array<{ label: string; href: string }> }> = [
  {
    q: 'Do you deliver, and how long does it take?',
    a: `${biz.deliveryNote} Delivery runs ${biz.deliveryHours}, ${biz.openDays}. Order before ${cutoff} and your order goes out on the same day's run; after that it goes on the next one. An estimated delivery fee for your address is shown at checkout before you pay, and confirmed before the rider leaves; nothing is added after delivery.`,
    links: [{ label: 'Delivery details', href: '/delivery/kampala-wakiso' }],
  },
  {
    q: 'Where is the GoldPlus shop and when is it open?',
    a: `GoldPlus is at ${biz.addressLine1.replace(/\.$/, '')} — ${biz.addressLine2.replace(/\.$/, '')}. The shop is open ${biz.openDays}, ${biz.shopHours}. You can call or WhatsApp ${biz.phoneDisplay} before you come, and you are welcome to collect an online order at the shop instead of paying for delivery.`,
    links: [{ label: 'Find us on the map', href: biz.mapUrl }],
  },
  {
    q: 'How do I know which replacement battery fits my phone?',
    a: 'Three ways, and you never pay before the fit is confirmed. Search your phone in the battery finder; or read the code printed on the battery inside your phone and match it to the code in the product name; or send us your phone model on WhatsApp and we tell you which pack fits. Batteries whose fit we know are listed by the phone they fit — an iPhone 13 Pro battery says so in its name.',
    links: [{ label: 'Battery finder', href: '/battery-finder' }, { label: 'All batteries', href: '/shop?category=power-devices&q=battery' }],
  },
  {
    q: 'How can I pay?',
    a: `Two ways, both offered at checkout. ${copy.payment.pesapal.description} Or choose "${copy.payment.offline.label.toLowerCase()}": ${copy.payment.offline.description.charAt(0).toLowerCase()}${copy.payment.offline.description.slice(1)}`,
  },
  {
    q: 'Are GoldPlus products genuine, and what if something is faulty?',
    a: `GoldPlus is the brand as well as the shop: the products are GoldPlus-branded, and you can check the code from the security hologram on the verification page. Product pages list the maker's own specifications. If a product is faulty, we replace it or refund you, and GoldPlus pays the cost of getting it back to us — tell support what the fault is, with your order number. Changed your mind instead? Return it unused and complete within ${RETURNS_POLICY.windowDays} days of delivery or collection, and the refund goes back the way you paid; for a change-of-mind return the carriage back to us is yours.`,
    links: [{ label: 'Warranty', href: '/warranty' }, { label: 'Returns', href: '/returns' }, { label: 'Contact support', href: '/support' }],
  },
  {
    q: 'Does a larger wattage number mean faster charging for every phone?',
    a: 'No. The charger, the cable and the phone must support the same charging mode. For a charger with several ports, check the rating for the port you use and any shared-output limit printed on the label.',
    links: [{ label: 'Chargers', href: '/power/chargers' }, { label: 'Charging cables', href: '/power/charging-cables' }],
  },
  {
    q: 'Does 3A on a cable mean USB 3.0?',
    a: 'No. Amps describe electrical current. USB data speed is a separate specification. A cable marked 3A does not, by itself, establish USB 3.0 data transfer.',
    links: [{ label: 'Charging cables', href: '/power/charging-cables' }],
  },
  {
    q: 'Will a magnetic power bank work with my phone?',
    a: 'Wireless charging and magnetic attachment are separate questions. Check that your phone supports the relevant wireless charging method and that your phone or its case supports magnetic attachment. Ask us about the exact model before ordering.',
    links: [{ label: 'Power banks', href: '/power/power-banks' }],
  },
  {
    q: 'Why are two capacities printed on a battery label?',
    a: 'Some labels list both a rated capacity and a typical capacity. Keep those values separate when comparing batteries, and match the exact battery code and phone model first; capacity alone does not establish the fit.',
    links: [{ label: 'Phone batteries', href: '/phone-batteries' }],
  },
];

const canonical = `${SITE_ORIGIN}/faq`;
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${canonical}#faq`,
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
const crumbs = breadcrumbJsonLd([
  { name: 'GoldPlus', url: SITE_ORIGIN },
  { name: 'Shopping questions and product help', url: canonical },
]);
---
<BaseLayout
  title="Shopping Questions & Product Help | GoldPlus"
  description="Answers about product fit, connections, delivery, verification and support. Follow the relevant GoldPlus product or policy page for details."
  canonicalUrl={canonical}
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={serializeJsonLd(faqJsonLd)} />
    <script type="application/ld+json" is:inline set:html={serializeJsonLd(crumbs)} />
  </Fragment>

  <div class="bg-white">
    <section class="border-b border-slate-100 bg-gradient-to-b from-slate-50 to-white py-12 sm:py-16">
      <div class="container mx-auto max-w-3xl px-4 lg:px-8">
        <h1 class="text-3xl font-black tracking-tight text-slate-900 sm:text-4xl">Questions about choosing and ordering</h1>
        <p class="mt-3 text-base leading-relaxed text-slate-600">
          The things people ask us most, answered plainly. If yours is not here,
          <a href="/support" class="font-bold text-brand-primaryInk underline underline-offset-2">ask support</a> —
          we answer on WhatsApp on {biz.phoneDisplay}.
        </p>
      </div>
    </section>

    <section class="py-10 sm:py-14">
      <div class="container mx-auto max-w-3xl px-4 lg:px-8">
        <dl class="divide-y divide-slate-100">
          {faqs.map((f) => (
            <div class="py-7 first:pt-0">
              <dt class="text-lg font-black leading-snug text-slate-900">{f.q}</dt>
              <dd class="mt-3 text-[15px] leading-relaxed text-slate-600">
                {f.a}
                {f.links && (
                  <span class="mt-3 flex flex-wrap gap-x-5 gap-y-2">
                    {f.links.map((l) => (
                      <a
                        href={l.href}
                        class="text-sm font-bold text-brand-primaryInk underline underline-offset-2 hover:no-underline"
                        {...(l.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}
                      >{l.label} &rarr;</a>
                    ))}
                  </span>
                )}
              </dd>
            </div>
          ))}
        </dl>

        <div class="mt-10 rounded-2xl border border-slate-200 bg-slate-50 p-6">
          <h2 class="text-base font-black text-slate-900">Still stuck?</h2>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">
            Send us the phone model or the product code and we will tell you exactly what fits and what it costs, delivered.
          </p>
          <a href="/support" class="mt-4 inline-block rounded-xl bg-slate-900 px-6 py-3 text-xs font-black uppercase tracking-wider text-white hover:bg-black">Contact support</a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
