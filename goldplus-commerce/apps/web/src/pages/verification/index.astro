---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormField from '../../components/FormField.astro';
import FormFeedback from '../../components/FormFeedback.astro';
import { postJson } from '../../lib/api';

let status: 'success' | 'error' | 'received' | null = null;
let message: string | undefined;
let reference: string | undefined;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const code = String(form.get('code') ?? '').trim().toUpperCase();
  if (!code) {
    status = 'error';
    message = 'Please enter a verification code.';
  } else {
    const result = await postJson('/governance/verification/check', { code });
    reference = result.ok ? result.reference : undefined;
    if (!result.ok) {
      status = 'error';
      message = result.code === 'NETWORK'
        ? 'Cannot reach the verification service right now. Please try again shortly.'
        : result.message;
    } else {
      const data = result.data as { success?: boolean } | undefined;
      if (data?.success) {
        status = 'success';
        message = 'Verification code recognised. This product is registered with GoldPlus.';
      } else {
        status = 'received';
        message = 'Code not recognised, or already used. If you believe this is wrong, please report a fake product.';
      }
    }
  }
}
---

<BaseLayout title="Product Verification | GoldPlus">
  <div class="bg-brand-charcoal text-white py-16 border-b border-brand-borderGrey">
    <div class="container mx-auto px-4 lg:px-8 text-center">
      <span class="inline-flex items-center gap-1.5 py-1 px-3.5 rounded-full bg-brand-primary/15 text-brand-primary text-xs font-bold tracking-widest uppercase mb-4 border border-brand-primary/10">
        <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M2.166 4.9L10 1.154l7.834 3.746a1 1 0 01.586.904v4.32a9.002 9.002 0 01-4.707 7.925L10 19l-3.713-2.007a9.002 9.002 0 01-4.707-7.925v-4.32a1 1 0 01.586-.904zM10 3.018L3.999 5.892v3.232a7.001 7.001 0 003.659 6.16l2.342 1.266 2.342-1.266a7.001 7.001 0 003.659-6.16V5.892L10 3.018zm.707 6.293a1 1 0 00-1.414 0L7.5 11.086 6.707 10.293a1 1 0 00-1.414 1.414l1.5 1.5a1 1 0 001.414 0l2.5-2.5a1 1 0 000-1.414z" clip-rule="evenodd"></path></svg>
        GoldPlus Shield
      </span>
      <h1 class="text-3xl md:text-5xl font-black tracking-tight mb-4 text-white">Verify your product</h1>
      <p class="text-gray-300 max-w-2xl mx-auto text-base md:text-lg leading-relaxed font-medium">
        Every authentic GoldPlus product carries a unique verification code. Enter it below to confirm your purchase is genuine.
      </p>
    </div>
  </div>

  <div class="container mx-auto px-4 lg:px-8 py-16">
    <div class="max-w-2xl mx-auto">
      <FormFeedback status={status} message={message} reference={reference} />

      <div class="bg-white p-8 md:p-10 rounded-3xl border border-brand-borderGrey shadow-xl mb-10">
        <form method="POST" action="/verification" novalidate class="space-y-6">
          <FormField
            id="code"
            name="code"
            label="Verification code"
            type="text"
            required
            placeholder="GP-XXXX-XXXX-XXXX"
            helperText="Find this code on the security hologram on your product packaging."
            autocomplete="off"
          />
          <button type="submit" class="w-full bg-brand-primary text-brand-charcoal py-4 rounded-xl font-bold text-base hover:opacity-90 focus-visible:ring-4 focus-visible:ring-brand-primary/30 outline-none transition-all shadow-md shadow-brand-primary/10">
            Verify code
          </button>
        </form>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-10">
        <div class="bg-brand-softGrey border border-brand-borderGrey rounded-2xl p-6">
          <p class="text-[10px] font-bold uppercase tracking-widest text-brand-mutedGrey mb-2">Privacy & Transparency</p>
          <p class="text-xs text-brand-charcoal leading-relaxed font-medium">Each attempt is logged with anonymised metadata so we can detect counterfeit hot-spots. We never share personal data.</p>
        </div>
        <div class="bg-brand-softGrey border border-brand-borderGrey rounded-2xl p-6">
          <p class="text-[10px] font-bold uppercase tracking-widest text-brand-mutedGrey mb-2">Single use</p>
          <p class="text-xs text-brand-charcoal leading-relaxed font-medium">Codes can only be verified once. If a code is already used, it usually means the package was opened before you bought it.</p>
        </div>
      </div>

      <div class="bg-red-50 border border-red-100 rounded-3xl p-8 text-center">
        <h2 class="text-lg font-bold text-brand-error mb-2">Code not working?</h2>
        <p class="text-red-750 mb-6 text-sm font-medium leading-relaxed max-w-md mx-auto">If your code is rejected or the package was tampered with, report it. We investigate every submission.</p>
        <a href="/support/fake" class="inline-block px-6 py-3 bg-brand-error text-white rounded-xl font-bold hover:opacity-90 transition-all text-sm shadow-md shadow-brand-error/10">Report fake product</a>
      </div>
    </div>
  </div>
</BaseLayout>
