---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormField from '../../components/FormField.astro';
import FormFeedback from '../../components/FormFeedback.astro';
import { postJson } from '../../lib/api';

let status: 'success' | 'error' | 'received' | null = null;
let message: string | undefined;
let reference: string | undefined;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const code = String(form.get('code') ?? '').trim().toUpperCase();
  if (!code) {
    status = 'error';
    message = 'Please enter a verification code.';
  } else {
    const result = await postJson('/governance/verification/check', { code });
    reference = result.ok ? result.reference : undefined;
    if (!result.ok) {
      status = 'error';
      message = result.code === 'NETWORK'
        ? 'Cannot reach the verification service right now. Please try again shortly.'
        : result.message;
    } else {
      const data = result.data as { success?: boolean } | undefined;
      if (data?.success) {
        status = 'success';
        message = 'Verification code recognised. This product is registered with GoldPlus.';
      } else {
        status = 'received';
        message = 'Code not recognised, or already used. If you believe this is wrong, please report a fake product.';
      }
    }
  }
}
---

<BaseLayout title="Product Verification">
  <div class="bg-brand-dark text-white py-16 border-b border-gray-800">
    <div class="container mx-auto px-4 lg:px-8 text-center">
      <span class="inline-block py-1 px-3 rounded-full bg-brand-green/15 text-brand-green text-xs font-bold tracking-widest uppercase mb-4">
        GoldPlus Shield
      </span>
      <h1 class="text-3xl md:text-5xl font-black tracking-tight mb-4">Verify your product</h1>
      <p class="text-gray-300 max-w-2xl mx-auto text-lg leading-relaxed">
        Every authentic GoldPlus product carries a unique verification code. Enter it below to confirm your purchase is genuine.
      </p>
    </div>
  </div>

  <div class="container mx-auto px-4 lg:px-8 py-12">
    <div class="max-w-2xl mx-auto">
      <FormFeedback status={status} message={message} reference={reference} />

      <div class="bg-white p-8 rounded-2xl border border-gray-200 shadow-xl mb-10">
        <form method="POST" action="/verification" novalidate class="space-y-6">
          <FormField
            id="code"
            name="code"
            label="Verification code"
            type="text"
            required
            placeholder="GP-XXXX-XXXX-XXXX"
            helperText="Find this code on the security hologram on your product packaging."
            autocomplete="off"
          />
          <button type="submit" class="w-full bg-brand-green text-white py-4 rounded-xl font-bold text-lg hover:opacity-90 focus-visible:ring-4 focus-visible:ring-brand-green/30 outline-none transition-all">
            Verify code
          </button>
        </form>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8">
        <div class="bg-white border border-gray-200 rounded-xl p-5">
          <p class="text-xs font-bold uppercase tracking-widest text-gray-500 mb-2">Privacy</p>
          <p class="text-sm text-gray-700 leading-relaxed">Each attempt is logged with anonymised metadata so we can detect counterfeit hot-spots. We never share personal data.</p>
        </div>
        <div class="bg-white border border-gray-200 rounded-xl p-5">
          <p class="text-xs font-bold uppercase tracking-widest text-gray-500 mb-2">Single use</p>
          <p class="text-sm text-gray-700 leading-relaxed">Codes can only be verified once. If a code is already used, it usually means the package was opened before you bought it.</p>
        </div>
      </div>

      <div class="bg-red-50 border border-red-100 rounded-2xl p-6 text-center">
        <h2 class="text-lg font-bold text-red-800 mb-2">Code not working?</h2>
        <p class="text-red-700 mb-4 text-sm">If your code is rejected or the package was tampered with, report it. We investigate every submission.</p>
        <a href="/support/fake" class="inline-block px-5 py-2 bg-red-600 text-white rounded-lg font-bold hover:bg-red-700 transition-colors">Report fake product</a>
      </div>
    </div>
  </div>
</BaseLayout>
