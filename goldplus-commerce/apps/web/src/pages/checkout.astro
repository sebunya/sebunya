---
import BaseLayout from '../layouts/BaseLayout.astro';
import Notice from '../components/Notice.astro';
import FormField from '../components/FormField.astro';
import { apiBase } from '../lib/api';
import { readCartSessionId } from '../lib/cart-session';
import type { ApiEnvelope } from '@goldplus/shared';

interface CartItem {
  productId: string;
  slug: string;
  name: string;
  quantity: number;
  unitPriceUgx: number;
}

interface CartResponse {
  id: string;
  items: CartItem[];
  subtotalUgx: number;
}

const sessionId = readCartSessionId(Astro.request);

if (!sessionId) {
  return Astro.redirect('/cart', 303);
}

let cart: CartResponse | null = null;
try {
  const res = await fetch(`${apiBase}/commerce/carts/${encodeURIComponent(sessionId)}`, {
    headers: { Accept: 'application/json' },
  });
  if (res.ok) {
    const json = (await res.json()) as ApiEnvelope<CartResponse>;
    if (json.success && json.data) cart = json.data;
  }
} catch {
  /* fall through; checkout will redirect to /cart below */
}

if (!cart || cart.items.length === 0) {
  return Astro.redirect('/cart', 303);
}

const formatUgx = (n: number): string =>
  new Intl.NumberFormat('en-UG', { style: 'currency', currency: 'UGX', maximumFractionDigits: 0 }).format(n);
