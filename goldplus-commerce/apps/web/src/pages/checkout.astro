---
import BaseLayout from '../layouts/BaseLayout.astro';
import Notice from '../components/Notice.astro';
import FormField from '../components/FormField.astro';
import FormFeedback from '../components/FormFeedback.astro';
import UgandaLocationPicker from '../components/UgandaLocationPicker.astro';
import { apiBase, postJson } from '../lib/api';
import { readCartSessionId } from '../lib/cart-session';
import { prepareCheckoutPayload, validateCheckoutPayload } from '../lib/checkout';
import { parseLocalCartCookie } from '../lib/cart';
import { resolveCheckoutIntent, clearCheckoutIntent } from '../lib/checkoutIntent';
import { resolveAuthenticatedUserId } from '../lib/customerAuth';
import { cartClient } from '../lib/cartClient';
import { resolveCartCredential, clearCartCredential } from '../lib/cartCredential';
import { checkRequestOrigin, CROSS_SITE_MESSAGE } from '../lib/requestOrigin';
import {
  submitCheckout,
  customerMessageFor,
  startPayment,
  paymentStartMessageFor,
} from '../lib/checkoutClient';
import { mayStartPayment } from '@goldplus/shared';
import type { ApiEnvelope } from '@goldplus/shared';

interface CartItem {
  productId: string;
  slug: string;
  name: string;
  sku?: string;
  quantity: number;
  unitPriceUgx: number;
  priceUgx: number; // Normalized used in cart logic
}

interface CartResponse {
  id: string;
  items: CartItem[];
  subtotalUgx: number;
}

// Resolved ONCE for the whole render: the cart credential, the account-context
// prefill and the POST branch all need the same answer, and this call costs a
// round-trip to the API.
const authenticatedUserId = await resolveAuthenticatedUserId(Astro.cookies);

// The basket is read through the SIGNED CREDENTIAL, not a cart id in the URL. The
// credential also names the owner, so a signed-in customer cannot be served a guest
// basket and vice versa.
const cartCredential = resolveCartCredential(Astro.cookies, authenticatedUserId);
if (!cartCredential) {
  return Astro.redirect('/cart', 303);
}

let cart: CartResponse | null = null;
const serverCart = await cartClient.read(
  cartCredential.token,
  Astro.cookies.get('goldplus_session')?.value ?? null,
);
if (serverCart.ok) {
  cart = {
    id: serverCart.cart.id,
    items: serverCart.cart.items.map((line) => ({
      productId: line.productId,
      name: line.name,
      quantity: line.quantity,
      unitPriceUgx: line.unitPriceUgx,
      priceUgx: line.unitPriceUgx,
    })) as CartResponse['items'],
    subtotalUgx: serverCart.cart.subtotalUgx,
  };
}

// Fallback to local cookie state if API failed or returned empty!
if (!cart || cart.items.length === 0) {
  const localDataCookie = Astro.cookies.get('goldplus_cart_data')?.value;
  const items = parseLocalCartCookie(localDataCookie) as any[];
  if (items.length > 0) {
    const subtotalUgx = items.reduce((acc, item) => acc + ((item.unitPriceUgx || item.priceUgx) * item.quantity), 0);
    cart = {
      // The credential's cart id, so the local fallback and the server basket refer to
      // the same basket rather than to whatever the browser last held.
      id: cartCredential.cartId,
      items,
      subtotalUgx
    };
  }
}

if (!cart || cart.items.length === 0) {
  return Astro.redirect('/cart', 303);
}

// Setup form state for lifecycle
let status: 'success' | 'error' | 'received' | null = null;
let message: string | undefined;
let reference: string | undefined;
let createdOrderId: string | undefined;
let values: Record<string, string> = {};
let errors: Record<string, string> = {};
let isOfflineDraft = false;

// The checkout intent is resolved on EVERY render, including the initial GET.
//
// It previously lived inside the POST branch, which meant the initial GET issued
// no cookie at all and the template's reference to the derived key was a
// ReferenceError — the checkout page was broken on first load. `pnpm build`
// passed throughout, which is why build success is not evidence about the GET
// path.
//
// It is issued in this layer because the layer that owns the browser connection
// is the only one that can own the cookie: the API's Set-Cookie lands on this
// server's fetch response and never reaches the browser.

// ---------------------------------------------------------------------------
// Account context: everything the platform already knows about this customer.
// A returning customer should CONFIRM a checkout, not retype it. Every fetch
// here is timeout-guarded and failure-tolerant — prefill going missing must
// degrade to the blank form, never to a broken page.
// ---------------------------------------------------------------------------
interface SavedAddress {
  id: string;
  label: string;
  recipientName: string;
  phone: string;
  district: string;
  areaDetails: string;
  isDefault: boolean;
}
const sessionToken = Astro.cookies.get('goldplus_session')?.value ?? null;
let savedAddresses: SavedAddress[] = [];
let accountEmail = '';
if (authenticatedUserId && sessionToken) {
  try {
    const [addrRes, meRes] = await Promise.all([
      fetch(`${apiBase}/account/addresses`, {
        headers: { Authorization: `Bearer ${sessionToken}` },
        signal: AbortSignal.timeout(3000),
      }),
      fetch(`${apiBase}/account/me`, {
        headers: { Authorization: `Bearer ${sessionToken}` },
        signal: AbortSignal.timeout(3000),
      }),
    ]);
    const addrJson: any = addrRes.ok ? await addrRes.json().catch(() => null) : null;
    const meJson: any = meRes.ok ? await meRes.json().catch(() => null) : null;
    if (addrJson?.success && Array.isArray(addrJson.data)) savedAddresses = addrJson.data;
    if (meJson?.success) accountEmail = meJson.data?.email ?? '';
  } catch {
    /* prefill is a convenience, never a dependency */
  }
}
const defaultAddress = savedAddresses.find((a) => a.isDefault) ?? savedAddresses[0] ?? null;

// Live programme terms for the earn preview. Zero when inactive or unreachable —
// the preview line simply does not render rather than promising points.
let loyaltyProgramme: { active: boolean; earnRatePer1000Ugx: number } = { active: false, earnRatePer1000Ugx: 0 };
try {
  const lpRes = await fetch(`${apiBase}/commerce/loyalty-programme`, { signal: AbortSignal.timeout(2500) });
  const lpJson: any = lpRes.ok ? await lpRes.json().catch(() => null) : null;
  if (lpJson?.success && lpJson.data?.active) {
    loyaltyProgramme = { active: true, earnRatePer1000Ugx: Number(lpJson.data.earnRatePer1000Ugx) || 0 };
  }
} catch {
  /* preview only */
}

// Guest memory: details from their last completed checkout, held in an
// httpOnly cookie on their own device so a repeat guest confirms instead of
// retyping. Signed-in customers use their address book instead.
const GUEST_PREFILL_COOKIE = 'gp_checkout_prefill';
let guestPrefill: Record<string, string> = {};
if (!authenticatedUserId) {
  try {
    const raw = Astro.cookies.get(GUEST_PREFILL_COOKIE)?.value;
    if (raw) {
      const parsed = JSON.parse(decodeURIComponent(raw));
      if (parsed && typeof parsed === 'object') {
        for (const k of ['name', 'email', 'phone', 'locationJson', 'deliveryAddress']) {
          if (typeof parsed[k] === 'string' && parsed[k].length <= 600) guestPrefill[k] = parsed[k];
        }
      }
    }
  } catch {
    /* stale/corrupt cookie = no prefill */
  }
}

// Cross-site refusal comes BEFORE the intent is resolved, because resolving it can
// MINT one. A cross-site POST arrives without the SameSite=Lax cookie, and the
// response to a missing cookie was to manufacture a fresh guest identity and place
// an order under it — a request the browser had already labelled cross-site was
// answered by inventing an identity for it.
const originDecision =
  Astro.request.method === 'POST'
    ? checkRequestOrigin(Astro.request, import.meta.env as unknown as Record<string, string | undefined>)
    : ({ allowed: true, basis: 'SEC_FETCH_SITE' } as const);

if (!originDecision.allowed) {
  status = 'error';
  message = CROSS_SITE_MESSAGE;
}

// Not resolved at all on a refused request: resolving MINTS, and a cross-site POST
// has no business being issued a checkout identity.
const checkoutIntent = originDecision.allowed
  ? resolveCheckoutIntent(Astro.cookies, authenticatedUserId)
  : null;
if (originDecision.allowed && !checkoutIntent) {
  // Refuse rather than fall back to an unsigned identity, which would make every
  // retry a new operation and therefore a new order.
  throw new Error('CHECKOUT_INTENT_SECRET is not configured');
}

// Handle Form Submission (RESTORED FEATURE)
if (Astro.request.method === 'POST' && originDecision.allowed && checkoutIntent) {
  const formData = await Astro.request.formData();
  
  // Extract raw strings for re-populating inputs on errors
  values = {
    name: String(formData.get('name') || '').trim(),
    email: String(formData.get('email') || '').trim(),
    phone: String(formData.get('phone') || '').trim(),
    locationJson: String(formData.get('locationJson') || '').trim(),
    deliveryAddress: String(formData.get('deliveryAddress') || '').trim(),
  };

  // A saved-address id is only meaningful for a signed-in customer; the id is
  // re-fetched server-side below, so a tampered value can select nothing but
  // that customer's own addresses.
  const selectedAddressId = authenticatedUserId ? String(formData.get('addressId') || '').trim() : '';
  const selectedAddress = selectedAddressId
    ? savedAddresses.find((a) => a.id === selectedAddressId) ?? null
    : null;

  // Simple validation checks
  if (!values.name) errors.name = 'Full name is required.';
  if (!values.phone) errors.phone = 'Contact phone number is required.';
  // A chosen saved address IS the delivery location; the picker is only
  // required when delivering somewhere new.
  if (!selectedAddress && !values.locationJson) errors.locationJson = 'Please select a delivery location.';
  // The landmark line is what the rider actually navigates by — required for a
  // new address; a saved address already carries its area details.
  if (!selectedAddress && !values.deliveryAddress) errors.deliveryAddress = 'Add the estate, road, building or landmark our rider should look for.';

  if (Object.keys(errors).length === 0) {
     // Prepare mapped payload compatible with Commerce API
     // Map priceUgx field since interface varies slightly between cart api and checkout lib
     const normalizedItems = cart.items.map(i => ({ ...i, priceUgx: i.priceUgx || i.unitPriceUgx }));
     const payload = prepareCheckoutPayload(formData, normalizedItems as any);
     if (selectedAddress) {
       payload.customerDetails = {
         name: values.name,
         email: values.email || undefined,
         phone: values.phone,
         deliveryArea: `${selectedAddress.areaDetails}, ${selectedAddress.district}`,
         deliveryAddress: [selectedAddress.areaDetails, values.deliveryAddress].filter(Boolean).join(' | '),
         deliveryLocation: { district: selectedAddress.district },
       };
     }
     const paymentMethod = String(formData.get('paymentMethod') || 'offline').trim();
     
     // Typed BFF call. The generic postJson helper returned `data: unknown` and
     // dropped every response header, which is how the API's move to a minimal
     // DTO returning `orderId` went unnoticed while this page read `res.data.id`:
     // the value was simply undefined, the PesaPal branch was skipped, and the
     // customer saw the offline-review message instead of being sent to pay.
     const result = await submitCheckout({
        request: {
           customerDetails: payload.customerDetails,
           buyerType: payload.buyerType,
           items: payload.items,
           // Fingerprint inputs: switching between paying online and ordering offline is
           // a different operation, and the basket version pins which basket state the
           // customer was actually looking at.
           paymentMethod: paymentMethod === 'pesapal' ? 'pesapal' : 'offline',
           cartId: serverCart.ok ? serverCart.cart.id : null,
           cartVersion: serverCart.ok ? serverCart.cart.version : null,
        },
        intentToken: checkoutIntent.token,
        sessionToken: Astro.cookies.get('goldplus_session')?.value ?? null,
     });

     const outcome = customerMessageFor(result);

     if (result.ok) {
        const dto = result.data;
        reference = dto.orderNumber || dto.orderId;
        createdOrderId = dto.orderId;

        // The order exists from this point on whatever the payment path does,
        // so the "remember for next time" work happens here, before any
        // redirect can end the render.
        if (!authenticatedUserId) {
          try {
            Astro.cookies.set(
              GUEST_PREFILL_COOKIE,
              encodeURIComponent(JSON.stringify({
                name: values.name,
                email: values.email,
                phone: values.phone,
                locationJson: values.locationJson,
                deliveryAddress: values.deliveryAddress,
              })),
              { path: '/checkout', maxAge: 60 * 60 * 24 * 180, httpOnly: true, sameSite: 'lax', secure: import.meta.env.PROD },
            );
          } catch { /* memory is a convenience */ }
        } else if (!selectedAddress && sessionToken && String(formData.get('saveAddress') || '') === 'true') {
          // Best-effort: a failed save must never disturb an order that succeeded.
          const district = payload.customerDetails.deliveryLocation?.district;
          if (district) {
            try {
              await fetch(`${apiBase}/account/addresses`, {
                method: 'POST',
                headers: { Authorization: `Bearer ${sessionToken}`, 'Content-Type': 'application/json' },
                signal: AbortSignal.timeout(3000),
                body: JSON.stringify({
                  label: district,
                  recipientName: values.name,
                  phone: values.phone,
                  district,
                  areaDetails: payload.customerDetails.deliveryArea,
                  makeDefault: savedAddresses.length === 0,
                }),
              });
            } catch { /* best-effort */ }
          }
        }

        // Payment starts ONLY when the server says the order is payable. The
        // previous condition was just "we have an order id", which would start a
        // payment for a stock-blocked or already-paid order.
        if (paymentMethod === 'pesapal' && mayStartPayment(dto)) {
           // Typed, and the intent is forwarded: the API cannot authorize this
           // caller without it. The previous untyped call also showed the API's
           // own error text to the customer on failure.
           const payRes = await startPayment({
              orderId: dto.orderId,
              intentToken: checkoutIntent.token,
              sessionToken: Astro.cookies.get('goldplus_session')?.value ?? null,
           });

           if (payRes.ok) {
              // The intent is DELIBERATELY RETAINED across the redirect.
              //
              // Clearing it here looked like tidy consumption, but the handoff is the
              // point at which the customer leaves this system, and every way they can
              // come back needs the same identity:
              //
              //   - the redirect is lost on a flaky mobile connection
              //   - they refresh, or press back
              //   - they abandon the bank page and return to /checkout
              //   - the provider sends them back to the return URL
              //
              // Without the intent, each of those is a NEW operation and therefore a
              // NEW order for a customer who already has one being paid for. The intent
              // is consumed when the order actually settles, not when it is handed over.
              //
              // The cart cookie IS cleared: the basket has become an order, and leaving
              // it would re-add the same items to the next checkout.
              Astro.cookies.delete('goldplus_cart_data', { path: '/' });
              return Astro.redirect(payRes.data.redirectUrl, 303);
           }

           // The order EXISTS and is payable; only the handoff failed. The intent
           // is kept so the customer can retry onto the same order rather than
           // creating a second one.
           status = 'error';
           reference = dto.orderNumber || dto.orderId;
           message = paymentStartMessageFor(payRes.code);
        } else if (outcome.status === 'awaiting_payment') {
           // Payable, but the customer chose the offline path.
           status = 'received';
           message = 'Order successfully created for review. Our logistics team will contact you with final pricing.';
           clearCheckoutIntent(Astro.cookies);
           Astro.cookies.delete('goldplus_cart_data', { path: '/' });
        } else {
           status = outcome.status === 'error' ? 'error' : 'received';
           message = outcome.message;
           if (outcome.status !== 'error') {
              clearCheckoutIntent(Astro.cookies);
              Astro.cookies.delete('goldplus_cart_data', { path: '/' });
           }
        }
     } else if (result.code === 'STOCK_NOT_RESERVED' && result.details) {
        // The order exists and is recorded truthfully; it simply cannot be paid.
        status = 'error';
        message = outcome.message;
        reference = result.details.orderNumber || result.details.orderId;
     } else if (outcome.status === 'retry') {
        // NETWORK or CHECKOUT_IN_PROGRESS: the intent cookie is deliberately
        // KEPT, so retrying reaches the same operation instead of creating a
        // second order.
        status = 'error';
        message = outcome.message;
     } else {
        const allowDraft = String(formData.get('allowOfflineDraft') || '') === 'true';
        if (allowDraft) {
           status = 'received';
           isOfflineDraft = true;
           reference = `GP-DRAFT-${Math.floor(100000 + Math.random() * 900000)}`;
           message = 'Offline draft saved on this device. Order was not submitted to the server.';
           
           // Clear browser cart cookie contents only when explicitly choosing a local draft
           Astro.cookies.delete('goldplus_cart_data', { path: '/' });
        } else {
           status = 'error';
           // `res` was a leftover from the untyped postJson call this branch used
           // to make. It is scoped to the cart-fetch block far above, so reaching
           // this line threw a ReferenceError and the customer got a 500 instead
           // of a message — on the ONE path that exists to explain a failure.
           // Found by the end-to-end harness; typecheck and build both passed.
           message = outcome.message || 'Failed to submit order. The checkout service is temporarily offline. You may retry, or check "Save as offline draft on this device" below to proceed in local demonstration mode.';
           // Preserve the cart cookie on failure so items are not lost!
        }
     }
  } else {
     status = 'error';
     message = 'Fix form errors before submitting.';
  }
}

// Initial GET: the form opens already filled with what the platform knows —
// account holders from their address book, returning guests from their own
// last checkout. Confirming beats retyping; everything stays editable.
if (Astro.request.method !== 'POST') {
  if (authenticatedUserId) {
    values = {
      name: defaultAddress?.recipientName ?? '',
      email: accountEmail,
      phone: defaultAddress?.phone ?? '',
      locationJson: '',
      deliveryAddress: '',
    };
  } else {
    values = {
      name: guestPrefill.name ?? '',
      email: guestPrefill.email ?? '',
      phone: guestPrefill.phone ?? '',
      locationJson: guestPrefill.locationJson ?? '',
      deliveryAddress: guestPrefill.deliveryAddress ?? '',
    };
  }
}

// Same deterministic rule the ledger applies (floor per 1,000 UGX × rate),
// previewed on the subtotal. Points are credited when the order is PAID —
// the copy says so; this is a preview, not a promise of unpaid points.
const potentialPoints = loyaltyProgramme.active
  ? Math.floor(cart.subtotalUgx / 1000) * loyaltyProgramme.earnRatePer1000Ugx
  : 0;

// Initial delivery estimate for the preselected saved address, so a returning
// customer sees a delivery figure without touching anything. Guests get one
// the moment they pick a location (client-side, same public endpoint).
// CONFIRMED comes only from an operator zone and IS charged on the order;
// ESTIMATED is advisory and never added to the total shown here.
interface DeliveryEstimateView {
  kind: 'CONFIRMED' | 'ESTIMATED' | 'UNAVAILABLE';
  feeUgx: number | null;
  km: number | null;
}
let initialDeliveryEstimate: DeliveryEstimateView | null = null;
if (defaultAddress) {
  try {
    const deRes = await fetch(
      `${apiBase}/commerce/delivery-estimate?district=${encodeURIComponent(defaultAddress.district)}`,
      { signal: AbortSignal.timeout(2500) },
    );
    const deJson: any = deRes.ok ? await deRes.json().catch(() => null) : null;
    if (deJson?.success) initialDeliveryEstimate = deJson.data.estimate;
  } catch {
    /* estimate is advisory */
  }
}

const formatUgx = (n: number): string =>
  new Intl.NumberFormat('en-UG', { style: 'currency', currency: 'UGX', maximumFractionDigits: 0 }).format(n);
---

<BaseLayout title="Checkout">
  <div class="bg-gradient-to-b from-slate-50 to-white py-10 border-b border-slate-100">
    <div class="container mx-auto px-4 lg:px-8">
      <h1 class="text-2xl md:text-3xl font-black tracking-tight text-gray-900 mb-2">Checkout</h1>
      <p class="text-slate-500 max-w-2xl text-sm">Verify your delivery zone accurately to accelerate shipment processing time.</p>
    </div>
  </div>

  <div class="container mx-auto px-4 lg:px-8 py-10">
    
    {status === 'received' ? (
      <div class="max-w-2xl mx-auto text-center py-16 bg-white border border-slate-200/80 rounded-2xl shadow-xs px-6">
         {isOfflineDraft ? (
           <>
              <div class="w-16 h-16 bg-amber-50 text-amber-600 rounded-full flex items-center justify-center mx-auto mb-6 border border-amber-100 shadow-xs">
               <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
             </div>
             <h2 class="text-2xl font-black text-gray-900 mb-2">Offline Draft Saved</h2>
             <p class="text-[10px] font-black text-amber-800 bg-amber-50 border border-amber-200/60 px-3 py-1 rounded-full inline-block mb-6 uppercase tracking-wider">Local Demo Mode Only</p>
             <p class="text-slate-550 text-base mb-6">Local Draft Reference: <strong class="font-mono bg-slate-50 px-2 py-0.5 rounded text-gray-900 border border-slate-200/40">{reference}</strong></p>
             <p class="text-amber-700 font-semibold max-w-md mx-auto mb-10 leading-relaxed bg-amber-50/50 border border-amber-200/60 p-4 rounded-xl text-xs text-left shadow-xs">
               Notice: The server is currently offline. This order has <strong>not</strong> been submitted to the GoldPlus distribution team. Please screenshot this reference page or retry when connection is restored.
             </p>
           </>
         ) : (
           <>
              <div class="w-16 h-16 bg-emerald-50 text-emerald-600 rounded-full flex items-center justify-center mx-auto mb-6 border border-emerald-100 shadow-xs">
               <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
             </div>
             <h2 class="text-2xl font-black text-gray-900 mb-2">Order Received</h2>
             <p class="text-slate-550 text-base mb-6">Reference: <strong class="font-mono bg-slate-50 px-2 py-0.5 rounded text-gray-900 border border-slate-200/40">{reference}</strong></p>
             <p class="text-slate-500 max-w-md mx-auto mb-10 leading-relaxed text-sm">Our distribution center will evaluate transit routing and contact you soon to confirm final delivery logistics.</p>
           </>
         )}
         <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
           {!isOfflineDraft && createdOrderId && (
             <a href={`/orders/${createdOrderId}`} class="inline-block bg-brand-primary text-gray-950 px-8 py-2.5 rounded-full font-bold hover:shadow-lg hover:shadow-brand-primary/20 transition-all text-xs tracking-wider uppercase cursor-pointer hover:scale-[1.01] active:scale-95">View &amp; track this order</a>
           )}
           <a href="/shop" class="inline-block bg-slate-900 text-white px-8 py-2.5 rounded-full font-bold hover:bg-slate-950 transition-all text-xs tracking-wider uppercase cursor-pointer hover:scale-[1.01] active:scale-95">Continue shopping</a>
         </div>
         {!isOfflineDraft && !authenticatedUserId && (
           <div class="mt-8 mx-auto max-w-md rounded-xl border border-amber-200/60 bg-amber-50 px-5 py-4 text-left">
             <p class="text-sm font-bold text-amber-900">Create a free account to get more from GoldPlus</p>
             <p class="text-xs text-amber-800 mt-1.5 leading-relaxed">Track orders in one place, save delivery addresses for one-tap checkout, and earn GoldPlus points on every paid order.</p>
             <a href="/register?returnTo=/account" class="inline-block mt-3 rounded-full bg-brand-dark px-5 py-2 text-[11px] font-black uppercase tracking-widest text-white hover:bg-black">Create account</a>
           </div>
         )}
      </div>
    ) : (
      <div class="flex flex-col lg:flex-row gap-10">

        <div class="w-full lg:w-2/3">
          <FormFeedback status={status} message={message} />
          
          <form method="POST" action="/checkout" novalidate class="space-y-6 mt-4">
            <!-- Slice 3B: idempotency key — a resubmitted/double-clicked form returns the same order -->
            {/*
              No hidden order key. A hidden field is caller-controlled, so it can
              never be the authoritative operation identity — a client could vary
              it to force a duplicate order, or reuse another customer's. The
              identity is derived server-side from the verified principal and the
              signed intent id.
            */}
            <div class="bg-white p-6 md:p-8 rounded-2xl border border-slate-200/80 shadow-xs">
              <h2 class="text-base md:text-lg font-black text-gray-900 mb-6 flex items-center gap-2.5">
                <span aria-hidden="true" class="w-6 h-6 rounded-full bg-slate-900 text-white flex items-center justify-center text-xs font-black">1</span>
                Customer details
              </h2>
              
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                <FormField id="name" name="name" label="Full name" required autocomplete="name" defaultValue={values.name} errorMessage={errors.name} />
                <FormField id="email" name="email" label="Email" type="email" autocomplete="email" defaultValue={values.email} />
                <FormField id="phone" name="phone" label="Phone (MTN / Airtel)" type="tel" required inputmode="tel" placeholder="07XX XXX XXX" defaultValue={values.phone} errorMessage={errors.phone} />
                <div class="md:col-span-2 space-y-4">
                   {savedAddresses.length > 0 && (
                     <fieldset class="space-y-2">
                       <legend class="text-sm font-bold text-gray-900 mb-2">Deliver to</legend>
                       {savedAddresses.map((a) => (
                         <label class="flex items-start gap-3 p-3.5 border border-slate-200/70 rounded-xl hover:border-brand-primary cursor-pointer select-none bg-slate-50/30 transition-all has-[:checked]:border-brand-primary has-[:checked]:bg-brand-primary/5">
                           <input
                             type="radio"
                             name="addressId"
                             value={a.id}
                             data-district={a.district}
                             checked={a.id === defaultAddress?.id}
                             class="mt-1 w-4 h-4 text-brand-primary border-slate-250 focus:ring-brand-primary cursor-pointer js-address-choice"
                           />
                           <span class="min-w-0">
                             <span class="font-bold text-gray-900 text-sm">{a.label}</span>
                             {a.isDefault && <span class="ml-2 text-[10px] font-black uppercase tracking-widest text-brand-primary">Default</span>}
                             <span class="block text-xs text-slate-500 mt-0.5">{a.recipientName} · {a.phone}</span>
                             <span class="block text-xs text-slate-500">{a.areaDetails}, {a.district}</span>
                           </span>
                         </label>
                       ))}
                       <label class="flex items-center gap-3 p-3.5 border border-dashed border-slate-300 rounded-xl hover:border-brand-primary cursor-pointer select-none transition-all has-[:checked]:border-brand-primary">
                         <input type="radio" name="addressId" value="" class="w-4 h-4 text-brand-primary border-slate-250 focus:ring-brand-primary cursor-pointer js-address-choice" />
                         <span class="font-bold text-gray-900 text-sm">Deliver somewhere else</span>
                       </label>
                     </fieldset>
                   )}
                   <div id="new-address-fields" class="space-y-4">
                     <UgandaLocationPicker
                       name="locationJson"
                       label="Delivery location"
                       helperText="Type the area, town or district you know — e.g. Najjera, Seeta, Mbarara."
                       required={savedAddresses.length === 0}
                       defaultValue={values.locationJson}
                       errorMessage={errors.locationJson}
                     />
                     <FormField
                       id="deliveryAddress"
                       name="deliveryAddress"
                       label="Exact address — estate, road, building or landmark"
                       placeholder="e.g. Kigoowa Road, gate after Capital Shoppers"
                       required
                       defaultValue={values.deliveryAddress}
                       errorMessage={errors.deliveryAddress}
                     />
                     {authenticatedUserId && (
                       <label class="flex items-center gap-2.5 text-sm text-slate-600 cursor-pointer select-none">
                         <input type="checkbox" name="saveAddress" value="true" checked class="w-4 h-4 rounded border-slate-300 text-brand-primary focus:ring-brand-primary cursor-pointer" />
                         <span>Save this address to my account for faster checkout next time</span>
                       </label>
                     )}
                   </div>
                </div>
              </div>
            </div>

             <div class="bg-white p-6 md:p-8 rounded-2xl border border-slate-200/80 shadow-xs">
              <h2 class="text-base md:text-lg font-black text-gray-900 mb-6 flex items-center gap-2.5">
                <span aria-hidden="true" class="w-6 h-6 rounded-full bg-slate-900 text-white flex items-center justify-center text-xs font-black">2</span>
                Payment method
              </h2>
              <div class="space-y-4">
                <label class="flex items-start gap-3 p-4 border border-slate-200/70 rounded-xl hover:border-brand-primary cursor-pointer select-none bg-slate-50/30 transition-all hover:shadow-xs">
                  <input type="radio" name="paymentMethod" value="offline" checked class="mt-1 w-4 h-4 text-brand-primary border-slate-250 focus:ring-brand-primary cursor-pointer" />
                  <div>
                    <span class="font-bold text-gray-900 text-sm">Cash / Manual Invoice</span>
                    <p class="text-xs text-slate-500 mt-1.5 leading-relaxed">Submit your order now, and our sales agents will manually verify delivery details and issue a final invoice.</p>
                  </div>
                </label>
                <label class="flex items-start gap-3 p-4 border border-slate-200/70 rounded-xl hover:border-brand-primary cursor-pointer select-none bg-slate-50/30 transition-all hover:shadow-xs">
                  <input type="radio" name="paymentMethod" value="pesapal" class="mt-1 w-4 h-4 text-brand-primary border-slate-250 focus:ring-brand-primary cursor-pointer" />
                  <div>
                    <span class="font-bold text-gray-900 text-sm">Mobile Money & Card via PesaPal</span>
                    <p class="text-xs text-slate-500 mt-1.5 leading-relaxed">Pay securely with MTN Mobile Money, Airtel Money, or credit/debit cards instantly via secure PesaPal redirection.</p>
                  </div>
                </label>
              </div>
            </div>

            {status === 'error' && (
              <div class="p-4 bg-amber-50 border border-amber-200 rounded-xl text-amber-900 text-sm flex items-start gap-3">
                <input type="checkbox" id="allowOfflineDraft" name="allowOfflineDraft" value="true" class="mt-1 rounded border-amber-300 text-amber-600 focus:ring-amber-500 w-4 h-4" />
                <div>
                  <label for="allowOfflineDraft" class="font-bold cursor-pointer select-none">Save as offline draft on this device</label>
                  <p class="text-xs text-amber-700 mt-1">If the checkout service is unreachable, checking this lets you complete the transaction flow as a local demonstration. The draft reference will be stored on your device and labeled explicitly.</p>
                </div>
              </div>
            )}

            <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4">
              {/*
                The button says what pressing it DOES. It used to read "Pay Online"
                while the preselected method was the offline invoice — the wrong
                promise at the most decisive moment of the whole funnel.
              */}
              <button
                type="submit"
                id="submitBtn"
                data-label-offline="Place order"
                data-label-pesapal="Pay securely now"
                class="bg-brand-primary text-gray-955 px-8 py-2.5 rounded-full font-bold text-sm tracking-wider uppercase hover:shadow-lg hover:shadow-brand-primary/20 transition-all outline-none cursor-pointer hover:scale-[1.005] active:scale-[0.985] shadow-sm"
              >
                Place order
              </button>
              <p class="text-xs text-slate-400 italic max-w-xs">Location verification safeguards delivery times.</p>
            </div>
          </form>
        </div>

        <aside class="w-full lg:w-1/3">
          <div class="bg-white rounded-2xl border border-slate-200/80 p-6 sticky top-24 shadow-xs">
            <h2 class="text-base font-black text-gray-900 mb-4">Order summary</h2>
            <ul class="space-y-3 text-sm mb-4" aria-label="Order items">
              {cart.items.map((item) => (
                <li class="flex items-start justify-between gap-3">
                  <div class="min-w-0">
                    <p class="font-bold text-gray-900 truncate">{item.name}</p>
                    <p class="text-xs text-slate-400 font-medium">Qty {item.quantity} × {formatUgx(item.unitPriceUgx || item.priceUgx)}</p>
                  </div>
                  <p class="font-bold text-gray-900 whitespace-nowrap text-sm">{formatUgx((item.unitPriceUgx || item.priceUgx) * item.quantity)}</p>
                </li>
              ))}
            </ul>
            <dl class="space-y-2 text-sm pt-3 border-t border-slate-100">
              <div class="flex items-center justify-between">
                <dt class="text-slate-550">Subtotal</dt>
                <dd class="font-bold text-gray-900">{formatUgx(cart.subtotalUgx)}</dd>
              </div>
              <div class="flex items-start justify-between gap-3" id="delivery-estimate-row">
                <dt class="text-slate-550">Delivery</dt>
                <dd class="text-right" id="delivery-estimate-value" data-state={initialDeliveryEstimate?.kind ?? 'NONE'}>
                  {initialDeliveryEstimate?.kind === 'CONFIRMED' && initialDeliveryEstimate.feeUgx !== null ? (
                    <span class="font-bold text-gray-900">{formatUgx(initialDeliveryEstimate.feeUgx)}</span>
                  ) : initialDeliveryEstimate?.kind === 'ESTIMATED' && initialDeliveryEstimate.feeUgx !== null ? (
                    <span class="font-bold text-gray-900">≈ {formatUgx(initialDeliveryEstimate.feeUgx)} <span class="block text-[10px] font-semibold text-slate-400">estimate — confirmed before dispatch</span></span>
                  ) : (
                    <span class="text-[11px] font-bold text-slate-400">Shown when you pick a location</span>
                  )}
                </dd>
              </div>
              <div class="flex items-center justify-between pt-3 border-t border-slate-100">
                <dt class="font-bold text-gray-900 text-sm" id="grand-total-label">{initialDeliveryEstimate?.kind === 'CONFIRMED' ? 'Grand total (incl. delivery)' : 'Grand total (excl. delivery)'}</dt>
                <dd class="font-black text-gray-900 text-lg" id="grand-total-value" data-subtotal={cart.subtotalUgx}>
                  {formatUgx(cart.subtotalUgx + (initialDeliveryEstimate?.kind === 'CONFIRMED' ? initialDeliveryEstimate.feeUgx ?? 0 : 0))}
                </dd>
              </div>
            </dl>
            {potentialPoints > 0 && (
              authenticatedUserId ? (
                <p class="mt-4 rounded-xl bg-amber-50 border border-amber-200/60 px-3.5 py-2.5 text-xs font-semibold text-amber-900">
                  You'll earn <strong>{potentialPoints.toLocaleString('en-UG')} GoldPlus points</strong> when this order is paid.
                </p>
              ) : (
                <p class="mt-4 rounded-xl bg-amber-50 border border-amber-200/60 px-3.5 py-2.5 text-xs font-semibold text-amber-900">
                  <a href="/login?returnTo=/checkout" class="underline font-bold">Sign in</a> or
                  <a href="/register?returnTo=/checkout" class="underline font-bold">create an account</a> to earn
                  <strong> {potentialPoints.toLocaleString('en-UG')} GoldPlus points</strong> on this order.
                </p>
              )
            )}
          </div>
        </aside>
      </div>
    )}
  </div>

  {/* Embed cart data for client-side telemetry — no sensitive data, prices are public */}
  <div
    id="checkout-telemetry-data"
    data-subtotal={cart.subtotalUgx}
    data-items={JSON.stringify(cart.items.map(i => ({
      item_id:   i.productId,
      item_name: i.name,
      price:     i.unitPriceUgx || i.priceUgx,
      quantity:  i.quantity,
      item_brand: 'GoldPlus',
    })))}
    aria-hidden="true"
    style="display:none"
  ></div>
</BaseLayout>

<script>
  import { track, captureClickIdsServerSide } from '../lib/telemetry';

  document.addEventListener('DOMContentLoaded', () => {
    const dataEl  = document.getElementById('checkout-telemetry-data');
    if (!dataEl) return;

    const subtotal = Number(dataEl.dataset.subtotal ?? '0');
    let items: any[] = [];
    try { items = JSON.parse(dataEl.dataset.items ?? '[]'); } catch { /* ignore */ }

    // Persist click IDs — critical for attributing this checkout session
    captureClickIdsServerSide();

    // ── begin_checkout — fires when user reaches the checkout page ────────────
    track('begin_checkout', {
      ecommerce: { value: subtotal, currency: 'UGX', items },
    });

    // ── fast-checkout interactions (progressive enhancement only) ─────────────
    // Without JS everything still works: the new-address block stays visible and
    // the server decides between saved address and typed location.
    const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement | null;
    const methodRadios = document.querySelectorAll<HTMLInputElement>('input[name="paymentMethod"]');
    const syncSubmitLabel = () => {
      if (!submitBtn) return;
      const method = document.querySelector<HTMLInputElement>('input[name="paymentMethod"]:checked')?.value ?? 'offline';
      submitBtn.textContent = (method === 'pesapal' ? submitBtn.dataset.labelPesapal : submitBtn.dataset.labelOffline) ?? 'Place order';
    };
    methodRadios.forEach((r) => r.addEventListener('change', syncSubmitLabel));
    syncSubmitLabel();

    const addressRadios = document.querySelectorAll<HTMLInputElement>('input.js-address-choice');
    const newAddressBlock = document.getElementById('new-address-fields');
    const syncAddressBlock = () => {
      if (!newAddressBlock || addressRadios.length === 0) return;
      const chosen = document.querySelector<HTMLInputElement>('input.js-address-choice:checked');
      const usingSaved = Boolean(chosen && chosen.value !== '');
      newAddressBlock.classList.toggle('hidden', usingSaved);
    };
    addressRadios.forEach((r) => r.addEventListener('change', syncAddressBlock));
    syncAddressBlock();

    // ── live delivery estimate ────────────────────────────────────────────────
    // Re-quotes whenever the destination changes: a saved-address radio (its
    // district travels on data-district) or a fresh picker selection. CONFIRMED
    // fees (operator zones — actually charged) join the grand total; ESTIMATES
    // stay advisory and never inflate the number the customer commits to.
    const API_BASE = (import.meta.env.PUBLIC_API_BASE_URL ?? '').replace(/\/+$/, '');
    const estimateEl = document.getElementById('delivery-estimate-value');
    const totalEl = document.getElementById('grand-total-value');
    const totalLabelEl = document.getElementById('grand-total-label');
    const ugx = (n: number) =>
      new Intl.NumberFormat('en-UG', { style: 'currency', currency: 'UGX', maximumFractionDigits: 0 }).format(n);

    function renderEstimate(est: { kind: string; feeUgx: number | null } | null) {
      if (!estimateEl || !totalEl || !totalLabelEl) return;
      if (est && est.kind === 'CONFIRMED' && est.feeUgx !== null) {
        estimateEl.innerHTML = `<span class="font-bold text-gray-900">${ugx(est.feeUgx)}</span>`;
        totalLabelEl.textContent = 'Grand total (incl. delivery)';
        totalEl.textContent = ugx(subtotal + est.feeUgx);
      } else if (est && est.kind === 'ESTIMATED' && est.feeUgx !== null) {
        estimateEl.innerHTML = `<span class="font-bold text-gray-900">≈ ${ugx(est.feeUgx)} <span class="block text-[10px] font-semibold text-slate-400">estimate — confirmed before dispatch</span></span>`;
        totalLabelEl.textContent = 'Grand total (excl. delivery)';
        totalEl.textContent = ugx(subtotal);
      } else {
        estimateEl.innerHTML = '<span class="text-[11px] font-bold text-slate-400">Confirmed by our team after ordering</span>';
        totalLabelEl.textContent = 'Grand total (excl. delivery)';
        totalEl.textContent = ugx(subtotal);
      }
    }

    let estimateSeq = 0;
    async function refreshEstimate(district: string | null, area: string | null) {
      if (!district || !API_BASE) { renderEstimate(null); return; }
      const seq = ++estimateSeq;
      try {
        const qs = new URLSearchParams({ district, ...(area ? { area } : {}) });
        const res = await fetch(`${API_BASE}/commerce/delivery-estimate?${qs}`, { signal: AbortSignal.timeout(4000) });
        const json = await res.json().catch(() => null);
        if (seq !== estimateSeq) return; // a newer destination superseded this quote
        renderEstimate(json?.success ? json.data.estimate : null);
      } catch {
        if (seq === estimateSeq) renderEstimate(null);
      }
    }

    addressRadios.forEach((r) =>
      r.addEventListener('change', () => {
        if (r.checked && r.value !== '') refreshEstimate(r.dataset.district ?? null, null);
        else if (r.checked) renderEstimate(null);
      }),
    );
    const pickerPayload = document.querySelector<HTMLInputElement>('form[action="/checkout"] .js-final-payload');
    pickerPayload?.addEventListener('change', () => {
      try {
        const loc = JSON.parse(pickerPayload.value || '{}');
        refreshEstimate(loc.district ?? null, loc.area ?? null);
      } catch {
        renderEstimate(null);
      }
    });

    // ── add_payment_info — fires when user submits the checkout form ──────────
    const form = document.querySelector<HTMLFormElement>('form[action="/checkout"]');
    form?.addEventListener('submit', () => {
      if (submitBtn) {
        submitBtn.textContent = 'Processing…';
        submitBtn.classList.add('opacity-80', 'cursor-not-allowed');
      }
    });
    form?.addEventListener('submit', () => {
      const paymentMethod = (
        form.querySelector<HTMLInputElement>('input[name="paymentMethod"]:checked')?.value ?? 'unknown'
      );
      track('add_payment_info', {
        ecommerce: {
          value:    subtotal,
          currency: 'UGX',
          items,
          // Map payment method to GA4 coupon field (closest equivalent)
          // sGTM tag can extract this for payment type segmentation
          coupon: paymentMethod,
        },
      });
    });
  });
</script>
