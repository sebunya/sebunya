---
import { gaSessionFromCookieHeader } from '../lib/gaSession';
import { HEARD_ABOUT_OPTIONS, parseHeardAbout } from '@goldplus/shared';
import DeliveryQuote from "../components/DeliveryQuote.astro";
import BaseLayout from '../layouts/BaseLayout.astro';
import Notice from '../components/Notice.astro';
import FormField from '../components/FormField.astro';
import FormFeedback from '../components/FormFeedback.astro';
import UgandaLocationPicker from '../components/UgandaLocationPicker.astro';
import { apiBase, postJson } from '../lib/api';
import { formatUgx } from '../lib/money';
import { readCartSessionId } from '../lib/cart-session';
import {
  prepareCheckoutPayload,
  validateCheckoutPayload,
  normaliseCheckoutPhone,
  looksLikeEmail,
  PHONE_FORMAT_MESSAGE,
  EMAIL_FORMAT_MESSAGE,
  sameDayCutoffCopy,
  sameDayLineFor,
  maskPhone,
  sealOrderReceipt,
  orderReceiptSigner,
  ORDER_NUMBER_PATTERN,
  ORDER_RECEIPT_COOKIE,
  ORDER_RECEIPT_PATH,
  ORDER_RECEIPT_MAX_AGE_SECONDS,
} from '../lib/checkout';
import { parseLocalCartCookie } from '../lib/cart';
import { resolveCheckoutIntent, issueFreshCheckoutIntent, clearCheckoutIntent } from '../lib/checkoutIntent';
import { requestSession } from '../lib/customerAuth';
import { cartClient } from '../lib/cartClient';
import { resolveCartCredential, clearCartCredential } from '../lib/cartCredential';
import { checkRequestOrigin, CROSS_SITE_MESSAGE } from '../lib/requestOrigin';
import {
  submitCheckout,
  customerMessageFor,
  invalidCheckoutField,
  startPayment,
  paymentStartMessageFor,
} from '../lib/checkoutClient';
import { mayStartPayment, kampalaCutoff } from '@goldplus/shared';
import { getStorefrontDiscount, basketSavingUgx, basketSavingLabel } from '../lib/storefrontDiscount';
import { getBusinessInfo } from '../lib/businessInfo';
import { getStorefrontCopy } from '../lib/storefrontCopy';
import type { ApiEnvelope } from '@goldplus/shared';

interface CartItem {
  productId: string;
  slug: string;
  name: string;
  sku?: string;
  quantity: number;
  unitPriceUgx: number;
  priceUgx: number; // Normalized used in cart logic
}

interface CartResponse {
  id: string;
  items: CartItem[];
  subtotalUgx: number;
}

// Resolved ONCE for the whole render: the cart credential, the account-context
// prefill and the POST branch all need the same answer, and this call costs a
// round-trip to the API.
// UNKNOWN (the check timed out or failed) is neither: a signed-in customer must
// never be checked out as a guest, and their basket credential must not be
// replaced, so on UNKNOWN nothing is placed and nothing is minted.
const checkoutSession = await requestSession(Astro.locals, Astro.cookies);
const sessionUnknown = checkoutSession.state === 'UNKNOWN';
const authenticatedUserId = checkoutSession.state === 'USER' ? checkoutSession.userId : null;

// The basket is read through the SIGNED CREDENTIAL, not a cart id in the URL. The
// credential also names the owner, so a signed-in customer cannot be served a guest
// basket and vice versa.
const cartCredential = resolveCartCredential(Astro.cookies, authenticatedUserId, { sessionUnknown });
if (!cartCredential) {
  return Astro.redirect('/cart', 303);
}


// The basket has become an order. The COOKIE is only the offline fallback; the
// server cart is the authority, and leaving it standing meant the customer came
// back from paying to find their old basket still full, with the mini-cart
// still counting items they had already bought. Best effort: a failure here
// must never turn a placed order into an error.
async function clearBasketAfterOrder() {
  Astro.cookies.delete('goldplus_cart_data', { path: '/' });
  try {
    await cartClient.clear(
      cartCredential!.token,
      {},
      Astro.cookies.get('goldplus_session')?.value ?? null,
    );
  } catch { /* the order stands either way */ }
}

/**
 * The order a PesaPal handoff is for, remembered on this device for the
 * cancellation page. PesaPal's cancellation URL is a fixed address that does
 * not reliably name the order, and that page's "Pay for this order" used to
 * send the customer to /checkout, whose basket had just been emptied.
 */
function rememberPaymentOrder(orderNumber: string | undefined | null) {
  if (!orderNumber || !ORDER_NUMBER_PATTERN.test(orderNumber)) return;
  try {
    Astro.cookies.set('gp_pay_order', orderNumber, {
      path: '/checkout/pesapal', maxAge: 60 * 60 * 6, httpOnly: true, sameSite: 'lax', secure: import.meta.env.PROD,
    });
  } catch { /* a convenience for the cancellation page */ }
}

let cart: CartResponse | null = null;
const serverCart = await cartClient.read(
  cartCredential.token,
  Astro.cookies.get('goldplus_session')?.value ?? null,
);
if (serverCart.ok) {
  cart = {
    id: serverCart.cart.id,
    items: serverCart.cart.items.map((line) => ({
      productId: line.productId,
      name: line.name,
      quantity: line.quantity,
      unitPriceUgx: line.unitPriceUgx,
      priceUgx: line.unitPriceUgx,
    })) as CartResponse['items'],
    subtotalUgx: serverCart.cart.subtotalUgx,
  };
}

// Fallback to local cookie state if API failed or returned empty!
// The order is ALWAYS priced server-side (the request carries productId and
// quantity only), so this can never change what is charged. It can, however,
// show a stale total from the device, so when it happens the customer is told
// rather than being quietly shown figures we could not confirm.
let pricedFromDevice = false;
if (!cart || cart.items.length === 0) {
  const localDataCookie = Astro.cookies.get('goldplus_cart_data')?.value;
  const items = parseLocalCartCookie(localDataCookie) as any[];
  if (items.length > 0) {
    const subtotalUgx = items.reduce((acc, item) => acc + ((item.unitPriceUgx || item.priceUgx) * item.quantity), 0);
    pricedFromDevice = true;
    cart = {
      // The credential's cart id, so the local fallback and the server basket refer to
      // the same basket rather than to whatever the browser last held.
      id: cartCredential.cartId,
      items,
      subtotalUgx
    };
  }
}

if (!cart || cart.items.length === 0) {
  return Astro.redirect('/cart', 303);
}

// Setup form state for lifecycle
let status: 'success' | 'error' | 'received' | null = null;
let message: string | undefined;
let reference: string | undefined;
let createdOrderId: string | undefined;
/** Set only when a refusal has somewhere useful to send the customer. */
let feedbackAction: { href: string; label: string } | undefined;
let receivedActionLabel = 'View & track this order';
let values: Record<string, string> = {};
let errors: Record<string, string> = {};
// What the confirmation page recaps. Filled as the order is placed.
let receiptTotalUgx: number | null = null;
let receiptFeeConfirmed: boolean | null = null;
let receiptPlace = '';
// The promo code and the preview it was applied under, carried back into the
// form when the page re-renders after a refusal. Without them a retry went
// through without the code the customer had typed.
let couponCodeValue = '';
// "How did you hear about us?" (optional), carried back the same way.
let heardAboutValue = '';
let previewQuoteIdValue = '';
// The payment method and points the customer chose, carried back the same way.
// The offline radio used to carry a literal `checked`, so any refusal quietly
// turned "Pay securely now" into a pay-on-delivery order on the next submit.
let paymentMethodValue: 'offline' | 'pesapal' = 'offline';
let redeemPointsValue = '';

// The checkout intent is resolved on EVERY render, including the initial GET.
//
// It previously lived inside the POST branch, which meant the initial GET issued
// no cookie at all and the template's reference to the derived key was a
// ReferenceError — the checkout page was broken on first load. `pnpm build`
// passed throughout, which is why build success is not evidence about the GET
// path.
//
// It is issued in this layer because the layer that owns the browser connection
// is the only one that can own the cookie: the API's Set-Cookie lands on this
// server's fetch response and never reaches the browser.

// ---------------------------------------------------------------------------
// Account context: everything the platform already knows about this customer.
// A returning customer should CONFIRM a checkout, not retype it. Every fetch
// here is timeout-guarded and failure-tolerant — prefill going missing must
// degrade to the blank form, never to a broken page.
// ---------------------------------------------------------------------------
interface SavedAddress {
  id: string;
  label: string;
  recipientName: string;
  phone: string;
  district: string;
  areaDetails: string;
  /** The location key the quoting service prices by; null for older addresses. */
  areaSlug?: string | null;
  isDefault: boolean;
}
const sessionToken = Astro.cookies.get('goldplus_session')?.value ?? null;
let savedAddresses: SavedAddress[] = [];
let accountEmail = '';
if (authenticatedUserId && sessionToken) {
  try {
    const [addrRes, meRes] = await Promise.all([
      fetch(`${apiBase}/account/addresses`, {
        headers: { Authorization: `Bearer ${sessionToken}` },
        signal: AbortSignal.timeout(3000),
      }),
      fetch(`${apiBase}/account/me`, {
        headers: { Authorization: `Bearer ${sessionToken}` },
        signal: AbortSignal.timeout(3000),
      }),
    ]);
    const addrJson: any = addrRes.ok ? await addrRes.json().catch(() => null) : null;
    const meJson: any = meRes.ok ? await meRes.json().catch(() => null) : null;
    if (addrJson?.success && Array.isArray(addrJson.data)) savedAddresses = addrJson.data;
    if (meJson?.success) accountEmail = meJson.data?.email ?? '';
  } catch {
    /* prefill is a convenience, never a dependency */
  }
}
const defaultAddress = savedAddresses.find((a) => a.isDefault) ?? savedAddresses[0] ?? null;

// Live programme terms for the earn preview. Zero when inactive or unreachable —
// the preview line simply does not render rather than promising points.
let loyaltyProgramme: {
  active: boolean;
  earnRatePer1000Ugx: number;
  redemption: { configured: boolean; pointValueUgx?: number; minPoints?: number; maxShareBps?: number };
} = { active: false, earnRatePer1000Ugx: 0, redemption: { configured: false } };
try {
  const lpRes = await fetch(`${apiBase}/commerce/loyalty-programme`, { signal: AbortSignal.timeout(2500) });
  const lpJson: any = lpRes.ok ? await lpRes.json().catch(() => null) : null;
  if (lpJson?.success && lpJson.data?.active) {
    loyaltyProgramme = {
      active: true,
      earnRatePer1000Ugx: Number(lpJson.data.earnRatePer1000Ugx) || 0,
      redemption: lpJson.data.redemption ?? { configured: false },
    };
  }
} catch {
  /* preview only */
}

// Available points for the redemption control (signed-in only, tolerant).
let loyaltyAvailablePoints = 0;
if (authenticatedUserId && sessionToken && loyaltyProgramme.active && loyaltyProgramme.redemption.configured) {
  try {
    const lbRes = await fetch(`${apiBase}/account/loyalty`, {
      headers: { Authorization: `Bearer ${sessionToken}` },
      signal: AbortSignal.timeout(2500),
    });
    const lbJson: any = lbRes.ok ? await lbRes.json().catch(() => null) : null;
    if (lbJson?.success) loyaltyAvailablePoints = Number(lbJson.data?.balance?.available ?? 0);
  } catch {
    /* redemption control simply hides */
  }
}

// Active pickup points (PART G field 1) — collection is a first-class method.
let pickupPoints: Array<{ id: string; name: string; operator: string; physicalAddress: string | null }> = [];
try {
  const ppRes = await fetch(`${apiBase}/locations/pickup-points`, { signal: AbortSignal.timeout(2500) });
  const ppJson: any = ppRes.ok ? await ppRes.json().catch(() => null) : null;
  if (ppJson?.success && Array.isArray(ppJson.data)) pickupPoints = ppJson.data;
} catch {
  /* door delivery remains the default */
}

// Guest memory: details from their last completed checkout, held in an
// httpOnly cookie on their own device so a repeat guest confirms instead of
// retyping. Signed-in customers use their address book instead.
const GUEST_PREFILL_COOKIE = 'gp_checkout_prefill';
let guestPrefill: Record<string, string> = {};
if (!authenticatedUserId) {
  try {
    const raw = Astro.cookies.get(GUEST_PREFILL_COOKIE)?.value;
    if (raw) {
      const parsed = JSON.parse(decodeURIComponent(raw));
      if (parsed && typeof parsed === 'object') {
        for (const k of ['name', 'email', 'phone', 'locationJson', 'deliveryAddress']) {
          if (typeof parsed[k] === 'string' && parsed[k].length <= 600) guestPrefill[k] = parsed[k];
        }
      }
    }
  } catch {
    /* stale/corrupt cookie = no prefill */
  }
}

// Cross-site refusal comes BEFORE the intent is resolved, because resolving it can
// MINT one. A cross-site POST arrives without the SameSite=Lax cookie, and the
// response to a missing cookie was to manufacture a fresh guest identity and place
// an order under it — a request the browser had already labelled cross-site was
// answered by inventing an identity for it.
const originDecision =
  Astro.request.method === 'POST'
    ? checkRequestOrigin(Astro.request, import.meta.env as unknown as Record<string, string | undefined>)
    : ({ allowed: true, basis: 'SEC_FETCH_SITE' } as const);

if (!originDecision.allowed) {
  status = 'error';
  message = CROSS_SITE_MESSAGE;
}

// Not resolved at all on a refused request: resolving MINTS, and a cross-site POST
// has no business being issued a checkout identity.
// Nor on an UNKNOWN session: minting here would issue a GUEST intent to a
// customer who may be signed in, and the POST below would place their order as a
// guest. The page says so and the customer retries in a moment. Only on a POST:
// a plain view places nothing, so an error there reads as a failed order.
if (originDecision.allowed && sessionUnknown && Astro.request.method === 'POST') {
  status = 'error';
  message = 'We could not confirm your sign-in just now, so nothing has been placed. Please wait a moment and try again.';
}
const checkoutIntent = originDecision.allowed && !sessionUnknown
  ? resolveCheckoutIntent(Astro.cookies, authenticatedUserId)
  : null;
if (originDecision.allowed && !sessionUnknown && !checkoutIntent) {
  // Refuse rather than fall back to an unsigned identity, which would make every
  // retry a new operation and therefore a new order.
  throw new Error('CHECKOUT_INTENT_SECRET is not configured');
}

// Handle Form Submission (RESTORED FEATURE)
if (Astro.request.method === 'POST' && originDecision.allowed && checkoutIntent) {
  const formData = await Astro.request.formData();
  
  // Extract raw strings for re-populating inputs on errors
  values = {
    name: String(formData.get('name') || '').trim(),
    email: String(formData.get('email') || '').trim(),
    phone: String(formData.get('phone') || '').trim(),
    locationJson: String(formData.get('locationJson') || '').trim(),
    deliveryAddress: String(formData.get('deliveryAddress') || '').trim(),
    deliveryMethod: String(formData.get('deliveryMethod') || 'door').trim() === 'pickup' ? 'pickup' : 'door',
    pickupPointId: String(formData.get('pickupPointId') || '').trim(),
  };
  couponCodeValue = String(formData.get('couponCode') || '').trim().slice(0, 40);
  heardAboutValue = parseHeardAbout(formData.get('heardAbout')) ?? '';
  {
    const q = String(formData.get('previewQuoteId') || '').trim();
    previewQuoteIdValue = /^[0-9a-f-]{36}$/i.test(q) ? q : '';
  }
  paymentMethodValue = String(formData.get('paymentMethod') || '').trim() === 'pesapal' ? 'pesapal' : 'offline';
  {
    const rp = parseInt(String(formData.get('redeemPoints') || ''), 10);
    redeemPointsValue = Number.isInteger(rp) && rp > 0 ? String(rp) : '';
  }

  // Collection from a pickup point (rendered only when pickup points exist).
  // The point comes from OUR list, never from client text, and it is the
  // delivery location: the picker and the landmark line are hidden for it, so
  // they must not be required for it either (they were, and the error landed
  // on a field the customer could not see).
  const pickupPoint = values.deliveryMethod === 'pickup' && pickupPoints.length > 0
    ? pickupPoints.find((p) => p.id === values.pickupPointId) ?? null
    : null;
  const collecting = values.deliveryMethod === 'pickup' && pickupPoints.length > 0;
  if (collecting && pickupPoint) {
    const pickupText = `Pickup point: ${pickupPoint.name}${pickupPoint.physicalAddress ? `, ${pickupPoint.physicalAddress}` : ''}`;
    formData.set('locationJson', JSON.stringify({ manual: true, rawAddressText: pickupText }));
    values.locationJson = String(formData.get('locationJson'));
  }

  // A saved-address id is only meaningful for a signed-in customer; the id is
  // re-fetched server-side below, so a tampered value can select nothing but
  // that customer's own addresses.
  const selectedAddressId = authenticatedUserId ? String(formData.get('addressId') || '').trim() : '';
  const selectedAddress = selectedAddressId
    ? savedAddresses.find((a) => a.id === selectedAddressId) ?? null
    : null;

  // Simple validation checks
  if (!values.name) errors.name = 'Full name is required.';
  // The number is how the order is confirmed, so it is checked for shape, not
  // just presence: '12345' used to create an order nobody could call.
  if (!values.phone) errors.phone = 'Contact phone number is required.';
  else if (!normaliseCheckoutPhone(values.phone)) errors.phone = PHONE_FORMAT_MESSAGE;
  if (values.email && !looksLikeEmail(values.email)) errors.email = EMAIL_FORMAT_MESSAGE;
  if (collecting && !pickupPoint) errors.pickupPointId = 'Choose the pickup point you will collect from.';
  // A chosen saved address IS the delivery location; the picker is only
  // required when delivering somewhere new.
  if (!collecting && !selectedAddress && !values.locationJson) errors.locationJson = 'Please select a delivery location.';
  // The landmark line is what the rider actually navigates by — required for a
  // new address; a saved address already carries its area details.
  if (!collecting && !selectedAddress && !values.deliveryAddress) errors.deliveryAddress = 'Add the estate, road, building or landmark our rider should look for.';

  if (Object.keys(errors).length === 0) {
     // Prepare mapped payload compatible with Commerce API
     // Map priceUgx field since interface varies slightly between cart api and checkout lib
     const normalizedItems = cart.items.map(i => ({ ...i, priceUgx: i.priceUgx || i.unitPriceUgx }));
     const payload = prepareCheckoutPayload(formData, normalizedItems as any);
     if (selectedAddress) {
       payload.customerDetails = {
         name: values.name,
         email: values.email || undefined,
         phone: values.phone,
         deliveryArea: `${selectedAddress.areaDetails}, ${selectedAddress.district}`,
         deliveryAddress: [selectedAddress.areaDetails, values.deliveryAddress].filter(Boolean).join(' | '),
         // The same key the page quoted by, so the charge resolves on it too.
         deliveryLocation: { district: selectedAddress.district, areaSlug: selectedAddress.areaSlug ?? undefined },
       };
     }
     const paymentMethod = String(formData.get('paymentMethod') || 'offline').trim();
     receiptPlace = payload.customerDetails.deliveryArea;
     
     // Typed BFF call. The generic postJson helper returned `data: unknown` and
     // dropped every response header, which is how the API's move to a minimal
     // DTO returning `orderId` went unnoticed while this page read `res.data.id`:
     // the value was simply undefined, the PesaPal branch was skipped, and the
     // customer saw the offline-review message instead of being sent to pay.
     // Held in a variable because the intent can be re-minted below, and the
     // payment handoff must then use the token the order was actually created under.
     let activeIntentToken = checkoutIntent.token;
     const checkoutArgs = {
        // R3.1: SSR-only visit token so the API stamps the order's experience
        // profile — the identity join for commercial attribution.
        visitToken: Astro.locals.gpVisit ?? null,
        request: {
           customerDetails: payload.customerDetails,
           buyerType: payload.buyerType,
           items: payload.items,
           // Fingerprint inputs: switching between paying online and ordering offline is
           // a different operation, and the basket version pins which basket state the
           // customer was actually looking at.
           paymentMethod: paymentMethod === 'pesapal' ? 'pesapal' : 'offline',
           cartId: serverCart.ok ? serverCart.cart.id : null,
           cartVersion: serverCart.ok ? serverCart.cart.version : null,
           // Loyalty redemption (PART G): points to convert to a discount.
           // Server-validated and reserved — a bad value fails the checkout
           // with a clear message rather than a silent trim.
           ...( (() => { const rp = parseInt(String(formData.get('redeemPoints') || ''), 10); return Number.isInteger(rp) && rp > 0 ? { redeemPoints: rp } : {}; })() ),
           // Promo code: server-validated by the SAME evaluator that priced the
           // preview; an empty field is simply no code. previewQuoteId (set by
           // the Apply button) arms the PRICE_CHANGED consistency gate.
           ...( (() => { const cc = String(formData.get('couponCode') || '').trim(); return cc ? { couponCode: cc } : {}; })() ),
           // Optional, reporting only: an unknown value is simply not sent.
           ...(heardAboutValue ? { heardAbout: heardAboutValue } : {}),
           ...( (() => { const q = String(formData.get('previewQuoteId') || '').trim(); return /^[0-9a-f-]{36}$/i.test(q) ? { previewQuoteId: q } : {}; })() ),
           // Marketing attribution captured client-side; recorded best-effort, never priced.
           // Plus the visitor as the browser tag knows it (the `_fp_cid` cookie is
           // GA's client_id) and the buyer's own IP and browser: payment is
           // confirmed later, server to server, where no browser is present, and
           // the purchase sent to GA4 then must join THIS visit, not invent one.
           ...( (() => {
             let a: Record<string, unknown> = {};
             try { const p = JSON.parse(String(formData.get('attribution') || 'null')); if (p && typeof p === 'object') a = p; } catch { /* optional */ }
             const fp = Astro.cookies.get('_fp_cid')?.value;
             // Caddy's X-Real-IP is the shopper's address ({client_ip}: only
             // believed from Cloudflare's ranges), unlike a raw CF header.
             const ip = Astro.request.headers.get('x-real-ip');
             const ua = Astro.request.headers.get('user-agent');
             // GA4's own session for this visit, from its `_ga_<stream>` cookie
             // (GS1.1.<sid>.<n>… or GS2.1.s<sid>$o<n>$…): the server-sent purchase
             // must land in THIS session, or GA credits the sale to "direct".
             const gaSession = gaSessionFromCookieHeader(Astro.request.headers.get('cookie')) ?? {};
             return { attribution: { ...a, ...gaSession, ...(fp ? { fpClientId: fp.slice(0, 255) } : {}), ...(ip ? { clientIp: ip.slice(0, 64) } : {}), ...(ua ? { userAgent: ua.slice(0, 1024) } : {}) } };
           })() ),
        },
        intentToken: activeIntentToken,
        sessionToken: Astro.cookies.get('goldplus_session')?.value ?? null,
     };

     let result = await submitCheckout(checkoutArgs);

     // The stored intent had already been spent AND produced no order, so there
     // is nothing to duplicate. Mint a fresh one and submit once more.
     //
     // Without this, an ordinary journey was a dead end: a checkout refused for
     // an unavailable item, or an online payment that failed, left an intent the
     // customer could not clear. Anything they changed afterwards — removing the
     // unavailable item, switching to pay on delivery — made the request differ
     // from the stored fingerprint and was refused, for twelve hours, with
     // "your basket changed since this checkout started".
     //
     // Bounded to ONE retry, and only on this code, which the API returns only
     // when the spent intent left no order behind.
     if (!result.ok && result.code === 'CHECKOUT_INTENT_SPENT') {
        const freshIntent = issueFreshCheckoutIntent(Astro.cookies, authenticatedUserId);
        if (freshIntent) {
           activeIntentToken = freshIntent.token;
           result = await submitCheckout({ ...checkoutArgs, intentToken: freshIntent.token });
        }
     }

     // The preview is exactly what a price or offer refusal says has changed.
     // Carrying it into the retry would refuse the retry the same way, for
     // ever; the code stays, and the retry is priced (and charged) afresh.
     if (!result.ok && (result.code === 'PRICE_CHANGED' || result.code === 'PROMOTION_CHANGED')) {
        previewQuoteIdValue = '';
     }

     const outcome = customerMessageFor(result);

     if (result.ok) {
        const dto = result.data;
        reference = dto.orderNumber || dto.orderId;
        createdOrderId = dto.orderId;
        receiptTotalUgx = Number.isFinite(dto.totalAmount) ? dto.totalAmount : null;
        receiptFeeConfirmed = typeof dto.deliveryFeeConfirmed === 'boolean' ? dto.deliveryFeeConfirmed : null;

        // The order exists from this point on whatever the payment path does,
        // so the "remember for next time" work happens here, before any
        // redirect can end the render.
        if (!authenticatedUserId) {
          try {
            Astro.cookies.set(
              GUEST_PREFILL_COOKIE,
              encodeURIComponent(JSON.stringify({
                name: values.name,
                email: values.email,
                phone: values.phone,
                locationJson: values.locationJson,
                deliveryAddress: values.deliveryAddress,
              })),
              { path: '/checkout', maxAge: 60 * 60 * 24 * 180, httpOnly: true, sameSite: 'lax', secure: import.meta.env.PROD },
            );
          } catch { /* memory is a convenience */ }
        } else if (!selectedAddress && sessionToken && String(formData.get('saveAddress') || '') === 'true') {
          // Best-effort: a failed save must never disturb an order that succeeded.
          const district = payload.customerDetails.deliveryLocation?.district;
          if (district) {
            try {
              await fetch(`${apiBase}/account/addresses`, {
                method: 'POST',
                headers: { Authorization: `Bearer ${sessionToken}`, 'Content-Type': 'application/json' },
                signal: AbortSignal.timeout(3000),
                body: JSON.stringify({
                  label: district,
                  recipientName: values.name,
                  phone: values.phone,
                  district,
                  areaDetails: payload.customerDetails.deliveryArea,
                  makeDefault: savedAddresses.length === 0,
                }),
              });
            } catch { /* best-effort */ }
          }
        }

        // Payment starts ONLY when the server says the order is payable. The
        // previous condition was just "we have an order id", which would start a
        // payment for a stock-blocked or already-paid order.
        if (paymentMethod === 'pesapal' && mayStartPayment(dto)) {
           // Typed, and the intent is forwarded: the API cannot authorize this
           // caller without it. The previous untyped call also showed the API's
           // own error text to the customer on failure.
           const payRes = await startPayment({
              orderId: dto.orderId,
              intentToken: activeIntentToken,
              sessionToken: Astro.cookies.get('goldplus_session')?.value ?? null,
           });

           if (payRes.ok) {
              // The intent is DELIBERATELY RETAINED across the redirect.
              //
              // Clearing it here looked like tidy consumption, but the handoff is the
              // point at which the customer leaves this system, and every way they can
              // come back needs the same identity:
              //
              //   - the redirect is lost on a flaky mobile connection
              //   - they refresh, or press back
              //   - they abandon the bank page and return to /checkout
              //   - the provider sends them back to the return URL
              //
              // Without the intent, each of those is a NEW operation and therefore a
              // NEW order for a customer who already has one being paid for. The intent
              // is consumed when the order actually settles, not when it is handed over.
              //
              // The cart cookie IS cleared: the basket has become an order, and leaving
              // it would re-add the same items to the next checkout.
              await clearBasketAfterOrder();
              rememberPaymentOrder(dto.orderNumber);
              return Astro.redirect(payRes.data.redirectUrl, 303);
           }

           // The order EXISTS and is payable; only the handoff failed. The intent
           // is kept so the customer can retry onto the same order rather than
           // creating a second one — and the order page has its own Pay button,
           // so the customer is given that door rather than only a sentence.
           status = 'error';
           reference = dto.orderNumber || dto.orderId;
           message = paymentStartMessageFor(payRes.code);
           feedbackAction = authenticatedUserId
             ? { href: `/orders/${dto.orderId}`, label: 'Open your order and pay there' }
             : { href: `/track-order?reference=${encodeURIComponent(dto.orderNumber || '')}`, label: 'Track this order' };
        } else if (outcome.status === 'awaiting_payment') {
           // Payable, but the customer chose the offline path.
           status = 'received';
           message = 'Our team will call you to confirm the total before you pay.';
           clearCheckoutIntent(Astro.cookies);
           await clearBasketAfterOrder();
        } else {
           status = outcome.status === 'error' ? 'error' : 'received';
           message = outcome.message;
           if (outcome.status !== 'error') {
              clearCheckoutIntent(Astro.cookies);
              await clearBasketAfterOrder();
           }
        }
     } else if (result.code === 'CHECKOUT_ALREADY_ORDERED' && result.existingOrder) {
        // This checkout already produced an order. Nothing failed: the order
        // the customer wanted exists and is theirs, so it gets the same screen
        // a fresh order gets — and, if they asked to pay now, the same thing a
        // fresh order does: the handoff to the payment provider, for THAT
        // order. The intent is kept (it is the customer's authorisation to pay
        // it). The basket is NOT cleared: the API answers this code only when
        // this basket's fingerprint differs from the order's, so the basket on
        // screen is a NEW one the order was not made from, and deleting it
        // would throw away what the customer has just put together.
        const existing = result.existingOrder;
        const paid = existing.paymentStatus === 'paid';
        reference = existing.orderNumber;
        createdOrderId = existing.orderId;
        if (!paid && paymentMethod === 'pesapal') {
           const payRes = await startPayment({
              orderId: existing.orderId,
              intentToken: activeIntentToken,
              sessionToken: Astro.cookies.get('goldplus_session')?.value ?? null,
           });
           if (payRes.ok) {
              rememberPaymentOrder(existing.orderNumber);
              return Astro.redirect(payRes.data.redirectUrl, 303);
           }
           status = 'received';
           receivedActionLabel = 'Track or pay for this order';
           message = `${paymentStartMessageFor(payRes.code)} Nothing has been charged. Open the order below to try paying online again, or pay on delivery or at the shop.`;
        } else {
           status = 'received';
           receivedActionLabel = paid ? 'Track this order' : 'Track or pay for this order';
           message = paid
             ? 'You have already paid for this order — there is nothing more to do, and we have not taken a second payment.'
             : 'You placed this order a moment ago and it is saved for you. Nothing has been charged. Pay on delivery or at our shop, or open the order below to pay online now.';
        }
     } else if (result.code === 'STOCK_NOT_RESERVED' && result.details) {
        // The order exists and is recorded truthfully; it simply cannot be paid.
        status = 'error';
        message = outcome.message;
        reference = result.details.orderNumber || result.details.orderId;
        feedbackAction = { href: `/track-order?reference=${encodeURIComponent(result.details.orderNumber || '')}`, label: 'Track this order' };
     } else if (outcome.status === 'retry') {
        feedbackAction = feedbackAction ?? outcome.action;
        // NETWORK or CHECKOUT_IN_PROGRESS: the intent cookie is deliberately
        // KEPT, so retrying reaches the same operation instead of creating a
        // second order.
        status = 'error';
        message = outcome.message;
     } else if (result.code === 'INVALID_CHECKOUT' && invalidCheckoutField(result.message)) {
        // The API named the field it refused. Highlight THAT field, in our
        // words; the API's own text never reaches the customer.
        const pinned = invalidCheckoutField(result.message)!;
        errors[pinned.field] = pinned.message;
        status = 'error';
        message = 'One detail needs a second look. It is highlighted below. You have not been charged.';
     } else {
        // There used to be a "Save as offline draft on this device" checkbox
        // here that, on any refusal, rendered a green "Order Received" with a
        // random GP-DRAFT-###### reference — an order-shaped number that
        // existed nowhere, could never be paid (every payment path refuses the
        // prefix), and deleted the customer's cart cookie on the way out. It
        // was demo scaffolding on a production money path. A refusal is now
        // simply a refusal, with the basket kept so nothing is lost.
        status = 'error';
        message = outcome.message;
        feedbackAction = feedbackAction ?? outcome.action;
     }
  } else {
     status = 'error';
     message = Object.keys(errors).length === 1
       ? 'One detail needs a second look. It is highlighted below.'
       : 'Some details need a second look. Each one is highlighted below.';
  }
}

// Post/Redirect/Get. The confirmation used to be rendered in this POST's own
// response: the basket is already empty by then, so a refresh re-POSTed into
// the empty-cart redirect and the customer landed on "Your cart is empty" with
// their order number gone. The confirmation is now its own page, and what it
// recaps travels in a sealed, short-lived, httpOnly cookie on this device.
if (status === 'received' && reference) {
  const sign = orderReceiptSigner({
    CHECKOUT_INTENT_SECRET: import.meta.env.CHECKOUT_INTENT_SECRET || process.env.CHECKOUT_INTENT_SECRET,
    JWT_SECRET: import.meta.env.JWT_SECRET || process.env.JWT_SECRET,
  });
  if (sign) {
    const sealed = sealOrderReceipt({
      v: 1,
      ref: reference,
      orderId: createdOrderId ?? null,
      message: message ?? '',
      actionLabel: receivedActionLabel,
      items: cart.items.map((i: any) => ({
        name: String(i.name ?? ''),
        quantity: Number(i.quantity) || 1,
      })),
      totalUgx: receiptTotalUgx,
      deliveryFeeConfirmed: receiptFeeConfirmed,
      deliveryPlace: receiptPlace,
      phoneMasked: maskPhone(values.phone ?? ''),
      issuedAt: Date.now(),
    }, sign);
    Astro.cookies.set(ORDER_RECEIPT_COOKIE, sealed, {
      path: ORDER_RECEIPT_PATH, maxAge: ORDER_RECEIPT_MAX_AGE_SECONDS, httpOnly: true, sameSite: 'lax', secure: import.meta.env.PROD,
    });
    return Astro.redirect(`${ORDER_RECEIPT_PATH}?ref=${encodeURIComponent(reference)}`, 303);
  }
}

/** Where each field error sends the customer, in the order the form asks. */
const FIELD_TARGET: Record<string, { target: string; label: string }> = {
  name: { target: 'name', label: 'Full name' },
  email: { target: 'email', label: 'Email' },
  phone: { target: 'phone', label: 'Phone' },
  pickupPointId: { target: 'pickupPointSelect', label: 'Pickup point' },
  locationJson: { target: 'deliveryLocation_input', label: 'Delivery location' },
  deliveryAddress: { target: 'deliveryAddress', label: 'Exact address' },
};
const errorLinks = Object.keys(FIELD_TARGET)
  .filter((k) => errors[k])
  .map((k) => ({ href: `#${FIELD_TARGET[k].target}`, label: FIELD_TARGET[k].label, text: errors[k] }));

// Initial GET: the form opens already filled with what the platform knows —
// account holders from their address book, returning guests from their own
// last checkout. Confirming beats retyping; everything stays editable.
if (Astro.request.method !== 'POST') {
  if (authenticatedUserId) {
    values = {
      name: defaultAddress?.recipientName ?? '',
      email: accountEmail,
      phone: defaultAddress?.phone ?? '',
      locationJson: '',
      deliveryAddress: '',
    };
  } else {
    values = {
      name: guestPrefill.name ?? '',
      email: guestPrefill.email ?? '',
      phone: guestPrefill.phone ?? '',
      locationJson: guestPrefill.locationJson ?? '',
      deliveryAddress: guestPrefill.deliveryAddress ?? '',
    };
  }
}


// Initial delivery estimate for the preselected saved address, so a returning
// customer sees a delivery figure without touching anything. Guests get one
// the moment they pick a location (client-side, same public endpoint).
// CONFIRMED comes only from an operator zone and IS charged on the order;
// ESTIMATED is advisory and never added to the total shown here.
interface DeliveryEstimateView {
  kind: 'CONFIRMED' | 'ESTIMATED' | 'UNAVAILABLE';
  feeUgx: number | null;
  km: number | null;
}
let initialDeliveryEstimate: DeliveryEstimateView | null = null;
// The basket goes with the estimate, as `<productId>:<qty>`, so the page is
// quoted by the one quoting service exactly what the order will be charged
// (a bus parcel is priced per parcel and cannot be quoted without it).
const estimateItemsParam = cart.items.map((i) => `${i.productId}:${i.quantity}`).join(',');
if (defaultAddress) {
  try {
    const deRes = await fetch(
      `${apiBase}/commerce/delivery-estimate?district=${encodeURIComponent(defaultAddress.district)}`
        + `&area=${encodeURIComponent(defaultAddress.areaDetails ?? '')}`
        + `&areaSlug=${encodeURIComponent(defaultAddress.areaSlug ?? '')}`
        + `&items=${encodeURIComponent(estimateItemsParam)}`,
      { signal: AbortSignal.timeout(2500) },
    );
    const deJson: any = deRes.ok ? await deRes.json().catch(() => null) : null;
    if (deJson?.success) initialDeliveryEstimate = deJson.data.estimate;
  } catch {
    /* estimate is advisory */
  }
}

// What the NEW quoting service needs: the saved address's area when there is
// one, its district otherwise. Null on both means the customer has not chosen
// a location yet, and the quote correctly stays at disclaimer stage 1.
const initialAreaSlug: string | null = (defaultAddress as any)?.areaSlug ?? null;
const initialDistrict: string | null = defaultAddress?.district ?? null;

// Same-day deadline from the SAME operator-configured Kampala cutoff the header uses.
const bizCheckout = await getBusinessInfo();
// Payment-method display copy — operator-editable (admin/storefront-copy).
const paymentCopy = (await getStorefrontCopy()).payment;
const cut = kampalaCutoff(new Date(), { cutoffHour: bizCheckout.sameDayCutoffHour, closedDays: bizCheckout.closedDays });
// Worked out for WHERE the order is going. "This arrives today" beside the
// button used to be printed to a customer who had just chosen Arua; the line
// now names Kampala & Wakiso until a district is known, and the page script
// switches it when the customer picks one (data-* below).
const sameDayCopy = sameDayCutoffCopy(cut, { now: new Date(), closedDays: bizCheckout.closedDays });
const initialLineDistrict: string | null = (() => {
  if (initialDistrict) return initialDistrict;
  try {
    const loc = JSON.parse(values.locationJson || '{}');
    return typeof loc?.district === 'string' ? loc.district : null;
  } catch {
    return null;
  }
})();
const cutoffLine = sameDayLineFor(sameDayCopy, initialLineDistrict);

// The site-wide campaign, for the label only.
const checkoutDiscount = await getStorefrontDiscount();
// The evaluator's own saving, per-product floors included (0127); the order is
// priced server-side by the same evaluator, so this is what it will charge.
// Asked for EVERY basket: an automatic promotion that is not a simple
// site-wide campaign (a minimum spend, a cap, an exclusion) is still charged,
// and gating on the campaign showed the undiscounted total while PesaPal
// asked for less.
const checkoutSavings = await basketSavingUgx(
  cart.items.map((i: any) => ({ productId: i.productId, quantity: i.quantity })),
  cart.subtotalUgx,
);
const checkoutSaleSubtotal = cart.subtotalUgx - checkoutSavings;

// Same deterministic rule the ledger applies (floor per 1,000 UGX × rate).
// The ledger's basis is the ORDER TOTAL, which is the DISCOUNTED subtotal plus
// the delivery fee. Previewing on the pre-discount subtotal was not the "lower
// bound" the old comment claimed: once a campaign runs, subtotal can exceed
// discounted-subtotal-plus-delivery, and the preview then promised points the
// ledger does not award. Basing it on the discounted subtotal, which delivery
// only ever adds to, makes it a true lower bound again — so the copy says
// "at least". Points VEST ON DELIVERY (loyalty completion, PART F).
const potentialPoints = loyaltyProgramme.active
  ? Math.floor(checkoutSaleSubtotal / 1000) * loyaltyProgramme.earnRatePer1000Ugx
  : 0;
/**
 * A running campaign is not the same thing as money off THIS basket. The
 * evaluator will not discount below the per-unit price floor, so a basket of
 * items already at the floor saves nothing, and the summary was announcing
 * "10% discount ... -UGX 0": a claim the checkout does not honour. The row
 * appears only when the customer actually saves something.
 */
const checkoutOnSale = checkoutSavings > 0;
const checkoutSavingLabel = basketSavingLabel(
  checkoutDiscount,
  cart.items.map((i: any) => ({ unitPriceUgx: Number(i.unitPriceUgx ?? i.priceUgx) || 0, quantity: Number(i.quantity) || 0 })),
  checkoutSavings,
);
---

<BaseLayout robotsMeta="noindex,follow" title="Checkout">
  <div class="bg-gradient-to-b from-slate-50 to-white py-10 border-b border-slate-100">
    <div class="container mx-auto px-4 lg:px-8">
      <h1 class="text-2xl md:text-3xl font-black tracking-tight text-gray-900 mb-2">Checkout</h1>
      {/* True in every state: the fee shows here when your area can be priced,
          and is confirmed by phone when it cannot (it used to promise "your
          exact delivery fee" on a page that could not always show one). */}
      <p class="text-slate-600 max-w-2xl text-sm">Tell us where to deliver. You'll see the delivery fee here, or we confirm it by phone before dispatch.</p>
    </div>
  </div>

  <div class="container mx-auto px-4 lg:px-8 py-10">
    
    {status === 'received' ? (
      /* Reached only when the confirmation page could not be used (no signing
         secret): the order still exists, so the number is never lost. */
      <div class="max-w-2xl mx-auto bg-white border border-slate-200/80 rounded-2xl p-6">
        <FormFeedback status="received" message={message} reference={reference} actionHref={createdOrderId ? (authenticatedUserId ? `/orders/${createdOrderId}` : `/track-order?reference=${encodeURIComponent(reference ?? '')}`) : undefined} actionLabel={receivedActionLabel} />
      </div>
    ) : (
      /* Grid, not two flex columns: below lg the summary (items, total, promo
         code, points) now sits BETWEEN the form and the order button, so a
         customer sees what they will pay, and can enter a code, before they
         commit. On desktop the summary stays in the right-hand column. */
      <div class="grid grid-cols-1 gap-x-10 gap-y-6 lg:grid-cols-3 lg:grid-rows-[auto_1fr]">

        <div class="min-w-0 lg:col-span-2 lg:row-start-1">
          {/*
            `reference` is passed through: on a payment-start failure the copy
            says "quote your order number", and the page used to show the
            sentence without the number.
          */}
          {errorLinks.length > 0 ? (
            /* Field errors get a summary that LINKS to each field and takes
               focus (the page script moves it here), instead of a sentence
               about "highlighted fields" that left focus on the page body. */
            <div id="checkout-error-summary" role="alert" tabindex="-1" class="mb-6 rounded-xl border border-red-200 bg-red-50 p-4 text-red-900 outline-none focus-visible:ring-4 focus-visible:ring-red-300">
              <p class="text-sm font-bold">{message}</p>
              <ul class="mt-2 space-y-1.5 text-sm">
                {errorLinks.map((e) => (
                  <li><a href={e.href} class="font-semibold underline underline-offset-2 hover:text-red-950">{e.label}: {e.text}</a></li>
                ))}
              </ul>
            </div>
          ) : (
            /* A refusal with no field to point at (price changed, service
               unavailable) takes focus too, so the page script can move the
               customer to it instead of leaving them at the top of the body. */
            <div id="checkout-feedback" tabindex="-1" class="outline-none" data-error={status === 'error' ? 'true' : undefined}>
            <FormFeedback status={status} message={message} reference={status === 'error' ? reference : undefined} actionHref={feedbackAction?.href} actionLabel={feedbackAction?.label} helpHref={bizCheckout.whatsappUrl ? `${bizCheckout.whatsappUrl}?text=${encodeURIComponent(`Hi GoldPlus, I need help with my checkout${reference ? ` (order ${reference})` : ''}.`)}` : undefined} helpPhone={bizCheckout.phoneDisplay} />
            </div>
          )}

          <form id="checkout-form" method="POST" action="/checkout" novalidate class="space-y-6 mt-4">
            <input type="hidden" name="attribution" id="attribution-field" />
            <!-- Slice 3B: idempotency key — a resubmitted/double-clicked form returns the same order -->
            {/*
              No hidden order key. A hidden field is caller-controlled, so it can
              never be the authoritative operation identity, a client could vary
              it to force a duplicate order, or reuse another customer's. The
              identity is derived server-side from the verified principal and the
              signed intent id.
            */}
            <div class="bg-white p-6 md:p-8 rounded-2xl border border-slate-200/80">
              <h2 class="text-base md:text-lg font-black text-gray-900 mb-6 flex items-center gap-2.5">
                <span aria-hidden="true" class="w-6 h-6 rounded-full bg-slate-900 text-white flex items-center justify-center text-xs font-black">1</span>
                Customer details
              </h2>
              
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                <FormField id="name" name="name" label="Full name" required autocomplete="name" defaultValue={values.name} errorMessage={errors.name} />
                <FormField id="email" name="email" label="Email" type="email" autocomplete="email" defaultValue={values.email} errorMessage={errors.email} />
                <FormField id="phone" name="phone" label="Phone (mobile or landline)" type="tel" required inputmode="tel" autocomplete="tel" placeholder="07XX XXX XXX" defaultValue={values.phone} errorMessage={errors.phone} />
                <div class="md:col-span-2 space-y-4">
                   {savedAddresses.length > 0 && (
                     <fieldset class="space-y-2">
                       <legend class="text-sm font-bold text-gray-900 mb-2">Deliver to</legend>
                       {savedAddresses.map((a) => (
                         <label class="flex items-start gap-3 p-3.5 border border-slate-200/70 rounded-xl hover:border-brand-primary cursor-pointer select-none bg-slate-50/30 transition-all has-[:checked]:border-brand-primary has-[:checked]:bg-brand-primary/5">
                           <input
                             type="radio"
                             name="addressId"
                             value={a.id}
                             data-district={a.district}
                             data-area={a.areaDetails}
                             data-area-slug={a.areaSlug ?? ''}
                             checked={a.id === defaultAddress?.id}
                             class="mt-0.5 w-5 h-5 accent-[#456B00] cursor-pointer js-address-choice"
                           />
                           <span class="min-w-0">
                             <span class="font-bold text-gray-900 text-sm">{a.label}</span>
                             {a.isDefault && <span class="ml-2 text-[10px] font-black uppercase tracking-widest text-brand-primaryInk">Default</span>}
                             <span class="block text-xs text-slate-500 mt-0.5">{a.recipientName} · {a.phone}</span>
                             <span class="block text-xs text-slate-500">{a.areaDetails}, {a.district}</span>
                           </span>
                         </label>
                       ))}
                       <label class="flex items-center gap-3 p-3.5 border border-dashed border-slate-300 rounded-xl hover:border-brand-primary cursor-pointer select-none transition-all has-[:checked]:border-brand-primary">
                         <input type="radio" name="addressId" value="" class="w-5 h-5 accent-[#456B00] cursor-pointer js-address-choice" />
                         <span class="font-bold text-gray-900 text-sm">Deliver somewhere else</span>
                       </label>
                     </fieldset>
                   )}
                   <div id="new-address-fields" class="space-y-4">
                     {pickupPoints.length > 0 && (
              <fieldset class="space-y-2" id="delivery-method-block">
                <legend class="block text-sm font-bold text-brand-charcoal">How would you like to get this order?</legend>
                <div class="flex flex-wrap gap-x-4 gap-y-2">
                  <label class="flex min-h-11 items-center gap-2 text-sm font-semibold"><input type="radio" name="deliveryMethod" value="door" checked={values.deliveryMethod !== 'pickup'} class="js-method-radio w-5 h-5 accent-[#456B00]" /> Deliver to me</label>
                  <label class="flex min-h-11 items-center gap-2 text-sm font-semibold"><input type="radio" name="deliveryMethod" value="pickup" checked={values.deliveryMethod === 'pickup'} class="js-method-radio w-5 h-5 accent-[#456B00]" /> I'll collect from a pickup point</label>
                </div>
                <select id="pickupPointSelect" name="pickupPointId" class={`${values.deliveryMethod === 'pickup' ? '' : 'hidden '}w-full bg-white border ${errors.pickupPointId ? 'border-red-600' : 'border-brand-borderGrey'} px-3 py-2.5 rounded-lg text-base sm:text-sm font-medium outline-none focus:ring-2 focus:ring-brand-primaryInk`} aria-label="Choose a pickup point" aria-invalid={errors.pickupPointId ? 'true' : undefined} aria-describedby={errors.pickupPointId ? 'pickupPointSelect-error' : undefined}>
                  <option value="">Choose a pickup point…</option>
                  {pickupPoints.map((p) => (
                    <option value={p.id} selected={p.id === values.pickupPointId} data-name={p.name} data-address={p.physicalAddress ?? ''}>{p.name} ({p.operator.replace(/_/g, ' ')})</option>
                  ))}
                </select>
                {errors.pickupPointId && <p id="pickupPointSelect-error" class="text-xs text-red-600 font-bold">{errors.pickupPointId}</p>}
              </fieldset>
            )}
            <UgandaLocationPicker
              id="deliveryLocation"
              withPin={true}
                       name="locationJson"
                       label="Delivery location"
                       helperText="Type the area, town or district you know, for example Najjera, Seeta or Mbarara."
                       required={savedAddresses.length === 0}
                       defaultValue={values.locationJson}
                       errorMessage={errors.locationJson}
                     />
                     <FormField
                       id="deliveryAddress"
                       name="deliveryAddress"
                       label="Exact address: estate, road, building or landmark"
                       placeholder="e.g. Kigoowa Road, gate after Capital Shoppers"
                       required
                       defaultValue={values.deliveryAddress}
                       errorMessage={errors.deliveryAddress}
                     />
                     {authenticatedUserId && (
                       <label class="flex items-center gap-2.5 text-sm text-slate-600 cursor-pointer select-none">
                         <input type="checkbox" name="saveAddress" value="true" checked class="w-4 h-4 rounded border-slate-300 text-brand-primary focus:ring-brand-primaryInk cursor-pointer" />
                         <span>Save this address to my account for faster checkout next time</span>
                       </label>
                     )}
                   </div>
                </div>
              </div>
            </div>

             <div class="bg-white p-6 md:p-8 rounded-2xl border border-slate-200/80">
              <h2 class="text-base md:text-lg font-black text-gray-900 mb-6 flex items-center gap-2.5">
                <span aria-hidden="true" class="w-6 h-6 rounded-full bg-slate-900 text-white flex items-center justify-center text-xs font-black">2</span>
                Payment method
              </h2>
              {/* The chosen card is marked by more than a 13px browser-blue dot:
                  the same checked treatment the saved-address cards use, and a
                  radio in the accessible lime ink. */}
              <fieldset class="space-y-4">
                <legend class="sr-only">Choose how to pay</legend>
                <label class="flex items-start gap-3 p-4 border border-slate-200/70 rounded-xl hover:border-brand-primary cursor-pointer select-none bg-slate-50/30 transition-all has-[:checked]:border-brand-primary has-[:checked]:bg-brand-primary/5 has-[:checked]:ring-1 has-[:checked]:ring-brand-primary">
                  <input type="radio" name="paymentMethod" value="offline" checked={paymentMethodValue !== 'pesapal'} class="mt-0.5 w-5 h-5 shrink-0 accent-[#456B00] cursor-pointer" />
                  <div>
                    <span class="font-bold text-gray-900 text-sm">{paymentCopy.offline.label}</span>
                    <p class="text-xs text-slate-500 mt-1.5 leading-relaxed">{paymentCopy.offline.description}</p>
                  </div>
                </label>
                <label class="flex items-start gap-3 p-4 border border-slate-200/70 rounded-xl hover:border-brand-primary cursor-pointer select-none bg-slate-50/30 transition-all has-[:checked]:border-brand-primary has-[:checked]:bg-brand-primary/5 has-[:checked]:ring-1 has-[:checked]:ring-brand-primary">
                  <input type="radio" name="paymentMethod" value="pesapal" checked={paymentMethodValue === 'pesapal'} class="mt-0.5 w-5 h-5 shrink-0 accent-[#456B00] cursor-pointer" />
                  <div>
                    <span class="font-bold text-gray-900 text-sm">{paymentCopy.pesapal.label}</span>
                    <p class="text-xs text-slate-500 mt-1.5 leading-relaxed">{paymentCopy.pesapal.description}</p>
                  </div>
                </label>
              </fieldset>
            </div>

            {/* One optional question, for attribution only: never required, no
                default answer, and "prefer not to say" sends nothing. */}
            <div class="bg-white p-6 md:p-8 rounded-2xl border border-slate-200/80">
              <label for="heardAbout" class="block text-sm font-bold text-gray-900">How did you hear about us? <span class="font-normal text-slate-500">(optional)</span></label>
              <select id="heardAbout" name="heardAbout" class="mt-2 w-full min-h-11 bg-white border border-brand-borderGrey px-3 py-2.5 rounded-lg text-base sm:text-sm font-medium outline-none focus:ring-2 focus:ring-brand-primaryInk">
                <option value="" selected={heardAboutValue === ''}>Prefer not to say</option>
                {HEARD_ABOUT_OPTIONS.map((o) => <option value={o.value} selected={heardAboutValue === o.value}>{o.label}</option>)}
              </select>
            </div>

          </form>
        </div>

        <aside class="min-w-0 lg:col-start-3 lg:row-start-1 lg:row-span-2">
          <div class="bg-white rounded-2xl border border-slate-200/80 p-6 sticky top-24">
            <div class="flex items-center justify-between mb-4">
              <h2 class="text-base font-black text-gray-900">Order summary</h2>
              <a href="/cart" class="text-xs font-bold text-slate-500 hover:text-gray-900 underline outline-none focus-visible:ring-2 focus-visible:ring-brand-primaryInk rounded">Edit cart</a>
            </div>
            <ul class="space-y-3 text-sm mb-4" aria-label="Order items">
              {cart.items.map((item) => (
                <li class="flex items-start justify-between gap-3">
                  <div class="min-w-0">
                    <p class="font-bold text-gray-900 truncate">{item.name}</p>
                    <p class="text-xs text-slate-600 font-medium">Qty {item.quantity} × {formatUgx(item.unitPriceUgx || item.priceUgx)}</p>
                  </div>
                  <p class="font-bold text-gray-900 whitespace-nowrap text-sm">{formatUgx((item.unitPriceUgx || item.priceUgx) * item.quantity)}</p>
                </li>
              ))}
            </ul>
            <dl class="space-y-2 text-sm pt-3 border-t border-slate-100">
              <div class="flex items-center justify-between">
                <dt class="text-slate-600">Subtotal</dt>
                <dd class="font-bold text-gray-900 tabular-nums">{formatUgx(cart.subtotalUgx)}</dd>
              </div>
              {checkoutOnSale && (
                <div class="flex items-center justify-between">
                  <dt class="font-medium" style="color:#456B00">{checkoutSavingLabel}</dt>
                  <dd class="font-bold tabular-nums" style="color:#456B00">&minus;{formatUgx(checkoutSavings)}</dd>
                </div>
              )}
              <div class="hidden flex items-center justify-between" id="promo-row">
                <dt class="font-medium" style="color:#456B00">Promo code</dt>
                <dd class="font-bold tabular-nums" style="color:#456B00" id="promo-row-value"></dd>
              </div>
              <div class="flex items-start justify-between gap-3" id="delivery-estimate-row">
                <dt class="text-slate-600">Delivery</dt>
                <dd class="text-right" id="delivery-estimate-value" data-state={initialDeliveryEstimate?.kind ?? 'NONE'}>
                  {initialDeliveryEstimate?.kind === 'CONFIRMED' && initialDeliveryEstimate.feeUgx !== null ? (
                    <span class="font-bold text-gray-900 tabular-nums">{formatUgx(initialDeliveryEstimate.feeUgx)}</span>
                  ) : initialDeliveryEstimate?.kind === 'ESTIMATED' && initialDeliveryEstimate.feeUgx !== null ? (
                    <span class="font-bold text-gray-900 tabular-nums">about {formatUgx(initialDeliveryEstimate.feeUgx)} <span class="block text-[10px] font-semibold text-slate-600">confirmed before the rider leaves</span></span>
                  ) : initialDeliveryEstimate ? (
                    <span class="text-[11px] font-bold text-slate-600">Confirmed by phone before dispatch</span>
                  ) : (
                    <span class="text-[11px] font-bold text-slate-600">Shown when you pick a location</span>
                  )}
                </dd>
              </div>
              {/* Stage 2: the FIXED commitment, plus the cut-off countdown,
                  free-delivery progress, pickup and the proportionality
                  interstitial. Every sentence resolved from the registry. */}
              <div class="pt-3">
                <dt class="sr-only">Delivery commitment</dt>
                <dd id="checkout-delivery-quote" data-subtotal={cart.subtotalUgx} aria-live="polite">
                  <DeliveryQuote
                    stage={2}
                    areaSlug={initialAreaSlug}
                    district={initialDistrict}
                    items={cart.items.map((i: any) => ({ productId: i.productId, quantity: i.quantity }))}
                    subtotalUgx={cart.subtotalUgx}
                  />
                </dd>
              </div>
              <div class="flex items-center justify-between pt-3 border-t border-slate-100">
                <dt class="font-bold text-gray-900 text-sm" id="grand-total-label">{initialDeliveryEstimate?.kind === 'CONFIRMED' ? 'Total to pay' : 'Estimated total'}</dt>
                <dd class="font-black text-gray-900 text-lg tabular-nums" id="grand-total-value" data-subtotal={checkoutSaleSubtotal}>
                  {formatUgx(checkoutSaleSubtotal + (initialDeliveryEstimate?.kind === 'CONFIRMED' ? (initialDeliveryEstimate.feeUgx ?? 0) : 0))}
                </dd>
              </div>
            </dl>
            {initialDeliveryEstimate?.kind === 'ESTIMATED' && (
              <p class="text-[10px] text-slate-600 text-right mt-1">Delivery is added on top and confirmed before the rider leaves.</p>
            )}
            {loyaltyProgramme.active && loyaltyProgramme.redemption.configured && loyaltyAvailablePoints >= (loyaltyProgramme.redemption.minPoints ?? 1) && (
              <div class="mt-4 rounded-xl bg-slate-50 border border-slate-200 px-3.5 py-3 space-y-2">
                <label for="redeemPoints" class="block text-xs font-black uppercase tracking-wider text-slate-600">
                  Use your points. Balance {loyaltyAvailablePoints.toLocaleString('en-UG')} (worth {formatUgx(loyaltyAvailablePoints * (loyaltyProgramme.redemption.pointValueUgx ?? 0))})
                </label>
                <div class="flex items-center gap-2">
                  <input
                    type="number"
                    id="redeemPoints"
                    name="redeemPoints"
                    form="checkout-form"
                    min={loyaltyProgramme.redemption.minPoints}
                    max={loyaltyAvailablePoints}
                    step="1"
                    inputmode="numeric"
                    placeholder={`min ${loyaltyProgramme.redemption.minPoints}`}
                    value={redeemPointsValue}
                    class="w-32 px-3 py-2 bg-white border border-brand-borderGrey rounded-lg text-base sm:text-sm font-bold outline-none focus:ring-2 focus:ring-brand-primaryInk"
                    data-point-value={loyaltyProgramme.redemption.pointValueUgx}
                  />
                  <span class="text-xs font-semibold text-slate-500" id="redeem-value-preview">We will show the discount before you pay</span>
                </div>
                <p class="text-[11px] text-slate-500">Points can cover up to {Math.floor((loyaltyProgramme.redemption.maxShareBps ?? 0) / 100)}% of the goods total. The exact discount is confirmed when you place the order.</p>
              </div>
            )}
            <div
              id="promo-code-block"
              class="mt-4 rounded-xl bg-slate-50 border border-slate-200 px-3.5 py-3 space-y-2"
              data-items={JSON.stringify(cart.items.map((i: any) => ({ productId: i.productId, quantity: i.quantity })))}
            >
              <label for="couponCode" class="block text-xs font-black uppercase tracking-wider text-slate-600">Have a promo code?</label>
              <div class="flex items-center gap-2">
                <input
                  type="text"
                  id="couponCode"
                  name="couponCode"
                  form="checkout-form"
                  maxlength="40"
                  autocomplete="off"
                  autocapitalize="characters"
                  spellcheck="false"
                  placeholder="e.g. GOLD10"
                  value={couponCodeValue}
                  class="w-40 px-3 py-2 bg-white border border-brand-borderGrey rounded-lg text-base sm:text-sm font-bold uppercase tracking-wider outline-none focus:ring-2 focus:ring-brand-primaryInk"
                />
                <button
                  type="button"
                  id="promo-apply"
                  class="inline-flex min-h-11 items-center rounded-full border-2 border-brand-primary px-4 text-xs font-black uppercase tracking-wider text-gray-900 outline-none hover:bg-brand-primary/10 focus-visible:ring-4 focus-visible:ring-brand-primaryInk disabled:opacity-50"
                >Apply</button>
              </div>
              <p id="promo-message" class="text-[11px] font-semibold text-slate-500" aria-live="polite"></p>
              <input type="hidden" id="previewQuoteId" name="previewQuoteId" form="checkout-form" value={previewQuoteIdValue} />
            </div>
            {pricedFromDevice && (
              <p class="mt-4 rounded-xl border border-amber-200 bg-amber-50 px-3.5 py-2.5 text-xs font-semibold text-amber-900">
                We could not reach our pricing service just now, so these totals come from your device. We confirm the real total before you pay.
              </p>
            )}
            {potentialPoints > 0 && (
              authenticatedUserId ? (
                <p class="mt-4 rounded-xl bg-slate-50 border border-slate-200 px-3.5 py-2.5 text-xs font-semibold text-slate-700">
                  You'll earn at least <strong style="color:#456B00">{potentialPoints.toLocaleString('en-UG')} GoldPlus points</strong> when this order is delivered.
                </p>
              ) : (
                <p class="mt-4 rounded-xl bg-slate-50 border border-slate-200 px-3.5 py-2.5 text-xs font-semibold text-slate-700">
                  <a href="/login?returnTo=/checkout" class="underline font-bold">Sign in</a> or
                  <a href="/register?returnTo=/checkout" class="underline font-bold">create an account</a> to earn at least
                  <strong style="color:#456B00"> {potentialPoints.toLocaleString('en-UG')} GoldPlus points</strong> on this order.
                </p>
              )
            )}
          </div>
        </aside>
        {/* The order button, AFTER the summary in the document: below lg it
            follows the total and the promo code; on desktop it sits under the
            form. `form=` keeps it the form's submit button (Enter still
            submits, and it carries its own value). */}
        <div class="min-w-0 lg:col-span-2 lg:row-start-2 self-start">
          <p class="lg:hidden mb-3 flex items-baseline justify-between gap-3 rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm">
            <span class="font-bold text-gray-900" id="submit-total-label">{initialDeliveryEstimate?.kind === 'CONFIRMED' ? 'Total to pay' : 'Estimated total'}</span>
            <span class="font-black text-gray-900 tabular-nums" id="submit-total-value">{formatUgx(checkoutSaleSubtotal + (initialDeliveryEstimate?.kind === 'CONFIRMED' ? (initialDeliveryEstimate.feeUgx ?? 0) : 0))}</span>
          </p>
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
            {/*
              The button says what pressing it DOES. It used to read "Pay Online"
              while the preselected method was the offline invoice, the wrong
              promise at the most decisive moment of the whole funnel.
            */}
            <button
              type="submit"
              form="checkout-form"
              id="submitBtn"
              data-label-offline="Place order"
              data-label-pesapal="Pay securely now"
              class="w-full sm:w-auto px-8 h-[52px] rounded-full font-semibold text-[15px] hover:shadow-lg hover:shadow-brand-primary/20 transition-all outline-none focus-visible:ring-4 focus-visible:ring-brand-primaryInk cursor-pointer hover:scale-[1.005] active:scale-[0.985] shadow-sm"
              style="background:#93D500;color:#0A0A0A"
            >
              {paymentMethodValue === 'pesapal' ? 'Pay securely now' : 'Place order'}
            </button>
            <p id="cutoff-line" class="text-xs font-semibold" style="color:#456B00" data-scoped={sameDayCopy.scoped} data-in-area={sameDayCopy.inArea} data-outside={sameDayCopy.outside}>{cutoffLine}</p>
          </div>
        </div>
      </div>
    )}
  </div>

  {/* Embed cart data for client-side telemetry — no sensitive data, prices are public */}
  <div
    id="checkout-telemetry-data"
    data-subtotal={checkoutSaleSubtotal}
    data-items={JSON.stringify(cart.items.map(i => ({
      item_id:   i.productId,
      item_name: i.name,
      price:     i.unitPriceUgx || i.priceUgx,
      quantity:  i.quantity,
      item_brand: 'GoldPlus',
    })))}
    aria-hidden="true"
    style="display:none"
  ></div>
</BaseLayout>

<script>
  // Explicit wiring (2026-08-06): the picker's behaviour used to reach this
  // page only through Astro's implicit chunk-linking of component scripts,
  // which no grep could audit. The page now names its dependency; init is
  // idempotent, so double-import double-wires nothing.
  import '../lib/locationPickerClient';
  import { track, captureClickIdsServerSide } from '../lib/telemetry';
  import { getCheckoutAttribution } from '../lib/attribution';
  import { publicApiBase } from '../lib/api';
  import { buildDeliveryQuoteRequest, renderDeliveryQuotePanel, DELIVERY_QUOTE_UNREACHABLE_HTML } from '../lib/deliveryQuotePanel';

  document.addEventListener('DOMContentLoaded', () => {
    const dataEl  = document.getElementById('checkout-telemetry-data');
    if (!dataEl) return;

    const subtotal = Number(dataEl.dataset.subtotal ?? '0');
    let items: any[] = [];
    try { items = JSON.parse(dataEl.dataset.items ?? '[]'); } catch { /* ignore */ }

    // Persist click IDs — critical for attributing this checkout session
    captureClickIdsServerSide();

    // ── begin_checkout — fires when user reaches the checkout page ────────────
    track('begin_checkout', {
      ecommerce: { value: subtotal, currency: 'UGX', items },
    });

    // ── fast-checkout interactions (progressive enhancement only) ─────────────
    // Without JS everything still works: the new-address block stays visible and
    // the server decides between saved address and typed location.
    const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement | null;
    const methodRadios = document.querySelectorAll<HTMLInputElement>('input[name="paymentMethod"]');
    const syncSubmitLabel = () => {
      if (!submitBtn) return;
      const method = document.querySelector<HTMLInputElement>('input[name="paymentMethod"]:checked')?.value ?? 'offline';
      submitBtn.textContent = (method === 'pesapal' ? submitBtn.dataset.labelPesapal : submitBtn.dataset.labelOffline) ?? 'Place order';
    };
    methodRadios.forEach((r) => r.addEventListener('change', syncSubmitLabel));
    syncSubmitLabel();

    const addressRadios = document.querySelectorAll<HTMLInputElement>('input.js-address-choice');
    const newAddressBlock = document.getElementById('new-address-fields');
    const syncAddressBlock = () => {
      if (!newAddressBlock || addressRadios.length === 0) return;
      const chosen = document.querySelector<HTMLInputElement>('input.js-address-choice:checked');
      const usingSaved = Boolean(chosen && chosen.value !== '');
      newAddressBlock.classList.toggle('hidden', usingSaved);
    };
    addressRadios.forEach((r) => r.addEventListener('change', syncAddressBlock));
    syncAddressBlock();

    // ── live delivery estimate ────────────────────────────────────────────────
    // Re-quotes whenever the destination changes: a saved-address radio (its
    // district travels on data-district) or a fresh picker selection. CONFIRMED
    // fees (operator zones — actually charged) join the grand total; ESTIMATES
    // stay advisory and never inflate the number the customer commits to.
    const API_BASE = publicApiBase;
    const estimateEl = document.getElementById('delivery-estimate-value');
    const totalEl = document.getElementById('grand-total-value');
    const totalLabelEl = document.getElementById('grand-total-label');
    // The phone-width copy of the total beside the order button.
    const submitTotalEl = document.getElementById('submit-total-value');
    const submitTotalLabelEl = document.getElementById('submit-total-label');
    // The same-day line follows the chosen district (three server-written
    // variants; the page never composes a delivery promise of its own).
    const cutoffEl = document.getElementById('cutoff-line');
    const SAME_DAY = ['kampala', 'wakiso'];
    function setCutoffFor(district: string | null) {
      if (!cutoffEl) return;
      const d = (district ?? '').trim().toLowerCase();
      const text = !d ? cutoffEl.dataset.scoped : SAME_DAY.includes(d) ? cutoffEl.dataset.inArea : cutoffEl.dataset.outside;
      if (text) cutoffEl.textContent = text;
    }
    const ugx = (n: number) => `UGX ${new Intl.NumberFormat('en-US', { maximumFractionDigits: 0 }).format(Math.round(n))}`;

    // Promo-code state: the applied discount lowers the GOODS total; the last
    // delivery estimate is kept so applying a code re-renders the same view.
    let promoDiscountUgx = 0;
    let lastEstimate: { kind: string; feeUgx: number | null } | null = null;
    // Whether the customer has told us where the order goes. A place we
    // cannot price (UNAVAILABLE, or written directions) is still a place:
    // the row used to fall back to "Shown when you pick a location" right
    // after they had picked one.
    let lastLocated = estimateEl?.dataset.state !== undefined && estimateEl.dataset.state !== 'NONE';
    const goodsTotal = () => Math.max(0, subtotal - promoDiscountUgx);

    function renderEstimate(est: { kind: string; feeUgx: number | null } | null, located: boolean = lastLocated) {
      lastEstimate = est;
      lastLocated = located;
      if (!estimateEl || !totalEl || !totalLabelEl) return;
      renderEstimateRow(est, located);
      if (submitTotalEl) submitTotalEl.textContent = totalEl.textContent;
      if (submitTotalLabelEl) submitTotalLabelEl.textContent = totalLabelEl.textContent;
    }

    function renderEstimateRow(est: { kind: string; feeUgx: number | null } | null, located: boolean) {
      if (!estimateEl || !totalEl || !totalLabelEl) return;
      // The Total always includes every fee shown above it. A CONFIRMED fee is
      // the amount to pay; an ESTIMATE is folded into an "Estimated total" so the
      // customer never sees a total that excludes a fee the page just quoted.
      if (est && est.kind === 'CONFIRMED' && est.feeUgx !== null) {
        estimateEl.innerHTML = `<span class="font-bold text-gray-900 tabular-nums">${ugx(est.feeUgx)}</span>`;
        totalLabelEl.textContent = 'Total to pay';
        totalEl.textContent = ugx(goodsTotal() + est.feeUgx);
      } else if (est && est.kind === 'ESTIMATED' && est.feeUgx !== null) {
        // An estimate is not a commitment: it is shown, but only a CONFIRMED
        // operator-zone fee joins the committed total (Slice 03 P0 contract).
        estimateEl.innerHTML = `<span class="font-bold text-gray-900 tabular-nums">about ${ugx(est.feeUgx)} <span class="block text-[10px] font-semibold text-slate-600">confirmed before the rider leaves</span></span>`;
        totalLabelEl.textContent = 'Estimated total';
        totalEl.textContent = ugx(goodsTotal());
      } else if (located) {
        // UNAVAILABLE, written directions, or the estimate could not be
        // reached: the same sentence the quote panel and the subtitle use.
        estimateEl.innerHTML = '<span class="text-[11px] font-bold text-slate-600">Confirmed by phone before dispatch</span>';
        totalLabelEl.textContent = 'Estimated total';
        totalEl.textContent = ugx(goodsTotal());
      } else {
        estimateEl.innerHTML = '<span class="text-[11px] font-bold text-slate-600">Shown when you pick a location</span>';
        totalLabelEl.textContent = 'Estimated total';
        totalEl.textContent = ugx(goodsTotal());
      }
    }

    let estimateSeq = 0;
    // The basket travels with every estimate (`<productId>:<qty>`), so the
    // quote is for what the order will be charged, not for an empty parcel.
    const estimateItems = (() => {
      try {
        const list = JSON.parse(document.getElementById('promo-code-block')?.getAttribute('data-items') || '[]') as Array<{ productId: string; quantity: number }>;
        return list.map((i) => `${i.productId}:${i.quantity}`).join(',');
      } catch { return ''; }
    })();
    // ── the delivery commitment panel, re-quoted after a location pick ─────────
    // The server rendered it for the saved address (or for no place at all).
    // A guest who picks a location used to keep that first answer; now the
    // panel is asked again from the SAME endpoint the server used (POST
    // /delivery/quote, the one quoting service) and drawn by the SAME renderer,
    // so it cannot disagree with the first paint or with the order's charge.
    const quotePanelEl = document.getElementById('checkout-delivery-quote');
    const quoteItems: Array<{ productId: string; quantity: number }> = (() => {
      try { return JSON.parse(document.getElementById('promo-code-block')?.getAttribute('data-items') || '[]'); }
      catch { return []; }
    })();
    let quoteSeq = 0;
    async function refreshQuotePanel(district: string | null, area: string | null, areaSlug: string | null) {
      if (!quotePanelEl || !API_BASE) return;
      const seq = ++quoteSeq;
      const body = buildDeliveryQuoteRequest({
        district,
        areaSlug,
        deliveryArea: area,
        items: quoteItems,
        subtotalUgx: Number(quotePanelEl.dataset.subtotal) || 0,
      });
      let html = DELIVERY_QUOTE_UNREACHABLE_HTML;
      try {
        const res = await fetch(`${API_BASE}/delivery/quote`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
          signal: AbortSignal.timeout(6000),
        });
        const json = await res.json().catch(() => null);
        if (json?.success) html = renderDeliveryQuotePanel(json.data, { stage: 2 });
      } catch { /* the unreachable line, as on the server */ }
      if (seq !== quoteSeq) return; // a newer destination superseded this quote
      quotePanelEl.innerHTML = html;
    }

    async function refreshEstimate(district: string | null, area: string | null, areaSlug: string | null = null) {
      setCutoffFor(district);
      void refreshQuotePanel(district, area, areaSlug);
      const seq = ++estimateSeq;
      if (!district) { renderEstimate(null, false); return; }
      if (!API_BASE) { renderEstimate(null, true); return; }
      try {
        const qs = new URLSearchParams({
          district,
          ...(area ? { area } : {}),
          ...(areaSlug ? { areaSlug } : {}),
          ...(estimateItems ? { items: estimateItems } : {}),
        });
        const res = await fetch(`${API_BASE}/commerce/delivery-estimate?${qs}`, { signal: AbortSignal.timeout(4000) });
        const json = await res.json().catch(() => null);
        if (seq !== estimateSeq) return; // a newer destination superseded this quote
        renderEstimate(json?.success ? json.data.estimate : null, true);
      } catch {
        if (seq === estimateSeq) renderEstimate(null, true);
      }
    }

    addressRadios.forEach((r) =>
      r.addEventListener('change', () => {
        if (r.checked && r.value !== '') refreshEstimate(r.dataset.district ?? null, r.dataset.area || null, r.dataset.areaSlug || null);
        else if (r.checked) onPickerChange();
      }),
    );
    const pickerPayload = document.querySelector<HTMLInputElement>('form[action="/checkout"] .js-final-payload');
    function onPickerChange() {
      const raw = pickerPayload?.value ?? '';
      if (!raw) { ++estimateSeq; setCutoffFor(null); renderEstimate(null, false); void refreshQuotePanel(null, null, null); return; }
      try {
        const loc = JSON.parse(raw);
        if (loc?.district) { refreshEstimate(String(loc.district), loc.area ?? null, loc.areaSlug ? String(loc.areaSlug) : null); return; }
        // Written directions or a pickup point: a place, with no district to price.
        ++estimateSeq;
        setCutoffFor(null);
        renderEstimate(null, true);
        void refreshQuotePanel(null, null, null);
      } catch {
        ++estimateSeq;
        setCutoffFor(null);
        renderEstimate(null, false);
      }
    }
    pickerPayload?.addEventListener('change', onPickerChange);
    // A returning guest's form opens with their last place already chosen:
    // price it now rather than showing "pick a location" beside a location.
    // (Called directly: re-dispatching 'change' would also fire the funnel event.)
    const savedChosenAtLoad = document.querySelector<HTMLInputElement>('input.js-address-choice:checked');
    if (pickerPayload?.value && !(savedChosenAtLoad && savedChosenAtLoad.value !== '')) onPickerChange();

    // ── promo code (Apply = live preview from the SAME evaluator that charges) ──
    const promoInput = document.getElementById('couponCode') as HTMLInputElement | null;
    const promoApply = document.getElementById('promo-apply') as HTMLButtonElement | null;
    const promoMsg = document.getElementById('promo-message');
    const promoRow = document.getElementById('promo-row');
    const promoRowValue = document.getElementById('promo-row-value');
    const promoQuoteField = document.getElementById('previewQuoteId') as HTMLInputElement | null;
    const promoItems: Array<{ productId: string; quantity: number }> = (() => {
      try { return JSON.parse(document.getElementById('promo-code-block')?.getAttribute('data-items') || '[]'); }
      catch { return []; }
    })();

    function setPromo(discount: number, message: string | null, tone: 'ok' | 'error' | 'muted') {
      promoDiscountUgx = discount;
      if (promoRow && promoRowValue) {
        promoRow.classList.toggle('hidden', discount <= 0);
        promoRowValue.textContent = '\u2212' + ugx(discount);
      }
      if (promoMsg) {
        promoMsg.textContent = message ?? '';
        promoMsg.className = 'text-[11px] font-semibold ' +
          (tone === 'ok' ? 'text-emerald-700' : tone === 'error' ? 'text-red-600' : 'text-slate-600');
      }
      renderEstimate(lastEstimate);
    }

    promoApply?.addEventListener('click', async () => {
      const code = (promoInput?.value ?? '').trim();
      if (promoQuoteField) promoQuoteField.value = '';
      if (!code) { setPromo(0, null, 'muted'); return; }
      if (!API_BASE || promoItems.length === 0) { setPromo(0, 'The code will be applied when you place the order.', 'muted'); return; }
      promoApply.disabled = true;
      if (promoMsg) { promoMsg.textContent = 'Checking\u2026'; promoMsg.className = 'text-[11px] font-semibold text-slate-600'; }
      try {
        const res = await fetch(`${API_BASE}/commerce/pricing-preview`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ items: promoItems, couponCode: code }),
          signal: AbortSignal.timeout(5000),
        });
        const json = await res.json().catch(() => null);
        if (json?.success && json.data) {
          if (json.data.couponApplied) {
            if (promoQuoteField) promoQuoteField.value = String(json.data.quoteId || '');
            setPromo(Number(json.data.couponDiscountUgx) || 0, `Code applied. You save ${ugx(Number(json.data.couponDiscountUgx) || 0)}.`, 'ok');
          } else {
            setPromo(0, json.data.couponMessage || 'This code cannot be applied to this basket.', 'error');
          }
        } else {
          setPromo(0, json?.error?.message || 'Could not check the code right now. It will still be applied when you place the order if it is valid.', 'muted');
        }
      } catch {
        setPromo(0, 'Could not check the code right now. It will still be applied when you place the order if it is valid.', 'muted');
      } finally {
        promoApply.disabled = false;
      }
    });
    // Editing the code invalidates the previewed quote (the server re-prices anyway).
    promoInput?.addEventListener('input', () => { if (promoQuoteField) promoQuoteField.value = ''; });
    // A code carried back after a refusal is checked again, so the summary
    // shows its discount and the retry carries a fresh preview.
    if (promoInput?.value.trim()) promoApply?.click();

    // ── offline draft persistence (brief F.5): a dropped connection must not
    // eat a half-typed address. Saved locally, restored when fields are empty,
    // cleared on successful submission (success page has no form).
    const DRAFT_KEY = 'gp_checkout_draft_v1';
    const draftFields = ['name', 'email', 'phone', 'deliveryAddress'] as const;
    const formEl = document.getElementById('checkout-form') as HTMLFormElement | null;
    function saveDraft() {
      try {
        const data: Record<string, string> = {};
        for (const f of draftFields) {
          const el = document.getElementById(f) as HTMLInputElement | null;
          if (el?.value) data[f] = el.value;
        }
        const payloadEl = formEl?.querySelector('.js-final-payload') as HTMLInputElement | null;
        if (payloadEl?.value) data.locationJson = payloadEl.value;
        localStorage.setItem(DRAFT_KEY, JSON.stringify(data));
      } catch { /* storage full/blocked. Drafts are a convenience */ }
    }
    function restoreDraft() {
      try {
        const raw = localStorage.getItem(DRAFT_KEY);
        if (!raw) return;
        const data = JSON.parse(raw) as Record<string, string>;
        for (const f of draftFields) {
          const el = document.getElementById(f) as HTMLInputElement | null;
          if (el && !el.value && data[f]) el.value = data[f];
        }
      } catch { /* corrupt draft = ignore */ }
    }
    restoreDraft();
    formEl?.addEventListener('input', () => saveDraft());
    formEl?.addEventListener('submit', () => {
      // Stamp last-touch marketing attribution onto the order (best-effort).
      try {
        const attrEl = document.getElementById('attribution-field') as HTMLInputElement | null;
        if (attrEl) attrEl.value = JSON.stringify(getCheckoutAttribution() ?? {});
      } catch { /* attribution is optional */ }
      try { localStorage.removeItem(DRAFT_KEY); } catch { /* ignore */ }
    });

    // ── live redemption value preview (PART G: value shown WITH the points) ──
    const redeemInput = document.getElementById('redeemPoints') as HTMLInputElement | null;
    const redeemPreview = document.getElementById('redeem-value-preview');
    redeemInput?.addEventListener('input', () => {
      const pv = Number(redeemInput.dataset.pointValue ?? 0);
      const pts = parseInt(redeemInput.value, 10);
      if (redeemPreview) {
        redeemPreview.textContent =
          Number.isInteger(pts) && pts > 0 && pv > 0 ? `= ${ugx(pts * pv)} off this order` : 'We will show the discount before you pay';
      }
    });

    // ── pickup point method toggle (PART G field 1) ──────────────────────────
    const methodRadios2 = document.querySelectorAll<HTMLInputElement>('input.js-method-radio');
    const pickupSelect = document.getElementById('pickupPointSelect') as HTMLSelectElement | null;
    const pickerBlock = formEl?.querySelector('.js-uganda-location-picker') as HTMLElement | null;
    const landmarkField = document.getElementById('deliveryAddress')?.closest('div');
    function syncMethod() {
      const pickup = document.querySelector<HTMLInputElement>('input.js-method-radio:checked')?.value === 'pickup';
      pickupSelect?.classList.toggle('hidden', !pickup);
      pickerBlock?.classList.toggle('hidden', pickup);
      (landmarkField as HTMLElement | undefined)?.classList.toggle('hidden', pickup);
      if (pickup) applyPickupSelection();
    }
    function applyPickupSelection() {
      const opt = pickupSelect?.selectedOptions?.[0];
      const payloadEl = formEl?.querySelector('.js-final-payload') as HTMLInputElement | null;
      if (!payloadEl) return;
      if (opt && opt.value) {
        payloadEl.value = JSON.stringify({
          manual: true,
          rawAddressText: `Pickup point: ${opt.dataset.name}${opt.dataset.address ? ', ' + opt.dataset.address : ''}`,
        });
        payloadEl.dispatchEvent(new Event('change', { bubbles: true }));
      }
    }
    methodRadios2.forEach((r) => r.addEventListener('change', syncMethod));
    pickupSelect?.addEventListener('change', applyPickupSelection);
    // A form that came back with "collect" chosen opens in that state.
    if (methodRadios2.length > 0) syncMethod();

    // ── add_shipping_info: the address step becomes visible in the funnel ────
    let shippingTracked = false;
    pickerPayload?.addEventListener('change', () => {
      if (shippingTracked || !pickerPayload.value) return;
      shippingTracked = true;
      track('add_shipping_info', { ecommerce: { value: subtotal, currency: 'UGX', items } });
    });

    // ── add_payment_info — fires when user submits the checkout form ──────────
    const form = document.querySelector<HTMLFormElement>('form[action="/checkout"]');
    // The button is really disabled, not just styled as disabled: a second
    // tap on a slow connection re-POSTed the form. The intent fingerprint made
    // that idempotent server-side, but the customer then saw "already being
    // processed" as a red error. Deferred one tick so the submit itself
    // carries the button's value.
    form?.addEventListener('submit', () => {
      if (!submitBtn) return;
      submitBtn.textContent = 'Sending your order…';
      submitBtn.classList.add('opacity-80', 'cursor-not-allowed');
      setTimeout(() => { submitBtn.disabled = true; }, 0);
    });
    // Browser Back from the PesaPal page restores this document from the
    // back-forward cache with the button still frozen. Give it back. The label
    // is worked out from the method that is CHECKED now: a label captured at
    // load said "Place order" under a selected "Pay now". And the browser can
    // restore a checked radio without firing 'change' (a plain Back that is not
    // a bfcache restore), so the choices are re-read after this event as well.
    const resyncChoices = () => {
      syncSubmitLabel();
      syncAddressBlock();
      if (methodRadios2.length > 0) syncMethod();
    };
    window.addEventListener('pageshow', (ev) => {
      if (ev.persisted && submitBtn) {
        submitBtn.disabled = false;
        submitBtn.classList.remove('opacity-80', 'cursor-not-allowed');
      }
      resyncChoices();
      window.setTimeout(resyncChoices, 0);
    });

    // A form that came back with field errors: take the customer to the
    // summary that links to each one (focus used to stay on the page body).
    (document.getElementById('checkout-error-summary') ?? document.querySelector<HTMLElement>('#checkout-feedback[data-error]'))?.focus();
    form?.addEventListener('submit', () => {
      const paymentMethod = (
        form.querySelector<HTMLInputElement>('input[name="paymentMethod"]:checked')?.value ?? 'unknown'
      );
      track('add_payment_info', {
        ecommerce: {
          value:    subtotal,
          currency: 'UGX',
          items,
          // Map payment method to GA4 coupon field (closest equivalent)
          // sGTM tag can extract this for payment type segmentation
          coupon: paymentMethod,
        },
      });
    });
  });
</script>
