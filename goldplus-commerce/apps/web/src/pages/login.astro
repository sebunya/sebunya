---
import BaseLayout from '../layouts/BaseLayout.astro';
import FormField from '../components/FormField.astro';
import FormFeedback from '../components/FormFeedback.astro';
import Notice from '../components/Notice.astro';
import { apiBase } from '../lib/api';
import { SESSION_COOKIE_NAME } from '../lib/session';

let status: 'success' | 'error' | null = null;
let message: string | undefined;
let values: { email?: string } = {};
let notConfigured = false;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const email = String(form.get('email') ?? '').trim();
  const password = String(form.get('password') ?? '');
  values = { email };

  if (!email || !password) {
    status = 'error';
    message = 'Email and password are required.';
  } else {
    try {
      const res = await fetch(`${apiBase}/auth/login`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, password }),
      });
      const json: any = await res.json().catch(() => null);

      if (res.ok && json?.success && json.data?.token) {
        // Via Astro.cookies, NOT a raw Set-Cookie header: Astro drops headers set
        // on Astro.response when the frontmatter returns Astro.redirect(), so the
        // raw-header version signed nobody in — the customer bounced straight
        // back to this page. Admin login always used Astro.cookies and worked,
        // which is why the breakage hid on the customer side only.
        Astro.cookies.set(SESSION_COOKIE_NAME, json.data.token, {
          path: '/',
          httpOnly: true,
          sameSite: 'lax',
          maxAge: 604800,
          secure: import.meta.env.PROD,
        });

        // R2: merge this browser's anonymous experience profile into the
        // signed-in customer — transactional and idempotent on the API side;
        // a hiccup here must never fail the sign-in itself.
        const visitToken = Astro.cookies.get('gp_visit')?.value;
        if (visitToken) {
          try {
            await fetch(`${apiBase}/recommendations/profile/link`, {
              method: 'POST',
              headers: { Authorization: `Bearer ${json.data.token}`, 'x-gp-visit': visitToken },
              signal: AbortSignal.timeout(3000),
            });
          } catch {
            // Continuity, not correctness.
          }
        }
        const returnTo = Astro.url.searchParams.get('returnTo');
        const safe = returnTo && returnTo.startsWith('/') && !returnTo.startsWith('//') ? returnTo : '/account';
        return Astro.redirect(safe, 303);
      }

      if (json?.error?.code === 'AUTH_NOT_CONFIGURED') {
        notConfigured = true;
        message = json.error.message;
      } else {
        status = 'error';
        message = json?.error?.message ?? `Login failed (HTTP ${res.status}).`;
      }
    } catch {
      status = 'error';
      message = 'Cannot reach the authentication service right now. Please try again shortly.';
    }
  }
}
---

<BaseLayout title="Sign in" description="Sign in to your GoldPlus account.">
  <div class="container mx-auto px-4 lg:px-8 py-12 md:py-20">
    <div class="max-w-md mx-auto">
      <h1 class="text-2xl md:text-3xl font-black text-gray-900 mb-2 tracking-tight">Sign in</h1>
      <p class="text-slate-500 mb-6 text-sm leading-relaxed">Access your orders, addresses and account.</p>

      {notConfigured && (
        <div class="mb-6">
          <Notice kind="not-configured" title="Sign-in not configured" message={message} />
        </div>
      )}
      {!notConfigured && <FormFeedback status={status} message={message} />}

      <form method="POST" action="/login" novalidate class="bg-white p-8 rounded-2xl border border-slate-200/80 shadow-xs space-y-5">
        <FormField id="email" name="email" label="Email" type="email" required autocomplete="email" defaultValue={values.email} />
        <FormField id="password" name="password" label="Password" type="password" required autocomplete="current-password" />
        <button
          type="submit"
          class="w-full bg-brand-primary text-gray-955 py-2.5 rounded-full font-bold text-xs tracking-wider uppercase hover:shadow-lg hover:shadow-brand-primary/20 transition-all outline-none cursor-pointer hover:scale-[1.005] active:scale-[0.985]"
        >
          Sign in
        </button>
        <p class="text-xs text-slate-400 text-center leading-relaxed">
          New to GoldPlus?
          <a href={`/register${Astro.url.searchParams.get('returnTo') ? `?returnTo=${encodeURIComponent(Astro.url.searchParams.get('returnTo') ?? '')}` : ''}`} class="font-bold text-slate-600 underline hover:text-gray-900">Create your account</a>
        </p>
      </form>
    </div>
  </div>
</BaseLayout>
