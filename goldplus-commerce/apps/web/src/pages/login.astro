---
import { jsonApiHeaders } from '../lib/forwardClient';
import { safeReturnTo } from '../lib/safeReturnTo';
import BaseLayout from '../layouts/BaseLayout.astro';
import FormField from '../components/FormField.astro';
import FormFeedback from '../components/FormFeedback.astro';
import Notice from '../components/Notice.astro';
import { apiBase } from '../lib/api';
import SocialSignIn from '../components/auth/SocialSignIn.astro';
import { SESSION_COOKIE_NAME } from '../lib/session';

/**
 * The visitor's address, forwarded so abuse control counts THEM and not this
 * container. Reading it can throw in a prerendered context, so it degrades to
 * the shared bucket rather than breaking the page.
 */
let clientAddress: string | null = null;
try {
  clientAddress = Astro.clientAddress ?? null;
} catch {
  clientAddress = null;
}


let status: 'success' | 'error' | null = null;
let message: string | undefined;
let values: { email?: string } = {};
let notConfigured = false;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const email = String(form.get('email') ?? '').trim();
  const password = String(form.get('password') ?? '');
  values = { email };

  if (!email || !password) {
    status = 'error';
    message = 'Email and password are required.';
  } else {
    try {
      const res = await fetch(`${apiBase}/auth/login`, {
        method: 'POST',
        headers: jsonApiHeaders(clientAddress),
        body: JSON.stringify({ email, password }),
      });
      const json: any = await res.json().catch(() => null);

      if (res.ok && json?.success && json.data?.token) {
        // Via Astro.cookies, NOT a raw Set-Cookie header: Astro drops headers set
        // on Astro.response when the frontmatter returns Astro.redirect(), so the
        // raw-header version signed nobody in — the customer bounced straight
        // back to this page. Admin login always used Astro.cookies and worked,
        // which is why the breakage hid on the customer side only.
        Astro.cookies.set(SESSION_COOKIE_NAME, json.data.token, {
          path: '/',
          httpOnly: true,
          sameSite: 'lax',
          maxAge: 604800,
          secure: import.meta.env.PROD,
        });


        // R9 (M8, fixation): the visit token is ROTATED at the authentication
        // boundary — a pre-planted cookie must never become the token that
        // gets linked to the freshly signed-in customer. The NEW token is
        // linked; the old one keeps only its anonymous history.
        const { mintSignedVisitToken } = await import('../lib/visitToken');
        const { VISIT_COOKIE_NAME, visitCookieOptions } = await import('../middleware');
        const rotatedToken = mintSignedVisitToken();
        if (rotatedToken) {
          Astro.cookies.set(VISIT_COOKIE_NAME, rotatedToken, visitCookieOptions());
          try {
            await fetch(`${apiBase}/recommendations/profile/link`, {
              method: 'POST',
              headers: { Authorization: `Bearer ${json.data.token}`, 'x-gp-visit': rotatedToken },
              signal: AbortSignal.timeout(3000),
            });
          } catch {
            // Continuity, not correctness.
          }
        }
        const returnTo = Astro.url.searchParams.get('returnTo');
        const safe = safeReturnTo(returnTo);
        return Astro.redirect(safe, 303);
      }

      if (json?.error?.code === 'AUTH_NOT_CONFIGURED') {
        notConfigured = true;
        message = json.error.message;
      } else {
        status = 'error';
        // Never the API's own text, and never an HTTP number: neither is
        // something a customer can act on. A wrong password and an unknown
        // email get the same sentence on purpose (no account enumeration).
        message =
          res.status === 401 ? 'That email and password do not match. Check them and try again, or reset your password.'
          : res.status === 400 ? 'Check the email and password fields and try again.'
          : res.status === 429 ? 'Too many attempts. Please wait a few minutes and try again.'
          : res.status === 403 ? 'This account cannot be used right now. Please contact us and we will help.'
          : 'We could not sign you in right now. Please try again in a moment.';
      }
    } catch {
      status = 'error';
      message = 'Cannot reach the authentication service right now. Please try again shortly.';
    }
  }
}
---

<BaseLayout robotsMeta="noindex,follow" title="Sign in" description="Sign in to your GoldPlus account.">
  <div class="container mx-auto px-4 lg:px-8 py-12 md:py-20">
    <div class="max-w-md mx-auto">
      <h1 class="text-2xl md:text-3xl font-black text-gray-900 mb-2 tracking-tight">Sign in</h1>
      <p class="text-slate-500 mb-6 text-sm leading-relaxed">Access your orders, addresses and account.</p>

      {notConfigured && (
        <div class="mb-6">
          <Notice kind="warning" title="Sign-in is temporarily unavailable" message="Please try again shortly. If you need an order urgently, look it up on the track-order page with its reference, or contact us." />
        </div>
      )}
      {!notConfigured && <FormFeedback status={status} message={message} />}

      <SocialSignIn returnTo={Astro.url.searchParams.get('returnTo') ?? '/account'} intent="signin" />

      <form method="POST" action="/login" novalidate class="bg-white p-8 rounded-2xl border border-slate-200/80 shadow-xs space-y-5">
        <FormField id="email" name="email" label="Email" type="email" required autocomplete="email" defaultValue={values.email} />
        <FormField id="password" name="password" label="Password" type="password" required autocomplete="current-password" />
        <button
          type="submit"
          class="w-full bg-brand-primary text-gray-955 py-2.5 rounded-full font-bold text-xs tracking-wider uppercase hover:shadow-lg hover:shadow-brand-primary/20 transition-all outline-none cursor-pointer hover:scale-[1.005] active:scale-[0.985]"
        >
          Sign in
        </button>
        <p class="text-xs text-slate-400 text-center leading-relaxed">
          <a href="/forgot-password" class="font-bold text-slate-600 underline hover:text-gray-900">Forgot your password?</a>
        </p>
        <p class="text-xs text-slate-400 text-center leading-relaxed">
          New to GoldPlus?
          <a href={`/register${Astro.url.searchParams.get('returnTo') ? `?returnTo=${encodeURIComponent(Astro.url.searchParams.get('returnTo') ?? '')}` : ''}`} class="font-bold text-slate-600 underline hover:text-gray-900">Create your account</a>
        </p>
      </form>
    </div>
  </div>
</BaseLayout>
