---
import BaseLayout from '../layouts/BaseLayout.astro';
import FormField from '../components/FormField.astro';
import FormFeedback from '../components/FormFeedback.astro';
import Notice from '../components/Notice.astro';
import { apiBase } from '../lib/api';
import { sessionCookieValue } from '../lib/session';

let status: 'success' | 'error' | null = null;
let message: string | undefined;
let values: { email?: string } = {};
let notConfigured = false;

// Surface an error bounced back from the Google OAuth flow (?social=...).
const socialError = Astro.url.searchParams.get('social');
if (socialError) {
  const socialMessages: Record<string, string> = {
    not_configured: 'Google sign-in is not configured on this site yet.',
    unavailable: 'Google sign-in is temporarily unavailable. Please try again shortly.',
    declined: 'Google sign-in was cancelled.',
    bad_state: 'Your sign-in session expired. Please try again.',
    missing_code: 'Google did not return an authorization code. Please try again.',
    failed: 'We could not complete Google sign-in. Please try again or use email and password.',
  };
  status = 'error';
  message = socialMessages[socialError] ?? 'Google sign-in did not complete. Please try again.';
}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const email = String(form.get('email') ?? '').trim();
  const password = String(form.get('password') ?? '');
  values = { email };

  if (!email || !password) {
    status = 'error';
    message = 'Email and password are required.';
  } else {
    try {
      const res = await fetch(`${apiBase}/auth/login`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, password }),
      });
      const json: any = await res.json().catch(() => null);

      if (res.ok && json?.success && json.data?.token) {
        Astro.response.headers.set('Set-Cookie', sessionCookieValue(json.data.token));
        const returnTo = Astro.url.searchParams.get('returnTo');
        const safe = returnTo && returnTo.startsWith('/') && !returnTo.startsWith('//') ? returnTo : '/account';
        return Astro.redirect(safe, 303);
      }

      if (json?.error?.code === 'AUTH_NOT_CONFIGURED') {
        notConfigured = true;
        message = json.error.message;
      } else {
        status = 'error';
        message = json?.error?.message ?? `Login failed (HTTP ${res.status}).`;
      }
    } catch {
      status = 'error';
      message = 'Cannot reach the authentication service right now. Please try again shortly.';
    }
  }
}
---

<BaseLayout title="Sign in" description="Sign in to your GoldPlus account.">
  <div class="container mx-auto px-4 lg:px-8 py-12 md:py-20">
    <div class="max-w-md mx-auto">
      <h1 class="text-2xl md:text-3xl font-black text-brand-charcoal mb-2 tracking-tight">Sign in</h1>
      <p class="text-brand-mutedGrey mb-6 text-sm leading-relaxed">Access your orders, addresses and account.</p>

      {notConfigured && (
        <div class="mb-6">
          <Notice kind="not-configured" title="Sign-in not configured" message={message} />
        </div>
      )}
      {!notConfigured && <FormFeedback status={status} message={message} />}

      <a
        href={`/auth/google`}
        class="flex items-center justify-center gap-3 w-full bg-white border border-brand-borderGrey py-3 rounded-lg font-bold text-brand-charcoal hover:bg-gray-50 focus-visible:ring-4 focus-visible:ring-brand-primary/30 outline-none mb-5"
      >
        <svg class="w-5 h-5" viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1Z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84A11 11 0 0 0 12 23Z"/><path fill="#FBBC05" d="M5.84 14.1a6.6 6.6 0 0 1 0-4.2V7.06H2.18a11 11 0 0 0 0 9.88l3.66-2.84Z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84C6.71 7.31 9.14 5.38 12 5.38Z"/></svg>
        Continue with Google
      </a>

      <div class="flex items-center gap-3 mb-5" aria-hidden="true">
        <span class="h-px bg-brand-borderGrey flex-1"></span>
        <span class="text-xs text-brand-mutedGrey">or</span>
        <span class="h-px bg-brand-borderGrey flex-1"></span>
      </div>

      <form method="POST" action="/login" novalidate class="bg-white p-6 md:p-8 rounded-2xl border border-brand-borderGrey shadow-sm space-y-5">
        <FormField id="email" name="email" label="Email" type="email" required autocomplete="email" defaultValue={values.email} />
        <FormField id="password" name="password" label="Password" type="password" required autocomplete="current-password" />
        <button
          type="submit"
          class="w-full bg-brand-primary text-brand-charcoal py-3 rounded-lg font-bold hover:opacity-90 focus-visible:ring-4 focus-visible:ring-brand-primary/30 outline-none"
        >
          Sign in
        </button>
        <p class="text-xs text-brand-mutedGrey text-center">
          Don't have an account? <a href="/register" class="font-bold text-brand-charcoal hover:underline">Create one</a>
        </p>
      </form>
    </div>
  </div>
</BaseLayout>
