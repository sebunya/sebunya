---
import BaseLayout from '../layouts/BaseLayout.astro';
import { policyBySlug, POLICY_STATUS_LABEL } from '../lib/legal-policies';
const policy = policyBySlug('warranty')!;
import CmsPolicyDocument from '../components/CmsPolicyDocument.astro';
import { fetchPublishedPolicy } from '../lib/legalCms';
// Wave 2C: a PUBLISHED CMS version replaces the wording below; until one
// exists this page is the authoritative published policy.
const cms = await fetchPublishedPolicy('warranty');
---

<BaseLayout title="Warranty policy | GoldPlus">
  <main id="main-content">
    {cms ? <CmsPolicyDocument policy={cms} /> : <>
    <header class="border-b border-slate-200 bg-gradient-to-b from-slate-50 to-white py-12 sm:py-16">
      <div class="container mx-auto max-w-4xl px-4 lg:px-8">
        <p class="text-xs font-black uppercase tracking-[0.18em] text-brand-primary">Customer policy</p>
        <h1 class="mt-3 text-3xl font-black tracking-tight text-gray-900 sm:text-4xl">Warranty policy</h1>
        <p class="mt-4 max-w-3xl text-sm leading-relaxed text-slate-600 sm:text-base">This draft explains how warranty claims are handled. Product-specific coverage always comes from the product listing, your receipt or the manufacturer.</p>
        <p class="mt-4 inline-flex flex-wrap items-center gap-2 text-xs font-bold text-slate-600">
          <span class="rounded-full border border-emerald-300 bg-emerald-50 px-3 py-1 text-emerald-900">{POLICY_STATUS_LABEL[policy.status]}</span>
          <span class="rounded-full border border-slate-200 bg-slate-50 px-3 py-1">Version {policy.version}</span>
          <span class="rounded-full border border-slate-200 bg-slate-50 px-3 py-1">Effective date: {policy.effectiveDate}</span>
        </p>
      </div>
    </header>

    <div class="container mx-auto max-w-4xl px-4 py-10 sm:py-14 lg:px-8">
      <div class="space-y-10 text-sm leading-relaxed text-slate-700 sm:text-base">
        <section aria-labelledby="warranty-terms" class="scroll-mt-24">
          <h2 id="warranty-terms" class="text-xl font-black text-gray-900">Where warranty terms come from</h2>
          <p class="mt-3">Warranty coverage differs by product and brand. The coverage that applies to your purchase is the one stated on the product listing, your receipt, or the manufacturer's documentation — this page does not add or replace those terms.</p>
        </section>
        <section aria-labelledby="warranty-claim" class="scroll-mt-24">
          <h2 id="warranty-claim" class="text-xl font-black text-gray-900">How to make a warranty claim</h2>
          <p class="mt-3">Contact GoldPlus support with your order number or receipt, the product, and a description of the fault. The support team verifies the purchase, checks the applicable coverage, and explains the assessment, repair or replacement steps.</p>
          <p class="mt-3">Product verification protects you here: verified genuine products carry their manufacturer support. If you suspect a counterfeit, use the <a href="/verification" class="font-bold underline decoration-slate-300 underline-offset-4">verification checker</a> first.</p>
        </section>
        <section aria-labelledby="warranty-contact" class="scroll-mt-24 rounded-2xl border border-slate-200 bg-slate-50 p-6">
          <h2 id="warranty-contact" class="text-xl font-black text-gray-900">Make a warranty claim</h2>
          <p class="mt-3">Support verifies your purchase and the applicable coverage, then walks you through assessment, repair or replacement.</p>
          <div class="mt-5 flex flex-col gap-3 sm:flex-row">
            <a href="/support" class="rounded-full bg-slate-950 px-6 py-3 text-center text-sm font-bold text-white hover:bg-brand-primary hover:text-slate-950">Contact support</a>
            <a href="/track-order" class="rounded-full border border-slate-300 px-6 py-3 text-center text-sm font-bold text-slate-800">Find my order</a>
          </div>
        </section>
      </div>
    </div>
  </>}
  </main>
</BaseLayout>
