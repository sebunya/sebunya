---
import '../styles/global.css';
import Header from '../components/Header.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
}

const {
  title,
  description = 'GoldPlus — Premium electronics in Uganda',
  image = '/icon-512.svg',
  canonicalUrl,
} = Astro.props;

const canonical = canonicalUrl ?? Astro.url.toString();
---

<!doctype html>
<html lang="en-UG">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <meta name="description" content={description} />
    <title>{title} | GoldPlus Uganda</title>

    {/* Open Graph */}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />

    {/* Twitter */}
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />
    <link rel="canonical" href={canonical} />
    <slot name="head" />

    <link rel="icon" type="image/svg+xml" href="/icon-192.svg" />
    <link rel="apple-touch-icon" href="/icon-192.svg" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#0A0A0A" />
  </head>
  <body class="bg-brand-softGrey text-brand-charcoal flex flex-col min-h-screen font-sans selection:bg-brand-primary selection:text-brand-charcoal">

    {/* Header */}
    <Header />

    <main class="flex-grow flex flex-col">
      <slot />
    </main>

    <footer class="bg-white border-t border-brand-borderGrey mt-auto">
      <div class="container mx-auto px-4 lg:px-8 py-12 md:py-16">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
          <div>
            <span class="text-2xl font-black tracking-tighter text-brand-charcoal block mb-4">
              Gold<span class="text-brand-primary">Plus</span>
            </span>
            <p class="text-sm text-brand-mutedGrey leading-relaxed max-w-xs">
              Engineered for reliability. Premium electronics for the Ugandan lifestyle, with guaranteed authenticity.
            </p>
          </div>

          <div>
            <h3 class="font-bold text-sm uppercase tracking-wider mb-4 text-brand-charcoal">Shop</h3>
            <ul class="space-y-3 text-sm text-brand-mutedGrey">
              <li><a href="/shop" class="hover:text-brand-primary transition-colors">All products</a></li>
              <li><a href="/shop?category=power" class="hover:text-brand-primary transition-colors">Power devices</a></li>
              <li><a href="/shop?category=sound" class="hover:text-brand-primary transition-colors">Sound devices</a></li>
            </ul>
          </div>

          <div>
            <h3 class="font-bold text-sm uppercase tracking-wider mb-4 text-brand-charcoal">Customer service</h3>
            <ul class="space-y-3 text-sm text-brand-mutedGrey">
              <li><a href="/verification" class="hover:text-brand-primary transition-colors">Product verification</a></li>
              <li><a href="/support" class="hover:text-brand-primary transition-colors">Contact support</a></li>
            </ul>
          </div>

          <div>
            <h3 class="font-bold text-sm uppercase tracking-wider mb-4 text-brand-charcoal">Business</h3>
            <ul class="space-y-3 text-sm text-brand-mutedGrey">
              <li><a href="/dealers/apply" class="hover:text-brand-primary transition-colors">Become a dealer</a></li>
              <li><a href="/quote-request" class="hover:text-brand-primary transition-colors">Request a quote</a></li>
            </ul>
          </div>
        </div>
        <div class="border-t border-brand-borderGrey mt-12 pt-8 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-brand-mutedGrey">
          <p>&copy; {new Date().getFullYear()} GoldPlus. All rights reserved.</p>
          <div class="flex gap-4">
            <a href="/privacy" class="hover:text-brand-charcoal">Privacy</a>
            <a href="/terms" class="hover:text-brand-charcoal">Terms</a>
          </div>
        </div>
      </div>
    </footer>

    <script>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch((error) => {
            console.error('Service Worker registration failed:', error);
          });
        });
      }
    </script>
  </body>
</html>
