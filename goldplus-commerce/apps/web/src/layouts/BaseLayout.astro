---
import '../styles/global.css';
import Header from '../components/Header.astro';

import { whatsappSupportNumber } from '../lib/api';

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
}

const {
  title,
  description = 'GoldPlus — Premium electronics in Uganda',
  image = '/icon-512.svg',
  canonicalUrl,
