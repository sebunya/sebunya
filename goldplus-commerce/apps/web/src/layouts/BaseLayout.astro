---

<!doctype html>
<html lang="en-UG">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <meta name="description" content={description} />
    <title>{title.includes('GoldPlus') ? title : `${title} | GoldPlus`}</title>

    {/* Open Graph */}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />

    {/* Twitter */}
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />
    <link rel="canonical" href={canonical} />
    <slot name="head" />

    {/* Server-Side Google Tag Manager — R7 (§32): only rendered when a REAL
        container id is configured. The old fallback shipped GTM-MOCKID in
        production HTML: a tracking loader firing for a container that does
        not exist, on every page, before any consent consideration. */}
    {import.meta.env.PUBLIC_GTM_ID && (
      <script define:vars={{ metricsUrl: import.meta.env.PUBLIC_METRICS_URL || 'https://metrics.shopgoldplus.com', gtmId: import.meta.env.PUBLIC_GTM_ID }}>
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
        new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
        metricsUrl+'/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer',gtmId);
      </script>
    )}


    {/* PostHog — R7 (§32): only loaded with a REAL key. The old version
        loaded the SDK and connected to app.posthog.com with a mock key on
        every page (opt-out only stopped capture, not the connection). */}
    {import.meta.env.PUBLIC_POSTHOG_KEY && <script>
      !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.async=!0,p.src=s.api_host+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="capture identify alias people.set people.set_once set_config register register_once unregister opt_out_capturing has_opted_out_capturing opt_in_capturing reset isFeatureEnabled onFeatureFlags getFeatureFlag getFeatureFlagPayload reloadFeatureFlags group updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures getActiveMatchingSurveys getSurveys onSessionId".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
      posthog.init(
        import.meta.env.PUBLIC_POSTHOG_KEY,
        {
          api_host: import.meta.env.PUBLIC_POSTHOG_HOST || 'https://app.posthog.com',
        }
      );
    </script>}
    <link rel="icon" type="image/svg+xml" href="/icon-192.svg" />
    <link rel="apple-touch-icon" href="/icon-192.svg" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#0A0A0A" />
  </head>
  <body class="bg-brand-softGrey text-brand-charcoal flex flex-col min-h-screen font-sans selection:bg-brand-primary selection:text-brand-charcoal">

    {/* Slice 13: keyboard users skip repeated navigation. Visible on focus only. */}
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:rounded-lg focus:bg-slate-950 focus:px-4 focus:py-2 focus:text-sm focus:font-bold focus:text-white">Skip to content</a>

    {/* GTM noscript fallback — rendered only alongside a real container id */}
    {import.meta.env.PUBLIC_GTM_ID && (
      <noscript>
        <iframe
          src={`${import.meta.env.PUBLIC_METRICS_URL || 'https://metrics.shopgoldplus.com'}/ns.html?id=${import.meta.env.PUBLIC_GTM_ID}`}
          height="0"
          width="0"
          style="display:none;visibility:hidden"
          title="Google Tag Manager"
        ></iframe>
      </noscript>
    )}

    {/* Header — the GoldPlus navigation system */}
    <GpNav />

    {/* Slice 13: uniform skip-link landing point for every page */}
    <div id="main" tabindex="-1"></div>

    <main class="flex-grow flex flex-col">
      <slot />
    </main>

    <footer class="bg-[#0A0A0A] text-slate-400 border-t border-zinc-800/50 mt-auto">
      <div class="container mx-auto px-4 lg:px-8 py-16 md:py-20">
        
        {/* TOP GRID: brand + visit/hours | Shop | Buying | Help */}
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-[1.7fr_1fr_1fr_1.1fr] gap-10 lg:gap-8">

          <div class="flex flex-col">
            <h3 class="text-white text-base font-black tracking-tight">Stay ahead of the fakes.</h3>
            <p class="text-xs text-slate-400 leading-relaxed mt-2 mb-4">Product drops, verification tips and dealer news, straight to our WhatsApp channel.</p>
            <a href="https://whatsapp.com/channel/0029VbByb56KmCPSiisvMs44" target="_blank" rel="noopener noreferrer" aria-label="Follow GoldPlus on WhatsApp" class="inline-flex items-center gap-2 rounded-full px-4 py-2.5 text-xs font-bold w-fit outline-none focus-visible:ring-4 focus-visible:ring-brand-primary/30 transition-colors" style="background:#93D500;color:#0A0A0A">
              <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 004.79 1.22h.01c5.46 0 9.9-4.45 9.9-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0012.04 2z"/></svg>
              Follow on WhatsApp
            </a>
            <div class="mt-7 grid grid-cols-1 sm:grid-cols-2 gap-6 text-xs">
              <div>
                <p class="font-bold text-white mb-1.5">Visit the shop</p>
                <p class="text-slate-400 leading-relaxed">Wilson Road, Kampala</p>
                <p class="text-slate-500 leading-relaxed">Next to Uhuru Restaurant, opposite Pioneer Mall parking.</p>
                <a href="tel:+256705004545" class="mt-2 inline-block font-bold text-slate-300 hover:text-brand-primary transition-colors">0705 004545</a>
              </div>
              <div>
                <p class="font-bold text-white mb-1.5">Open</p>
                <p class="text-slate-400">Shop &middot; 8:30am&ndash;6:00pm</p>
                <p class="text-slate-400">Delivery &middot; 8:30am&ndash;8:00pm</p>
                <p class="text-slate-500 mt-1.5">Same-day in Kampala &amp; Wakiso. Fee shown before you pay.</p>
              </div>
            </div>
          </div>

          <div class="flex flex-col">
            <h4 class="font-bold text-xs uppercase tracking-wider mb-5 text-white">Shop</h4>
            <ul class="space-y-3.5 text-xs">
              <li><a href="/shop?category=power" class="hover:text-brand-primary transition-colors hover:underline decoration-brand-primary/45 underline-offset-4">Power</a></li>
              <li><a href="/shop?category=sound" class="hover:text-brand-primary transition-colors hover:underline decoration-brand-primary/45 underline-offset-4">Sound</a></li>
              <li><a href="/shop?category=storage" class="hover:text-brand-primary transition-colors hover:underline decoration-brand-primary/45 underline-offset-4">Storage</a></li>
              <li><a href="/shop?category=car" class="hover:text-brand-primary transition-colors hover:underline decoration-brand-primary/45 underline-offset-4">Car</a></li>
              <li><a href="/shop?category=pc" class="hover:text-brand-primary transition-colors hover:underline decoration-brand-primary/45 underline-offset-4">PC</a></li>
              <li><a href="/shop?promo=flash-sale" class="hover:text-brand-primary transition-colors hover:underline decoration-brand-primary/45 underline-offset-4">Flash sale</a></li>
              <li><a href="/shop" class="hover:text-brand-primary transition-colors hover:underline decoration-brand-primary/45 underline-offset-4">Shop all</a></li>
            </ul>
          </div>

          <div class="flex flex-col">
            <h4 class="font-bold text-xs uppercase tracking-wider mb-5 text-white">Buying</h4>
            <ul class="space-y-3.5 text-xs">
              <li><a href="/cart" class="hover:text-brand-primary transition-colors hover:underline decoration-brand-primary/45 underline-offset-4">Your cart</a></li>
              <li><a href="/checkout" class="hover:text-brand-primary transition-colors hover:underline decoration-brand-primary/45 underline-offset-4">Checkout</a></li>
              <li><a href="/track-order" class="hover:text-brand-primary transition-colors hover:underline decoration-brand-primary/45 underline-offset-4">Track your order</a></li>
              <li><a href="/quote-request" class="hover:text-brand-primary transition-colors hover:underline decoration-brand-primary/45 underline-offset-4">Request a quote</a></li>
              <li><a href="/loyalty" class="hover:text-brand-primary transition-colors hover:underline decoration-brand-primary/45 underline-offset-4">GoldPlus Rewards</a></li>
            </ul>
          </div>

          <div class="flex flex-col">
            <h4 class="font-bold text-xs uppercase tracking-wider mb-5 text-white">Help</h4>
            <ul class="space-y-3.5 text-xs">
              <li><a href="/verification" class="hover:text-brand-primary transition-colors hover:underline decoration-brand-primary/45 underline-offset-4">Verify a product</a></li>
              <li><a href="/support" class="hover:text-brand-primary transition-colors hover:underline decoration-brand-primary/45 underline-offset-4">Get support</a></li>
              <li><a href="/support/issue" class="hover:text-brand-primary transition-colors hover:underline decoration-brand-primary/45 underline-offset-4">Report an issue</a></li>
              <li><a href="/support/fake" class="hover:text-brand-primary transition-colors hover:underline decoration-brand-primary/45 underline-offset-4">Report a counterfeit</a></li>
              <li><a href="/preferences" class="hover:text-brand-primary transition-colors hover:underline decoration-brand-primary/45 underline-offset-4">Your preferences</a></li>
            </ul>
          </div>
        </div>

        {/* SOCIAL, CONTACT & COMMUNITY ICON ROW */}
        <div class="border-t border-zinc-800/50 mt-16 pt-8 flex flex-wrap items-center justify-start gap-3">
          {footerSocialLinks.filter(link => link.enabled).map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="w-11 h-11 bg-zinc-900 border border-zinc-800/80 hover:border-brand-primary text-zinc-400 hover:text-brand-primary rounded-full flex items-center justify-center transition-all hover:bg-zinc-850 focus:ring-2 focus:ring-brand-primary outline-none"
              aria-label={link.label}
              title={link.label}
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d={link.iconPath}></path>
              </svg>
            </a>
          ))}
        </div>

