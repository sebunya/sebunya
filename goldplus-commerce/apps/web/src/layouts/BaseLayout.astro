---

<!doctype html>
<html lang="en-UG">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <meta name="description" content={description} />
    <title>{title.includes('GoldPlus') ? title : `${title} | GoldPlus`}</title>

    {/* Open Graph */}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />

    {/* Twitter */}
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />
    <link rel="canonical" href={canonical} />
    <slot name="head" />

    <link rel="icon" type="image/svg+xml" href="/icon-192.svg" />
    <link rel="apple-touch-icon" href="/icon-192.svg" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#0A0A0A" />
  </head>
  <body class="bg-brand-softGrey text-brand-charcoal flex flex-col min-h-screen font-sans selection:bg-brand-primary selection:text-brand-charcoal">

    {/* Header */}
    <Header />

    <main class="flex-grow flex flex-col">
      <slot />
    </main>

    <footer class="bg-[#0A0A0A] text-slate-400 border-t border-zinc-800/50 mt-auto">
      {/* Row 1 — NEWSLETTER + WHATSAPP CHANNEL ENGAGEMENT BAND */}
      <div class="border-b border-zinc-800/60 py-12">
        <div class="container mx-auto px-4 lg:px-8">
          <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-8">
            {/* Newsletter signup teaser */}
            <div class="max-w-md w-full">
              <div class="flex items-center gap-2 mb-2">
                <h3 class="text-white text-base font-black tracking-tight">Stay ahead of the fakes.</h3>
                <span class="inline-flex items-center text-[9px] font-bold text-brand-primary uppercase tracking-widest bg-brand-primary/10 px-2 py-0.5 rounded border border-brand-primary/15">
                  Coming Soon
                </span>
              </div>
              <p class="text-xs text-slate-400 leading-relaxed mb-4">
                New arrivals, verification tips and dealer news — straight to your inbox.
              </p>
              <div class="inline-flex items-center gap-2 bg-zinc-900/60 border border-zinc-800/80 rounded-full px-4 py-2.5 text-xs text-slate-500 font-semibold">
                <svg class="w-3.5 h-3.5 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                Email updates opening soon
              </div>
            </div>

            {/* WhatsApp Channel CTA */}
            <div class="max-w-md w-full lg:text-right lg:ml-auto">
              <h3 class="text-white text-base font-black tracking-tight mb-2">Follow GoldPlus on WhatsApp.</h3>
              <p class="text-xs text-slate-400 mb-4 leading-relaxed">
                Get product drops, verification tips and dealer updates direct to your community feed.
              </p>
              <div class="flex lg:justify-end">
                <a
                  href="https://whatsapp.com/channel/0029VbByb56KmCPSiisvMs44"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="Follow GoldPlus on WhatsApp Channel"
                  class="inline-flex items-center gap-2 px-6 py-2.5 bg-brand-primary text-gray-950 rounded-full font-bold text-xs tracking-wider uppercase transition-all hover:scale-[1.015] active:scale-95 hover:shadow-lg hover:shadow-brand-primary/20"
                >
                  <svg class="w-4 h-4 text-gray-950" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946C.06 5.348 5.397.01 12.008.01c3.202.001 6.212 1.246 8.477 3.513 2.262 2.268 3.507 5.28 3.505 8.484-.004 6.657-5.34 11.997-11.953 11.997-2.005-.001-3.973-.502-5.754-1.458L0 24zM6.59 5.86c-.22-.492-.452-.503-.66-.512-.17-.008-.364-.007-.56-.007-.195 0-.514.073-.783.366-.268.293-1.026 1.002-1.026 2.441 0 1.439 1.047 2.829 1.193 3.023.147.195 2.059 3.145 4.988 4.41.698.302 1.242.482 1.668.618.7.223 1.34.191 1.844.116.563-.083 1.732-.708 1.977-1.393.243-.684.243-1.27.17-1.393-.073-.122-.268-.195-.561-.341-.293-.146-1.732-.853-2.001-.951-.269-.098-.464-.147-.66.146-.195.293-.757.951-.928 1.147-.171.195-.342.22-.635.073-.293-.146-1.238-.457-2.36-1.457-.872-.777-1.46-1.738-1.631-2.03-.171-.293-.018-.452.129-.597.132-.131.293-.342.44-.512.146-.17.195-.293.293-.488.097-.195.048-.366-.024-.512-.072-.147-.66-1.59-.904-2.18z"></path></svg>
                  Follow our WhatsApp Channel
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>

      {/* Row 2 — MAIN FOOTER COLUMNS */}
      <div class="container mx-auto px-4 lg:px-8 py-16 md:py-20">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-10 lg:gap-8">
          {/* Column 1 — Brand / Contact */}
          <div class="sm:col-span-2 lg:col-span-1">
            <span class="text-2xl font-black tracking-tighter text-white block mb-4">
              Gold<span class="text-brand-primary">Plus</span>
            </span>
            <p class="text-xs text-slate-400 leading-relaxed mb-6">
              Verified original electronics for Uganda — power, sound, storage and car accessories you can check before you trust.
            </p>
            <a
              href={`https://wa.me/${whatsappSupportNumber}`}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 bg-brand-primary text-gray-950 px-4.5 py-2.5 rounded-full font-bold text-xs tracking-wider uppercase transition-all hover:scale-[1.015] active:scale-95 hover:shadow-lg hover:shadow-brand-primary/20"
            >
              Chat on WhatsApp
            </a>
          </div>

          {/* Column 2 — Shop */}
          <div>
            <h4 class="font-bold text-xs uppercase tracking-wider mb-5 text-white">Shop</h4>
            <ul class="space-y-3.5 text-xs">
              <li><a href="/" class="hover:text-brand-primary transition-colors hover:underline decoration-brand-primary/45 underline-offset-4">Home</a></li>
              <li><a href="/shop" class="hover:text-brand-primary transition-colors hover:underline decoration-brand-primary/45 underline-offset-4">All Products</a></li>
              <li><a href="/shop?category=power" class="hover:text-brand-primary transition-colors hover:underline decoration-brand-primary/45 underline-offset-4">Power Devices</a></li>
              <li><a href="/shop?category=sound" class="hover:text-brand-primary transition-colors hover:underline decoration-brand-primary/45 underline-offset-4">Sound Devices</a></li>
            </ul>
          </div>

          {/* Column 3 — Buying */}
          <div>
            <h4 class="font-bold text-xs uppercase tracking-wider mb-5 text-white">Buying</h4>
            <ul class="space-y-3.5 text-xs">
              <li><a href="/cart" class="hover:text-brand-primary transition-colors hover:underline decoration-brand-primary/45 underline-offset-4">Cart</a></li>
              <li><a href="/checkout" class="hover:text-brand-primary transition-colors hover:underline decoration-brand-primary/45 underline-offset-4">Checkout</a></li>
              <li><a href="/quote-request" class="hover:text-brand-primary transition-colors hover:underline decoration-brand-primary/45 underline-offset-4">Request a Quote</a></li>
              <li><a href="/track-order" class="hover:text-brand-primary transition-colors hover:underline decoration-brand-primary/45 underline-offset-4">Track Order</a></li>
            </ul>
          </div>

          {/* Column 4 — Customer Service */}
          <div>
            <h4 class="font-bold text-xs uppercase tracking-wider mb-5 text-white">Customer Service</h4>
            <ul class="space-y-3.5 text-xs">
              <li><a href="/verification" class="hover:text-brand-primary transition-colors hover:underline decoration-brand-primary/45 underline-offset-4">Product Verification</a></li>
              <li><a href="/support" class="hover:text-brand-primary transition-colors hover:underline decoration-brand-primary/45 underline-offset-4">Contact Support</a></li>
              <li><a href="/support/issue" class="hover:text-brand-primary transition-colors hover:underline decoration-brand-primary/45 underline-offset-4">Report an Issue</a></li>
              <li>
                <a
                  href="/support/fake"
                  class="text-red-400 hover:text-red-300 font-bold transition-colors inline-block hover:underline decoration-red-400/45 underline-offset-4"
                >
                  Report Counterfeit
                </a>
              </li>
            </ul>
          </div>

          {/* Column 5 — Business / Account */}
          <div>
            <h4 class="font-bold text-xs uppercase tracking-wider mb-5 text-white">Business</h4>
            <ul class="space-y-3.5 text-xs">
              <li><a href="/dealers/apply" class="hover:text-brand-primary transition-colors hover:underline decoration-brand-primary/45 underline-offset-4">Become a Dealer</a></li>
              <li><a href="/login" class="hover:text-brand-primary transition-colors hover:underline decoration-brand-primary/45 underline-offset-4">Login</a></li>
            </ul>
          </div>
        </div>

        {/* Row 3 — SOCIAL, CONTACT & COMMUNITY ICON ROW */}
        <div class="border-t border-zinc-800/50 mt-12 pt-8 flex flex-wrap items-center justify-start gap-3">
          {footerSocialLinks.filter(link => link.enabled).map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="w-11 h-11 bg-zinc-900 border border-zinc-800/80 hover:border-brand-primary text-zinc-400 hover:text-brand-primary rounded-full flex items-center justify-center transition-all hover:bg-zinc-850 focus:ring-2 focus:ring-brand-primary outline-none"
              aria-label={link.label}
              title={link.label}
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d={link.iconPath}></path>
              </svg>
            </a>
          ))}
          <span class="text-[10px] text-zinc-600 font-bold uppercase tracking-wider ml-1">
            Official Channels Verified
          </span>
        </div>

        {/* Row 4 — LEGAL BAR */}
        <div class="border-t border-zinc-900 mt-10 pt-6 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-slate-500">
          <p>&copy; {new Date().getFullYear()} GoldPlus. All rights reserved.</p>
          <div class="flex flex-wrap items-center gap-x-6 gap-y-2 justify-center md:justify-end">
            <a href="/privacy" class="hover:text-white transition-colors hover:underline decoration-white/30 underline-offset-4">Privacy Policy</a>
            <a href="/terms" class="hover:text-white transition-colors hover:underline decoration-white/30 underline-offset-4">Terms of Service</a>
            <a
              href="https://www.tenxafrica.com"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-white transition-colors hover:underline decoration-white/30 underline-offset-4 inline-flex items-center gap-1"
            >
              <span>Website design by</span>
              <span class="font-semibold text-brand-primary">TenX Africa</span>
            </a>
          </div>
        </div>
      </div>
    </footer>

    <script>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch((error) => {
            console.error('Service Worker registration failed:', error);
          });
        });
      }
    </script>
  </body>
</html>
