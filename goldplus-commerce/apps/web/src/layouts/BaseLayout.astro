    <link rel="icon" type="image/svg+xml" href="/icon-192.svg" />
    <link rel="apple-touch-icon" href="/icon-192.svg" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#0A0A0A" />
  </head>
  <body class="bg-brand-softGrey text-brand-charcoal flex flex-col min-h-screen font-sans selection:bg-brand-primary selection:text-brand-charcoal">

    {/* GTM noscript fallback — required for users with JS disabled */}
    <noscript>
      <iframe
        src={`${import.meta.env.PUBLIC_METRICS_URL || 'https://metrics.shopgoldplus.com'}/ns.html?id=${import.meta.env.PUBLIC_GTM_ID || 'GTM-MOCKID'}`}
        height="0"
        width="0"
        style="display:none;visibility:hidden"
        title="Google Tag Manager"
      ></iframe>
    </noscript>

    {/* Header */}
    <Header />

    <main class="flex-grow flex flex-col">
      <slot />
    </main>

    <footer class="bg-[#0A0A0A] text-slate-400 border-t border-zinc-800/50 mt-auto">
      <div class="container mx-auto px-4 lg:px-8 py-16 md:py-20">
        
        {/* TOP GRID */}
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-[1.45fr_0.75fr_1fr_1.35fr] gap-10 lg:gap-8">
          
          {/* Column 1: Newsletter */}
          <div class="flex flex-col lg:col-span-1 order-1">
            <div class="flex items-center gap-2 mb-2">
              <h3 class="text-white text-base font-black tracking-tight">Stay ahead of the fakes.</h3>
            </div>
            <p class="text-xs text-slate-400 leading-relaxed mb-4">
              New arrivals, verification tips and dealer news — straight to your inbox.
            </p>
            <div class="inline-flex items-center gap-2 bg-zinc-900/60 border border-zinc-800/80 rounded-full px-4 py-2.5 text-xs text-slate-500 font-semibold w-fit">
              <svg class="w-3.5 h-3.5 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
              Email updates opening soon
            </div>
          </div>

          {/* Column 2: Buying */}
          <div class="flex flex-col lg:col-span-1 order-3 lg:order-2">
            <h4 class="font-bold text-xs uppercase tracking-wider mb-5 text-white">Buying</h4>
            <ul class="space-y-3.5 text-xs">
              <li><a href="/cart" class="hover:text-brand-primary transition-colors hover:underline decoration-brand-primary/45 underline-offset-4">Cart</a></li>
              <li><a href="/checkout" class="hover:text-brand-primary transition-colors hover:underline decoration-brand-primary/45 underline-offset-4">Checkout</a></li>
              <li><a href="/quote-request" class="hover:text-brand-primary transition-colors hover:underline decoration-brand-primary/45 underline-offset-4">Request a Quote</a></li>
              <li><a href="/track-order" class="hover:text-brand-primary transition-colors hover:underline decoration-brand-primary/45 underline-offset-4">Track Order</a></li>
            </ul>
          </div>

          {/* Column 3: Customer Service */}
          <div class="flex flex-col lg:col-span-1 order-4 lg:order-3">
            <h4 class="font-bold text-xs uppercase tracking-wider mb-5 text-white">Customer Service</h4>
            <ul class="space-y-3.5 text-xs">
              <li><a href="/verification" class="hover:text-brand-primary transition-colors hover:underline decoration-brand-primary/45 underline-offset-4">Product Verification</a></li>
              <li><a href="/support" class="hover:text-brand-primary transition-colors hover:underline decoration-brand-primary/45 underline-offset-4">Contact Support</a></li>
              <li><a href="/support/issue" class="hover:text-brand-primary transition-colors hover:underline decoration-brand-primary/45 underline-offset-4">Report an Issue</a></li>
              <li>
                <a href="/support/fake" class="hover:text-brand-primary transition-colors hover:underline decoration-brand-primary/45 underline-offset-4">Report Counterfeit</a>
              </li>
            </ul>
          </div>

          {/* Column 4: WhatsApp Channel CTA */}
          <div class="flex flex-col lg:col-span-1 order-2 lg:order-4 lg:items-end lg:text-right">
            <h3 class="text-white text-base font-black tracking-tight mb-2">Follow GoldPlus on WhatsApp.</h3>
            <p class="text-xs text-slate-400 mb-4 leading-relaxed">
              Get product drops, verification tips and dealer updates direct to your community feed.
            </p>
            <a
              href="https://whatsapp.com/channel/0029VbByb56KmCPSiisvMs44"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Follow GoldPlus on WhatsApp Channel"
              class="inline-flex items-center gap-2 px-6 py-2.5 bg-brand-primary text-gray-950 rounded-full font-bold text-xs tracking-wider uppercase transition-all hover:scale-[1.015] active:scale-95 hover:shadow-lg hover:shadow-brand-primary/20 w-fit"
            >
              <svg class="w-4 h-4 text-gray-950" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946C.06 5.348 5.397.01 12.008.01c3.202.001 6.212 1.246 8.477 3.513 2.262 2.268 3.507 5.28 3.505 8.484-.004 6.657-5.34 11.997-11.953 11.997-2.005-.001-3.973-.502-5.754-1.458L0 24zM6.59 5.86c-.22-.492-.452-.503-.66-.512-.17-.008-.364-.007-.56-.007-.195 0-.514.073-.783.366-.268.293-1.026 1.002-1.026 2.441 0 1.439 1.047 2.829 1.193 3.023.147.195 2.059 3.145 4.988 4.41.698.302 1.242.482 1.668.618.7.223 1.34.191 1.844.116.563-.083 1.732-.708 1.977-1.393.243-.684.243-1.27.17-1.393-.073-.122-.268-.195-.561-.341-.293-.146-1.732-.853-2.001-.951-.269-.098-.464-.147-.66.146-.195.293-.757.951-.928 1.147-.171.195-.342.22-.635.073-.293-.146-1.238-.457-2.36-1.457-.872-.777-1.46-1.738-1.631-2.03-.171-.293-.018-.452.129-.597.132-.131.293-.342.44-.512.146-.17.195-.293.293-.488.097-.195.048-.366-.024-.512-.072-.147-.66-1.59-.904-2.18z"></path></svg>
              Follow our WhatsApp Channel
            </a>
          </div>
        </div>
        
        {/* SOCIAL, CONTACT & COMMUNITY ICON ROW */}
        <div class="border-t border-zinc-800/50 mt-16 pt-8 flex flex-wrap items-center justify-start gap-3">
          {footerSocialLinks.filter(link => link.enabled).map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="w-11 h-11 bg-zinc-900 border border-zinc-800/80 hover:border-brand-primary text-zinc-400 hover:text-brand-primary rounded-full flex items-center justify-center transition-all hover:bg-zinc-850 focus:ring-2 focus:ring-brand-primary outline-none"
              aria-label={link.label}
              title={link.label}
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d={link.iconPath}></path>
              </svg>
            </a>
          ))}
        </div>

        {/* LOWER BRAND & LEGAL ROW */}
        <div class="border-t border-zinc-900 mt-10 pt-10 pb-8 flex flex-col md:flex-row md:items-end justify-between gap-8 text-xs text-slate-500">
          <div class="max-w-sm">
            <h4 class="font-bold text-xs uppercase tracking-wider mb-4 text-white">We Accept</h4>
            <div class="flex flex-wrap items-center gap-3 mb-6">
              <img src="/payment/mtn-momo.svg" alt="MTN MoMo" class="h-6 w-auto object-contain" />
              <img src="/payment/airtel-money.svg" alt="Airtel Money" class="h-6 w-auto object-contain" />
              <img src="/payment/visa.svg" alt="Visa" class="h-6 w-auto object-contain" />
              <img src="/payment/mastercard.svg" alt="MasterCard" class="h-6 w-auto object-contain" />
              <img src="/payment/unionpay.svg" alt="UnionPay" class="h-6 w-auto object-contain" />
            </div>
