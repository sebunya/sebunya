---
import '../styles/global.css';
import GpNav from '../components/GpNav.astro';

import { whatsappSupportNumber } from '../lib/api';
import { getBusinessInfo } from '../lib/businessInfo';
import { getHomepageContent } from '../lib/homepageContent';
import { DEFAULT_HOMEPAGE_CONTENT } from '@goldplus/shared';
import { SITE_ORIGIN } from '../lib/sitemap';
import { resolveMeasurementConfig } from '../lib/measurement';
import DeclarativeActions from '../components/DeclarativeActions.astro';

// Business/contact info — admin-editable, DB-backed (falls back to DEFAULT).
const biz = await getBusinessInfo();
// Footer copy + links — admin-editable via homepage_content (falls back to DEFAULT).
const homepageContentForFooter = await getHomepageContent();
const whatsappChannel = homepageContentForFooter.whatsappChannel ?? DEFAULT_HOMEPAGE_CONTENT.whatsappChannel;
const footer = homepageContentForFooter.footer ?? DEFAULT_HOMEPAGE_CONTENT.footer;

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
  /** U6 — optional robots directive (e.g. "noindex,follow"). Omitted = default index,follow. */
  robotsMeta?: string;
}

const {
  title,
  description = 'GoldPlus. Premium electronics in Uganda',
  image = '/og-default.png',
  canonicalUrl,
  robotsMeta,
} = Astro.props;

// Footer social/contact icons live in ONE cached sprite (public/nav/social-v1.svg,
// a <symbol> per key) instead of ~6.4 KB of path data inlined into every
// document (about 2.4 KB brotli of the home budget, 2026-09-25). Bump the file
// name when an icon changes: there is no edge purge token.
const FOOTER_ICON_SPRITE = '/nav/social-v1.svg';
const footerIconKeys = new Set(['instagram', 'x', 'facebook', 'youtube', 'tiktok', 'linkedin', 'threads', 'pinterest', 'whatsapp-chat']);

// Default canonical is origin + path. The query string is never part of it:
// it carried payment-return parameters (and, once, provider text) into
// <link rel="canonical"> and og:url. Pages whose query IS the resource
// (/shop filters, via crawlPolicy) pass canonicalUrl explicitly.
// SITE_ORIGIN, not the origin this request happened to arrive on. Search
// Console shows the shop indexed under BOTH https://www.shopgoldplus.com and
// https://shopgoldplus.com, because a request-derived canonical simply agrees
// with whichever host the crawler used, so each page competed with its own
// twin and the ranking signals split between them. Every page now names one
// canonical host — the same one the sitemaps and the pages that already pass
// canonicalUrl explicitly use.
const canonical = canonicalUrl ?? `${SITE_ORIGIN}${Astro.url.pathname}`;
// Share-card crawlers (WhatsApp, Facebook, X) ignore a relative og:image; always emit an absolute URL.
const shareImage = /^https?:\/\//i.test(image) ? image : `${SITE_ORIGIN}${image.startsWith('/') ? '' : '/'}${image}`;
const measurement = resolveMeasurementConfig(import.meta.env);
// Loads /fonts/faces.css right after the first paint (see the <head> comment).
// Loads Cloudflare Web Analytics after load + idle (see the <head> comment).
const CF_BEACON_LOADER = `(function(){function go(){var s=document.createElement('script');s.defer=true;s.src='https://static.cloudflareinsights.com/beacon.min.js';s.setAttribute('data-cf-beacon','{"token":"6288c9e8fae24ebcbc432462132ae7bd"}');document.body.appendChild(s);}function idle(){(window.requestIdleCallback||function(f){setTimeout(f,1500);})(go,{timeout:4000});}if(document.readyState==='complete'){idle();}else{addEventListener('load',idle);}})();`;
// Returning-visitor flag on <html> before first paint (see the <head> comment).
const SEEN_FLAG = `try{if(localStorage.getItem('goldplus_seen_before')==='true')document.documentElement.classList.add('gp-seen')}catch(e){}`;
// Recently-viewed flag, same timing: the homepage trust strip hides only when the
// "Pick up where you left off" rail will take its place (not for every returner).
const RV_FLAG = `try{var r=JSON.parse(localStorage.getItem('goldplus_recently_viewed')||'[]');if(Array.isArray(r)&&r.length)document.documentElement.classList.add('gp-rv')}catch(e){}`;
const FONT_LOADER = `(function(){var d=0;function go(){if(d)return;d=1;var l=document.createElement('link');l.rel='stylesheet';l.href='/fonts/faces.css?v=20260913';document.head.appendChild(l);}try{var o=new PerformanceObserver(function(){o.disconnect();setTimeout(go,0);});o.observe({type:'paint',buffered:true});}catch(e){}addEventListener('load',function(){setTimeout(go,0);});setTimeout(go,3000);})();`;
const clarityId = /^[a-z0-9]{6,20}$/.test(import.meta.env.PUBLIC_CLARITY_ID ?? '') ? import.meta.env.PUBLIC_CLARITY_ID : null;
// Clarity records page TEXT, not only inputs: everything is masked except the
// public catalogue (home, shop, products, categories, blog, info pages), so a
// name, phone or quote shown back on any other page is never recorded.
const clarityMaskAll = !/^\/($|shop|products|categories|category|brands|blog|search|batteries|deals|about|faq|delivery|returns|warranty|contact)(\/|$|\?)/.test(Astro.url.pathname);
---

<!doctype html>
<html lang="en-UG">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <meta name="description" content={description} />
    <title>{title.includes('GoldPlus') ? title : `${title} | GoldPlus`}</title>

    {/* Open Graph */}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={shareImage} />

    {/* Twitter */}
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonical} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={shareImage} />
    <link rel="canonical" href={canonical} />
    {robotsMeta && <meta name="robots" content={robotsMeta} />}
    <slot name="head" />

    {/* Server-Side Google Tag Manager — R7 (§32): only rendered when a REAL
        container id is configured. The old fallback shipped GTM-MOCKID in
        production HTML: a tracking loader firing for a container that does
        not exist, on every page, before any consent consideration.

        The endpoint is now part of the same readiness condition. It used to
        default to https://metrics.shopgoldplus.com, which has no DNS record —
        so setting the id alone would have shipped a loader aimed at nothing. */}
    {/* Microsoft Clarity (heatmaps, session recordings): only with a project id,
        never for robots. Clarity masks typed input by default; checkout and
        account pages are masked entirely (data-clarity-mask on <body>). */}
    {clarityId && (
      <script nonce={Astro.locals.cspNonce} define:vars={{ clarityId }}>
        (function () {
          if (navigator.webdriver === true || /HeadlessChrome|Chrome-Lighthouse|PTST|GTmetrix|Pingdom/i.test(navigator.userAgent || '')) return;
          (function(c,l,a,r,i,t,y){c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
          t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
          y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);})(window,document,"clarity","script",clarityId);
        })();
      </script>
    )}
    {/* The tag script's notes live here, not in the script, so they are not shipped
        in every document (2026-09-25).
        Our own robots are not customers: the performance audit, Lighthouse
        Watch and the compatibility/synthetic probes drive real browsers
        against production (with a spoofed phone user agent, so GA4's bot
        list misses them). Automation is detected by what it cannot hide.
        Consent Mode v2 defaults, set BEFORE the container loads. Owner
        decision 2026-09-19: measurement is always on and runs server-side.
        The one choice a shopper makes here (preference centre, gp_consent=a0)
        is about analytics COOKIES in their browser: with it, Google's tag
        runs cookieless. Advertising storage is off: no ad destination exists.
        One visitor id for the tag AND the server (GA client_id = `_fp_cid`,
        set by our server in middleware; written here only as a fallback). */}
    {measurement.configured && (
      <script nonce={Astro.locals.cspNonce} define:vars={{ metricsUrl: measurement.metricsUrl, gtmId: measurement.gtmId, userId: Astro.locals.gpUserId ?? null }}>
        (function () {
        var ua = navigator.userAgent || '';
        if (navigator.webdriver === true || /HeadlessChrome|Chrome-Lighthouse|PTST|GTmetrix|Pingdom/i.test(ua)) return;
        window.dataLayer = window.dataLayer || [];
        window.gtag = window.gtag || function () { dataLayer.push(arguments); };
        var noCookies = /(?:^|; )gp_consent=a0/.test(document.cookie);
        gtag('consent', 'default', {
          analytics_storage: noCookies ? 'denied' : 'granted',
          ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied',
          functionality_storage: 'granted', security_storage: 'granted',
        });
        var m = document.cookie.match(/(?:^|; )_fp_cid=([^;]*)/);
        var cid = m ? decodeURIComponent(m[1]) : null;
        if (!cid) {
          cid = 'fp.' + Date.now() + '.' + (crypto.randomUUID ? crypto.randomUUID() : Math.random().toString(36).slice(2));
          document.cookie = '_fp_cid=' + cid + '; expires=' + new Date(Date.now() + 365 * 864e5).toUTCString() + '; path=/; SameSite=Lax; Secure';
        }
        dataLayer.push(userId ? { fp_client_id: cid, user_id: userId } : { fp_client_id: cid });
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
        new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
        metricsUrl+'/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer',gtmId);
        })();
      </script>
    )}


    {/* PostHog — R7 (§32): only loaded with a REAL key. The old version
        loaded the SDK and connected to app.posthog.com with a mock key on
        every page (opt-out only stopped capture, not the connection). */}
    {import.meta.env.PUBLIC_POSTHOG_KEY && <script nonce={Astro.locals.cspNonce}>
      !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.async=!0,p.src=s.api_host+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="capture identify alias people.set people.set_once set_config register register_once unregister opt_out_capturing has_opted_out_capturing opt_in_capturing reset isFeatureEnabled onFeatureFlags getFeatureFlag getFeatureFlagPayload reloadFeatureFlags group updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures getActiveMatchingSurveys getSurveys onSessionId".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
      posthog.init(
        import.meta.env.PUBLIC_POSTHOG_KEY,
        {
          api_host: import.meta.env.PUBLIC_POSTHOG_HOST || 'https://app.posthog.com',
        }
      );
    </script>}
    {/* Crawlers and browsers request /favicon.ico by convention whatever the
        link tags say, and Apple devices ignore an SVG apple-touch-icon — both
        were 404ing for Googlebot and Applebot until 2026-09-02. */}
    {/* Web fonts load right after the first paint (2026-09-13). The page paints in the
        metric-matched fallbacks that stay inline, then /fonts/faces.css swaps the brand
        fonts in without moving the layout. Before, all eight files (~88 KB) were
        requested with the document and, on Lighthouse's throttled mobile link, pushed
        FCP and LCP back ~300 ms each (bench: FCP 1.36 s -> 1.06 s, LCP 1.68 s -> 1.39 s,
        CLS 0.001 -> 0.000). A real visitor sees the fonts about one frame later than
        before. Fallbacks: the load event, a 3 s timer, and <noscript>. */}
    {/* data-cfasync="false": Cloudflare Rocket Loader otherwise rewrites this script to run
        after window.load, and the fonts swapped late (PSI: speed index 2.0 s -> 3.2 s). */}
    <script nonce={Astro.locals.cspNonce} is:inline data-cfasync="false" set:html={FONT_LOADER}></script>
    {/* Returning-visitor flag set BEFORE first paint (2026-09-14). The homepage trust strip
        is for new visitors; hiding it at DOMContentLoaded moved everything below it after the
        first paint (Cloudflare RUM: CLS 0.106 on the section under it). Same localStorage
        key as lib/returning-user.ts. */}
    <script nonce={Astro.locals.cspNonce} is:inline data-cfasync="false" set:html={SEEN_FLAG + RV_FLAG}></script>
    <noscript><link rel="stylesheet" href="/fonts/faces.css?v=20260913" /></noscript>
    {/* Cloudflare Web Analytics (real-user LCP/INP/CLS), installed manually and loaded after
        window.load when the browser is idle (2026-09-14). Cloudflare's automatic injection
        put the 10 KB beacon beside the document before first paint on every page view.
        The beacon's observers are buffered, so paints and shifts before it loads are still
        reported. The token is the site's public beacon token (it was already in every page). */}
    <script nonce={Astro.locals.cspNonce} is:inline data-cfasync="false" set:html={CF_BEACON_LOADER}></script>
    <link rel="icon" type="image/svg+xml" href="/icon-192.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="alternate" type="application/rss+xml" title="GoldPlus guides and advice" href="/rss.xml" />
    <meta name="theme-color" content="#0A0A0A" />
  </head>
  <body data-clarity-mask={clarityMaskAll ? "true" : undefined} class="bg-brand-softGrey text-brand-charcoal flex flex-col min-h-screen font-sans selection:bg-brand-primary selection:text-brand-charcoal">

    {/* Slice 13: keyboard users skip repeated navigation. Visible on focus only. */}
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:rounded-lg focus:bg-slate-950 focus:px-4 focus:py-2 focus:text-sm focus:font-bold focus:text-white">Skip to content</a>

    {/* GTM noscript fallback — rendered only alongside a real container id */}
    {measurement.configured && (
      <noscript>
        <iframe
          src={`${measurement.metricsUrl}/ns.html?id=${measurement.gtmId}`}
          height="0"
          width="0"
          style="display:none;visibility:hidden"
          title="Google Tag Manager"
        ></iframe>
      </noscript>
    )}

    {/* Header — the GoldPlus navigation system */}
    <GpNav />

    {/* Slice 13: uniform skip-link landing point for every page */}
    <div id="main" tabindex="-1"></div>

    <main class="flex-grow flex flex-col">
      <slot />
    </main>

    <footer class="bg-[#0A0A0A] text-slate-400 border-t border-zinc-800/50 mt-auto">
      <div class="container mx-auto px-4 lg:px-8 py-16 md:py-20">
        
        {/* TOP GRID: brand + visit/hours | Shop | Buying | Help */}
        <div class="grid grid-cols-2 lg:grid-cols-[1.6fr_1fr_1fr_1fr_1.05fr] gap-10 lg:gap-8">

          {/* Two link columns side by side on a phone (the brand block spans
              both), not 28 links stacked in one ~2,000px column. */}
          <div class="flex flex-col max-lg:col-span-2">
            <h2 class="text-white text-base font-black tracking-tight">{whatsappChannel.heading}</h2>
            <p class="text-xs text-slate-400 leading-relaxed mt-2 mb-4">{whatsappChannel.body}</p>
            <a href={biz.whatsappChannelUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-full px-4 py-2.5 text-xs font-bold w-fit outline-none focus-visible:ring-4 focus-visible:ring-brand-primary transition-colors" style="background:#93D500;color:#0A0A0A">
              <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 004.79 1.22h.01c5.46 0 9.9-4.45 9.9-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0012.04 2z"/></svg>
              Follow on WhatsApp
            </a>
            <div class="mt-7 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-1 gap-6 text-xs">
              <div>
                <p class="font-bold text-white mb-1.5">{footer.visitHeading}</p>
                {biz.addressLine1 && <p class="text-slate-400 leading-relaxed">{biz.addressLine1}</p>}
                {biz.addressLine2 && <p class="text-slate-400 leading-relaxed">{biz.addressLine2}</p>}
                {biz.phoneDisplay && <a href={biz.phoneDial || `tel:${biz.phoneDisplay}`} class="mt-2 inline-block font-bold text-slate-300 hover:text-brand-primary transition-colors">{biz.phoneDisplay}</a>}
              </div>
              <div>
                <p class="font-bold text-white mb-1.5">{footer.openHeading}</p>
                {biz.shopHours && <p class="text-slate-400">Shop &middot; {biz.shopHours}</p>}
                {biz.deliveryHours && <p class="text-slate-400">Delivery &middot; {biz.deliveryHours}</p>}
                {biz.openDays && <p class="text-slate-400">{biz.openDays}</p>}
                {biz.deliveryNote && <p class="text-slate-400 mt-1.5">{biz.deliveryNote}</p>}
              </div>
            </div>
          </div>

          {footer.columns.map((col) => (
            <div class="flex flex-col">
              <h3 class="font-bold text-xs uppercase tracking-wider mb-5 text-white">{col.heading}</h3>
              <ul class="space-y-3.5 text-xs">
                {col.links.map((l) => (
                  <li><a href={l.href} class="hover:text-brand-primary transition-colors hover:underline decoration-brand-primary/45 underline-offset-4">{l.label}</a></li>
                ))}
              </ul>
            </div>
          ))}
        </div>

        {/* SOCIAL, CONTACT & COMMUNITY ICON ROW */}
        <div class="border-t border-zinc-800/50 mt-16 pt-8 flex flex-wrap items-center justify-start gap-3">
          {biz.socials.filter((s) => s.enabled && s.href).map((s) => {
            if (!footerIconKeys.has(s.key)) return null;
            return (
              <a
                href={s.href}
                target="_blank"
                rel="noopener noreferrer"
                class="w-11 h-11 bg-zinc-900 border border-zinc-700 hover:border-brand-primary text-zinc-200 hover:text-brand-primary rounded-full flex items-center justify-center transition-all hover:bg-zinc-800 hover:-translate-y-0.5 focus-visible:ring-2 focus-visible:ring-brand-primary outline-none"
                aria-label={`GoldPlus on ${s.label}`}
                title={s.label}
              >
                <svg class="w-5 h-5" fill="currentColor" aria-hidden="true"><use href={`${FOOTER_ICON_SPRITE}#${s.key}`} /></svg>
              </a>
            );
          })}
        </div>

        {/* LOWER BRAND & LEGAL ROW */}
        <div class="border-t border-zinc-900 mt-10 pt-10 pb-8 flex flex-col md:flex-row md:items-end justify-between gap-8 text-xs text-slate-400">
          <div class="max-w-sm">
            <h3 class="font-bold text-xs uppercase tracking-wider mb-4 text-white">{footer.paymentHeading}</h3>
            <div class="flex flex-wrap items-center gap-2.5 mb-6">
              {/* Sized and lazy: they sit below the fold on every page. The MTN mark was a 120 KB SVG wrapping a bitmap; it is now a 2 KB WebP. */}
              <span class="inline-flex items-center justify-center h-12 min-w-[76px] px-4 rounded-xl bg-white shadow-sm" title="MTN Mobile Money"><img src="/payment/mtn-momo.webp" alt="MTN Mobile Money" width="36" height="36" loading="lazy" decoding="async" class="h-9 w-auto object-contain" /></span>
              <span class="inline-flex items-center justify-center h-12 min-w-[76px] px-4 rounded-xl bg-white shadow-sm" title="Airtel Money"><img src="/payment/airtel-money.svg" alt="Airtel Money" width="36" height="36" loading="lazy" decoding="async" class="h-9 w-auto object-contain" /></span>
              <span class="inline-flex items-center justify-center h-12 min-w-[76px] px-4 rounded-xl bg-white shadow-sm" title="Visa"><img src="/payment/visa.svg" alt="Visa" width="62" height="20" loading="lazy" decoding="async" class="h-5 w-auto object-contain" /></span>
              <span class="inline-flex items-center justify-center h-12 min-w-[76px] px-4 rounded-xl bg-white shadow-sm" title="Mastercard"><img src="/payment/mastercard.svg" alt="Mastercard" width="45" height="28" loading="lazy" decoding="async" class="h-7 w-auto object-contain" /></span>
            </div>
            <p>&copy; {new Date().getFullYear()} {footer.copyrightNotice}</p>
          </div>
          <div class="flex flex-wrap items-center gap-x-6 gap-y-3 justify-start md:justify-end">
            {footer.legalLinks.map((l) => (
              <a href={l.href} class="hover:text-white transition-colors hover:underline decoration-white/30 underline-offset-4">{l.label}</a>
            ))}
            <a
              href={footer.attribution.href}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-white transition-colors hover:underline decoration-white/30 underline-offset-4 inline-flex items-center gap-1"
            >
              {footer.attribution.label}
            </a>
          </div>
        </div>
      </div>
    </footer>

    <script>
      // Capture marketing attribution (last-touch UTM + external referrer) on every
      // page, so an order can be attributed to where it came from.
      import { captureAttribution, recordAdClick } from '../lib/attribution';
      captureAttribution();
      recordAdClick();
      import { recordLandingTouch } from '../lib/telemetry';
      recordLandingTouch();
    </script>

    <script>
      // ONE sale-countdown ticker for every [data-card-sale-ends] chip on the
      // page — product cards, recommendation rails, client-injected cards alike.
      // Counts down to the campaign end so the customer knows exactly when the
      // price returns to normal. Re-scans each tick because rails inject cards
      // after load. Scoped attribute: the header owns data-sale-ends.
      const tickSaleChips = () => {
        for (const el of Array.from(document.querySelectorAll<HTMLElement>('[data-card-sale-ends]'))) {
          const end = new Date(el.getAttribute('data-card-sale-ends') ?? '').getTime();
          if (!Number.isFinite(end)) continue;
          const ms = end - Date.now();
          if (ms <= 0) { el.textContent = 'Sale ended. Regular price applies'; continue; }
          const d = Math.floor(ms / 86400000), h = Math.floor((ms % 86400000) / 3600000), m = Math.floor((ms % 3600000) / 60000);
          el.textContent = d > 0 ? `Sale ends in ${d}d ${h}h` : h > 0 ? `Sale ends in ${h}h ${m}m` : `Sale ends in ${m}m`;
        }
      };
      tickSaleChips();
      document.addEventListener('DOMContentLoaded', tickSaleChips);
      setInterval(tickSaleChips, 60_000);
      // Rails inject cards after load in whatever order their scripts ran —
      // tick the moment new chips appear rather than up to a minute later.
      // Guarded to ELEMENT insertions that carry a chip: the ticker's own
      // textContent writes add bare text nodes, which must not re-trigger it.
      new MutationObserver((mutations) => {
        for (const m of mutations) {
          for (const node of Array.from(m.addedNodes)) {
            if (node instanceof Element && (node.matches('[data-card-sale-ends]') || node.querySelector('[data-card-sale-ends]'))) {
              tickSaleChips();
              return;
            }
          }
        }
      }).observe(document.body, { childList: true, subtree: true });
    </script>

    <script>
      // An image whose source dies must degrade to an honest placeholder, never
      // to the browser's broken-image glyph. Delegated on window in the capture
      // phase because `error` does not bubble: this covers every <img> on the
      // page including the ones rails inject after load, with no per-site
      // onerror attributes to keep in sync.
      const IMAGE_FALLBACK = '/products/image-unavailable.svg';

      function applyFallback(image) {
        // Guard the fallback itself, so a missing placeholder cannot loop.
        if (image.dataset.imageFallbackApplied === 'true') return;
        if (image.getAttribute('src') === IMAGE_FALLBACK) return;
        image.dataset.imageFallbackApplied = 'true';
        image.removeAttribute('srcset');
        image.src = IMAGE_FALLBACK;
      }

      window.addEventListener(
        'error',
        (event) => {
          if (event.target instanceof HTMLImageElement) applyFallback(event.target);
        },
        true,
      );

      // The listener above only catches failures that happen AFTER this module
      // runs, and Astro defers it — by then the images in the initial HTML have
      // usually already failed, and `error` does not replay. So sweep for
      // images that are finished loading with no intrinsic width, which is what
      // a broken image looks like once the event is gone. Run at both moments:
      // DOM ready catches most, `load` catches the stragglers.
      function sweepBrokenImages() {
        for (const image of document.querySelectorAll('img')) {
          if (image.complete && image.naturalWidth === 0) applyFallback(image);
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', sweepBrokenImages);
      } else {
        sweepBrokenImages();
      }
      window.addEventListener('load', sweepBrokenImages);

      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch((error) => {
            console.error('Service Worker registration failed:', error);
          });
        });
      }
    </script>
    <DeclarativeActions />
  </body>
</html>
