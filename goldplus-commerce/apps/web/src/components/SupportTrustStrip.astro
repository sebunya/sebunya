---
/**
 * Support & Trust — the verification promise, ONE source rendered beside every
 * product surface (PDP sidebar, shop grid, wherever cards are sold from).
 * `layout="row"` spreads the three actions into columns on wide pages;
 * `layout="stacked"` is the sidebar form the PDP has always used.
 */
interface Props {
  layout?: "stacked" | "row";
}
const { layout = "stacked" } = Astro.props;

const ACTIONS = [
  {
    href: "/verification",
    title: "Verify product",
    body: "Confirm that your GoldPlus product is original.",
    tone: "brand-primary",
    icon: '<path fill-rule="evenodd" d="M2.166 4.9L10 1.154l7.834 3.746a1 1 0 01.586.904v4.32a9.002 9.002 0 01-4.707 7.925L10 19l-3.713-2.007a9.002 9.002 0 01-4.707-7.925v-4.32a1 1 0 01.586-.904zM10 3.018L3.999 5.892v3.232a7.001 7.001 0 003.659 6.16l2.342 1.266 2.342-1.266a7.001 7.001 0 003.659-6.16V5.892L10 3.018zm.707 6.293a1 1 0 00-1.414 0L7.5 11.086 6.707 10.293a1 1 0 00-1.414 1.414l1.5 1.5a1 1 0 001.414 0l2.5-2.5a1 1 0 000-1.414z" clip-rule="evenodd"></path>',
    iconAttrs: 'fill="currentColor" viewBox="0 0 20 20"',
    iconClass: "text-brand-primary",
    hoverClass: "group-hover:border-brand-primary",
    titleHover: "group-hover:text-brand-primary",
  },
  {
    href: "/support/issue",
    title: "Report issue",
    body: "Tell us if something is wrong with your product or order.",
    tone: "blue",
    icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>',
    iconAttrs: 'fill="none" stroke="currentColor" viewBox="0 0 24 24"',
    iconClass: "text-blue-500",
    hoverClass: "group-hover:border-blue-500",
    titleHover: "group-hover:text-blue-500",
  },
  {
    href: "/support/fake",
    title: "Report fake",
    body: "Help us identify and remove counterfeit GoldPlus products.",
    tone: "red",
    icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"></path>',
    iconAttrs: 'fill="none" stroke="currentColor" viewBox="0 0 24 24"',
    iconClass: "text-red-500",
    hoverClass: "group-hover:border-red-500",
    titleHover: "group-hover:text-red-500",
  },
];
---

<div class="bg-slate-50 border border-slate-200/80 rounded-xl p-6">
  <h3 class="font-bold text-gray-900 mb-2">Support &amp; Trust</h3>
  <p class="text-sm text-slate-600 mb-6 leading-relaxed max-w-3xl">Buy with confidence. Every GoldPlus product is supported with verification tools to help customers confirm authenticity, report product concerns and protect themselves from counterfeits.</p>
  <div class={layout === "row" ? "grid grid-cols-1 sm:grid-cols-3 gap-5" : "space-y-4"}>
    {ACTIONS.map((action) => (
      <a href={action.href} class="group flex items-start gap-3 outline-none focus-visible:ring-2 focus-visible:ring-brand-primary rounded-lg">
        <div class={`w-8 h-8 rounded-full bg-white border border-slate-200 flex items-center justify-center shrink-0 transition-colors ${action.hoverClass}`}>
          <svg class={`w-4 h-4 ${action.iconClass}`} set:html={action.icon} {...(action.tone === 'brand-primary' ? { fill: 'currentColor', viewBox: '0 0 20 20' } : { fill: 'none', stroke: 'currentColor', viewBox: '0 0 24 24' })} />
        </div>
        <div>
          <h4 class={`text-sm font-bold text-gray-900 transition-colors ${action.titleHover}`}>{action.title}</h4>
          <p class="text-[13px] text-slate-500">{action.body}</p>
        </div>
      </a>
    ))}
  </div>
</div>
