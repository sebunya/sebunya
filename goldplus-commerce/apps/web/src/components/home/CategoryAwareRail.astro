---
import { apiBase } from "../../lib/api";
import { getCleanCatalog } from "../../lib/catalog/catalog";
import type { ApiResponse, ProductPublicDto } from "@goldplus/shared";

interface Props {
  excludeProductIds?: string[];
}

const { excludeProductIds = [] } = Astro.props;

let allProducts: ProductPublicDto[] = [];
try {
  const res = await fetch(`${apiBase}/products?limit=50`, { signal: AbortSignal.timeout(3000) });
  if (res.ok) {
    const json = await res.json() as ApiResponse<ProductPublicDto[]>;
    if (json.success && Array.isArray(json.data)) {
      allProducts = json.data;
    }
  }
} catch {
  // Safe fallback
}

const normalized = getCleanCatalog(allProducts);
const serializedProducts = normalized.map(p => ({
  productId: p.id,
  slug: p.slug,
  name: p.name,
  categoryName: p.categoryName,
  price: p.retailPriceUgx,
  imageUrl: p.primaryImageUrl
}));
---

<section
  class="my-12"
  style="display: none;"
  aria-labelledby="recommendation-category-aware"
  data-category-aware-rail
  data-products={JSON.stringify(serializedProducts)}
  data-exclude-ids={JSON.stringify(excludeProductIds)}
>
  <div class="mb-6">
    <h2 id="recommendation-category-aware" class="text-2xl font-black tracking-tight text-brand-charcoal" data-category-title>
      People exploring similar products also viewed
    </h2>
    <p class="text-brand-mutedGrey text-sm mt-1 font-medium" data-category-subtitle>
      More verified picks from the category you were browsing.
    </p>
  </div>

  <ul class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6" data-category-list>
     {/* Hydrated dynamically on client mount */}
  </ul>
</section>

<script>
  interface SerializedProduct {
    productId: string;
    slug: string;
    name: string;
    categoryName: string;
    price?: number;
    imageUrl?: string;
  }

  document.addEventListener("DOMContentLoaded", () => {
    const rail = document.querySelector("[data-category-aware-rail]") as HTMLElement | null;
    const list = document.querySelector("[data-category-list]");
    const titleEl = document.querySelector("[data-category-title]");
    const subtitleEl = document.querySelector("[data-category-subtitle]");

    if (!rail || !list || !titleEl || !subtitleEl) return;

    const rawProducts = rail.getAttribute("data-products");
    const products: SerializedProduct[] = rawProducts ? JSON.parse(rawProducts) : [];

    const rawExcludes = rail.getAttribute("data-exclude-ids");
    const excludeIds: string[] = rawExcludes ? JSON.parse(rawExcludes) : [];
    const excludedSet = new Set(excludeIds);

    const lastCategoryRaw = window.localStorage.getItem("goldplus_last_category");
    const lastSearchRaw = window.localStorage.getItem("goldplus_last_search");

    let lastCategory = lastCategoryRaw ? JSON.parse(lastCategoryRaw) : null;
    let lastSearch = lastSearchRaw ? JSON.parse(lastSearchRaw) : null;

    // 30 days expiry check
    const thirtyDays = 30 * 24 * 60 * 60 * 1000;
    if (lastCategory && (Date.now() - lastCategory.timestamp > thirtyDays)) lastCategory = null;
    if (lastSearch && (Date.now() - lastSearch.timestamp > thirtyDays)) lastSearch = null;

    const CATEGORY_SLUG_TO_LABEL: Record<string, string> = {
      'power': 'Power Devices',
      'sound': 'Sound Devices',
      'storage': 'Storage Devices',
      'car': 'Car Accessories',
      'pc': 'PC Accessories'
    };

    let matchedProducts: SerializedProduct[] = [];
    let titleText = "";
    let subtitleText = "";
    let reasonCode = "";

    // Decide whether to show category or search interest based on the most recent timestamp
    if (lastCategory && (!lastSearch || lastCategory.timestamp >= lastSearch.timestamp)) {
      const catSlug = lastCategory.value;
      const catName = CATEGORY_SLUG_TO_LABEL[catSlug.toLowerCase()] || catSlug;

      matchedProducts = products.filter(p => p.categoryName === catName && !excludedSet.has(p.productId));
      titleText = "People exploring similar products also viewed";
      subtitleText = "More verified picks from the category you were browsing.";
      reasonCode = "LAST_CATEGORY";
    } else if (lastSearch) {
      const query = lastSearch.value.toLowerCase().trim();

      matchedProducts = products.filter(p => 
        !excludedSet.has(p.productId) &&
        (p.name.toLowerCase().includes(query) || p.categoryName.toLowerCase().includes(query))
      );
      titleText = "People exploring similar products also viewed";
      subtitleText = `More verified picks matching your search for "${lastSearch.value}".`;
      reasonCode = "LAST_SEARCH";
    }

    const items = matchedProducts.slice(0, 4);

    if (items.length < 2) {
      // Hide completely if fewer than 2 items to display (truthful display rule)
      return;
    }

    titleEl.textContent = titleText;
    subtitleEl.textContent = subtitleText;
    rail.style.display = "block";

    list.innerHTML = items
      .map((item) => {
        const priceLabel = (typeof item.price === "number" && item.price > 0) 
          ? `USh ${item.price.toLocaleString("en-UG")}` 
          : "Price on request";
        
        const lowerName = item.name.toLowerCase();
        const productType = lowerName.includes("charger") ? "Charger"
          : (lowerName.includes("earbud") || lowerName.includes("headphone") || lowerName.includes("sound")) ? "Earbuds"
          : lowerName.includes("cable") ? "Cable"
          : lowerName.includes("power bank") ? "Power Bank"
          : lowerName.includes("drive") || lowerName.includes("sd") || lowerName.includes("storage") ? "Storage"
          : "Accessory";

        const img = item.imageUrl 
           ? `<img src="${item.imageUrl}" alt="${item.name}" loading="lazy" class="object-cover w-full h-full transition-transform duration-500 group-hover:scale-105" />`
           : `<div class="absolute inset-0 flex flex-col items-center justify-center bg-brand-softGrey p-4 text-center select-none">
                <svg class="w-10 h-10 mb-2 text-brand-mutedGrey/20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                <span class="text-[10px] font-bold text-brand-mutedGrey tracking-wider uppercase">${productType}</span>
                <span class="text-[9px] font-bold text-brand-mutedGrey/40 mt-1 uppercase tracking-tight">Image pending</span>
              </div>`;

        const priceSizeClass = (typeof item.price === 'number' && item.price > 0) ? 'text-lg text-brand-charcoal' : 'text-xs text-brand-mutedGrey font-bold';

        const attributionId = "loc_" + Math.random().toString(36).substring(2, 11);
        const railRenderId = "loc_rail_" + Date.now();

        return `
          <li class="group list-none h-full">
            <a href="/products/${item.slug}" 
               data-recommendation-click 
               data-placement="category_continuation" 
               data-product-id="${item.productId}" 
               data-attribution-id="${attributionId}"
               data-rail-render-id="${railRenderId}"
               data-reason-code="${reasonCode}"
               class="flex flex-col h-full border border-brand-borderGrey rounded-3xl p-5 hover:border-brand-primary hover:shadow-xl transition-all duration-300 bg-white outline-none focus-visible:ring-4 focus-visible:ring-brand-primary/30">
              <div class="aspect-square bg-brand-softGrey rounded-2xl overflow-hidden mb-4 relative border border-brand-borderGrey/50">
                 ${img}
              </div>
              <div class="flex flex-col flex-grow">
                <h3 class="text-base font-bold text-brand-charcoal leading-tight mb-2 group-hover:text-brand-primary transition-colors line-clamp-2 min-h-[2.5rem]">${item.name}</h3>
                <div class="mt-auto pt-4 border-t border-brand-borderGrey flex items-center justify-between gap-3">
                  <span class="font-black tracking-tight ${priceSizeClass}">${priceLabel}</span>
                  <span class="px-4 py-2 rounded-xl font-bold text-xs transition-all duration-300 bg-brand-softGrey text-brand-charcoal group-hover:bg-brand-charcoal group-hover:text-white">View</span>
                </div>
              </div>
            </a>
          </li>
        `;
      })
      .join("");
  });
</script>
