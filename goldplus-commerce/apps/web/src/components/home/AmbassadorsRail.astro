---
/**
 * Ambassadors & models — real people photographed with GoldPlus products, the
 * last section before the footer. Five portraits across on desktop (three on a
 * tablet, one and a peek on a phone), with arrows to page through the rest.
 *
 * Built from the home page's own vocabulary so it reads as part of the shop:
 * the section heading, container and rounded cards of "Featured products", ink
 * and the brand lime, the gallery's round arrow buttons.
 *
 * Honest by construction: every word and photo comes from the owner's editor
 * (/admin/homepage/ambassadors); the API only sends people who are published AND
 * have a signed photo release on file; with no one to show, nothing renders.
 * A card links to the product in the photo when that product is on sale.
 */
import { HOME_AMBASSADOR_ROLE_LABEL, type HomeAmbassadors, type ProductPublicDto } from '@goldplus/shared';

interface Props {
  section: HomeAmbassadors | undefined;
  products: ProductPublicDto[];
}
const { section, products } = Astro.props;

const bySlug = new Map(products.map((p) => [p.slug, p]));
const people = (section?.people ?? [])
  .filter((p) => p.image)
  .map((p) => {
    const product = p.productSlug ? bySlug.get(p.productSlug) ?? null : null;
    return {
      ...p,
      href: product ? `/products/${product.slug}` : null,
      line: p.tagline || (product ? `With the ${product.name}` : ''),
      label: `${p.name}, ${HOME_AMBASSADOR_ROLE_LABEL[p.role]}${product ? ` — view the ${product.name}` : ''}`,
    };
  });
const SIZES = '(min-width: 1024px) 19vw, (min-width: 768px) 31vw, (min-width: 640px) 45vw, 74vw';
---
{section && people.length > 0 && (
  <section class="bg-white py-14 border-t border-zinc-200/85" aria-labelledby="ambassadors-heading" data-ambassadors>
    <div class="container mx-auto px-4 lg:px-8">
      <div class="mb-8 max-w-2xl">
        <h2 id="ambassadors-heading" class="text-2xl font-black tracking-tight text-gray-900">{section.heading}</h2>
        {section.intro && <p class="mt-2 text-sm leading-relaxed text-slate-600">{section.intro}</p>}
      </div>

      <div class="gp-amb">
        <button type="button" class="gp-amb__arrow gp-amb__arrow--prev" data-amb-prev aria-label="Previous people" aria-controls="ambassadors-track" hidden disabled>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg>
        </button>
        <ul id="ambassadors-track" class="gp-amb__track" data-amb-track tabindex="-1" aria-label={section.heading}>
          {people.map((p, i) => {
            const Tag = p.href ? 'a' : 'div';
            return (
              <li class="gp-amb__item">
                <Tag href={p.href ?? undefined} class="gp-amb__card group" aria-label={p.href ? p.label : undefined}>
                  <img
                    src={p.image!.src}
                    srcset={p.image!.srcset ?? undefined}
                    sizes={p.image!.srcset ? SIZES : undefined}
                    width={p.image!.width ?? 600}
                    height={p.image!.height ?? 1000}
                    alt={p.imageAlt}
                    loading="lazy"
                    decoding="async"
                    class="gp-amb__img"
                  />
                  <span class="gp-amb__scrim" aria-hidden="true"></span>
                  <span class="gp-amb__text">
                    <span class="gp-amb__role">{HOME_AMBASSADOR_ROLE_LABEL[p.role]}</span>
                    <span class="gp-amb__name">{p.name}</span>
                    {p.line && <span class="gp-amb__line">{p.line}</span>}
                  </span>
                </Tag>
              </li>
            );
          })}
        </ul>
        <button type="button" class="gp-amb__arrow gp-amb__arrow--next" data-amb-next aria-label="Next people" aria-controls="ambassadors-track" hidden>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
        </button>
      </div>

      <div class="mt-8">
        <a href={section.ctaHref} class="inline-flex min-h-11 items-center rounded-full border-2 border-gray-900 px-6 text-sm font-bold text-gray-900 transition-colors hover:bg-gray-900 hover:text-white">{section.ctaLabel}</a>
      </div>
    </div>
  </section>
)}

<style>
  .gp-amb { position: relative; }
  /* The row: native horizontal scrolling with snap — swipe on a phone, trackpad or
     arrows on a laptop. No script is needed to see every person. */
  .gp-amb__track { display: flex; gap: 1rem; margin: 0; padding: 0 0 0.25rem; list-style: none; overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory; scrollbar-width: none; outline: none; }
  .gp-amb__track::-webkit-scrollbar { display: none; }
  .gp-amb__item { flex: 0 0 74%; scroll-snap-align: start; }
  @media (min-width: 640px) { .gp-amb__item { flex-basis: calc((100% - 1rem) / 2.2); } }
  @media (min-width: 768px) { .gp-amb__item { flex-basis: calc((100% - 2rem) / 3); } }
  @media (min-width: 1024px) { .gp-amb__item { flex-basis: calc((100% - 4rem) / 5); } }

  .gp-amb__card { position: relative; display: block; overflow: hidden; aspect-ratio: 3 / 5; border-radius: 1rem; background: #1C1C1C; color: #fff; container-type: inline-size; }
  .gp-amb__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 25%; }
  @media (prefers-reduced-motion: no-preference) {
    .gp-amb__img { transition: transform 600ms cubic-bezier(.2,.7,.2,1); }
    a.gp-amb__card:hover .gp-amb__img, a.gp-amb__card:focus-visible .gp-amb__img { transform: scale(1.035); }
  }
  /* Two layers. A soft wash over the lower photo (mood only), and — what guarantees
     legibility — a band that belongs to the TEXT BLOCK: solid ink behind every word
     however many lines the name and line run, fading out above them. A fixed-height
     scrim lost to long names on narrow cards (1024 px: role label 1.71:1 over a white
     photo); measured again after this change against pure-white photos at every width. */
  .gp-amb__scrim { position: absolute; inset: auto 0 0 0; height: 60%; background: linear-gradient(to top, rgba(10,10,10,.55) 0%, rgba(10,10,10,0) 100%); }
  .gp-amb__text { position: absolute; inset: auto 0 0 0; display: flex; flex-direction: column; gap: 0.35rem; padding: 3.25rem 1.25rem 1.25rem; background: linear-gradient(to top, rgba(10,10,10,.9) 0%, rgba(10,10,10,.86) calc(100% - 3.25rem), rgba(10,10,10,0) 100%); text-shadow: 0 1px 2px rgba(0,0,0,.35); }
  .gp-amb__role { font-size: 0.625rem; font-weight: 900; letter-spacing: 0.18em; text-transform: uppercase; color: #93D500; }
  /* Scales with the CARD, not the window: a 180 px card at 1024 px must not wrap a name into three lines. */
  .gp-amb__name { font-size: clamp(1.25rem, 11.5cqw, 1.75rem); font-weight: 900; line-height: 1.02; letter-spacing: -0.02em; overflow-wrap: anywhere; }
  .gp-amb__line { font-size: 0.875rem; font-weight: 500; line-height: 1.35; color: rgba(255,255,255,.92); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  a.gp-amb__card:focus-visible { outline: 3px solid #456B00; outline-offset: 3px; }

  /* Arrows: the gallery's round buttons, at the row's edges on larger screens. */
  /* Over the PHOTO, never the words: on short cards (1024 px) a mid-height arrow covered
     the fifth card's label. The text band always sits in the lower part of a card. */
  .gp-amb__arrow { position: absolute; top: 34%; z-index: 2; display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; margin-top: -22px; border-radius: 9999px; border: 1px solid rgba(10,10,10,.1); background: rgba(255,255,255,.96); color: #0A0A0A; box-shadow: 0 4px 14px rgba(10,10,10,.14); cursor: pointer; transition: opacity 150ms ease; }
  .gp-amb__arrow--prev { left: -0.75rem; }
  .gp-amb__arrow--next { right: -0.75rem; }
  .gp-amb__arrow:hover { border-color: #0A0A0A; }
  .gp-amb__arrow:focus-visible { outline: none; box-shadow: 0 0 0 2px #FFFFFF, 0 0 0 4px #456B00; }
  .gp-amb__arrow:disabled { opacity: 0; pointer-events: none; }
  .gp-amb__arrow[hidden] { display: none; }
  @media (max-width: 639px) { .gp-amb__arrow { display: none; } } /* phones swipe */
</style>

<script>
  // Page the row by whole screens of cards; hide an arrow at its end. Focus is
  // handed to the track before an arrow that holds it is disabled (a disabled
  // button drops focus to <body> — the gallery taught us that).
  document.querySelectorAll<HTMLElement>('[data-ambassadors]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-amb-track]');
    const prev = root.querySelector<HTMLButtonElement>('[data-amb-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-amb-next]');
    if (!track || !prev || !next) return;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const step = () => {
      const item = track.querySelector<HTMLElement>('.gp-amb__item');
      if (!item) return track.clientWidth;
      const gap = parseFloat(getComputedStyle(track).columnGap || '16') || 16;
      const per = Math.max(1, Math.floor((track.clientWidth + gap) / (item.offsetWidth + gap)));
      return per * (item.offsetWidth + gap);
    };
    const setArrow = (btn: HTMLButtonElement, enabled: boolean) => {
      if (!enabled && document.activeElement === btn) {
        const other = btn === prev ? next : prev;
        (other.disabled ? track : other).focus({ preventScroll: true });
      }
      btn.disabled = !enabled;
    };
    const update = () => {
      const max = track.scrollWidth - track.clientWidth;
      const scrollable = max > 2;
      prev.hidden = next.hidden = !scrollable;
      setArrow(prev, scrollable && track.scrollLeft > 2);
      setArrow(next, scrollable && track.scrollLeft < max - 2);
    };
    prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: reduced ? 'auto' : 'smooth' }));
    next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: reduced ? 'auto' : 'smooth' }));
    let raf = 0;
    track.addEventListener('scroll', () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(update); }, { passive: true });
    window.addEventListener('resize', () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(update); });
    update();
  });
</script>
