---
import { apiBase } from '../lib/api';
import { readCartSessionId } from '../lib/cart-session';

const sessionId = readCartSessionId(Astro.request);
let cartItemCount = 0;

if (sessionId) {
  try {
    const res = await fetch(`${apiBase}/commerce/carts/${encodeURIComponent(sessionId)}`, {
      headers: { Accept: 'application/json' },
      signal: AbortSignal.timeout(1500), // Quick, safe fallback timeout
    });
    if (res.ok) {
      const json = await res.json();
      if (json.success && json.data && json.data.items) {
        cartItemCount = json.data.items.reduce((acc: number, item: any) => acc + item.quantity, 0);
      }
    }
  } catch (err) {
    // Graceful error fail-safe, leaves count at 0 without blocking render
    cartItemCount = 0;
  }
}

// Binds active search query term from URL safely
const q = Astro.url.searchParams.get('q') || '';
const currentPath = Astro.url.pathname;

// Clean active state evaluation logic
const isShopAllActive = currentPath === '/shop' && !q;
const isPowerActive = currentPath === '/shop' && q === 'charger';
const isSoundActive = currentPath === '/shop' && q === 'earbuds';
const isStorageActive = currentPath === '/shop' && q === 'flash';
const isCarActive = currentPath === '/shop' && q === 'mount';
const isPCActive = false; // PC fallback is neutral to avoid overlap with Shop All active state
---

<header class="bg-white text-gray-900 border-b border-gray-100 sticky top-0 z-50 shadow-sm selection:bg-brand-primary selection:text-gray-900">
  
  <!-- WIDE DESKTOP LAYOUT (min-width: 1024px) -->
  <!-- Single-Row Elegant Architecture: Logo | Unified Segmented Dock | Separator | Search | Separator | Account | Separator | Cart -->
  <!-- Everything is vertically centered along a unified centerline using items-center -->
  <!-- Reduced visual weights and nested borders to make the header feel extremely calm, premium and spacious -->
  <div class="hidden lg:block py-3 px-4 xl:px-8 max-w-[1600px] mx-auto">
    <div class="flex items-center justify-between gap-5 xl:gap-8 h-10">
      
      <!-- Logo + Category Dock Row Wrap for Premium Visual Spacing (gap 20px - 28px) -->
      <div class="flex items-center gap-5 xl:gap-7 h-10">
        <!-- Brand Logo -->
        <div class="flex items-center flex-shrink-0 mr-1">
          <a href="/" class="flex items-center group outline-none focus-visible:ring-2 focus-visible:ring-brand-primary rounded-lg transition-all duration-300">
            <img
              src="/logos/goldplus-logo-header-exact-old-footprint-117x33.svg"
              width="117"
              height="33"
              alt="GoldPlus"
              class="h-[25px] w-auto object-contain"
            />
          </a>
        </div>

        <!-- Unified Segmented Category Dock: Shop All / Power / Sound / Storage / Car / PC -->
        <!-- Redesigned as a calm capsule nav without internal segment separators and transparent icon tiles -->
        <nav class="flex items-center bg-gray-50/50 px-1.5 border border-gray-200/50 rounded-full text-xs font-semibold text-gray-650 h-10" aria-label="Desktop Categories">
          <!-- Shop All Segment -->
          <a
            href="/shop"
            title="Browse all GoldPlus products"
            aria-label="Browse all GoldPlus products"
            class={`group flex items-center gap-2 px-3.5 py-1 hover:bg-white rounded-full transition-all duration-300 outline-none focus-visible:ring-2 focus-visible:ring-brand-primary active:scale-98 h-8 ${
              isShopAllActive ? 'bg-white text-gray-950 font-bold shadow-sm border border-gray-200/20' : 'hover:text-gray-950 text-gray-700'
            }`}
          >
            <!-- Transparent Icon wrapper (size-[22px] flex-shrink-0) -->
            <div class={`w-[22px] h-[22px] flex items-center justify-center transition-colors duration-300 flex-shrink-0 ${
              isShopAllActive 
                ? 'text-brand-primary' 
                : 'text-slate-500 group-hover:text-brand-primary'
            }`}>
              <!-- Lucide ShoppingBag (w-[22px] h-[22px]) -->
              <svg class="w-[22px] h-[22px]" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M16 10a4 4 0 0 1-8 0" />
                <path d="M3.103 6.034h17.794" />
                <path d="M3.4 5.467a2 2 0 0 0-.4 1.2V20a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6.667a2 2 0 0 0-.4-1.2l-2-2.667A2 2 0 0 0 17 2H7a2 2 0 0 0-1.6.8z" />
              </svg>
            </div>
            <span class="text-[13px] font-semibold transition-colors duration-300">Shop All</span>
          </a>

          <div class="h-4 w-px bg-slate-200 self-center flex-shrink-0" aria-hidden="true"></div>

          <!-- Power Segment -->
          <a
            href="/shop?q=charger"
            title="Power devices: chargers, charging cables and power banks"
            aria-label="Power devices: chargers, charging cables and power banks"
            class={`group flex items-center gap-2 px-3.5 py-1 hover:bg-white rounded-full transition-all duration-300 outline-none focus-visible:ring-2 focus-visible:ring-brand-primary active:scale-98 h-8 ${
              isPowerActive ? 'bg-white text-gray-950 font-bold shadow-sm border border-gray-200/20' : 'hover:text-gray-950 text-gray-700'
            }`}
