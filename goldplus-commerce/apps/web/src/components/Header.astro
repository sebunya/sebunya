            class={`group flex items-center gap-2 px-3 py-0.5 hover:bg-gray-50 rounded-full transition-all duration-300 outline-none focus-visible:ring-2 focus-visible:ring-brand-primary active:scale-98 h-8 ${
              isShopAllActive ? 'bg-gray-50 text-gray-950 font-bold shadow-sm' : 'hover:text-gray-950 text-gray-700'
            }`}
          >
            <div class={`w-5 h-5 flex items-center justify-center transition-colors duration-300 ${
              isShopAllActive 
                ? 'text-brand-primary' 
                : 'text-slate-500 group-hover:text-brand-primary'
            }`}>
              <!-- Lucide ShoppingBag (w-5 h-5) -->
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
