      </div>

      <!-- Integrated Search Bar -->
      <form action="/shop" method="GET" class="flex-grow max-w-md relative group mx-auto flex items-center h-9">
        <div class="relative w-full">
          <input
            type="search"
            name="q"
            value={q}
            placeholder="Search products"
            aria-label="Product Search"
            class="w-full pl-10 pr-20 py-2 bg-gray-50 hover:bg-gray-100/60 focus:bg-white border border-gray-200/80 rounded-full focus:border-brand-primary focus:ring-4 focus:ring-brand-primary/10 transition-all duration-300 outline-none text-xs placeholder-gray-400 text-gray-800 h-9"
          />
          <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400 group-focus-within:text-brand-primary transition-colors duration-300">
