          <div class="h-4 w-px bg-slate-200 self-center flex-shrink-0" aria-hidden="true"></div>

          <!-- Sound Segment -->
          <a
            href="/shop?q=earbuds"
            title="Sound devices: earbuds and portable speakers"
            aria-label="Sound devices: earbuds and portable speakers"
