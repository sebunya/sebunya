            <!-- Transparent Icon wrapper -->
            <div class={`w-[22px] h-[22px] flex items-center justify-center transition-colors duration-300 flex-shrink-0 ${
              isPowerActive 
                ? 'text-brand-primary' 
                : 'text-slate-500 group-hover:text-brand-primary'
            }`}>
              <!-- Lucide BatteryCharging (w-[22px] h-[22px]) -->
