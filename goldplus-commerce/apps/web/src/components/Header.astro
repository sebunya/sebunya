        </div>
        <div>
          <h4 class="text-xs font-bold text-gray-805 group-hover:text-brand-primary transition-colors">Power Devices</h4>
          <p class="text-[10px] text-gray-450 mt-0.5 leading-relaxed">Chargers, cables and power banks</p>
        </div>
