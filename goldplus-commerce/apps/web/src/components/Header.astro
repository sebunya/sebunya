      <!-- Sound Devices Item -->
      <a href="/shop?q=earbuds" class="group flex items-start gap-3.5 p-3 rounded-xl hover:bg-gray-50/60 transition-all duration-300 outline-none focus-visible:ring-2 focus-visible:ring-brand-primary">
