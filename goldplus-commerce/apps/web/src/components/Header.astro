  <div class="hidden lg:block py-3.5 px-4 xl:px-8 max-w-[1600px] mx-auto">
    <div class="flex items-center justify-between gap-4 xl:gap-6 h-10">
      
      <!-- Logo + Category Dock Row Wrap for Premium Visual Spacing (gap 24px - 32px) -->
