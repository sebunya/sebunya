        </nav>
      </div>

      <!-- Soft Structural Separator 1: Category Dock to Search (1px thickness, slate-200, 24px height) -->
      <div class="h-6 w-px bg-slate-200 flex-shrink-0 self-center" aria-hidden="true"></div>

      <!-- Right Side Search Form (Expanded Width max-w-[420px] xl:max-w-[500px]) -->
      <form action="/shop" method="GET" class="flex-grow max-w-[420px] xl:max-w-[500px] relative group flex items-center h-10">
        <div class="relative w-full">
          <input
            type="search"
            name="q"
            value={q}
            placeholder="What are you shopping for?"
            aria-label="Product Search"
            class="w-full pl-9 pr-20 py-2 bg-gray-50 hover:bg-gray-100/60 focus:bg-white border border-gray-200/60 rounded-full focus:border-brand-primary focus:ring-4 focus:ring-brand-primary/10 transition-all duration-300 outline-none text-xs placeholder-gray-400 text-gray-800 h-10"
          />
          <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400 group-focus-within:text-brand-primary transition-colors duration-300">
            <!-- Lucide Search -->
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-4.34-4.34" />
              <circle cx="11" cy="11" r="8" />
            </svg>
          </span>
          <button type="submit" class="absolute right-2 top-1/2 -translate-y-1/2 px-3 py-1 text-[10px] font-black uppercase tracking-widest text-gray-500 hover:text-gray-950 transition-colors duration-300 outline-none rounded-full">
            Search
          </button>
        </div>
      </form>

      <!-- Soft Structural Separator 2: Search to Account -->
      <div class="h-6 w-px bg-slate-200 flex-shrink-0 self-center" aria-hidden="true"></div>

      <!-- Account Actions -->
      <div class="flex items-center gap-4 flex-shrink-0 h-10">
        <a href="/account" class="text-xs font-bold text-gray-650 hover:text-gray-950 transition-colors py-1.5 focus-visible:ring-2 focus-visible:ring-brand-primary outline-none rounded-full">
          Account
        </a>
        
        <!-- Soft Structural Separator 3: Account to Cart -->
        <div class="h-6 w-px bg-slate-200 flex-shrink-0 self-center" aria-hidden="true"></div>

        <!-- Cart Action -->
        <a href="/cart" class="group flex items-center gap-2 px-3 py-1 bg-gray-50/50 hover:bg-gray-100/60 border border-gray-200/40 rounded-full transition-all duration-300 outline-none focus-visible:ring-2 focus-visible:ring-brand-primary h-10">
          <span class="text-xs font-bold text-gray-705 group-hover:text-gray-950 transition-colors">Cart</span>
          <span class="bg-brand-primary text-gray-950 text-[10px] font-black px-2 py-0.5 rounded-full transition-transform duration-300 group-hover:scale-110">
            {cartItemCount}
          </span>
        </a>
      </div>

    </div>
  </div>

  <!-- MEDIUM / TABLET LAYOUT (min-width: 768px and max-width: 1023px) -->
  <!-- Two-Row Architecture: Top row (Logo | Search | Account | Cart) + Bottom row (Unified Segmented Dock) -->
  <!-- Tightened layout with minimal gaps and compact h-9 dock to prevent pushing hero down -->
  <div class="hidden md:block lg:hidden border-b border-gray-100/50">
    <!-- Top Row -->
    <div class="py-2 px-6 max-w-7xl mx-auto flex items-center justify-between gap-6 h-12">
      
