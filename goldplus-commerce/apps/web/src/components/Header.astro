          <!-- Headphones Icon -->
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 18.5a6.5 6.5 0 100-13 6.5 6.5 0 000 13z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.5 12a3.5 3.5 0 117 0v3.5a1.5 1.5 0 01-3 0V12"></path>
          </svg>
        </div>
        <div>
          <h4 class="text-xs font-bold text-gray-805 group-hover:text-brand-primary transition-colors">Sound Devices</h4>
          <p class="text-[10px] text-gray-450 mt-0.5 leading-relaxed">Wireless earbuds and portable speakers</p>
        </div>
      </a>

      <!-- Storage Devices Item -->
      <a href="/shop?q=flash" class="group flex items-start gap-3.5 p-3 rounded-xl hover:bg-gray-50/60 transition-all duration-300 outline-none focus-visible:ring-2 focus-visible:ring-brand-primary">
        <div class="w-10 h-10 rounded-xl bg-gray-50 border border-gray-100 flex items-center justify-center text-gray-500 group-hover:bg-brand-primary/10 group-hover:border-brand-primary/20 group-hover:text-brand-primary transition-colors flex-shrink-0">
          <!-- Memory Card/SD Icon -->
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 3H5a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2V9l-6-6H9z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 3v6h6M7 9h6M7 13h10M7 17h10"></path>
          </svg>
        </div>
        <div>
          <h4 class="text-xs font-bold text-gray-805 group-hover:text-brand-primary transition-colors">Storage Devices</h4>
          <p class="text-[10px] text-gray-450 mt-0.5 leading-relaxed">Flash drives, SD cards and external storage</p>
        </div>
      </a>

      <!-- Car Accessories Item -->
      <a href="/shop?q=mount" class="group flex items-start gap-3.5 p-3 rounded-xl hover:bg-gray-50/60 transition-all duration-300 outline-none focus-visible:ring-2 focus-visible:ring-brand-primary">
        <div class="w-10 h-10 rounded-xl bg-gray-50 border border-gray-100 flex items-center justify-center text-gray-500 group-hover:bg-brand-primary/10 group-hover:border-brand-primary/20 group-hover:text-brand-primary transition-colors flex-shrink-0">
          <!-- Dashboard Mount Icon -->
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 20l-5.447-2.724A2 2 0 012.5 15.49V6.51a2 2 0 011.053-1.786L9 2m6 18l5.447-2.724a2 2 0 001.053-1.786V6.51a2 2 0 00-1.053-1.786L15 2M9 2v18m6-18v18m-6-8h6"></path>
          </svg>
        </div>
        <div>
          <h4 class="text-xs font-bold text-gray-805 group-hover:text-brand-primary transition-colors">Car Accessories</h4>
          <p class="text-[10px] text-gray-450 mt-0.5 leading-relaxed">Phone mounts and car chargers</p>
        </div>
      </a>

      <!-- PC Accessories Item -->
      <a href="/shop" class="group flex items-start gap-3.5 p-3 rounded-xl hover:bg-gray-50/60 transition-all duration-300 outline-none focus-visible:ring-2 focus-visible:ring-brand-primary">
        <div class="w-10 h-10 rounded-xl bg-gray-50 border border-gray-100 flex items-center justify-center text-gray-500 group-hover:bg-brand-primary/10 group-hover:border-brand-primary/20 group-hover:text-brand-primary transition-colors flex-shrink-0">
          <!-- Mouse / Navigation Cursor Icon -->
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5M7.188 2.239a9 9 0 0112.573 12.574"></path>
          </svg>
        </div>
        <div>
          <h4 class="text-xs font-bold text-gray-805 group-hover:text-brand-primary transition-colors">PC Accessories</h4>
          <p class="text-[10px] text-gray-450 mt-0.5 leading-relaxed">Mice and sound cards</p>
        </div>
      </a>

      <!-- View All Products Footer -->
      <a href="/shop" class="col-span-2 group bg-gray-50 hover:bg-brand-primary/10 border border-gray-100 hover:border-brand-primary/20 p-4.5 rounded-xl transition-all duration-300 flex items-center justify-between outline-none focus-visible:ring-2 focus-visible:ring-brand-primary">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-lg bg-white border border-gray-100 flex items-center justify-center text-brand-primary shadow-sm flex-shrink-0">
            <!-- Grid Icon -->
            <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path>
            </svg>
          </div>
          <div>
            <h4 class="text-xs font-bold text-gray-805 transition-colors">View All Products</h4>
            <p class="text-[10px] text-gray-550 mt-0.5 leading-none">Browse the full GoldPlus certified catalog</p>
          </div>
        </div>
        <svg class="w-4 h-4 text-brand-primary transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
    </div>

  </div>

  <!-- Mobile Header Banner (Visible under md) -->
  <div class="md:hidden flex items-center justify-between px-4 py-3 bg-white">
    <!-- Brand -->
    <a href="/" class="flex items-center gap-2 group outline-none">
      <span class="text-lg font-black tracking-tight text-gray-950">
        Gold<span class="text-brand-primary">Plus</span>
      </span>
    </a>

    <!-- Right Side Actions -->
    <div class="flex items-center gap-3">
      <!-- Cart -->
      <a href="/cart" class="relative flex items-center justify-center w-9 h-9 bg-gray-50 border border-gray-100 rounded-xl outline-none">
        <svg class="w-4 h-4 text-gray-600" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
        </svg>
        <span class="absolute -top-1 -right-1 bg-brand-primary text-gray-950 text-[9px] font-black w-4.5 h-4.5 rounded-full flex items-center justify-center">
          {cartItemCount}
        </span>
      </a>

      <!-- Hamburger Menu Button -->
      <button
        type="button"
        id="mobile-menu-toggle"
        aria-expanded="false"
        aria-controls="mobile-menu-drawer"
        aria-label="Toggle Navigation Drawer"
        class="flex items-center justify-center w-9 h-9 bg-gray-50 border border-gray-100 rounded-xl outline-none focus-visible:ring-2 focus-visible:ring-brand-primary"
      >
        <svg id="hamburger-icon" class="w-4.5 h-4.5 text-gray-600" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <svg id="close-icon" class="hidden w-4.5 h-4.5 text-gray-600" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Drawer Panel -->
  <div
    id="mobile-menu-drawer"
    class="hidden md:hidden border-t border-gray-100 bg-white"
  >
    <div class="px-4 py-5 space-y-6">
      <!-- Mobile Search Form -->
      <form action="/shop" method="GET" class="relative">
        <input
          type="search"
          name="q"
          value={q}
          placeholder="Search chargers, earbuds..."
          aria-label="Mobile Product Search"
          class="w-full pl-10 pr-4 py-2.5 bg-gray-50 border border-gray-100 rounded-xl focus:border-brand-primary outline-none text-xs placeholder-gray-400 text-gray-850"
        />
        <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </span>
      </form>

      <!-- Category Links Group -->
      <div>
        <h3 class="text-[10px] font-black text-brand-primary uppercase tracking-widest mb-3">Explore Products</h3>
        <div class="grid grid-cols-2 gap-2.5 text-xs">
          <a
            href="/shop?q=charger"
            title="Power devices"
            class="flex items-center gap-2 px-3 py-2.5 bg-gray-50 border border-gray-100/50 rounded-xl text-gray-700 font-bold block"
          >
            <svg class="w-4 h-4 text-brand-primary flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
            Power
          </a>
          <a
            href="/shop?q=earbuds"
            title="Sound devices"
            class="flex items-center gap-2 px-3 py-2.5 bg-gray-50 border border-gray-100/50 rounded-xl text-gray-700 font-bold block"
          >
            <svg class="w-4 h-4 text-brand-primary flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 18.5a6.5 6.5 0 100-13 6.5 6.5 0 000 13z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.5 12a3.5 3.5 0 117 0v3.5a1.5 1.5 0 01-3 0V12"></path>
            </svg>
            Sound
          </a>
          <a
            href="/shop?q=flash"
            title="Storage devices"
            class="flex items-center gap-2 px-3 py-2.5 bg-gray-50 border border-gray-100/50 rounded-xl text-gray-700 font-bold block"
          >
            <svg class="w-4 h-4 text-brand-primary flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 3H5a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2V9l-6-6H9z"></path>
            </svg>
            Storage
          </a>
          <a
            href="/shop?q=mount"
            title="Car accessories"
            class="flex items-center gap-2 px-3 py-2.5 bg-gray-50 border border-gray-100/50 rounded-xl text-gray-700 font-bold block"
          >
            <svg class="w-4 h-4 text-brand-primary flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 20l-5.447-2.724A2 2 0 012.5 15.49V6.51a2 2 0 011.053-1.786L9 2m6 18l5.447-2.724a2 2 0 001.053-1.786V6.51a2 2 0 00-1.053-1.786L15 2M9 2v18m6-18v18m-6-8h6"></path>
            </svg>
            Car
          </a>
          <a
            href="/shop"
            title="PC Accessories"
            class="col-span-2 flex items-center justify-center gap-2 px-3 py-2.5 bg-gray-50 border border-gray-100/50 rounded-xl text-gray-700 font-bold block"
          >
            <svg class="w-4 h-4 text-brand-primary flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5M7.188 2.239a9 9 0 0112.573 12.574"></path>
            </svg>
            PC Accessories
          </a>
          <a
            href="/shop"
            class="col-span-2 text-center py-2.5 bg-gray-50 border border-gray-100 text-brand-primary font-black uppercase tracking-widest rounded-xl text-[10px]"
          >
            View All Products
          </a>
        </div>
      </div>

      <!-- General Navigation Links -->
      <div class="space-y-4 pt-4 border-t border-gray-100 text-xs font-semibold text-gray-700">
        <a href="/account" class="block hover:text-brand-primary transition-colors">
          Account Profile
        </a>
        <a href="/cart" class="block hover:text-brand-primary transition-colors">
          Shopping Cart
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  // Desktop panel interactions
  const productsBtn = document.getElementById('desktop-products-btn');
  const productsPanel = document.getElementById('desktop-products-panel');
  const productsArrow = document.getElementById('desktop-products-arrow');

  if (productsBtn && productsPanel && productsArrow) {
    const openMenu = () => {
      productsBtn.setAttribute('aria-expanded', 'true');
      productsPanel.classList.remove('hidden');
      productsArrow.classList.add('rotate-180');
    };

    const closeMenu = () => {
      productsBtn.setAttribute('aria-expanded', 'false');
      productsPanel.classList.add('hidden');
      productsArrow.classList.remove('rotate-180');
    };

    productsBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isExpanded = productsBtn.getAttribute('aria-expanded') === 'true';
      if (isExpanded) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    // Close on clicks outside the header component
    document.addEventListener('click', (e) => {
      if (productsBtn.getAttribute('aria-expanded') === 'true' && !productsPanel.contains(e.target as Node) && e.target !== productsBtn) {
        closeMenu();
      }
    });

    // Close on clicking any link inside the panel
    productsPanel.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        closeMenu();
      });
    });

    // Keyboard support: Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && productsBtn.getAttribute('aria-expanded') === 'true') {
        closeMenu();
        productsBtn.focus();
      }
    });
  }

  // Mobile drawer interactions
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const drawer = document.getElementById('mobile-menu-drawer');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  if (toggleBtn && drawer && hamburgerIcon && closeIcon) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', (!isExpanded).toString());
      
      if (isExpanded) {
        drawer.classList.add('hidden');
        hamburgerIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
      } else {
        drawer.classList.remove('hidden');
        hamburgerIcon.classList.add('hidden');
        closeIcon.classList.remove('hidden');
      }
    });

    // Close mobile drawer on any category/nav click
    drawer.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        toggleBtn.setAttribute('aria-expanded', 'false');
        drawer.classList.add('hidden');
        hamburgerIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
      });
    });

    // Close mobile menu on Escape key press
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggleBtn.getAttribute('aria-expanded') === 'true') {
        toggleBtn.setAttribute('aria-expanded', 'false');
        drawer.classList.add('hidden');
        hamburgerIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
        toggleBtn.focus();
      }
    });
  }
</script>
