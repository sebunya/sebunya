              isPowerActive ? 'bg-gray-50 text-gray-950 font-bold shadow-sm' : 'hover:text-gray-950 text-gray-700'
            }`}
          >
            <div class={`w-5 h-5 flex items-center justify-center transition-colors duration-300 ${
              isPowerActive 
                ? 'text-brand-primary' 
                : 'text-slate-500 group-hover:text-brand-primary'
            }`}>
              <!-- Lucide BatteryCharging (w-5 h-5) -->
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
                <path d="m11 7-3 5h4l-3 5" />
                <path d="M14.856 6H16a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-2.935" />
                <path d="M22 14v-4" />
                <path d="M5.14 18H4a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h2.936" />
