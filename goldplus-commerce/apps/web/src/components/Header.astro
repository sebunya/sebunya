    </div>

    <!-- Bottom Row: Centered Compact h-9 Category Dock -->
    <div class="bg-gray-50/30 py-1.5 border-t border-gray-100/50">
      <div class="flex items-center justify-center">
        <nav class="flex items-center bg-white/80 p-0.5 border border-gray-200/40 rounded-full text-xs font-semibold text-gray-750 h-9" aria-label="Medium Categories">
          <!-- Shop All Segment -->
          <a
            href="/shop"
            title="Browse all GoldPlus products"
