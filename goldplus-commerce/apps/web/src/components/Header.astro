---
import { apiBase } from '../lib/api';
import { readCartSessionId } from '../lib/cart-session';

const sessionId = readCartSessionId(Astro.request);
let cartItemCount = 0;

if (sessionId) {
  try {
    const res = await fetch(`${apiBase}/commerce/carts/${encodeURIComponent(sessionId)}`, {
      headers: { Accept: 'application/json' },
      signal: AbortSignal.timeout(1500), // Quick, safe fallback timeout
    });
    if (res.ok) {
      const json = await res.json();
      if (json.success && json.data && json.data.items) {
        cartItemCount = json.data.items.reduce((acc: number, item: any) => acc + item.quantity, 0);
      }
    }
  } catch (err) {
    // Graceful error fail-safe, leaves count at 0 without blocking render
    cartItemCount = 0;
  }
}

// Binds active search query term from URL safely
const q = Astro.url.searchParams.get('q') || '';
---

<header class="bg-white text-gray-900 border-b border-gray-100 sticky top-0 z-50 shadow-sm selection:bg-brand-primary selection:text-gray-900">
  <!-- Desktop / Tablet Navbar (Single-Row Premium Slim Design) -->
  <div class="hidden md:block py-3.5 px-4 lg:px-8 max-w-7xl mx-auto">
    <div class="flex items-center justify-between gap-6">
      
      <!-- Brand Logo -->
      <div class="flex items-center flex-shrink-0">
        <a href="/" class="flex items-center gap-2.5 group outline-none focus-visible:ring-2 focus-visible:ring-brand-primary rounded-lg transition-transform hover:scale-[1.01]">
          <span class="text-xl font-black tracking-tight text-gray-950">
            Gold<span class="text-brand-primary group-hover:text-gray-950 transition-colors duration-300">Plus</span>
          </span>
        </a>
      </div>

      <!-- Navigation Links -->
      <nav class="flex items-center gap-6 font-semibold text-sm text-gray-650 flex-shrink-0" aria-label="Primary Desktop">
        <a
          href="/shop"
          title="Browse all GoldPlus products"
          aria-label="Browse all GoldPlus products"
          class="hover:text-gray-950 transition-colors focus-visible:ring-2 focus-visible:ring-brand-primary outline-none rounded px-1.5"
        >
          Products
        </a>
      </nav>

      <!-- Center Product Search Bar -->
      <form action="/shop" method="GET" class="flex-grow max-w-md relative group">
        <div class="relative w-full">
          <input
            type="search"
            name="q"
            value={q}
            placeholder="Search chargers, earbuds, power banks..."
            aria-label="Product Search"
            class="w-full pl-10 pr-20 py-2 bg-gray-50 hover:bg-gray-100/60 focus:bg-white border border-gray-200/80 rounded-xl focus:border-brand-primary focus:ring-4 focus:ring-brand-primary/10 transition-all duration-300 outline-none text-xs placeholder-gray-400 text-gray-805"
          />
          <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400 group-focus-within:text-brand-primary transition-colors duration-300">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
          </span>
          <button type="submit" class="absolute right-2.5 top-1/2 -translate-y-1/2 px-2.5 py-1 text-[10px] font-black uppercase tracking-widest text-gray-450 hover:text-gray-950 transition-colors duration-300 outline-none focus-visible:ring-2 focus-visible:ring-brand-primary rounded">
            Search
          </button>
        </div>
      </form>

      <!-- Actions Layer -->
      <div class="flex items-center gap-4 flex-shrink-0">
        <a href="/account" class="text-xs font-bold text-gray-605 hover:text-gray-950 transition-colors py-1.5 focus-visible:ring-2 focus-visible:ring-brand-primary outline-none rounded-lg">
          Account
        </a>
        <div class="h-3 w-px bg-gray-200"></div>
        <a href="/cart" class="group flex items-center gap-2.5 px-3 py-1.5 bg-gray-50 hover:bg-gray-100/80 border border-gray-100 rounded-xl transition-all duration-300 outline-none focus-visible:ring-2 focus-visible:ring-brand-primary">
          <span class="text-xs font-bold text-gray-700 group-hover:text-gray-950 transition-colors">Cart</span>
          <span class="bg-brand-primary text-gray-950 text-[10px] font-black px-2 py-0.5 rounded-full transition-transform duration-300 group-hover:scale-110">
            {cartItemCount}
          </span>
        </a>
      </div>

    </div>
  </div>

  <!-- Mobile Header Banner (Visible under md) -->
  <div class="md:hidden flex items-center justify-between px-4 py-3 bg-white">
    <!-- Brand -->
    <a href="/" class="flex items-center gap-2 group outline-none">
      <span class="text-lg font-black tracking-tight text-gray-950">
        Gold<span class="text-brand-primary">Plus</span>
      </span>
    </a>

    <!-- Right Side Actions -->
    <div class="flex items-center gap-3">
      <!-- Cart -->
      <a href="/cart" class="relative flex items-center justify-center w-9 h-9 bg-gray-50 border border-gray-100 rounded-xl outline-none">
        <svg class="w-4 h-4 text-gray-600" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
        </svg>
        <span class="absolute -top-1 -right-1 bg-brand-primary text-gray-950 text-[9px] font-black w-4.5 h-4.5 rounded-full flex items-center justify-center">
          {cartItemCount}
        </span>
      </a>

      <!-- Hamburger Menu Button -->
      <button
        type="button"
        id="mobile-menu-toggle"
        aria-expanded="false"
        aria-controls="mobile-menu-drawer"
        aria-label="Toggle Navigation Drawer"
        class="flex items-center justify-center w-9 h-9 bg-gray-50 border border-gray-100 rounded-xl outline-none focus-visible:ring-2 focus-visible:ring-brand-primary"
      >
        <svg id="hamburger-icon" class="w-4.5 h-4.5 text-gray-600" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <svg id="close-icon" class="hidden w-4.5 h-4.5 text-gray-600" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Drawer Panel -->
  <div
    id="mobile-menu-drawer"
    class="hidden md:hidden border-t border-gray-100 bg-white"
  >
    <div class="px-4 py-5 space-y-6">
      <!-- Mobile Search Form -->
      <form action="/shop" method="GET" class="relative">
        <input
          type="search"
          name="q"
          value={q}
          placeholder="Search chargers, earbuds..."
          aria-label="Mobile Product Search"
          class="w-full pl-10 pr-4 py-2.5 bg-gray-50 border border-gray-100 rounded-xl focus:border-brand-primary outline-none text-xs placeholder-gray-400 text-gray-850"
        />
        <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </span>
      </form>

      <!-- Products Navigation Link -->
      <div>
        <a
          href="/shop"
          title="Browse all GoldPlus products"
          aria-label="Browse all GoldPlus products"
          class="w-full text-center py-3 bg-gray-50 hover:bg-gray-100 border border-gray-100 text-brand-primary font-black uppercase tracking-widest rounded-xl text-[11px] block transition-colors duration-300"
        >
          Browse Products
        </a>
      </div>

      <!-- General Navigation Links -->
      <div class="space-y-4 pt-4 border-t border-gray-100 text-xs font-semibold text-gray-700">
        <a href="/account" class="block hover:text-brand-primary transition-colors">
          Account Profile
        </a>
        <a href="/cart" class="block hover:text-brand-primary transition-colors">
          Shopping Cart
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  // Mobile drawer interactions
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const drawer = document.getElementById('mobile-menu-drawer');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  if (toggleBtn && drawer && hamburgerIcon && closeIcon) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', (!isExpanded).toString());
      
      if (isExpanded) {
        drawer.classList.add('hidden');
        hamburgerIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
      } else {
        drawer.classList.remove('hidden');
        hamburgerIcon.classList.add('hidden');
        closeIcon.classList.remove('hidden');
      }
    });

    // Close mobile drawer on any category/nav click
    drawer.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        toggleBtn.setAttribute('aria-expanded', 'false');
        drawer.classList.add('hidden');
        hamburgerIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
      });
    });

    // Close mobile menu on Escape key press
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggleBtn.getAttribute('aria-expanded') === 'true') {
        toggleBtn.setAttribute('aria-expanded', 'false');
        drawer.classList.add('hidden');
        hamburgerIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
        toggleBtn.focus();
      }
    });
  }
</script>
