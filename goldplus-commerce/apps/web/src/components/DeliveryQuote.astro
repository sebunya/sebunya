---
import { apiBase } from "../lib/api";
import { buildDeliveryQuoteRequest, renderDeliveryQuotePanel, DELIVERY_QUOTE_UNREACHABLE_HTML } from "../lib/deliveryQuotePanel";

/**
 * The delivery quote, shown identically at the product page, the cart and
 * checkout (PART 9 #20: same basket, same fee, everywhere).
 *
 * ONE endpoint answers all three, and its cache key includes the configuration
 * version — so publishing the launch numbers invalidates every cached
 * "fee unavailable" at once rather than leaving customers looking at a stale
 * refusal and wondering why the numbers did not take.
 *
 * EVERY SENTENCE COMES FROM THE REGISTRY. Nothing in this file hardcodes
 * customer-facing copy; the API resolves the Tier 1 strings and this renders
 * them. A wording change reaches all three surfaces without a deploy.
 *
 * Server-rendered. No framework, no client fetch on first paint. Checkout
 * re-renders it in the browser after a location pick through the same
 * renderer (lib/deliveryQuotePanel.ts) and the same endpoint.
 */

interface Props {
  /** Which surface this is, so the disclaimer stage is right. */
  stage: 1 | 2;
  areaSlug?: string | null;
  district?: string | null;
  items?: Array<{ productId: string; quantity: number }>;
  subtotalUgx?: number | null;
  /** Product page: a single item, before any area is known. */
  compact?: boolean;
}

const { stage, areaSlug = null, district = null, items = [], subtotalUgx = null, compact = false } = Astro.props;

let q: any = null;
let unreachable = false;
try {
  const res = await fetch(`${apiBase}/delivery/quote`, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify(buildDeliveryQuoteRequest({ areaSlug, district, items, subtotalUgx })),
    signal: AbortSignal.timeout(6000),
  });
  const json = await res.json().catch(() => null);
  if (json?.success) q = json.data;
  else unreachable = true;
} catch {
  unreachable = true;
}

// ONE renderer for the server and the browser: the checkout page re-quotes
// after a location pick and renders the SAME markup from the SAME endpoint,
// so the re-quoted panel cannot drift from this first paint. Every value is
// escaped there; every sentence comes from the registry via the quote body.
// (The shop directions link opens Google Maps in a new tab and says so.)
const html = unreachable ? DELIVERY_QUOTE_UNREACHABLE_HTML : renderDeliveryQuotePanel(q, { stage, compact });
---

<Fragment set:html={html} />
