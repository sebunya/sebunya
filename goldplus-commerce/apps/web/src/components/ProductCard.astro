---
import type { ProductPublicDto } from '@goldplus/shared';

interface Props {
  product: ProductPublicDto;
  subcategory?: string;
  searchQuery?: string;
  searchRank?: number;
}

const { product, subcategory = '', searchQuery = '', searchRank = 0 } = Astro.props;
const productHref = searchQuery && searchRank > 0
  ? `/products/${product.slug}?searchQuery=${encodeURIComponent(searchQuery)}&searchRank=${searchRank}`
  : `/products/${product.slug}`;

const hasValidPrice = typeof product.retailPriceUgx === 'number'
  && Number.isFinite(product.retailPriceUgx)
  && product.retailPriceUgx > 0;
const formattedPrice = hasValidPrice
  ? `UGX ${product.retailPriceUgx!.toLocaleString('en-UG')}`
  : "Price on request";

const lowerName = product.name.toLowerCase();
const productType = lowerName.includes("charger") ? "Charger"
  : (lowerName.includes("earbud") || lowerName.includes("headphone") || lowerName.includes("sound")) ? "Earbuds"
  : lowerName.includes("cable") ? "Cable"
  : lowerName.includes("power bank") ? "Power Bank"
  : lowerName.includes("drive") || lowerName.includes("sd") || lowerName.includes("storage") ? "Storage"
  : "Accessory";

const shortDescAttr = product.attributeValues?.find(a => a.name === 'CardShortDescription')?.value;

const availabilityLabel = (() => {
  switch(product.availability.kind) {
    case 'in_stock': return 'In Stock';
    case 'pre_order': return 'Pre-Order';
    case 'out_of_stock': return 'Out of Stock';
    default: return 'Confirm availability';
  }
})();

const availabilityBadgeClass = (() => {
  switch(product.availability.kind) {
    case 'in_stock': return 'bg-brand-primary/15 text-brand-charcoal border-brand-primary/20';
    case 'pre_order': return 'bg-blue-50/80 text-blue-700 border-blue-150';
    default: return 'bg-red-50 text-red-600 border-red-100';
  }
})();
---

<article
  class="group flex flex-col h-full border border-slate-200/80 rounded-2xl p-5 hover:border-brand-primary hover:-translate-y-0.5 transition-[transform,border-color] duration-200 bg-white"
  data-product-id={product.id}
  data-product-name={product.name}
  data-product-price={product.retailPriceUgx ?? ''}
  data-product-category={product.categoryName ?? ''}
  aria-label={`${product.name}, ${formattedPrice}, ${availabilityLabel}`}
>
  
  {/* Product Image & Status Badge */}
  <div class="relative mb-4">
    <a href={productHref} class="block aspect-square bg-slate-50 rounded-xl overflow-hidden relative outline-none focus-visible:ring-4 focus-visible:ring-brand-primary/30 border border-slate-100">
      {product.primaryImageUrl ? (
        <img 
          src={product.primaryImageUrl} 
          alt={`Photo of ${product.name}`} 
          class="object-cover w-full h-full"
          loading="lazy"
        />
      ) : (
        <div class="absolute inset-0 flex flex-col items-center justify-center bg-slate-50 p-4 text-center select-none">
          <svg class="w-10 h-10 mb-2 text-brand-mutedGrey/20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
          <span class="text-[10px] font-bold text-slate-400 tracking-wider uppercase">{productType}</span>
          <span class="text-[9px] font-bold text-slate-300 mt-1 uppercase tracking-tight">Image pending</span>
        </div>
      )}
      {product.availability.kind !== 'in_stock' && (
        <div class="absolute top-3 left-3">
           <span class={`text-[9px] font-black px-2.5 py-1 rounded-full uppercase tracking-wider border shadow-xs ${availabilityBadgeClass}`}>
             {availabilityLabel}
           </span>
        </div>
      )}
    </a>
  </div>
  
  <div class="flex flex-col flex-grow">
    {/* Category */}
    <p class="text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-1">{product.categoryName}{subcategory ? ` · ${subcategory}` : ''}</p>
    
    {/* Title */}
    <h3 class="text-[15px] font-bold text-gray-900 leading-snug mb-2 group-hover:text-brand-primary transition-colors line-clamp-2 min-h-[2.5rem]">
      <a href={productHref} class="outline-none focus-visible:underline">
        {product.name}
      </a>
    </h3>

    {/* Card Short Description */}
    {shortDescAttr && (
      <p class="text-[12px] text-slate-500 mb-3 line-clamp-2 leading-relaxed">
        {shortDescAttr}
      </p>
    )}
    
    <div class="mt-auto pt-3 border-t border-slate-100">
      <p class={`font-black tracking-tight tabular-nums ${hasValidPrice ? 'text-lg text-gray-900' : 'text-xs text-slate-500 font-bold'}`}>
        {formattedPrice}
      </p>
    </div>
  </div>
</article>
