---
import type { ProductPublicDto } from '@goldplus/shared';

interface Props {
  product: ProductPublicDto;
}

const { product } = Astro.props;
const inStock = product.availability.kind === 'in_stock' || product.availability.kind === 'pre_order';

const formattedPrice = (typeof product.retailPriceUgx === "number" && product.retailPriceUgx > 0)
  ? `USh ${product.retailPriceUgx.toLocaleString("en-UG")}`
  : "Price on request";

const lowerName = product.name.toLowerCase();
const productType = lowerName.includes("charger") ? "Charger"
  : (lowerName.includes("earbud") || lowerName.includes("headphone") || lowerName.includes("sound")) ? "Earbuds"
  : lowerName.includes("cable") ? "Cable"
  : lowerName.includes("power bank") ? "Power Bank"
  : lowerName.includes("drive") || lowerName.includes("sd") || lowerName.includes("storage") ? "Storage"
  : "Accessory";

const availabilityLabel = (() => {
  switch(product.availability.kind) {
    case 'in_stock': return 'In Stock';
    case 'pre_order': return 'Pre-Order';
    case 'out_of_stock': return 'Out of Stock';
    default: return 'Check Availability';
  }
})();

const availabilityBadgeClass = (() => {
  switch(product.availability.kind) {
    case 'in_stock': return 'bg-brand-primary/15 text-brand-charcoal border-brand-primary/20';
    case 'pre_order': return 'bg-blue-50/80 text-blue-700 border-blue-150';
    default: return 'bg-red-50 text-red-600 border-red-100';
  }
})();
---

<article class="group flex flex-col h-full border border-brand-borderGrey rounded-3xl p-5 hover:border-brand-primary hover:shadow-xl transition-all duration-300 bg-white">
  
  {/* Product Image & Status Badge */}
  <div class="relative mb-5">
    <a href={`/products/${product.slug}`} class="block aspect-square bg-brand-softGrey rounded-2xl overflow-hidden relative outline-none focus-visible:ring-4 focus-visible:ring-brand-primary/30 border border-brand-borderGrey/50">
      {product.primaryImageUrl ? (
        <img 
          src={product.primaryImageUrl} 
          alt={`Photo of ${product.name}`} 
          class="object-cover w-full h-full transition-transform duration-500 group-hover:scale-105"
          loading="lazy"
        />
      ) : (
        <div class="absolute inset-0 flex flex-col items-center justify-center bg-brand-softGrey p-4 text-center select-none">
          <svg class="w-10 h-10 mb-2 text-brand-mutedGrey/20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
          <span class="text-[10px] font-bold text-brand-mutedGrey tracking-wider uppercase">{productType}</span>
          <span class="text-[9px] font-bold text-brand-mutedGrey/40 mt-1 uppercase tracking-tight">Coming Soon</span>
        </div>
      )}
      <div class="absolute top-3 left-3">
         <span class={`text-[10px] font-bold px-3 py-1 rounded-full uppercase tracking-wider border ${availabilityBadgeClass}`}>
           {availabilityLabel}
         </span>
      </div>
      
      {/* Verified Original Trust Overlay Badge */}
      <div class="absolute bottom-3 right-3">
         <span class="bg-brand-charcoal/85 backdrop-blur-sm text-white text-[9px] font-bold px-2.5 py-1.5 rounded-full uppercase tracking-widest border border-white/10 shadow-sm flex items-center gap-1">
           <svg class="w-3 h-3 text-brand-primary" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M2.166 4.9L10 1.154l7.834 3.746a1 1 0 01.586.904v4.32a9.002 9.002 0 01-4.707 7.925L10 19l-3.713-2.007a9.002 9.002 0 01-4.707-7.925v-4.32a1 1 0 01.586-.904zM10 3.018L3.999 5.892v3.232a7.001 7.001 0 003.659 6.16l2.342 1.266 2.342-1.266a7.001 7.001 0 003.659-6.16V5.892L10 3.018zm.707 6.293a1 1 0 00-1.414 0L7.5 11.086 6.707 10.293a1 1 0 00-1.414 1.414l1.5 1.5a1 1 0 001.414 0l2.5-2.5a1 1 0 000-1.414z" clip-rule="evenodd"></path></svg>
           Verified Authentic
         </span>
      </div>
    </a>
  </div>
  
  <div class="flex flex-col flex-grow">
    {/* Category */}
    <p class="text-[10px] font-bold text-brand-mutedGrey uppercase tracking-widest mb-1.5">{product.categoryName}</p>
    
    {/* Title */}
    <h3 class="text-base font-bold text-brand-charcoal leading-tight mb-2 group-hover:text-brand-primary transition-colors line-clamp-2 min-h-[2.5rem]">
      <a href={`/products/${product.slug}`} class="outline-none focus-visible:underline">
        {product.name}
      </a>
    </h3>
    
    {/* Conditional SKU Tag */}
    <div class="mb-4">
      {product.sku ? (
        <span class="text-[10px] text-brand-mutedGrey font-mono bg-brand-softGrey px-2.5 py-1 rounded-md border border-brand-borderGrey inline-block">
          SKU: {product.sku}
        </span>
      ) : (
        <span class="text-[10px] text-red-600 bg-red-55/40 px-2.5 py-1 rounded-md border border-red-100 inline-block font-semibold">
          Identifier pending review
        </span>
      )}
    </div>

    <div class="mt-auto pt-4 border-t border-brand-borderGrey flex items-center justify-between gap-3">
      <p class={`font-black tracking-tight ${(typeof product.retailPriceUgx === 'number' && product.retailPriceUgx > 0) ? 'text-lg text-brand-charcoal' : 'text-xs text-brand-mutedGrey font-bold'}`}>
        {formattedPrice}
      </p>
      
      <a 
        href={`/products/${product.slug}`}
        class="px-4 py-2 rounded-xl font-bold text-xs transition-all duration-300 outline-none focus:ring-4 focus:ring-brand-primary/20 bg-brand-softGrey text-brand-charcoal hover:bg-brand-charcoal hover:text-white"
        aria-label={`View ${product.name}`}>
         View
      </a>
    </div>
  </div>
</article>
