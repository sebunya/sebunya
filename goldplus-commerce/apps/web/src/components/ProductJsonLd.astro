---
import type { ProductPublicDto } from '@goldplus/shared';
import { offerPriceUgx } from '../lib/offerPrice';
import { serializeJsonLd, schemaAvailability } from '../lib/jsonld';
import { SITE_ORIGIN } from '../lib/sitemap';
import { merchantReturnPolicyJsonLd } from '../lib/returnsPolicy';
import { batteryProductJsonLdProps, type BatteryJsonLdFacts } from '../lib/phoneBatteryPage';

interface Props {
  product: ProductPublicDto;
  url: string;
  /** The campaign sale price the page is showing, when one is running. */
  priceUgx?: number | null;
  /** AggregateRating from published, verified-purchase reviews; omitted when there are none. */
  aggregateRating?: Record<string, unknown> | null;
  /**
   * A replacement battery: the pack code, the recorded capacity and voltage
   * (only when the catalogue holds them) and the phones it is published as
   * fitting, so an engine reads "spare part for <phone>" as a fact rather
   * than inferring it from the name. Nothing here is invented: null stays out.
   */
  battery?: BatteryJsonLdFacts | null;
}

const { product, url, priceUgx, aggregateRating, battery } = Astro.props;


const node: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  category: product.categoryName,
  url,
  // The house brand: every product here is GoldPlus-branded; Google's product
  // rich results and Merchant free listings want brand on the page as in the feed.
  brand: { '@type': 'Brand', name: 'GoldPlus' },
};

const hasValidSku = product.sku && product.sku !== 'Needs Business Confirmation' && !product.sku.toLowerCase().includes('pending');
const hasValidMpn = product.modelNumber && product.modelNumber !== 'Needs Business Confirmation' && !product.modelNumber.toLowerCase().includes('pending');

if (hasValidSku) node.sku = product.sku;
if (hasValidMpn) node.mpn = product.modelNumber;

const specEntries = Object.entries(product.verifiedSpecs).filter(([_, v]) => {
  if (typeof v !== 'string') return true;
  const valLower = v.toLowerCase();
  return !valLower.includes('confirm') && !valLower.includes('based on') && !valLower.includes('pending');
});
if (specEntries.length > 0) {
  node.description = specEntries.map(([k, v]) => `${k}: ${v}`).join('; ');
} else if (product.longDescription?.trim() || product.shortDescription?.trim()) {
  node.description = (product.longDescription?.trim() || product.shortDescription).trim();
}

// Focus 4: every available canonical image, slot 1 first, absolute, no empties.
const abs = (u: string) => (/^https?:\/\//i.test(u) ? u : `${SITE_ORIGIN}${u}`);
// Demo/sample frames (alt begins "Sample ") are placeholders: they must never be published as
// this product's picture to Google or any other consumer of structured data.
const jsonLdImages = (product.images ?? [])
  .filter((i) => !(i.alt ?? '').startsWith('Sample '))
  .map((i) => i.url).filter((u): u is string => typeof u === 'string' && u.length > 0).map(abs);
if (jsonLdImages.length > 0) node.image = jsonLdImages.length === 1 ? jsonLdImages[0] : jsonLdImages;
// No real photograph: no `image` at all. A placeholder card is not a picture of the product.

const verifiedAttrs = product.attributeValues.filter((v) => v.isVerified);
if (verifiedAttrs.length > 0) {
  node.additionalProperty = verifiedAttrs.map((v) => {
    const prop: Record<string, unknown> = {
      '@type': 'PropertyValue',
      name: v.name,
      value: v.value,
    };
    if (v.unit) prop.unitText = v.unit;
    return prop;
  });
}

if (battery) {
  const { additionalProperty, ...rest } = batteryProductJsonLdProps(battery, !!hasValidMpn);
  Object.assign(node, rest);
  node.additionalProperty = [...((node.additionalProperty as unknown[] | undefined) ?? []), ...additionalProperty];
}

if (product.retailPriceUgx !== null) {
  const offers: Record<string, unknown> = {
    '@type': 'Offer',
    priceCurrency: 'UGX',
    // The price the customer sees and pays — never the regular price under a running sale.
    price: offerPriceUgx(product.retailPriceUgx, priceUgx),
    url,
    itemCondition: 'https://schema.org/NewCondition',
    // The shop's returns promise, on the offer Google reads.
    hasMerchantReturnPolicy: merchantReturnPolicyJsonLd(),
    // Who sells it: the same organisation node the home page describes (@id),
    // inline so the offer is complete on its own page.
    seller: { '@type': 'Organization', '@id': `${SITE_ORIGIN}/#organization`, name: 'ShopGoldPlus', url: SITE_ORIGIN },
  };
  const availUrl = schemaAvailability(product.availability.kind);
  if (availUrl) offers.availability = availUrl;
  node.offers = offers;
}

// Stars in search results only from real, published ratings (never from zero, never invented).
if (aggregateRating) node.aggregateRating = aggregateRating;

// Escaped like every other JSON-LD block: a product name or spec containing "</script>" must not end the tag.
const jsonText = serializeJsonLd(node);
---
<script type="application/ld+json" is:inline set:html={jsonText} />
