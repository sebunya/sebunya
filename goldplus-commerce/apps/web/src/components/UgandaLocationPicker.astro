---
import { UGANDA_DISTRICTS } from '@goldplus/shared';

/**
 * UgandaLocationPicker v2 — capture WHERE a delivery goes in the way Ugandans
 * actually give directions (location-module brief PARTs F–H).
 *
 * Layers, in order:
 *   1. SERVER search over the verified gazetteer (5,805 areas + aliases +
 *      groups + landmarks + pickup points) — folded orthography, ranked,
 *      provenance-tagged. Falls back seamlessly to layer 2 offline.
 *   2. LOCAL index: curated aliases + the official 136 districts — always
 *      available with zero network (the metro set that matters most).
 *   3. District select — the always-visible structural fallback.
 *   4. "I can't find my area" — the PART H manual path. A missing gazetteer
 *      row must never block a sale: free text + optional district proceed to
 *      checkout with the fee honestly unconfirmed and land in the ops queue.
 *
 * Optional pin capture (PART G.1, `withPin`): device GPS or a pasted
 * Google-Maps/WhatsApp link (parsed client-side; short links resolved
 * server-side). Coordinates ride in the payload; no area is ever fabricated
 * from them (no centroids — the gap is flagged, not approximated).
 *
 * Payload (hidden input, JSON):
 *   { district, area?, displayLabel, areaSlug?, gpsLat?, gpsLng?,
 *     gpsAccuracyM?, gpsSource? }                      — structured selection
 *   { manual: true, rawAddressText, district? }        — manual fallback
 * Legacy payloads are still accepted as defaultValue.
 */
interface Props {
  id?: string;
  name: string;
  label?: string;
  placeholder?: string;
  helperText?: string;
  required?: boolean;
  defaultValue?: string;
  errorMessage?: string;
  /** Show the GPS / pasted-link pin capture section. */
  withPin?: boolean;
}

const {
  id = 'loc_' + Math.random().toString(36).substr(2, 9),
  name,
  label = 'Delivery location',
  placeholder = 'Type your area, town or district — e.g. Najjera, Seeta, Mbarara',
  helperText = '',
  required = false,
  defaultValue = '',
  errorMessage = '',
  withPin = false,
} = Astro.props;

const helperId = helperText ? `${id}_helper` : undefined;

let initialPrimary = '';
let initialSecondary = '';
if (defaultValue && defaultValue.startsWith('{')) {
  try {
    const prior = JSON.parse(defaultValue);
    if (prior?.manual && prior?.rawAddressText) {
      initialPrimary = String(prior.rawAddressText).slice(0, 60);
      initialSecondary = prior.district ? `District: ${prior.district} · written directions` : 'Written directions — our team confirms';
    } else if (prior?.district) {
      initialPrimary = String(prior.area || prior.parishWard || prior.district);
      initialSecondary = `District: ${prior.district} · Uganda`;
    }
  } catch {
    /* unparseable prior state = start fresh */
  }
}
---

<div class="js-uganda-location-picker space-y-2 relative" data-id={id} data-with-pin={withPin ? '1' : ''}>
  <label for={`${id}_input`} class="block text-sm font-bold text-brand-charcoal">
    {label} {required && <span class="text-red-500" aria-hidden="true">*</span>}
  </label>

  {helperText && <p id={helperId} class="text-xs text-brand-mutedGrey">{helperText}</p>}

  {/* Confirmed selection card */}
  <div class={`js-selected-card bg-green-50 border border-green-200 rounded-xl p-4 flex items-start justify-between gap-4 ${initialPrimary ? '' : 'hidden'}`}>
    <div class="flex gap-3">
      <div class="mt-1 bg-green-100 text-green-700 rounded-full p-1 flex-shrink-0">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
      </div>
      <div>
        <p class="font-bold text-brand-charcoal text-base leading-tight js-card-primary">{initialPrimary}</p>
        <p class="text-sm text-gray-700 js-card-secondary">{initialSecondary}</p>
        <p class="text-xs text-green-700 mt-0.5 hidden js-card-pin">📍 Location pin attached</p>
      </div>
    </div>
    <button type="button" class="text-xs font-black text-brand-charcoal uppercase tracking-wider hover:bg-white px-3 py-1.5 rounded-lg border border-green-200 transition-colors js-change-btn">
      Change
    </button>
  </div>

  {/* Search + always-available district fallback */}
  <div class={`js-search-mode space-y-3 ${initialPrimary ? 'hidden' : ''}`}>
    <div class="relative">
      <input
        type="text"
        id={`${id}_input`}
        class="w-full px-4 py-4 bg-white border border-brand-borderGrey rounded-xl shadow-sm focus:ring-2 focus:ring-brand-primary focus:border-transparent outline-none transition-all font-medium"
        placeholder={placeholder}
        autocomplete="off"
        inputmode="search"
        enterkeyhint="search"
        aria-autocomplete="list"
        aria-haspopup="listbox"
        role="combobox"
        aria-describedby={helperId}
        aria-expanded="false"
        aria-controls={`${id}_results`}
        aria-invalid={!!errorMessage}
      />
      <ul
        id={`${id}_results`}
        role="listbox"
        aria-label="Matching places"
        class="absolute z-50 top-full left-0 right-0 bg-white border border-gray-200 rounded-xl mt-2 shadow-2xl max-h-64 overflow-y-auto hidden js-results-dropdown divide-y divide-gray-100"
      >
      </ul>
      <p class="sr-only js-result-announce" role="status" aria-live="polite"></p>
    </div>

    <div class="flex items-center gap-3">
      <span class="text-[11px] font-bold uppercase tracking-widest text-brand-mutedGrey whitespace-nowrap">Browse by district</span>
      <select
        aria-label="Pick your district from the official list"
        class="js-district-select flex-1 bg-white border border-brand-borderGrey px-3 py-2.5 rounded-lg text-sm font-medium outline-none focus:ring-2 focus:ring-brand-primary"
      >
        <option value="">Pick your district…</option>
        {UGANDA_DISTRICTS.map((d) => <option value={d}>{d}</option>)}
      </select>
    </div>

    {/* PART H: the sale never blocks on a data gap — always visible */}
    <button type="button" class="js-manual-toggle text-sm font-bold text-brand-charcoal underline underline-offset-4 decoration-brand-primary">
      I can't find my area — write directions instead
    </button>

    <div class="js-manual-mode hidden space-y-2 bg-amber-50 border border-amber-200 rounded-xl p-4">
      <label class="block text-sm font-bold text-brand-charcoal" for={`${id}_manual`}>
        Describe where the delivery should go
      </label>
      <textarea
        id={`${id}_manual`}
        rows="2"
        maxlength="400"
        class="js-manual-text w-full px-3 py-2.5 bg-white border border-brand-borderGrey rounded-lg text-sm outline-none focus:ring-2 focus:ring-brand-primary"
        placeholder="e.g. Kyanamukaaka trading centre, past the mosque, ask for Ssalongo's shop"></textarea>
      <p class="text-xs text-amber-800">Our team will confirm the delivery details with a phone call before dispatch.</p>
      <button type="button" class="js-manual-commit bg-brand-charcoal text-white text-sm font-bold px-4 py-2 rounded-lg">
        Use these directions
      </button>
    </div>
  </div>

  {withPin && (
    <div class="js-pin-section border border-gray-200 rounded-xl p-4 space-y-3">
      <p class="text-sm font-bold text-brand-charcoal">Location pin <span class="font-normal text-gray-500">(optional — helps the rider find you)</span></p>
      <div class="flex flex-wrap gap-2">
        <button type="button" class="js-pin-gps text-sm font-bold bg-white border border-brand-borderGrey px-4 py-2.5 rounded-lg hover:border-brand-primary">
          📍 Use my current location
        </button>
      </div>
      <input
        type="text"
        class="js-pin-link w-full px-3 py-2.5 bg-white border border-brand-borderGrey rounded-lg text-sm outline-none focus:ring-2 focus:ring-brand-primary"
        placeholder="…or paste a WhatsApp / Google Maps location link"
        autocomplete="off"
      />
      <p class="js-pin-status text-xs text-gray-500"></p>
    </div>
  )}

  {errorMessage && <p class="text-xs text-red-600 mt-1 font-bold js-err-box">{errorMessage}</p>}

  <input type="hidden" name={name} id={id} class="js-final-payload" value={defaultValue} required={required} />
</div>

<script>
  // The logic lives in src/lib/locationPickerClient.ts and self-initialises,
  // idempotently. See that file's header for why it is a named module rather
  // than inline: implicit hoisting made the wiring unauditable by grep.
  import '../lib/locationPickerClient';
</script>
