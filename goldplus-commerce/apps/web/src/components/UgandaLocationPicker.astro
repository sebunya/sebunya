---
import type { UgandaLocationSelection } from '@goldplus/shared';

/**
 * UgandaLocationPicker.astro
 * Unified, accessible location picker that strictly guarantees canonical payload shapes.
 */
interface Props {
  id?: string;
  name: string; 
  label?: string;
  placeholder?: string;
  helperText?: string;
  required?: boolean;
  defaultValue?: string; // Expects full JSON payload from prior state
  errorMessage?: string;
}

const {
  id = "loc_" + Math.random().toString(36).substr(2, 9),
  name,
  label = "Location",
  placeholder = "Search town, parish, or district...",
  helperText = "",
  required = false,
  defaultValue = "",
  errorMessage = ""
} = Astro.props;

const helperId = helperText ? `${id}_helper` : undefined;

// Dehydrate initial value safely
let initialSelection: Partial<UgandaLocationSelection> | null = null;
if (defaultValue && defaultValue.startsWith('{')) {
  try {
    initialSelection = JSON.parse(defaultValue);
  } catch (e) {}
}
---

<div class="js-uganda-location-picker space-y-2 relative" data-id={id}>
  <div class="flex items-center justify-between">
    <label for={`${id}_input`} class="block text-sm font-bold text-brand-charcoal flex items-center gap-1">
      {label} {required && <span class="text-red-500" aria-hidden="true">*</span>}
    </label>
    <button type="button" class="text-xs font-bold text-brand-primary hover:underline js-toggle-mode" aria-expanded="false">
      Not sure? Choose step by step
    </button>
  </div>

  {helperText && <p id={helperId} class="text-xs text-brand-mutedGrey">{helperText}</p>}

  {/* Case 1: State - Selection Confirmed (The "Selected Card") */}
  <div class={`js-selected-card bg-green-50 border border-green-200 rounded-xl p-4 flex items-start justify-between gap-4 ${initialSelection ? '' : 'hidden'}`}>
    <div class="flex gap-3">
       <div class="mt-1 bg-green-100 text-green-700 rounded-full p-1 flex-shrink-0">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
       </div>
       <div>
          <p class="font-bold text-brand-charcoal text-base leading-tight js-card-primary">{initialSelection?.parishWard || ''}</p>
          <p class="text-sm text-gray-700 js-card-secondary">{initialSelection ? `${initialSelection.subcountyDivisionTc}, ${initialSelection.district}` : ''}</p>
          <p class="text-xs text-gray-500 font-medium mt-0.5 js-card-meta">{initialSelection ? `${initialSelection.region} · Code ${initialSelection.postcode}` : ''}</p>
       </div>
    </div>
    <button type="button" class="text-xs font-black text-brand-charcoal uppercase tracking-wider hover:bg-white px-3 py-1.5 rounded-lg border border-green-200 transition-colors js-change-btn">
       Change
    </button>
  </div>

  {/* Case 2: State - Search Field */}
  <div class={`js-search-mode relative ${initialSelection ? 'hidden' : ''}`}>
    <div class="relative">
      <input 
        type="text" 
        id={`${id}_input`} 
        class="w-full px-4 py-4 bg-white border border-brand-borderGrey rounded-xl shadow-sm focus:ring-2 focus:ring-brand-primary focus:border-transparent outline-none transition-all pr-12 font-medium"
        placeholder={placeholder}
        autocomplete="off"
        aria-autocomplete="list"
        aria-haspopup="listbox"
        role="combobox"
        aria-describedby={helperId}
        aria-expanded="false"
        aria-controls={`${id}_results`}
        aria-invalid={!!errorMessage}
      />
      <div class="absolute right-2 top-1/2 -translate-y-1/2 flex items-center gap-1">
         <button type="button" class="js-geo-btn p-2 bg-gray-50 hover:bg-gray-100 text-gray-500 hover:text-brand-primary rounded-lg transition-colors" title="Use my current precise location (GPS)">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
         </button>
      </div>
    </div>
    
    {/* Accessible Dropdown list */}
    <ul 
      id={`${id}_results`} 
      role="listbox"
      class="absolute z-50 top-full left-0 right-0 bg-white border border-gray-200 rounded-xl mt-2 shadow-2xl max-h-64 overflow-y-auto hidden js-results-dropdown divide-y divide-gray-100"
    >
       <!-- Results dynamically Injected via script -->
    </ul>
  </div>

  {/* Case 3: State - Hierarchical Step Selector */}
  <div class="hidden js-step-mode space-y-3 p-4 bg-gray-50 rounded-xl border border-gray-200 shadow-inner">
    <div class="flex justify-between items-center mb-1">
      <span class="text-xs font-bold text-gray-400 uppercase">Step Selector</span>
      <button type="button" class="text-xs text-gray-500 hover:text-brand-charcoal js-clear-step">Reset</button>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
      <div>
        <select aria-label="Select District" class="w-full bg-white border border-gray-300 px-3 py-2.5 rounded-lg text-sm font-medium js-step-district"><option value="">District...</option></select>
      </div>
      <div>
        <select aria-label="Select Subcounty" disabled class="w-full bg-white disabled:opacity-50 disabled:bg-gray-100 border border-gray-300 px-3 py-2.5 rounded-lg text-sm font-medium js-step-subcounty"><option value="">Sub-county...</option></select>
      </div>
      <div>
        <select aria-label="Select Parish" disabled class="w-full bg-white disabled:opacity-50 disabled:bg-gray-100 border border-gray-300 px-3 py-2.5 rounded-lg text-sm font-medium js-step-parish"><option value="">Parish / Ward...</option></select>
      </div>
    </div>
  </div>

  {errorMessage && <p class="text-xs text-red-600 mt-1 font-bold js-err-box">{errorMessage}</p>}

  {/* The Core Form Values. strictly hidden payloads. */}
  <input type="hidden" name={name} id={id} class="js-final-payload" value={defaultValue} required={required} />
  <input type="hidden" name={`${name}_coords`} class="js-final-coords" />
</div>

<script>
  import { searchLocations, normalizeToSelection } from '../lib/location-search';
  import type { UgandaLocationIndexRecord, UgandaLocationSelection } from '@goldplus/shared';

  // Dynamic global fetch store shared across all component instances on page
  let masterIndex: UgandaLocationIndexRecord[] = [];
  let isFetching = false;

  async function loadMasterIndex(): Promise<UgandaLocationIndexRecord[]> {
    if (masterIndex.length > 0) return masterIndex;
    if (isFetching) {
       while(isFetching) { await new Promise(r => setTimeout(r, 50)); if(masterIndex.length > 0) return masterIndex; }
    }
    isFetching = true;
    try {
      const response = await fetch('/data/uganda-locations-final.json');
      if (!response.ok) throw new Error(`Dataset fetch error ${response.status}`);
      masterIndex = await response.json();
    } catch (err) {
      console.error('[UG-PICKER] Fatal Dataset Load Failure:', err);
    } finally {
      isFetching = false;
    }
    return masterIndex;
  }

  function setupWidget(el: HTMLElement) {
    const rootId = el.getAttribute('data-id');
    const input = el.querySelector('.js-search-mode input') as HTMLInputElement;
    const dropdown = el.querySelector('.js-results-dropdown') as HTMLUListElement;
    const payloadInput = el.querySelector('.js-final-payload') as HTMLInputElement;
    const coordsInput = el.querySelector('.js-final-coords') as HTMLInputElement;
    
    const geoBtn = el.querySelector('.js-geo-btn') as HTMLButtonElement;
    const selectedCard = el.querySelector('.js-selected-card') as HTMLElement;
    const searchContainer = el.querySelector('.js-search-mode') as HTMLElement;
    const changeBtn = el.querySelector('.js-change-btn') as HTMLButtonElement;
    
    const cardPrimary = el.querySelector('.js-card-primary') as HTMLElement;
    const cardSecondary = el.querySelector('.js-card-secondary') as HTMLElement;
    const cardMeta = el.querySelector('.js-card-meta') as HTMLElement;

    const toggleBtn = el.querySelector('.js-toggle-mode') as HTMLButtonElement;
    const stepContainer = el.querySelector('.js-step-mode') as HTMLElement;
    const errBox = el.querySelector('.js-err-box') as HTMLElement;

    const districtSelect = el.querySelector('.js-step-district') as HTMLSelectElement;
    const subcountySelect = el.querySelector('.js-step-subcounty') as HTMLSelectElement;
    const parishSelect = el.querySelector('.js-step-parish') as HTMLSelectElement;
    const clearStepBtn = el.querySelector('.js-clear-step') as HTMLButtonElement;

    let localBuffer: UgandaLocationSelection[] = [];
    let activeIndex = -1;

    /**
     * Commits a confirmed selection to DOM and updates all structural layouts
     */
    function commitSelection(sel: UgandaLocationSelection) {
      payloadInput.value = JSON.stringify(sel);
      
      // Update UI Card
      cardPrimary.textContent = sel.parishWard;
      const secText = sel.subcountyDivisionTc === sel.parishWard ? sel.district : `${sel.subcountyDivisionTc}, ${sel.district}`;
      cardSecondary.textContent = secText;
      cardMeta.textContent = `${sel.region} · Code ${sel.postcode}`;
      
      // Toggle Visibilities
      dropdown.classList.add('hidden');
      searchContainer.classList.add('hidden');
      stepContainer.classList.add('hidden');
      selectedCard.classList.remove('hidden');
      
      if(errBox) errBox.classList.add('hidden');
      input.value = '';
      localBuffer = [];
      activeIndex = -1;
    }

    /**
     * Invalidates current selection and triggers standard fallback/rescan flow.
     */
    function unlockSelection() {
      payloadInput.value = '';
      coordsInput.value = '';
      selectedCard.classList.add('hidden');
      geoBtn.classList.remove('bg-green-100', 'text-green-600');
      geoBtn.title = "Use my current precise location (GPS)";
      
      const isStep = toggleBtn.getAttribute('aria-expanded') === 'true';
      if (isStep) {
         stepContainer.classList.remove('hidden');
      } else {
         searchContainer.classList.remove('hidden');
         input.focus();
      }
    }

    changeBtn.addEventListener('click', unlockSelection);

    /**
     * Keyboard Navigation handler for ARIA accessible dropdowns
     */
    function moveHighlight(dir: number) {
       const items = dropdown.querySelectorAll('li[role="option"]');
       if (items.length === 0) return;

       if (activeIndex >= 0) items[activeIndex].classList.remove('bg-blue-50', 'ring-1', 'ring-inset', 'ring-blue-200');
       
       activeIndex += dir;
       if (activeIndex < 0) activeIndex = items.length - 1;
       if (activeIndex >= items.length) activeIndex = 0;

       const next = items[activeIndex] as HTMLElement;
       next.classList.add('bg-blue-50', 'ring-1', 'ring-inset', 'ring-blue-200');
       next.scrollIntoView({ block: 'nearest' });
       input.setAttribute('aria-activedescendant', next.id);
    }

    input.addEventListener('keydown', (e) => {
       if (dropdown.classList.contains('hidden')) return;
       if (e.key === 'ArrowDown') { e.preventDefault(); moveHighlight(1); }
       else if (e.key === 'ArrowUp') { e.preventDefault(); moveHighlight(-1); }
       else if (e.key === 'Enter') {
          e.preventDefault();
          if (activeIndex >= 0 && localBuffer[activeIndex]) {
             commitSelection(localBuffer[activeIndex]);
          }
       }
       else if (e.key === 'Escape') {
          dropdown.classList.add('hidden');
          input.setAttribute('aria-expanded', 'false');
       }
    });

    // Typing triggers data ensures and fuzzy rendering
    input.addEventListener('input', async () => {
      // IMPERATIVE: INSTANTLY INVALIDATE payload on character change to prevent stale submissions!
      payloadInput.value = '';
      activeIndex = -1;

      const query = input.value.trim();
      if (query.length < 2) {
        dropdown.classList.add('hidden');
        input.setAttribute('aria-expanded', 'false');
        return;
      }

      const data = await loadMasterIndex();
      const ranked = searchLocations(query, data, 15);
      localBuffer = ranked.map(r => r.selection);

      if (localBuffer.length === 0) {
         dropdown.innerHTML = `<li class="px-4 py-3 text-sm text-gray-500 italic">No Ugandan location matched "${query}"</li>`;
      } else {
         dropdown.innerHTML = localBuffer.map((item, idx) => `
           <li id="${rootId}_opt_${idx}" role="option" class="px-4 py-3 hover:bg-brand-softGrey cursor-pointer flex flex-col gap-0.5 group transition-colors" data-index="${idx}">
             <div class="flex items-center justify-between">
               <span class="font-bold text-brand-charcoal leading-tight text-base group-hover:text-brand-primary">${item.parishWard}</span>
               <span class="text-[10px] font-black bg-gray-100 px-1.5 py-0.5 rounded text-gray-600 uppercase tracking-wider">${item.postcode}</span>
             </div>
             <span class="text-sm text-gray-600 leading-normal">${item.subcountyDivisionTc === item.parishWard ? item.district : `${item.subcountyDivisionTc}, ${item.district}`}</span>
             <span class="text-xs text-gray-400 font-medium">${item.region}</span>
           </li>
         `).join('');
      }

      dropdown.classList.remove('hidden');
      input.setAttribute('aria-expanded', 'true');
    });

    // Delegate selection clicks to container to handle dynamic items efficiently
    dropdown.addEventListener('click', (e) => {
       const li = (e.target as HTMLElement).closest('li[data-index]');
       if (!li) return;
       const idx = parseInt(li.getAttribute('data-index') || '0', 10);
       if (localBuffer[idx]) {
          commitSelection(localBuffer[idx]);
       }
    });

    // Handle explicit step-by-step mechanism
    toggleBtn.addEventListener('click', async () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      const data = await loadMasterIndex();

      if (!isExpanded) {
         toggleBtn.setAttribute('aria-expanded', 'true');
         toggleBtn.textContent = 'Switch to quick search';
         searchContainer.classList.add('hidden');
         dropdown.classList.add('hidden');
         if(!payloadInput.value) {
            stepContainer.classList.remove('hidden');
         }
         // Init district options
         const uniqDistricts = Array.from(new Set(data.map(r => r.d))).sort();
         districtSelect.innerHTML = '<option value="">District...</option>' + uniqDistricts.map(d => `<option value="${d}">${d}</option>`).join('');
      } else {
         toggleBtn.setAttribute('aria-expanded', 'false');
         toggleBtn.textContent = 'Not sure? Choose step by step';
         stepContainer.classList.add('hidden');
         if(!payloadInput.value) {
            searchContainer.classList.remove('hidden');
            input.focus();
         }
      }
    });

    // Direct cascading for step controls
    districtSelect.addEventListener('change', () => {
       subcountySelect.innerHTML = '<option value="">Sub-county...</option>';
       subcountySelect.disabled = !districtSelect.value;
       parishSelect.innerHTML = '<option value="">Parish...</option>';
       parishSelect.disabled = true;
       
       if (districtSelect.value) {
          const matchSubs = Array.from(new Set(masterIndex.filter(r => r.d === districtSelect.value).map(r => r.s))).sort();
          subcountySelect.innerHTML += matchSubs.map(s => `<option value="${s}">${s}</option>`).join('');
       }
    });

    subcountySelect.addEventListener('change', () => {
       parishSelect.innerHTML = '<option value="">Parish / Ward...</option>';
       parishSelect.disabled = !subcountySelect.value;
       
       if (subcountySelect.value) {
          const matchParishes = masterIndex.filter(r => r.d === districtSelect.value && r.s === subcountySelect.value).sort((a,b) => a.p.localeCompare(b.p));
          // Store code and parish composite to prevent simple duplicate postcode overrides!
          parishSelect.innerHTML += matchParishes.map(p => `<option value="${p.code}||${p.p}">${p.p}</option>`).join('');
       }
    });

    parishSelect.addEventListener('change', () => {
       const rawVal = parishSelect.value;
       if (!rawVal) return;
       const [code, parishName] = rawVal.split('||');
       const match = masterIndex.find(r => r.code === code && r.p === parishName);
       if (match) {
          commitSelection(normalizeToSelection(match));
       }
    });

    clearStepBtn.addEventListener('click', () => {
       districtSelect.value = '';
       subcountySelect.innerHTML = '<option value="">Sub-county...</option>';
       subcountySelect.disabled = true;
       parishSelect.innerHTML = '<option value="">Parish...</option>';
       parishSelect.disabled = true;
    });

    // Geolocation opt-in integration
    geoBtn?.addEventListener('click', () => {
       if (!navigator.geolocation) {
          alert('Sorry, browser geolocation not supported.');
          return;
       }
       
       const origHtml = geoBtn.innerHTML;
       geoBtn.innerHTML = '<svg class="animate-spin h-5 w-5 text-gray-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path></svg>';
       
       navigator.geolocation.getCurrentPosition(
          (pos) => {
             const latlng = { lat: pos.coords.latitude, lng: pos.coords.longitude };
             coordsInput.value = JSON.stringify(latlng);
             geoBtn.innerHTML = '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>';
             geoBtn.classList.add('bg-green-100', 'text-green-600');
             geoBtn.title = `Coordinates Captured: ${latlng.lat.toFixed(4)}, ${latlng.lng.toFixed(4)}`;
             // Update selection payload if exists to append
             if (payloadInput.value) {
                try {
                  const existing = JSON.parse(payloadInput.value);
                  existing.coordinates = latlng;
                  payloadInput.value = JSON.stringify(existing);
                } catch(e) {}
             }
          },
          (err) => {
             geoBtn.innerHTML = origHtml;
             alert('Unable to capture location. Please ensure permissions are enabled.');
             console.warn('Geo-fail:', err);
          },
          { timeout: 10000, enableHighAccuracy: true }
       );
    });

    // Blur to close outside clicks
    document.addEventListener('click', (e) => {
       if (!el.contains(e.target as Node)) {
          dropdown.classList.add('hidden');
          input.setAttribute('aria-expanded', 'false');
       }
    });
  }

  document.querySelectorAll('.js-uganda-location-picker').forEach(el => setupWidget(el as HTMLElement));
</script>
