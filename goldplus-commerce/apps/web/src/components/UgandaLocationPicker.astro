---
import { UGANDA_DISTRICTS } from '@goldplus/shared';

/**
 * UgandaLocationPicker v2 — capture WHERE a delivery goes in the way Ugandans
 * actually give directions (location-module brief PARTs F–H).
 *
 * Layers, in order:
 *   1. SERVER search over the verified gazetteer (5,805 areas + aliases +
 *      groups + landmarks + pickup points) — folded orthography, ranked,
 *      provenance-tagged. Falls back seamlessly to layer 2 offline.
 *   2. LOCAL index: curated aliases + the official 136 districts — always
 *      available with zero network (the metro set that matters most).
 *   3. District select, pasted map link and written directions, folded under
 *      "Can't find your area?" (2026-10-16: one question on screen, not four).
 *   4. Written directions — the PART H manual path. A missing gazetteer
 *      row must never block a sale: free text + optional district proceed to
 *      checkout with the fee honestly unconfirmed and land in the ops queue.
 *
 * Optional pin capture (PART G.1, `withPin`): device GPS or a pasted
 * Google-Maps/WhatsApp link (parsed client-side; short links resolved
 * server-side), offered INSIDE the search box. A pin alone names the area via
 * GET /locations/near (the quote's own nearest-area rule: close and unambiguous,
 * else nothing — no area is invented); the customer still sees and can change it.
 *
 * Payload (hidden input, JSON):
 *   { district, area?, displayLabel, areaSlug?, gpsLat?, gpsLng?,
 *     gpsAccuracyM?, gpsSource? }                      — structured selection
 *   { manual: true, rawAddressText, district? }        — manual fallback
 * Legacy payloads are still accepted as defaultValue.
 */
interface Props {
  id?: string;
  name: string;
  label?: string;
  placeholder?: string;
  helperText?: string;
  required?: boolean;
  defaultValue?: string;
  errorMessage?: string;
  /** Show the GPS / pasted-link pin capture section. */
  withPin?: boolean;
  /** Label for the free-text fallback; the default is delivery wording, so a non-delivery form (a counterfeit report) passes its own. */
  manualLabel?: string;
  /** Note under the free-text fallback; empty string hides it. */
  manualNote?: string;
  /** Offer written directions under "Can't find your area?" (false where only an AREA is useful, e.g. "Deliver to"). */
  withDirections?: boolean;
  /** Offer the paid Google Places layer for buildings (false where an area is all that is needed). */
  deepPlaces?: boolean;
}

const {
  id = 'loc_' + Math.random().toString(36).substr(2, 9),
  manualLabel = 'Describe where the delivery should go',
  manualNote = 'Our team will confirm the delivery details with a phone call before dispatch.',
  name,
  label = 'Delivery location',
  placeholder = 'Search your area, e.g. Najjera, Kisaasi, Mbarara',
  helperText = '',
  required = false,
  defaultValue = '',
  errorMessage = '',
  withPin = false,
  withDirections = true,
  deepPlaces = true,
} = Astro.props;

const helperId = helperText ? `${id}_helper` : undefined;
// The error is part of the input's description, so a screen reader hears WHY
// the field is invalid, not only that it is.
const errorId = errorMessage ? `${id}_error` : undefined;
const describedBy = [helperId, errorId].filter(Boolean).join(' ') || undefined;

let initialPrimary = '';
let initialSecondary = '';
if (defaultValue && defaultValue.startsWith('{')) {
  try {
    const prior = JSON.parse(defaultValue);
    if (prior?.manual && prior?.rawAddressText) {
      initialPrimary = String(prior.rawAddressText).slice(0, 60);
      initialSecondary = prior.district ? `District: ${prior.district} · written directions` : 'Written directions. Our team confirms';
    } else if (prior?.district) {
      initialPrimary = String(prior.area || prior.parishWard || prior.district);
      initialSecondary = `District: ${prior.district} · Uganda`;
    }
  } catch {
    /* unparseable prior state = start fresh */
  }
}
---

<div class="js-uganda-location-picker space-y-2 relative" data-id={id} data-with-pin={withPin ? '1' : ''} data-deep={deepPlaces ? '' : 'off'}>
  <label for={`${id}_input`} class="block text-sm font-bold text-brand-charcoal">
    {label} {required && <span class="text-red-500" aria-hidden="true">*</span>}
  </label>

  {helperText && <p id={helperId} class="text-xs text-brand-mutedGrey">{helperText}</p>}

  {/* Right under the label, beside the input it is about (it used to render
      after the pin box, ~300px away). Hidden by the script once a place is chosen. */}
  {errorMessage && <p id={errorId} class="text-xs text-red-600 font-bold js-err-box">{errorMessage}</p>}

  {/* Confirmed selection card */}
  <div class={`js-selected-card bg-green-50 border border-green-200 rounded-xl p-4 flex items-start justify-between gap-4 ${initialPrimary ? '' : 'hidden'}`}>
    <div class="flex items-start gap-3 min-w-0">
      <div class="mt-1 bg-green-100 text-green-700 rounded-full p-1 flex-shrink-0">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
      </div>
      <div class="min-w-0">
        <p class="font-bold text-brand-charcoal text-base leading-tight break-words js-card-primary">{initialPrimary}</p>
        <p class="text-sm text-gray-700 js-card-secondary">{initialSecondary}</p>
        <p class="text-xs text-green-700 mt-0.5 hidden js-card-pin">📍 Your exact location is attached for the rider</p>
        {withPin && (
          <button type="button" class="js-card-add-pin mt-1.5 text-xs font-bold text-brand-charcoal underline underline-offset-4 decoration-brand-primary">
            📍 Add my exact location (helps the rider find you)
          </button>
        )}
        {withPin && <p class="js-card-pin-status text-xs text-gray-600 mt-1" role="status" aria-live="polite"></p>}
      </div>
    </div>
    <button type="button" class="inline-flex min-h-11 flex-shrink-0 items-center text-xs font-black text-brand-charcoal uppercase tracking-wider hover:bg-white px-4 rounded-lg border border-green-200 transition-colors outline-none focus-visible:ring-4 focus-visible:ring-brand-primaryInk js-change-btn">
      Change
    </button>
  </div>

  {/* Search + always-available district fallback */}
  <div class={`js-search-mode space-y-3 ${initialPrimary ? 'hidden' : ''}`}>
    <div class="relative">
      <svg aria-hidden="true" class="pointer-events-none absolute left-4 top-[1.15rem] w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7" stroke-width="2"></circle><path stroke-linecap="round" stroke-width="2" d="M20 20l-3.5-3.5"></path></svg>
      <input
        type="text"
        id={`${id}_input`}
        class={`w-full pl-12 ${withPin ? 'pr-32 sm:pr-44' : 'pr-4'} py-4 bg-white border ${errorMessage ? 'border-red-600 ring-2 ring-red-100' : 'border-brand-borderGrey'} rounded-xl shadow-sm focus:ring-2 focus:ring-brand-primaryInk focus:border-transparent outline-none transition-all font-medium`}
        placeholder={placeholder}
        autocomplete="off"
        inputmode="search"
        enterkeyhint="search"
        aria-autocomplete="list"
        aria-haspopup="listbox"
        role="combobox"
        aria-describedby={describedBy}
        aria-expanded="false"
        aria-controls={`${id}_results`}
        aria-invalid={errorMessage ? 'true' : undefined}
      />
      {withPin && (
        <button type="button" class="js-pin-gps absolute right-2 top-2 bottom-2 inline-flex items-center gap-1.5 rounded-lg bg-brand-charcoal px-3 text-xs sm:text-sm font-bold text-white hover:bg-black outline-none focus-visible:ring-4 focus-visible:ring-brand-primaryInk">
          <svg aria-hidden="true" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3" stroke-width="2"></circle><path stroke-linecap="round" stroke-width="2" d="M12 2v3M12 19v3M2 12h3M19 12h3"></path></svg>
          <span class="sm:hidden">Locate me</span><span class="hidden sm:inline">Use my location</span>
        </button>
      )}
      <ul
        id={`${id}_results`}
        role="listbox"
        aria-label="Matching places"
        class="absolute z-50 top-full left-0 right-0 bg-white border border-gray-200 rounded-xl mt-2 shadow-2xl max-h-64 overflow-y-auto hidden js-results-dropdown divide-y divide-gray-100"
      >
      </ul>
      <p class="sr-only js-result-announce" role="status" aria-live="polite"></p>
    </div>
    {withPin && <p class="js-pin-status text-xs text-gray-600 min-h-[1rem]" role="status" aria-live="polite"></p>}

    {/* One question on screen; the other ways to answer it fold away (2026-10-16). Nothing removed:
        district list, pasted WhatsApp/Maps link and written directions are all one tap away. */}
    <details class="js-fallbacks group rounded-xl border border-gray-200 bg-white">
      <summary class="cursor-pointer list-none px-4 py-3 text-sm font-bold text-brand-charcoal flex items-center justify-between min-h-11">
        <span>Can't find your area?</span>
        <span aria-hidden="true" class="text-gray-400 group-open:rotate-180 transition-transform">▾</span>
      </summary>
      <div class="space-y-4 px-4 pb-4">
        <div class="space-y-1.5">
          <label class="block text-xs font-bold text-brand-charcoal" for={`${id}_district`}>Pick your district</label>
          <select
            id={`${id}_district`}
            class="js-district-select w-full min-w-0 bg-white border border-brand-borderGrey px-3 py-2.5 rounded-lg text-base sm:text-sm font-medium outline-none focus:ring-2 focus:ring-brand-primaryInk"
          >
            <option value="">Pick your district…</option>
            {UGANDA_DISTRICTS.map((d) => <option value={d}>{d}</option>)}
          </select>
        </div>
        {withPin && (
          <div class="space-y-1.5">
            <label for={`${id}_pin`} class="block text-xs font-bold text-brand-charcoal">Paste a WhatsApp or Google Maps location</label>
            <input
              type="text"
              id={`${id}_pin`}
              class="js-pin-link w-full px-3 py-2.5 bg-white border border-brand-borderGrey rounded-lg text-base sm:text-sm outline-none focus:ring-2 focus:ring-brand-primaryInk"
              placeholder="https://maps.app.goo.gl/…"
              autocomplete="off"
            />
          </div>
        )}
        {withDirections && (
        <div class="js-manual-mode space-y-2">
          <label class="block text-xs font-bold text-brand-charcoal" for={`${id}_manual`}>
            {manualLabel}
          </label>
          <textarea
            id={`${id}_manual`}
            rows="2"
            maxlength="400"
            class="js-manual-text w-full px-3 py-2.5 bg-white border border-brand-borderGrey rounded-lg text-base sm:text-sm outline-none focus:ring-2 focus:ring-brand-primaryInk"
            placeholder="e.g. Kyanamukaaka trading centre, past the mosque, ask for Ssalongo's shop"></textarea>
          {manualNote && <p class="text-xs text-gray-600">{manualNote}</p>}
          <button type="button" class="js-manual-commit bg-brand-charcoal text-white text-sm font-bold px-4 py-2.5 rounded-lg min-h-11">
            Use these directions
          </button>
        </div>
        )}
      </div>
    </details>
  </div>

  {/* Announces the chosen place once the search box is replaced by the card
      (focus moves to "Change", which alone would say nothing about what was chosen). */}
  <p class="sr-only js-commit-announce" role="status" aria-live="polite"></p>

  <input type="hidden" name={name} id={id} class="js-final-payload" value={defaultValue} required={required} />
</div>

<script>
  // The logic lives in src/lib/locationPickerClient.ts and self-initialises,
  // idempotently. See that file's header for why it is a named module rather
  // than inline: implicit hoisting made the wiring unauditable by grep.
  import '../lib/locationPickerClient';
</script>
