---
import { UGANDA_DISTRICTS } from '@goldplus/shared';

/**
 * UgandaLocationPicker — capture WHERE a delivery goes in the way Ugandans
 * actually give directions.
 *
 * Two layers, nothing else:
 *   1. A structured layer that is always verifiably correct: the customer types
 *      the place they know ("Najjera", "Seeta", "Fort Portal") and lands on a
 *      curated alias mapped to its REAL district — or picks the district
 *      directly from the official list, which stays visible as a fallback.
 *   2. Free text for everything finer (estate, road, landmark) lives OUTSIDE
 *      this component, because last-mile delivery here runs on landmarks and a
 *      phone call — not parishes or postcodes.
 *
 * The previous version searched a 5,700-row postcode gazetteer that had Wakiso
 * missing entirely, Kireka and Nansana filed under Mukono, and no Najjera or
 * Bugolobi at all — structured wrongness that mis-zoned real orders. This one
 * would rather say less and be right. The dead GPS button (raw coordinates
 * captured into a field nothing consumed) is gone with it.
 *
 * Payload emitted (hidden input, JSON): { district, area?, displayLabel }.
 * Legacy payloads (parishWard/postcode shapes) are still accepted as
 * defaultValue and re-rendered faithfully so in-flight sessions keep working.
 */
interface Props {
  id?: string;
  name: string;
  label?: string;
  placeholder?: string;
  helperText?: string;
  required?: boolean;
  defaultValue?: string; // JSON payload from prior state (new or legacy shape)
  errorMessage?: string;
}

const {
  id = 'loc_' + Math.random().toString(36).substr(2, 9),
  name,
  label = 'Delivery location',
  placeholder = 'Type your area, town or district — e.g. Najjera, Seeta, Mbarara',
  helperText = '',
  required = false,
  defaultValue = '',
  errorMessage = '',
} = Astro.props;

const helperId = helperText ? `${id}_helper` : undefined;

// Rehydrate a prior selection (new lean shape or the legacy gazetteer shape)
// so re-rendered forms show what was chosen.
let initialPrimary = '';
let initialSecondary = '';
if (defaultValue && defaultValue.startsWith('{')) {
  try {
    const prior = JSON.parse(defaultValue);
    if (prior?.district) {
      initialPrimary = String(prior.area || prior.parishWard || prior.district);
      initialSecondary = `District: ${prior.district} · Uganda`;
    }
  } catch {
    /* unparseable prior state = start fresh */
  }
}
---

<div class="js-uganda-location-picker space-y-2 relative" data-id={id}>
  <label for={`${id}_input`} class="block text-sm font-bold text-brand-charcoal">
    {label} {required && <span class="text-red-500" aria-hidden="true">*</span>}
  </label>

  {helperText && <p id={helperId} class="text-xs text-brand-mutedGrey">{helperText}</p>}

  {/* Confirmed selection card */}
  <div class={`js-selected-card bg-green-50 border border-green-200 rounded-xl p-4 flex items-start justify-between gap-4 ${initialPrimary ? '' : 'hidden'}`}>
    <div class="flex gap-3">
      <div class="mt-1 bg-green-100 text-green-700 rounded-full p-1 flex-shrink-0">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
      </div>
      <div>
        <p class="font-bold text-brand-charcoal text-base leading-tight js-card-primary">{initialPrimary}</p>
        <p class="text-sm text-gray-700 js-card-secondary">{initialSecondary}</p>
      </div>
    </div>
    <button type="button" class="text-xs font-black text-brand-charcoal uppercase tracking-wider hover:bg-white px-3 py-1.5 rounded-lg border border-green-200 transition-colors js-change-btn">
      Change
    </button>
  </div>

  {/* Search + always-available district fallback */}
  <div class={`js-search-mode space-y-3 ${initialPrimary ? 'hidden' : ''}`}>
    <div class="relative">
      <input
        type="text"
        id={`${id}_input`}
        class="w-full px-4 py-4 bg-white border border-brand-borderGrey rounded-xl shadow-sm focus:ring-2 focus:ring-brand-primary focus:border-transparent outline-none transition-all font-medium"
        placeholder={placeholder}
        autocomplete="off"
        aria-autocomplete="list"
        aria-haspopup="listbox"
        role="combobox"
        aria-describedby={helperId}
        aria-expanded="false"
        aria-controls={`${id}_results`}
        aria-invalid={!!errorMessage}
      />
      <ul
        id={`${id}_results`}
        role="listbox"
        aria-label="Matching places"
        class="absolute z-50 top-full left-0 right-0 bg-white border border-gray-200 rounded-xl mt-2 shadow-2xl max-h-64 overflow-y-auto hidden js-results-dropdown divide-y divide-gray-100"
      >
      </ul>
    </div>

    <div class="flex items-center gap-3">
      <span class="text-[11px] font-bold uppercase tracking-widest text-brand-mutedGrey whitespace-nowrap">Can't find it?</span>
      <select
        aria-label="Pick your district from the official list"
        class="js-district-select flex-1 bg-white border border-brand-borderGrey px-3 py-2.5 rounded-lg text-sm font-medium outline-none focus:ring-2 focus:ring-brand-primary"
      >
        <option value="">Pick your district…</option>
        {UGANDA_DISTRICTS.map((d) => <option value={d}>{d}</option>)}
      </select>
    </div>
  </div>

  {errorMessage && <p class="text-xs text-red-600 mt-1 font-bold js-err-box">{errorMessage}</p>}

  <input type="hidden" name={name} id={id} class="js-final-payload" value={defaultValue} required={required} />
</div>

<script>
  // Deep import of the pure-data module, NOT '@goldplus/shared': this script is
  // bundled for the BROWSER, and the shared package index pulls in modules that
  // import node:crypto (cart-credential, checkout-intent), which kills the
  // client build. The frontmatter (SSR) may use the package root; this may not.
  import { UGANDA_DISTRICTS, UGANDA_PLACE_ALIASES } from '../../../../packages/shared/src/locations/uganda';

  interface PlaceOption {
    /** What the customer sees and typed toward. */
    label: string;
    /** Canonical district the option resolves to. */
    district: string;
    /** Area label when the option is a neighbourhood/town; absent for bare districts. */
    area?: string;
  }

  // One flat, tiny index: curated aliases first (they are what people type),
  // then every district itself. No fetch, no external dataset.
  const OPTIONS: PlaceOption[] = [
    ...UGANDA_PLACE_ALIASES.map((a) => ({ label: a.area, district: a.district, area: a.area })),
    ...UGANDA_DISTRICTS.map((d) => ({ label: d, district: d })),
  ];

  function rank(query: string, limit = 8): PlaceOption[] {
    const q = query.trim().toLowerCase();
    if (q.length < 2) return [];
    const starts: PlaceOption[] = [];
    const contains: PlaceOption[] = [];
    for (const opt of OPTIONS) {
      const l = opt.label.toLowerCase();
      if (l.startsWith(q)) starts.push(opt);
      else if (l.includes(q)) contains.push(opt);
    }
    return [...starts, ...contains].slice(0, limit);
  }

  function setupWidget(el: HTMLElement) {
    const input = el.querySelector('.js-search-mode input') as HTMLInputElement | null;
    const dropdown = el.querySelector('.js-results-dropdown') as HTMLUListElement | null;
    const payloadInput = el.querySelector('.js-final-payload') as HTMLInputElement | null;
    const selectedCard = el.querySelector('.js-selected-card') as HTMLElement | null;
    const searchContainer = el.querySelector('.js-search-mode') as HTMLElement | null;
    const changeBtn = el.querySelector('.js-change-btn') as HTMLButtonElement | null;
    const cardPrimary = el.querySelector('.js-card-primary') as HTMLElement | null;
    const cardSecondary = el.querySelector('.js-card-secondary') as HTMLElement | null;
    const districtSelect = el.querySelector('.js-district-select') as HTMLSelectElement | null;
    const errBox = el.querySelector('.js-err-box') as HTMLElement | null;
    if (!input || !dropdown || !payloadInput || !selectedCard || !searchContainer) return;

    let current: PlaceOption[] = [];
    let activeIndex = -1;

    function commit(opt: PlaceOption) {
      const hasArea = Boolean(opt.area && opt.area !== opt.district);
      payloadInput!.value = JSON.stringify({
        district: opt.district,
        ...(hasArea ? { area: opt.area } : {}),
        displayLabel: hasArea ? `${opt.area}, ${opt.district}` : opt.district,
      });
      if (cardPrimary) cardPrimary.textContent = opt.area ?? opt.district;
      if (cardSecondary) cardSecondary.textContent = `District: ${opt.district} · Uganda`;
      dropdown!.classList.add('hidden');
      input!.setAttribute('aria-expanded', 'false');
      searchContainer!.classList.add('hidden');
      selectedCard!.classList.remove('hidden');
      errBox?.classList.add('hidden');
      payloadInput!.dispatchEvent(new Event('change', { bubbles: true }));
    }

    function renderResults(list: PlaceOption[]) {
      dropdown!.innerHTML = '';
      activeIndex = -1;
      if (list.length === 0) {
        const li = document.createElement('li');
        li.className = 'px-4 py-3 text-sm text-gray-500';
        li.textContent = 'No match — pick your district from the list below.';
        dropdown!.appendChild(li);
      } else {
        list.forEach((opt, i) => {
          const li = document.createElement('li');
          li.setAttribute('role', 'option');
          li.setAttribute('id', `${el.dataset.id}_opt_${i}`);
          li.className = 'px-4 py-3 cursor-pointer hover:bg-amber-50 flex items-baseline justify-between gap-3';
          const nameSpan = document.createElement('span');
          nameSpan.className = 'font-bold text-brand-charcoal text-sm';
          nameSpan.textContent = opt.label;
          const distSpan = document.createElement('span');
          distSpan.className = 'text-xs text-gray-500 whitespace-nowrap';
          distSpan.textContent = opt.area ? `${opt.district} District` : 'District';
          li.appendChild(nameSpan);
          li.appendChild(distSpan);
          // mousedown, not click: the input's blur handler hides the list before
          // a click would land.
          li.addEventListener('mousedown', (e) => {
            e.preventDefault();
            commit(opt);
          });
          dropdown!.appendChild(li);
        });
      }
      dropdown!.classList.remove('hidden');
      input!.setAttribute('aria-expanded', 'true');
    }

    function highlight(delta: number) {
      const items = Array.from(dropdown!.querySelectorAll('[role="option"]')) as HTMLElement[];
      if (items.length === 0) return;
      activeIndex = (activeIndex + delta + items.length) % items.length;
      items.forEach((item, i) => {
        item.classList.toggle('bg-amber-50', i === activeIndex);
        if (i === activeIndex) {
          input!.setAttribute('aria-activedescendant', item.id);
          item.scrollIntoView({ block: 'nearest' });
        }
      });
    }

    input.addEventListener('input', () => {
      // A changed query invalidates any committed payload so a stale selection
      // cannot ride along under fresher-looking text.
      payloadInput.value = '';
      current = rank(input.value);
      if (input.value.trim().length < 2) {
        dropdown.classList.add('hidden');
        input.setAttribute('aria-expanded', 'false');
        return;
      }
      renderResults(current);
    });

    input.addEventListener('keydown', (e) => {
      if (dropdown.classList.contains('hidden')) return;
      if (e.key === 'ArrowDown') { e.preventDefault(); highlight(1); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); highlight(-1); }
      else if (e.key === 'Enter') {
        if (activeIndex >= 0 && current[activeIndex]) { e.preventDefault(); commit(current[activeIndex]); }
        else if (current.length === 1) { e.preventDefault(); commit(current[0]); }
      } else if (e.key === 'Escape') {
        dropdown.classList.add('hidden');
        input.setAttribute('aria-expanded', 'false');
      }
    });

    input.addEventListener('blur', () => {
      window.setTimeout(() => {
        dropdown.classList.add('hidden');
        input.setAttribute('aria-expanded', 'false');
      }, 150);
    });

    districtSelect?.addEventListener('change', () => {
      const district = districtSelect.value;
      if (district) commit({ label: district, district });
    });

    changeBtn?.addEventListener('click', () => {
      selectedCard.classList.add('hidden');
      searchContainer.classList.remove('hidden');
      payloadInput.value = '';
      if (districtSelect) districtSelect.value = '';
      input.value = '';
      input.focus();
    });
  }

  document.querySelectorAll<HTMLElement>('.js-uganda-location-picker').forEach(setupWidget);
</script>
