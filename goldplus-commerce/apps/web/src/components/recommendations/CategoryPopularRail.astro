---
import RecommendationRail from "./RecommendationRail.astro";
import { getRecommendations } from "../../lib/recommendations";
import { filterDisplayableRecommendations } from "../../lib/recommendation-display";

/**
 * R7 (2026-08-06): trusts the engine's category ladder (bestsellers → search
 * affinity → engagement → stable category listing).
 *
 * UNWIRED: no page mounts this rail today — the shop page IS the category
 * listing, so a "popular in this category" rail beside it would be the same
 * products twice. It stays because dedicated category landing pages are the
 * obvious next storefront step; wire it there, and delete this note.
 */

interface Props {
  categoryId?: string;
  categorySlug?: string;
  categoryName: string;
}

const { categoryId, categorySlug, categoryName } = Astro.props;

const response = await getRecommendations({
  placement: "category_popular",
  categoryId,
  categorySlug,
  limit: 12,
}, { visitToken: Astro.locals.gpVisit });

const finalItems = filterDisplayableRecommendations(response.items, { limit: 4 });
---

{finalItems.length > 0 && (
  <RecommendationRail
    title="More from this category"
    subtitle={`Products listed in ${categoryName}.`}
    placement="category_popular"
    items={finalItems}
  />
)}
