---
import RecommendationRail from "./RecommendationRail.astro";
import { getRecommendations } from "../../lib/recommendations";
import { filterDisplayableRecommendations, previewRecommendationRules, productToRecommendationItem } from "../../lib/recommendation-display";
import { CATEGORY_SLUG_TO_NAME, getCleanCatalog } from "../../lib/catalog/catalog";
import { apiBase } from "../../lib/api";
import type { ApiResponse, ProductPublicDto } from "@goldplus/shared";

interface Props {
  categoryId?: string;
  categorySlug?: string;
}

const { categoryId, categorySlug } = Astro.props;

const response = await getRecommendations({
  placement: "category_popular",
  categoryId,
  categorySlug,
  limit: 12,
}, { visitToken: Astro.locals.gpVisit });

let displayItems = filterDisplayableRecommendations(response.items, {
  limit: 4,
});

let finalItems = displayItems;

if (finalItems.length === 0) {
  let allProducts: ProductPublicDto[] = [];
  try {
    const res = await fetch(`${apiBase}/products?limit=50`, { signal: AbortSignal.timeout(3000) });
    if (res.ok) {
      const json = await res.json() as ApiResponse<ProductPublicDto[]>;
      if (json.success && json.data) {
        allProducts = json.data;
      }
    }
  } catch {
    // ignore
  }
  allProducts = getCleanCatalog(allProducts);
  
  // Find category name from slug
  const targetCategory = categorySlug ? CATEGORY_SLUG_TO_NAME[categorySlug] : undefined;

  // Filter products by category slug/name if present
  let filtered = allProducts;
  if (targetCategory) {
    filtered = allProducts.filter(p => p.categoryName === targetCategory);
  }
  
  finalItems = previewRecommendationRules(
    filtered.map((product) => productToRecommendationItem(product, "CATEGORY_FALLBACK")),
    { currentCategory: targetCategory, maxCount: 4, categoryDominanceCap: 4 },
  ).selected;
}
---

{finalItems.length > 0 && (
  <RecommendationRail
    title="More from this category"
    subtitle="Products currently listed in this product family."
    placement="category_popular"
    items={finalItems}
  />
)}
