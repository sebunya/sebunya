---
import RecommendationRail from "./RecommendationRail.astro";
import { getRecommendations } from "../../lib/recommendations";
import { filterDisplayableRecommendations, shouldRenderRail } from "../../lib/recommendation-display";

interface Props {
  excludeProductIds?: string[];
  useContainerWrapper?: boolean;
}

const { excludeProductIds = [], useContainerWrapper = false } = Astro.props;

// Fetch slightly more to ensure we can achieve a clean 4-item limit after exclusions
const response = await getRecommendations({
  placement: "home_trending",
  limit: 12,
});

const displayItems = filterDisplayableRecommendations(response.items, {
  excludeIds: excludeProductIds,
  limit: 4,
});

const render = shouldRenderRail(displayItems, 2);
---

{render && (
  useContainerWrapper ? (
    <section class="bg-brand-softGrey py-16 border-t border-brand-borderGrey">
      <div class="container mx-auto px-4 lg:px-8">
        <RecommendationRail
          title="Top Sellers Right Now"
          subtitle="Customer favourites based on real GoldPlus orders."
          placement="home_trending"
          items={displayItems}
        />
      </div>
    </section>
  ) : (
    <RecommendationRail
      title="Top Sellers Right Now"
      subtitle="Customer favourites based on real GoldPlus orders."
      placement="home_trending"
      items={displayItems}
    />
  )
)}
