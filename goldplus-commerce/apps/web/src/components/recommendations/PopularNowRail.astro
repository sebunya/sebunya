---
import RecommendationRail from "./RecommendationRail.astro";
import { getRecommendations } from "../../lib/recommendations";
import { filterDisplayableRecommendations } from "../../lib/recommendation-display";
import { LOCAL_SEED_PRODUCTS, getCleanCatalog } from "../../lib/catalog/catalog";
import { apiBase } from "../../lib/api";
import type { ApiResponse, ProductPublicDto } from "@goldplus/shared";

interface Props {
  excludeProductIds?: string[];
  useContainerWrapper?: boolean;
}

const { excludeProductIds = [], useContainerWrapper = false } = Astro.props;

// Fetch slightly more to ensure we can achieve a clean 4-item limit after exclusions
const response = await getRecommendations({
  placement: "home_trending",
  limit: 12,
});

const displayItems = filterDisplayableRecommendations(response.items, {
  excludeIds: excludeProductIds,
  limit: 4,
});

let finalItems = displayItems;

if (finalItems.length === 0) {
  let allProducts: ProductPublicDto[] = [];
  try {
    const res = await fetch(`${apiBase}/products?limit=50`, { signal: AbortSignal.timeout(3000) });
    if (res.ok) {
      const json = await res.json() as ApiResponse<ProductPublicDto[]>;
      if (json.success && json.data) {
        allProducts = json.data;
      }
    }
  } catch {
    // ignore
  }
  allProducts = getCleanCatalog(allProducts);
  
  const eligible = allProducts.filter(p => !excludeProductIds.includes(p.id));
  
  finalItems = eligible.slice(0, 4).map(p => ({
    productId: p.id,
    slug: p.slug,
    name: p.name,
    imageUrl: p.primaryImageUrl ?? undefined,
    price: p.retailPriceUgx ?? undefined,
    score: 0.5,
    reasonCode: "TRENDING_FALLBACK",
  }));
}
---

{finalItems.length > 0 && (
  useContainerWrapper ? (
    <section class="bg-brand-softGrey py-16 border-t border-brand-borderGrey">
      <div class="container mx-auto px-4 lg:px-8">
        <RecommendationRail
          title="Top Sellers Right Now"
          subtitle="Customer favourites based on real GoldPlus orders."
          placement="home_trending"
          items={finalItems}
        />
      </div>
    </section>
  ) : (
    <RecommendationRail
      title="Top Sellers Right Now"
      subtitle="Customer favourites based on real GoldPlus orders."
      placement="home_trending"
      items={finalItems}
    />
  )
)}
