---
import type {
  RecommendationItemDto,
  RecommendationPlacement,
} from "@goldplus/shared";
import RecommendationCard from "./RecommendationCard.astro";

interface Props {
  title: string;
  placement: RecommendationPlacement;
  items: RecommendationItemDto[];
  subtitle?: string;
  variant?: "default" | "cart-compact";
  showEmptyState?: boolean;
  emptyMessage?: string;
}

const {
  title,
  placement,
  items = [],
  subtitle,
  variant = "default",
  showEmptyState = false,
  emptyMessage = "No eligible products are currently available to show.",
} = Astro.props;

const productIdsString = items.map((item) => item.productId).join(",");
---

<section
  class="my-12"
  aria-labelledby={`recommendation-title-${placement}`}
  data-recommendation-rail
  data-placement={placement}
  data-product-ids={productIdsString}
>
  <div class="mb-6">
    <h2 id={`recommendation-title-${placement}`} class="text-2xl font-black tracking-tight text-brand-charcoal">
      {title}
    </h2>
    {subtitle && (
      <p class="text-brand-mutedGrey text-sm mt-1 font-medium">{subtitle}</p>
    )}
  </div>

  {items.length > 0 ? (
    <ul class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6">
      {items.map((item) => (
        <RecommendationCard item={item} placement={placement} variant={variant} />
      ))}
    </ul>
  ) : showEmptyState ? (
    <div class="rounded-2xl border border-brand-borderGrey bg-brand-softGrey px-5 py-6 text-sm text-brand-mutedGrey" role="status">
      <p>{emptyMessage}</p>
      <a href="/shop" class="mt-3 inline-flex font-bold text-brand-charcoal underline underline-offset-4 focus-visible:outline focus-visible:outline-2 focus-visible:outline-brand-primary">
        Browse the shop
      </a>
    </div>
  ) : null}
</section>

<script>
  import {
    trackRecommendationClick,
    trackRecommendationImpression,
    persistClickAttribution
  } from "../../lib/recommendations";

  // Wait for DOM interactive so dynamic features register
  document.addEventListener("DOMContentLoaded", () => {
    const cards = document.querySelectorAll("[data-recommendation-click]");

    const seenCards = new WeakSet<Element>();

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting || seenCards.has(entry.target)) continue;

          // Commit seen so it won't fire duplication streams on re-scroll.
          seenCards.add(entry.target);

          const target = entry.target;
          const placement = target.getAttribute("data-placement");
          const productId = target.getAttribute("data-product-id");

          if (placement && productId) {
            trackRecommendationImpression({
              placement: placement as any,
              productId,
              attributionId: target.getAttribute("data-attribution-id") || undefined,
              railRenderId: target.getAttribute("data-rail-render-id") || undefined,
              ruleId: target.getAttribute("data-rule-id") || undefined,
              reasonCode: target.getAttribute("data-reason-code") || undefined,
              source: "recommendation_rail",
            });
          }
        }
      },
      { threshold: 0.30 },
    );

    cards.forEach((card) => observer.observe(card));

    // Event delegation approach for robust monitoring
    document.addEventListener("click", (event) => {
      const target = event.target instanceof Element
        ? event.target.closest("[data-recommendation-click]")
        : null;

      if (!target) return;

      const placement = target.getAttribute("data-placement");
      const productId = target.getAttribute("data-product-id");
      const attributionId = target.getAttribute("data-attribution-id");
      const railRenderId = target.getAttribute("data-rail-render-id");
      const ruleId = target.getAttribute("data-rule-id");
      const reasonCode = target.getAttribute("data-reason-code");

      if (placement && productId) {
        if (attributionId) {
          persistClickAttribution({
            attributionId,
            railRenderId: railRenderId || undefined,
            placement,
            ruleId: ruleId || undefined,
            reasonCode: reasonCode || undefined,
            productId,
          });
        }

        trackRecommendationClick({
          placement: placement as any,
          productId,
          attributionId: attributionId || undefined,
          railRenderId: railRenderId || undefined,
          ruleId: ruleId || undefined,
          reasonCode: reasonCode || undefined,
          source: "recommendation_card",
        });
      }
    });
  });
</script>
