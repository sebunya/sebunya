---
import RecommendationRail from "./RecommendationRail.astro";
import { getRecommendations } from "../../lib/recommendations";
import { filterDisplayableRecommendations } from "../../lib/recommendation-display";

/**
 * R7 (2026-08-06): compatibility is REQUIRED here — the engine hard-kills
 * anything known-incompatible and reports NO_COMPATIBLE_PRODUCTS when nothing
 * verified fits, so an anchor with no compatible accessories renders NO rail
 * rather than a catalogue dump pretending earbuds complete a car mount. The
 * old client-side catalogue re-rank is retired.
 */

interface Props {
  productId: string;
  productSlug: string;
  categoryName?: string;
  subcategoryName?: string;
}

const { productId, productSlug } = Astro.props;

const response = await getRecommendations({
  placement: "complete_setup",
  productId,
  limit: 6,
}, { visitToken: Astro.locals.gpVisit });

const finalItems = filterDisplayableRecommendations(response.items, {
  currentProductId: productId,
  currentProductSlug: productSlug,
  limit: 4,
});
---

{finalItems.length > 0 && (
  <RecommendationRail
    title="You may also need"
    subtitle="Made to work with the one you're looking at."
    placement="complete_setup"
    items={finalItems}
  />
)}
