---
import RecommendationRail from "./RecommendationRail.astro";
import { getRecommendations } from "../../lib/recommendations";
import { filterDisplayableRecommendations } from "../../lib/recommendation-display";
import { LOCAL_SEED_PRODUCTS, getCleanCatalog } from "../../lib/catalog/catalog";
import { apiBase } from "../../lib/api";
import type { ApiResponse, ProductPublicDto } from "@goldplus/shared";

interface Props {
  productId: string;
}

const { productId } = Astro.props;

const response = await getRecommendations({
  placement: "complete_setup",
  productId,
  limit: 6,
});

const displayItems = filterDisplayableRecommendations(response.items, {
  currentProductId: productId,
  limit: 3,
});

let finalItems = displayItems;

if (finalItems.length === 0) {
  let allProducts: ProductPublicDto[] = [];
  try {
    const res = await fetch(`${apiBase}/products?limit=50`, { signal: AbortSignal.timeout(3000) });
    if (res.ok) {
      const json = await res.json() as ApiResponse<ProductPublicDto[]>;
      if (json.success && json.data) {
        allProducts = json.data;
      }
    }
  } catch {
    // ignore
  }
  allProducts = getCleanCatalog(allProducts);
  
  const eligible = allProducts.filter(p => p.id !== productId);
  // Complete setup: prioritize accessories/power/cables
  const powerOrAccessory = eligible.filter(p => p.categoryName === 'Power Devices' || p.categoryName === 'Car Accessories');
  const others = eligible.filter(p => p.categoryName !== 'Power Devices' && p.categoryName !== 'Car Accessories');
  const sorted = [...powerOrAccessory, ...others];
  
  finalItems = sorted.slice(0, 3).map(p => ({
    productId: p.id,
    slug: p.slug,
    name: p.name,
    imageUrl: p.primaryImageUrl ?? undefined,
    price: p.retailPriceUgx ?? undefined,
    score: 0.5,
    reasonCode: "SETUP_FALLBACK",
  }));
}
---

{finalItems.length > 0 && (
  <RecommendationRail
    title="Complete Your Setup"
    subtitle="Add the essentials that make your device work harder."
    placement="complete_setup"
    items={finalItems}
  />
)}
