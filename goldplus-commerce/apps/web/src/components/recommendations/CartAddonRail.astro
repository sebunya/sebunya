---
import RecommendationRail from "./RecommendationRail.astro";
import { getRecommendations } from "../../lib/recommendations";

interface Props {
  cartProductIds: string[];
}

const { cartProductIds } = Astro.props;

const response = await getRecommendations({
  placement: "cart_addon",
  cartProductIds,
  limit: 4,
});
---

<RecommendationRail
  title="Add Before Checkout"
  subtitle="Frequent small additions chosen by shoppers."
  placement="cart_addon"
  items={response.items}
/>
