---
import RecommendationRail from "./RecommendationRail.astro";
import { getRecommendations } from "../../lib/recommendations";
import { filterDisplayableRecommendations } from "../../lib/recommendation-display";

/**
 * R7 (2026-08-06): trusts the engine's cart_addon ladder (compatibility →
 * complementary → paid velocity → catalogue). Cart items are excluded twice —
 * engine and display boundary — because a cart item recommended back is the
 * one mistake this rail must never make. Three visible add-ons (§27).
 */

interface Props {
  cartProductIds: string[];
}

const { cartProductIds } = Astro.props;

const response = await getRecommendations({
  placement: "cart_addon",
  cartProductIds,
  limit: 8,
}, { visitToken: Astro.locals.gpVisit });

const finalItems = filterDisplayableRecommendations(response.items, {
  excludeIds: cartProductIds,
  limit: 3,
});
---

{finalItems.length > 0 && (
  <RecommendationRail
    title="You may also need"
    subtitle="Optional products from the current catalogue. Check product details before adding."
    placement="cart_addon"
    items={finalItems}
    variant="cart-compact"
  />
)}
