---
import { apiBase } from "../../lib/api";
import type { ApiResponse, ProductPublicDto } from "@goldplus/shared";

/**
 * Server-rendered local history is impossible as data lives in client storage.
 * This layout is initially Hidden and un-hides only via script injection if local items exist.
 */
interface Props {
  title?: string;
  subtitle?: string;
}

const { 
  title = "Pick Up Where You Left Off",
  subtitle = "Continue with products you viewed or added to cart."
} = Astro.props;

let validIds: string[] = [];
try {
  const res = await fetch(`${apiBase}/products?limit=50`, { signal: AbortSignal.timeout(3000) });
  if (res.ok) {
    const json = await res.json() as ApiResponse<ProductPublicDto[]>;
    if (json.success) {
      validIds = json.data.map(p => p.id).filter((id): id is string => typeof id === "string");
    }
  }
} catch {
  // Graceful fallback
}
---

<section
  class="my-12"
  style="display: none;"
  aria-labelledby="recommendation-recently-viewed"
  data-recently-viewed-rail
  data-valid-ids={JSON.stringify(validIds)}
>
  <div class="mb-6">
    <h2 id="recommendation-recently-viewed" class="text-2xl font-black tracking-tight text-brand-charcoal">
      {title}
    </h2>
    <p class="text-brand-mutedGrey text-sm mt-1 font-medium">{subtitle}</p>
  </div>

  <ul class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6" data-recently-viewed-list>
     {/* Hydrated dynamically on client mount */}
  </ul>
</section>

<script>
  import { shouldShowPickUpWhereYouLeftOff, getRecentlyViewedHistory } from "../../lib/returning-user";

  document.addEventListener("DOMContentLoaded", () => {
    const rail = document.querySelector("[data-recently-viewed-rail]") as HTMLElement | null;
    const list = document.querySelector("[data-recently-viewed-list]");

    if (!rail || !list) return;

    // Lock logic: Must be confirmed returning visitor AND have history
    if (!shouldShowPickUpWhereYouLeftOff()) {
      return;
    }

    const validIdsAttr = rail.getAttribute("data-valid-ids");
    const validIds: string[] = validIdsAttr ? JSON.parse(validIdsAttr) : [];

    const rawHistory = getRecentlyViewedHistory();
    const items = rawHistory
      .filter((item) => validIds.length === 0 || validIds.includes(item.productId))
      .slice(0, 4);

    if (items.length === 0) return;

    // Unhide section now that all gating rules passed and we have data
    rail.style.display = "block";

    list.innerHTML = items
      .map((item) => {
        const priceLabel = (typeof item.price === "number" && item.price > 0) 
          ? `USh ${item.price.toLocaleString("en-UG")}` 
          : "Price on request";
        
        const lowerName = item.name.toLowerCase();
        const productType = lowerName.includes("charger") ? "Charger"
          : (lowerName.includes("earbud") || lowerName.includes("headphone") || lowerName.includes("sound")) ? "Earbuds"
          : lowerName.includes("cable") ? "Cable"
          : lowerName.includes("power bank") ? "Power Bank"
          : lowerName.includes("drive") || lowerName.includes("sd") || lowerName.includes("storage") ? "Storage"
          : "Accessory";

        const img = item.imageUrl 
           ? `<img src="${item.imageUrl}" alt="${item.name}" loading="lazy" class="object-cover w-full h-full transition-transform group-hover:scale-105" />`
           : `<div class="absolute inset-0 flex flex-col items-center justify-center bg-brand-softGrey p-4 text-center select-none">
                <svg class="w-8 h-8 mb-1 text-brand-mutedGrey/30" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                <span class="text-[10px] font-bold text-brand-mutedGrey tracking-wider uppercase">${productType}</span>
                <span class="text-[9px] font-bold text-brand-mutedGrey/40 mt-0.5 uppercase tracking-tight">Coming Soon</span>
              </div>`;

        const priceSizeClass = (typeof item.price === 'number' && item.price > 0) ? 'text-sm' : 'text-[11px] text-brand-mutedGrey font-bold';

        const attributionId = "loc_" + Math.random().toString(36).substring(2, 11);
        const railRenderId = "loc_rail_" + Date.now();

        return `
          <li class="group list-none h-full">
            <a href="/products/${item.slug}" 
               data-recommendation-click 
               data-placement="recently_viewed" 
               data-product-id="${item.productId}" 
               data-attribution-id="${attributionId}"
               data-rail-render-id="${railRenderId}"
               data-reason-code="RECENTLY_VIEWED"
               class="flex flex-col h-full border border-brand-borderGrey rounded-2xl p-3 sm:p-4 hover:border-brand-primary hover:shadow-lg transition-all bg-white outline-none focus-visible:ring-4 focus-visible:ring-brand-primary/30">
              <div class="aspect-square bg-brand-softGrey rounded-xl overflow-hidden mb-3 relative">
                 ${img}
              </div>
              <div class="flex flex-col flex-grow">
                <h3 class="line-clamp-2 text-sm font-bold text-brand-charcoal leading-tight mb-1.5 group-hover:text-brand-primary transition-colors min-h-[2.5rem]">${item.name}</h3>
                <div class="mt-auto flex items-center justify-between pt-2 border-t border-brand-borderGrey/50">
                  <span class="text-brand-charcoal font-black ${priceSizeClass}">${priceLabel}</span>
                  <span class="px-2.5 py-1 rounded-lg bg-brand-softGrey text-brand-charcoal font-bold text-[10px] uppercase tracking-wider transition-colors group-hover:bg-brand-primary group-hover:text-brand-charcoal">View</span>
                </div>
              </div>
            </a>
          </li>
        `;
      })
      .join("");
  });
</script>
