---
import { getStorefrontDiscount } from "../../lib/storefrontDiscount";


interface Props {
  title?: string;
  subtitle?: string;
  alwaysRender?: boolean;
  fallbackProducts?: Array<{
    productId: string;
    slug: string;
    name: string;
    imageUrl?: string;
    price?: number;
    availability?: { kind: "in_stock" | "out_of_stock" | "pre_order" | "unknown"; quantity?: number };
  }>;
}

const { 
  title = "Pick Up Where You Left Off",
  subtitle = "Your recently viewed GoldPlus products are still here.",
  alwaysRender = false,
  fallbackProducts = []
} = Astro.props;

// Fresh server truth per product (price, stock, image) is fetched by the
// client from /api/catalogue-live only when the rail is about to render: local
// history is a bookmark, not a price list. It was stamped here as
// data-live-products on every page (34 KB of HTML) — see that endpoint.

// R1: when the catalogue cannot be fetched, the rail stays hidden rather
// than validating against fabricated seed IDs (retired 2026-08-06).

// The SAME campaign discount every server-rendered card shows, stamped for the
// client-side card builder so this rail is uniform with the rest of the site.
const railDiscount = await getStorefrontDiscount();
---

<section
  class="my-12"
  style="display: none;"
  aria-labelledby="recommendation-recently-viewed"
  data-recently-viewed-rail
  data-always-render={alwaysRender ? "true" : "false"}
  data-fallback-products={JSON.stringify(fallbackProducts.map(({ productId, slug, name, imageUrl, price, availability }) => ({ productId, slug, name, imageUrl, price, availability })))}
  data-sale-bps={railDiscount.active ? String(railDiscount.percentBps) : ""}
  data-sale-percent={railDiscount.active ? String(railDiscount.percent) : ""}
  data-sale-ends-iso={railDiscount.active ? (railDiscount.endsIso ?? "") : ""}
>
  <div class="mb-6">
    <h2 id="recommendation-recently-viewed" class="text-2xl font-black tracking-tight text-brand-charcoal">
      {title}
    </h2>
    <p class="text-brand-mutedGrey text-sm mt-1 font-medium">{subtitle}</p>
  </div>

  <ul class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6" data-recently-viewed-list>
     {/* Hydrated dynamically on client mount */}
  </ul>
</section>

<script>
  import { shouldShowPickUpWhereYouLeftOff, getRecentlyViewedHistory } from "../../lib/returning-user";

  document.addEventListener("DOMContentLoaded", async () => {
    const rail = document.querySelector("[data-recently-viewed-rail]") as HTMLElement | null;
    const list = document.querySelector("[data-recently-viewed-list]");

    if (!rail || !list) return;

    const alwaysRender = rail.getAttribute("data-always-render") === "true";
    
    // Lock logic: Must be confirmed returning visitor AND have history, UNLESS alwaysRender is active
    if (!alwaysRender && !shouldShowPickUpWhereYouLeftOff()) {
      return;
    }

    const safeSlug = /^[a-z0-9]+(?:-[a-z0-9]+)*$/;
    const escapeHtml = (value: unknown) => String(value ?? "").replace(/[&<>'"]/g, (character) => ({
      "&": "&amp;",
      "<": "&lt;",
      ">": "&gt;",
      "'": "&#39;",
      '"': "&quot;",
    })[character] ?? character);
    const safeImageUrl = (value: unknown) => {
      const candidate = String(value ?? "").trim();
      return /^https?:\/\//i.test(candidate) || /^\/(?!\/)/.test(candidate) ? candidate : "";
    };

    // Overlay fresh server truth (price, stock, image) onto local history —
    // a bookmark from last week must not show last week's price.
    // Nothing to show and nothing to fetch: the returning-visitor rail with no history.
    if (!alwaysRender && getRecentlyViewedHistory().length === 0) return;
    let liveByProduct: Record<string, { price?: number; sale?: number | null; availability?: { kind: string; quantity?: number }; imageUrl?: string }> = {};
    try {
      const res = await fetch("/api/catalogue-live", { credentials: "same-origin" });
      const body = await res.json();
      if (body && body.success && body.data && typeof body.data === "object") liveByProduct = body.data;
    } catch {
      // Same as an empty catalogue before: no overlay and no id filter.
    }
    // The live map's keys ARE the approved catalogue; a separate id list was the same
    // 184 ids stamped a second time into every page.
    const validIds: string[] = Object.keys(liveByProduct);
    // Same rule as lib/imageSrcset.ts for media-library masters: the card box is
    // 160–320 px wide, the master is 1024 px.
    const srcsetOf = (url: string) => { const m = url.match(/^(\/uploads\/assets\/[^?#]+\/)pdp\.webp$/); return m ? ` srcset="${m[1]}thumb.webp 160w, ${m[1]}card.webp 480w, ${url} 1024w" sizes="(max-width: 640px) 50vw, (max-width: 1024px) 33vw, 320px"` : ""; };
    const overlay = (item: any) => {
      const live = liveByProduct[item.productId];
      return live ? { ...item, price: live.price ?? item.price, sale: live.sale ?? null, availability: live.availability ?? item.availability, imageUrl: live.imageUrl ?? item.imageUrl } : { ...item, sale: null };
    };

    const rawHistory = getRecentlyViewedHistory();
    let items = rawHistory
      .map(overlay)
      .filter((item) => validIds.length === 0 || validIds.includes(item.productId))
      .filter((item) => safeSlug.test(String(item.slug ?? "")))
      .slice(0, 4);

    let isUsingFallback = false;
    if (items.length === 0) {
      if (alwaysRender) {
        const fallbackAttr = rail.getAttribute("data-fallback-products");
        items = fallbackAttr ? JSON.parse(fallbackAttr) : [];
        isUsingFallback = true;
      }
      
      if (items.length === 0) {
        return;
      }
    }

    // Unhide section now that all gating rules passed and we have data
    rail.style.display = "block";

    // The SAME campaign discount every server-rendered card shows (stamped by
    // the frontmatter); the evaluator's exact per-line formula, to the shilling.
    const saleBps = Number(rail.getAttribute("data-sale-bps") || 0);
    const salePercent = Number(rail.getAttribute("data-sale-percent") || 0);
    const saleEndsIso = rail.getAttribute("data-sale-ends-iso") || "";
    const saleActive = Number.isFinite(saleBps) && saleBps > 0;
    // The sale price is computed on the server by /api/catalogue-live with the
    // evaluator's exact per-line formula, INCLUDING the product's floor (Price
    // A), which never reaches the browser. No live sale = full price.

    const sharedRailRenderId = crypto.randomUUID();
    list.innerHTML = items
      .map((item) => {
        const priceLabel = (typeof item.price === "number" && item.price > 0) 
          ? `UGX ${item.price.toLocaleString("en-US")}`
          : "Price on request";
        
        const itemName = String(item.name ?? "Product");
        const escapedName = escapeHtml(itemName);
        const escapedProductId = escapeHtml(item.productId);
        const escapedSlug = escapeHtml(item.slug);
        const imageUrl = safeImageUrl(item.imageUrl);
        const lowerName = itemName.toLowerCase();
        const productType = lowerName.includes("charger") ? "Charger"
          : (lowerName.includes("earbud") || lowerName.includes("headphone") || lowerName.includes("sound")) ? "Earbuds"
          : lowerName.includes("cable") ? "Cable"
          : lowerName.includes("power bank") ? "Power Bank"
          : lowerName.includes("drive") || lowerName.includes("sd") || lowerName.includes("storage") ? "Storage"
          : "Accessory";

        const img = imageUrl
           ? `<img src="${escapeHtml(imageUrl)}"${srcsetOf(imageUrl)} alt="${escapedName} product image" loading="lazy" class="object-cover w-full h-full transition-transform duration-500 group-hover:scale-105" />`
           : `<div class="absolute inset-0 flex flex-col items-center justify-center bg-brand-softGrey p-4 text-center select-none">
                <svg class="w-10 h-10 mb-2 text-brand-mutedGrey/20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                <span class="text-[10px] font-bold text-brand-mutedGrey tracking-wider uppercase">${productType}</span>
                <span class="text-[9px] font-bold text-brand-mutedGrey/40 mt-1 uppercase tracking-tight">Image unavailable</span>
              </div>`;

        const qty = item.availability?.kind === "in_stock" && typeof item.availability?.quantity === "number" && item.availability.quantity > 0
          ? item.availability.quantity : null;
        const stockIsLow = qty !== null && qty <= 10;
        const availabilityLabel = item.availability?.kind === "in_stock"
          ? (qty !== null ? (stockIsLow ? `Only ${qty} left in stock` : `${qty} in stock`) : "In stock")
          : item.availability?.kind === "out_of_stock" ? "Out of stock"
          : item.availability?.kind === "pre_order" ? "Pre-order"
          : "Confirm availability";
        const availabilityClass = stockIsLow ? "text-amber-700 font-bold" : "text-brand-mutedGrey";

        const hasPrice = typeof item.price === "number" && item.price > 0;
        // A campaign is not a sale unless this product's price actually
        // drops. At the floor the cut is nothing, and "145,000 was 145,000,
        // 10% discount" is a claim the basket does not honour.
        const onSale = saleActive && hasPrice && typeof item.sale === "number" && item.sale > 0 && item.sale < item.price;
        const priceHtml = onSale
          ? `<span class="flex flex-col min-w-0">
               <span class="flex flex-wrap items-baseline gap-x-2">
                 <span class="font-black tracking-tight tabular-nums text-lg text-brand-charcoal">UGX ${item.sale.toLocaleString("en-US")}</span>
                 <span class="text-[11px] font-semibold text-slate-600 line-through tabular-nums">UGX ${item.price.toLocaleString("en-US")}</span>
                 <span class="text-[9px] font-black uppercase tracking-wider rounded-full px-1.5 py-0.5" style="background:#93D500;color:#0A0A0A">${salePercent}% discount</span>
               </span>
               ${saleEndsIso ? `<span class="mt-0.5 text-[10px] font-bold text-amber-700 tabular-nums" data-card-sale-ends="${escapeHtml(saleEndsIso)}">Discounted price. Limited time</span>` : ""}
             </span>`
          : `<span class="font-black tracking-tight ${hasPrice ? 'text-lg text-brand-charcoal' : 'text-xs text-brand-mutedGrey font-bold'}">${priceLabel}</span>`;


        // R7: real UUIDs — the old "loc_"-prefixed values failed the API's
        // uuid columns, so every event from this rail was silently rejected.
        const attributionId = crypto.randomUUID();
        const railRenderId = sharedRailRenderId;

        // The SAME server-handled add/buy the PDP and every other card use.
        const canBuy = item.availability?.kind === "in_stock" && hasPrice;
        const ctaHtml = canBuy
          ? `<form method="POST" action="/cart" class="mt-3 flex gap-2">
               <input type="hidden" name="action" value="add" />
               <input type="hidden" name="productId" value="${escapedProductId}" />
               <input type="hidden" name="slug" value="${escapedSlug}" />
               <input type="hidden" name="name" value="${escapedName}" />
               <input type="hidden" name="priceUgx" value="${Number(item.price) || 0}" />
               <button type="submit" aria-label="Add ${escapedName} to cart" class="flex-1 min-h-11 rounded-full border border-slate-300 text-[11px] font-black uppercase tracking-wider text-gray-800 outline-none transition hover:border-gray-900 hover:bg-slate-50 focus-visible:ring-2 focus-visible:ring-brand-primaryInk active:scale-[0.98]">Add to cart</button>
               <button type="submit" name="buyNow" value="1" aria-label="Buy ${escapedName} now" class="flex-1 min-h-11 rounded-full text-[11px] font-black uppercase tracking-wider outline-none transition hover:shadow-md hover:shadow-brand-primary/25 focus-visible:ring-2 focus-visible:ring-brand-primaryInk active:scale-[0.98]" style="background:#93D500;color:#0A0A0A">Buy now</button>
             </form>`
          : `<a href="/products/${escapedSlug}" class="mt-3 flex min-h-11 items-center justify-center rounded-full border border-slate-300 text-[11px] font-black uppercase tracking-wider text-gray-800 outline-none transition hover:border-gray-900 focus-visible:ring-2 focus-visible:ring-brand-primaryInk">View product</a>`;

        return `
          <li class="group list-none h-full">
            <div class="flex flex-col h-full border border-brand-borderGrey rounded-3xl p-5 hover:border-brand-primary hover:shadow-xl transition-all duration-300 bg-white">
              <a href="/products/${escapedSlug}"
                 aria-label="View ${escapedName}. ${priceLabel}. ${availabilityLabel}."
                 data-recommendation-click 
                 data-placement="recently_viewed" 
                 data-product-id="${escapedProductId}"
                 data-attribution-id="${attributionId}"
                 data-rail-render-id="${railRenderId}"
                 data-reason-code="${isUsingFallback ? 'RECENTLY_VIEWED_FALLBACK' : 'RECENTLY_VIEWED'}"
                 class="block aspect-square bg-brand-softGrey rounded-2xl overflow-hidden mb-4 relative border border-brand-borderGrey/50 outline-none focus-visible:ring-4 focus-visible:ring-brand-primaryInk">
                 ${img}
              </a>
              <div class="flex flex-col flex-grow">
                <h3 class="text-base font-bold text-brand-charcoal leading-tight mb-2 group-hover:text-brand-primaryInk transition-colors line-clamp-2 min-h-[2.5rem]"><a href="/products/${escapedSlug}" class="outline-none focus-visible:underline">${escapedName}</a></h3>
                <p class="mb-3 text-[11px] font-semibold ${availabilityClass}">${availabilityLabel}</p>
                <div class="mt-auto pt-4 border-t border-brand-borderGrey flex items-center justify-between gap-3">
                  ${priceHtml}
                </div>
                ${ctaHtml}
              </div>
            </div>
          </li>
        `;
      })
      .join("");

    // R7/R9: this rail injects its cards AFTER the shared observer in
    // RecommendationRail took its static snapshot, so it observes its own —
    // with the SAME 0.30 visibility contract as every other rail, because an
    // impression fired on DOM injection is not comparable to one fired on
    // actual sight, and cross-placement CTRs must compare like with like.
    import("../../lib/recommendations").then(({ trackRecommendationImpression }) => {
      const seen = new WeakSet<Element>();
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting || seen.has(entry.target)) continue;
            seen.add(entry.target);
            const productId = entry.target.getAttribute("data-product-id");
            if (!productId) continue;
            trackRecommendationImpression({
              placement: "recently_viewed",
              productId,
              attributionId: entry.target.getAttribute("data-attribution-id") || undefined,
              railRenderId: entry.target.getAttribute("data-rail-render-id") || undefined,
              reasonCode: entry.target.getAttribute("data-reason-code") || undefined,
              source: "recommendation_rail",
            });
          }
        },
        { threshold: 0.3 },
      );
      for (const el of Array.from(list.querySelectorAll("[data-recommendation-click]"))) {
        observer.observe(el);
      }
    }).catch(() => undefined);
  });
</script>
