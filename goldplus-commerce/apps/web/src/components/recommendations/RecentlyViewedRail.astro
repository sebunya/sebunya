---
/**
 * Server-rendered local history is impossible as data lives in client storage.
 * This layout is initially Hidden and un-hides only via script injection if local items exist.
 */
---

<section
  class="my-12 hidden"
  aria-labelledby="recommendation-recently-viewed"
  data-recently-viewed-rail
>
  <div class="mb-6">
    <h2 id="recommendation-recently-viewed" class="text-2xl font-black tracking-tight text-brand-charcoal">
      Recently Viewed
    </h2>
    <p class="text-brand-mutedGrey text-sm mt-1 font-medium">Products you saw during this session.</p>
  </div>

  <ul class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6" data-recently-viewed-list>
     {/* Hydrated dynamically on client mount */}
  </ul>
</section>

<script>
  import { getRecentlyViewedLocal } from "../../lib/recommendations";

  document.addEventListener("DOMContentLoaded", () => {
    const rail = document.querySelector("[data-recently-viewed-rail]");
    const list = document.querySelector("[data-recently-viewed-list]");

    if (!rail || !list) return;

    const items = getRecentlyViewedLocal().slice(0, 4);

    if (items.length === 0) return;

    // Clear hiding class as we have contents to load
    rail.classList.remove("hidden");

    const format = new Intl.NumberFormat("en-UG", {
      style: "currency",
      currency: "UGX",
      maximumFractionDigits: 0,
    });

    list.innerHTML = items
      .map((item) => {
        const priceLabel = item.price ? format.format(item.price) : "Price pending";
        const img = item.imageUrl 
           ? `<img src="${item.imageUrl}" alt="${item.name}" loading="lazy" class="object-cover w-full h-full transition-transform group-hover:scale-105" />`
           : `<div class="absolute inset-0 flex items-center justify-center text-brand-mutedGrey/40"><svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg></div>`;

        return `
          <li class="group list-none h-full">
            <a href="/products/${item.slug}" class="flex flex-col h-full border border-brand-borderGrey rounded-2xl p-3 sm:p-4 hover:border-brand-primary hover:shadow-lg transition-all bg-white outline-none focus-visible:ring-4 focus-visible:ring-brand-primary/30">
              <div class="aspect-square bg-brand-softGrey rounded-xl overflow-hidden mb-3 relative">
                 ${img}
              </div>
              <div class="flex flex-col flex-grow">
                <h3 class="line-clamp-2 text-sm font-bold text-brand-charcoal leading-tight mb-1.5 group-hover:text-brand-primary transition-colors min-h-[2.5rem]">${item.name}</h3>
                <div class="mt-auto flex items-center justify-between pt-2 border-t border-brand-borderGrey/50">
                  <span class="text-brand-charcoal font-black text-sm">${priceLabel}</span>
                </div>
              </div>
            </a>
          </li>
        `;
      })
      .join("");
  });
</script>
