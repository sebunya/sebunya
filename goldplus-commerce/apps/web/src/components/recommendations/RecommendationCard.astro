---
import type { RecommendationItemDto, RecommendationPlacement } from "@goldplus/shared";

interface Props {
  item: RecommendationItemDto;
  placement: RecommendationPlacement;
}

const { item, placement } = Astro.props;

const formattedPrice = (typeof item.price === "number" && item.price > 0)
  ? `USh ${item.price.toLocaleString("en-UG")}`
  : "Price on request";

const lowerName = item.name.toLowerCase();
const productType = lowerName.includes("charger") ? "Charger"
  : (lowerName.includes("earbud") || lowerName.includes("headphone") || lowerName.includes("sound")) ? "Earbuds"
  : lowerName.includes("cable") ? "Cable"
  : lowerName.includes("power bank") ? "Power Bank"
  : lowerName.includes("drive") || lowerName.includes("sd") || lowerName.includes("storage") ? "Storage"
  : "Accessory";
---

<li class="group list-none h-full">
  <a
    href={`/products/${item.slug}`}
    class="flex flex-col h-full border border-brand-borderGrey rounded-3xl p-5 hover:border-brand-primary hover:shadow-xl transition-all duration-300 bg-white relative outline-none focus-visible:ring-4 focus-visible:ring-brand-primary/30"
    data-recommendation-click
    data-placement={placement}
    data-product-id={item.productId}
    data-attribution-id={item.attributionId}
    data-rail-render-id={item.railRenderId}
    data-rule-id={item.ruleId}
    data-reason-code={item.reasonCode}
  >
    {/* Render small rationale tag if exists */}
    {item.displayReason && (
      <div class="absolute top-3 right-3 z-10">
        <span class="bg-brand-charcoal/85 backdrop-blur-sm text-white text-[9px] font-bold px-2.5 py-1.5 rounded-full uppercase tracking-widest border border-white/10 shadow-sm">
          {item.displayReason}
        </span>
      </div>
    )}

    <div class="aspect-square bg-brand-softGrey rounded-2xl overflow-hidden mb-4 relative border border-brand-borderGrey/50">
      {item.imageUrl ? (
        <img
          src={item.imageUrl}
          alt={item.name}
          loading="lazy"
          class="object-cover w-full h-full transition-transform duration-500 group-hover:scale-105"
        />
      ) : (
        <div class="absolute inset-0 flex flex-col items-center justify-center bg-brand-softGrey p-4 text-center select-none">
           <svg class="w-10 h-10 mb-2 text-brand-mutedGrey/20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
           <span class="text-[10px] font-bold text-brand-mutedGrey tracking-wider uppercase">{productType}</span>
           <span class="text-[9px] font-bold text-brand-mutedGrey/40 mt-1 uppercase tracking-tight">Coming Soon</span>
        </div>
      )}
    </div>

    <div class="flex flex-col flex-grow">
      <h3 class="text-base font-bold text-brand-charcoal leading-tight mb-2 group-hover:text-brand-primary transition-colors line-clamp-2 min-h-[2.5rem]">
        {item.name}
      </h3>

      <div class="mt-auto pt-4 border-t border-brand-borderGrey flex items-center justify-between gap-3">
        <span class={`font-black tracking-tight ${typeof item.price === 'number' && item.price > 0 ? 'text-lg text-brand-charcoal' : 'text-xs text-brand-mutedGrey font-bold'}`}>
          {formattedPrice}
        </span>
        <span class="px-4 py-2 rounded-xl font-bold text-xs transition-all duration-300 bg-brand-softGrey text-brand-charcoal group-hover:bg-brand-charcoal group-hover:text-white">
          View
        </span>
      </div>
    </div>
  </a>
</li>
