---
import type { RecommendationItemDto, RecommendationPlacement } from "@goldplus/shared";
import { supportedRecommendationReason } from "../../lib/recommendation-display";
import { formatUgx } from "../../lib/money";

interface Props {
  item: RecommendationItemDto & {
    availability?: { kind: "in_stock" | "out_of_stock" | "pre_order" | "unknown" };
    imageAlt?: string;
  };
  placement: RecommendationPlacement;
  variant?: "default" | "cart-compact";
}

const { item, placement, variant = "default" } = Astro.props;

const formattedPrice = (typeof item.price === "number" && item.price > 0)
  ? formatUgx(item.price)
  : "Price on request";
const availabilityLabel = item.availability?.kind === "in_stock" ? "In stock"
  : item.availability?.kind === "out_of_stock" ? "Out of stock"
  : item.availability?.kind === "pre_order" ? "Pre-order"
  : "Confirm availability";
const displayReason = supportedRecommendationReason(item.reasonCode);

const lowerName = item.name.toLowerCase();
const productType = lowerName.includes("charger") ? "Charger"
  : (lowerName.includes("earbud") || lowerName.includes("headphone") || lowerName.includes("sound")) ? "Earbuds"
  : lowerName.includes("cable") ? "Cable"
  : lowerName.includes("power bank") ? "Power Bank"
  : lowerName.includes("drive") || lowerName.includes("sd") || lowerName.includes("storage") ? "Storage"
  : "Accessory";
---

<li class="group list-none h-full">
  <a
    href={`/products/${item.slug}`}
    aria-label={`View ${item.name}. ${formattedPrice}. ${availabilityLabel}.`}
    class={variant === "cart-compact" 
      ? "flex flex-col h-full border border-slate-200/80 rounded-2xl p-4 hover:border-brand-primary hover:shadow-lg transition-all duration-300 bg-white relative outline-none focus-visible:ring-4 focus-visible:ring-brand-primary/30"
      : "flex flex-col h-full border border-brand-borderGrey rounded-3xl p-5 hover:border-brand-primary hover:shadow-xl transition-all duration-300 bg-white relative outline-none focus-visible:ring-4 focus-visible:ring-brand-primary/30"}
    data-recommendation-click
    data-placement={placement}
    data-product-id={item.productId}
    data-attribution-id={item.attributionId}
    data-rail-render-id={item.railRenderId}
    data-rule-id={item.ruleId}
    data-reason-code={item.reasonCode}
  >
    {/* Render small rationale tag if exists */}
    {displayReason && (
      <div class="absolute top-3 right-3 z-10">
        <span class="bg-brand-charcoal/85 backdrop-blur-sm text-white text-[9px] font-bold px-2.5 py-1.5 rounded-full uppercase tracking-widest border border-white/10 shadow-sm">
          {displayReason}
        </span>
      </div>
    )}

    <div class={variant === "cart-compact" 
      ? "aspect-square bg-slate-50 rounded-xl overflow-hidden mb-3 relative border border-slate-100"
      : "aspect-square bg-brand-softGrey rounded-2xl overflow-hidden mb-4 relative border border-brand-borderGrey/50"}>
      {item.imageUrl ? (
        <img
          src={item.imageUrl}
          alt={item.imageAlt ?? `${item.name} product image`}
          loading="lazy"
          class="object-cover w-full h-full transition-transform duration-500 group-hover:scale-105"
        />
      ) : (
        <div class="absolute inset-0 flex flex-col items-center justify-center bg-brand-softGrey p-4 text-center select-none">
           <svg class="w-10 h-10 mb-2 text-brand-mutedGrey/20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
           <span class="text-[10px] font-bold text-brand-mutedGrey tracking-wider uppercase">{productType}</span>
           <span class="text-[9px] font-bold text-brand-mutedGrey/50 mt-1 uppercase tracking-tight">Image unavailable</span>
        </div>
      )}
    </div>

    <div class="flex flex-col flex-grow">
      <h3 class={variant === "cart-compact"
        ? "text-sm font-bold text-gray-900 leading-tight mb-1.5 group-hover:text-brand-primary transition-colors line-clamp-1"
        : "text-base font-bold text-brand-charcoal leading-tight mb-2 group-hover:text-brand-primary transition-colors line-clamp-2 min-h-[2.5rem]"}>
        {item.name}
      </h3>
      <p class="mb-3 text-[11px] font-semibold text-brand-mutedGrey">{availabilityLabel}</p>

      <div class={variant === "cart-compact"
        ? "mt-auto pt-3 border-t border-slate-100 flex items-center justify-between gap-2"
        : "mt-auto pt-4 border-t border-brand-borderGrey flex items-center justify-between gap-3"}>
        <span class={variant === "cart-compact"
          ? `font-black tracking-tight ${typeof item.price === 'number' && item.price > 0 ? 'text-sm text-brand-primary' : 'text-[10px] text-slate-400 font-bold uppercase'}`
          : `font-black tracking-tight ${typeof item.price === 'number' && item.price > 0 ? 'text-lg text-brand-charcoal' : 'text-xs text-brand-mutedGrey font-bold'}`}>
          {formattedPrice}
        </span>
        {variant === "cart-compact" ? (
          <span class="w-7 h-7 rounded-full flex items-center justify-center transition-all duration-300 bg-slate-50 text-gray-900 group-hover:bg-brand-charcoal group-hover:text-white border border-slate-200 group-hover:border-transparent flex-shrink-0">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
          </span>
        ) : (
          <span class="px-4 py-2 rounded-xl font-bold text-xs transition-all duration-300 bg-brand-softGrey text-brand-charcoal group-hover:bg-brand-charcoal group-hover:text-white">
            View
          </span>
        )}
      </div>
    </div>
  </a>
</li>
