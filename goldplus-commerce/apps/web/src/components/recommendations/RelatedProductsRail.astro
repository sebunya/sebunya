---
import RecommendationRail from "./RecommendationRail.astro";
import { getRecommendations } from "../../lib/recommendations";
import { filterDisplayableRecommendations, previewRecommendationRules, productToRecommendationItem } from "../../lib/recommendation-display";
import { getCleanCatalog } from "../../lib/catalog/catalog";
import { apiBase } from "../../lib/api";
import type { ApiResponse, ProductPublicDto } from "@goldplus/shared";

interface Props {
  productId: string;
  productSlug: string;
  categoryName: string;
  subcategoryName?: string;
}

const { productId, productSlug, categoryName, subcategoryName = "" } = Astro.props;

const response = await getRecommendations({
  placement: "product_related",
  productId,
  limit: 8,
});

const displayItems = filterDisplayableRecommendations(response.items, {
  currentProductId: productId,
  currentProductSlug: productSlug,
  currentCategory: categoryName,
  currentSubcategory: subcategoryName,
  limit: 4,
});

let finalItems = displayItems;
let selectionRule = "eligible_candidates";

if (finalItems.length === 0) {
  let allProducts: ProductPublicDto[] = [];
  try {
    const res = await fetch(`${apiBase}/products?limit=50`, { signal: AbortSignal.timeout(3000) });
    if (res.ok) {
      const json = await res.json() as ApiResponse<ProductPublicDto[]>;
      if (json.success && json.data) {
        allProducts = json.data;
      }
    }
  } catch {
    // ignore
  }
  allProducts = getCleanCatalog(allProducts);
  
  const preview = previewRecommendationRules(
    allProducts.map((product) => productToRecommendationItem(product, "RELATED_FALLBACK")),
    {
      currentProductId: productId,
      currentProductSlug: productSlug,
      currentCategory: categoryName,
      currentSubcategory: subcategoryName,
      maxCount: 4,
      categoryDominanceCap: 2,
    },
  );
  finalItems = preview.selected;
  selectionRule = preview.selectedRule;
}
---

<RecommendationRail
    title={selectionRule === "same_subcategory" || selectionRule === "same_category" ? "Similar products" : "Browse available products"}
    subtitle={selectionRule === "same_subcategory" || selectionRule === "same_category"
      ? `More products listed in ${categoryName}.`
      : "A catalogue fallback based only on currently listed products."}
    placement="product_related"
    items={finalItems}
    showEmptyState={true}
    emptyMessage="No similar products are currently listed."
  />
