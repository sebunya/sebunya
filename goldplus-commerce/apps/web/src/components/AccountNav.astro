---
interface Props {
  active: 'overview' | 'orders' | 'loyalty' | 'rewards' | 'addresses' | 'preferences';
}
const { active } = Astro.props;

const items = [
  { key: 'overview', href: '/account', label: 'Overview' },
  { key: 'orders', href: '/account/orders', label: 'Orders' },
  { key: 'loyalty', href: '/account/loyalty', label: 'Points' },
  { key: 'rewards', href: '/account/rewards', label: 'Rewards' },
  { key: 'addresses', href: '/account/addresses', label: 'Addresses' },
  { key: 'preferences', href: '/account/preferences', label: 'Preferences' },
] as const;
---

<nav aria-label="Account sections" class="flex flex-wrap gap-2 mb-8">
  {items.map((item) => (
    <a
      href={item.href}
      aria-current={item.key === active ? 'page' : undefined}
      class={`px-4 py-2 rounded-full text-xs font-bold uppercase tracking-wider transition-all ${
        item.key === active
          ? 'bg-brand-charcoal text-white'
          : 'bg-white border border-brand-borderGrey text-brand-mutedGrey hover:text-brand-charcoal hover:border-brand-charcoal'
      }`}
    >
      {item.label}
    </a>
  ))}
</nav>
