---
import { formatUgx } from '../../lib/money';
import { availabilityLabel, type BulkQuoteBuyerView } from '../../lib/bulkQuoteView';

/**
 * One bulk quote request as its buyer sees it: reference, status in plain
 * words, and every line. Used by /bulk/submitted and /bulk/status.
 */
interface Props {
  request: BulkQuoteBuyerView;
}
const { request } = Astro.props;
const submitted = (() => {
  const t = new Date(request.createdAt).getTime();
  return Number.isFinite(t)
    ? new Date(t).toLocaleString('en-GB', { timeZone: 'Africa/Kampala', day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' })
    : '';
})();
const neededBy = request.neededBy
  ? new Date(`${request.neededBy}T00:00:00Z`).toLocaleDateString('en-GB', { timeZone: 'UTC', day: 'numeric', month: 'short', year: 'numeric' })
  : null;
const unpriced = request.totals.lineCount - request.totals.pricedLineCount;
---

<section class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6" aria-labelledby="bulk-summary-heading">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <p class="text-xs font-bold uppercase tracking-widest text-slate-500">Reference</p>
      <p id="bulk-summary-heading" class="mt-1 font-mono text-2xl font-black tracking-wider text-gray-950">{request.reference}</p>
    </div>
    <p class="rounded-full border border-slate-300 bg-slate-50 px-3 py-1 text-sm font-bold text-slate-800">{request.statusLabel}</p>
  </div>
  <p class="mt-3 text-sm leading-relaxed text-slate-700">{request.statusDetail}</p>

  <dl class="mt-5 grid grid-cols-1 gap-3 text-sm sm:grid-cols-2">
    {submitted && <div><dt class="font-bold text-slate-600">Sent</dt><dd class="text-gray-950">{submitted}</dd></div>}
    {request.businessName && <div><dt class="font-bold text-slate-600">Business</dt><dd class="text-gray-950 break-words">{request.businessName}</dd></div>}
    {request.deliveryDistrict && <div><dt class="font-bold text-slate-600">Delivery district</dt><dd class="text-gray-950">{request.deliveryDistrict}</dd></div>}
    {neededBy && <div><dt class="font-bold text-slate-600">Needed by</dt><dd class="text-gray-950">{neededBy}</dd></div>}
  </dl>

  <h2 class="mt-6 text-base font-black text-gray-950">
    {request.totals.lineCount} {request.totals.lineCount === 1 ? 'product' : 'products'}, {request.totals.totalUnits.toLocaleString('en-US')} {request.totals.totalUnits === 1 ? 'unit' : 'units'}
  </h2>
  <ul class="mt-3 divide-y divide-slate-100 border-y border-slate-100">
    {request.lines.map((line) => (
      <li class="flex flex-col gap-1 py-3 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
        <div class="min-w-0">
          <p class="font-bold text-gray-950 break-words">{line.productName}</p>
          <p class="text-xs text-slate-600">
            {line.productCode && <span class="font-mono">{line.productCode}</span>}
            {line.productCode && ' · '}
            {availabilityLabel(line.availability)}
          </p>
        </div>
        <div class="shrink-0 text-sm text-slate-800 sm:text-right">
          <p><span class="font-black">{line.quantity.toLocaleString('en-US')}</span> × {line.unitPriceUgx === null ? 'price to confirm' : formatUgx(line.unitPriceUgx)}</p>
          {line.lineTotalUgx !== null && <p class="text-xs text-slate-600">{formatUgx(line.lineTotalUgx)} at list price</p>}
        </div>
      </li>
    ))}
  </ul>

  <div class="mt-4 rounded-xl bg-slate-50 p-4 text-sm">
    <p class="font-bold text-gray-950">Estimated total at list price: {formatUgx(request.totals.estimatedTotalUgx)}</p>
    <p class="mt-1 text-slate-700">This is an estimate at our listed prices, not a bill. Our sales team confirms volume pricing, stock and delivery when they call you.</p>
    {unpriced > 0 && <p class="mt-1 text-slate-700">{unpriced} {unpriced === 1 ? 'product has' : 'products have'} no listed price. Our team will price {unpriced === 1 ? 'it' : 'them'}.</p>}
  </div>
</section>
