---
import { formatUgx } from '../../lib/money';
import type { BulkQuoteBuyerView } from '../../lib/bulkQuoteView';

/**
 * One bulk request as its buyer sees it: reference, status in plain words,
 * every line in cartons or pieces, and the budget. Bulk prices appear only
 * when the request's phone was verified (the API decides: pricesShown).
 * Used by /bulk/submitted and /bulk/status.
 */
interface Props {
  request: BulkQuoteBuyerView;
}
const { request } = Astro.props;
const submitted = (() => {
  const t = new Date(request.createdAt).getTime();
  return Number.isFinite(t)
    ? new Date(t).toLocaleString('en-GB', { timeZone: 'Africa/Kampala', day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' })
    : '';
})();
const neededBy = request.neededBy
  ? new Date(`${request.neededBy}T00:00:00Z`).toLocaleDateString('en-GB', { timeZone: 'UTC', day: 'numeric', month: 'short', year: 'numeric' })
  : null;
const t = request.totals;
const unpriced = t.lineCount - t.pricedLineCount;
const size = [
  `${t.lineCount} ${t.lineCount === 1 ? 'product' : 'products'}`,
  t.totalCartons > 0 ? `${t.totalCartons.toLocaleString('en-US')} ${t.totalCartons === 1 ? 'carton' : 'cartons'}` : null,
  t.totalUnits > 0 ? `${t.totalUnits.toLocaleString('en-US')} ${t.totalUnits === 1 ? 'piece' : 'pieces'}` : null,
].filter(Boolean).join(', ');
---

<section class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6" aria-labelledby="bulk-summary-heading">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <p class="text-xs font-bold uppercase tracking-widest text-slate-500">Reference</p>
      <p id="bulk-summary-heading" class="mt-1 font-mono text-2xl font-black tracking-wider text-gray-950">{request.reference}</p>
    </div>
    <p class="rounded-full border border-slate-300 bg-slate-50 px-3 py-1 text-sm font-bold text-slate-800">{request.statusLabel}</p>
  </div>
  <p class="mt-3 text-sm leading-relaxed text-slate-700">{request.statusDetail}</p>

  <dl class="mt-5 grid grid-cols-1 gap-3 text-sm sm:grid-cols-2">
    {submitted && <div><dt class="font-bold text-slate-600">Sent</dt><dd class="text-gray-950">{submitted}</dd></div>}
    {request.businessName && <div><dt class="font-bold text-slate-600">Business</dt><dd class="text-gray-950 break-words">{request.businessName}</dd></div>}
    {request.deliveryDistrict && <div><dt class="font-bold text-slate-600">Delivery district</dt><dd class="text-gray-950">{request.deliveryDistrict}</dd></div>}
    {neededBy && <div><dt class="font-bold text-slate-600">Needed by</dt><dd class="text-gray-950">{neededBy}</dd></div>}
    {request.budgetUgx !== null && <div><dt class="font-bold text-slate-600">Budget</dt><dd class="text-gray-950">{formatUgx(request.budgetUgx)}</dd></div>}
  </dl>

  {t.lineCount === 0 ? (
    <p class="mt-6 rounded-xl bg-slate-50 p-4 text-sm text-slate-800">You sent a budget without a list. Our team will build the list from your notes and call you with it.</p>
  ) : (
    <>
      <h2 class="mt-6 text-base font-black text-gray-950">{size}</h2>
      <ul class="mt-3 divide-y divide-slate-100 border-y border-slate-100">
        {request.lines.map((line) => (
          <li class="flex flex-col gap-1 py-3 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
            <div class="min-w-0">
              <p class="font-bold text-gray-950 break-words">{line.productName}</p>
              <p class="text-xs text-slate-600">
                {line.productCode && <span class="font-mono">{line.productCode}</span>}
                {line.productCode && ' · '}
                {line.countLabel}
                {line.aboveSelfServe && ' · our team confirms supply'}
              </p>
            </div>
            {request.pricesShown && (
              <div class="shrink-0 text-sm text-slate-800 sm:text-right">
                <p>{line.unitPriceUgx === null ? 'Price to confirm' : `${formatUgx(line.unitPriceUgx)} a piece`}</p>
                {line.lineTotalUgx !== null && <p class="font-black">{formatUgx(line.lineTotalUgx)}</p>}
              </div>
            )}
          </li>
        ))}
      </ul>

      <div class="mt-4 rounded-xl bg-slate-50 p-4 text-sm">
        {request.pricesShown ? (
          <>
            <p class="font-bold text-gray-950">Total at bulk price: {formatUgx(t.estimatedTotalUgx)}</p>
            <p class="mt-1 text-slate-700">Delivery is added when our team confirms the delivery date with you. Nothing is charged until then.</p>
            {unpriced > 0 && <p class="mt-1 text-slate-700">{unpriced} {unpriced === 1 ? 'product has' : 'products have'} no bulk price or carton size yet. Our team will price {unpriced === 1 ? 'it' : 'them'}.</p>}
          </>
        ) : (
          <p class="text-slate-700">Our team will call you with the total at bulk price and the delivery date. Nothing is charged until then.</p>
        )}
      </div>
    </>
  )}
</section>
