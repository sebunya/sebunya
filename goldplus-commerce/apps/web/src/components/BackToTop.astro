---
/**
 * Back to top: a quiet round button that appears once a visitor is more than a
 * screen down a long page, with a lime ring that fills as they scroll. It
 * returns them to the top (instantly under prefers-reduced-motion) and puts
 * keyboard focus back at the start of the page.
 *
 * Built to cost nothing it does not need: one passive scroll listener throttled
 * to animation frames, opacity/transform transitions only (composited, no layout
 * shift), hidden from the tab order and from assistive tech while invisible,
 * and lifted above the product page's sticky buy bar on phones.
 */
---
<button type="button" class="gp-totop" data-totop aria-label="Back to top" title="Back to top" tabindex="-1" aria-hidden="true">
  <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
    <path d="M12 19V5M5.5 11.5 12 5l6.5 6.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
</button>

<style>
  .gp-totop {
    --p: 0;
    --lift: 0px;
    position: fixed;
    right: max(1rem, env(safe-area-inset-right));
    bottom: calc(max(1rem, env(safe-area-inset-bottom)) + var(--lift));
    z-index: 45;
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 9999px;
    background: #0a0a0a;
    color: #93d500;
    cursor: pointer;
    box-shadow: 0 6px 22px rgba(10, 10, 10, 0.28);
    opacity: 0;
    visibility: hidden;
    transform: translateY(12px) scale(0.92);
    transition: opacity 0.22s ease, transform 0.22s ease, visibility 0s linear 0.22s;
    -webkit-tap-highlight-color: transparent;
  }
  /* The progress ring: a conic fill masked to a 2px band around the edge. */
  .gp-totop::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 2px;
    background: conic-gradient(#93d500 calc(var(--p) * 1turn), rgba(147, 213, 0, 0.18) 0);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask: linear-gradient(#000 0 0) content-box exclude, linear-gradient(#000 0 0);
    pointer-events: none;
  }
  .gp-totop[data-shown] {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition: opacity 0.22s ease, transform 0.22s ease, visibility 0s;
  }
  .gp-totop svg { position: relative; transition: transform 0.2s ease; }
  .gp-totop:hover svg { transform: translateY(-2px); }
  .gp-totop:active { transform: scale(0.94); }
  .gp-totop:focus-visible { outline: 3px solid #93d500; outline-offset: 3px; }
  @media (prefers-reduced-motion: reduce) {
    .gp-totop, .gp-totop[data-shown], .gp-totop svg { transition: none; transform: none; }
  }
  @media print { .gp-totop { display: none; } }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-totop]');
  if (btn) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    let ticking = false;
    let shown = false;

    const update = () => {
      ticking = false;
      const doc = document.documentElement;
      const max = doc.scrollHeight - window.innerHeight;
      const y = window.scrollY;
      // Only long pages earn the button: more than ~2.5 screens of content.
      const show = max > window.innerHeight * 1.5 && y > window.innerHeight * 1.2;
      if (show !== shown) {
        shown = show;
        btn.toggleAttribute('data-shown', show);
        btn.tabIndex = show ? 0 : -1;
        btn.setAttribute('aria-hidden', show ? 'false' : 'true');
      }
      if (show) {
        btn.style.setProperty('--p', String(Math.min(1, Math.max(0, y / max))));
        // Stay clear of the product page's sticky buy bar when it is showing.
        // (offsetParent is always null for a fixed element, so visibility is read
        // from its client rects: none while hidden or display:none on desktop.)
        const bar = document.querySelector<HTMLElement>('[data-pdp-buybar]:not([hidden])');
        const lift = bar && bar.getClientRects().length > 0 ? bar.offsetHeight : 0;
        btn.style.setProperty('--lift', `${lift}px`);
      }
    };
    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    update();

    const toTop = () => {
      window.scrollTo({ top: 0, behavior: reduced.matches ? 'auto' : 'smooth' });
      // Keyboard and screen-reader users land at the start of the page too.
      const start = document.querySelector<HTMLElement>('a[href="#main"]') ?? document.body;
      start.focus({ preventScroll: true });
    };
    btn.addEventListener('click', toTop);
    // The footer's plain "#top" link works without script; with it, it glides the same way.
    document.querySelectorAll<HTMLAnchorElement>('a[href="#top"]').forEach((a) =>
      a.addEventListener('click', (e) => {
        e.preventDefault();
        toTop();
      }),
    );
  }
</script>
