     only about fifteen minutes across the whole year, so a fixed split is
     accurate here in a way it would not be at higher latitudes. Reading the
     device clock means a visitor in London or Dubai still gets their own
     local day or night. ?mode=day / ?mode=night forces it for QA. */
  (function(){
    var hero = box.closest('.gp-hero') || box.parentNode;
    var DAY_START = 6.5;    // 06:30 — first light in Kampala
    var DAY_END   = 18.75;  // 18:45 — dusk

    function current(){
      var d = new Date(), h = d.getHours() + d.getMinutes()/60;
      return (h >= DAY_START && h < DAY_END) ? 'day' : 'night';
    }
    function apply(m){
      if (hero.getAttribute('data-mode') !== m) hero.setAttribute('data-mode', m);
    }
    var forced = qs('mode');
    apply(forced === 'day' || forced === 'night' ? forced : current());

    // a session can outlast dusk; re-check quietly, and the CSS transition
    // makes the change a slow fade rather than a jump
    if (forced !== 'day' && forced !== 'night'){
      setInterval(function(){ apply(current()); }, 120000);
      document.addEventListener('visibilitychange', function(){
        if (!document.hidden) apply(current());
      });
    }
  })();

  /* ---------------- flash-sale countdown (label derived from the clock) ---------------- */
  var cd = document.getElementById('gpCountdown');
  if (cd && CTX.saleLive){
    var o = {}; ['d','h','m','s'].forEach(function(k){ o[k] = cd.querySelector('[data-cd="'+k+'"]'); });
    var kick = document.getElementById('gpFlashKicker'), pad = function(n){ return ('0'+n).slice(-2); };
    var label = function(t){
      var d = Math.floor(t/86400);
      if (d >= 2) return 'Flash sale · ' + d + ' days left';
      if (t > 86400) return 'Flash sale · under 48 hours';
      if (t > 3600) return 'Flash sale · final hours';
      return 'Flash sale · ending now';
    };
    var beat = function(){
      var ms = saleEnd - Date.now();
      if (ms <= 0){ clearInterval(tm); cd.style.display='none'; if (kick) kick.textContent='Guaranteed authenticity'; return; }
      var t = Math.floor(ms/1000);
      o.d.textContent = pad(Math.floor(t/86400));
      o.h.textContent = pad(Math.floor(t%86400/3600));
      o.m.textContent = pad(Math.floor(t%3600/60));
      var sec = pad(t%60);
      if (o.s.textContent !== sec){
        o.s.textContent = sec;
        o.s.style.animation = 'none'; void o.s.offsetWidth; o.s.style.animation = '';
      }
      if (kick) kick.textContent = label(t);
    };
    beat(); var tm = setInterval(beat, 1000);
  } else if (cd){ cd.style.display = 'none'; }

  /* ---------------- same-day cut-off ---------------- */
  var cut = document.getElementById('gpCutoffText');
  if (cut){
    var end = new Date(); end.setHours(CONFIG.cutoffHour,0,0,0);
    var mins = Math.floor((end - Date.now())/60000);
    if (CTX.day === 0) cut.textContent = 'Closed Sunday — ordering now ships Monday';
    else if (mins > 90) cut.textContent = Math.floor(mins/60) + 'h ' + (mins%60) + 'm left for today\u2019s run';
    else if (mins > 0)  cut.textContent = mins + ' minutes left for today\u2019s run';
    else cut.textContent = 'Today\u2019s run has left — order now for tomorrow';
  }

  /* ---------------- copy code ---------------- */
  var chip = document.getElementById('gpCode');
  if (chip) chip.addEventListener('click', function(){
    var st = document.getElementById('gpCodeState');
    var done = function(){ st.textContent='Copied'; setTimeout(function(){ st.textContent='Copy'; },2200); };
    if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(chip.getAttribute('data-code')).then(done,done);
    else done();
  });

  /* ---------------- scratch card ---------------- */
  (function(){
    var card = document.getElementById('gpScratch'); if (!card) return;
    var cv = document.getElementById('gpFoil'), ctx = cv.getContext('2d');
    var cta = document.getElementById('gpScratchCta'), sub = document.getElementById('gpScratchSub');
    var liveP = document.getElementById('gpPrizeLive');
    var saved = null; try { saved = JSON.parse(store.get(CONFIG.keys.scratch) || 'null'); } catch(e){}
    function weighted(){
      var sum = CONFIG.prizes.reduce(function(a,p){ return a+p.w; },0), r = Math.random()*sum;
      for (var i=0;i<CONFIG.prizes.length;i++){ r -= CONFIG.prizes[i].w; if (r<=0) return CONFIG.prizes[i]; }
      return CONFIG.prizes[0];
    }
    var prize = (saved && saved.code) ? saved : weighted();
    document.getElementById('gpPrizeN').textContent = prize.pct + '%';
    document.getElementById('gpPrizeC').textContent = 'CODE ' + prize.code;
    var painted=false, drawing=false, done=false;

    function paintFoil(){
      var r = card.getBoundingClientRect(); if (!r.width || !r.height) return false;
      var dpr = Math.min(window.devicePixelRatio||1,2);
      cv.width = Math.round(r.width*dpr); cv.height = Math.round(r.height*dpr);
      ctx.setTransform(dpr,0,0,dpr,0,0);
      var g = ctx.createLinearGradient(0,0,r.width,r.height);
      g.addColorStop(0,'#6F9E00'); g.addColorStop(.32,'#B9E84A'); g.addColorStop(.5,'#DFF59B');
      g.addColorStop(.68,'#B9E84A'); g.addColorStop(1,'#6F9E00');
      ctx.globalCompositeOperation='source-over'; ctx.fillStyle=g; ctx.fillRect(0,0,r.width,r.height);
      ctx.fillStyle='rgba(6,48,31,.3)';
      for (var i=-r.height;i<r.width;i+=13) ctx.fillRect(i,0,3,r.height);
      ctx.fillStyle='rgba(6,48,31,.85)'; ctx.textAlign='center';
      ctx.font='700 15px Poppins, system-ui, sans-serif'; ctx.fillText('GOLDPLUS', r.width/2, r.height/2-6);
      ctx.font='700 11px Poppins, system-ui, sans-serif'; ctx.fillText('SCRATCH TO REVEAL', r.width/2, r.height/2+14);
      painted = true; return true;
    }
    function clearAll(){
      if (done) return; done = true;
      cv.setAttribute('data-cleared',''); card.style.cursor='default';
      card.setAttribute('aria-label', prize.pct + '% member discount revealed. Code ' + prize.code + '.');
      // prize.pct is CMS data — never innerHTML. Set text; keep a static arrow node.
      cta.textContent = 'Claim ' + prize.pct + '% with rewards ';
      var _arr = document.createElement('span'); _arr.setAttribute('aria-hidden','true'); _arr.textContent = '\u2192';
      cta.appendChild(_arr);
      cta.setAttribute('href','/rewards?promo=' + prize.code);
      sub.textContent = 'That ' + prize.pct + '% is yours — open a free rewards account to lock it to your next order.';
      if (liveP) liveP.textContent = 'You revealed ' + prize.pct + '% off. Code ' + prize.code + '.';
      store.set(CONFIG.keys.scratch, JSON.stringify({pct:prize.pct,code:prize.code,revealed:true}));
    }
    function at(e){
      if (!painted || done) return;
      var r = cv.getBoundingClientRect();
      ctx.globalCompositeOperation='destination-out';
      ctx.beginPath(); ctx.arc(e.clientX-r.left, e.clientY-r.top, 24, 0, Math.PI*2); ctx.fill();
    }
    function cleared(){
      if (!cv.width) return 0;
      var d; try { d = ctx.getImageData(0,0,cv.width,cv.height).data; } catch(err){ return 0; }
      var step=4*12, empty=0, n=0;
      for (var i=3;i<d.length;i+=step){ n++; if (d[i]<24) empty++; }
      return n ? empty/n : 0;
    }
    card.addEventListener('pointerdown', function(e){
      if (done) return;
      if (!painted && !paintFoil()) return;
      drawing = true; setPlaying(false);
      card.setPointerCapture && card.setPointerCapture(e.pointerId);
      at(e); e.preventDefault();
    });
    card.addEventListener('pointermove', function(e){ if (!drawing) return; at(e); if (cleared() > .42) clearAll(); });
    ['pointerup','pointercancel','pointerleave'].forEach(function(t){ card.addEventListener(t, function(){ drawing=false; }); });
    card.addEventListener('keydown', function(e){ if (e.key==='Enter'||e.key===' '){ e.preventDefault(); setPlaying(false); clearAll(); } });

    if ((saved && saved.revealed) || reduce) clearAll();
    else {
      if (!paintFoil()) requestAnimationFrame(paintFoil);
      window.addEventListener('resize', function(){ if (!done){ painted=false; paintFoil(); } });
    }
  })();

  // First render: immediate, from LOCAL context — controls and countdown live at t=0.
  applyChoice(computeChoice(CTX), null);

  /* ---------------- Task 3: enhancements + measurement ----------------
     The full engine has ALREADY rendered and is rotating from local context —
     nothing below is on the paint path. These are pure enhancements, each
     gated by consent, and each degrades to nothing on failure. They never
     reshuffle the visible rail (that would be worse UX than the marginal gain);
     they refine the arch image, deep-link a CTA, and fill the loyalty meter. */
  function heroSegment(){ return CTX.isRegular ? 'regular' : CTX.isReturning ? 'returning' : CTX.isNew ? 'new' : 'unknown'; }

  (function heroEnhance(){
    // The server fetch sends the visit token and profiles the visitor: it runs
    // ONLY with personalization consent. Without it the hero keeps its
    // non-profiled local order and default imagery.
    if (heroOptedOut('personalization')) return;
    var ctl;
    try { ctl = (window.AbortSignal && AbortSignal.timeout) ? AbortSignal.timeout(4000) : undefined; } catch(e){}
    fetch('/api/hero/signals', { credentials: 'same-origin', signal: ctl })
      .then(function(r){ return r.ok ? r.json() : null; })
      .then(function(j){
        var d = j && j.success && j.data; if (!d) return;

        // Fold the real signals into the context and RE-SELECT — this is where
        // personalisation stops being cosmetic and starts choosing slides.
        // The currently-visible slide is preserved, so only the deck behind it
        // rearranges; nothing the visitor is looking at jumps.
        var changed = false;
        if (typeof d.hasOrdered === 'boolean' && d.hasOrdered !== CTX.hasOrdered){ CTX.hasOrdered = d.hasOrdered; changed = true; }
        var cats = (d.categoryAffinity || []).map(function(x){ return x && x.categorySlug; }).filter(Boolean);
        if (cats.length && cats.join(',') !== CTX.serverCats.join(',')){ CTX.serverCats = cats; changed = true; }
        if (d.stockBySlug) CTX.stockBySlug = d.stockBySlug;
        if (changed){
          var keep = slides[index] && slides[index].getAttribute('data-id');
          applyChoice(computeChoice(CTX), keep);
        }

        // A: preferred in-stock product for the arch on agnostic slides.
        if (d.preferredProduct && d.preferredProduct.imageUrl){ heroPref = d.preferredProduct; placeArch(); }
        // A: deep-link the browse CTAs into the visitor's category (visual only).
        var cat = (d.categoryAffinity && d.categoryAffinity[0] && d.categoryAffinity[0].categorySlug) || null;
        if (cat){
          ['range','newarrivals'].forEach(function(id){
            var s = null; for (var i=0;i<slides.length;i++){ if (slides[i].getAttribute('data-id')===id){ s=slides[i]; break; } }
            if (!s) return; var a = s.querySelector('.gp-hero__cta');
            if (a && a.getAttribute('href') && a.getAttribute('href').indexOf('/shop') === 0) a.setAttribute('href', '/shop?category=' + encodeURIComponent(cat));
          });
        }
        // C: real loyalty balance in the meter (only if the slide is shown).
        if (d.loyalty){
          var pts = document.querySelector('.gp-hero__meter-pts'), goal = document.querySelector('.gp-hero__meter-goal');
          if (pts) pts.textContent = Number(d.loyalty.points||0).toLocaleString('en-UG') + ' pts';
          if (goal && typeof d.loyalty.goalRemaining === 'number') goal.textContent = d.loyalty.goalRemaining > 0 ? (d.loyalty.goalRemaining + ' to ' + (d.loyalty.tierLabel||'next')) : (d.loyalty.tierLabel||'');
        }
      })
      .catch(function(){});
  })();

  (function heroInstrument(){
    // No analytics consent → measure nothing. Silence is the correct default.
    if (heroOptedOut('analytics')) return;
    var seg = heroSegment(), impressed = {}, impTimer = null;
    function emit(type, key, pos){
      try {
        var body = JSON.stringify({ eventType: type, slideKey: key, position: pos, segment: seg });
        if (type === 'CLICK' && navigator.sendBeacon){ navigator.sendBeacon('/api/hero/events', new Blob([body], {type:'application/json'})); return; }
        fetch('/api/hero/events', { method:'POST', headers:{'Content-Type':'application/json'}, credentials:'same-origin', keepalive:true, body:body }).catch(function(){});
      } catch(e){}
    }
    function armImpression(){
      if (impTimer) clearTimeout(impTimer);
      var s = slides[index]; if (!s) return;
      var key = s.getAttribute('data-id'), pos = index + 1;
      if (impressed[key]) return;
      impTimer = setTimeout(function(){
        if (slides[index] && slides[index].getAttribute('data-id') === key && !document.hidden){ impressed[key] = true; emit('IMPRESSION', key, pos); }
      }, 1000);
    }
    var _paint = paint; paint = function(){ _paint(); armImpression(); };
    box.addEventListener('click', function(e){
      var cta = e.target && e.target.closest && e.target.closest('.gp-hero__cta'); if (!cta) return;
      var s = slides[index]; if (s) emit('CLICK', s.getAttribute('data-id'), index + 1);
    });
    armImpression();
  })();
})();
</script>
