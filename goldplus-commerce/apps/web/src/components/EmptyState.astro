---
interface Props {
  title: string;
  message?: string;
  hint?: string;
}
const { title, message, hint } = Astro.props;
---
<div class="border border-dashed border-gray-300 rounded-2xl p-10 md:p-12 text-center bg-white">
  <p class="text-lg font-bold text-brand-dark mb-2">{title}</p>
  {message && <p class="text-sm text-gray-600 max-w-md mx-auto leading-relaxed">{message}</p>}
  {hint && <p class="mt-3 text-xs text-gray-400 italic">{hint}</p>}
  <div class="mt-6"><slot /></div>
</div>
