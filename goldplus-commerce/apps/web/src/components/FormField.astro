---
type FieldType = 'text' | 'email' | 'tel' | 'url' | 'number' | 'password' | 'textarea' | 'date';

interface Props {
  id: string;
  name: string;
  label: string;
  type?: FieldType;
  required?: boolean;
  placeholder?: string;
  helperText?: string;
  defaultValue?: string;
  rows?: number;
  pattern?: string;
  inputmode?: string;
  autocomplete?: string;
  errorMessage?: string;
}

const {
  id, name, label, type = 'text', required, placeholder,
  helperText, defaultValue, rows = 4, pattern, inputmode, autocomplete, errorMessage,
} = Astro.props;

const baseClass = 'w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-lg focus:ring-2 focus:ring-brand-green focus:border-brand-green outline-none transition-colors';
const errorClass = errorMessage ? 'border-red-300 ring-2 ring-red-100' : '';
const describedBy = helperText ? `${id}-help` : undefined;
---
<div>
  <label for={id} class="block text-sm font-bold text-brand-dark mb-2 flex items-center gap-1">
    <slot name="label">
      {label}
    </slot>
    {required && <span class="text-red-600 ml-1" aria-hidden="true">*</span>}
  </label>
  {type === 'textarea' ? (
    <textarea
      id={id}
      name={name}
      rows={rows}
      required={required}
      placeholder={placeholder}
      class={`${baseClass} ${errorClass}`}
      aria-describedby={describedBy}
      aria-invalid={errorMessage ? 'true' : undefined}
    >{defaultValue}</textarea>
  ) : (
    <input
      id={id}
      type={type}
      name={name}
      required={required}
      placeholder={placeholder}
      value={defaultValue}
      pattern={pattern}
      inputmode={inputmode}
      autocomplete={autocomplete}
      class={`${baseClass} ${errorClass}`}
      aria-describedby={describedBy}
      aria-invalid={errorMessage ? 'true' : undefined}
    />
  )}
  {helperText && <p id={describedBy} class="text-xs text-gray-500 mt-1">{helperText}</p>}
  {errorMessage && <p class="text-xs text-red-600 mt-1 font-bold">{errorMessage}</p>}
</div>
