---
import { giftCardTheme, logoUrl } from '../lib/giftCardThemes';
import { CARD_PLACEHOLDER, asCardNote, giftCardLabel, greetingParts } from '../lib/giftCardFaceText';
import { formatUgx } from '../lib/money';

/**
 * A GoldPlus gift card (redesign 2026-10-21, from the rebrand book). One structure for all 14 occasions:
 *   brand area (the original logo) · greeting · "To" + name + note grouped · the occasion's illustration in its own
 *   area · an information band (From and the amount) that reads as the gift's ribbon.
 * Black-led cards: art on black, green band with black text. White-led cards: art on a green field, black band.
 * With a photo, the photo takes the art area (wide) or sits above the note (a phone-width card), never under text.
 * The card grows instead of clipping when the note is long. The buy page redraws this same markup (data-gc-*).
 */
interface Props {
  theme?: string | null;
  amountUgx: number;
  toName?: string | null;
  fromName?: string | null;
  message?: string | null;
  /** A same-site URL of the buyer's photo, when they added one. */
  photoUrl?: string | null;
  /** The masked code under the amount, where the screen needs it ("GPGC-••••-••••-NB8B"). */
  masked?: string | null;
  class?: string;
}
const { theme: themeKey, amountUgx, toName, fromName, message, photoUrl, masked, class: extra = '' } = Astro.props;
const t = giftCardTheme(themeKey);
const { lines, long: longWord } = greetingParts(t.headline);
const note = asCardNote(message);
const label = giftCardLabel({ headline: t.headline, to: toName, from: fromName, amount: formatUgx(amountUgx), photo: Boolean(photoUrl), note });
---
<div class={`gcf-shell ${extra}`}>
<div
  class={`gcf gcf-${t.variant} ${photoUrl ? 'gcf-has-photo' : ''}`}
  data-gc-face
  data-theme={t.key}
  data-variant={t.variant}
  role="img"
  aria-label={label}
>
  <div class="gcf-top">
    <div class="gcf-words">
      <img class="gcf-logo" src={logoUrl(t.logo)} alt="" width="120" height="34" data-gc-logo />
      <p class={`gcf-greet ${longWord ? 'gcf-greet-long' : ''}`} data-gc-headline>{lines.map((l, i) => <>{i > 0 && <br />}{l}</>)}</p>
      <div class="gcf-person">
        <p class="gcf-label">To</p>
        <p class="gcf-name" data-gc-to>{toName || CARD_PLACEHOLDER.to}</p>
        <p class={`gcf-note ${note ? '' : 'gcf-hidden'}`} data-gc-message>{note}</p>
      </div>
    </div>
    <div class="gcf-art">
      <img class={`gcf-illustration ${photoUrl ? 'gcf-hidden' : ''}`} src={t.art} alt="" width="200" height="200" data-gc-art />
      <img class={`gcf-photo ${photoUrl ? '' : 'gcf-hidden'}`} src={photoUrl ?? undefined} alt={photoUrl ? 'Photo added by the sender' : ''} width="540" height="540" data-gc-photo />
    </div>
  </div>
  <div class="gcf-band">
    <p class="gcf-from"><span class="gcf-label">From</span><span data-gc-from>{fromName || CARD_PLACEHOLDER.from}</span></p>
    <div class="gcf-value">
      <p class="gcf-amount" data-gc-amount>{formatUgx(amountUgx)}</p>
      <slot>{masked && <p class="gcf-masked">{masked}</p>}</slot>
    </div>
  </div>
</div>
</div>

<style>
  /* Each size is given twice: in px for a browser without container units (older Android WebViews), then in cqi.
     The shell measures the width the card has (cqi units and the phone-width rule below read it) and carries the
     card's edge. The card clips its corners with clip-path, not overflow: with overflow hidden, aspect-ratio would
     fix the height and a long note would run under the band; this way the ratio is a minimum and the card grows. */
  .gcf-shell { container-type: inline-size; width: 100%; border-radius: 14px; box-shadow: 0 0 0 1px rgba(0, 0, 0, .08), 0 2px 6px rgba(0, 0, 0, .08); }
  .gcf {
    --gcf-green: #96CC06;
    font-family: 'Montserrat', 'Montserrat Fallback', Arial, sans-serif;
    display: grid;
    grid-template-rows: 1fr auto;
    width: 100%;
    aspect-ratio: 1.586 / 1;
    border-radius: 14px;
    clip-path: inset(0 round 14px);
  }
  .gcf-dark { background: #000; color: #fff; }
  .gcf-light { background: #fff; color: #000; }
  .gcf-top { display: grid; grid-template-columns: minmax(0, 1fr) 40%; }
  .gcf-words { display: flex; flex-direction: column; padding: 16px 5px 13px 16px; padding: 5cqi 1.5cqi 4cqi 5cqi; min-width: 0; }
  .gcf-logo { height: 17px; height: clamp(15px, 5.2cqi, 26px); width: auto; align-self: flex-start; }
  .gcf-greet { margin: 11px 0 0; margin: 3.4cqi 0 0; font-weight: 800; font-size: 21px; font-size: clamp(19px, 6.6cqi, 36px); line-height: 1.02; letter-spacing: -.015em; hyphens: manual; }
  .gcf-greet-long { font-size: 17px; font-size: clamp(16px, 5.4cqi, 30px); }
  .gcf-person { margin-top: auto; padding-top: 11px; padding-top: 3.4cqi; display: grid; gap: 3px; gap: .8cqi; }
  .gcf-label { margin: 0; font-size: 9px; font-size: clamp(8px, 2.6cqi, 11px); font-weight: 600; letter-spacing: .16em; text-transform: uppercase; opacity: .62; }
  .gcf-name { margin: 0; font-weight: 700; font-size: 15px; font-size: clamp(14px, 4.6cqi, 24px); line-height: 1.15; overflow-wrap: anywhere; }
  .gcf-note { margin: 2px 0 0; margin: .6cqi 0 0; font-weight: 500; font-size: 12px; font-size: clamp(12px, 3.7cqi, 17px); line-height: 1.4; opacity: .88; overflow-wrap: anywhere; }
  .gcf-art { position: relative; display: grid; place-items: end center; padding: 13px 10px 0; padding: 4cqi 3cqi 0; min-width: 0; }
  .gcf-light .gcf-art { background: var(--gcf-green); place-items: center; padding: 10px; padding: 3cqi; }
  .gcf-illustration { width: 100%; height: auto; }
  /* The photo is always the square the sender chose (never re-cropped), set in the card's colour field. */
  .gcf-photo { display: block; width: 100%; height: auto; aspect-ratio: 1 / 1; object-fit: cover; border-radius: 8px; }
  .gcf-has-photo .gcf-art { place-items: center; padding: 13px 13px 13px 6px; padding: 4cqi 4cqi 4cqi 2cqi; }
  .gcf-band { display: flex; align-items: center; justify-content: space-between; gap: 10px; gap: 3cqi; padding: 9px 16px; padding: 2.6cqi 5cqi; }
  .gcf-dark .gcf-band { background: var(--gcf-green); color: #000; }
  .gcf-light .gcf-band { background: #000; color: #fff; }
  .gcf-from { margin: 0; display: flex; align-items: baseline; gap: 7px; gap: 2cqi; min-width: 0; font-weight: 600; font-size: 11px; font-size: clamp(11px, 3.4cqi, 16px); }
  .gcf-from [data-gc-from] { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .gcf-band .gcf-label { opacity: .7; }
  .gcf-value { text-align: right; }
  .gcf-amount { margin: 0; font-weight: 800; font-size: 14px; font-size: clamp(13px, 4.4cqi, 22px); letter-spacing: .01em; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .gcf-light .gcf-amount { color: var(--gcf-green); }
  .gcf-masked { margin: 1px 0 0; margin: .4cqi 0 0; font-family: ui-monospace, monospace; font-size: 9px; font-size: clamp(9px, 2.6cqi, 12px); opacity: .75; letter-spacing: .06em; }
  .gcf-hidden { display: none; }
  /* A photo on a phone-width card: stacked, the photo first in its own colour field, the words below it. */
  @container (max-width: 420px) {
    .gcf-has-photo .gcf-top { grid-template-columns: 1fr; }
    .gcf-has-photo .gcf-art { order: -1; padding: 6cqi 0; background: var(--gcf-green); }
    .gcf-has-photo .gcf-photo { width: 64%; }
    .gcf-has-photo .gcf-words { padding-top: 5cqi; }
  }
</style>
