---
import ConsentToggle from './ConsentToggle.astro';

interface Props {
  preferences: any;
}
const { preferences } = Astro.props;
---

<form method="POST" class="max-w-2xl">
  <div class="mb-10">
    <h2 class="text-lg font-black text-brand-charcoal mb-4 tracking-tight">Privacy and consent</h2>
    <p class="text-sm text-brand-mutedGrey mb-6">Choose how we use your data. Some cookies are needed for the site to work, like your cart and staying signed in.</p>
    
    <ConsentToggle 
      id="consent_essential" 
      name="consent.essential" 
      label="Essential" 
      description="Needed for checkout, security and signing in. These cannot be switched off." 
      checked={true} 
      required={true} 
    />
    <ConsentToggle 
      id="consent_analytics" 
      name="consent.analytics" 
      label="Analytics cookies in your browser" 
      description="Lets Google Analytics store cookies on this device. GoldPlus always keeps a server-side record of visits and orders (including your IP address and browser) to run the shop and personalise it; switching this off stops the cookies, not that record." 
      checked={preferences.consent?.analytics ?? true} 
    />
    <ConsentToggle 
      id="consent_advertising" 
      name="consent.advertising" 
      label="Advertising and paid social" 
      description="When this is on, your purchases and the products you view or add to your basket are shared with the advertising platforms GoldPlus uses (listed in the privacy policy), to measure our campaigns. Switch it off to stop that." 
      checked={preferences.consent?.advertising ?? true} 
    />
    <ConsentToggle 
      id="consent_personalization" 
      name="consent.personalization" 
      label="Personalisation" 
      description="Product suggestions based on what you browse and buy." 
      checked={preferences.consent?.personalization ?? true} 
    />
  </div>

  <div class="mb-10">
    <h2 class="text-lg font-black text-brand-charcoal mb-4 tracking-tight">How would you like us to contact you?</h2>
    <p class="text-sm text-brand-mutedGrey mb-6">We only contact you about your orders and the questions you send us. GoldPlus does not send marketing messages.</p>

    <ConsentToggle 
      id="channel_email" 
      name="channels.email" 
      label="Email updates" 
      description="Order receipts and delivery updates by email." 
      checked={preferences.channels?.email ?? true} 
    />
    <ConsentToggle 
      id="channel_sms" 
      name="channels.sms" 
      label="SMS messages" 
      description="Delivery alerts and important order updates by SMS." 
      checked={preferences.channels?.sms ?? true} 
    />
    <ConsentToggle 
      id="channel_whatsapp" 
      name="channels.whatsapp" 
      label="WhatsApp" 
      description="Chat with support and get order updates on WhatsApp." 
      checked={preferences.channels?.whatsapp ?? true} 
    />
  </div>

  <div class="border-t border-brand-borderGrey pt-6">
    <button type="submit" class="bg-brand-charcoal text-white font-bold px-6 py-3 rounded-xl hover:bg-black transition-colors">
      Save preferences
    </button>
  </div>
</form>
