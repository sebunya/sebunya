---
/**
 * Basket reminders (0210): one text when the customer leaves items in their
 * basket, only if they asked for it. Off unless they tick the box themselves.
 * Same shape as the WhatsApp offers section; an unreadable state is never
 * shown as "off".
 */
interface Props {
  status: {
    status: 'OPTED_IN' | 'NOT_OPTED_IN' | 'WITHDRAWN' | 'BLOCKED';
    since: string | null;
    phoneMasked: string | null;
    hasPhone: boolean;
    covered: boolean;
    coverageReason: string;
    copy: string;
    copyVersionId: string;
  } | null;
}
const { status } = Astro.props;
const since = status?.since ? new Date(status.since).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Africa/Kampala' }) : null;
---

<section class="mb-10 rounded-2xl border border-slate-200 bg-white p-6" aria-labelledby="basket-reminders-title">
  <p class="text-xs font-black uppercase tracking-wider text-brand-primaryInk">Basket reminders</p>
  <h2 id="basket-reminders-title" class="mt-2 text-lg font-black text-brand-charcoal">A text when you leave something in your basket</h2>
  <p class="mt-3 text-sm leading-relaxed text-slate-600">
    One text, a few hours after you leave items in your basket, at most once a week. Messages about an order you placed are not affected by this.
  </p>

  {!status && (
    <p class="mt-4 rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900">
      We could not load this setting just now, so nothing is shown as on or off. Please reload the page in a moment.
    </p>
  )}

  {status && status.status === 'OPTED_IN' && (
    <div class="mt-4 grid gap-3">
      <p class="text-sm text-slate-800"><strong>On</strong>{since ? ` since ${since}` : ''}{status.phoneMasked ? `, for ${status.phoneMasked}` : ''}.</p>
      {!status.covered && status.coverageReason === 'PHONE_CHANGED_SINCE_OPT_IN' && (
        <p class="rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900">Your phone number changed after you said yes, so no reminder goes to the new number unless you switch this off and on again.</p>
      )}
      {!status.covered && status.coverageReason === 'SUPPRESSED' && (
        <p class="rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900">You asked us to stop texting you, so no basket reminders go out. Contact us if that is not what you want.</p>
      )}
      <form method="POST">
        <input type="hidden" name="formKind" value="basket-reminders" />
        <input type="hidden" name="requested" value="withdrawn" />
        <button type="submit" class="min-h-11 rounded-xl border border-slate-300 bg-white px-6 py-3 text-sm font-black text-slate-900">Switch basket reminders off</button>
      </form>
    </div>
  )}

  {status && status.status === 'BLOCKED' && (
    <p class="mt-4 text-sm text-slate-700">Basket reminders are switched off for this account. <a href="/support" class="font-bold underline">Contact support</a> if you think that is wrong.</p>
  )}

  {status && (status.status === 'NOT_OPTED_IN' || status.status === 'WITHDRAWN') && (
    status.hasPhone ? (
      <form method="POST" class="mt-4 grid gap-4">
        <input type="hidden" name="formKind" value="basket-reminders" />
        <input type="hidden" name="requested" value="granted" />
        <input type="hidden" name="copyVersionId" value={status.copyVersionId} />
        <p class="text-sm text-slate-800"><strong>Off.</strong> GoldPlus sends you no basket reminders.</p>
        <label class="flex gap-3 rounded-xl border border-slate-200 bg-slate-50 p-4 text-sm text-slate-800">
          <input type="checkbox" name="confirmation" value="yes" required class="mt-1 h-5 w-5" />
          <span>{status.copy} {status.phoneMasked && <span class="block mt-1 text-slate-600">Number on your account: {status.phoneMasked}</span>}</span>
        </label>
        <button type="submit" class="justify-self-start min-h-11 rounded-xl bg-slate-950 px-6 py-3 text-sm font-black text-white">Switch basket reminders on</button>
      </form>
    ) : (
      <p class="mt-4 text-sm text-slate-700">Off. To get basket reminders, add a Ugandan phone number to your account first.</p>
    )
  )}
</section>
