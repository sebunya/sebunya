---
interface Props {
  enabled: boolean;
}
const { enabled } = Astro.props;
---

<section class="mb-10 rounded-2xl border border-slate-200 bg-slate-50 p-6" aria-labelledby="canonical-consent-title">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <p class="text-xs font-black uppercase tracking-wider text-brand-primary">Canonical consent P0</p>
      <h2 id="canonical-consent-title" class="mt-2 text-lg font-black text-brand-charcoal">Purpose-specific communication choice</h2>
    </div>
    <span class:list={[
      "rounded-full border px-3 py-1 text-[10px] font-black uppercase tracking-wider",
      enabled ? "border-blue-200 bg-blue-50 text-blue-800" : "border-amber-200 bg-amber-50 text-amber-800",
    ]}>{enabled ? "Gated UAT only" : "Not live"}</span>
  </div>

  <p class="mt-4 text-sm leading-relaxed text-slate-600">
    This control records one explicit purpose and channel at a time. It never activates email, SMS or WhatsApp delivery.
  </p>

  <form method="POST" class="mt-6 grid gap-4">
    <input type="hidden" name="formKind" value="canonical-consent" />
    <input type="hidden" name="purpose_key" value="marketing_offers_campaigns" />
    <input type="hidden" name="copy_version_id" value="account-consent-p0-v1" />

    <label class="grid gap-2 text-sm font-bold text-slate-800">
      Channel
      <select name="channel_key" required disabled={!enabled} class="rounded-xl border border-slate-300 bg-white px-4 py-3">
        <option value="email">Email</option>
        <option value="sms">SMS</option>
        <option value="whatsapp">WhatsApp</option>
      </select>
    </label>

    <fieldset disabled={!enabled} class="grid gap-3">
      <legend class="text-sm font-bold text-slate-800">Choice</legend>
      <label class="flex gap-3 rounded-xl border border-slate-200 bg-white p-4 text-sm text-slate-700">
        <input type="radio" name="requested_state" value="granted" required />
        <span><strong class="block text-slate-950">Allow optional GoldPlus offers</strong>For the selected channel only. No send is activated by saving.</span>
      </label>
      <label class="flex gap-3 rounded-xl border border-slate-200 bg-white p-4 text-sm text-slate-700">
        <input type="radio" name="requested_state" value="withdrawn" required />
        <span><strong class="block text-slate-950">Withdraw this optional choice</strong>Withdrawal remains separate from necessary service communication.</span>
      </label>
    </fieldset>

    <button type="submit" disabled={!enabled} class="justify-self-start rounded-xl bg-slate-950 px-6 py-3 text-sm font-black text-white disabled:cursor-not-allowed disabled:bg-slate-400">
      {enabled ? "Save purpose-specific choice" : "Canonical saving is not live"}
    </button>
  </form>
</section>
