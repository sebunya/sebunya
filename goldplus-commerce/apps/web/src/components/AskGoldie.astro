---
/**
 * Inline "Ask Goldie" questions, placed in the page where the decision is
 * being made (the product page, under the key facts). The pattern every
 * leading shop assistant shares (Amazon's Rufus suggests product-specific
 * questions on the listing itself): user-initiated, in the content flow,
 * covering nothing. Each chip opens Goldie and asks that question.
 * Rendered only when the assistant is enabled; a page without Goldie shows
 * nothing rather than a dead button.
 */
import { assistantEnabled } from '../lib/assistant';
import type { GoldieQuestion } from '../lib/goldieQuestions';
/** Each chip shows a short label and sends the full question (which names the product). */
interface Props { questions: GoldieQuestion[]; source: string; class?: string }
const { questions, source, class: cls = '' } = Astro.props;
const enabled = assistantEnabled() && questions.length > 0;
---
{enabled && (
  <div class={`gp-askgoldie ${cls}`} data-askgoldie={source}>
    <span class="gp-askgoldie__label"><span class="gp-askgoldie__avatar" aria-hidden="true">G</span>Ask Goldie</span>
    <div class="gp-askgoldie__chips">
      {questions.map((q) => (<button type="button" data-ask={q.ask} aria-label={q.ask}>{q.label}</button>))}
    </div>
  </div>
)}

<style is:global>
  .gp-askgoldie { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem .75rem; }
  .gp-askgoldie__label { display: inline-flex; align-items: center; gap: .4rem; font-size: .72rem; font-weight: 900; letter-spacing: .04em; text-transform: uppercase; color: #456b00; }
  .gp-askgoldie__avatar { width: 22px; height: 22px; display: grid; place-items: center; border-radius: 9999px; background: #93d500; color: #0a0a0a; font-weight: 900; font-size: .7rem; letter-spacing: 0; text-transform: none; }
  .gp-askgoldie__chips { display: flex; flex-wrap: wrap; gap: .4rem; }
  .gp-askgoldie__chips button { border: 1.5px solid #456b00; background: #fff; color: #456b00; border-radius: 9999px; padding: .4rem .8rem; font: inherit; font-size: .78rem; font-weight: 800; cursor: pointer; min-height: 36px; transition: background .15s, color .15s; }
  .gp-askgoldie__chips button:hover { background: #456b00; color: #fff; }
  .gp-askgoldie__chips button:focus-visible { outline: 3px solid #93d500; outline-offset: 2px; }
</style>

<script>
  document.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement | null)?.closest<HTMLButtonElement>('.gp-askgoldie [data-ask]');
    if (!b) return;
    const source = b.closest<HTMLElement>('[data-askgoldie]')?.dataset.askgoldie || 'inline';
    document.dispatchEvent(new CustomEvent('gp-assistant:ask', { detail: { question: b.dataset.ask || '', source } }));
  });
</script>
