---
import { cartClient } from '../lib/cartClient';
import { resolveCartCredential } from '../lib/cartCredential';
import { resolveAuthenticatedUserId } from '../lib/customerAuth';
import { readSessionToken } from '../lib/session';
import { apiBase } from '../lib/api';
import { HERO_SLIDE_LIBRARY, computeNbaCandidates, kampalaCutoff, type NavConfig } from '@goldplus/shared';
import { getBusinessInfo } from '../lib/businessInfo';
import { getNavFeatured } from '../lib/navFeatured';
import { getStorefrontDiscount, salePriceUgx, effectiveFloorUgx } from '../lib/storefrontDiscount';
import { formatUgx } from '../lib/money';
import { getNavConfig } from '../lib/navConfig';

/**
 * GoldPlus site navigation.
 * ONE instance, rendered once from BaseLayout. Per-visitor data is resolved
 * server-side; all pages are dynamic + uncached, so this is safe.
 *
 * Stage 2: the header CONTENT (rail, contact, featured cards, flash panel, search
 * copy, the first-order estimate, trending) is DB-backed and editable in
 * /admin/nav. We fetch it here and fall back to DEFAULT_NAV_CONFIG — the header
 * is never a database outage. The deep structural bodies (tile descriptors, the
 * capacity matrix, the battery brand chips) stay in code; they match the seed.
 */

// ---- header content (CMS, DB-backed) ----
// Cached in-process with a short TTL (getNavConfig): per-site, identical for all
// visitors, so we do not block every page render on a fetch. Falls back to the
// last good value / DEFAULT_NAV_CONFIG — the header never blanks on a DB hiccup.
const nav: NavConfig = await getNavConfig();

// Contact details come from business_info (/admin/business-info), which is the
// ONE owner: it carries the dial string, the WhatsApp URL, the address, the
// hours and the socials, and the footer already renders from it. The header
// used to hard-code the same phone number in eight places, so editing it in the
// admin changed the footer and left the header lying. `nav_config.contact`
// duplicates a subset of these fields and is deliberately NOT read here — one
// fact, one owner.
const biz = await getBusinessInfo();
/** WhatsApp deep link with an optional prefilled message. */
const waLink = (prefill?: string) =>
  prefill ? `${biz.whatsappUrl}?text=${encodeURIComponent(prefill)}` : biz.whatsappUrl;


// ---- cart: read through the SIGNED credential, never an id in a URL ----
// Resolved in middleware: a component renders after the response has begun, so
// minting a credential here would set a cookie the browser never receives.
const headerUserId = Astro.locals.gpUserId !== undefined
  ? Astro.locals.gpUserId
  : await resolveAuthenticatedUserId(Astro.cookies);
const signedIn = headerUserId !== null;
const headerCart = Astro.locals.gpCart !== undefined
  ? Astro.locals.gpCart
  : resolveCartCredential(Astro.cookies, headerUserId);
let cartCount = 0;
let cartItems: Array<{ name: string; qty: number; price: string }> = [];
let subtotal = '0';
if (headerCart) {
  const result = await cartClient.read(headerCart.token, Astro.cookies.get('goldplus_session')?.value ?? null);
  if (result.ok) {
    cartCount = result.cart.items.reduce((a, i) => a + i.quantity, 0);
    cartItems = result.cart.items.slice(0, 4).map((i) => ({
      name: i.name, qty: i.quantity, price: i.unitPriceUgx.toLocaleString('en-UG'),
    }));
    subtotal = result.cart.subtotalUgx.toLocaleString('en-UG');
  }
}

// ---- signed-in enrichment: real points + first name (never fabricated) ----
let points = 0;
let firstName = '';
let visits = 2;                       // >1 unless we learn this is a first session
let lastOrderDays: number | null = null;
let orderInTransit = false;
if (signedIn) {
  const token = readSessionToken(Astro.request);
  if (token) {
    try {
      const res = await fetch(`${apiBase}/account/overview`, {
        headers: { Authorization: `Bearer ${token}` },
        signal: AbortSignal.timeout(2500),
      });
      const json: any = await res.json().catch(() => null);
      if (json?.success) {
        const ov = json.data;
        if (ov?.loyalty?.programmeActive && ov.loyalty.balance) {
          points = Number(ov.loyalty.balance.available ?? ov.loyalty.balance ?? 0) || 0;
        }
        const rn = ov?.defaultAddress?.recipientName;
        if (rn && typeof rn === 'string') firstName = rn.trim().split(/\s+/)[0] || '';
        // order history powers the reorder + in-transit NBA candidates
        const orders: any[] = Array.isArray(ov?.recentOrders) ? ov.recentOrders : [];
        const last = orders[0];
        const lastAt = last && (last.createdAt ?? last.placedAt ?? last.date);
        if (lastAt) {
          const t = new Date(lastAt).getTime();
          if (Number.isFinite(t)) lastOrderDays = Math.max(0, Math.round((Date.now() - t) / 86400000));
        }
        orderInTransit = orders.some((o) => /deliver|transit|dispatch|shipp?ed|out_for/i.test(String(o?.status ?? '')));
      }
    } catch {
      // A failed read leaves the header in its signed-in-but-unenriched state.
    }
  }
}

// ---- visit tenure for a signed-out visitor (drives welcome vs signup) ----
// The header is on every page, so this must be cheap: the middleware minted the
// visit cookie iff this is the first-ever document request from this browser —
// the honest "brand-new visitor" signal, with no per-page profile lookup. A
// resolvable-throw in private browsing would treat them as returning, so we
// never show a first-order promo we cannot gate.
if (!signedIn) visits = Astro.locals.gpVisitIsNew ? 1 : 2;

// The sale clock is resolved AFTER navDeal (below), because the only honest
// deadline is the one the promotion actually carries.
const flash = HERO_SLIDE_LIBRARY.find((sl) => sl.slideKey === 'flash');

// ---- points redemption value: ONE source of truth (the loyalty programme,
// the same endpoint checkout uses). We claim a shilling value ONLY when
// redemption is actually configured — the old hardcoded rate promised money the
// programme may not offer (redemption is unconfigured until an operator sets it).
let pointsRedeemUgx = 0;
try {
  const lpRes = await fetch(`${apiBase}/commerce/loyalty-programme`, { signal: AbortSignal.timeout(2000) });
  const lpJson: any = lpRes.ok ? await lpRes.json().catch(() => null) : null;
  if (lpJson?.success && lpJson.data?.redemption?.configured) {
    pointsRedeemUgx = Number(lpJson.data.redemption.pointValueUgx) || 0;
  }
} catch { /* the header never blocks on loyalty */ }

// ---- Next Best Action, computed on the SERVER from real signals ----
// The browser keeps an identical offline set as the fallback; this is what makes
// the strip right for new vs existing customers before the page even paints.
// The featured cross-sell cards, from REAL catalogue data (a card must never
// name a product the shop does not carry, or quote a price no one set).
const navFeatured = await getNavFeatured();
const navDeal = await getStorefrontDiscount();

// ---- the sale clock, from the RUNNING promotion and nothing else ----
//
// This used to read `nav.settings.saleEndsIso`, a hand-typed date that nobody
// had to keep true. It said 2026-08-09 while the header still advertised a
// "Live" flash sale, so the countdown rendered 00:00:00:00 against a deadline
// that had already passed. The promotion evaluator knows when the discount
// really ends; that is the only deadline allowed to drive a clock.
//
// saleLive is now "a real, site-wide discount is running RIGHT NOW". Every
// piece of sale furniture — the rail chip, the flash panel, the countdown —
// hangs off it, so when no promotion is running the header says nothing about
// a sale instead of inventing one.
const saleEnds = navDeal.active ? (navDeal.endsIso ?? '') : '';
const saleLive = saleEnds ? Date.now() < new Date(saleEnds).getTime() : false;
/** The rail's "Flash sale — Live" chip is a claim; drop it when it is untrue. */
const railItems = saleLive ? nav.rail : nav.rail.filter((c) => c.key !== 'flash');
const featAt = (i: number) => navFeatured.length ? navFeatured[i % navFeatured.length] : null;

/**
 * The deal panel's featured card, and whether it is HONESTLY on sale.
 *
 * A running campaign is not a discount. At the UGX 145,000 floor a 10% campaign
 * takes nothing off a product already priced at the floor, yet this card said
 * "On sale now" and printed "UGX 145,000 → UGX 145,000". The storefront's other
 * surfaces (cart, checkout, product page, product card) were corrected to gate
 * on the SAVING rather than the campaign; the header was missed.
 */
const dealFeat = featAt(0);
const dealFeatSaleUgx =
  navDeal.active && dealFeat?.priceUgx
    ? salePriceUgx(dealFeat.priceUgx, navDeal.percentBps, effectiveFloorUgx(navDeal.priceFloorUgx, dealFeat.floorPriceUgx, dealFeat.priceUgx))
    : null;
const dealFeatOnSale =
  dealFeatSaleUgx !== null && dealFeat?.priceUgx != null && dealFeatSaleUgx < dealFeat.priceUgx;
const cut = kampalaCutoff(new Date(), { cutoffHour: biz.sameDayCutoffHour, closedDays: biz.closedDays });
const nba = computeNbaCandidates({
  signedIn, visits, cart: cartCount, points, lastOrderDays, orderInTransit,
  beforeCutoff: cut.beforeCutoff, minsToCutoff: cut.minsToCutoff, sunday: cut.sunday, saleLive,
  cutoffLabel: cut.cutoffLabel,
}, {
  // the CMS offer figures drive the copy, so the server strip and the editor agree
  firstOrderPct: nav.settings.firstOrderDiscountPct,
  referralPct: nav.settings.referralPct,
  pointsToUgxRate: pointsRedeemUgx, // the loyalty redemption value, or 0 = no money claim
  firstOrderEstimate: nav.settings.firstOrderEstimateUgx,
  salePct: navDeal.active ? navDeal.percent : 0, // the live promotion, or nothing
});

const escNav = (str: string) => str.replace(/&/g, '\\u0026').replace(/</g, '\\u003c').replace(/>/g, '\\u003e').replace(/\u2028/g, '\\u2028').replace(/\u2029/g, '\\u2029');
const navConfigJson = escNav(JSON.stringify({
  signedIn, firstName, points, cartCount, saleEnds,
  firstOrderEstimate: nav.settings.firstOrderEstimateUgx,
  firstOrderPct: nav.settings.firstOrderDiscountPct,
  referralPct: nav.settings.referralPct,
  pointsRate: pointsRedeemUgx,
  trending: nav.search.trendingTerms.map((t) => [t.label, t.href]),
  zeroResult: nav.search.zeroResultCopy,
  // The search sheet's footer link is built in the browser, so the ONE
  // WhatsApp URL has to reach the client too — otherwise that one link keeps
  // pointing at a number the admin can no longer change.
  whatsappUrl: biz.whatsappUrl,
  // The popover's offer is the LIVE promotion or nothing. It used to promise
  // "10% off your first order — still reserved" from a CMS number with no
  // pricing rule behind it; the only real discount is a storewide one.
  saleActive: navDeal.active,
  salePct: navDeal.active ? navDeal.percent : 0,
}));
const nbaJson = escNav(JSON.stringify(nba));
---
<header class="gp-nav" id="gpNav" data-sale-ends={saleEnds}
  data-cutoff-hour={String(biz.sameDayCutoffHour)}
  data-closed-days={biz.closedDays.join(",")}
  data-cutoff-label={cut.cutoffLabel}>
  <div class="gp-nav__top">
    <div class="gp-nav__top-in gpn-container">
      <div class="gp-nav__nba" id="gpNavNba" role="status" aria-live="off" aria-label="Recommended next step">
        <span class="gp-nav__dot" aria-hidden="true"></span>
        <a class="gp-nav__nba-slot" id="gpNavNbaSlot" href="/support" data-in=""><span class="gp-nav__nba-txt" id="gpNavNbaText">Order before <b>{cut.cutoffLabel}</b> for same-day delivery in Kampala</span><u id="gpNavNbaCta" hidden=""></u></a>
        <button class="gp-nav__nba-x" id="gpNavNbaX" type="button" aria-label="Dismiss this message">×</button>
      </div>
      <span class="gp-nav__reach">
        <a href={biz.phoneDial}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6.5 3h3l1.5 4-2 1.4a12 12 0 0 0 5.6 5.6L16 12l4 1.5v3a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4 6.2 2 2 0 0 1 6.5 3z"></path></svg>
          <b>{biz.phoneDisplay}</b>
        </a>
        <span class="gp-nav__reach-sep" aria-hidden="true"></span>
        <a href={biz.whatsappUrl}>
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.66.15-.2.3-.76.96-.94 1.16-.17.2-.35.22-.64.08-.3-.15-1.25-.46-2.38-1.47-.88-.79-1.47-1.75-1.65-2.05-.17-.3-.02-.46.13-.6.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.66-1.6-.9-2.19-.24-.57-.48-.5-.66-.5h-.57c-.2 0-.52.07-.79.37-.27.3-1.03 1.01-1.03 2.46s1.06 2.85 1.2 3.05c.15.2 2.08 3.18 5.04 4.46.7.3 1.25.48 1.68.62.71.22 1.35.19 1.86.12.57-.08 1.75-.71 1.99-1.4.25-.69.25-1.28.17-1.4-.07-.13-.27-.2-.57-.35z"></path><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.87 9.87 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2zm0 18.15h-.01a8.2 8.2 0 0 1-4.18-1.15l-.3-.18-3.11.82.83-3.04-.2-.31a8.17 8.17 0 0 1-1.25-4.38c0-4.54 3.7-8.23 8.24-8.23 2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 0 1 2.41 5.82c0 4.54-3.7 8.23-8.25 8.23z"></path></svg>
          WhatsApp
        </a>
      </span>
    </div>
  </div>

  <div class="gp-nav__bar gpn-container">
    <button class="gp-nav__burger" id="gpNavBurger" type="button" aria-expanded="false" aria-controls="gpNavMega" aria-label="Open menu"><span></span><span></span><span></span></button>

    <a class="gp-nav__logo" href="/" aria-label="GoldPlus home">
      <img src="/nav/gp-wordmark-cream.png" alt="GoldPlus" width="480" height="138">
    </a>

    <form class="gp-nav__search" role="search" action="/shop">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" aria-hidden="true"><circle cx="10.75" cy="10.75" r="6.75"></circle><path d="M15.6 15.6 20.5 20.5"></path></svg>
      <input type="search" name="q" placeholder={nav.search.placeholderDesktop} aria-label="Search products">
      <a class="gp-nav__scan" href="/verification" aria-label="Check if a product is genuine">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8V5a2 2 0 0 1 2-2h3M16 3h3a2 2 0 0 1 2 2v3M21 16v3a2 2 0 0 1-2 2h-3M8 21H5a2 2 0 0 1-2-2v-3M7 12h10"></path></svg>
      </a>
      <div class="gp-nav__sheet" role="listbox" aria-label="Search suggestions"></div>
    </form>

    <div class="gp-nav__actions">
      <a class="gp-nav__pts" href="/account/rewards" id="gpNavPtsWrap" hidden=""><b id="gpNavPts">0</b> pts</a>
      <div class="gp-nav__acct" id="gpNavAcct">
        <button class="gp-nav__act" id="gpNavAcctBtn" type="button" aria-expanded="false" aria-haspopup="true" aria-label="Account">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8.5" r="3.6"></circle><path d="M4.8 20a7.4 7.4 0 0 1 14.4 0"></path></svg>
        </button>
        <div class="gp-nav__acct-pop" id="gpNavAcctPop"></div>
      </div>
      <div class="gp-nav__cartwrap" id="gpNavCartWrap">
      <a class="gp-nav__act" href="/cart" aria-label={cartCount > 0 ? `Cart, ${cartCount} item${cartCount === 1 ? "" : "s"}` : "Cart, empty"}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 7h13l-1.4 8.4a2 2 0 0 1-2 1.6H9a2 2 0 0 1-2-1.6L5.2 4H3"></path><circle cx="9.5" cy="20" r="1.2"></circle><circle cx="16.5" cy="20" r="1.2"></circle></svg>
        <span class="gp-nav__badge" id="gpNavCart" hidden="">0</span>
      </a>
        <div class="gp-nav__mini" id="gpNavMini">
          <p class="gp-nav__mini-h">In your cart</p>
          <div class="gp-nav__mini-list">
            {cartItems.map((it) => (
              <a href="/cart">
                <span class="gp-nav__sug-img"></span>
                <span class="gp-nav__sug-t"><b>{it.name}</b><span>Qty {it.qty}</span></span>
                <span class="gp-nav__sug-p">{it.price}</span>
              </a>
            ))}
          </div>
          <div class="gp-nav__mini-sum"><span>Subtotal</span><b>UGX {subtotal}</b></div>
          <div class="gp-nav__mini-cut" id="gpNavMiniCut"></div>
          <a class="gp-nav__acct-cta" href="/checkout">Checkout</a>
          <a class="gp-nav__acct-alt" href="/cart">View cart</a>
        </div>
      </div>
    </div>
  </div>

  <nav class="gp-nav__rail" aria-label="Product categories">
    <div class="gp-nav__rail-in gpn-container" id="gpNavRail">
      {railItems.map((cat) => (
        <a class={cat.key === 'flash' ? 'gp-nav__cat gp-nav__cat--flash' : 'gp-nav__cat'} href={cat.href} data-cat={cat.key}>{cat.label}{cat.tag && <span class="gp-nav__cat-tag">{cat.tag}</span>}</a>
      ))}
      <span class="gp-nav__spark" id="gpNavSpark" aria-hidden="true"></span>
    </div>
  </nav>

  <div class="gp-nav__mega" id="gpNavMega">
    <div class="gp-nav__mega-in gpn-container">

      <div class="gp-nav__panel" data-panel="all" data-shape="wide">
        <div class="gp-nav__tiles gp-nav__tiles--five">
          <a class="gp-nav__tile" href="/shop?category=power"><b>Power</b><span>Banks, batteries, chargers</span></a>
          <a class="gp-nav__tile" href="/shop?category=sound"><b>Sound</b><span>Earbuds and headphones</span></a>
          <a class="gp-nav__tile" href="/shop?category=storage"><b>Storage</b><span>1GB to 512GB</span></a>
          <a class="gp-nav__tile" href="/shop?category=car"><b>Car</b><span>Chargers and Bluetooth</span></a>
          <a class="gp-nav__tile" href="/shop?category=pc"><b>PC</b><span>Mouse and sound cards</span></a>
          <a class="gp-nav__tile gp-nav__tile--go" href="/shop"><b>Everything →</b><span>The full range</span></a>
        </div>
        <div class="gp-nav__feat-col">
          <h3>Start here</h3>
          <ul>
            <li><a href="/shop">New this month</a></li>
            <li><a href="/shop">Best sellers</a></li>
            <li><a href="/shop">Best value picks</a></li>
            <li><a href="/verification">How we verify stock</a></li>
          </ul>
        </div>
      </div>

      <div class="gp-nav__panel" data-panel="power">
        <div>
          <h3>Power</h3>
          <ul>
            <li><a href="/shop?category=power&q=power+bank">Power banks</a></li>
            <li><a href="/shop?category=power&q=wall+charger">Wall chargers</a></li>
            <li><a href="/shop?category=power&q=adapter">Adapters</a></li>
            <li><a href="/shop?category=power&q=cable">Cables</a></li>
            <li><a href="/shop?category=power"><b>All Power →</b></a></li>
          </ul>
        </div>
        <div class="gp-nav__finder">
          <h3>Phone batteries</h3>
          <p class="gp-nav__note">Find yours by phone model</p>
          <form action="/battery-finder" role="search">
            <input type="search" name="q" placeholder="Type your phone, e.g. Tecno Spark 10" aria-label="Find a battery for your phone model">
          </form>
          <div class="gp-nav__chips">
            <a href="/shop?category=power&q=tecno">Tecno</a>
            <a href="/shop?category=power&q=infinix">Infinix</a>
            <a href="/shop?category=power&q=itel">itel</a>
            <a href="/shop?category=power&q=samsung">Samsung</a>
            <a href="/shop?category=power&q=iphone">iPhone</a>
            <a href="/shop?category=power&q=redmi">Redmi</a>
            <a href="/shop?category=power&q=xiaomi">Xiaomi</a>
            <a href="/shop?category=power&q=huawei">Huawei</a>
            <a href="/shop?category=power&q=nokia">Nokia</a>
            <a href="/shop?category=power&q=oppo">Oppo</a>
            <a href="/shop?category=power&q=battery" style="color:var(--gpn-green)">All brands →</a>
          </div>
          <a class="gp-nav__ask" href={waLink(nav.contact.whatsappBatteryPrefill)}>
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.66.15-.2.3-.76.96-.94 1.16-.17.2-.35.22-.64.08-.3-.15-1.25-.46-2.38-1.47-.88-.79-1.47-1.75-1.65-2.05-.17-.3-.02-.46.13-.6.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.66-1.6-.9-2.19-.24-.57-.48-.5-.66-.5h-.57c-.2 0-.52.07-.79.37-.27.3-1.03 1.01-1.03 2.46s1.06 2.85 1.2 3.05c.15.2 2.08 3.18 5.04 4.46.7.3 1.25.48 1.68.62.71.22 1.35.19 1.86.12.57-.08 1.75-.71 1.99-1.4.25-.69.25-1.28.17-1.4-.07-.13-.27-.2-.57-.35z"></path><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.87 9.87 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2zm0 18.15h-.01a8.2 8.2 0 0 1-4.18-1.15l-.3-.18-3.11.82.83-3.04-.2-.31a8.17 8.17 0 0 1-1.25-4.38c0-4.54 3.7-8.23 8.24-8.23 2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 0 1 2.41 5.82c0 4.54-3.7 8.23-8.25 8.23z"></path></svg>
            Can't find your model? Send us a photo of the old one
          </a>
        </div>
        {featAt(0) && (
          <a class="gp-nav__feat" href={`/products/${featAt(0)!.slug}`}>
            <div class="gp-nav__feat-card gp-nav__feat-card--photo"><img src={featAt(0)!.imageUrl} alt={featAt(0)!.name} loading="lazy" decoding="async"></div>
            <div><small>{featAt(0)!.label}</small><p>{featAt(0)!.name}</p><span>{featAt(0)!.blurb}</span></div>
          </a>
        )}
      </div>

      <div class="gp-nav__panel" data-panel="sound" data-shape="wide">
        <div class="gp-nav__tiles">
          <a class="gp-nav__tile" href="/shop?category=sound&q=earbuds"><b>Earbuds</b><span>True wireless, with a charging case</span></a>
