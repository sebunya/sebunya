<style is:global>
/* Poppins — reuse the self-hosted files the hero already ships (CSP font-src 'self') */
@font-face{font-family:'Poppins';font-style:normal;font-weight:400;font-display:swap;src:url('/hero/fonts/poppins-400.woff2') format('woff2');}
@font-face{font-family:'Poppins';font-style:normal;font-weight:600;font-display:swap;src:url('/hero/fonts/poppins-600.woff2') format('woff2');}
@font-face{font-family:'Poppins';font-style:normal;font-weight:700;font-display:swap;src:url('/hero/fonts/poppins-700.woff2') format('woff2');}

/* =====================================================================
   GOLDPLUS NAVIGATION v2
   Fewer things, each doing one job. The logo is the logo. Contact lives
   in the contact strip. The rail is the navigation. Nothing is said twice.
   ===================================================================== */
body.gph-nav-demo{display:block;margin:0;padding:0;background:#0A0A0A;min-height:100vh;}
body.gph-nav-demo .gp-hero{margin-top:22px;}

/* ===== ALIGNMENT: the header shares the SITE's content container =====
   The storefront wraps every section in Tailwind's `.container mx-auto px-4
   lg:px-8` (default stepped breakpoints; 16px gutter -> 32px at lg). A single
   fixed max-width cannot match a STEPPED container, so .gpn-container replicates
   it EXACTLY and the four header rows use it: the header lines up with the hero
   and every section by construction, at every width, not by eye. */
:root{ --gpn-gutter:16px; }
@media (min-width:1024px){ :root{ --gpn-gutter:32px; } }
.gpn-container{ width:100%; margin-inline:auto; padding-inline:var(--gpn-gutter); }
@media (min-width:640px){ .gpn-container{ max-width:640px; } }
@media (min-width:768px){ .gpn-container{ max-width:768px; } }
@media (min-width:1024px){ .gpn-container{ max-width:1024px; } }
@media (min-width:1280px){ .gpn-container{ max-width:1280px; } }
@media (min-width:1536px){ .gpn-container{ max-width:1536px; } }

.gp-nav{
  --gpn-green:#93D500;
  --gpn-ink:#0A0A0A;
  --gpn-cream:#F3EFE8;
  --gpn-line:rgba(243,239,228,.12);
  --gpn-muted:rgba(243,239,228,.6);
  --gpn-panel:#0F0F0F;
  --gpn-ease:cubic-bezier(.22,.9,.28,1);
  position:relative;z-index:60;background:var(--gpn-ink);
  box-shadow:0 1px 0 rgba(147,213,0,.14), 0 18px 40px -26px rgba(10,10,10,.6);
  font-family:'Poppins',system-ui,sans-serif;color:var(--gpn-cream);
}
.gp-nav,.gp-nav *,.gp-nav *::before,.gp-nav *::after{box-sizing:border-box;}
/* The reset must NOT outweigh component rules: `.gp-nav a` is (0,1,1) and
   silently beat every single-class colour rule at (0,1,0), so styled links
   fell back to cream — including cream-on-green CTAs at 1.76:1.
   `:where()` contributes zero specificity, so this lands at (0,0,1): it still
   overrides the global `a` colour, but any component class beats it. */
:where(.gp-nav) a{text-decoration:none;color:inherit;}
/* Same zero-specificity treatment as the anchor reset above, and for the same
   reason: `.gp-nav button` at (0,1,1) beat `.gp-nav__acct-cta` at (0,1,0) and
   stripped the fill off the primary sign-up CTA. */
:where(.gp-nav) button{font:inherit;color:inherit;background:none;border:0;padding:0;cursor:pointer;}
/* #4: a 20px glyph in a 44px box sits 12px in; pull leading/trailing controls
   out by that residual so the marks go flush with page content, the hit box
   overhangs harmlessly into the gutter. */
.gp-nav__burger{margin-left:-12px;}
.gp-nav__cartwrap{margin-right:-12px;}
.gp-nav :focus-visible{outline:2px solid var(--gpn-green);outline-offset:3px;border-radius:6px;}

/* ---------- contact strip: the two ways to reach a human ---------- */
.gp-nav__top{border-bottom:1px solid var(--gpn-line);font-size:12px;}
.gp-nav__top-in{
  height:38px;
  display:flex;align-items:center;justify-content:space-between;gap:20px;
}
/* ---------- next best action ----------
   One line, one job: the single most useful thing this visitor could do
   next. Ranked by the same kind of engine the hero used, so the two
   never contradict each other. */
.gp-nav__nba{display:flex;align-items:center;gap:9px;color:var(--gpn-muted);min-width:0;flex:1;align-self:stretch;}
.gp-nav__nba-slot{
  display:flex;align-items:center;gap:7px;min-width:0;align-self:stretch;
  color:var(--gpn-muted);white-space:nowrap;overflow:hidden;
  opacity:0;transform:translateY(4px);
  transition:opacity .4s var(--gpn-ease),transform .4s var(--gpn-ease),color .2s;
}
.gp-nav__nba-slot[data-in]{opacity:1;transform:none;}
.gp-nav__nba-slot:hover{color:var(--gpn-cream);}
.gp-nav__nba-slot b{color:var(--gpn-cream);font-weight:600;}
.gp-nav__nba-slot em{font-style:normal;color:var(--gpn-green);font-weight:600;}
/* only the sentence shrinks; the action is a flex sibling at flex:none, so
   ellipsis never eats "Finish order →" on a narrow phone */
.gp-nav__nba-txt{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.gp-nav__nba-slot u{text-decoration:none;color:var(--gpn-green);font-weight:600;flex:none;}
.gp-nav__nba-slot:hover u{text-decoration:underline;}
.gp-nav__nba-x{
  width:22px;height:22px;flex:none;border-radius:50%;line-height:1;font-size:15px;
  color:rgba(243,239,228,.35);display:none;place-items:center;
}
.gp-nav__nba:hover .gp-nav__nba-x{display:grid;}
.gp-nav__nba-x:hover{color:var(--gpn-cream);background:rgba(243,239,228,.08);}
.gp-nav__dot[data-urgent]{background:#E8C96A;}
.gp-nav__dot{width:5px;height:5px;border-radius:50%;background:var(--gpn-green);flex:none;
  box-shadow:0 0 0 0 rgba(147,213,0,.55);animation:gpn-live 2.6s ease-out infinite;}
@keyframes gpn-live{0%{box-shadow:0 0 0 0 rgba(147,213,0,.5)}70%{box-shadow:0 0 0 7px rgba(147,213,0,0)}100%{box-shadow:0 0 0 0 rgba(147,213,0,0)}}

.gp-nav__reach{display:flex;align-items:center;gap:4px;flex:none;}
.gp-nav__reach a{
  display:inline-flex;align-items:center;gap:7px;height:26px;padding:0 10px;border-radius:999px;
  color:var(--gpn-muted);letter-spacing:.01em;
  transition:color .22s var(--gpn-ease),background .22s var(--gpn-ease);
}
.gp-nav__reach a:hover{color:var(--gpn-cream);background:rgba(243,239,228,.07);}
.gp-nav__reach svg{width:14px;height:14px;flex:none;}
.gp-nav__reach b{font-weight:600;color:var(--gpn-cream);font-variant-numeric:tabular-nums;letter-spacing:.02em;}
.gp-nav__reach a:hover svg{color:var(--gpn-green);}
.gp-nav__reach-sep{width:1px;height:14px;background:var(--gpn-line);}

/* ---------- main bar ---------- */
.gp-nav__bar{
  height:80px;
  display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:24px;
}
.gp-nav__logo{display:block;line-height:0;flex:none;padding-block:9px;}  /* #8: 44px hit box, mark size unchanged */
.gp-nav__logo img{height:30px;width:auto;display:block;transition:opacity .25s var(--gpn-ease);}
.gp-nav__logo:hover img{opacity:.8;}

.gp-nav__search{position:relative;max-width:480px;width:100%;justify-self:center;}
.gp-nav__search input{
  width:100%;height:44px;padding:0 44px;
  background:rgba(243,239,228,.045);border:1px solid var(--gpn-line);border-radius:999px;
  color:var(--gpn-cream);font:400 14.5px 'Poppins',sans-serif;
  transition:border-color .3s var(--gpn-ease),background .3s var(--gpn-ease);
}
.gp-nav__search input::placeholder{color:rgba(243,239,228,.42);}
.gp-nav__search input:focus{outline:none;border-color:rgba(147,213,0,.5);background:rgba(243,239,228,.075);}
.gp-nav__search > svg{position:absolute;left:17px;top:50%;transform:translateY(-50%);width:17px;height:17px;color:rgba(243,239,228,.5);pointer-events:none;transition:color .25s var(--gpn-ease);}
.gp-nav__search:focus-within > svg{color:var(--gpn-green);}
.gp-nav__scan svg{width:18px;height:18px;}
.gp-nav__scan{position:absolute;right:5px;top:50%;transform:translateY(-50%);
  width:34px;height:34px;border-radius:50%;display:grid;place-items:center;color:rgba(243,239,228,.45);}
.gp-nav__scan:hover{color:var(--gpn-green);background:rgba(147,213,0,.1);}

.gp-nav__actions{display:flex;align-items:center;gap:2px;}
.gp-nav__act{
  width:44px;height:44px;display:grid;place-items:center;border-radius:12px;position:relative;
  color:var(--gpn-cream);transition:background .22s var(--gpn-ease);
}
.gp-nav__act:hover{background:rgba(243,239,228,.07);}
.gp-nav__act svg{width:20px;height:20px;}
.gp-nav__pts{
  display:inline-flex;align-items:baseline;gap:5px;height:32px;padding:0 13px;margin-right:6px;
  border:1px solid rgba(147,213,0,.3);border-radius:999px;font-size:11.5px;color:var(--gpn-muted);
  white-space:nowrap;transition:border-color .25s,background .25s;
}
.gp-nav__pts b{color:var(--gpn-green);font-weight:600;font-size:13px;font-variant-numeric:tabular-nums;}
.gp-nav__pts:hover{border-color:rgba(147,213,0,.6);background:rgba(147,213,0,.08);}
.gp-nav__badge{
  position:absolute;top:5px;right:5px;min-width:17px;height:17px;padding:0 5px;
  display:grid;place-items:center;border-radius:999px;
  background:var(--gpn-green);color:var(--gpn-ink);font-size:10px;font-weight:700;
}
.gp-nav__badge[hidden]{display:none;}
.gp-nav__pts[hidden]{display:none;}
.gp-nav__badge[data-bump]{animation:gpn-bump .5s var(--gpn-ease);}
@keyframes gpn-bump{0%{transform:scale(1)}40%{transform:scale(1.32)}100%{transform:scale(1)}}

/* mobile toggle — deliberately NOT the brand mark */
.gp-nav__burger{display:none;width:44px;height:44px;border-radius:12px;position:relative;}
.gp-nav__burger span{
  position:absolute;left:12px;width:20px;height:2px;border-radius:2px;background:var(--gpn-cream);
  transition:transform .4s var(--gpn-ease),opacity .25s;
}
.gp-nav__burger span:nth-child(1){top:15px;}
.gp-nav__burger span:nth-child(2){top:21px;}
.gp-nav__burger span:nth-child(3){top:27px;}
.gp-nav[data-open] .gp-nav__burger span:nth-child(1){transform:translateY(6px) rotate(45deg);background:var(--gpn-green);}
.gp-nav[data-open] .gp-nav__burger span:nth-child(2){opacity:0;}
.gp-nav[data-open] .gp-nav__burger span:nth-child(3){transform:translateY(-6px) rotate(-45deg);background:var(--gpn-green);}

/* ---------- rail ---------- */
.gp-nav__rail{border-top:1px solid var(--gpn-line);position:relative;}
.gp-nav__rail-in{
  height:48px;
  display:flex;align-items:center;gap:32px;position:relative;
}
.gp-nav__cat{
  position:relative;height:100%;display:flex;align-items:center;gap:8px;
  font-size:13.5px;font-weight:500;color:var(--gpn-muted);
  transition:color .22s var(--gpn-ease);
}
.gp-nav__cat:hover,.gp-nav__cat[data-on],.gp-nav__cat[aria-current]{color:var(--gpn-cream);}
.gp-nav__cat-tag{
  padding:2px 6px;border-radius:4px;font-size:9px;font-weight:700;letter-spacing:.08em;
  text-transform:uppercase;background:var(--gpn-green);color:var(--gpn-ink);
}
.gp-nav__spark{
  position:absolute;bottom:-1px;left:0;height:2px;width:0;background:var(--gpn-green);border-radius:2px;
  box-shadow:0 0 12px rgba(147,213,0,.55);opacity:0;pointer-events:none;
  transition:transform .42s var(--gpn-ease),width .42s var(--gpn-ease),opacity .28s;
}
.gp-nav__spark[data-show]{opacity:1;}

/* ---------- one panel, contents swap per category ---------- */
.gp-nav__mega{
  position:absolute;left:0;right:0;top:100%;z-index:59;
  background:var(--gpn-panel);border-top:1px solid var(--gpn-line);
  box-shadow:0 30px 64px rgba(0,0,0,.55);
  display:grid;grid-template-rows:0fr;
  transition:grid-template-rows .42s var(--gpn-ease);
}
.gp-nav[data-open] .gp-nav__mega{grid-template-rows:1fr;}
.gp-nav__mega-in{
  width:100%;justify-self:stretch;   /* #3: fill the animating grid track, THEN center */
  min-height:0;overflow-x:hidden;overflow-y:auto;
  max-height:min(78vh,560px);      /* short windows scroll rather than clip */
}
.gp-nav__panel{display:none;grid-template-columns:1fr 1fr 296px;gap:34px;padding:28px 0 30px;}
.gp-nav__panel[data-on]{display:grid;align-items:stretch;}
.gp-nav[data-open] .gp-nav__panel[data-on] > *{animation:gpn-rise .42s var(--gpn-ease) both;}
.gp-nav__panel[data-on] > *:nth-child(2){animation-delay:60ms;}
.gp-nav__panel[data-on] > *:nth-child(3){animation-delay:120ms;}
@keyframes gpn-rise{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}

.gp-nav__panel h3{
  margin:0 0 14px;font-size:10.5px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;
  color:var(--gpn-green);
}
.gp-nav__panel ul{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:2px;}
.gp-nav__panel li a{
  display:block;padding:7px 0;font-size:14px;color:var(--gpn-muted);
  transition:color .18s,transform .22s var(--gpn-ease);
}
.gp-nav__panel li a:hover{color:var(--gpn-cream);transform:translateX(4px);}
.gp-nav__panel li a b{font-weight:500;color:var(--gpn-green);}

.gp-nav__tiles--five{grid-template-columns:repeat(3,1fr);}
.gp-nav__tile--go{border-color:rgba(147,213,0,.35);}
.gp-nav__tile--go b{color:var(--gpn-green);}
.gp-nav__feat-col h3{margin:0 0 14px;}
.gp-nav__feat{display:flex;flex-direction:column;gap:13px;}
.gp-nav__feat-card{
  position:relative;                 /* percentage heights need a resolved parent —
                                        without it the image sizes off its own width */
  background:var(--gpn-cream);border-radius:999px 999px 16px 16px;height:132px;
  overflow:hidden;isolation:isolate;
}
.gp-nav__feat-card img{
  position:absolute;inset:13%;width:74%;height:74%;object-fit:contain;
  mix-blend-mode:multiply;
  filter:brightness(1.09) contrast(1.04);transition:transform .6s var(--gpn-ease);
}
.gp-nav__feat:hover .gp-nav__feat-card img{transform:scale(1.05);}
.gp-nav__feat small{font-size:9.5px;letter-spacing:.13em;text-transform:uppercase;color:var(--gpn-green);font-weight:700;}
.gp-nav__feat p{margin:5px 0 0;font-size:13.5px;font-weight:600;line-height:1.35;}
.gp-nav__feat span{display:block;margin-top:3px;font-size:12.5px;color:var(--gpn-muted);}

.gp-nav__cat--flash .gp-nav__cat-tag{animation:gpn-live 2.6s ease-out infinite;}
.gp-nav__stock{margin:0 0 14px;font-size:12px;color:var(--gpn-muted);}
.gp-nav__stock b{color:var(--gpn-cream);font-weight:600;}
.gp-nav__stock-bar{height:4px;border-radius:2px;background:rgba(243,239,228,.13);margin-bottom:7px;overflow:hidden;}
.gp-nav__stock-bar i{display:block;height:100%;border-radius:2px;background:var(--gpn-green);
  box-shadow:0 0 10px rgba(147,213,0,.5);}
.gp-nav__cd{display:flex;gap:8px;margin-bottom:14px;}
.gp-nav__cd span{
  min-width:56px;padding:9px 8px 7px;text-align:center;
  border:1px solid var(--gpn-line);border-radius:10px;
}
.gp-nav__cd b{display:block;font-size:19px;font-weight:700;color:var(--gpn-green);font-variant-numeric:tabular-nums;line-height:1;}
.gp-nav__cd small{display:block;margin-top:4px;font-size:8.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--gpn-muted);}
.gp-nav__flashcta{
  display:inline-flex;align-items:center;height:42px;padding:0 20px;border-radius:999px;
  background:var(--gpn-green);color:var(--gpn-ink);font-size:13px;font-weight:600;
  transition:box-shadow .3s;
}
.gp-nav__flashcta:hover{box-shadow:0 8px 26px rgba(147,213,0,.35);}
.gp-nav__panel li a em{font-style:normal;color:var(--gpn-green);font-weight:600;margin-left:6px;}
.gp-nav__scrim{position:fixed;inset:0;z-index:58;background:rgba(4,4,4,.55);
  opacity:0;visibility:hidden;transition:opacity .35s,visibility .35s;}
.gp-nav[data-open] .gp-nav__scrim{opacity:1;visibility:visible;}

.gp-nav__mob{display:none;}

/* ---------- mobile ---------- */
@media (max-width:980px){
  .gp-nav__top-in{height:34px;justify-content:center;}
  .gp-nav__nba{font-size:11px;justify-content:center;}
  .gp-nav__nba-x{display:none!important;}
  .gp-nav__reach{display:none;}
  .gp-nav__bar{grid-template-columns:auto 1fr auto;height:60px;gap:8px;}
  .gp-nav__search,.gp-nav__rail,.gp-nav__pts{display:none;}
  .gp-nav__burger{display:block;}
  .gp-nav__logo{justify-self:center;}
  .gp-nav__logo img{height:26px;}
  .gp-nav__scrim{display:none;}

  .gp-nav__ticker,.gp-nav__top,.gp-nav__bar{position:relative;z-index:61;background:var(--gpn-ink);}
  .gp-nav__mega{
    display:block;grid-template-rows:none;
    position:fixed;inset:0;max-height:none;height:100dvh;background:var(--gpn-ink);
    border:0;box-shadow:none;transform:translateY(-100%);
    transition:transform .46s var(--gpn-ease);overflow-y:auto;-webkit-overflow-scrolling:touch;
  }
  /* the desktop clamp is (0,3,0); a bare .gp-nav__mega rule cannot beat it
     inside a media query, so match its specificity or the overlay stays 420px */
  .gp-nav[data-open] .gp-nav__mega{transform:none;max-height:none;grid-template-rows:none;}
  .gp-nav__mega-in{padding-block:calc(var(--gpn-head,94px) + 16px) 36px;max-height:none;overflow:visible;}
  .gp-nav__panel{display:none!important;}
  .gp-nav__mob{display:block;}

  .gp-nav__msearch{position:relative;margin-bottom:18px;}
  .gp-nav__msearch input{
    width:100%;height:50px;padding:0 16px 0 44px;border-radius:14px;
    background:rgba(243,239,228,.06);border:1px solid var(--gpn-line);
    color:var(--gpn-cream);font:400 15px 'Poppins',sans-serif;
  }
  .gp-nav__msearch input:focus{outline:none;border-color:rgba(147,213,0,.5);}
  .gp-nav__msearch > svg{position:absolute;left:16px;top:50%;transform:translateY(-50%);width:17px;height:17px;color:rgba(243,239,228,.45);}

  .gp-nav__quick{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:20px;}
  .gp-nav__quick a{
    min-height:52px;display:flex;align-items:center;justify-content:center;gap:7px;
    border:1px solid var(--gpn-line);border-radius:14px;font-size:14px;font-weight:600;
  }
  .gp-nav__quick a:last-child{border-color:rgba(147,213,0,.4);}

  .gp-nav__mflash{
    display:flex;align-items:center;justify-content:space-between;gap:12px;
    min-height:56px;padding:0 16px;margin-bottom:20px;border-radius:14px;
    background:rgba(147,213,0,.1);border:1px solid rgba(147,213,0,.35);
    font-size:14px;
  }
  .gp-nav__mflash b{color:var(--gpn-green);font-weight:700;font-variant-numeric:tabular-nums;}
  .gp-nav__mflash-go{color:var(--gpn-green);font-weight:600;flex:none;}
  .gp-nav__acc{border-top:1px solid var(--gpn-line);}
  .gp-nav__acc:last-of-type{border-bottom:1px solid var(--gpn-line);}
  .gp-nav__acc-head{display:flex;align-items:stretch;}
  .gp-nav__acc-head > a{flex:1;display:flex;align-items:center;font-size:16px;font-weight:600;min-height:58px;}
  .gp-nav__acc-tog{width:58px;display:grid;place-items:center;color:var(--gpn-green);font-size:22px;line-height:1;
    transition:transform .35s var(--gpn-ease);}
  .gp-nav__acc[data-exp] .gp-nav__acc-tog{transform:rotate(45deg);}
  .gp-nav__acc ul{list-style:none;margin:0;padding:0;max-height:0;overflow:hidden;
    transition:max-height .42s var(--gpn-ease);}
  .gp-nav__acc[data-exp] ul{max-height:360px;}
  /* :where() zero-weights the accordion default (0,0,1) so component classes
     like .gp-nav__ask keep their own colour — (0,2,1) beat them before. */
  :where(.gp-nav__acc li) a{display:block;padding:13px 0 13px 15px;font-size:14.5px;color:var(--gpn-muted);}
  .gp-nav__acc li:last-child a{padding-bottom:18px;}

  /* the two ways to reach a human, thumb-sized */
  .gp-nav__mreach{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:24px;}
  .gp-nav__mreach a{
    min-height:56px;display:flex;align-items:center;justify-content:center;gap:9px;
    border-radius:14px;font-size:14px;font-weight:600;
  }
  .gp-nav__mreach a:first-child{border:1px solid var(--gpn-line);}
  .gp-nav__mreach a:last-child{background:var(--gpn-green);color:var(--gpn-ink);}
  .gp-nav__mreach svg{width:18px;height:18px;}
  .gp-nav__mnote{margin:12px 0 0;font-size:12px;color:var(--gpn-muted);text-align:center;}
}
@media (max-width:380px){
  .gp-nav__logo img{height:23px;}
}
@media (prefers-reduced-motion:reduce){
  .gp-nav *,.gp-nav *::before,.gp-nav *::after{animation:none!important;transition-duration:.01ms!important;}
}



/* ---------- mini cart: the cut-off follows the order, not the other way round ---------- */
.gp-nav__cartwrap{position:relative;}
.gp-nav__mini{
  position:absolute;right:0;top:calc(100% + 10px);width:320px;z-index:70;
  background:var(--gpn-panel);border:1px solid var(--gpn-line);border-radius:16px;
  box-shadow:0 24px 54px rgba(0,0,0,.6);padding:16px;
  opacity:0;visibility:hidden;transform:translateY(-6px);
  transition:opacity .25s var(--gpn-ease),transform .25s var(--gpn-ease),visibility .25s;
}
.gp-nav__cartwrap[data-open] .gp-nav__mini{opacity:1;visibility:visible;transform:none;}
.gp-nav__cartwrap[data-empty] .gp-nav__mini{display:none;}
.gp-nav__mini-h{margin:0 0 10px;font-size:10px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--gpn-muted);}
.gp-nav__mini-list{display:flex;flex-direction:column;margin:0 -6px;}
.gp-nav__mini-list a{display:flex;align-items:center;gap:11px;padding:8px 6px;border-radius:10px;}
.gp-nav__mini-list a:hover{background:rgba(243,239,228,.06);}
.gp-nav__mini-list .gp-nav__sug-img{width:40px;height:40px;}
.gp-nav__mini-list .gp-nav__sug-p{font-size:12.5px;}
.gp-nav__mini-sum{
  display:flex;justify-content:space-between;align-items:baseline;
  margin:11px 0 12px;padding-top:11px;border-top:1px solid var(--gpn-line);font-size:12.5px;color:var(--gpn-muted);
}
.gp-nav__mini-sum b{font-size:15px;color:var(--gpn-cream);font-variant-numeric:tabular-nums;}
.gp-nav__mini-cut{
  display:flex;align-items:center;gap:8px;margin-bottom:12px;padding:9px 12px;border-radius:10px;
  background:rgba(147,213,0,.08);border:1px solid rgba(147,213,0,.28);
  font-size:12px;color:var(--gpn-muted);line-height:1.4;
}
.gp-nav__mini-cut b{color:var(--gpn-green);font-weight:600;}
.gp-nav__mini .gp-nav__acct-alt{margin-top:8px;}

/* ---------- account ---------- */
.gp-nav__acct{position:relative;}
.gp-nav__acct-pop{
  position:absolute;right:0;top:calc(100% + 10px);width:280px;z-index:70;
  background:var(--gpn-panel);border:1px solid var(--gpn-line);border-radius:16px;
  box-shadow:0 24px 54px rgba(0,0,0,.6);padding:18px;
  opacity:0;visibility:hidden;transform:translateY(-6px);
  transition:opacity .25s var(--gpn-ease),transform .25s var(--gpn-ease),visibility .25s;
}
.gp-nav__acct[data-open] .gp-nav__acct-pop{opacity:1;visibility:visible;transform:none;}
.gp-nav__hi{margin:0 0 3px;font-size:15px;font-weight:600;color:var(--gpn-cream);}
.gp-nav__hi-sub{margin:0 0 15px;font-size:12.5px;color:var(--gpn-muted);line-height:1.45;}
.gp-nav__hi-sub b{color:var(--gpn-green);font-weight:600;}
.gp-nav__acct-cta{
  display:flex;align-items:center;justify-content:center;height:44px;border-radius:11px;
  background:var(--gpn-green);color:var(--gpn-ink);font-size:13.5px;font-weight:600;margin-bottom:9px;
}
.gp-nav__acct-cta:hover{color:var(--gpn-ink);box-shadow:0 8px 22px rgba(147,213,0,.3);}
.gp-nav__acct-alt{
  display:flex;align-items:center;justify-content:center;height:44px;border-radius:11px;
  border:1px solid var(--gpn-line);font-size:13px;color:var(--gpn-cream);
}
.gp-nav__acct-alt:hover{border-color:rgba(147,213,0,.45);color:var(--gpn-cream);}
.gp-nav__acct-links{display:flex;flex-direction:column;gap:1px;margin:0 -6px;}
.gp-nav__acct-links a{
  display:flex;align-items:center;justify-content:space-between;
  padding:10px 6px;border-radius:9px;font-size:13.5px;color:var(--gpn-muted);
}
.gp-nav__acct-links a:hover{background:rgba(243,239,228,.06);color:var(--gpn-cream);}
.gp-nav__acct-links b{color:var(--gpn-green);font-weight:600;font-size:12.5px;}
/* the reserved-reward card — deliberately looks held, not handed over */
.gp-nav__hold{
  display:block;margin-bottom:13px;padding:13px 14px;border-radius:12px;
  border:1px dashed rgba(147,213,0,.42);background:rgba(147,213,0,.07);
}
.gp-nav__hold-tag{
  display:block;margin-bottom:6px;font-size:9.5px;font-weight:700;
  letter-spacing:.14em;text-transform:uppercase;color:var(--gpn-green);
}
.gp-nav__hold b{display:block;font-size:14.5px;font-weight:600;color:var(--gpn-cream);line-height:1.25;}
.gp-nav__hold span{display:block;margin-top:5px;font-size:11.5px;color:var(--gpn-muted);line-height:1.45;}
.gp-nav__hold em{font-style:normal;color:var(--gpn-green);font-weight:600;}

/* one field: a phone number IS the account here */
.gp-nav__join{display:flex;flex-direction:column;gap:8px;margin-bottom:9px;}
.gp-nav__join input{
  height:44px;padding:0 14px;border-radius:11px;
  background:rgba(243,239,228,.05);border:1px solid var(--gpn-line);
  color:var(--gpn-cream);font:400 13.5px 'Poppins',sans-serif;
}
.gp-nav__join input::placeholder{color:rgba(243,239,228,.34);}
.gp-nav__join input:focus{outline:none;border-color:rgba(147,213,0,.55);background:rgba(243,239,228,.07);}
.gp-nav__join .gp-nav__acct-cta{margin-bottom:0;border:0;width:100%;font-family:inherit;cursor:pointer;}
.gp-nav__join-note{margin:0 0 11px;font-size:11px;color:rgba(243,239,228,.42);line-height:1.4;}

.gp-nav__acct-code{
  display:flex;align-items:center;justify-content:space-between;gap:10px;
  margin-bottom:14px;padding:11px 13px;border-radius:11px;
  border:1px dashed rgba(147,213,0,.45);background:rgba(147,213,0,.06);
  font-size:13px;font-weight:700;letter-spacing:.08em;color:var(--gpn-green);cursor:pointer;
}
.gp-nav__acct-code small{font-size:10.5px;font-weight:500;letter-spacing:.04em;color:var(--gpn-muted);}

/* mobile: the greeting leads the menu */
.gp-nav__mhi{margin:0 0 16px;}
.gp-nav__mhi h2{margin:0 0 4px;font-size:20px;font-weight:600;color:var(--gpn-cream);letter-spacing:-.01em;}
.gp-nav__mhi p{margin:0;font-size:13px;color:var(--gpn-muted);line-height:1.5;}
.gp-nav__mhi p b{color:var(--gpn-green);}
.gp-nav__mhi-row{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:14px;}
.gp-nav__mhi-row a{
  min-height:50px;display:flex;align-items:center;justify-content:center;
  border-radius:12px;font-size:13.5px;font-weight:600;
}
.gp-nav__mhi-row a:first-child{background:var(--gpn-green);color:var(--gpn-ink);}
.gp-nav__mhi-row a:last-child{border:1px solid var(--gpn-line);color:var(--gpn-cream);}
/* one-field sign-up, mobile. Same rules as the desktop popover but sized for
   thumbs: 52px row, and 15px type because iOS zooms the page on focus below 16 */
.gp-nav__mjoin{display:flex;gap:9px;margin-top:14px;}
.gp-nav__mjoin input{
  flex:1;min-width:0;height:52px;padding:0 15px;border-radius:12px;
  background:rgba(243,239,228,.05);border:1px solid var(--gpn-line);
  color:var(--gpn-cream);font:400 15px 'Poppins',system-ui,sans-serif;
}
.gp-nav__mjoin input::placeholder{color:rgba(243,239,228,.34);}
.gp-nav__mjoin input:focus{outline:none;border-color:rgba(147,213,0,.55);background:rgba(243,239,228,.07);}
.gp-nav__mjoin button{
  flex:none;height:52px;padding:0 22px;border-radius:12px;border:0;
  background:var(--gpn-green);color:var(--gpn-ink);
  font:600 14px 'Poppins',system-ui,sans-serif;cursor:pointer;
}
/* a real touch target, not a bare text link: 44px box, margin trimmed so the
   visual gap below "Claim it" stays at ~12px */
.gp-nav__mhi-alt{display:inline-flex;align-items:center;min-height:44px;margin-top:2px;font-size:13px;color:var(--gpn-muted);}
.gp-nav__mhi-alt:hover{color:var(--gpn-cream);}

/* ---------- search: a real search experience, not a text box ---------- */
.gp-nav__search{position:relative;}
.gp-nav__sheet{
  position:absolute;left:0;right:0;top:calc(100% + 10px);z-index:70;
  background:var(--gpn-panel);border:1px solid var(--gpn-line);border-radius:18px;
  box-shadow:0 26px 60px rgba(0,0,0,.6);
  padding:16px 6px 8px;
  opacity:0;visibility:hidden;transform:translateY(-6px);
  transition:opacity .25s var(--gpn-ease),transform .25s var(--gpn-ease),visibility .25s;
  max-height:min(70vh,480px);overflow-y:auto;
}
.gp-nav__search[data-open] .gp-nav__sheet{opacity:1;visibility:visible;transform:none;}
.gp-nav__sh-h{
  padding:0 14px;margin:0 0 9px;font-size:10px;font-weight:700;letter-spacing:.14em;
  text-transform:uppercase;color:var(--gpn-muted);display:flex;justify-content:space-between;align-items:center;
}
.gp-nav__sh-h button{font-size:10px;letter-spacing:.06em;color:var(--gpn-muted);text-transform:none;}
.gp-nav__sh-h button:hover{color:var(--gpn-green);}
.gp-nav__sh-sec + .gp-nav__sh-sec{margin-top:14px;padding-top:14px;border-top:1px solid var(--gpn-line);}

.gp-nav__trend{display:flex;flex-wrap:wrap;gap:7px;padding:0 14px;}
.gp-nav__trend a{
  display:inline-flex;align-items:center;gap:7px;padding:7px 12px;border-radius:999px;
  border:1px solid var(--gpn-line);font-size:12.5px;color:var(--gpn-muted);
  transition:border-color .2s,color .2s,background .2s;
}
.gp-nav__trend a:hover,.gp-nav__trend a[data-sel]{border-color:rgba(147,213,0,.5);color:var(--gpn-cream);background:rgba(147,213,0,.07);}
.gp-nav__trend i{font-style:normal;font-size:10.5px;font-weight:700;color:var(--gpn-green);font-variant-numeric:tabular-nums;}

.gp-nav__sug{display:flex;flex-direction:column;}
.gp-nav__sug a{
  display:flex;align-items:center;gap:13px;padding:9px 14px;border-radius:12px;
  transition:background .18s;
}
.gp-nav__sug a:hover,.gp-nav__sug a[data-sel]{background:rgba(243,239,228,.06);}
.gp-nav__sug-img{
  width:44px;height:44px;flex:none;border-radius:10px;background:var(--gpn-cream);
  background-image:linear-gradient(135deg,transparent 46%,rgba(10,10,10,.07) 46% 54%,transparent 54%);
  display:grid;place-items:center;overflow:hidden;isolation:isolate;
}
.gp-nav__sug-img img{width:82%;height:82%;object-fit:contain;mix-blend-mode:multiply;filter:brightness(1.09) contrast(1.04);}
.gp-nav__sug-t{flex:1;min-width:0;}
.gp-nav__sug-t b{display:block;font-size:13.5px;font-weight:500;color:var(--gpn-cream);
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.gp-nav__sug-t b mark{background:none;color:var(--gpn-green);font-weight:700;}
.gp-nav__sug-t span{display:block;margin-top:2px;font-size:11.5px;color:var(--gpn-muted);}
.gp-nav__sug-p{font-size:13px;font-weight:600;color:var(--gpn-cream);flex:none;font-variant-numeric:tabular-nums;}
.gp-nav__sug-cat{font-size:11px;color:var(--gpn-green);flex:none;}

.gp-nav__sh-foot{
  margin-top:12px;padding:11px 14px 4px;border-top:1px solid var(--gpn-line);
  display:flex;align-items:center;justify-content:space-between;gap:12px;font-size:12px;
}
.gp-nav__sh-foot a{color:var(--gpn-green);display:inline-flex;align-items:center;gap:7px;}
.gp-nav__sh-foot a:hover{text-decoration:underline;}
.gp-nav__sh-foot svg{width:14px;height:14px;}
.gp-nav__sh-keys{color:var(--gpn-muted);display:flex;gap:10px;}
.gp-nav__sh-keys kbd{
  font:inherit;font-size:10px;padding:2px 5px;border:1px solid var(--gpn-line);border-radius:4px;
  color:var(--gpn-muted);
}
.gp-nav__sh-empty{padding:14px;font-size:13px;color:var(--gpn-muted);}
.gp-nav__sh-empty b{color:var(--gpn-cream);}

@media (max-width:980px){
  .gp-nav__sheet{position:static;opacity:1;visibility:visible;transform:none;
    background:none;border:0;box-shadow:none;padding:0;max-height:none;
    display:none;}
  .gp-nav__msearch[data-open] .gp-nav__sheet{display:block;margin-top:14px;}
  .gp-nav__sh-keys{display:none;}
  .gp-nav__sug a{padding:11px 4px;}
  .gp-nav__trend{padding:0 2px;}
  .gp-nav__sh-h{padding:0 2px;}
  .gp-nav__sh-foot{padding:11px 2px 4px;flex-direction:column;align-items:flex-start;}
}

/* ---------- panel shapes: the menu fits the catalogue, not the reverse ---------- */
.gp-nav__panel{grid-template-columns:1fr 1fr 296px;}
.gp-nav__panel[data-shape="wide"]{grid-template-columns:1fr 296px;}
.gp-nav__note{margin:-8px 0 12px;font-size:12px;color:var(--gpn-muted);}
.gp-nav__note b{color:var(--gpn-cream);font-weight:600;}

/* battery finder — 80+ SKUs is a search problem, not a list problem */
.gp-nav__finder form{margin:0;}
.gp-nav__finder input{
  width:100%;height:42px;padding:0 15px;margin-bottom:12px;
  background:rgba(243,239,228,.05);border:1px solid var(--gpn-line);border-radius:10px;
  color:var(--gpn-cream);font:400 13.5px 'Poppins',sans-serif;
}
.gp-nav__finder input::placeholder{color:rgba(243,239,228,.4);}
.gp-nav__finder input:focus{outline:none;border-color:rgba(147,213,0,.5);}
.gp-nav__chips{display:flex;flex-wrap:wrap;gap:7px;}
.gp-nav__ask{
  display:inline-flex;align-items:center;gap:9px;margin-top:13px;
  font-size:12.5px;color:var(--gpn-green);
}
.gp-nav__ask svg{width:15px;height:15px;flex:none;}
.gp-nav__ask:hover{text-decoration:underline;}
.gp-nav__chips a{
  padding:7px 12px;border:1px solid var(--gpn-line);border-radius:999px;
  font-size:12.5px;color:var(--gpn-muted);
  transition:border-color .2s,color .2s,background .2s;
}
.gp-nav__chips a:hover{border-color:rgba(147,213,0,.5);color:var(--gpn-cream);background:rgba(147,213,0,.07);}

/* capacity matrix — people shop storage by size, not by product type */
.gp-nav__matrix{display:flex;flex-direction:column;gap:16px;}
.gp-nav__matrix-row h4{
  margin:0 0 9px;font-size:13.5px;font-weight:600;color:var(--gpn-cream);
  display:flex;align-items:center;gap:9px;
}
.gp-nav__matrix-row h4 a{color:var(--gpn-green);font-size:11.5px;font-weight:500;}
.gp-nav__caps{display:flex;flex-wrap:wrap;gap:6px;}
.gp-nav__caps a{
  min-width:56px;padding:8px 10px;text-align:center;
  border:1px solid var(--gpn-line);border-radius:9px;
  font-size:12.5px;font-weight:500;color:var(--gpn-muted);
  font-variant-numeric:tabular-nums;
  transition:border-color .2s,color .2s,background .2s;
}
.gp-nav__caps a:hover{border-color:rgba(147,213,0,.5);color:var(--gpn-cream);background:rgba(147,213,0,.07);}

/* tiles — a two-item category shouldn't pretend to be a six-item one */
.gp-nav__tiles{display:grid;grid-template-columns:1fr 1fr;gap:12px;grid-auto-rows:1fr;align-content:stretch;}
.gp-nav__tile{
  display:flex;flex-direction:column;justify-content:center;
  padding:16px 18px;border:1px solid var(--gpn-line);border-radius:14px;
  transition:border-color .25s var(--gpn-ease),background .25s var(--gpn-ease);
}
.gp-nav__tile:hover{border-color:rgba(147,213,0,.4);background:rgba(147,213,0,.05);}
.gp-nav__tile b{display:block;font-size:14.5px;font-weight:600;color:var(--gpn-cream);}
.gp-nav__tile span{display:block;margin-top:4px;font-size:12.5px;color:var(--gpn-muted);line-height:1.4;}

@media (max-width:980px){
  .gp-nav__acc .gp-nav__chips,.gp-nav__acc .gp-nav__caps{padding:0 0 16px 15px;}
  /* 44px, not the desktop 38 — these capacity chips ARE mobile storage navigation */
  .gp-nav__acc .gp-nav__chips a,.gp-nav__acc .gp-nav__caps a{min-height:44px;display:flex;align-items:center;justify-content:center;}
  .gp-nav__acc h4{margin:14px 0 8px 15px;font-size:13px;color:var(--gpn-cream);}
  .gp-nav__acc[data-exp] ul{max-height:640px;}
  .gp-nav__mfinder{margin:0 0 12px 15px;}
  .gp-nav__mfinder input{
    width:calc(100% - 15px);height:48px;padding:0 15px;border-radius:11px;
    background:rgba(243,239,228,.05);border:1px solid var(--gpn-line);
    color:var(--gpn-cream);font:400 14px 'Poppins',sans-serif;
  }
  .gp-nav__mfinder input:focus{outline:none;border-color:rgba(147,213,0,.5);}
  .gp-nav__acc .gp-nav__ask{margin:2px 0 16px 15px;line-height:1.45;}
}

.gp-nav[data-mode="night"]{--gpn-cream:#E7E3DA;--gpn-muted:rgba(231,227,218,.54);--gpn-green:#83BE00;}
.gp-nav[data-mode="night"] .gp-nav__feat-card{background:#D6D1C3;}
.gp-nav[data-mode="day"]{--gpn-cream:#FFFDF7;--gpn-muted:rgba(255,253,247,.7);}
</style>

<script is:inline set:html={`window.__GPNAV=${navConfigJson};window.GP_NBA=${nbaJson};`}></script>

<script is:inline>
(function(){
  'use strict';
  var nav = document.getElementById('gpNav'); if (!nav) return;
  var CFG = window.__GPNAV || {};  // server-injected per-visitor truth
  // CMS-owned offer figures, fanned out to every copy site so editing them in
  // /admin/nav is reflected everywhere (no hardcoded percentages that drift).
  var RATE_FIRST = CFG.firstOrderPct != null ? CFG.firstOrderPct : 10;
  var RATE_REFER = CFG.referralPct != null ? CFG.referralPct : 10;
  var RATE_PTS = CFG.pointsRate != null ? CFG.pointsRate : 10;
  var EST_FIRST = CFG.firstOrderEstimate || 'UGX 18,500';

  /* ---- visitor counter ----
     First-party, non-identifying: a count and a timestamp. Everything that
     distinguishes a first-time visitor from a returning one depends on this,
     so it is incremented ONCE per load, HERE, before any block (segment,
     greeting, NBA) reads it. In private browsing localStorage throws and the
     visitor is treated as returning — never show a first-order promo you
     cannot gate. */
  var gpVisits = 0, gpVisitsKnown = false;
  (function(){
    try {
      gpVisits = parseInt(localStorage.getItem('gp_visits') || '0', 10) + 1;
      localStorage.setItem('gp_visits', String(gpVisits));
      localStorage.setItem('gp_last', String(Date.now()));
      gpVisitsKnown = true;
    } catch(e){
      try { window.__gpVisitsFallback = 2; } catch(e2){}
    }
  })();

  // ---- §10 instrumentation: nav_events via the same-origin relay ----
  // Segment is derived from the POST-increment count so it matches the greeting
  // and NBA the visitor actually sees (v===1 first visit → 'new', v>1 → 'returning').
  var gpSeg = CFG.signedIn ? 'signed_in' : (gpVisitsKnown ? (gpVisits > 1 ? 'returning' : 'new') : 'unknown');
  var gpBeacon = { NBA_CLICK:1, SEARCH_SUGGEST_CLICK:1, WHATSAPP_TAP:1, BATTERY_FINDER_SUBMIT:1, MINICART_CHECKOUT:1 };
  var gpSeen = {};
  window.gpNavTrack = function(type, d){
    d = d || {};
    try {
      var body = JSON.stringify({ eventType:type, itemKey:d.itemKey||'', position:d.position||0, segment:gpSeg, term:(d.term!=null?String(d.term):null) });
      if (gpBeacon[type] && navigator.sendBeacon){ navigator.sendBeacon('/api/nav/events', new Blob([body],{type:'application/json'})); return; }
      fetch('/api/nav/events', { method:'POST', headers:{'Content-Type':'application/json'}, credentials:'same-origin', keepalive:true, body:body }).catch(function(){});
    } catch(e){}
  };
  nav.addEventListener('click', function(e){
    var t = e.target; if (!t || !t.closest) return;
    var wa = t.closest('a[href^="https://wa.me/"]');
    if (wa){ var place = wa.closest('.gp-nav__finder') ? 'panel-power' : (wa.closest('.gp-nav__sh-foot') ? 'search-foot' : 'bar'); window.gpNavTrack('WHATSAPP_TAP', { itemKey: place }); return; }
    if (t.closest('.gp-nav__sheet [data-opt]')){ window.gpNavTrack('SEARCH_SUGGEST_CLICK', {}); return; }
    if (t.closest('.gp-nav__mini a[href="/checkout"]')){ window.gpNavTrack('MINICART_CHECKOUT', {}); return; }
    var slot = t.closest('.gp-nav__nba-slot');
    if (slot){ window.gpNavTrack('NBA_CLICK', { itemKey: slot.getAttribute('data-nba') || '' }); return; }
  });
  nav.addEventListener('submit', function(e){
    var f = e.target;
    if (f && f.closest && (f.closest('.gp-nav__finder') || f.closest('.gp-nav__mfinder'))){
      var mi = f.querySelector('input[name=model]');
      window.gpNavTrack('BATTERY_FINDER_SUBMIT', { itemKey: 'power', term: mi ? mi.value : '' });
    }
  }, true);
  var mega = document.getElementById('gpNavMega');
  var burger = document.getElementById('gpNavBurger');
  var scrim = document.getElementById('gpNavScrim');
  var rail = document.getElementById('gpNavRail');
  var spark = document.getElementById('gpNavSpark');
  var panels = mega.querySelectorAll('.gp-nav__panel');
  var mq = function(){ return window.innerWidth <= 980; };
  var qs = function(k){ var m = location.search.match(new RegExp('[?&]' + k + '=([^&]+)')); return m && decodeURIComponent(m[1]); };

  /* ---- open / close ---- */
  function open(){
    nav.setAttribute('data-open','');
    burger.setAttribute('aria-expanded','true');
    burger.setAttribute('aria-label','Close menu');
    if (mq()) document.body.style.overflow = 'hidden';
  }
  function close(){
    nav.removeAttribute('data-open');
    nav.removeAttribute('data-cat');
    burger.setAttribute('aria-expanded','false');
    burger.setAttribute('aria-label','Open menu');
    document.body.style.overflow = '';
    for (var i=0;i<panels.length;i++) panels[i].removeAttribute('data-on');
    var on = rail.querySelector('.gp-nav__cat[data-on]');
    if (on){ on.removeAttribute('data-on'); on.setAttribute('aria-expanded','false'); }
    if (!current) spark.removeAttribute('data-show'); else moveSpark(current);
  }
  burger.addEventListener('click', function(){
    nav.hasAttribute('data-open') ? close() : open();
  });
  scrim.addEventListener('click', close);
  document.addEventListener('keydown', function(e){
    if (e.key === 'Escape' && nav.hasAttribute('data-open')){ close(); burger.focus(); }
  });

  /* ---- the spark ---- */
  function moveSpark(el){
    if (!el) return;
    var r = el.getBoundingClientRect(), p = rail.getBoundingClientRect();
    spark.style.width = r.width + 'px';
    spark.style.transform = 'translateX(' + (r.left - p.left) + 'px)';
    spark.setAttribute('data-show','');
  }

  /* ---- desktop: hovering a category opens ITS panel ---- */
  var cats = rail.querySelectorAll('.gp-nav__cat');
  var current = null, closeT = null;

  function show(id, el){
    if (id && !gpSeen['panel:'+id]){ gpSeen['panel:'+id]=1; window.gpNavTrack('PANEL_OPEN', { itemKey:id }); }
    for (var i=0;i<panels.length;i++){
      panels[i].removeAttribute('data-on');
      if (panels[i].getAttribute('data-panel') === id) panels[i].setAttribute('data-on','');
    }
    var prev = rail.querySelector('.gp-nav__cat[data-on]');
    if (prev){ prev.removeAttribute('data-on'); prev.setAttribute('aria-expanded','false'); }
    if (el){ el.setAttribute('data-on',''); el.setAttribute('aria-expanded','true'); }
    nav.setAttribute('data-cat', id);
    moveSpark(el);
    open();
  }

  for (var i=0;i<cats.length;i++){
    (function(el){
      var id = el.getAttribute('data-cat');
      if (id){ el.setAttribute('aria-haspopup','true'); el.setAttribute('aria-expanded','false'); }
      el.addEventListener('mouseenter', function(){
        if (mq()) return;
        clearTimeout(closeT);
        if (id) show(id, el); else { close(); moveSpark(el); }
      });
      el.addEventListener('focus', function(){
        if (mq()) return;
        if (id) show(id, el); else moveSpark(el);
      });
      if (location.pathname && el.getAttribute('href') === location.pathname){
        el.setAttribute('aria-current','page'); current = el;
      }
    })(cats[i]);
  }
  if (current) requestAnimationFrame(function(){ moveSpark(current); });

  /* a diagonal path from the rail into the panel must not close it */
  nav.addEventListener('mouseleave', function(){
    if (mq()) return;
    closeT = setTimeout(close, 260);
  });
  nav.addEventListener('mouseenter', function(){ clearTimeout(closeT); });

  /* ---- mobile: accordions, with the label staying a real link ---- */
  mega.addEventListener('click', function(e){
    var tog = e.target.closest('.gp-nav__acc-tog');
    if (!tog) return;
    var acc = tog.closest('.gp-nav__acc');
    var open_ = acc.hasAttribute('data-exp');
    open_ ? acc.removeAttribute('data-exp') : acc.setAttribute('data-exp','');
    tog.setAttribute('aria-expanded', open_ ? 'false' : 'true');
  });

  /* ---- overlay clears the real header height ---- */
  (function(){
    var bar = nav.querySelector('.gp-nav__bar');
    function measure(){
      nav.style.setProperty('--gpn-head',
        Math.round(bar.getBoundingClientRect().bottom - nav.getBoundingClientRect().top) + 'px');
    }
    measure();
    window.addEventListener('resize', measure, { passive:true });
    if (window.ResizeObserver) new ResizeObserver(measure).observe(bar);
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(measure);
  })();

  /* ---- mini cart ---- */
  (function(){
    var wrap = document.getElementById('gpNavCartWrap');
    var cut = document.getElementById('gpNavMiniCut');
    if (!wrap) return;
    var t = null;
    function open(){ if (window.innerWidth <= 980) return; clearTimeout(t); wrap.setAttribute('data-open',''); if (!gpSeen.minicart){ gpSeen.minicart=1; window.gpNavTrack('MINICART_OPEN', {}); } }
    function shut(){ t = setTimeout(function(){ wrap.removeAttribute('data-open'); }, 220); }
    wrap.addEventListener('mouseenter', open);
    wrap.addEventListener('mouseleave', shut);
    wrap.addEventListener('focusin', open);
    wrap.addEventListener('focusout', function(e){ if (!wrap.contains(e.relatedTarget)) shut(); });

    /* the cart carries the same 5pm promise as the hero and the top strip —
       urgency where the decision is actually made */
    function tick(){
      if (!cut) return;
      var d = new Date(), h = d.getHours(), m = d.getMinutes();
      if (d.getDay() === 0){ cut.innerHTML = 'Closed Sunday &mdash; this order goes out <b>Monday morning</b>'; return; }
      if (h >= 17){ cut.innerHTML = "Today's run has left &mdash; this order goes out <b>tomorrow morning</b>"; return; }
      var mins = (17 - h) * 60 - m;
      var left = mins >= 60 ? Math.floor(mins/60) + 'h ' + (mins%60) + 'm' : mins + ' minutes';
      cut.innerHTML = 'Check out in <b>' + left + '</b> and this arrives <b>today</b>.';
    }
    tick(); setInterval(tick, 60000);
  })();

  /* ---- the sale clock: same deadline as the hero, never a second one ---- */
  (function(){
    var end = new Date(nav.getAttribute('data-sale-ends')).getTime();
    if (!isFinite(end)) return;
    var cd = document.getElementById('gpNavCd');
    var note = document.getElementById('gpNavCdNote');
    var mcd = document.getElementById('gpNavMcd');
    var flashCat = rail.querySelector('.gp-nav__cat--flash');
    var cells = cd ? { d:cd.querySelector('[data-cd=d]'), h:cd.querySelector('[data-cd=h]'),
                       m:cd.querySelector('[data-cd=m]'), s:cd.querySelector('[data-cd=s]') } : null;
    function pad(n){ return (n < 10 ? '0' : '') + n; }
    function tick(){
      var left = end - Date.now();
      if (left <= 0){
        /* the sale is over: retire it rather than leave a dead promise */
        if (flashCat) flashCat.style.display = 'none';
        var p = mega.querySelector('.gp-nav__panel[data-panel=flash]');
        if (p) p.style.display = 'none';
        var mf = mega.querySelector('.gp-nav__mflash');
        if (mf) mf.style.display = 'none';
        return;
      }
      var s = Math.floor(left/1000), d = Math.floor(s/86400),
          h = Math.floor(s%86400/3600), m = Math.floor(s%3600/60), sec = s%60;
      if (cells){ cells.d.textContent = pad(d); cells.h.textContent = pad(h);
                  cells.m.textContent = pad(m); cells.s.textContent = pad(sec); }
      if (mcd) mcd.textContent = d > 0 ? d + 'd ' + pad(h) + 'h' : pad(h) + ':' + pad(m) + ':' + pad(sec);
      if (note) note.innerHTML = d === 0
        ? 'Final hours. <b>Same verified stock, less money.</b>'
        : 'Same verified stock. Less money, until the clock runs out.';
    }
    tick(); setInterval(tick, 1000);
  })();


  /* ---------------- search: suggestions, trends, recents ----------------
     Typed-ahead over a small local index. On the live site swap INDEX for a
     real predictive-search endpoint; the rendering and keyboard handling
     stay exactly as they are. */
  (function(){
    /* bundled: blob URL from window.__resources; unbundled: the live URL */
    function R(id, url){ return (window.__resources && window.__resources[id]) || url; }

    var INDEX = [];  // Stage 3 wires the real /products/suggest endpoint
    var TREND = (CFG.trending && CFG.trending.length) ? CFG.trending : [];  // seeded from the CMS (query logs)
    var RKEY = 'gp_recent';
    function recents(){ try { return JSON.parse(localStorage.getItem(RKEY) || '[]'); } catch(e){ return []; } }
    function remember(q){
      if (!q) return;
      try {
        var r = recents().filter(function(x){ return x.toLowerCase() !== q.toLowerCase(); });
        r.unshift(q); localStorage.setItem(RKEY, JSON.stringify(r.slice(0,5)));
      } catch(e){}
    }
    function esc(s){ return s.replace(/[&<>"]/g, function(m){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[m]; }); }
    function mark(t,q){
      var i = t.toLowerCase().indexOf(q.toLowerCase());
      if (i < 0 || !q) return esc(t);
      return esc(t.slice(0,i)) + '<mark>' + esc(t.slice(i,i+q.length)) + '</mark>' + esc(t.slice(i+q.length));
    }

    function wire(form){
      if (!form) return;
      var input = form.querySelector('input[type=search]');
      var sheet = form.querySelector('.gp-nav__sheet');
      if (!input || !sheet) return;
      var sel = -1;

      function idle(){
        var r = recents(), h = '';
        if (r.length){
          h += '<div class="gp-nav__sh-sec"><p class="gp-nav__sh-h">Recent<button type="button" data-clear>Clear</button></p><div class="gp-nav__sug">';
          h += r.map(function(q){ return '<a href="/shop?q=' + encodeURIComponent(q) + '" data-opt><span class="gp-nav__sug-t"><b>' + esc(q) + '</b></span></a>'; }).join('');
          h += '</div></div>';
        }
        h += '<div class="gp-nav__sh-sec"><p class="gp-nav__sh-h">Trending in Kampala</p><div class="gp-nav__trend">';
        h += TREND.map(function(t,i){ return '<a href="' + esc(t[1]) + '" data-opt><i>' + (i+1) + '</i>' + esc(t[0]) + '</a>'; }).join('');
        h += '</div></div>';
        h += foot();
        sheet.innerHTML = h;
      }
      function foot(){
        return '<div class="gp-nav__sh-foot"><a href="https://wa.me/256705004545">' +
