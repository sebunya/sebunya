        cta:'Find your model', href:'/shop?category=power&q=battery' });

      if (CTX.signedIn) c.push({ id:'refer', score:62,
        text:'Introduce a friend. You both earn <em>points</em> when their first order is delivered',
        short:'Introduce a friend. You both earn <em>points</em>',
        cta:'Get your link', href:'/account/rewards' });

      /* ---- not signed in: the useful, honest defaults (mirrors nba.ts) ---- */
      if (!CTX.signedIn && CTX.visits <= 1) c.push({ id:'welcome', score:60,
        text:'Your phone number is your account. Join free and earn <em>points</em> on every paid order',
        short:'Join free and earn <em>points</em> on every order',
        cta:'Join free', href:'/register' });

      if (!CTX.signedIn && CTX.visits > 1) c.push({ id:'signup', score:55,
        text:'Join free. Your phone number is the account, and points start with your next order',
        short:'Join free. Points start with your next order',
        cta:'Join free', href:'/register' });

      /* the live sale with its real percentage — never a typed figure */
      if (CTX.saleLive && RATE_SALE > 0) c.push({ id:'sale', score:92,
        text:'Up to <em>' + RATE_SALE + '% off</em> right now. It comes off at checkout',
        short:'Up to <em>' + RATE_SALE + '% off</em>, on now',
        cta:'Get the discount', href:'/shop' });

      /* ---- always available, and always true ---- */
      if (CTX.sunday) c.push({ id:'sunday', score:40,
        text:'Closed today. Same day delivery resumes on the <b>next working day</b>',
        short:'Delivery resumes <b>next working day</b>', href:'/support' });
      else if (CTX.beforeCutoff) c.push({ id:'cutoff', score:CTX.minsToCutoff <= 60 ? 90 : 50, urgent:CTX.minsToCutoff <= 60,
        text: CTX.minsToCutoff <= 60
          ? 'Only <em>' + CTX.minsToCutoff + ' minutes</em> left to order for delivery today'
          : 'Order before <b>' + (nav.getAttribute('data-cutoff-label') || '5:00pm') + '</b> and we deliver today in Kampala and Wakiso',
        short: CTX.minsToCutoff <= 60
          ? '<em>' + CTX.minsToCutoff + ' min</em> left for delivery today'
          : 'Order by <b>5:00pm</b> for delivery today',
        href:'/support' });
      else c.push({ id:'aftercutoff', score:44,
        text:"Today's run has left. Order now and we deliver <b>tomorrow morning</b>",
        short:'Next delivery run is <b>tomorrow</b>', href:'/support' });

      c.push({ id:'verify', score:30,
        text:'Every unit is tested before it is sold', cta:'How we verify', href:'/verification' });

      return c;
    }

    var dismissed = (st('gp_nba_x') || '').split(',').filter(Boolean);
    var list = [], i = 0, timer = null, rendered = false;

    function isNarrow(){ return window.innerWidth <= 980; }

    function render(n){
      var item = list[n]; if (!item) return;
      slot.removeAttribute('data-in');
      setTimeout(function(){
        /* mobile fits ~58 characters at 11px, not the ~72 desktop allows, so the
           longest messages carry a `short` variant rather than being ellipsised */
        txt.innerHTML = (isNarrow() && item.short) ? item.short : item.text;
        if (ctaEl){
          ctaEl.innerHTML = item.cta ? item.cta + ' &rarr;' : '';
          ctaEl.hidden = !item.cta;
        }
        slot.setAttribute('href', item.href || '#');
        slot.setAttribute('data-nba', item.id);
        if (!gpSeen['nba:'+item.id]){ gpSeen['nba:'+item.id]=1; window.gpNavTrack('NBA_IMPRESSION', { itemKey:item.id, position:n+1 }); }
        if (dot){ item.urgent ? dot.setAttribute('data-urgent','') : dot.removeAttribute('data-urgent'); }
        slot.setAttribute('data-in','');
      }, rendered ? 320 : 0);
      rendered = true;
    }

    /* deliberately no rotation — see the note above */
    function start(){}

    function build(source){
      list = (source || candidates())
        .filter(function(x){ return dismissed.indexOf(x.id) < 0; })
        .sort(function(a,b){ return (b.score||0) - (a.score||0); })
        .slice(0,3);   /* only the first is shown; the rest are dismissal fallbacks */
      if (!list.length) list = [{ id:'fallback', score:0, text:'Verified original electronics, delivered across Uganda', href:'/shop' }];
      i = 0; render(0); start();
    }

    if (xBtn) xBtn.addEventListener('click', function(){
      var id = slot.getAttribute('data-nba');
      if (id && dismissed.indexOf(id) < 0){ dismissed.push(id); set('gp_nba_x', dismissed.join(',')); }
      if (id) window.gpNavTrack('NBA_DISMISS', { itemKey:id });
      build(window.GP_NBA);
    });

    /* real engine wins if it is there; otherwise the local set renders immediately */
    try { build(window.GP_NBA); }
    catch (err){ if (window.console) console.error('[gp-nba]', err); }
    if (window.GP_NBA_PROMISE && window.GP_NBA_PROMISE.then){
      window.GP_NBA_PROMISE.then(function(rows){ if (rows && rows.length) build(rows); }).catch(function(){});
    }
    /* the cut-off candidates go stale as the clock moves */
    setInterval(function(){ if (!window.GP_NBA) build(); }, 60000);
  })();

  /* ---- automatic day / night, from the visitor's own clock ----
     Uganda sits on the equator, so a fixed split is accurate all year;
     reading the DEVICE clock means a Ugandan abroad still gets their own
     local mode. ?mode=day / ?mode=night forces it for QA. */
  (function(){
    var DAY_START = 6.5, DAY_END = 18.75;
    function current(){
      var d = new Date(), h = d.getHours() + d.getMinutes()/60;
      return (h >= DAY_START && h < DAY_END) ? 'day' : 'night';
    }
    function apply(m){ if (nav.getAttribute('data-mode') !== m) nav.setAttribute('data-mode', m); }
    var forced = qs('mode');
    apply(forced === 'day' || forced === 'night' ? forced : current());
    if (forced !== 'day' && forced !== 'night'){
      setInterval(function(){ apply(current()); }, 120000);
      document.addEventListener('visibilitychange', function(){ if (!document.hidden) apply(current()); });
    }
  })();
})();
</script>
