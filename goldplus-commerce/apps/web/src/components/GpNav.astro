    function start(){}

    function build(source){
      list = (source || candidates())
        .filter(function(x){ return dismissed.indexOf(x.id) < 0; })
        .sort(function(a,b){ return (b.score||0) - (a.score||0); })
        .slice(0,3);   /* only the first is shown; the rest are dismissal fallbacks */
      if (!list.length) list = [{ id:'fallback', score:0, text:'Verified original electronics, delivered across Uganda', href:'/shop' }];
      i = 0; render(0); start();
    }

    if (xBtn) xBtn.addEventListener('click', function(){
