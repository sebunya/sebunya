      input.addEventListener('keydown', function(e){
        var o = opts();
        if (e.key === 'ArrowDown'){ e.preventDefault(); sel = Math.min(sel+1, o.length-1); highlight(); }
        else if (e.key === 'ArrowUp'){ e.preventDefault(); sel = Math.max(sel-1, -1); highlight(); }
        else if (e.key === 'Enter'){
