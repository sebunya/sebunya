      function highlight(){
        var o = opts();
        for (var i=0;i<o.length;i++) o[i].removeAttribute('data-sel');
        if (sel >= 0 && o[sel]){ o[sel].setAttribute('data-sel',''); }
      }
      function show(){ form.setAttribute('data-open',''); }
      function hide(){ form.removeAttribute('data-open'); sel = -1; }

      input.addEventListener('focus', function(){ if (!input.value) idle(); else results(input.value); show(); });
      var debT = null;
      input.addEventListener('input', function(){
        sel = -1; show();
        var v = input.value.trim();
