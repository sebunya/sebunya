  (function(){
    var slot = document.getElementById('gpNavNbaSlot');
    var txt  = document.getElementById('gpNavNbaText');
    var ctaEl = document.getElementById('gpNavNbaCta');
    var dot  = nav.querySelector('.gp-nav__dot');
    var xBtn = document.getElementById('gpNavNbaX');
    if (!slot) return;

    function st(k){ try { return localStorage.getItem(k); } catch(e){ return null; } }
    function set(k,v){ try { localStorage.setItem(k,v); } catch(e){} }

    var d = new Date(), hour = d.getHours(), day = d.getDay();
    var minsToCutoff = (17 - hour) * 60 - d.getMinutes();
    var saleEnd = new Date(nav.getAttribute('data-sale-ends')).getTime();

    var CTX = {
