  });
  nav.addEventListener('submit', function(e){
    var f = e.target;
    if (f && f.closest && (f.closest('.gp-nav__finder') || f.closest('.gp-nav__mfinder'))){
      var mi = f.querySelector('input[name=q]') || f.querySelector('input[name=model]');
      window.gpNavTrack('BATTERY_FINDER_SUBMIT', { itemKey: 'power', term: mi ? mi.value : '' });
    }
  }, true);
  var mega = document.getElementById('gpNavMega');
  var burger = document.getElementById('gpNavBurger');
  var scrim = document.getElementById('gpNavScrim');
  var rail = document.getElementById('gpNavRail');
  var spark = document.getElementById('gpNavSpark');
  var panels = mega.querySelectorAll('.gp-nav__panel');
  var mq = function(){ return window.innerWidth <= 980; };
  var qs = function(k){ var m = location.search.match(new RegExp('[?&]' + k + '=([^&]+)')); return m && decodeURIComponent(m[1]); };

  /* ---- open / close ---- */
  function open(){
    nav.setAttribute('data-open','');
