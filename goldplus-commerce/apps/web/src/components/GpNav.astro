  }

  /* ---- desktop: hovering a category opens ITS panel ---- */
  var cats = rail.querySelectorAll('.gp-nav__cat');
  var current = null, closeT = null;

  function show(id, el){
    if (id && !gpSeen['panel:'+id]){ gpSeen['panel:'+id]=1; window.gpNavTrack('PANEL_OPEN', { itemKey:id }); }
    for (var i=0;i<panels.length;i++){
      panels[i].removeAttribute('data-on');
      if (panels[i].getAttribute('data-panel') === id) panels[i].setAttribute('data-on','');
    }
    var prev = rail.querySelector('.gp-nav__cat[data-on]');
    if (prev){ prev.removeAttribute('data-on'); prev.setAttribute('aria-expanded','false'); }
