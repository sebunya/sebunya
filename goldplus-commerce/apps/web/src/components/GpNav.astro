<script is:inline set:html={`window.__GPNAV=${navConfigJson};window.GP_NBA=${nbaJson};`}></script>

<script is:inline>
  /* The shop's clock is Africa/Kampala, and its cutoff and closed days are set
     by the operator in business_info. Both client blocks below used to read
     the VISITOR's clock and a hardcoded 17:00/Sunday, so a customer outside
     EAT, or one whose device clock was off, was told a deadline the shop does
     not keep, and changing the cutoff in admin moved nothing here. */
  function gpShopNow(){
    try { return new Date(new Date().toLocaleString('en-US', { timeZone: 'Africa/Kampala' })); }
    catch (e) { return new Date(); }
  }
  function gpCutoffHour(el){
    var v = parseInt(el && el.getAttribute('data-cutoff-hour'), 10);
    return isFinite(v) ? v : 17;
  }
  function gpClosedDays(el){
    var raw = (el && el.getAttribute('data-closed-days')) || '';
    return raw.split(',').map(function(x){ return parseInt(x, 10); }).filter(function(x){ return isFinite(x); });
  }

(function(){
  'use strict';
  var nav = document.getElementById('gpNav'); if (!nav) return;
  var CFG = window.__GPNAV || {};  // server-injected per-visitor truth
  // CMS-owned offer figures, fanned out to every copy site so editing them in
  // /admin/nav is reflected everywhere (no hardcoded percentages that drift).
  // The only discount the popover may name is the live storewide promotion.
  var SALE_ON = CFG.saleActive === true && Number(CFG.salePct) > 0;
  var RATE_SALE = SALE_ON ? Number(CFG.salePct) : 0;
  var RATE_PTS = CFG.pointsRate != null ? CFG.pointsRate : 0; // 0 = redemption not configured; claim no shilling value

  /* ---- visitor counter ----
     First-party, non-identifying: a count and a timestamp. Everything that
     distinguishes a first-time visitor from a returning one depends on this,
     so it is incremented ONCE per load, HERE, before any block (segment,
     greeting, NBA) reads it. In private browsing localStorage throws and the
     visitor is treated as returning, never show a first-order promo you
     cannot gate. */
  var gpVisits = 0, gpVisitsKnown = false;
  (function(){
    try {
      gpVisits = parseInt(localStorage.getItem('gp_visits') || '0', 10) + 1;
      localStorage.setItem('gp_visits', String(gpVisits));
      localStorage.setItem('gp_last', String(Date.now()));
