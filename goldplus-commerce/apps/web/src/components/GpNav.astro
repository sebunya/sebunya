  // Segment is derived from the POST-increment count so it matches the greeting
  // and NBA the visitor actually sees (v===1 first visit → 'new', v>1 → 'returning').
  var gpSeg = CFG.signedIn ? 'signed_in' : (gpVisitsKnown ? (gpVisits > 1 ? 'returning' : 'new') : 'unknown');
  var gpBeacon = { NBA_CLICK:1, SEARCH_SUGGEST_CLICK:1, WHATSAPP_TAP:1, BATTERY_FINDER_SUBMIT:1, MINICART_CHECKOUT:1 };
  var gpSeen = {};
  window.gpNavTrack = function(type, d){
    d = d || {};
