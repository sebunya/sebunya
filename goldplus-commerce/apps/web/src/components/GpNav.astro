  /* ---- mini cart ---- */
  (function(){
    var wrap = document.getElementById('gpNavCartWrap');
    var cut = document.getElementById('gpNavMiniCut');
    if (!wrap) return;
    var t = null;
    function open(){ if (window.innerWidth <= 980) return; clearTimeout(t); wrap.setAttribute('data-open',''); if (!gpSeen.minicart){ gpSeen.minicart=1; window.gpNavTrack('MINICART_OPEN', {}); } }
    function shut(){ t = setTimeout(function(){ wrap.removeAttribute('data-open'); }, 220); }
