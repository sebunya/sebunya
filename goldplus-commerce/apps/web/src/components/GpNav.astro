      var body = JSON.stringify({ eventType:type, itemKey:d.itemKey||'', position:d.position||0, segment:gpSeg, term:(d.term!=null?String(d.term):null) });
      if (gpBeacon[type] && navigator.sendBeacon){ navigator.sendBeacon('/api/nav/events', new Blob([body],{type:'application/json'})); return; }
      fetch('/api/nav/events', { method:'POST', headers:{'Content-Type':'application/json'}, credentials:'same-origin', keepalive:true, body:body }).catch(function(){});
    } catch(e){}
  };
  nav.addEventListener('click', function(e){
    var t = e.target; if (!t || !t.closest) return;
    var wa = t.closest('a[href^="https://wa.me/"]');
    if (wa){ var place = wa.closest('.gp-nav__finder') ? 'panel-power' : (wa.closest('.gp-nav__sh-foot') ? 'search-foot' : 'bar'); window.gpNavTrack('WHATSAPP_TAP', { itemKey: place }); return; }
    if (t.closest('.gp-nav__sheet [data-opt]')){ window.gpNavTrack('SEARCH_SUGGEST_CLICK', {}); return; }
    if (t.closest('.gp-nav__mini a[href="/checkout"]')){ window.gpNavTrack('MINICART_CHECKOUT', {}); return; }
    var slot = t.closest('.gp-nav__nba-slot');
