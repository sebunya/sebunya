---
/**
 * Goldie, the GoldPlus shop host: a launcher and a panel on every page. The
 * browser posts the conversation to /api/assistant/chat (same origin) and
 * renders the streamed answer. Product cards and action chips are built from
 * the validated `products` and `links` events the server sends, never from
 * the model's prose. Rendered only when the server has an API key.
 *
 * The transcript lives in sessionStorage for this tab only (wrapped in
 * try/catch); the server stores nothing. Clearing it clears the display, not
 * the server's fairness counters (by design).
 *
 * Voice and look (2026-10-12 redesign): Goldie greets by time of day, answers
 * in one to three plain sentences, and offers the next step as a chip.
 *
 * Awareness (2026-10-13, researched): motion only ever carries information,
 * and nothing floats over content on a phone. Baymard's usability testing
 * found floating chat on mobile the most harmful pattern (it covers swatches,
 * filters and copy and cannot be moved), found invitations on filter and
 * checkout pages disruptive, and found user-initiated chat fast and welcome.
 * Trigger benchmarks put a proactive message at 30 to 45 seconds of reading
 * or 60 percent scroll, page-specific, once. So:
 *  - the launcher rises in once the page has loaded and gone idle;
 *  - on desktop, one teaser written for the page slides out of the launcher
 *    after 30 s or 60% read, once per visitor per week, never on checkout,
 *    cart, account, finder, search or filter pages; it folds to an unread
 *    dot after a minute and the panel then opens with the same message and
 *    chips, so nothing is lost to the timer (WCAG 2.2.1);
 *  - on phones there is no bubble: the pill itself carries a short line
 *    ("Will it fit your phone?") and the panel opens with the full message;
 *    the pill folds to the avatar while scrolling down and lifts above the
 *    product page's buy bar;
 *  - the product page also offers two inline "Ask Goldie" questions in the
 *    content flow (AskGoldie.astro), the Rufus pattern, user-initiated.
 * The conversation panel's code (src/scripts/goldie-panel.ts) loads on the
 * first sign of interest; only the launcher and this awareness layer ship with
 * every page. Cards with a catalogue id offer Add to cart from the chat.
 * Impressions, taps and dismissals are counted as NBA items
 * ("goldie-<context>") in the nav telemetry, so the admin nav report says
 * whether it earns its place. Everything respects prefers-reduced-motion.
 *
 * The Goldie wordmark (2026-10-13): the name carries one lime-to-gold glint
 * that crosses the word, and only when it means something: once per visit as
 * the launcher arrives (with one ring from the avatar), when Goldie has a
 * message waiting, on hover or keyboard focus, and as the panel opens. No loop,
 * no idle motion, no change to the pill's size (nothing on the page moves);
 * plain text in forced-colours mode, still under reduced motion.
 */
import { assistantEnabled } from '../lib/assistant';
interface Props { whatsappUrl: string; cutoffHour?: number }
const { whatsappUrl, cutoffHour = 17 } = Astro.props;
const enabled = assistantEnabled();
---
{enabled && (
  <div id="gp-assistant" class="gp-assistant" data-whatsapp={whatsappUrl} data-endpoint="/api/assistant/chat" data-cutoff-hour={String(cutoffHour)}>
    <button type="button" class="gp-assistant__launch" aria-haspopup="dialog" aria-controls="gp-assistant-panel" aria-expanded="false" data-launch>
      <span class="gp-assistant__avatar gp-assistant__avatar--launch" aria-hidden="true"><span>G</span><i class="gp-assistant__badge" data-badge hidden></i></span>
      <span class="gp-assistant__launchtext"><strong>Ask <span class="gp-goldie" data-goldie data-text="Goldie">Goldie</span></strong><small>GoldPlus shop help</small></span>
    </button>

    <div class="gp-assistant__teaser" role="status" aria-live="polite" hidden data-teaser>
      <button type="button" class="gp-assistant__teaser-x" aria-label="Dismiss Goldie's message" data-teaser-close>
        <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
      <button type="button" class="gp-assistant__teaser-body" data-teaser-open>
        <span class="gp-assistant__avatar gp-assistant__avatar--sm" aria-hidden="true"><span>G</span></span>
        <span class="gp-assistant__teaser-text"><b>Goldie</b><span data-teaser-text></span></span>
      </button>
      <div class="gp-assistant__teaser-chips" data-teaser-chips></div>
    </div>

    <section id="gp-assistant-panel" class="gp-assistant__panel" role="dialog" aria-label="Goldie, the GoldPlus shop assistant" aria-modal="false" hidden data-panel>
      <header class="gp-assistant__head">
        <span class="gp-assistant__avatar" aria-hidden="true"><span>G</span></span>
        <div class="gp-assistant__who">
          <p class="gp-assistant__title"><span class="gp-goldie" data-goldie-title data-text="Goldie">Goldie</span></p>
          <p class="gp-assistant__sub"><span class="gp-assistant__dot" aria-hidden="true"></span>GoldPlus shop help · AI, answers from the shelf</p>
        </div>
        <div class="gp-assistant__headbtns">
          <button type="button" class="gp-assistant__clear" data-clear hidden>Start over</button>
          <button type="button" class="gp-assistant__close" aria-label="Close Goldie" data-close>
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
          </button>
        </div>
      </header>

      <div class="gp-assistant__log" role="log" aria-live="polite" aria-relevant="additions" data-log></div>

      <div class="gp-assistant__starters" data-starters>
        <button type="button" data-starter="Find a battery for my phone">Battery for my phone</button>
        <button type="button" data-prefill="How much is ">Check a price</button>
        <button type="button" data-starter="Do you deliver to my area and what does it cost?">Delivery</button>
        <button type="button" data-starter="Where is the shop and when are you open?">Visit the shop</button>
      </div>

      <form class="gp-assistant__form" data-form>
        <label class="sr-only" for="gp-assistant-input">Message Goldie</label>
        <textarea id="gp-assistant-input" rows="1" maxlength="2000" placeholder="Type your question…" autocomplete="off" data-input></textarea>
        <button type="submit" class="gp-assistant__send" aria-label="Send" data-send>
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </button>
      </form>
      <p class="gp-assistant__foot">
        <span>Goldie is an AI. Prices and stock on the cards are live; check the product page before you pay.</span>
        <a class="gp-assistant__wa" href={whatsappUrl} target="_blank" rel="noopener noreferrer">
          <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 2a8 8 0 1 1-4.2 14.8l-.3-.2-3 .8.8-2.9-.2-.3A8 8 0 0 1 12 4zm-3 4.5c-.2 0-.5.1-.7.3-.3.3-1 1-1 2.4s1 2.8 1.2 3c.1.2 2 3.2 5 4.4 2.5 1 3 .8 3.5.7.5 0 1.7-.7 1.9-1.4.2-.7.2-1.2.2-1.4-.1-.1-.3-.2-.6-.3l-2-1c-.3-.1-.5-.1-.7.1l-.9 1.1c-.2.2-.3.2-.6.1-.3-.2-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6l.5-.6.3-.5c.1-.2 0-.4 0-.5l-.9-2.2c-.2-.5-.4-.5-.6-.5H9z"/></svg>
          Prefer a person? WhatsApp us
        </a>
      </p>
    </section>
  </div>
)}

<style is:global>
  /* Global on purpose: the script creates the bubbles, cards and chips after render. */
  .gp-assistant { --gp-green: #93d500; --gp-green-deep: #456b00; --gp-ink: #0a0a0a; --gp-paper: #fbfbf7; --gp-line: #e6e6df; --gp-mute: #6b6b64; --gp-ease: cubic-bezier(.2,.8,.2,1); font-family: inherit; }
  .gp-assistant__avatar { width: 38px; height: 38px; flex: none; display: grid; place-items: center; border-radius: 9999px; background: var(--gp-green); color: var(--gp-ink); font-weight: 900; font-size: 1.05rem; letter-spacing: -.02em; box-shadow: inset 0 0 0 2px rgba(10,10,10,.12); }
  .gp-assistant__avatar--sm { width: 28px; height: 28px; font-size: .8rem; }
  .gp-assistant__launch {
    position: fixed; right: max(1rem, env(safe-area-inset-right)); bottom: calc(max(1rem, env(safe-area-inset-bottom)) + 64px + var(--gp-lift, 0px));
    z-index: 46; display: inline-flex; align-items: center; gap: .6rem; padding: .45rem 1rem .45rem .45rem; border: 0; border-radius: 9999px;
    background: var(--gp-ink); color: #fff; box-shadow: 0 10px 30px rgba(0,0,0,.28); cursor: pointer; min-height: 48px; text-align: left;
    transition: transform .2s var(--gp-ease), box-shadow .2s var(--gp-ease);
  }
  .gp-assistant__launch:hover { transform: translateY(-1px); box-shadow: 0 14px 34px rgba(0,0,0,.32); }
  .gp-assistant__launchtext { display: grid; line-height: 1.1; }
  .gp-assistant__launchtext strong { font-size: .84rem; font-weight: 800; }
  .gp-assistant__launchtext small { font-size: .66rem; color: #cfcfc7; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  /* The launcher-to-panel morph (View Transitions): one surface grows into the panel, the name travels into the header. */
  ::view-transition-group(goldie-surface) { animation-duration: .36s; animation-timing-function: cubic-bezier(.2,.8,.2,1); border-radius: 1.25rem; overflow: clip; }
  ::view-transition-old(goldie-surface), ::view-transition-new(goldie-surface) { height: 100%; width: 100%; object-fit: cover; object-position: right bottom; animation-duration: .24s; }
  ::view-transition-group(goldie-name) { animation-duration: .36s; animation-timing-function: cubic-bezier(.2,.8,.2,1); }
  .gp-assistant__launch--nudge .gp-assistant__avatar--launch { animation: gp-nudge 1.1s var(--gp-ease) 1; }
  @keyframes gp-nudge { 0%,100% { transform: rotate(0) } 20% { transform: rotate(-12deg) } 45% { transform: rotate(10deg) } 70% { transform: rotate(-6deg) } }
  /* Arrival: the launcher is not in the first paint; it rises once the page has settled. */
  .gp-assistant__launch--pending { opacity: 0; transform: translateY(16px) scale(.96); pointer-events: none; }
  .gp-assistant__launch--loading { cursor: progress; }
  .gp-assistant__launch--loading .gp-assistant__avatar--launch { animation: gp-ring 1.2s var(--gp-ease) infinite; }
  .gp-assistant__launch--arrive { animation: gp-arrive .5s var(--gp-ease) both; }
  @keyframes gp-arrive { from { opacity: 0; transform: translateY(16px) scale(.96) } to { opacity: 1; transform: none } }
  .gp-assistant__avatar--launch { position: relative; }
  /* The Goldie wordmark. The real text is always drawn solid; the glint is a copy laid over it
     (::after, hidden from screen readers) whose lime-to-gold band crosses once. If a browser cannot
     paint clipped text, the overlay simply does not show and the name stays plain white. */
  .gp-goldie { position: relative; display: inline-block; }
  @supports ((-webkit-background-clip: text) or (background-clip: text)) {
    .gp-goldie::after {
      content: attr(data-text); content: attr(data-text) / ""; position: absolute; inset: 0; pointer-events: none;
      background-image: linear-gradient(105deg, transparent 0 33%, #c6f25a 42%, #f2c744 50%, #c6f25a 58%, transparent 67% 100%);
      background-size: 300% 100%; background-position: 100% 0; background-repeat: no-repeat;
      -webkit-background-clip: text; background-clip: text; color: transparent; -webkit-text-fill-color: transparent;
    }
  }
  .gp-goldie--glint::after { animation: gp-glint 1.2s cubic-bezier(.45,0,.2,1) both; }
  @media (hover: hover) { .gp-assistant__launch:hover .gp-goldie::after { animation: gp-glint-hover .9s cubic-bezier(.45,0,.2,1) both; } }
  .gp-assistant__launch:focus-visible .gp-goldie::after { animation: gp-glint-hover .9s cubic-bezier(.45,0,.2,1) both; }
  @keyframes gp-glint { from { background-position: 100% 0 } to { background-position: 0 0 } }
  @keyframes gp-glint-hover { from { background-position: 100% 0 } to { background-position: 0 0 } }
  /* Hello: once per visit, the avatar sends one ring out as the name glints. */
  .gp-assistant__launch--hello .gp-assistant__avatar--launch { animation: gp-ring 1.3s var(--gp-ease) .1s 1; }
  @media (forced-colors: active) { .gp-goldie::after { display: none; } }
  .gp-assistant__badge { position: absolute; top: -2px; right: -2px; width: 12px; height: 12px; border-radius: 9999px; background: #ff5a36; border: 2px solid var(--gp-ink); }
  .gp-assistant__badge[hidden] { display: none; }
  /* On phones the pill folds to the avatar while the shopper scrolls down, and opens again when they pause. */
  @media (max-width: 640px) {
    .gp-assistant__launch { transition: transform .2s var(--gp-ease), box-shadow .2s var(--gp-ease), padding .25s var(--gp-ease); }
    .gp-assistant__launchtext { max-width: 9rem; overflow: hidden; white-space: nowrap; transition: max-width .25s var(--gp-ease), opacity .2s; }
    .gp-assistant__launch--mini { padding-right: .45rem; }
    .gp-assistant__launch--mini .gp-assistant__launchtext { max-width: 0; opacity: 0; }
    /* The pill carrying a message: wider, the line in bold, "Ask Goldie" beneath. */
    .gp-assistant__launch--msg .gp-assistant__launchtext { max-width: 14rem; }
    .gp-assistant__launch--msg.gp-assistant__launch--mini .gp-assistant__launchtext { max-width: 0; }
    .gp-assistant__launch--msg .gp-assistant__avatar--launch { animation: gp-ring 1.5s var(--gp-ease) .2s 2; }
  }
  /* The teaser: one message for this page, anchored to the launcher. */
  .gp-assistant__teaser[hidden] { display: none; }
  .gp-assistant__teaser {
    position: fixed; right: max(1rem, env(safe-area-inset-right)); bottom: calc(max(1rem, env(safe-area-inset-bottom)) + 124px + var(--gp-lift, 0px)); z-index: 46;
    width: min(364px, calc(100vw - 2rem)); background: var(--gp-paper); color: var(--gp-ink); border: 1px solid var(--gp-line);
    border-radius: 1.1rem; border-bottom-right-radius: .4rem; box-shadow: 0 18px 44px rgba(0,0,0,.26); padding: .7rem .7rem .6rem; transform-origin: 92% 100%;
  }
  .gp-assistant__teaser--enter { animation: gp-rise .32s var(--gp-ease) both; }
  .gp-assistant__teaser--enter .gp-assistant__avatar--sm { animation: gp-ring 1.5s var(--gp-ease) .25s 2; }
  @keyframes gp-ring { 0% { box-shadow: inset 0 0 0 2px rgba(10,10,10,.12), 0 0 0 0 rgba(147,213,0,.55) } 100% { box-shadow: inset 0 0 0 2px rgba(10,10,10,.12), 0 0 0 14px rgba(147,213,0,0) } }
  .gp-assistant__teaser--leave { animation: gp-sink .22s var(--gp-ease) both; }
  @keyframes gp-sink { to { opacity: 0; transform: translateY(10px) scale(.96) } }
  .gp-assistant__teaser-x { position: absolute; top: .35rem; right: .35rem; width: 32px; height: 32px; border: 0; border-radius: 9999px; background: transparent; color: var(--gp-mute); display: grid; place-items: center; cursor: pointer; }
  .gp-assistant__teaser-x:hover { background: #edede6; color: var(--gp-ink); }
  .gp-assistant__teaser-body { display: flex; align-items: flex-start; gap: .6rem; width: 100%; padding: 0 1.9rem 0 0; border: 0; background: transparent; color: inherit; text-align: left; cursor: pointer; font: inherit; }
  .gp-assistant__teaser-text { display: grid; gap: .15rem; font-size: .88rem; line-height: 1.45; min-width: 0; }
  .gp-assistant__teaser-text b { font-size: .7rem; font-weight: 900; letter-spacing: .04em; text-transform: uppercase; color: var(--gp-green-deep); }
  .gp-assistant__teaser-chips { display: flex; flex-wrap: wrap; gap: .4rem; margin: .6rem 0 0 2.35rem; }
  .gp-assistant__teaser-chips:empty { display: none; }
  .gp-assistant__teaser-chips button { border: 1.5px solid var(--gp-green-deep); background: #fff; color: var(--gp-green-deep); border-radius: 9999px; padding: .4rem .8rem; font-size: .78rem; font-weight: 800; cursor: pointer; min-height: 36px; font-family: inherit; transition: background .15s, color .15s; }
  .gp-assistant__teaser-chips button:hover { background: var(--gp-green-deep); color: #fff; }
  .gp-assistant__teaser-x:focus-visible, .gp-assistant__teaser-body:focus-visible, .gp-assistant__teaser-chips button:focus-visible { outline: 3px solid var(--gp-green); outline-offset: 2px; }
  .gp-assistant--open .gp-assistant__teaser { display: none; }
  .gp-assistant__launch:focus-visible, .gp-assistant__close:focus-visible, .gp-assistant__clear:focus-visible, .gp-assistant__send:focus-visible, .gp-assistant__starters button:focus-visible, .gp-assistant__chip:focus-visible, .gp-assistant__card a:focus-visible { outline: 3px solid var(--gp-green); outline-offset: 2px; }
  .gp-assistant--open .gp-assistant__launch { display: none; }
  .gp-assistant__panel[hidden] { display: none; }
  .gp-assistant__panel {
    /* Above the site header (z 60-62) and its menus (z 70): on phones the panel is the whole screen and its own close button must never sit under the nav. */
    position: fixed; right: max(1rem, env(safe-area-inset-right)); bottom: max(1rem, env(safe-area-inset-bottom)); z-index: 80;
    width: min(400px, calc(100vw - 2rem)); height: min(640px, calc(100vh - 2rem)); display: flex; flex-direction: column;
    background: var(--gp-paper); color: var(--gp-ink); border: 1px solid var(--gp-line); border-radius: 1.25rem; box-shadow: 0 24px 60px rgba(0,0,0,.3); overflow: hidden;
    transform-origin: 92% 100%;
  }
  .gp-assistant__panel--enter { animation: gp-rise .26s var(--gp-ease) both; }
  @keyframes gp-rise { from { opacity: 0; transform: translateY(14px) scale(.96) } to { opacity: 1; transform: none } }
  @media (max-width: 480px) { .gp-assistant__panel { right: 0; bottom: 0; width: 100vw; height: 100dvh; border-radius: 0; } }
  .gp-assistant__head { display: flex; align-items: center; gap: .7rem; padding: .8rem .9rem; background: var(--gp-ink); color: #fff; }
  .gp-assistant__who { min-width: 0; flex: 1; }
  .gp-assistant__title { margin: 0; font-weight: 900; font-size: 1rem; letter-spacing: -.01em; }
  .gp-assistant__sub { margin: .1rem 0 0; font-size: .7rem; color: #cfcfc7; display: flex; align-items: center; gap: .35rem; }
  .gp-assistant__dot { width: 7px; height: 7px; border-radius: 9999px; background: var(--gp-green); box-shadow: 0 0 0 3px rgba(147,213,0,.25); }
  .gp-assistant__headbtns { display: flex; align-items: center; gap: .4rem; }
  .gp-assistant__clear { border: 1px solid #4a4a46; background: transparent; color: #cfcfc7; font-size: .66rem; font-weight: 700; border-radius: 9999px; padding: .3rem .65rem; cursor: pointer; }
  .gp-assistant__clear[hidden] { display: none; }
  .gp-assistant__close { border: 0; background: transparent; color: #fff; cursor: pointer; display: grid; place-items: center; min-width: 44px; min-height: 44px; border-radius: 9999px; }
  .gp-assistant__close:hover { background: rgba(255,255,255,.1); }
  .gp-assistant__log { flex: 1; overflow-y: auto; padding: 1rem .9rem; display: flex; flex-direction: column; gap: .55rem; overflow-anchor: auto; }
  .gp-assistant__row { display: flex; align-items: flex-end; gap: .45rem; max-width: 92%; }
  .gp-assistant__row--user { align-self: flex-end; }
  .gp-assistant__row--bot { align-self: flex-start; }
  .gp-assistant__msg { padding: .62rem .85rem; border-radius: 1.1rem; font-size: .9rem; line-height: 1.5; white-space: pre-wrap; overflow-wrap: anywhere; min-width: 0; }
  .gp-assistant__msg--user { background: var(--gp-ink); color: #fff; border-bottom-right-radius: .35rem; }
  .gp-assistant__msg--bot { background: #fff; border: 1px solid var(--gp-line); border-bottom-left-radius: .35rem; }
  .gp-assistant__msg--bot a { color: var(--gp-green-deep); font-weight: 700; text-decoration: underline; }
  .gp-assistant__msg--bot strong { font-weight: 800; }
  .gp-assistant__msg--error { background: #fff5f4; border: 1px solid #f1c7c2; color: #8a1f1f; }
  .gp-assistant__status { align-self: flex-start; margin-left: 2.3rem; font-size: .72rem; color: var(--gp-mute); }
  .gp-assistant__typing { display: inline-flex; gap: 4px; padding: .7rem .9rem; }
  .gp-assistant__typing i { width: 7px; height: 7px; border-radius: 9999px; background: var(--gp-mute); animation: gp-bounce 1.1s infinite var(--gp-ease); }
  .gp-assistant__typing i:nth-child(2) { animation-delay: .15s } .gp-assistant__typing i:nth-child(3) { animation-delay: .3s }
  @keyframes gp-bounce { 0%,70%,100% { transform: translateY(0); opacity: .45 } 35% { transform: translateY(-5px); opacity: 1 } }
  .gp-assistant__chips { display: flex; flex-wrap: wrap; gap: .4rem; margin-left: 2.3rem; max-width: 92%; }
  .gp-assistant__chip { display: inline-flex; align-items: center; gap: .35rem; border: 1.5px solid var(--gp-green-deep); background: #fff; color: var(--gp-green-deep); border-radius: 9999px; padding: .4rem .8rem; font-size: .78rem; font-weight: 800; text-decoration: none; min-height: 36px; transition: background .15s, color .15s; }
  .gp-assistant__chip:hover { background: var(--gp-green-deep); color: #fff; }
  .gp-assistant__cards { display: grid; gap: .5rem; margin-left: 2.3rem; max-width: 92%; }
  .gp-assistant__card { background: #fff; border: 1px solid var(--gp-line); border-radius: 1rem; padding: .55rem .65rem; transition: border-color .15s; }
  .gp-assistant__card:hover { border-color: var(--gp-green); }
  .gp-assistant__card-link { display: grid; grid-template-columns: 60px 1fr; gap: .65rem; align-items: center; text-decoration: none; color: inherit; }
  .gp-assistant__card-link:focus-visible { outline: 3px solid var(--gp-green); outline-offset: 2px; border-radius: .6rem; }
  /* Add to cart sits under the facts, in line with the text column: ask, see, add, without leaving the chat. */
  .gp-assistant__card-act { display: flex; align-items: center; gap: .5rem; margin: .5rem 0 0 calc(60px + .65rem); flex-wrap: wrap; }
  .gp-assistant__add { display: inline-flex; align-items: center; min-height: 36px; padding: .35rem .9rem; border: 0; border-radius: 9999px; background: var(--gp-green); color: var(--gp-ink); font: inherit; font-size: .78rem; font-weight: 900; text-decoration: none; cursor: pointer; transition: transform .15s var(--gp-ease), background .15s; }
  .gp-assistant__add:hover { transform: translateY(-1px); }
  .gp-assistant__add[disabled] { opacity: .6; cursor: progress; transform: none; }
  .gp-assistant__add--done { background: #fff; border: 1.5px solid var(--gp-green-deep); color: var(--gp-green-deep); }
  .gp-assistant__add:focus-visible { outline: 3px solid var(--gp-green); outline-offset: 2px; }
  .gp-assistant__add-note { font-size: .7rem; color: var(--gp-mute); }
  .gp-assistant__add-note:empty { display: none; }
  .gp-assistant__card img, .gp-assistant__card .ph { width: 60px; height: 60px; object-fit: cover; border-radius: .6rem; background: #f0f0ea; }
  .gp-assistant__card b { display: block; font-size: .84rem; line-height: 1.3; font-weight: 800; }
  .gp-assistant__card .price { display: block; margin-top: .2rem; font-size: .9rem; font-weight: 900; color: var(--gp-ink); font-variant-numeric: tabular-nums; }
  .gp-assistant__card .meta { display: inline-block; margin-top: .25rem; font-size: .68rem; font-weight: 700; color: var(--gp-mute); }
  .gp-assistant__card .meta--in { color: var(--gp-green-deep); }
  .gp-assistant__starters[hidden] { display: none; }
  .gp-assistant__starters { display: flex; flex-wrap: wrap; gap: .4rem; padding: .25rem .9rem .5rem; }
  .gp-assistant__starters button { border: 1.5px solid var(--gp-line); background: #fff; border-radius: 9999px; padding: .45rem .8rem; font-size: .78rem; font-weight: 800; color: var(--gp-ink); cursor: pointer; min-height: 38px; transition: border-color .15s; }
  .gp-assistant__starters button:hover { border-color: var(--gp-green); }
  .gp-assistant__form { display: flex; gap: .5rem; padding: .7rem .9rem; border-top: 1px solid var(--gp-line); background: #fff; }
  .gp-assistant__form textarea { flex: 1; resize: none; border: 1.5px solid var(--gp-line); border-radius: .9rem; padding: .62rem .8rem; font: inherit; font-size: 16px; max-height: 6rem; background: var(--gp-paper); }
  .gp-assistant__form textarea:focus { outline: none; border-color: var(--gp-green); background: #fff; }
  .gp-assistant__send { width: 44px; height: 44px; flex: none; border: 0; border-radius: 9999px; background: var(--gp-green); color: var(--gp-ink); display: grid; place-items: center; cursor: pointer; transition: transform .15s var(--gp-ease); }
  .gp-assistant__send:hover { transform: scale(1.05); }
  .gp-assistant__send[disabled] { opacity: .5; cursor: progress; transform: none; }
  .gp-assistant__foot { margin: 0; padding: .35rem .9rem .7rem; font-size: .67rem; color: var(--gp-mute); background: #fff; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .35rem .75rem; }
  .gp-assistant__foot > span { flex: 1 1 14rem; }
  .gp-assistant__wa { display: inline-flex; align-items: center; gap: .35rem; min-height: 36px; padding: .3rem .75rem; border-radius: 9999px; border: 1.5px solid var(--gp-green-deep); color: var(--gp-green-deep); font-size: .74rem; font-weight: 800; text-decoration: none; white-space: nowrap; }
  .gp-assistant__wa:hover { background: var(--gp-green-deep); color: #fff; }
  .gp-assistant__wa:focus-visible { outline: 3px solid var(--gp-green); outline-offset: 2px; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
  @media (prefers-reduced-motion: reduce) {
    .gp-assistant__panel--enter, .gp-assistant__launch--nudge .gp-assistant__avatar--launch, .gp-assistant__typing i,
    .gp-assistant__launch--arrive, .gp-assistant__teaser--enter, .gp-assistant__teaser--enter .gp-assistant__avatar--sm, .gp-assistant__teaser--leave, .gp-assistant__launch--msg .gp-assistant__avatar--launch, .gp-assistant__launch--loading .gp-assistant__avatar--launch,
    .gp-goldie::after, .gp-assistant__launch--hello .gp-assistant__avatar--launch { animation: none !important; }
    .gp-assistant__launch--pending { opacity: 1; transform: none; pointer-events: auto; }
    .gp-assistant__teaser--leave { display: none; }
    .gp-assistant__launch, .gp-assistant__send, .gp-assistant__card, .gp-assistant__add, .gp-assistant__launchtext { transition: none; }
    .gp-assistant__typing i { opacity: .7; }
  }
</style>

<script>
  import type { GoldiePanel, Teaser } from '../scripts/goldie-panel';
  import { goldieKey, pageQuestions, productQuestions, shortProductName, todayStillOpen as stillOpen, type PageKey } from '../lib/goldieQuestions';
  import { goldieArm, armMoves, launcherSubline, createHesitation, NUDGE_EXCLUDED, NUDGES_PER_VISIT, NUDGE_CREDIT_MS, type GoldieArm, type HesitationReason } from '../lib/goldieAwareness';

  // Only the launcher and its awareness layer ship with the page. The conversation panel
  // (../scripts/goldie-panel.ts) loads on the first sign of interest: a hover, a touch, a tap,
  // or an inline "Ask Goldie" question.
  const root = document.getElementById('gp-assistant');
  if (root) {
    const endpoint = root.dataset.endpoint || '/api/assistant/chat';
    const q = <T extends Element>(sel: string) => root.querySelector<T>(sel)!;
    const launch = q<HTMLButtonElement>('[data-launch]'), panel = q<HTMLElement>('[data-panel]');
    const teaser = q<HTMLElement>('[data-teaser]'), teaserText = q<HTMLElement>('[data-teaser-text]'), teaserChips = q<HTMLElement>('[data-teaser-chips]');
    const teaserOpen = q<HTMLButtonElement>('[data-teaser-open]'), teaserClose = q<HTMLButtonElement>('[data-teaser-close]'), badge = q<HTMLElement>('[data-badge]');
    const SEEN = 'gp-assistant-seen', TEASED = 'gp-assistant-teased';
    const track = (type: string, itemKey: string) => { const w = window as unknown as { gpNavTrack?: (t: string, d: { itemKey: string }) => void }; try { w.gpNavTrack?.(type, { itemKey }); } catch { /* telemetry is optional */ } };
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const hour = new Date().getHours();

    /** What the site already knows, so Goldie never asks twice: the phone chosen in the battery
     *  finder (a readable cookie set by the finder and the product page) and whether today's
     *  delivery run is still open (shop cutoff, Kampala time). */
    const knownPhone = (() => {
      try {
        const raw = document.cookie.split('; ').find((c) => c.startsWith('gp_battery_device='))?.slice('gp_battery_device='.length);
        const d = raw ? (JSON.parse(decodeURIComponent(raw)) as { label?: unknown }) : null;
        const label = typeof d?.label === 'string' ? d.label.trim().slice(0, 60) : '';
        return /^[\w .+'/-]{2,60}$/.test(label) ? label : '';
      } catch { return ''; }
    })();
    const todayStillOpen = stillOpen(Number(root.dataset.cutoffHour) || 17);
    // The motion experiment (lib/goldieAwareness.ts): arm "a" moves, arm "b" stays still; both are counted.
    let arm: GoldieArm = 'a';
    try { arm = goldieArm(localStorage); } catch { arm = 'a'; }
    const moves = armMoves(arm) && !reduced;
    let nudgeKey = '', nudgedAt = 0;
    // The pill's second line names the question this page raises ("Ask if it fits your phone").
    const subline = launcherSubline({ path: location.pathname, productName: document.querySelector<HTMLElement>('[data-product-name]')?.dataset.productName, phone: knownPhone, todayOpen: todayStillOpen });
    const GREETING = `${hour < 12 ? 'Good morning' : hour < 17 ? 'Good afternoon' : 'Good evening'}, I'm Goldie from GoldPlus. Ask me about a charger, a cable, a power bank, earphones or a battery for your phone, and I'll check the shelf for you.`;

    // ---- the panel, loaded once, on first interest
    let activeTeaser: Teaser | null = null;
    let panelP: Promise<GoldiePanel> | null = null;
    const narrow = matchMedia('(max-width: 640px)');
    const getPanel = () => (panelP ??= import('../scripts/goldie-panel').then((m) => m.mountGoldie(root, {
      endpoint, reduced, knownPhone, greeting: GREETING, track, getTeaser: () => activeTeaser, narrow: () => narrow.matches,
      morph,
      onOpen: () => { hideTeaser(false); badge.hidden = true; launch.removeAttribute('aria-label'); launch.classList.remove('gp-assistant__launch--msg', 'gp-assistant__launch--loading'); setPillText('Ask Goldie', subline); setTimeout(() => glintOn(titleWord), 160); },
    })).catch((err) => { panelP = null; throw err; }));
    // A failed module load is cached by the browser for this page view, so a further tap shows the same
    // WhatsApp fallback rather than a dead button; the next page load fetches it afresh.
    const prefetch = () => { getPanel().catch(() => { /* the tap path shows the fallback */ }); };
    /** A tap while the panel code is still on its way (slow network): the pill says so, and if the
     *  code never arrives the shopper is not left with a dead button but with the person on WhatsApp. */
    const withPanel = (fn: (p: GoldiePanel) => void) => {
      let pending = true;
      setTimeout(() => { if (pending) { launch.classList.add('gp-assistant__launch--loading'); setPillText('Opening…', 'one moment'); } }, 250);
      getPanel().then((p) => { pending = false; fn(p); }).catch(() => {
        pending = false; launch.classList.remove('gp-assistant__launch--loading'); setPillText('Ask Goldie', subline);
        const wa = root.dataset.whatsapp || '/wa';
        teaserText.textContent = 'I could not load just now. The shop answers on WhatsApp.'; teaserChips.replaceChildren();
        const a = document.createElement('a'); a.href = wa; a.target = '_blank'; a.rel = 'noopener noreferrer'; a.textContent = 'Open WhatsApp'; a.className = 'gp-assistant__chip'; teaserChips.append(a);
        teaser.hidden = false; teaserState = 'shown';
      });
    };
    launch.addEventListener('pointerenter', prefetch, { once: true });
    launch.addEventListener('focus', prefetch, { once: true });
    launch.addEventListener('touchstart', prefetch, { once: true, passive: true });
    launch.addEventListener('click', () => {
      track(pillShown ? 'NBA_CLICK' : 'PANEL_OPEN', pillShown ? `${teaserKey}-pill` : goldieKey('launcher'));
      // The experiment counts the first tap of the visit for the visitor's arm; a tap soon after a nudge is credited to it.
      if (onceThisVisit('gp-goldie-tap')) track('NBA_CLICK', goldieKey('launch', arm));
      if (nudgeKey && Date.now() - nudgedAt < NUDGE_CREDIT_MS) { track('NBA_CLICK', nudgeKey); nudgeKey = ''; }
      withPanel((p) => morph(() => p.open(), true));
    });
    const launchStrong = launch.querySelector<HTMLElement>('strong')!, launchSmall = launch.querySelector<HTMLElement>('small')!;
    // "Ask Goldie" keeps the wordmark node; any other line (a page message, "Opening…") is plain text.
    const goldieWord = launch.querySelector<HTMLElement>('[data-goldie]')!;
    const setPillText = (big: string, small: string) => {
      if (big === 'Ask Goldie') launchStrong.replaceChildren('Ask ', goldieWord); else launchStrong.textContent = big;
      launchSmall.textContent = small;
    };
    /** One glint across the name; restarts cleanly if called again. Only when the name is on screen and motion is welcome. */
    const glintOn = (word: HTMLElement | null) => {
      if (reduced || !word || !word.isConnected) return;
      word.classList.remove('gp-goldie--glint'); void word.offsetWidth; word.classList.add('gp-goldie--glint');
    };
    /** The launcher's glint draws the eye, so only the moving arm gets it; hover and the panel title are feedback and stay for everyone. */
    const glint = () => { if (moves) glintOn(goldieWord); };
    launchSmall.textContent = subline;
    // The panel title glints on its own timer: the panel drops its entry class after 0.26 s, which would cut a glint tied to it.
    const titleWord = root.querySelector<HTMLElement>('[data-goldie-title]');
    for (const w of [goldieWord, titleWord]) w?.addEventListener('animationend', (e) => { if ((e as AnimationEvent).animationName.startsWith('gp-glint')) w.classList.remove('gp-goldie--glint'); });
    // A tab that already has a conversation going gets the panel code early, so "Start over" and the transcript are instant.
    try { if (sessionStorage.getItem('gp-assistant-turns')) prefetch(); } catch { /* ignore */ }

    /** True the first time a key is seen this visit (tab session); false after, and where storage is blocked. */
    function onceThisVisit(key: string): boolean { try { if (sessionStorage.getItem(key) === '1') return false; sessionStorage.setItem(key, '1'); return true; } catch { return false; } }

    /** The launcher grows into the panel (and folds back) as one surface, the name travelling into the
     *  header, where the browser supports View Transitions; elsewhere, and under reduced motion, the change is instant. */
    function morph(update: () => void, toPanel: boolean) {
      const d = document as Document & { startViewTransition?: (cb: () => void) => { finished: Promise<void> } };
      if (reduced || typeof d.startViewTransition !== 'function') { update(); return; }
      const surfaces: [HTMLElement, HTMLElement] = toPanel ? [launch, panel] : [panel, launch];
      const words = goldieWord.isConnected && titleWord ? (toPanel ? [goldieWord, titleWord] : [titleWord, goldieWord]) : null;
      const name = (el: HTMLElement | null | undefined, v: string) => { if (el) el.style.viewTransitionName = v; };
      name(surfaces[0], 'goldie-surface'); name(words?.[0], 'goldie-name');
      try {
        const vt = d.startViewTransition(() => {
          name(surfaces[0], ''); name(words?.[0], '');
          update();
          panel.classList.remove('gp-assistant__panel--enter');
          name(surfaces[1], 'goldie-surface'); name(words?.[1], 'goldie-name');
        });
        vt.finished.catch(() => undefined).finally(() => { for (const el of [launch, panel, goldieWord, titleWord]) name(el, ''); });
      } catch { for (const el of [launch, panel, goldieWord, titleWord]) name(el, ''); update(); }
    }

    // Arrival: out of the first paint; rises once the page has loaded and gone idle.
    launch.classList.add('gp-assistant__launch--pending');
    const arrive = () => {
      launch.classList.remove('gp-assistant__launch--pending');
      if (!reduced) { launch.classList.add('gp-assistant__launch--arrive'); launch.addEventListener('animationend', () => launch.classList.remove('gp-assistant__launch--arrive'), { once: true }); }
      // Hello, once per visit: the name glints and the avatar rings as the pill settles. Later pages just arrive.
      let greeted = true;
      try { greeted = sessionStorage.getItem('gp-goldie-hello') === '1'; sessionStorage.setItem('gp-goldie-hello', '1'); } catch { greeted = true; }
      if (onceThisVisit('gp-goldie-imp')) track('NBA_IMPRESSION', goldieKey('launch', arm));
      if (!greeted && moves) {
        setTimeout(() => { glint(); launch.classList.add('gp-assistant__launch--hello'); setTimeout(() => launch.classList.remove('gp-assistant__launch--hello'), 1500); }, 420);
      }
    };
    const whenSettled = (fn: () => void) => {
      const idle = () => { const w = window as unknown as { requestIdleCallback?: (cb: () => void, o?: { timeout: number }) => void }; if (w.requestIdleCallback) w.requestIdleCallback(fn, { timeout: 2500 }); else setTimeout(fn, 800); };
      if (document.readyState === 'complete') idle(); else addEventListener('load', idle, { once: true });
    };
    whenSettled(arrive);

    // The product page's buy bar on phones: the launcher lifts above it rather than sitting on it.
    const buybar = document.querySelector<HTMLElement>('[data-pdp-buybar]');
    if (buybar) {
      const lift = () => { const h = buybar.hidden ? 0 : buybar.getBoundingClientRect().height; root.style.setProperty('--gp-lift', `${Math.max(0, Math.round(h) - 56)}px`); };
      new MutationObserver(lift).observe(buybar, { attributes: true, attributeFilter: ['hidden', 'class', 'style'] }); lift();
    }

    // Phones: fold the pill to the avatar while scrolling down; open it again on a pause or a scroll up.
    let lastY = scrollY, foldTimer: number | undefined, holdOpenUntil = 0;
    addEventListener('scroll', () => {
      if (!narrow.matches) return;
      const y = scrollY; const down = y > lastY + 4 && y > 120; const up = y < lastY - 4; lastY = y;
      if (Date.now() < holdOpenUntil) return;
      if (down) launch.classList.add('gp-assistant__launch--mini'); else if (up) launch.classList.remove('gp-assistant__launch--mini');
      clearTimeout(foldTimer); foldTimer = setTimeout(() => launch.classList.remove('gp-assistant__launch--mini'), 1400) as unknown as number;
    }, { passive: true });

    // The teaser: one message written for this page. Not on pages where a floating invitation
    // gets in the way of a task (checkout, cart, account, the finders, search and filtered lists).
    const EXCLUDED = /^\/(checkout|cart|admin|account|orders|login|logout|auth|forgot-password|consent|preferences|offline|shop|search|compare|product-finder|battery-finder|quote-request|bulk|dealers)(\/|$)/;
    type PageTeaser = Teaser & { pill: string };
    // Labels are short; each chip SENDS a full question naming its subject (lib/goldieQuestions.ts),
    // because the server never sees the page the conversation came from.
    const page = (key: PageKey, text: string, pill: string, asksPhone = false): PageTeaser => ({ key, text, pill, asksPhone, chips: pageQuestions(key, knownPhone, todayStillOpen) });
    const pageTeaser = (): PageTeaser | null => {
      const path = location.pathname;
      if (EXCLUDED.test(path)) return null;
      // One voice per page: where the page already offers "Ask Goldie" questions in its content, the launcher stays quiet.
      if (document.querySelector('.gp-askgoldie')) return null;
      const name = document.querySelector<HTMLElement>('[data-product-name]')?.dataset.productName?.trim();
      if (path.startsWith('/products/') && name) {
        const short = shortProductName(name); const battery = /batter/i.test(name);
        const chips = productQuestions({ name, isBattery: battery, phone: knownPhone, todayOpen: todayStillOpen });
        return battery
          ? { key: 'pdp-battery', text: knownPhone ? `Looking at the ${short} for your ${knownPhone}? I can confirm the fit before you pay.` : `Looking at the ${short}? Tell me your phone and I'll confirm it fits before you pay.`, pill: knownPhone ? `Fits your ${knownPhone}?` : 'Will it fit your phone?', chips, asksPhone: true }
          : { key: 'pdp', text: `Looking at the ${short}? Ask me anything about it, or whether it can reach you today.`, pill: 'Questions on this one?', chips };
      }
      if (path.startsWith('/phone-batteries')) return knownPhone
        ? page('batteries', `Still shopping for your ${knownPhone}? Say the word and I'll pull up the battery that fits it.`, `Battery for your ${knownPhone}?`)
        : page('batteries', 'Not sure which battery fits? Tell me the phone and I\'ll check the shelf.', 'Which battery fits?', true);
      if (path.startsWith('/power/chargers')) return page('chargers', 'Choosing a charger? Tell me the phone and I\'ll say what it takes.', 'Which charger for you?', true);
      if (path.startsWith('/power/power-banks')) return page('power-banks', 'For the power cuts? Tell me what you charge and I\'ll size the power bank.', 'Which size do you need?');
      if (path.startsWith('/power/charging-cables')) return page('cables', 'Type-C, V8 or iPhone cable? Tell me the phone and I\'ll pick the right end.', 'Which cable fits?', true);
      if (path.startsWith('/audio')) return page('audio', 'Earphones for calls, music or the gym? Say which and I\'ll shortlist.', 'Calls, music or gym?');
      if (path.startsWith('/storage')) return page('storage', 'Flash disk or memory card? Tell me what it\'s for and I\'ll find the size.', 'Which size do you need?');
      if (path.startsWith('/delivery')) return page('delivery', todayStillOpen ? 'Ask me about delivery to your area and whether today\'s run still has room.' : 'Today\'s run has left. Ask me when the next one can reach your area.', 'Delivery to your area?');
      if (path.startsWith('/blog')) return page('guide', 'Reading up? When you know what you need, tell me the phone and I\'ll find it on the shelf.', 'Found what you need?', true);
      if (path === '/') return knownPhone
        ? page('home', `Welcome back. Shopping for your ${knownPhone} again? I can find the battery, charger or cable that fits it.`, `For your ${knownPhone}?`)
        : page('home', 'Hi, I\'m Goldie. Tell me your phone and I\'ll find the battery, charger or cable that fits, and say if it can come today.', 'What phone do you use?', true);
      return null;
    };

    // Once per visitor per week (a tab-only fallback where storage is blocked).
    const TEASED_AT = 'gp-assistant-teased-at', WEEK = 7 * 24 * 3600 * 1000;
    const teasedRecently = () => {
      try { if (Date.now() - Number(localStorage.getItem(TEASED_AT) || 0) < WEEK) return true; } catch { /* blocked */ }
      try { return sessionStorage.getItem(TEASED) === '1' || sessionStorage.getItem(SEEN) === '1'; } catch { return false; }
    };
    const markTeased = () => { try { localStorage.setItem(TEASED_AT, String(Date.now())); } catch { /* ignore */ } try { sessionStorage.setItem(TEASED, '1'); } catch { /* ignore */ } };

    let teaserState: 'idle' | 'shown' | 'done' = 'idle'; let teaserKey = ''; let pillShown = false;
    function hideTeaser(leaveBadge: boolean) {
      if (teaserState !== 'shown') return; teaserState = 'done';
      const finish = () => { teaser.hidden = true; teaser.classList.remove('gp-assistant__teaser--leave', 'gp-assistant__teaser--enter'); };
      if (reduced) finish(); else { teaser.classList.add('gp-assistant__teaser--leave'); teaser.addEventListener('animationend', finish, { once: true }); }
      if (leaveBadge && panel.hidden) { badge.hidden = false; launch.setAttribute('aria-label', 'Ask Goldie, 1 new message'); }
    }
    const askNow = (question: string, itemKey: string) => { track('NBA_CLICK', itemKey); withPanel((p) => { void p.ask(question); }); };
    const showTeaser = () => {
      if (teaserState !== 'idle' || !panel.hidden) return;
      const t = pageTeaser(); if (!t) { teaserState = 'done'; return; }
      activeTeaser = t; teaserKey = goldieKey(t.key); markTeased();
      if (narrow.matches) {
        // Phones: the message rides in the pill; nothing floats over the content.
        teaserState = 'done'; pillShown = true;
        launch.classList.remove('gp-assistant__launch--mini'); launch.classList.add('gp-assistant__launch--msg');
        setPillText(t.pill, 'Ask Goldie'); holdOpenUntil = Date.now() + 8000;
        track('NBA_IMPRESSION', `${teaserKey}-pill`);
        // The wide pill returns to its usual size after a moment so it covers nothing for long;
        // the panel keeps the full message and its questions, so nothing is lost to the timer.
        setTimeout(() => { if (panel.hidden) { launch.classList.remove('gp-assistant__launch--msg'); setPillText('Ask Goldie', subline); badge.hidden = false; launch.setAttribute('aria-label', 'Ask Goldie, 1 new message'); glint(); } }, 12000);
        return;
      }
      teaserState = 'shown';
      teaserText.textContent = t.text; teaserChips.replaceChildren();
      for (const c of t.chips) { const b = document.createElement('button'); b.type = 'button'; b.textContent = c.label; b.setAttribute('aria-label', c.ask); b.addEventListener('click', () => askNow(c.ask, `${teaserKey}-chip`)); teaserChips.append(b); }
      teaser.hidden = false; if (!reduced) { teaser.classList.add('gp-assistant__teaser--enter'); setTimeout(glint, 200); }
      track('NBA_IMPRESSION', teaserKey);
      // Ignored for a minute, it folds to an unread dot; the panel still opens with the same message.
      setTimeout(() => hideTeaser(true), 60000);
    };
    teaserOpen.addEventListener('click', () => { track('NBA_CLICK', teaserKey); withPanel((p) => p.open()); });
    teaserClose.addEventListener('click', () => { track('NBA_DISMISS', teaserKey); hideTeaser(false); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && teaserState === 'shown') hideTeaser(false); });
    if (!teasedRecently() && pageTeaser()) {
      // Whichever comes first: real reading time, or most of the page read.
      const dwell = setTimeout(showTeaser, narrow.matches ? 40000 : 30000);
      const onScroll = () => {
        const depth = (scrollY + innerHeight) / Math.max(1, document.documentElement.scrollHeight);
        if (depth >= 0.6) { clearTimeout(dwell); removeEventListener('scroll', onScroll); showTeaser(); }
      };
      addEventListener('scroll', onScroll, { passive: true });
    }

    // Hesitation: when the shopper looks stuck (re-reading, copying a model number, going still), the name
    // glints once and the avatar rings, so the motion means "I can help with that". Once per page, a few per visit.
    if (!NUDGE_EXCLUDED.test(location.pathname)) {
      const h = createHesitation(performance.now(), { stillMs: 20000 });
      const reading = location.pathname.startsWith('/blog');
      const nudgesSoFar = () => { try { return Number(sessionStorage.getItem('gp-goldie-nudges') || 0); } catch { return NUDGES_PER_VISIT; } };
      const onReason = (r: HesitationReason | null) => {
        if (!r || (reading && r === 'still')) return;
        if (!panel.hidden || teaserState === 'shown' || nudgesSoFar() >= NUDGES_PER_VISIT) return;
        try { sessionStorage.setItem('gp-goldie-nudges', String(nudgesSoFar() + 1)); } catch { /* ignore */ }
        nudgeKey = goldieKey('nudge', r, arm); nudgedAt = Date.now(); track('NBA_IMPRESSION', nudgeKey);
        if (!moves) return;
        launch.classList.remove('gp-assistant__launch--mini'); holdOpenUntil = Date.now() + 4000;
        glint(); launch.classList.add('gp-assistant__launch--hello'); setTimeout(() => launch.classList.remove('gp-assistant__launch--hello'), 1500);
