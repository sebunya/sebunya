---
const { gates } = Astro.props;
---

<div class="bg-white p-6 rounded-lg shadow-sm border border-gray-200 mt-6">
  <h3 class="text-lg font-bold mb-4">Gate Results</h3>
  <div class="flex flex-col gap-4">
    {gates.map((gate) => {
      let bg = 'bg-gray-50';
      let border = 'border-gray-200';
      if (gate.status === 'PASS') {
        bg = 'bg-green-50'; border = 'border-green-200';
      } else if (gate.status === 'WARN') {
        bg = 'bg-yellow-50'; border = 'border-yellow-200';
      } else if (gate.status === 'FAIL') {
        bg = 'bg-red-50'; border = 'border-red-200';
      }

      return (
        <div class={`p-4 border rounded-md ${bg} ${border}`}>
          <div class="flex justify-between">
            <span class="font-semibold text-gray-900">{gate.name}</span>
            <span class="text-sm font-medium uppercase">{gate.status}</span>
          </div>
          <p class="text-xs text-gray-500 mt-1">{gate.category} | Severity: {gate.severity}</p>
          <pre class="mt-2 text-xs bg-white p-2 rounded border">{JSON.stringify(gate.evidence, null, 2)}</pre>
        </div>
      );
    })}
  </div>
</div>
