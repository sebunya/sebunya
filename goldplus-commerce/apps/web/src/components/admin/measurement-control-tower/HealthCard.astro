---
import StatusBadge from './StatusBadge.astro';

export interface Props {
  title: string;
  value: number | string;
  status: string;
}

const { title, value, status } = Astro.props;
---
<div class="bg-white rounded-lg shadow-sm border border-slate-200 p-5 flex flex-col">
  <div class="flex justify-between items-start mb-2">
    <h3 class="text-sm font-semibold text-slate-500 uppercase tracking-wider">{title}</h3>
    <StatusBadge status={status} />
  </div>
  <div class="text-3xl font-bold text-slate-800 mt-auto">{value}</div>
</div>
