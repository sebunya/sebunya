---
export interface Props {
  status: string;
  label?: string;
}

const { status, label } = Astro.props;

let colorClass = 'bg-slate-100 text-slate-800';

switch (status) {
  case 'HEALTHY':
  case 'CONFIGURED':
    colorClass = 'bg-green-100 text-[#96cc06] border border-[#96cc06]';
    break;
  case 'WARNING':
    colorClass = 'bg-yellow-100 text-yellow-800';
    break;
  case 'FAILED':
    colorClass = 'bg-red-100 text-red-800';
    break;
  case 'CONSENT_BLOCKED':
    colorClass = 'bg-slate-200 text-slate-600 border border-slate-300';
    break;
  case 'DRY_RUN':
    colorClass = 'bg-blue-100 text-blue-800 border border-blue-300';
    break;
  case 'NOT_CONFIGURED':
  case 'NO_DATA_AVAILABLE':
    colorClass = 'bg-slate-100 text-slate-500 border border-dashed border-slate-300';
    break;
  case 'REDACTED':
    colorClass = 'bg-purple-100 text-purple-800 border border-purple-300';
    break;
}

const displayLabel = label || status.replace(/_/g, ' ');
---
<span class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${colorClass}`}>
  {displayLabel}
</span>
