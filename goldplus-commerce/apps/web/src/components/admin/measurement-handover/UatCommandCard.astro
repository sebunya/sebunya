---
export interface Props {
  title: string;
  command: string;
}
const { title, command } = Astro.props;
---
<div class="bg-gray-50 border border-gray-200 shadow-sm rounded-lg p-4">
  <h4 class="font-medium text-gray-900 mb-2">{title}</h4>
  <code class="block bg-gray-900 text-gray-100 p-3 rounded text-sm overflow-x-auto">
    {command}
  </code>
</div>
