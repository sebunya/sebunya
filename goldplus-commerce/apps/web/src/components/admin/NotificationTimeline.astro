---
import type { FrontendTimelineItem } from "../../lib/api";

interface Props {
  items: FrontendTimelineItem[];
}

const { items } = Astro.props;

function getStatusBadgeClass(status: string) {
  switch (status.toLowerCase()) {
    case 'sent':
      return 'bg-green-50 text-green-700 border-green-200';
    case 'dry_run':
    case 'preview_only':
      return 'bg-amber-50 text-amber-700 border-amber-200';
    case 'failed':
      return 'bg-red-50 text-red-700 border-red-200';
    case 'suppressed':
    case 'skipped':
      return 'bg-gray-100 text-gray-600 border-gray-200';
    case 'claimed':
      return 'bg-indigo-50 text-indigo-700 border-indigo-200';
    case 'pending':
    default:
      return 'bg-blue-50 text-blue-700 border-blue-200';
  }
}

function formatTimestamp(isoStr: string) {
  try {
    const d = new Date(isoStr);
    return d.toLocaleString('en-GB', {
      day: '2-digit',
      month: 'short',
      year: 'numeric',
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit'
    });
  } catch {
    return isoStr;
  }
}
---

<div class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden mt-8 hover:shadow-md transition-all duration-300">
  <div class="px-6 py-4 border-b border-gray-100 bg-gray-50 flex justify-between items-center flex-wrap gap-2">
    <div>
      <h3 class="text-[10px] font-black uppercase tracking-widest text-brand-dark">Order Notification Timeline</h3>
      <p class="text-[9px] text-gray-400 mt-0.5">Chronological audit log of outbox events, channel eligibility planning, and provider dispatch attempts.</p>
    </div>
    
    <span class="bg-blue-50 text-blue-700 border border-blue-100 text-[8px] font-black px-2.5 py-1 rounded-xl uppercase tracking-wider">
      Read-Only Mode
    </span>
  </div>

  <div class="p-6">
    {items.length === 0 ? (
      <div class="p-8 text-center text-gray-400 italic bg-gray-50 border border-gray-100 rounded-2xl">
        <svg class="w-8 h-8 text-gray-300 mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        No notification timeline records found for this order. (Events are enqueued during order transitions and payment settlements).
      </div>
    ) : (
      <div class="relative border-l border-gray-200 ml-4 pl-6 space-y-8">
        {items.map((item) => (
          <div class="relative group">
            <!-- Timeline Dot -->
            <span class={`absolute -left-[31px] top-1.5 flex items-center justify-center w-5 h-5 rounded-full ring-4 ring-white ${
              item.type === 'attempt' ? 'bg-indigo-500' : 'bg-emerald-500'
            }`}>
              {item.type === 'attempt' ? (
                <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 19v-8.93a2 2 0 01.89-1.664l8-5.333a2 2 0 012.22 0l8 5.333A2 2 0 0121 10.07V19M3 19a2 2 0 002 2h14a2 2 0 002-2M3 19l6.75-4.5M21 19l-6.75-4.5M3 10l6.75 4.5M21 10l-6.75 4.5m0 0l-2.25-1.5a2 2 0 00-2.22 0l-2.25 1.5"></path></svg>
              ) : (
                <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
              )}
            </span>

            <div class="bg-gray-50 border border-gray-200 rounded-xl p-5 relative transition-colors duration-200 hover:border-gray-300">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-3">
                <div>
                  <span class="text-[8px] font-bold text-gray-400 uppercase tracking-widest block mb-0.5">
                    {item.type.toUpperCase()} EVENT • {formatTimestamp(item.timestamp)}
                  </span>
                  <h4 class="text-xs font-black text-brand-dark flex items-center gap-2 flex-wrap">
                    {item.template}
                    <span class="text-[9px] font-mono text-gray-400 font-medium bg-gray-100 px-1.5 py-0.5 rounded">
                      via {item.channel.toUpperCase()}
                    </span>
                  </h4>
                </div>
                
                <div class="flex items-center gap-2 self-start sm:self-center">
                  <span class={`inline-block px-2.5 py-0.5 border font-black text-[9px] uppercase rounded-lg ${getStatusBadgeClass(item.status)}`}>
                    {item.status.replace(/_/g, ' ')}
                  </span>
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
                <div>
                  <span class="text-[8px] font-bold text-gray-400 uppercase block mb-0.5">Masked Recipient</span>
                  <span class="font-mono font-bold text-brand-dark break-all">{item.recipient || 'N/A'}</span>
                </div>

                {item.idempotencyKey && (
                  <div>
                    <span class="text-[8px] font-bold text-gray-400 uppercase block mb-0.5">Idempotency Key (Masked/Safe)</span>
                    <span class="font-mono font-bold text-gray-500 break-all">{item.idempotencyKey}</span>
                  </div>
                )}
              </div>

              <!-- Safety Flags & Details -->
              <div class="flex flex-wrap gap-2 mt-4 pt-3 border-t border-gray-200/50">
                {item.dryRunOnly && (
                  <span class="bg-amber-50 text-amber-700 border border-amber-200 text-[8px] font-black px-2 py-0.5 rounded uppercase tracking-wider">
                    Dry-Run Mode
                  </span>
                )}
                {item.previewOnly && (
                  <span class="bg-blue-50 text-blue-700 border border-blue-200 text-[8px] font-black px-2 py-0.5 rounded uppercase tracking-wider">
                    Preview Only
                  </span>
                )}
                {item.noSendGuarantee && (
                  <span class="bg-green-50 text-green-700 border border-green-200 text-[8px] font-black px-2 py-0.5 rounded uppercase tracking-wider">
                    No-Send Guaranteed
                  </span>
                )}
              </div>

              {item.suppressedReason && (
                <div class="bg-gray-100 border border-gray-200 text-gray-700 rounded-lg p-3 mt-3 text-[10px] leading-relaxed">
                  <strong>Suppressed Reason:</strong> {item.suppressedReason}
                </div>
              )}

              {item.providerMessage && (
                <div class="bg-gray-900 text-gray-100 border border-gray-800 rounded-lg p-3.5 mt-3">
                  <div class="text-[8px] font-bold text-gray-400 uppercase tracking-wider mb-1.5">Sanitized Response Payload</div>
                  <pre class="text-[9px] font-mono whitespace-pre-wrap break-all leading-relaxed overflow-x-auto text-green-400">
                    {item.providerMessage}
                  </pre>
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
    )}
  </div>
</div>
