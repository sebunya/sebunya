---
/**
 * "Where did this order come from?" on the admin order page (attribution
 * module, 0156). Shows the recorded visits, any creator/promo code and the
 * answers on file, and lets staff record how the customer heard about us and
 * the WhatsApp reference from the chat ("Ref GP-XXXXXX"). The form posts to
 * /api/admin/orders/<id>/source, which audits it through the API.
 */
import { apiBase } from '../../lib/api';
import { HEARD_ABOUT_LABELS, HEARD_ABOUT_OPTIONS } from '@goldplus/shared';
import { formatUgx } from '../../lib/money';

interface Props { orderId: string; token: string }
const { orderId, token } = Astro.props;

let view: any = null;
let loadMessage: string | null = null;
try {
  const res = await fetch(`${apiBase}/admin/attribution/orders/${encodeURIComponent(orderId)}`, { headers: { Accept: 'application/json', Authorization: `Bearer ${token}` }, signal: AbortSignal.timeout(10_000) });
  const json = res.ok ? await res.json().catch(() => null) : null;
  if (json?.success) view = json.data;
  else loadMessage = res.status === 403 ? 'Your account cannot read order attribution.' : 'Attribution for this order is not available right now.';
} catch { loadMessage = 'Attribution for this order is not available right now.'; }

const status = Astro.url.searchParams.get('source');
const statusMessage = Astro.url.searchParams.get('sourceMessage');
const CHANNEL: Record<string, string> = { paid_search: 'Paid search', paid_social: 'Paid social', organic_search: 'Organic search', organic_social: 'Organic social', referral: 'Referral', direct: 'Direct', whatsapp: 'WhatsApp', email: 'Email', sms: 'SMS', display: 'Display', affiliate: 'Affiliate', other_paid: 'Other paid', other: 'Other', creator: 'Creator', promo_code: 'Promo code', search_declared: 'Search (customer said)', social_declared: 'Social media (customer said)', word_of_mouth: 'Friends and family (customer said)', offline_media: 'Radio, TV and print (customer said)', returning_customer: 'Returning customer (customer said)' };
const label = (c: string) => CHANNEL[c] ?? c;
const when = (iso: string) => new Date(iso).toLocaleString('en-GB', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit', timeZone: 'Africa/Kampala' });
const lastClick = view ? view.credits.filter((c: any) => c.model === 'last_click') : [];
---
<section aria-labelledby="order-source-h" class="mt-8 rounded-2xl border border-gray-200 bg-white p-5">
  <h3 id="order-source-h" class="font-black text-brand-dark">Where this order came from</h3>
  {status === 'ok' && <p role="status" class="mt-3 rounded-lg border border-emerald-300 bg-emerald-50 p-3 text-sm text-emerald-900">{statusMessage || 'Recorded.'}</p>}
  {status === 'error' && <p role="alert" class="mt-3 rounded-lg border border-red-300 bg-red-50 p-3 text-sm text-red-900">{statusMessage || 'Not recorded.'}</p>}
  {!view ? <p class="mt-2 text-sm text-gray-600">{loadMessage}</p> : (
    <div class="mt-3 grid gap-4 md:grid-cols-2">
      <div class="text-sm">
        <p class="font-bold text-gray-900">Recorded visits (30 days before the order)</p>
        {view.touches.length === 0
          ? <p class="text-gray-600">{view.visitorRecorded ? 'None recorded for this visitor.' : 'No visitor was recorded with this order (for example an order entered for a customer).'}</p>
          : <ol class="mt-1 list-decimal pl-5">{view.touches.map((t: any) => <li>{label(t.channel)}{t.detail && <span class="text-gray-600"> · {t.detail}</span>} <span class="text-gray-500">({when(t.at)})</span></li>)}</ol>}
        {view.code && <p class="mt-2">{view.code.kind === 'creator' ? 'Creator' : 'Promo code'}: <strong>{view.code.detail}</strong></p>}
        <p class="mt-2">Customer said: <strong>{view.effectiveAnswer ? (HEARD_ABOUT_LABELS as Record<string, string>)[view.effectiveAnswer] ?? view.effectiveAnswer : 'No answer'}</strong></p>
        {view.reports.filter((r: any) => r.whatsappRef).map((r: any) => <p class="text-gray-600">WhatsApp reference {r.whatsappRef} ({when(r.at)})</p>)}
        <p class="mt-2">Last-click credit: {lastClick.length === 0 ? <strong>No recorded source</strong> : lastClick.map((c: any) => <strong>{label(c.channel)}{c.detail && ` · ${c.detail}`} ({formatUgx(c.creditedUGX)})</strong>)}</p>
      </div>
      <form method="POST" action={`/api/admin/orders/${encodeURIComponent(orderId)}/source`} class="space-y-3 text-sm">
        <label class="block font-bold text-gray-900" for="source-answer">How did the customer hear about us?</label>
        <select id="source-answer" name="answer" class="block w-full min-h-11 rounded-lg border border-gray-300 px-3">
          <option value="">Not asked / no answer</option>
          {HEARD_ABOUT_OPTIONS.map((o) => <option value={o.value} selected={view.effectiveAnswer === o.value}>{o.label}</option>)}
        </select>
        <label class="block font-bold text-gray-900" for="source-ref">WhatsApp reference <span class="font-normal text-gray-600">(optional, from the chat: "Ref GP-…")</span></label>
        <input id="source-ref" name="whatsappRef" maxlength="20" autocomplete="off" placeholder="GP-7K3Q9X" class="block w-full min-h-11 rounded-lg border border-gray-300 px-3 font-mono uppercase" />
        <label class="block font-bold text-gray-900" for="source-note">Note <span class="font-normal text-gray-600">(optional)</span></label>
        <input id="source-note" name="note" maxlength="300" class="block w-full min-h-11 rounded-lg border border-gray-300 px-3" />
        <button class="inline-flex min-h-11 items-center rounded-full bg-brand-dark px-5 font-bold text-white">Record source</button>
      </form>
    </div>
  )}
</section>
