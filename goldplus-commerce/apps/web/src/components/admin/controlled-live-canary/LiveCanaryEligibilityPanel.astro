---
---
<div class="bg-white shadow rounded-lg p-6">
  <h2 class="text-lg font-bold text-gray-900 mb-4">Canary Eligibility Check</h2>
  <div class="space-y-3">
    <div class="flex justify-between items-center text-sm border-b pb-2">
      <span class="text-gray-600">Dry-Run Passed status</span>
      <span class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">PASSED</span>
    </div>
    <div class="flex justify-between items-center text-sm border-b pb-2">
      <span class="text-gray-600">Evidence Pack Exists</span>
      <span class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">FOUND</span>
    </div>
    <div class="flex justify-between items-center text-sm border-b pb-2">
      <span class="text-gray-600">Kill-Switch Arm Status</span>
      <span class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">ARMED_SAFE</span>
    </div>
    <div class="flex justify-between items-center text-sm border-b pb-2">
      <span class="text-gray-600">Rollback Plan summary</span>
      <span class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">VERIFIED</span>
    </div>
    <div class="flex justify-between items-center text-sm border-b pb-2">
      <span class="text-gray-600">Monitoring Owner defined</span>
      <span class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">VERIFIED</span>
    </div>
  </div>
  <button id="runEligibilityCheckBtn" class="mt-4 w-full bg-blue-600 text-white py-2 px-4 rounded text-sm hover:bg-blue-700 font-medium">
    Run Eligibility Evaluation
  </button>
</div>
