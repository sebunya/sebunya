---
---
<div class="bg-white shadow rounded-lg p-6">
  <h2 class="text-lg font-bold text-gray-900 mb-4">Canary Control panel</h2>
  
  <div class="space-y-4">
    <div class="bg-gray-50 p-4 rounded text-sm space-y-2">
      <div>
        <span class="text-gray-500 font-semibold">Canary Cap:</span>
        <span class="text-gray-900 font-bold ml-1">1 event (one-event canary only)</span>
      </div>
      <div>
        <span class="text-gray-500 font-semibold">Destination Allowlist:</span>
        <span class="text-gray-900 font-bold ml-1">posthog</span>
      </div>
      <div>
        <span class="text-gray-500 font-semibold">Kill-Switch State:</span>
        <span class="text-gray-900 font-bold ml-1">ACTIVE</span>
      </div>
      <div>
        <span class="text-gray-500 font-semibold">Rollback Owner:</span>
        <span class="text-gray-900 font-bold ml-1">admin-devops</span>
      </div>
      <div>
        <span class="text-gray-500 font-semibold">Monitoring Owner:</span>
        <span class="text-gray-900 font-bold ml-1">admin-sre</span>
      </div>
    </div>

    <div>
      <label for="canaryConfirmText" class="block text-sm font-medium text-gray-700 mb-1">
        Type <code class="bg-gray-100 px-1 rounded text-red-600">START_CONTROLLED_CANARY</code> to confirm activation:
      </label>
      <input 
        type="text" 
        id="canaryConfirmText" 
        placeholder="START_CONTROLLED_CANARY" 
        class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-blue-500"
      />
    </div>

    <div class="grid grid-cols-2 gap-3">
      <button id="startCanaryBtn" class="bg-red-600 text-white py-2 px-4 rounded text-sm hover:bg-red-700 font-medium">
        Start Controlled Canary
      </button>
      <button id="pauseCanaryBtn" class="bg-yellow-600 text-white py-2 px-4 rounded text-sm hover:bg-yellow-700 font-medium">
        Pause Canary
      </button>
    </div>

    <button id="completeCanaryBtn" class="w-full bg-green-600 text-white py-2 px-4 rounded text-sm hover:bg-green-700 font-medium">
      Complete Canary Review
    </button>
  </div>
</div>
