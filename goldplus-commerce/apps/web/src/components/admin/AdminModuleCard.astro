---
import type { AdminTrustModule } from "../../lib/admin-trust-centre";
import { adminStatusTone } from "../../lib/admin-trust-centre";

interface Props {
  module: AdminTrustModule;
}

const { module } = Astro.props;
const tone = adminStatusTone(module.status);
const statusClass = tone === "success" ? "border-emerald-200 bg-emerald-50 text-emerald-800"
  : tone === "info" ? "border-blue-200 bg-blue-50 text-blue-800"
    : tone === "warning" ? "border-amber-200 bg-amber-50 text-amber-800"
      : tone === "danger" ? "border-red-200 bg-red-50 text-red-800"
        : "border-slate-200 bg-slate-100 text-slate-700";
const descriptionId = `admin-module-${module.id}-description`;
const disabledReasonId = `admin-module-${module.id}-disabled-reason`;
---

<article class="flex h-full flex-col rounded-2xl border border-slate-200 bg-white p-6 shadow-sm" data-admin-module={module.id}>
  <div class="flex items-start justify-between gap-4">
    <div>
      <h3 class="text-lg font-black tracking-tight text-brand-dark">{module.title}</h3>
      <p id={descriptionId} class="mt-2 text-sm leading-relaxed text-slate-600">{module.description}</p>
    </div>
    <span class={`shrink-0 rounded-full border px-2.5 py-1 text-[10px] font-black uppercase tracking-wide ${statusClass}`}>
      {module.status}
    </span>
  </div>

  <div class="mt-5 space-y-3 text-xs leading-relaxed">
    <div class="rounded-xl bg-slate-50 p-3">
      <p class="font-black uppercase tracking-wide text-slate-500">Next best step</p>
      <p class="mt-1 text-slate-700">{module.nextStep}</p>
    </div>
    {module.accessNote && (
      <p class="border-l-2 border-blue-300 pl-3 text-slate-600">
        <strong>Access:</strong> {module.accessNote}
      </p>
    )}
    {module.safetyNote && (
      <p class="border-l-2 border-amber-300 pl-3 text-slate-600">
        <strong>Safety:</strong> {module.safetyNote}
      </p>
    )}
  </div>

  <div class="mt-auto pt-6">
    {module.actionDisabled ? (
      <div>
        <button
          type="button"
          disabled
          aria-describedby={disabledReasonId}
          class="w-full cursor-not-allowed rounded-xl border border-slate-200 bg-slate-100 px-4 py-2.5 text-xs font-black text-slate-500"
        >
          {module.actionLabel}
        </button>
        <p id={disabledReasonId} class="mt-2 text-xs leading-relaxed text-slate-500">
          <strong>Why disabled:</strong> {module.disabledReason}
        </p>
        {module.previewHref && (
          <a
            href={module.previewHref}
            class="mt-3 inline-flex w-full items-center justify-center rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-xs font-black text-slate-800 transition-colors hover:border-slate-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-primary"
          >
            {module.previewLabel ?? "Review read-only preview"}
          </a>
        )}
      </div>
    ) : (
      <a
        href={module.href}
        aria-describedby={descriptionId}
        class="inline-flex w-full items-center justify-center rounded-xl bg-brand-dark px-4 py-2.5 text-xs font-black text-white transition-colors hover:bg-black focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-primary"
      >
        {module.actionLabel}
      </a>
    )}
  </div>
</article>
