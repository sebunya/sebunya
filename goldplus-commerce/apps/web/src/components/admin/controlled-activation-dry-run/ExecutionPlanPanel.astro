---
---
<div class="bg-white shadow rounded-lg p-6">
  <h2 class="text-lg font-medium text-gray-900 mb-4">Execution Plan</h2>
  <div class="space-y-4">
    <p class="text-sm text-gray-600">Review the details of the execution plan.</p>
    <div>
      <label class="block text-sm font-medium text-gray-700">Activation Request ID</label>
      <input type="text" id="ep-request-id" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm" readonly value="REQ-12345" />
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700">Scope</label>
      <input type="text" id="ep-scope" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm" readonly value="GTM" />
    </div>
    <div class="pt-4">
      <button type="button" class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-md" onclick="alert('Execution Plan Created')">Generate Execution Plan</button>
    </div>
  </div>
</div>
