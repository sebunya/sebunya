---
---
<div class="bg-white shadow rounded-lg p-6">
  <h2 class="text-lg font-medium text-gray-900 mb-4">Dry-Run Control</h2>
  <div class="space-y-4">
    <p class="text-sm text-gray-600">Orchestrate the dry-run process without dispatching real events.</p>
    <div class="flex items-center space-x-4">
      <button type="button" class="bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-md" onclick="alert('Starting Dry-Run')">Start Dry-Run</button>
      <button type="button" class="bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded-md" onclick="alert('Canceling Dry-Run')">Cancel Dry-Run</button>
    </div>
    <div class="mt-4 p-3 bg-gray-50 border rounded-md">
      <h3 class="text-sm font-medium text-gray-700">Status</h3>
      <p class="text-sm text-gray-500 mt-1">READY_FOR_DRY_RUN</p>
    </div>
  </div>
</div>
