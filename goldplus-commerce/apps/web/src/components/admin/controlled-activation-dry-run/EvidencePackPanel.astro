<div class="bg-white shadow rounded-lg p-6">
  <h2 class="text-lg font-medium text-gray-900 mb-4">Evidence Pack</h2>
  <div class="space-y-4">
    <p class="text-sm text-gray-600">Build the final evidence pack for the dry-run, which must be approved before any live activation.</p>
    <div class="mt-4 p-3 bg-gray-50 border rounded-md">
      <h3 class="text-sm font-medium text-gray-700">Audit Trail</h3>
      <p class="text-sm text-gray-500 mt-1">Ready to compile audit logs, payload previews, and canary validations.</p>
    </div>
    <div class="pt-4 flex space-x-4">
      <button type="button" class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-md" onclick="alert('Evidence Pack Built')">Build Evidence Pack</button>
      <button type="button" class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-md" onclick="alert('Marked Ready For Live Review')">Mark Ready for Live Review</button>
    </div>
  </div>
</div>
