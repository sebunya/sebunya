---
---
<div class="bg-white shadow rounded-lg p-6">
  <h2 class="text-lg font-medium text-gray-900 mb-4">Payload Previews</h2>
  <div class="space-y-4">
    <p class="text-sm text-gray-600">Review redacted payloads simulating real event dispatch.</p>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Destination</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Event Type</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <tr>
            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">Facebook CAPI</td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">PURCHASE</td>
            <td class="px-6 py-4 whitespace-nowrap">
              <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">PREVIEW_READY</span>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
    <div class="pt-4">
      <button type="button" class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-md" onclick="alert('Previews Generated')">Generate Previews</button>
    </div>
  </div>
</div>
