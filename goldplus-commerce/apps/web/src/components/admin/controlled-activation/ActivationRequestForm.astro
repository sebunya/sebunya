---
<div class="bg-white shadow rounded-lg p-6">
  <h2 class="text-lg font-medium text-gray-900 mb-4">New Activation Request</h2>
  <form class="space-y-4">
    <div>
      <label class="block text-sm font-medium text-gray-700">Reason</label>
      <input type="text" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm" required />
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700">Rollback Plan Summary</label>
      <input type="text" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm" required />
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700">Monitoring Owner</label>
      <input type="text" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm" required />
    </div>
    <button type="button" class="bg-indigo-600 text-white px-4 py-2 rounded-md">Create Request</button>
  </form>
</div>
