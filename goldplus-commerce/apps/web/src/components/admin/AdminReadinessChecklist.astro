---
import type { AdminReadinessItem } from "../../lib/admin-trust-centre";
import { adminStatusTone } from "../../lib/admin-trust-centre";

interface Props {
  items: readonly AdminReadinessItem[];
}

const { items } = Astro.props;
const statusClass = (status: AdminReadinessItem["status"]) => {
  const tone = adminStatusTone(status);
  if (tone === "success") return "border-emerald-200 bg-emerald-50 text-emerald-800";
  if (tone === "info") return "border-blue-200 bg-blue-50 text-blue-800";
  if (tone === "warning") return "border-amber-200 bg-amber-50 text-amber-800";
  if (tone === "danger") return "border-red-200 bg-red-50 text-red-800";
  return "border-slate-200 bg-slate-100 text-slate-700";
};
---

<section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm" aria-labelledby="admin-readiness-title">
  <div class="max-w-3xl">
    <h2 id="admin-readiness-title" class="text-xl font-black tracking-tight text-brand-dark">Admin readiness checklist</h2>
    <p class="mt-2 text-sm leading-relaxed text-slate-600">
      Known release posture only. This checklist does not query providers, read credentials or activate a service.
    </p>
  </div>
  <ul class="mt-6 grid gap-3 md:grid-cols-2">
    {items.map((item) => (
      <li class="flex items-start justify-between gap-4 rounded-xl border border-slate-100 bg-slate-50 p-4">
        <div>
          <p class="text-sm font-black text-brand-dark">{item.label}</p>
          <p class="mt-1 text-xs leading-relaxed text-slate-600">{item.detail}</p>
        </div>
        <span class={`shrink-0 rounded-full border px-2 py-1 text-[9px] font-black uppercase tracking-wide ${statusClass(item.status)}`}>
          {item.status}
        </span>
      </li>
    ))}
  </ul>
</section>
