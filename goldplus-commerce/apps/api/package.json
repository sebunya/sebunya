{
  "name": "@goldplus/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/interfaces/http/server.ts",
    "build": "tsc",
    "start": "node dist/interfaces/http/server.js",
    "db:generate": "drizzle-kit generate:pg",
    "db:migrate": "tsx src/infrastructure/db/migrations/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@goldplus/shared": "workspace:*",
    "@hono/node-server": "^1.8.0",
    "@hono/zod-validator": "^0.2.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.76.0",
    "@opentelemetry/sdk-node": "^0.218.0",
    "@sentry/node": "^10.54.0",
    "bullmq": "^5.8.5",
    "drizzle-orm": "^0.29.3",
    "hono": "^4.0.0",
    "hono-pino": "^0.10.3",
    "ioredis": "^5.4.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.3",
    "prom-client": "^15.1.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "drizzle-kit": "^0.20.14",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  }
