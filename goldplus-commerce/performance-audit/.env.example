# GoldPlus Continuous Performance Assurance — secrets and per-runner settings.
# Copy to .env on the runner (never commit .env). Non-secret settings live in
# audit.config.yaml. Every variable below is read by a verified integration.

# ── Targets ────────────────────────────────────────────────────────────────
TARGET_URL=https://shopgoldplus.com
# A product page for the WebPageTest e-commerce flow and Artillery journey.
# Choose a product that will stay published; see README "Test product".
AUDIT_PRODUCT_URL=

# ── Heavy load safety (k6, Artillery, Loader.io) ──────────────────────────
# Heavy profiles run ONLY against LOAD_TARGET_URL. Leave empty to skip them
# (reported as SKIPPED_FOR_SAFETY). If this is ever the production host, BOTH
# lines below must be set exactly as shown or the heavy test aborts.
LOAD_TARGET_URL=
ALLOW_PROD_LOAD_TEST=false
PROD_LOAD_TEST_ACK=

# ── Where runs are stored (durable, outside Git) ───────────────────────────
PERF_AUDIT_DATA_DIR=/var/lib/goldplus-performance-audit

# ── Provider credentials (all optional; a missing key = IMPLEMENTED_AWAITING_CREDENTIALS) ──
# WebPageTest (https://www.webpagetest.org/ → API key; paid plan for API tests)
WPT_API_KEY=
WPT_SERVER=https://www.webpagetest.org
# GTmetrix REST API 2.0 (account → API key; free tier has a small daily credit)
GTMETRIX_API_KEY=
# DebugBear (project API key + numeric project id; quick tests: 30/day on trial)
DEBUGBEAR_API_KEY=
DEBUGBEAR_PROJECT_ID=
# SpeedVitals (X-API-KEY; credits per Lighthouse/TTFB test)
SPEEDVITALS_API_KEY=
# Pingdom (SolarWinds) API 3.1 bearer token — official API only; the free speed test has no API
PINGDOM_API_TOKEN=
# Loader.io API v2 (loaderio-auth); verification token for the static file
LOADERIO_API_KEY=
LOADERIO_VERIFICATION_TOKEN=
# SpeedCurve (API key as basic-auth username); site id optional
SPEEDCURVE_API_KEY=
SPEEDCURVE_SITE_ID=

# ── Alerting hook (optional) ───────────────────────────────────────────────
# A URL that receives a JSON POST when an alert condition is met (see README).
PERF_AUDIT_ALERT_WEBHOOK_URL=
