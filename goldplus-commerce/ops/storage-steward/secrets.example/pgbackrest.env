# /etc/goldplus/secrets/pgbackrest.env          root:root 0600
#
# Used to render /etc/pgbackrest/pgbackrest.conf. Repository encryption means a
# lost passphrase is a lost repository — keep a copy off this machine.
PGBACKREST_REPO1_S3_KEY=
PGBACKREST_REPO1_S3_KEY_SECRET=
PGBACKREST_REPO1_S3_BUCKET=
PGBACKREST_REPO1_S3_ENDPOINT=
PGBACKREST_REPO1_S3_REGION=fsn1
PGBACKREST_REPO1_CIPHER_PASS=
