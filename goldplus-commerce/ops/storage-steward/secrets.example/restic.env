# /etc/goldplus/secrets/restic.env              root:root 0600
#
# A LOST RESTIC PASSWORD MEANS A LOST REPOSITORY. There is no recovery path.
# Store a copy somewhere that survives this machine before the first real backup.
RESTIC_PASSWORD=
RESTIC_REPOSITORY=s3:https://fsn1.your-objectstorage.com/BUCKET/restic
