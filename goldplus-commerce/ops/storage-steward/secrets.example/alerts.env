# /etc/goldplus/secrets/alerts.env              root:root 0600
#
# Where the Storage Steward sends HIGH and CRITICAL alerts. Without it they
# are only written to the state database and nobody reads them. Any URL that
# accepts a text POST: an ntfy topic (https://ntfy.sh/<private-topic>, and
# install the ntfy app on the owner's phone), a Slack or Discord webhook.
ALERT_WEBHOOK_URL=
