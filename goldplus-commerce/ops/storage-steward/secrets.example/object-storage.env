# /etc/goldplus/secrets/object-storage.env      root:root 0600
#
# Hetzner (or any S3-compatible) object storage. The secret key is shown ONCE
# when created, so paste it here directly on the server — never into git, a
# Compose file, a log, a report, or this repository.
#
# The Storage Steward records only `credential_present=true` and the result of
# its canary check. It never stores, prints or logs the values below.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# e.g. https://fsn1.your-objectstorage.com   (region is part of the host)
GOLDPLUS_S3_ENDPOINT=
GOLDPLUS_S3_BUCKET=
GOLDPLUS_S3_REGION=fsn1
