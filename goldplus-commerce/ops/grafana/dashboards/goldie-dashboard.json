{
  "title": "Goldie (customer care)",
  "uid": "goldie-care",
  "schemaVersion": 39,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Urgent tasks open",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "goldplus-prometheus"
      },
      "targets": [
        {
          "expr": "max(goldie_care_urgent_open)",
          "refId": "A",
          "legendFormat": "{{outcome}}{{channel}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Longest urgent wait, nobody on it (minutes)",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "goldplus-prometheus"
      },
      "targets": [
        {
          "expr": "max(goldie_care_oldest_urgent_minutes)",
          "refId": "A",
          "legendFormat": "{{outcome}}{{channel}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "gauge",
      "title": "Model spend vs cap",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "goldplus-prometheus"
      },
      "targets": [
        {
          "expr": "max(goldie_model_spend_ratio)",
          "refId": "A",
          "legendFormat": "{{outcome}}{{channel}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Escalations (1h)",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "goldplus-prometheus"
      },
      "targets": [
        {
          "expr": "sum(increase(goldie_care_escalations_total[1h]))",
          "refId": "A",
          "legendFormat": "{{outcome}}{{channel}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "WhatsApp messages by outcome",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "goldplus-prometheus"
      },
      "targets": [
        {
          "expr": "sum by (outcome) (increase(goldie_whatsapp_messages_total[15m]))",
          "refId": "A",
          "legendFormat": "{{outcome}}{{channel}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Care alerts by channel",
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "goldplus-prometheus"
      },
      "targets": [
        {
          "expr": "sum by (channel) (increase(goldie_care_alerts_total[1h]))",
          "refId": "A",
          "legendFormat": "{{outcome}}{{channel}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Replies recovered after interruption",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "goldplus-prometheus"
      },
      "targets": [
        {
          "expr": "sum(increase(goldie_whatsapp_recovered_total[1h]))",
          "refId": "A",
          "legendFormat": "{{outcome}}{{channel}}"
        }
      ]
    }
  ]
}