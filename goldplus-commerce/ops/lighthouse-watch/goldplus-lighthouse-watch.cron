# /etc/cron.d/goldplus-lighthouse-watch — install: cp this file there (root:root 0644)
#
# Lighthouse Watch, WEEKLY on a fixed slot (owner decisions 2026-10-06; was
# "at most every 96 h", 2026-09-13): Sunday 03:00 Kampala time (EAT, UTC+3),
# the dead of night when nobody is shopping, so the audit neither slows a
# customer nor is skewed by one. A fixed day makes week-on-week scores comparable.
#
# The host clock is UTC, so 03:00 EAT is written 00:00 UTC below. Do not
# "correct" it to 3. Neighbours: Steward housekeep 00:20 UTC (defers while busy;
# a run takes ~3 min), Steward deep Sun 01:40, backup 02:15, offsite 02:50,
# restore drill 1st Sun 03:30.
#
# Deploys no longer trigger it (their own smoke runs Lighthouse). The runner's
# 24 h guard only stops a duplicate in the same night; `manual` bypasses it.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
0 0 * * 0 root cd /opt/goldplus/app/goldplus-commerce && scripts/lighthouse-watch.sh cron
