# ==============================================================================
# CADDYFILE — GOLDPLUS PRODUCTION EDGE PROXY
# ==============================================================================
# Self-Critique Fixes Applied:
# 1. Rate limiting on /telemetry/collect — prevents outbox spam from bad actors
# 2. Bot suppression header — pass Cloudflare bot score to API for filtering
# 3. Security headers on all endpoints
# 4. Isolated telemetry subdomain with correct internal routing
# ==============================================================================

# ------------------------------------------------------------------------------
# 0. GLOBAL OPTIONS
# ------------------------------------------------------------------------------
{
  email admin@shopgoldplus.com
  # Aggressive TLS hardening — OCSP stapling + TLS 1.2 minimum
  servers {
    protocols h1 h2 h3
    # The shopper's real address. Every request reaches us through Cloudflare,
    # so {remote_host} is a Cloudflare edge: every visitor looked like a handful
    # of addresses (rate limits, lockouts and analytics all saw the edge).
    # CF-Connecting-IP is believed ONLY from Cloudflare's published ranges
    # (https://www.cloudflare.com/ips/, 2026-09-19); from anywhere else the
    # header is ignored and {client_ip} is the connecting address, so it cannot
    # be forged by calling the origin directly.
    trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
    client_ip_headers CF-Connecting-IP
  }
}

# ------------------------------------------------------------------------------
# 1. STOREFRONT — shopgoldplus.com / www.shopgoldplus.com
# ------------------------------------------------------------------------------
shopgoldplus.com, www.shopgoldplus.com {
  tls admin@shopgoldplus.com

  header {
    Strict-Transport-Security  "max-age=63072000; includeSubDomains; preload"
    X-Content-Type-Options     "nosniff"
    X-Frame-Options            "SAMEORIGIN"
    Referrer-Policy            "strict-origin-when-cross-origin"
    Permissions-Policy         "camera=(), microphone=(), geolocation=(self)"
    # static.cloudflareinsights.com / cloudflareinsights.com: Cloudflare Web
    # Analytics is switched on at the zone and injects its beacon into every
    # page; without these two sources the beacon is refused by this policy and
    # every page logs a console error (Lighthouse Best Practices, 2026-09-13).
    # metrics.shopgoldplus.com serves gtm.js and receives hits (first-party
    # tagging server); region1.google-analytics.com and googletagmanager.com
    # are only reached by Tag Assistant preview. tagassistant frame for preview.
    Content-Security-Policy    "default-src 'self'; script-src 'self' 'unsafe-inline' https://metrics.shopgoldplus.com https://www.googletagmanager.com https://pay.pesapal.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://metrics.shopgoldplus.com https://www.googletagmanager.com; connect-src 'self' https://api.shopgoldplus.com https://metrics.shopgoldplus.com https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com https://cloudflareinsights.com; frame-src 'self' https://pay.pesapal.com https://metrics.shopgoldplus.com https://tagassistant.google.com;"
    -Server
  }

  encode gzip

  # Media library assets (Wave 2B): the api container writes into the shared media
  # volume; the edge serves it directly so image delivery never hops through SSR.
  # Same-origin, so the existing img-src 'self' CSP already permits it.
  handle /uploads/* {
    root * /srv/media
    # Only a file that EXISTS is immutable. A miss must never carry the year-long
    # header: Cloudflare cached six 404s for a year on 2026-09-01 after the files
    # were requested before they were on the volume, and the photos stayed
    # broken after the files arrived.
    @present file
    header @present Cache-Control "public, max-age=31536000, immutable"
    @absent not file
    header @absent Cache-Control "no-store"
    file_server
  }

  # Public static files served by the web container (hero photos, product
  # photos, payment logos, nav art, self-hosted fonts, icons). The Astro server
  # sends no Cache-Control for them, so Cloudflare fell back to a 4-hour browser
  # TTL and every return visit re-fetched them (Lighthouse, 2026-09-13). Only a
  # 200 gets the long header: the same 404-cached-for-a-year trap as /uploads.
  # /products/ is ALSO the product PAGE prefix (/products/<slug>), so only image
  # files there are static. A bare /products/* sent every product page with a
  # 30-day browser cache: a repriced product kept its old price for a month
  # for anyone who had viewed it (found 2026-09-18 after the 18-9-26 reprice).
  @static path /hero/* /products/*.webp /products/*.avif /products/*.svg /products/*.png /products/*.jpg /products/*.jpeg /payment/* /nav/* /fonts/* /icon-192.svg /favicon.ico /apple-touch-icon.png
  handle @static {
    # The web container's MIME table has no AVIF entry and answers
    # application/octet-stream (with nosniff). The hero photos are AVIF first
    # (2026-09-13), so name the type here.
    @avif path *.avif
    header @avif >Content-Type "image/avif"
    reverse_proxy web:4321 {
      header_up Host              {host}
      header_up X-Real-IP         {client_ip}
      header_up X-Forwarded-For  {client_ip}
      header_up X-Forwarded-Proto {scheme}
      @ok status 200
      handle_response @ok {
        # ">" defers the set until the copied response is written, so it
        # REPLACES the upstream "public, max-age=0" instead of standing beside it.
        header >Cache-Control "public, max-age=2592000, stale-while-revalidate=86400"
        copy_response
      }
    }
  }

  handle {
    reverse_proxy web:4321 {
      header_up Host              {host}
      header_up X-Real-IP         {client_ip}
      header_up X-Forwarded-For  {client_ip}
      header_up X-Forwarded-Proto {scheme}
    }
  }

  handle_errors {
    @webUpstreamError expression `{err.status_code} >= 500`
    handle @webUpstreamError {
      root * /srv/caddy-fallback
      rewrite * /maintenance.html
      header Cache-Control "no-store"
      file_server {
        status 503
      }
    }
  }
}

# ------------------------------------------------------------------------------
# 2. API — api.shopgoldplus.com
# ------------------------------------------------------------------------------
api.shopgoldplus.com {
  tls admin@shopgoldplus.com

  header {
    Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
    X-Content-Type-Options    "nosniff"
    X-Frame-Options           "DENY"
    -Server
  }

  # Rate limit the telemetry ingestion endpoint to protect the outbox
  # (Rate limiting shifted to Hono middleware)

  encode gzip

  reverse_proxy api:3000 {
    header_up Host              {host}

    # ── Client identity — MODE A: Caddy is the public edge ──────────────────
    #
    # These two are SET (not appended), so whatever the caller sent is
    # discarded and the API sees only the address Caddy actually observed.
    header_up X-Real-IP         {client_ip}
    header_up X-Forwarded-For   {client_ip}
    header_up X-Forwarded-Proto {scheme}

    # reverse_proxy forwards every header it is not told about, so any
    # alternate client-identity header arrives exactly as the caller wrote it.
    # Stripping them is what makes the two lines above the only answer to "who
    # is this?" — otherwise a caller can simply pick a different header.
    header_up -CF-Connecting-IP
    header_up -True-Client-IP
    header_up -Fastly-Client-IP
    header_up -X-Client-IP
    header_up -X-Cluster-Client-IP
    header_up -Forwarded

    # Cloudflare scores are forgeable for the same reason: without Cloudflare in
    # front, Cf-Bot-Management-Score is just a header the caller chose. Bot
    # detection treats a low score as grounds to reject, so an attacker could
    # equally send a high one to wave itself through. Both the source header and
    # the internal header are cleared here.
    #
    # In MODE B (Cloudflare is the edge, origin locked to Cloudflare networks),
    # replace this block with the pass-through in
    # docs/platform/security/PROXY_TOPOLOGY.md — do NOT simply delete the strip.
    header_up -Cf-Bot-Management-Score
    header_up -Cf-Threat-Score
    header_up -X-CF-Bot-Score
    header_up -X-CF-Threat-Score
  }

  handle_errors {
    @apiUpstreamError expression `{err.status_code} >= 500`
    handle @apiUpstreamError {
      header Cache-Control "no-store"
      header Content-Type "application/json"
      respond "{\"ok\":false,\"status\":\"degraded\",\"service\":\"goldplus-api\",\"message\":\"GoldPlus API is temporarily unavailable. Please retry shortly.\"}" 503
    }
  }
}

# ------------------------------------------------------------------------------
# 3. TELEMETRY / sGTM — metrics.shopgoldplus.com
# ------------------------------------------------------------------------------
metrics.shopgoldplus.com {
  tls admin@shopgoldplus.com

  header {
    Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
    X-Content-Type-Options    "nosniff"
    -Server
    # No CORS headers here: the tagging server sets its own per request, and
    # a second, fixed Access-Control-Allow-Origin makes browsers reject both.
  }

  # Everything to the production tagging server; it forwards Tag Assistant
  # preview traffic to the preview server itself (PREVIEW_SERVER_URL). The old
  # two-reverse_proxy split overlapped: Caddy does not evaluate those in order.
  #
  # The visitor's real address ({client_ip}: see the global trusted_proxies).
  reverse_proxy sgtm-production:8080 {
    header_up Host              {host}
    header_up X-Forwarded-For   {client_ip}
    header_up X-Real-IP         {client_ip}
    header_up X-Forwarded-Proto https
  }
}

# ------------------------------------------------------------------------------
# 4. sGTM PREVIEW — preview-metrics.shopgoldplus.com (Tag Assistant for the
#    server container). Production forwards preview traffic here.
# ------------------------------------------------------------------------------
preview-metrics.shopgoldplus.com {
  tls admin@shopgoldplus.com

  header {
    Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
    X-Content-Type-Options    "nosniff"
    -Server
  }

  reverse_proxy sgtm-preview:8080 {
    header_up Host              {host}
    header_up X-Forwarded-For   {client_ip}
    header_up X-Real-IP         {client_ip}
    header_up X-Forwarded-Proto https
  }
}
