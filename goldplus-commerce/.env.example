# ---------------------------------------------------------------------------
# GoldPlus Commerce OS — environment variables
# Copy this file to `.env` and fill in real values for your environment.
# ---------------------------------------------------------------------------

# ---------- Database (required) ----------
# Postgres connection string. Without it the API fails at startup.
DATABASE_URL=postgresql://goldplus:goldplus@localhost:5432/goldplus

# ---------- Auth (required for sign-in to work) ----------
# Minimum 32 characters. If missing, /auth/login and /auth/admin/login
# return AUTH_NOT_CONFIGURED (HTTP 503) and the web sign-in pages
# render the "Sign-in not configured" notice.
JWT_SECRET=

# ---------- Payment webhooks (optional) ----------
# HMAC-SHA256 secrets for verifying incoming webhook signatures.
# If absent, webhooks still process but the response carries
# `meta.signatureVerified: false` and `meta.secretConfigured: false`.
MTN_WEBHOOK_SECRET=
AIRTEL_WEBHOOK_SECRET=

# ---------- Web app (required for the web app to reach the API) ----------
# Base URL of the API server, used by every server-side fetch in Astro pages.
# In production this should be the public API origin.
PUBLIC_API_BASE_URL=http://localhost:3000

# ---------- Admin bootstrap (required only for scripts/bootstrap-admin.ts) ----------
# Used once to seed the Owner role + first admin user. Safe to leave blank
# in normal operation. Password minimum 12 characters; script refuses shorter ones.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_PHONE=

# ---------- Notification adapters (optional) ----------
# When absent, WhatsApp/SMS adapters return
# `{ success: false, code: "NOT_CONFIGURED" }` instead of pretending to send.
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ---------- SMS gateway (optional; powers SMS OTP / 2FA) ----------
# Generic HTTP gateway: the adapter POSTs { to, from, message } with a
# bearer key. Both URL and key are required to send; otherwise the SMS
# channel reports NOT_CONFIGURED. Works with most bulk-SMS providers.
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=GoldPlus

# ---------- Two-factor / OTP hashing (optional but recommended) ----------
# Server pepper used to hash OTP + backup codes. Falls back to JWT_SECRET
# if unset; set a distinct value in production.
OTP_PEPPER=

# ---------- ZeptoMail transactional email (optional) ----------
# Both token and from-address are required to send; with either missing the
# adapter reports NOT_CONFIGURED and the outbox keeps a truthful attempt log.
# ZEPTOMAIL_API_TOKEN accepts the raw enczapikey or the full
# "Zoho-enczapikey <key>" header value. From-address must be a verified
# sender on your ZeptoMail Mail Agent.
ZEPTOMAIL_API_TOKEN=
ZEPTOMAIL_FROM_ADDRESS=
ZEPTOMAIL_FROM_NAME=GoldPlus

# ---------- Ops alert recipients (optional) ----------
# Where outbox events (payment results, dealer applications, quotes,
# counterfeit reports) are emailed / WhatsApp'd. No recipient, no send.
OPS_ALERT_EMAIL=
OPS_ALERT_WHATSAPP=

# ---------- Google social login (optional) ----------
# All three are required for Google sign-in. With any missing, the
# /auth/google/url endpoint returns NOT_CONFIGURED (HTTP 503) and nothing
# is attempted. The redirect URI must exactly match the one registered in
# the Google Cloud console OAuth client and point at the WEB app callback
# (the web app owns the browser flow + CSRF state), e.g.
# https://<web-host>/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
