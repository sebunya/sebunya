# ---------------------------------------------------------------------------
# GoldPlus Commerce OS — Environment Configuration Template
# Copy this file to `.env` and fill in real values for your environment.
# ---------------------------------------------------------------------------

# ---------- Node Environment ----------
# Environment mode. Under 'production', strict validation rules are enforced:
# - Required variables cannot be missing.
# - Secrets (JWT_SECRET, IDENTITY_HASH_PEPPER) must be at least 32 characters long.
# - Webhook secrets must be at least 24 characters long.
# - Obvious local placeholders (e.g., 'localhost', 'local-dev', 'changeme') are blocked.
NODE_ENV=development

# ---------- Database (required) ----------
# Postgres connection string. Without it the API fails at startup.
DATABASE_URL=postgresql://goldplus:goldplus@localhost:5432/goldplus

# ---------- Auth (required for sign-in to work) ----------
# Minimum 32 characters. Under production mode, strong keys are strictly verified.
# Never use local/demo secrets (like 'local-dev-secret') in production.
# Rotated secrets regularly.
JWT_SECRET=goldplus-local-dev-secret-32-chars-long-2026-uganda

# ---------- First-Party Identity Resolution (required) ----------
# Unique high-entropy pepper used to hash PII (emails, phone numbers) for privacy.
# Under production, this must be at least 32 characters and cannot contain local patterns.
# Rotate this key in sync with database migrations to avoid breaking existing links.
IDENTITY_HASH_PEPPER=goldplus-identity-pepper-local-32-chars-2026-key

# ---------- Payment webhooks (required) ----------
# HMAC-SHA256 secrets for verifying incoming webhook signatures.
# Under production, these must be at least 24 characters.
MTN_WEBHOOK_SECRET=goldplus-mtn-local-24-character-webhook-secret
AIRTEL_WEBHOOK_SECRET=goldplus-airtel-local-24-character-webhook-secret

# ---------- Web app (required for the web app to reach the API) ----------
# Base URL of the API server, used by every server-side fetch in Astro pages.
# In local development: http://localhost:3000
# In staging: https://staging-api.shopgoldplus.com
# In production: https://api.shopgoldplus.com
PUBLIC_API_BASE_URL=http://localhost:3000

# ---------- Admin bootstrap (required only for scripts/bootstrap-admin.ts) ----------
# Used once to seed the Owner role + first admin user. Safe to leave blank
# in normal operation. Password minimum 12 characters; script refuses shorter ones.
BOOTSTRAP_ADMIN_EMAIL=robsebunya@gmail.com
BOOTSTRAP_ADMIN_PASSWORD=Goldplus2026!
BOOTSTRAP_ADMIN_PHONE=+256705004545

# ---------- Notification adapters (optional; future) ----------
# When absent, WhatsApp/ZeptoMail/SMS adapters return
# `{ success: false, code: "NOT_CONFIGURED" }` instead of pretending to send.
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
ZEPTOMAIL_API_TOKEN=
ZEPTOMAIL_FROM_ADDRESS=
ZEPTOMAIL_FROM_NAME="GoldPlus"
ZEPTOMAIL_REPLY_TO=
ZEPTOMAIL_BASE_URL=https://api.zeptomail.com/v1.1/email
ZEPTOMAIL_TIMEOUT_MS=10000
# Pahappa Comms / EgoSMS SMS Integration
SMS_PROVIDER=
SMS_BASE_URL=https://comms.egosms.co/api/v1/json/
SMS_USERNAME=
SMS_API_KEY=
SMS_SENDER_ID=
SMS_DEFAULT_COUNTRY_CODE=UG
SMS_PRIORITY=0
SMS_TIMEOUT_MS=10000

# Global notification safety controls
NOTIFICATIONS_SMS_ENABLED=false
NOTIFICATIONS_EMAIL_ENABLED=false
NOTIFICATIONS_DRY_RUN=true
NOTIFICATIONS_LIVE_SEND_ENABLED=false
NOTIFICATIONS_ALLOWED_TEST_RECIPIENTS=
NOTIFICATIONS_RATE_LIMIT_PER_MINUTE=
NOTIFICATIONS_PROVIDER_TIMEOUT_MS=10000

# ===========================================================================
# ⚠️ PRODUCTION SECURITY WARNING:
# 1. DO NOT commit the .env file to public source control.
# 2. All secrets (JWT_SECRET, IDENTITY_HASH_PEPPER, webhook secrets) must be rotated 
#    prior to initial deployment and regular maintenance cycles.
# 3. Always use a production-grade high-entropy key generator (e.g. `openssl rand -hex 32`).
# ===========================================================================
