# ---------------------------------------------------------------------------
# GoldPlus Commerce OS — Environment Configuration Template
# Copy this file to `.env` and fill in real values for your environment.
# ---------------------------------------------------------------------------

# ---------- Node Environment ----------
# Environment mode. Under 'production', strict validation rules are enforced:
# - Required variables cannot be missing.
# - Secrets (JWT_SECRET, IDENTITY_HASH_PEPPER) must be at least 32 characters long.
# - Webhook secrets must be at least 24 characters long.
# - Obvious local placeholders (e.g., 'localhost', 'local-dev', 'changeme') are blocked.
NODE_ENV=development

# ---------- Database (required) ----------
# Postgres connection string. Without it the API fails at startup.
DATABASE_URL=postgresql://goldplus:goldplus@localhost:5432/goldplus

# ---------- Auth (required for sign-in to work) ----------
# Minimum 32 characters. Under production mode, strong keys are strictly verified.
# Never use local/demo secrets (like 'local-dev-secret') in production.
# Rotated secrets regularly.
JWT_SECRET=change-me-example-local-jwt-secret-at-least-32-chars

# ---------- First-Party Identity Resolution (required) ----------
# Unique high-entropy pepper used to hash PII (emails, phone numbers) for privacy.
# Under production, this must be at least 32 characters and cannot contain local patterns.
# Rotate this key in sync with database migrations to avoid breaking existing links.
IDENTITY_HASH_PEPPER=goldplus-identity-pepper-local-32-chars-2026-key

# ---------- Payment webhooks (required) ----------
# HMAC-SHA256 secrets for verifying incoming webhook signatures.
# Under production, these must be at least 24 characters.
MTN_WEBHOOK_SECRET=change-me-example-mtn-webhook-secret-24ch
AIRTEL_WEBHOOK_SECRET=change-me-example-airtel-webhook-secret-24

# ---------- Web app (required for the web app to reach the API) ----------
# Base URL of the API server, used by every server-side fetch in Astro pages.
# In local development: http://localhost:3000
# In staging: https://staging-api.shopgoldplus.com
# In production: https://api.shopgoldplus.com
PUBLIC_API_BASE_URL=http://localhost:3000

# ---------- Storefront cross-site protection (optional, recommended) ----------
# Comma-separated list of origins this storefront answers on. State-changing POSTs
# (checkout) are refused when the browser reports the request as cross-site, which
# needs no configuration; setting this strengthens the fallback used by older
# clients that send Origin or Referer but not Sec-Fetch-Site, by naming the hosts
# explicitly instead of trusting the request's own Host header — which, behind a
# reverse proxy, is exactly what an attacker can set.
# Example: https://shopgoldplus.com,https://www.shopgoldplus.com
PUBLIC_SITE_ORIGINS=

# ---------- Checkout intent signing (optional; falls back to JWT_SECRET) ----------
# Signs the BFF-issued checkout intent, which is what authorizes an order and a
# payment start. Must be at least 32 characters: the key derivation widens whatever
# it is given to 32 bytes, so a short root would hide behind a healthy-looking key.
# CHECKOUT_INTENT_KEY_ID names the current key; set CHECKOUT_INTENT_PREVIOUS_KEY_ID
# during a rotation so in-flight checkouts are not invalidated mid-payment.
CHECKOUT_INTENT_SECRET=
CHECKOUT_INTENT_KEY_ID=1
CHECKOUT_INTENT_PREVIOUS_KEY_ID=

# ---------- Admin bootstrap (required only for scripts/bootstrap-admin.ts) ----------
# Used once to seed the Owner role + first admin user. Safe to leave blank
# in normal operation. Password minimum 12 characters; script refuses shorter ones.
#
# NEVER put a real value here. This file is COMMITTED. The account these seed
# is granted EVERY permission in the registry (scripts/bootstrap-admin.ts),
# so a real password on this line is a full administrative credential in the
# repository — and it stays in git history even after it is edited out, which
# is why the only safe remedy for a leaked value is rotating the account.
# Real values belong in the deployment secret store and .env.production only.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=<set-a-strong-password-in-your-secret-store>
BOOTSTRAP_ADMIN_PHONE=+2567XXXXXXXX

# ---------- Notification adapters (optional; future) ----------
# When absent, WhatsApp/ZeptoMail/SMS adapters return
# `{ success: false, code: "NOT_CONFIGURED" }` instead of pretending to send.
WHATSAPP_PROVIDER=meta_cloud
WHATSAPP_API_BASE_URL=https://graph.facebook.com
WHATSAPP_API_VERSION=v20.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_DEFAULT_COUNTRY_CODE=UG
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_SUPPORT_NUMBER=256705004545
WHATSAPP_SUPPORT_LABEL="GoldPlus Support"
PUBLIC_WHATSAPP_SUPPORT_NUMBER=256705004545
PUBLIC_WHATSAPP_SUPPORT_LABEL="GoldPlus Support"
ZEPTOMAIL_API_TOKEN=
ZEPTOMAIL_FROM_ADDRESS=
ZEPTOMAIL_FROM_NAME="GoldPlus"
ZEPTOMAIL_REPLY_TO=
ZEPTOMAIL_BASE_URL=https://api.zeptomail.com/v1.1/email
ZEPTOMAIL_TIMEOUT_MS=10000
# Pahappa Comms / EgoSMS SMS Integration
SMS_PROVIDER=
SMS_BASE_URL=https://comms.egosms.co/api/v1/json/
SMS_USERNAME=
SMS_API_KEY=
SMS_SENDER_ID=
SMS_DEFAULT_COUNTRY_CODE=UG
SMS_PRIORITY=0
SMS_TIMEOUT_MS=10000

# Global notification safety controls
NOTIFICATIONS_SMS_ENABLED=false
NOTIFICATIONS_EMAIL_ENABLED=false
NOTIFICATIONS_WHATSAPP_ENABLED=false
NOTIFICATIONS_DRY_RUN=true
NOTIFICATIONS_LIVE_SEND_ENABLED=false
NOTIFICATIONS_ALLOWED_TEST_RECIPIENTS=
NOTIFICATIONS_RATE_LIMIT_PER_MINUTE=
NOTIFICATIONS_PROVIDER_TIMEOUT_MS=10000

# ---------- Telemetry & Observability (sGTM) ----------
# Your base64 encoded GTM Container Config string from Google Tag Manager UI
GTM_CONTAINER_CONFIG=AQOEAAA_mock_placeholder_change_in_production
# Docker-internal URL for the sGTM production container (never hits the public internet)
# Docker service name resolves to the container IP within the compose network
METRICS_INTERNAL_URL=http://sgtm-production:8080
# Docker-internal Redis URL for BullMQ queues
REDIS_URL=redis://redis:6379
# Optional shadow environment. Keep ratio at 0 unless a real shadow API is configured.
SHADOW_TRAFFIC_URL=
SHADOW_TRAFFIC_RATIO=0
# Public-facing metrics subdomain for the frontend snippet
PUBLIC_METRICS_URL=https://metrics.shopgoldplus.com
# GTM Container ID (e.g. GTM-XXXXXXX)
PUBLIC_GTM_ID=GTM-XXXXXXX

# ---------- Payment webhook verification ----------
# An unverified payment webhook is REFUSED. signatureVerified used to be
# computed and then ignored, so anyone who could reach the endpoint could mark
# an order paid with no credential.
#
# Monitored grace mode, for a deployment whose provider secrets are not yet
# configured. OFF unless set to exactly "true" — no other value enables it.
#
# It is narrow on purpose:
#   * it applies ONLY when no secret is configured for the provider. A
#     configured secret that did not match is a wrong or forged signature and
#     is refused whatever this flag says.
#   * anything it accepts is recorded with requires_review = true, does NOT
#     mark the order paid, emits no PAYMENT_SUCCESS event, and reports no
#     purchase telemetry. A human confirms it before the order moves.
#
# Set the provider secrets and turn this off.
PAYMENT_WEBHOOK_UNVERIFIED_GRACE=false
# Per-provider override, e.g. PAYMENT_WEBHOOK_UNVERIFIED_GRACE_MTN=true

# ---------- Client address / trusted proxies ----------
# REQUIRED IN PRODUCTION. The API refuses to start without it, because every
# per-client abuse control depends on knowing how the service is exposed.
#   CADDY_EDGE       Caddy is the only public edge (the tracked deployment).
#   CLOUDFLARE_EDGE  Cloudflare fronts Caddy. Read
#                    docs/platform/security/PROXY_TOPOLOGY.md before setting
#                    this — it is NOT just a hop-count change.
#   DIRECT           No proxy; forwarded headers are ignored entirely.
PROXY_TOPOLOGY_MODE=CADDY_EDGE

# Optional. Derived from the mode when unset (DIRECT 0, CADDY_EDGE 1,
# CLOUDFLARE_EDGE 2). Set it only if the deployment genuinely has a different
# number of trusted proxies.
# How many reverse proxies sit in front of the API. This decides which entry of
# X-Forwarded-For is treated as the caller, and therefore what the login
# lockout, the rate limiter and the bot-detection velocity check count per.
#
# Entries to the LEFT of the trusted ones were supplied by the caller and are
# discarded, so padding the header cannot mint fresh rate-limit buckets.
#
#   1  (default) Caddy is the only public edge and proxies to the API — the
#      tracked docker-compose.production topology.
#   0  the API is exposed directly; forwarded headers are not trusted at all.
#   2+ a CDN sits in front of Caddy. Set this to match, or the CDN's own
#      address is counted as the client and unrelated users share one bucket.
TRUSTED_PROXY_HOPS=1

# ===========================================================================
# ⚠️ PRODUCTION SECURITY WARNING:
# 1. DO NOT commit the .env file to public source control.
# 2. All secrets (JWT_SECRET, IDENTITY_HASH_PEPPER, webhook secrets) must be rotated 
#    prior to initial deployment and regular maintenance cycles.
# 3. Always use a production-grade high-entropy key generator (e.g. `openssl rand -hex 32`).
# ===========================================================================

# ---------- Measurement Control Tower (Phase 2) ----------
MEASUREMENT_DRY_RUN=true
MEASUREMENT_LIVE_DESTINATIONS_ENABLED=false
PAID_SOCIAL_QUEUE_ENABLED=false
MEASUREMENT_QA_ALLOW_NETWORK=false

GTM_ACCOUNT_ID=
GTM_WEB_CONTAINER_ID=
GTM_SERVER_CONTAINER_ID=
GTM_API_CLIENT_ID=
GTM_API_CLIENT_SECRET=
GTM_API_REFRESH_TOKEN=
GTM_SERVER_CONTAINER_CONFIG=
GTM_PREVIEW_SERVER_CONTAINER_CONFIG=

GA4_MEASUREMENT_ID=
GA4_API_SECRET=
GOOGLE_ADS_CONVERSION_ID=
GOOGLE_ADS_CONVERSION_LABEL=

META_PIXEL_ID=
META_ACCESS_TOKEN=

TIKTOK_PIXEL_ID=
TIKTOK_ACCESS_TOKEN=

X_ADS_ACCOUNT_ID=
X_PIXEL_ID=
X_CONVERSION_EVENT_ID=
X_ACCESS_TOKEN=

LINKEDIN_PARTNER_ID=
LINKEDIN_CONVERSION_ID=
LINKEDIN_ACCESS_TOKEN=

PINTEREST_TAG_ID=
PINTEREST_AD_ACCOUNT_ID=
PINTEREST_ACCESS_TOKEN=

SNAPCHAT_PIXEL_ID=
SNAPCHAT_AD_ACCOUNT_ID=
SNAPCHAT_ACCESS_TOKEN=

POSTHOG_PROJECT_API_KEY=
POSTHOG_HOST=

EGOSMS_API_KEY=
SENTRY_DSN=
